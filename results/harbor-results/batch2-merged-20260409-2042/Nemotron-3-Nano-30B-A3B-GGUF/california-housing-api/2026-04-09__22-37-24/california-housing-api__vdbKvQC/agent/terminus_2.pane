@app.post('/predict', response_model=PredictResponse)
async def predict(request: PredictRequest):
    if len(request.features) != 8:
        raise HTTPException(status_code=400, detail='Exactly 8 features required')
    
    # Convert to numpy array and reshape for prediction
    input_array = np.array(request.features).reshape(1, -1)
    prediction = best_model.predict(input_array)[0]
    
    return {
        'prediction': float(prediction),
        'model_name': 'random_forest'
    }

@app.post('/predict-batch', response_model=PredictBatchResponse)
async def predict_batch(request: PredictBatchRequest):
    if not request.features_list:
        raise HTTPException(status_code=400, detail='Features list cannot be empty')
    
    # Validate each sample has exactly 8 features
    for i, features in enumerate(request.features_list):
        if len(features) != 8:
            raise HTTPException(status_code=400, detail=f'Sample {i} must have exactly 8 features')
    
    # Convert to numpy array
    input_array = np.array(request.features_list)
    predictions = best_model.predict(input_array).tolist()
    
    return {
        'predictions': predictions,
        'model_name': 'random_forest',
        'count': len(predictions)
    }

# This will be used when running with uvicorn
if __name__ == '__main__':
    import uvicorn
    uvicorn.run('api.app:app', host='0.0.0.0', port=8000, reload=False)
