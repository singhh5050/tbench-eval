[439.532062, "i", "cat > /app/api/app.py << 'EOL'\nfrom fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel\nimport pickle\nimport numpy as np\nimport uvicorn\n\n# Load the best model at startup\nwith open('/app/models/best_model.pkl', 'rb') as f:\n    best_model = pickle.load(f)\n\n# Create FastAPI app\napp = FastAPI()\n\n# Request models\nclass PredictRequest(BaseModel):\n    features: list[float]\n\nclass PredictBatchRequest(BaseModel):\n    features_list: list[list[float]]\n\nclass HealthResponse(BaseModel):\n    status: str\n    model_loaded: bool\n\nclass ModelInfoResponse(BaseModel):\n    model_name: str\n    model_type: str\n    features_count: int\n\nclass PredictResponse(BaseModel):\n    prediction: float\n    model_name: str\n\nclass PredictBatchResponse(BaseModel):\n    predictions: list[float]\n    model_name: str\n    count: int\n\n@app.get('/health')\nasync def health():\n    return {\n        'status': 'healthy',\n        'model_loaded': True\n    }\n\n@app.get('/model-info')\nasync def model_info():\n    return {\n        'model_name': 'rand"]
[439.532224, "i", "om_forest',\n        'model_type': 'Random Forest Regressor',\n        'features_count': 8\n    }\n\n@app.post('/predict', response_model=PredictResponse)\nasync def predict(request: PredictRequest):\n    if len(request.features) != 8:\n        raise HTTPException(status_code=400, detail='Exactly 8 features required')\n    \n    # Convert to numpy array and reshape for prediction\n    input_array = np.array(request.features).reshape(1, -1)\n    prediction = best_model.predict(input_array)[0]\n    \n    return {\n        'prediction': float(prediction),\n        'model_name': 'random_forest'\n    }\n\n@app.post('/predict-batch', response_model=PredictBatchResponse)\nasync def predict_batch(request: PredictBatchRequest):\n    if not request.features_list:\n        raise HTTPException(status_code=400, detail='Features list cannot be empty')\n    \n    # Validate each sample has exactly 8 features\n    for i, features in enumerate(request.features_list):\n        if len(features) != 8:\n            raise HTTPException(status_code=400, deta"]
[439.532235, "o", "cat > /app/api/app.py << 'EOL'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.53229, "i", "il=f'Sample {i} must have exactly 8 features')\n    \n    # Convert to numpy array\n    input_array = np.array(request.features_list)\n    predictions = best_model.predict(input_array).tolist()\n    \n    return {\n        'predictions': predictions,\n        'model_name': 'random_forest',\n        'count': len(predictions)\n    }\n\nif __name__ == '__main__':\n    uvicorn.run('app:app', host='0.0.0.0', port=8000, reload=False)\nEOL\n"]
