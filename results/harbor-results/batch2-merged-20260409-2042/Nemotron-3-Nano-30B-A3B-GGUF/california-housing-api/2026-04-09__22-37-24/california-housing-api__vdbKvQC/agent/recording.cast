[414.376175, "o", "\u001b[?2004h> "]
[414.376199, "o", "    if not request.features_list:\r\n\u001b[?2004l\r"]
[414.376209, "o", "\u001b[?2004h> "]
[414.376267, "o", "        raise HTTPException(status_code=400, detail='Features list cannot be empty')\r\n\u001b[?2004l\r"]
[414.376278, "o", "\u001b[?2004h> "]
[414.376289, "o", "    \r\n\u001b[?2004l\r"]
[414.376299, "o", "\u001b[?2004h> "]
[414.376331, "o", "    # Validate each sample has exactly 8 features\r\n\u001b[?2004l\r"]
[414.376343, "o", "\u001b[?2004h> "]
[414.376383, "o", "    for i, features in enumerate(request.features_list):\r\n\u001b[?2004l\r"]
[414.376395, "o", "\u001b[?2004h> "]
