[439.533462, "o", "@app.get('/health')\r\n\u001b[?2004l\r\u001b[?2004h"]
[439.533474, "o", "> "]
[439.533489, "o", "async def health():\r\n\u001b[?2004l\r"]
[439.533501, "o", "\u001b[?2004h> "]
[439.533514, "o", "    return {\r\n\u001b[?2004l\r"]
[439.533527, "o", "\u001b[?2004h> "]
[439.533548, "o", "        'status': 'healthy',\r\n\u001b[?2004l\r"]
[439.53356, "o", "\u001b[?2004h> "]
[439.533581, "o", "        'model_loaded': True\r\n\u001b[?2004l\r"]
[439.533593, "o", "\u001b[?2004h>     }\r\n"]
[439.533605, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[439.533617, "o", "\u001b[?2004h> "]
[439.533641, "o", "@app.get('/model-info')\r\n\u001b[?2004l\r\u001b[?2004h"]
[439.533653, "o", "> "]
[439.533669, "o", "async def model_info():\r\n\u001b[?2004l\r"]
[439.533681, "o", "\u001b[?2004h> "]
[439.533693, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[439.533705, "o", "> "]
[439.533738, "o", "        'model_name': 'random_forest',\r\n\u001b[?2004l\r"]
[439.533779, "o", "\u001b[?2004h> "]
[439.533807, "o", "        'model_type': 'Random Forest Regressor',\r\n\u001b[?2004l\r"]
[439.533849, "o", "\u001b[?2004h>         'features_count': 8\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[439.533869, "o", "\u001b[?2004h> "]
[439.533901, "o", "@app.post('/predict', response_model=PredictResponse)\r\n\u001b[?2004l\r"]
[439.533916, "o", "\u001b[?2004h> "]
[439.533948, "o", "async def predict(request: PredictRequest):\r\n\u001b[?2004l\r"]
[439.533964, "o", "\u001b[?2004h> "]
[439.533986, "o", "    if len(request.features) != 8:\r\n\u001b[?2004l\r"]
[439.534001, "o", "\u001b[?2004h> "]
[439.534063, "o", "        raise HTTPException(status_code=400, detail='Exactly 8 features required')\r\n\u001b[?2004l\r"]
[439.534077, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[439.534092, "o", "\u001b[?2004h> "]
[439.534134, "o", "    # Convert to numpy array and reshape for prediction\r\n\u001b[?2004l\r"]
[439.534149, "o", "\u001b[?2004h> "]
[439.534191, "o", "    input_array = np.array(request.features).reshape(1, -1)\r\n\u001b[?2004l\r"]
[439.534204, "o", "\u001b[?2004h> "]
[439.534245, "o", "    prediction = best_model.predict(input_array)[0]\r\n\u001b[?2004l\r"]
[439.53426, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[439.534274, "o", "\u001b[?2004h> "]
[439.534289, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.534325, "o", "        'prediction': float(prediction),\r\n\u001b[?2004l\r"]
[439.534331, "o", "\u001b[?2004h> "]
[439.534382, "o", "        'model_name': 'random_forest'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.534398, "o", "    }\r\n\u001b[?2004l\r"]
[439.534413, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.534466, "o", "@app.post('/predict-batch', response_model=PredictBatchResponse)\r\n\u001b[?2004l\r"]
[439.534479, "o", "\u001b[?2004h> "]
[439.534519, "o", "async def predict_batch(request: PredictBatchRequest):\r\n\u001b[?2004l\r"]
[439.534534, "o", "\u001b[?2004h> "]
[439.534558, "o", "    if not request.features_list:\r\n\u001b[?2004l\r"]
[439.534571, "o", "\u001b[?2004h> "]
[439.534635, "o", "        raise HTTPException(status_code=400, detail='Features list cannot be empty')\r\n\u001b[?2004l\r"]
[439.534648, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[439.534662, "o", "\u001b[?2004h> "]
[439.534699, "o", "    # Validate each sample has exactly 8 features\r\n\u001b[?2004l\r"]
[439.534731, "o", "\u001b[?2004h> "]
[439.534765, "o", "    for i, features in enumerate(request.features_list):\r\n\u001b[?2004l\r"]
[439.534776, "o", "\u001b[?2004h> "]
[439.534801, "o", "        if len(features) != 8:\r\n\u001b[?2004l\r"]
[439.534813, "o", "\u001b[?2004h> "]
[439.534889, "o", "            raise HTTPException(status_code=400, detail=f'Sample {i} must have exactly 8 features')\r\n\u001b[?2004l\r"]
[439.534902, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[439.534914, "o", "\u001b[?2004h> "]
[439.534938, "o", "    # Convert to numpy array\r\n\u001b[?2004l\r"]
[439.534951, "o", "\u001b[?2004h> "]
[439.53499, "o", "    input_array = np.array(request.features_list)\r\n\u001b[?2004l\r"]
[439.535002, "o", "\u001b[?2004h> "]
[439.535047, "o", "    predictions = best_model.predict(input_array).tolist()\r\n\u001b[?2004l\r"]
[439.535059, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[439.535073, "o", "\u001b[?2004h> "]
[439.535085, "o", "    return {\r\n\u001b[?2004l\r"]
[439.535097, "o", "\u001b[?2004h> "]
[439.535124, "o", "        'predictions': predictions,\r\n\u001b[?2004l\r"]
[439.535136, "o", "\u001b[?2004h> "]
[439.535166, "o", "        'model_name': 'random_forest',\r\n\u001b[?2004l\r"]
[439.535177, "o", "\u001b[?2004h> "]
[439.535205, "o", "        'count': len(predictions)\r\n\u001b[?2004l\r"]
[439.535217, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[439.535229, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[439.535243, "o", "\u001b[?2004h> "]
[439.535266, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[439.535278, "o", "\u001b[?2004h> "]
[439.535333, "o", "    uvicorn.run('app:app', host='0.0.0.0', port=8000, reload=False)\r\n\u001b[?2004l\r"]
[439.535346, "o", "\u001b[?2004h> EOL\r\n"]
[439.535357, "o", "\u001b[?2004l\r"]
