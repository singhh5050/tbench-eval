[414.375551, "o", "\u001b[?2004h> "]
[414.375583, "o", "async def predict(request: PredictRequest):\r\n\u001b[?2004l\r\u001b[?2004h"]
[414.375604, "o", "> "]
[414.375626, "o", "    if len(request.features) != 8:\r\n\u001b[?2004l\r\u001b[?2004h"]
[414.37565, "o", "> "]
[414.375704, "o", "        raise HTTPException(status_code=400, detail='Exactly 8 features required')\r\n\u001b[?2004l\r"]
[414.375736, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[414.375795, "o", "\u001b[?2004h> "]
[414.375821, "o", "    # Convert to numpy array and reshape for prediction\r\n\u001b[?2004l\r\u001b[?2004h> "]
[414.375856, "o", "    input_array = np.array(request.features).reshape(1, -1)\r\n\u001b[?2004l\r"]
[414.375869, "o", "\u001b[?2004h> "]
[414.375907, "o", "    prediction = best_model.predict(input_array)[0]\r\n\u001b[?2004l\r"]
[414.375912, "o", "\u001b[?2004h> "]
[414.375927, "o", "    \r\n"]
[414.375939, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[414.375949, "o", "    return {\r\n\u001b[?2004l\r"]
[414.375958, "o", "\u001b[?2004h> "]
[414.37598, "o", "        'prediction': float(prediction),\r\n\u001b[?2004l\r"]
[414.375992, "o", "\u001b[?2004h"]
[414.376001, "o", "> "]
[414.376022, "o", "        'model_name': 'random_forest'\r\n\u001b[?2004l\r"]
[414.376033, "o", "\u001b[?2004h"]
[414.376042, "o", "> "]
[414.376054, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
