[439.628343, "i", "python3 /app/api/app.py &\n"]
[439.628482, "o", "python3 /app/api/app.py &\r\n\u001b[?2004l\r"]
[439.628649, "o", "[1] 873\r\n"]
[439.628729, "o", "\u001b[?2004h"]
[439.628757, "o", "root@e65884aa2bb3:/app# "]
[440.911394, "o", "\u001b[32mINFO\u001b[0m:     Started server process [\u001b[36m873\u001b[0m]\r\n\u001b[32mINFO\u001b[0m:     Waiting for application startup.\r\n"]
[440.91154, "o", "\u001b[32mINFO\u001b[0m:     Application startup complete.\r\n"]
[440.913883, "o", "\u001b[32mINFO\u001b[0m:     Uvicorn running on \u001b[1mhttp://0.0.0.0:8000\u001b[0m (Press CTRL+C to quit)\r\n"]
[458.883418, "i", "curl -s http://localhost:8000/health\n"]
[458.883662, "o", "curl -s http://localhost:8000/health\r\n\u001b[?2004l\r"]
[458.907326, "o", "\u001b[32mINFO\u001b[0m:     127.0.0.1:59068 - \"\u001b[1mGET /health HTTP/1.1\u001b[0m\" \u001b[32m200 OK\u001b[0m\r\n"]
[458.90743, "o", "{\"status\":\"healthy\",\"model_loaded\":true}"]
[458.908687, "o", "\u001b[?2004h"]
[458.908725, "o", "root@e65884aa2bb3:/app# "]
[474.870666, "i", "python3 -c \"\nimport pandas as pd\nimport json\nimport requests\nimport numpy as np\n\n# Load split info\nwith open('/app/output/split_info.json', 'r') as f:\n    split_info = json.load(f)\n\n# Get validation indices\nval_indices = split_info['validation_indices']\n\n# Load training data\ntrain_df = pd.read_csv('/app/train.csv')\n\n# Extract validation data\nval_data = train_df.iloc[val_indices]\n\n# Prepare features and true values\nfeatures_list = val_data.drop('target', axis=1).values.tolist()\ny_true = val_data['target'].values.tolist()\n\n# Make predictions\npredictions = []\nfor features in features_list:\n    response = requests.post('http://localhost:8000/predict', json={'features': features})\n    if response.status_code == 200:\n        result = response.json()\n        predictions.append(result['prediction'])\n    else:\n        print(f'Error: {response.status_code}')\n        predictions.append(np.nan)\n\n# Save to CSV\nwith open('/app/output/api_predictions.csv', 'w') as f:\n    f.write('sample_index,y_true,y_pred,absolute_error\\n'"]
[474.870712, "i", ")\n    for i, (y_t, y_p) in enumerate(zip(y_true, predictions)):\n        error = abs(y_t - y_p)\n        f.write(f'{i},{y_t},{y_p},{error}\\n')\n\n# Calculate metrics\nmae = np.mean([abs(y_t - y_p) for y_t, y_p in zip(y_true, predictions)])\nmse = np.mean([(y_t - y_p)**2 for y_t, y_p in zip(y_true, predictions)])\nrmse = np.sqrt(mse)\ny_true_array = np.array(y_true)\npred_array = np.array(predictions)\nss_res = np.sum((y_true_array - pred_array)**2)\nss_tot = np.sum((y_true_array - np.mean(y_true_array))**2)\nr2_score = 1 - (ss_res / ss_tot)\n\n# Save metrics\nmetrics = {\n    'sample_count': len(y_true),\n    'mae': mae,\n    'mse': mse,\n    'rmse': rmse,\n    'r2_score': r2_score\n}\nwith open('/app/output/api_metrics.json', 'w') as f:\n    json.dump(metrics, f, indent=2)\n\nprint(f'Metrics saved: mae={mae:.4f}, mse={mse:.4f}, rmse={rmse:.4f}, r2_score={r2_score:.4f}')\n\"\n"]
[474.870886, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import requests\r\n\u001b[?2004l\r\u001b[?2004h> "]
