[414.376425, "o", "\u001b[?2004h"]
[414.376434, "o", "> "]
[414.376499, "o", "            raise HTTPException(status_code=400, detail=f'Sample {i} must have exactly 8 features')\r\n\u001b[?2004l\r"]
[414.376511, "o", "\u001b[?2004h"]
[414.376518, "o", ">     \r\n\u001b[?2004l\r"]
[414.376529, "o", "\u001b[?2004h> "]
[414.376547, "o", "    # Convert to numpy array\r\n\u001b[?2004l\r"]
[414.37656, "o", "\u001b[?2004h> "]
[414.376592, "o", "    input_array = np.array(request.features_list)\r\n\u001b[?2004l\r"]
[414.3766, "o", "\u001b[?2004h"]
[414.376609, "o", "> "]
[414.376644, "o", "    predictions = best_model.predict(input_array).tolist()\r\n\u001b[?2004l\r"]
[414.376656, "o", "\u001b[?2004h> "]
[414.376665, "o", "    \r\n"]
[414.376673, "o", "\u001b[?2004l\r\u001b[?2004h> "]
