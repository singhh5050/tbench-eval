[174.71448, "i", "cat > /app/train_models.py << 'EOL'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.linear_model import LinearRegression, Ridge\nfrom sklearn.ensemble import RandomForestRegressor\nfrom sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\nimport json\nimport pickle\n\n# Load data\ndf = pd.read_csv('/app/data/train.csv')\n\n# Split data using same parameters as before\ntrain_df, val_df = train_test_split(df, test_size=0.2, random_state=42, shuffle=True)\n\n# Separate features and target\nX_train = train_df.drop('MedHouseVal', axis=1)\ny_train = train_df['MedHouseVal']\nX_val = val_df.drop('MedHouseVal', axis=1)\ny_val = val_df['MedHouseVal']\n\n# Initialize models and store results\nmodels = {\n    'linear_regression': LinearRegression(),\n    'ridge': Ridge(),\n    'random_forest': RandomForestRegressor(n_estimators=100, random_state=42)\n}\n\nmodel_results = {}\n\n# Train and evaluate each model\nfor name, model in models.items():\n    # Train\n    model.fit(X_"]
[174.714625, "i", "train, y_train)\n    \n    # Training R²\n    train_r2 = model.score(X_train, y_train)\n    \n    # Validation predictions\n    val_pred = model.predict(X_val)\n    \n    # Validation metrics\n    val_r2 = r2_score(y_val, val_pred)\n    mae = mean_absolute_error(y_val, val_pred)\n    mse = mean_squared_error(y_val, val_pred)\n    rmse = np.sqrt(mse)\n    \n    # Store results\n    model_results[name] = {\n        'train_r2': train_r2,\n        'val_r2': val_r2,\n        'mae': mae,\n        'mse': mse,\n        'rmse': rmse\n    }\n\n# Save model comparison\nwith open('/app/output/model_comparison.json', 'w') as f:\n    json.dump({\n        'models': [{\n            'model_name': name,\n            'train_r2': result['train_r2'],\n            'val_r2': result['val_r2'],\n            'mae': result['mae'],\n            'mse': result['mse'],\n            'rmse': result['rmse']\n        } for name, result in model_results.items()],\n        'best_model_name': max(model_results.keys(), key=lambda x: model_results[x]['val_r2'])\n    }, f, indent=2)"]
[174.714664, "o", "cat > /app/train_models.py << 'EOL'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[174.714683, "i", "\n\n# Select best model based on validation R²\nbest_model_name = max(model_results.keys(), key=lambda x: model_results[x]['val_r2'])\nbest_model = models[best_model_name]\n\n# Save all models\nfor name in models.keys():\n    model_path = f'/app/models/{name}.pkl'\n    with open(model_path, 'wb') as f:\n        pickle.dump(models[name], f)\n    \n# Save best model separately\nwith open('/app/models/best_model.pkl', 'wb') as f:\n    pickle.dump(models[best_model_name], f)\n\n# Print summary\nprint(f\"Best model: {best_model_name} with validation R²: {model_results[best_model_name]['val_r2']:.4f}\")\nEOL\n"]
