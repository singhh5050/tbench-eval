[414.376695, "o", "\u001b[?2004h> "]
[414.376734, "o", "        'predictions': predictions,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[414.37676, "o", "        'model_name': 'random_forest',\r\n\u001b[?2004l\r"]
[414.376773, "o", "\u001b[?2004h> "]
[414.376792, "o", "        'count': len(predictions)\r\n\u001b[?2004l\r"]
[414.376804, "o", "\u001b[?2004h> "]
