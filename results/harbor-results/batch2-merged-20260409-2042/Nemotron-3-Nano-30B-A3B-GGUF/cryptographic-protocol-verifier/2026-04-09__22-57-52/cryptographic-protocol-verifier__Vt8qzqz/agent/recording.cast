[76.139832, "i", "cat > /app/verify_zk_protocols.py << 'EOF'\nimport struct\nimport json\nimport re\nfrom datetime import datetime\nfrom collections import defaultdict\n\n# Security parameters\nSOUNDNESS_ERROR = \"1e-25\"\nSIMULATOR_EFFICIENCY = 1.5\nEXTRACTION_PROBABILITY = 0.95\nBINDING_ADVANTAGE = \"1e-30\"\n\n# Parse a single protocol file\ndef parse_protocol_file(filename):\n    with open(filename, 'rb') as f:\n        data = f.read()\n    \n    # Parse fixed header\n    protocol_type = data[0:16].decode('ascii').strip('\\x00')\n    timestamp = struct.unpack('<Q', data[16:24])[0]\n    json_len = struct.unpack('<I', data[24:28])[0]\n    \n    # Extract JSON data\n    json_start = 28\n    json_end = json_start + json_len\n    json_data = data[json_start:json_end]\n    \n    # Parse JSON\n    try:\n        json_info = json.loads(json_data.decode('utf-8'))\n        protocol_id = json_info.get('protocol_id', filename)\n    except:\n        protocol_id = filename\n    \n    # Skip padding and random data\n    return {\n        'protocol_type': protocol_type,\n        'p"]
