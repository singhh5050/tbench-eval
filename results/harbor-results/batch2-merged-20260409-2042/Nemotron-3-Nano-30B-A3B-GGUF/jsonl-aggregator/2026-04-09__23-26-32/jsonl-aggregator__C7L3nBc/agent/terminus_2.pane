[?2004hroot@de241286df24:/app# cat > /app/aggregate.py << 'EOF'
[?2004l[?2004h> import json, glob, collections
[?2004l[?2004h> 
[?2004l[?2004h> # Initialize counters
[?2004l[?2004h> user_amounts = collections.defaultdict(float)
[?2004l[?2004h> tag_counts = collections.defaultdict(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Process each JSONL file
[?2004l[?2004h> for file_path in sorted(glob.glob('/app/records_*.jsonl')):
[?2004l[?2004h>     with open(file_path, 'r') as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             record = json.loads(line.strip())
[?2004l[?2004h>             # Aggregate user amounts
[?2004l[?2004h>             user = record.get('user', 'unknown')
[?2004l[?2004h>             amount = round(record.get('amount', 0), 2)
[?2004l[?2004h>             user_amounts[user] += amount
[?2004l[?2004h>             # Aggregate tags
[?2004l[?2004h>             for tag in record.get('tags', []):
[?2004l[?2004h>                 tag_counts[tag] += 1
[?2004l[?2004h> 
[?2004l[?2004h> # Compute top 5 users by total amount
[?2004l[?2004h>  top_users = dict(collections.OrderedDict(
[?2004l[?2004h>     sorted(user_amounts.items(), key=lambda x: x[1], reverse=True)[:5]
[?2004l[?2004h> ))
[?2004l[?2004h> # Round amounts to 2 decimals and ensure integer item count (not needed here)
[?2004l[?2004h>  top_users_formatted = {k: {"total_amount": round(v, 2), "total_items": 0} for k, v in top_users.items()}
[?2004l[?2004h> 
[?2004l[?2004h> # Compute top 5 tags by count
[?2004l[?2004h>  top_tags = dict(collections.OrderedDict(
[?2004l[?2004h>     sorted(tag_counts.items(), key=lambda x: x[1], reverse=True)[:5]
[?2004l[?2004h> ))
[?2004l[?2004h>  top_tags_formatted = {k: {"count": v} for k, v in top_tags.items()}
[?2004l[?2004h> 
[?2004l[?2004h> # Build final structure
[?2004l[?2004h> result = {
[?2004l[?2004h>     "top_5_users_by_amount": top_users_formatted,
[?2004l[?2004h>     "top_5_tags_by_count": top_tags_formatted
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Write to aggregates.json
[?2004l[?2004h> with open('/app/aggregates.json', 'w') as f:
[?2004l[?2004h>     json.dump(result, f, separators=(',', ':'))
