[239.507542, "o", "> "]
[239.50758, "o", "if [ \"$EXPECTED_SHA256\" != \"$ACTUAL_SHA256\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[239.507597, "o", "> "]
[239.50765, "o", "    echo \"VERIFICATION_FAILED: SHA256 checksum mismatch\" >&2\r\n\u001b[?2004l\r\u001b[?2004h"]
[239.50768, "o", ">     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
[239.507699, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[239.507733, "o", "# Check required fields exist\r\n\u001b[?2004l\r\u001b[?2004h"]
[239.507748, "o", "> "]
[239.507815, "o", "REQUIRED_FIELDS=\"buildID artifact sha256 signedAt signer certificateChain\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[239.507831, "o", "> "]
[239.507865, "o", "for field in $REQUIRED_FIELDS; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[239.507918, "o", "    if ! jq -e \".$field\" \"$PROVENANCE_FILE\" >/dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[239.507935, "o", "\u001b[?2004h> "]
[239.508008, "o", "        echo \"VERIFICATION_FAILED: Missing required field $field in provenance\" >&2\r\n\u001b[?2004l\r"]
[239.508025, "o", "\u001b[?2004h> "]
[239.508041, "o", "        exit 1\r\n\u001b[?2004l\r"]
[239.508061, "o", "\u001b[?2004h>     fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[239.508084, "o", "done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[239.508104, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[239.508121, "o", "# All verifications passed\r\n\u001b[?2004l\r"]
[239.508136, "o", "\u001b[?2004h> "]
[239.508231, "o", "echo \"VERIFICATION_PASSED\"\r\n\u001b[?2004l\r\u001b[?2004h> exit 0\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
