[381.638491, "o", "\u001b[?2004h> "]
[381.638509, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
