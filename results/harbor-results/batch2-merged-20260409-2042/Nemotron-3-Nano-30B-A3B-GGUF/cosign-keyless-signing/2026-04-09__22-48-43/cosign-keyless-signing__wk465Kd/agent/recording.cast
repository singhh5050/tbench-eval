[327.40371, "i", "cat > /app/verify_artifact.sh << 'EOF'\n#!/bin/bash\nset -e\n\n# Check if artifact path is provided\nif [ $# -ne 1 ]; then\n    echo \"Usage: $0 <artifact-path>\" >&2\n    exit 1\nfi\n\nARTIFACT_PATH=\"$1\"\nARTIFACT_NAME=$(basename \"$ARTIFACT_PATH\")\n\n# Verify required files exist\nfor f in \"$ARTIFACT_PATH\" \"/app/signed/${ARTIFACT_NAME}.sig\" \"/app/signed/${ARTIFACT_NAME}.provenance.json\" \"/app/signed/${ARTIFACT_NAME}.provenance.sig\" \"/app/signed/${ARTIFACT_NAME}.chain.pem\"; do\n    if [ ! -f \"$f\" ]; then\n        echo \"VERIFICATION_FAILED: Required file $f not found\" >&2\n        exit 1\n    fi\ndone\n\n# Extract signing certificate from chain (first certificate in chain file)\nSIGNING_CERT=\"/app/signing/cert_$(echo \"$ARTIFACT_NAME\" | sed 's/\\./\\\\./g' <<< \"build-\").pem\"\nif [ ! -f \"$SIGNING_CERT\" ]; then\n    echo \"VERIFICATION_FAILED: Signing certificate not found\" >&2\n    exit 1\nfi\n\n# Verify certificate chain using OpenSSL\nif ! openssl verify -CAfile <(cat \"/app/signed/${ARTIFACT_NAME}.chain.pem\" | tr -d '\\n') -untrusted \"/app/signed/${ARTIFACT_NAME}.chain.pem\" \"$SIGNING_CERT\" 2>/dev/null; then\n    echo \"VERIFICATION_FAILED: Certificate chain validation failed\" >&2\n    exit 1\nfi\n\n# Extract public key from signing certificate\nPUBKEY=$(openssl x509 -in \"$SIGNING_CERT\" -pubkey -noout)\n\n# Verify artifact signature\nif ! echo \"$PUBKEY\" | openssl pkey -pubin -outform DER | openssl dgst -sha256 -verify - -signature \"/app/signed/${ARTIFACT_NAME}.sig\" \"$ARTIFACT_PATH\"; then\n    echo \"VERIFICATION_FAILED: Artifact signature verification failed\" >&2\n    exit 1\nfi\n\n# Verify provenance signature\nif ! echo \"$PUBKEY\" | openssl pkey -pubin -outform DER | openssl dgst -sha256 -verify - -signature \"/app/signed/${ARTIFACT_NAME}.provenance.sig\" \"/app/signed/${ARTIFACT_NAME}.provenance.json\"; then\n    echo \"VERIFICATION_FAILED: Provenance signature verification failed\" >&2\n    exit 1\nfi\n\n# Validate provenance JSON content\nif ! jq -e '.artifact == \"'$ARTIFACT_NAME'\"' \"/app/signed/${ARTIFACT_NAME}.provenance.json\" >/dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED: Provenance artifact field mismatch\" >&2\n    exit 1\nfi\n\n# Verify SHA256 checksum\nEXPECTED_SHA256=$(jq -r '.sha256' \"/app/signed/${ARTIFACT_NAME}.provenance.json\")\nACTUAL_SHA256=$(sha256sum \"$ARTIFACT_PATH\" | cut -d' ' -f1)\nif [ \"$EXPECTED_SHA256\" != \"$ACTUAL_SHA256\" ]; then\n    echo \"VERIFICATION_FAILED: SHA256 checksum mismatch\" >&2\n    exit 1\nfi\n\n# Check required fields exist\nREQUIRED_FIELDS=\"buildID artifact sha256 signedAt signer certificateChain\"\nfor field in $REQUIRED_FIELDS; do\n    if ! jq -e \".$field\" \"/app/signed/${ARTIFACT_NAME}.provenance.json\" >/dev/null 2>&1; then\n        echo \"VERIFICATION_FAILED: Missing required field $field in provenance\" >&2\n        exit 1\n    fi\ndone\n\n# All validations passed\necho \"VERIFICATION_PASSED\"\nexit 0\nEOF\n"]
[327.403981, "o", "cat > /app/verify_artifact.sh << 'EOF'\r\n\u001b[?2004l\r"]
[327.404053, "o", "\u001b[?2004h> "]
[327.404087, "o", "#!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.404099, "o", "> set -e\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[327.40416, "o", "> # Check if artifact path is provided\r\n\u001b[?2004l\r"]
[327.404196, "o", "\u001b[?2004h> if [ $# -ne 1 ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.40423, "o", "    echo \"Usage: $0 <artifact-path>\" >&2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.404256, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.404282, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.404305, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> ARTIFACT_PATH=\"$1\"\r\n\u001b[?2004l\r"]
[327.404327, "o", "\u001b[?2004h> "]
[327.404358, "o", "ARTIFACT_NAME=$(basename \"$ARTIFACT_PATH\")\r\n\u001b[?2004l\r"]
[327.40438, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[327.404399, "o", "\u001b[?2004h> "]
[327.404418, "o", "# Verify required files exist\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.404438, "o", "> "]
[327.404619, "o", "for f in \"$ARTIFACT_PATH\" \"/app/signed/${ARTIFACT_NAME}.sig\" \"/app/signed/${ARTIFACT_NAME}.provenance.json\" \"/app/signed/${ARTIFACT_NAME}.provenance.sig\" \"/app/signed/${ARTIFACT_NAME}.chain.pem\"; do\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.40465, "o", "> "]
[327.404675, "o", "    if [ ! -f \"$f\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.404753, "o", "        echo \"VERIFICATION_FAILED: Required file $f not found\" >&2\r\n\u001b[?2004l\r\u001b[?2004h>         exit 1\r\n\u001b[?2004l\r"]
[327.404796, "o", "\u001b[?2004h>     fi\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.404821, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.404908, "o", "# Extract signing certificate from chain (first certificate in chain file)\r\n\u001b[?2004l\r"]
[327.404936, "o", "\u001b[?2004h> "]
[327.405019, "o", "SIGNING_CERT=\"/app/signing/cert_$(echo \"$ARTIFACT_NAME\" | sed 's/\\./\\\\./g' <<< \"build-\").pem\"\r\n\u001b[?2004l\r"]
[327.405031, "o", "\u001b[?2004h> "]
[327.405063, "o", "if [ ! -f \"$SIGNING_CERT\" ]; then\r\n\u001b[?2004l\r"]
[327.405089, "o", "\u001b[?2004h> "]
[327.405132, "o", "    echo \"VERIFICATION_FAILED: Signing certificate not found\" >&2\r\n\u001b[?2004l\r"]
[327.405193, "o", "\u001b[?2004h> "]
[327.405221, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.405249, "o", "# Verify certificate chain using OpenSSL\r\n\u001b[?2004l\r"]
[327.405261, "o", "\u001b[?2004h> "]
[327.405525, "o", "if ! openssl verify -CAfile <(cat \"/app/signed/${ARTIFACT_NAME}.chain.pem\" | tr -d '\\n') -untrusted \"/app/signed/${ARTIFACT_NAME}.chain.pem\" \"$SIGNING_CERT\" 2>/dev/null; then\r\n\u001b[?2004l\r"]
[327.405537, "o", "\u001b[?2004h> "]
[327.405615, "o", "    echo \"VERIFICATION_FAILED: Certificate chain validation failed\" >&2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.405643, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[327.405657, "o", "> "]
[327.405693, "o", "# Extract public key from signing certificate\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.405716, "o", "> "]
[327.405759, "o", "PUBKEY=$(openssl x509 -in \"$SIGNING_CERT\" -pubkey -noout)\r\n\u001b[?2004l\r"]
[327.405779, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[327.405802, "o", "\u001b[?2004h> "]
[327.405854, "o", "# Verify artifact signature\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.406013, "o", "if ! echo \"$PUBKEY\" | openssl pkey -pubin -outform DER | openssl dgst -sha256 -verify - -signature \"/app/signed/${ARTIFACT_NAME}.sig\" \"$ARTIFACT_PATH\"; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.4061, "o", "    echo \"VERIFICATION_FAILED: Artifact signature verification failed\" >&2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.406115, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.406125, "o", "> fi\r\n\u001b[?2004l\r"]
[327.406183, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.406197, "o", "# Verify provenance signature\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.406231, "o", "> "]
[327.406407, "o", "if ! echo \"$PUBKEY\" | openssl pkey -pubin -outform DER | openssl dgst -sha256 -verify - -signature \"/app/signed/${ARTIFACT_NAME}.provenance.sig\" \"/app/signed/${ARTIFACT_NAME}.provenance.json\"; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.406474, "o", "    echo \"VERIFICATION_FAILED: Provenance signature verification failed\" >&2\r\n\u001b[?2004l\r"]
[327.406485, "o", "\u001b[?2004h> "]
[327.406495, "o", "    exit 1\r\n\u001b[?2004l\r"]
[327.406533, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[327.406544, "o", "\u001b[?2004h> "]
[327.406583, "o", "# Validate provenance JSON content\r\n\u001b[?2004l\r"]
[327.406605, "o", "\u001b[?2004h> "]
[327.406711, "o", "if ! jq -e '.artifact == \"'$ARTIFACT_NAME'\"' \"/app/signed/${ARTIFACT_NAME}.provenance.json\" >/dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.406722, "o", "> "]
[327.406784, "o", "    echo \"VERIFICATION_FAILED: Provenance artifact field mismatch\" >&2\r\n\u001b[?2004l\r"]
[327.406795, "o", "\u001b[?2004h> "]
[327.406822, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.406832, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.406858, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.406883, "o", "# Verify SHA256 checksum\r\n\u001b[?2004l\r"]
[327.406896, "o", "\u001b[?2004h> "]
[327.406973, "o", "EXPECTED_SHA256=$(jq -r '.sha256' \"/app/signed/${ARTIFACT_NAME}.provenance.json\")\r\n\u001b[?2004l\r"]
[327.406983, "o", "\u001b[?2004h> "]
[327.407042, "o", "ACTUAL_SHA256=$(sha256sum \"$ARTIFACT_PATH\" | cut -d' ' -f1)\r\n\u001b[?2004l\r"]
[327.407053, "o", "\u001b[?2004h> "]
[327.407108, "o", "if [ \"$EXPECTED_SHA256\" != \"$ACTUAL_SHA256\" ]; then\r\n\u001b[?2004l\r"]
[327.407119, "o", "\u001b[?2004h> "]
[327.407179, "o", "    echo \"VERIFICATION_FAILED: SHA256 checksum mismatch\" >&2\r\n\u001b[?2004l\r"]
[327.407189, "o", "\u001b[?2004h> "]
[327.407217, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.407228, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.407254, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.407283, "o", "# Check required fields exist\r\n\u001b[?2004l\r"]
[327.407293, "o", "\u001b[?2004h> "]
[327.407384, "o", "REQUIRED_FIELDS=\"buildID artifact sha256 signedAt signer certificateChain\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.407396, "o", "> "]
[327.407433, "o", "for field in $REQUIRED_FIELDS; do\r\n\u001b[?2004l\r"]
[327.407443, "o", "\u001b[?2004h> "]
[327.407543, "o", "    if ! jq -e \".$field\" \"/app/signed/${ARTIFACT_NAME}.provenance.json\" >/dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.407554, "o", "> "]
[327.407622, "o", "        echo \"VERIFICATION_FAILED: Missing required field $field in provenance\" >&2\r\n\u001b[?2004l\r"]
[327.407636, "o", "\u001b[?2004h> "]
[327.407663, "o", "        exit 1\r\n\u001b[?2004l\r\u001b[?2004h>     fi\r\n\u001b[?2004l\r"]
[327.407672, "o", "\u001b[?2004h> done\r\n\u001b[?2004l\r"]
[327.407682, "o", "\u001b[?2004h> \r\n"]
[327.407697, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[327.407747, "o", "# All validations passed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.407757, "o", "echo \"VERIFICATION_PASSED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.407786, "o", "exit 0\r\n\u001b[?2004l\r"]
[327.407803, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[327.408882, "o", "\u001b[?2004hroot@8884a9b806ea:/app# "]
[327.505263, "i", "chmod +x /app/verify_artifact.sh\n"]
[327.505558, "o", "chmod +x /app/verify_artifact.sh\r\n\u001b[?2004l\r"]
[327.506307, "o", "\u001b[?2004hroot@8884a9b806ea:/app# "]
[327.591532, "i", "/app/sign_artifact.sh /app/artifacts/test.txt build-001\n"]
[327.591811, "o", "/app/sign_artifact.sh /app/artifacts/test.txt build-001\r\n\u001b[?2004l\r"]
[327.610397, "o", "Certificate request self-signature ok\r\nsubject=CN=build-build-001, O=SecureB"]
[327.610466, "o", "uild, C=US\r\n"]
[327.624298, "o", "Successfully signed test.txt with build ID build-001\r\n"]
[327.62458, "o", "\u001b[?2004hroot@8884a9b806ea:/app# "]
[329.606034, "i", "/app/verify_artifact.sh /app/artifacts/test.txt\n"]
[329.606433, "o", "/app/verify_artifact.sh /app/artifacts/test.txt\r\n\u001b[?2004l\r"]
[329.609752, "o", "VERIFICATION_FAILED: Signing certificate not found\r\n"]
[329.60992, "o", "\u001b[?2004hroot@8884a9b806ea:/app# "]
[381.638019, "i", "cat > /app/verify_artifact.sh << 'EOF'\n#!/bin/bash\nset -e\n\n# Check if artifact path is provided\nif [ $# -ne 1 ]; then\n    echo \"Usage: $0 <artifact-path>\" >&2\n    exit 1\nfi\n\nARTIFACT_PATH=\"$1\"\nARTIFACT_NAME=$(basename \"$ARTIFACT_PATH\")\n\n# Verify required files exist\nfor f in \"$ARTIFACT_PATH\" \"/app/signed/${ARTIFACT_NAME}.sig\" \"/app/signed/${ARTIFACT_NAME}.provenance.json\" \"/app/signed/${ARTIFACT_NAME}.provenance.sig\" \"/app/signed/${ARTIFACT_NAME}.chain.pem\"; do\n    if [ ! -f \"$f\" ]; then\n        echo \"VERIFICATION_FAILED: Required file $f not found\" >&2\n        exit 1\n    fi\ndone\n\n# Extract signing certificate from chain file (first certificate in PEM format)\nSIGNING_CERT=\"/tmp/signing-cert-extracted.pem\"\nawk '/-----BEGIN CERTIFICATE-----/{flag=1} flag/{print} /-----END CERTIFICATE/{flag=0; exit}' \"/app/signed/${ARTIFACT_NAME}.chain.pem\" > \"$SIGNING_CERT\"\n\nif [ ! -s \"$SIGNING_CERT\" ]; then\n    echo \"VERIFICATION_FAILED: Could not extract signing certificate\" >&2\n    exit 1\nfi\n\n# Verify certificate chain using the extracted certificate\nif ! openssl verify -CAfile <(cat \"/app/signed/${ARTIFACT_NAME}.chain.pem\" | tr -d '\\n') -untrusted \"/app/signed/${ARTIFACT_NAME}.chain.pem\" \"$SIGNING_CERT\" 2>/dev/null; then\n    echo \"VERIFICATION_FAILED: Certificate chain validation failed\" >&2\n    exit 1\nfi\n\n# Extract public key from signing certificate\nPUBKEY=$(openssl x509 -in \"$SIGNING_CERT\" -pubkey -noout)\n\n# Verify artifact signature\nif ! echo \"$PUBKEY\" | openssl pkey -pubin -outform DER | openssl dgst -sha256 -verify - -signature \"/app/signed/${ARTIFACT_NAME}.sig\" \"$ARTIFACT_PATH\"; then\n    echo \"VERIFICATION_FAILED: Artifact signature verification failed\" >&2\n    exit 1\nfi\n\n# Verify provenance signature\nif ! echo \"$PUBKEY\" | openssl pkey -pubin -outform DER | openssl dgst -sha256 -verify - -signature \"/app/signed/${ARTIFACT_NAME}.provenance.sig\" \"/app/signed/${ARTIFACT_NAME}.provenance.json\"; then\n    echo \"VERIFICATION_FAILED: Provenance signature verification failed\" >&2\n    exit 1\nfi\n\n# Validate provenance JSON content\nif ! jq -e '.artifact == \"'$ARTIFACT_NAME'\"' \"/app/signed/${ARTIFACT_NAME}.provenance.json\" >/dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED: Provenance artifact field mismatch\" >&2\n    exit 1\nfi\n\n# Verify SHA256 checksum\nEXPECTED_SHA256=$(jq -r '.sha256' \"/app/signed/${ARTIFACT_NAME}.provenance.json\")\nACTUAL_SHA256=$(sha256sum \"$ARTIFACT_PATH\" | cut -d' ' -f1)\nif [ \"$EXPECTED_SHA256\" != \"$ACTUAL_SHA256\" ]; then\n    echo \"VERIFICATION_FAILED: SHA256 checksum mismatch\" >&2\n    exit 1\nfi\n\n# Check required fields exist\nREQUIRED_FIELDS=\"buildID artifact sha256 signedAt signer certificateChain\"\nfor field in $REQUIRED_FIELDS; do\n    if ! jq -e \".$field\" \"/app/signed/${ARTIFACT_NAME}.provenance.json\" >/dev/null 2>&1; then\n        echo \"VERIFICATION_FAILED: Missing required field $field in provenance\" >&2\n        exit 1\n    fi\ndone\n\n# All validations passed\necho \"VERIFICATION_PASSED\"\nexit 0\nEOF\n"]
[381.638291, "o", "cat > /app/verify_artifact.sh << 'EOF'\r\n\u001b[?2004l\r"]
[381.638327, "o", "\u001b[?2004h> #!/bin/bash\r\n"]
