[204.511518, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[204.511538, "o", "\u001b[?2004h> # Sign the artifact\r\n\u001b[?2004l\r"]
[204.511557, "o", "\u001b[?2004h> "]
[204.511595, "o", "SIGNATURE_FILE=\"/app/signed/${ARTIFACT_NAME}.sig\"\r\n\u001b[?2004l\r"]
[204.511618, "o", "\u001b[?2004h> "]
[204.511706, "o", "openssl dgst -sha256 -sign \"$PRIVATE_KEY_FILE\" -out \"$SIGNATURE_FILE\" \"$ARTIFACT_PATH\"\r\n\u001b[?2004l\r"]
[204.511725, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[204.511744, "o", "\u001b[?2004h> "]
[204.511777, "o", "# Create provenance attestation JSON\r\n\u001b[?2004l\r"]
[204.511786, "o", "\u001b[?2004h> "]
[204.511858, "o", "PROVENANCE_FILE=\"/app/signed/${ARTIFACT_NAME}.provenance.json\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.511876, "o", "> "]
[204.511908, "o", "TIMESTAMP=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\r\n\u001b[?2004l\r"]
[204.511928, "o", "\u001b[?2004h> "]
[204.511952, "o", "cat > \"$PROVENANCE_FILE\" << JSON\r\n\u001b[?2004l\r"]
[204.511969, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.511999, "o", "  \"buildID\": \"$BUILD_ID\",\r\n\u001b[?2004l\r"]
[204.512017, "o", "\u001b[?2004h> "]
[204.51204, "o", "  \"artifact\": \"$ARTIFACT_NAME\",\r\n\u001b[?2004l\r"]
[204.512057, "o", "\u001b[?2004h> "]
[204.512084, "o", "  \"sha256\": \"$SHA256_CHECKSUM\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.512102, "o", "> "]
[204.51212, "o", "  \"signedAt\": \"$TIMESTAMP\",\r\n\u001b[?2004l\r"]
[204.512137, "o", "\u001b[?2004h> "]
[204.512161, "o", "  \"signer\": \"build-$BUILD_ID\",\r\n\u001b[?2004l\r"]
[204.512181, "o", "\u001b[?2004h> "]
[204.512221, "o", "  \"certificateChain\": [\"intermediate-ca\", \"root-ca\"]\r\n\u001b[?2004l\r"]
[204.512239, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.512249, "o", "> JSON\r\n\u001b[?2004l\r"]
[204.512274, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.512299, "o", "# Sign the provenance JSON\r\n\u001b[?2004l\r"]
[204.512316, "o", "\u001b[?2004h> "]
[204.512379, "o", "PROVENANCE_SIG_FILE=\"/app/signed/${ARTIFACT_NAME}.provenance.sig\"\r\n\u001b[?2004l\r"]
[204.512397, "o", "\u001b[?2004h> "]
[204.512475, "o", "openssl dgst -sha256 -sign \"$PRIVATE_KEY_FILE\" -out \"$PROVENANCE_SIG_FILE\" \"$PROVENANCE_FILE\"\r\n\u001b[?2004l\r"]
[204.512497, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.512531, "o", "# Create certificate chain bundle\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.512552, "o", "> "]
[204.512592, "o", "CHAIN_FILE=\"/app/signed/${ARTIFACT_NAME}.chain.pem\"\r\n\u001b[?2004l\r"]
[204.512617, "o", "\u001b[?2004h> "]
[204.51268, "o", "cat \"$CERT_FILE\" \"/app/ca/intermediate-ca.pem\" \"/app/ca/root-ca.pem\" > \"$CHAIN_FILE\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.512699, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.512731, "o", "# Delete ephemeral private key\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.512753, "o", "> "]
[204.512771, "o", "rm -f \"$PRIVATE_KEY_FILE\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[204.512792, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[204.512814, "o", "# Clean up temporary files\r\n\u001b[?2004l\r"]
[204.512832, "o", "\u001b[?2004h> "]
[204.512863, "o", "rm -f \"/app/signing/csr_$BUILD_ID.csr\"\r\n\u001b[?2004l\r"]
[204.512881, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[204.512901, "o", "# Output success\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.512927, "o", "> "]
[204.512974, "o", "chmod +x \"$SIGNATURE_FILE\" \"$PROVENANCE_SIG_FILE\" \"$CHAIN_FILE\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[204.512998, "o", "> "]
[204.513079, "o", "echo \"Successfully signed $ARTIFACT_NAME with build ID $BUILD_ID\"\r\n\u001b[?2004l\r"]
[204.5131, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[204.514254, "o", "\u001b[?2004hroot@8884a9b806ea:/app# "]
[204.603325, "i", "chmod +x /app/sign_artifact.sh\n"]
[204.603623, "o", "chmod +x /app/sign_artifact.sh\r\n\u001b[?2004l\r"]
[204.604385, "o", "\u001b[?2004hroot@8884a9b806ea:/app# "]
[204.710892, "i", "echo \"Creating sample artifact for testing...\"\n"]
[204.711085, "o", "echo \"Creating sample artifact for testing...\"\r\n\u001b[?2004l\r"]
[204.711201, "o", "Creating sample artifact for testing...\r\n"]
[204.711216, "o", "\u001b[?2004hroot@8884a9b806ea:/app# "]
[204.803279, "i", "echo \"Sample content for testing\" > /app/artifacts/test.txt\n"]
