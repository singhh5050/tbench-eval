[381.639464, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify certificate chain using the extracted certificate\r\n\u001b[?2004l\r"]
[381.63952, "o", "\u001b[?2004h> "]
[381.639636, "o", "if ! openssl verify -CAfile <(cat \"/app/signed/${ARTIFACT_NAME}.chain.pem\" | tr -d '\\n') -untrusted \"/app/signed/${ARTIFACT_NAME}.chain.pem\" \"$SIGNING_CERT\" 2>/dev/null; then\r\n\u001b[?2004l\r"]
[381.639658, "o", "\u001b[?2004h> "]
