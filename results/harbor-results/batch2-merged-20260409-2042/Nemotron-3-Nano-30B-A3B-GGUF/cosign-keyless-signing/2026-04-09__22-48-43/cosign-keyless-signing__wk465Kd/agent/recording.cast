[88.116097, "o", "Creating Root CA...\r\n"]
[88.12313, "o", "Error checking x509 extension section v3_req\r\n40F7E29DF47D0000:error:1100006F:X509 V3 routines:v2i_ASN1_BIT_STRING:unknown bit string argument:../crypto/x509/v3_bitst.c:82:certificateSign\r\n40F7E29DF47D0000:error:11000080:X509 V3 routines:X509V3_EXT_nconf_int:error in extension:../crypto/x509/v3_conf.c:48:section=v3_req, name=keyUsage, value=certificateSign, cRLSign\r\n"]
