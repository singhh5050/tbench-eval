[381.639762, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[381.639781, "o", "\u001b[?2004h> "]
[381.639812, "o", "# Extract public key from signing certificate\r\n\u001b[?2004l\r"]
[381.63983, "o", "\u001b[?2004h> "]
[381.639867, "o", "PUBKEY=$(openssl x509 -in \"$SIGNING_CERT\" -pubkey -noout)\r\n\u001b[?2004l\r"]
[381.639885, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[381.639906, "o", "# Verify artifact signature\r\n\u001b[?2004l\r"]
[381.639926, "o", "\u001b[?2004h> "]
[381.640034, "o", "if ! echo \"$PUBKEY\" | openssl pkey -pubin -outform DER | openssl dgst -sha256 -verify - -signature \"/app/signed/${ARTIFACT_NAME}.sig\" \"$ARTIFACT_PATH\"; then\r\n\u001b[?2004l\r"]
[381.640056, "o", "\u001b[?2004h> "]
[381.640105, "o", "    echo \"VERIFICATION_FAILED: Artifact signature verification failed\" >&2\r\n\u001b[?2004l\r"]
[381.640126, "o", "\u001b[?2004h> "]
[381.640147, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[381.640168, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
