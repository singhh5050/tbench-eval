[381.638948, "o", "\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[381.638967, "o", "> "]
[381.63902, "o", "# Extract signing certificate from chain file (first certificate in PEM format)\r\n\u001b[?2004l\r"]
[381.639039, "o", "\u001b[?2004h> "]
