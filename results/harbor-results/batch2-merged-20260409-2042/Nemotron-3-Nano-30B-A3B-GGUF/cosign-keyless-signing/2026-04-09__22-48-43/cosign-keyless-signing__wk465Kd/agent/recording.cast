[381.63909, "o", "\u001b[?2004h> "]
[381.639248, "o", "awk '/-----BEGIN CERTIFICATE-----/{flag=1} flag/{print} /-----END CERTIFICATE/{flag=0; exit}' \"/app/signed/${ARTIFACT_NAME}.chain.pem\" > \"$SIGNING_CERT\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[381.639315, "o", "if [ ! -s \"$SIGNING_CERT\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
