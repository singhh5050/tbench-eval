[166.211082, "i", " arg2)))\n                 (else\n                  (apply-primitive op (map (lambda (x) (eval x env)) (cdr expr))))))\n        (else expr)))\n\n(define (env-lookup var env)\n  (if (env? env)\n      (let ((bindings (env-bindings env))\n            (parent (env-parent env)))\n        (if (member var bindings)\n            (cdr (assoc var bindings))\n            (env-lookup var parent)))\n      #f))\n\n(define (env-define! env var val)\n  (if (env? env)\n      (let ((bindings (env-bindings env)))\n        (set! bindings (cons (cons var val) bindings))\n        (env-bindings-set! env bindings))\n      (error \"define: undefined environment\")))\n\n(define (env-set! env var val)\n  (let ((parent (env-parent env)))\n    (if (env? parent)\n        (env-set! parent var val)\n        (env-define! env var val))))\n\n(define (make-global-env)\n  (let ((bindings '()))\n    (environment 'bindings '() parent)))\n\n(define (environment bindings parent)\n  (let ((env (make-environment))\n        (env-bindings env) bindings)\n    (set! (env-parent env) parent)"]
