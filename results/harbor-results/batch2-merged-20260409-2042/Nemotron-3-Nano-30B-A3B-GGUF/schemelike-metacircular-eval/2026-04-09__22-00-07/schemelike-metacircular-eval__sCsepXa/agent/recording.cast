[166.21122, "i", "\n    env))\n\n(define (self-evaluating? expr)\n  (cond ((number? expr) #t)\n        ((string? expr) #t)\n        ((symbol? expr) #f)\n        ((pair? expr) #f)\n        (else #t)))\n\n(define (primitive-procedure name)\n  (cond ((eq? name \"+\") (lambda (x y) (+ x y)))\n        ((eq? name \"-\") (lambda (x y) (- x y)))\n        ((eq? name \"*\") (lambda (x y) (* x y)))\n        ((eq? name \"/\") (lambda (x y) (/ x y)))\n        (else (error \"Unknown primitive\" name))))\n\n(define (apply-primitive op args)\n  (let ((proc (primitive-procedure op)))\n    (proc (car args) (cadr args))))\n\n(define (eval-file filename)\n  (let ((port (open-input-file filename)))\n    (let ((expr (read port)))\n      (close-input-port port)\n      (let ((result (eval expr (global-environment))))\n        (display result)\n        (newline))))\n\n(define (main)\n  (let ((filename (read-line (current-input-port))))\n    (eval-file filename)))\n\n(main)\nEOF\n"]
