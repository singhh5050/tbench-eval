[86.542999, "i", "  # Output result as JSON\n    print(json.dumps(result))\n    # If verification fails, ensure \"failed\" appears in stdout or exit non-zero\n    if not (root_matches and file_hash_matches):\n        # Already printed JSON, but we need to ensure exit code is non-zero\n        sys.exit(1)\n\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser(description='Merkle Tree CLI Tool')\n    subparsers = parser.add_subparsers(dest='command', help='Available commands')\n\n    # scan command\n    scan_parser = subparsers.add_parser('scan', help='Scan a directory and build Merkle tree')\n    scan_parser.add_argument('directory', help='Directory to scan')\n\n    # proof command\n    proof_parser = subparsers.add_parser('proof', help='Generate Merkle proof for a file')\n    proof_parser.add_argument('file_path', help='Relative file path as stored in merkle_data.json')\n\n    # verify command\n    verify_parser = subparsers.add_parser('verify', help='Verify file integrity using proof')\n    verify_parser.add_argument('file_path', help"]
[86.543007, "i", "='File path to verify (relative or absolute)')\n    verify_parser.add_argument('proof_file', help='JSON file containing proof data')\n\n    args = parser.parse_args()\n\n    if args.command == 'scan':\n        scan_directory(args.directory)\n    elif args.command == 'proof':\n        generate_proof(args.file_path)\n    elif args.command == 'verify':\n        verify_file(args.file_path, args.proof_file)\n    else:\n        parser.print_help()\n        sys.exit(1)\n\nEOF\n"]
