[86.542189, "i", "cat > /app/merkle_cli.py << 'EOF'\n#!/usr/bin/env python3\nimport argparse\nimport hashlib\nimport json\nimport os\nimport sys\nfrom pathlib import Path\n\n\ndef sha512(data: bytes) -> str:\n    return hashlib.sha512(data).hexdigest()\n\n\ndef build_merkle_tree(file_hashes):\n    # file_hashes: dict mapping relative path to leaf hash\n    # returns root_hash, proofs (dict mapping path to proof list), file_hashes (same as input)\n    # proof list format: [\"left\", sibling_hash], [\"right\", sibling_hash], ... from leaf to root\n\n    # Start with leaves\n    nodes = [{'path': p, 'hash': h} for p, h in file_hashes.items()]\n    proofs = {p: [] for p in file_hashes}\n\n    while len(nodes) > 1:\n        next_level = []\n        for i in range(0, len(nodes), 2):\n            left = nodes[i]\n            right = nodes[i+1] if i+1 < len(nodes) else left  # duplicate last if odd\n\n            # Compute parent hash\n            combined = left['hash'].encode('utf-8') + right['hash'].encode('utf-8')\n            parent_hash = sha512(combined)\n\n      "]
[86.54242, "o", "cat > /app/merkle_cli.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> import argparse\r\n\u001b[?2004l\r\u001b[?2004h> import hashlib\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.542526, "i", "      # Record sibling direction and hash for each child\n            # If current index is even, left is left child, right is right child\n            # So left's sibling is right -> direction \"right\"\n            #     right's sibling is left -> direction \"left\"\n            if i % 2 == 0:\n                # left child\n                proofs[left['path']].insert(0, [\"right\", right['hash']])\n                # right child (if different)\n                if i+1 < len(nodes):\n                    proofs[right['path']].insert(0, [\"left\", left['hash']])\n            else:\n                # This case should not happen as we process pairs sequentially\n                # but if it does, treat similarly\n                pass\n\n            next_level.append({'hash': parent_hash})\n        nodes = next_level\n\n    root_hash = nodes[0]['hash'] if nodes else ''\n    return root_hash, proofs, file_hashes\n\n\ndef scan_directory(directory_path):\n    directory = Path(directory_path)\n    if not directory.is_dir():\n        print(f'Error: {dir"]
