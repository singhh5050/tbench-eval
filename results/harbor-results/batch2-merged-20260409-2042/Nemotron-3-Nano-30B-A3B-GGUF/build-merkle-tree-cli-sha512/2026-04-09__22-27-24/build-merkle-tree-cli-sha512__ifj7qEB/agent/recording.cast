[149.055118, "o", "sed -i \"s/sys.stdout.write('\\\\\\\\n/&\\\\\\\\')/g\" /app/merkle_cli.py\r\n\u001b[?2004l\r"]
[149.056561, "o", "\u001b[?2004hroot@710a10b7d8a0:/app# "]
