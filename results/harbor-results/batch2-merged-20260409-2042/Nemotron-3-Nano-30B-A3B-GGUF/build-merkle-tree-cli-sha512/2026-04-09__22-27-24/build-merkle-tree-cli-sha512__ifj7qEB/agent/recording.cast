[86.546719, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[86.546762, "o", "    with open('/app/merkle_data.json', 'w') as f:\r\n\u001b[?2004l\r"]
[86.546781, "o", "\u001b[?2004h> "]
[86.546816, "o", "        json.dump(storage, f, indent=2)\r\n\u001b[?2004l\r"]
[86.546838, "o", "\u001b[?2004h> "]
[86.546896, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def generate_proof(file_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.546927, "o", "    # Load merkle_data.json\r\n\u001b[?2004l\r"]
[86.546948, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.546968, "o", "> "]
[86.547013, "o", "        with open('/app/merkle_data.json', 'r') as f:\r\n\u001b[?2004l\r"]
[86.547031, "o", "\u001b[?2004h> "]
[86.547058, "o", "            storage = json.load(f)\r\n\u001b[?2004l\r"]
[86.54708, "o", "\u001b[?2004h> "]
[86.547101, "o", "    except FileNotFoundError:\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.54712, "o", "> "]
[86.547204, "o", "        print(\"Error: merkle_data.json not found. Run 'scan' first.\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.547228, "o", "\u001b[?2004h> "]
[86.547248, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[86.547275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.547297, "o", "    # Validate root_hash length\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.547459, "o", "    if len(storage['root_hash']) != 128 or not all(c in '0123456789abcdef' for c in storage['root_hash']):\r\n\u001b[?2004l\r"]
[86.547478, "o", "\u001b[?2004h> "]
[86.547561, "o", "        print(\"Error: invalid root_hash format\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.547579, "o", "\u001b[?2004h> "]
[86.547604, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[86.547624, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.547642, "o", "\u001b[?2004h> "]
[86.547673, "o", "    # Validate file_hashes entries\r\n\u001b[?2004l\r"]
[86.547692, "o", "\u001b[?2004h> "]
[86.547756, "o", "    for k, v in storage['file_hashes'].items():\r\n\u001b[?2004l\r"]
[86.547778, "o", "\u001b[?2004h> "]
[86.547869, "o", "        if len(v) != 128 or not all(c in '0123456789abcdef' for c in v):\r\n\u001b[?2004l\r"]
[86.547888, "o", "\u001b[?2004h"]
[86.54791, "o", "> "]
[86.54798, "o", "            print(f\"Error: invalid hash for {k}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.548002, "o", "\u001b[?2004h> "]
[86.548027, "o", "            sys.exit(1)\r\n\u001b[?2004l\r"]
[86.548048, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.548094, "o", "    # Check if file_path exists in proofs\r\n\u001b[?2004l\r"]
[86.548113, "o", "\u001b[?2004h"]
[86.548135, "o", "> "]
[86.548171, "o", "    if file_path not in storage['proofs']:\r\n\u001b[?2004l\r"]
[86.54819, "o", "\u001b[?2004h> "]
[86.548278, "o", "        print(f\"Error: no proof found for {file_path}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.548299, "o", "\u001b[?2004h> "]
[86.548318, "o", "        sys.exit(1)\r\n"]
[86.548337, "o", "\u001b[?2004l\r\u001b[?2004h"]
[86.548361, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.548402, "o", "    proof = storage['proofs'][file_path]\r\n\u001b[?2004l\r"]
[86.548424, "o", "\u001b[?2004h> "]
[86.548459, "o", "    # Validate each proof hash\r\n\u001b[?2004l\r"]
[86.548475, "o", "\u001b[?2004h> "]
[86.548505, "o", "    for entry in proof:\r\n\u001b[?2004l\r"]
[86.548522, "o", "\u001b[?2004h"]
[86.548545, "o", "> "]
[86.548638, "o", "        if len(entry[1]) != 128 or not all(c in '0123456789abcdef' for c in entry[1]):\r\n\u001b[?2004l\r"]
[86.54866, "o", "\u001b[?2004h> "]
[86.548759, "o", "            print(f\"Error: invalid proof hash {entry[1]}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.548779, "o", "\u001b[?2004h> "]
[86.548805, "o", "            sys.exit(1)\r\n\u001b[?2004l\r"]
[86.548822, "o", "\u001b[?2004h> "]
[86.548831, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.548872, "o", "    # Output JSON to stdout\r\n\u001b[?2004l\r"]
[86.548895, "o", "\u001b[?2004h> "]
[86.548916, "o", "    output = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.548962, "o", "        \"file_path\": file_path,\r\n\u001b[?2004l\r"]
[86.548971, "o", "\u001b[?2004h> "]
[86.549006, "o", "        \"proof\": proof\r\n\u001b[?2004l\r"]
[86.549026, "o", "\u001b[?2004h"]
[86.549048, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.549068, "o", "> "]
[86.549106, "o", "    json.dump(output, sys.stdout, indent=None)\r\n\u001b[?2004l\r"]
[86.549124, "o", "\u001b[?2004h> "]
[86.549156, "o", "    sys.stdout.write('\\n')\r\n\u001b[?2004l\r"]
[86.549165, "o", "\u001b[?2004h> "]
[86.549184, "o", "\r\n\u001b[?2004l\r"]
[86.549192, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.549245, "o", "def verify_file(file_path, proof_file):\r\n\u001b[?2004l\r"]
[86.549263, "o", "\u001b[?2004h> "]
[86.549297, "o", "    # Load merkle_data.json\r\n\u001b[?2004l\r"]
[86.549305, "o", "\u001b[?2004h> "]
[86.549327, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.549335, "o", "> "]
[86.549409, "o", "        with open('/app/merkle_data.json', 'r') as f:\r\n\u001b[?2004l\r"]
[86.549416, "o", "\u001b[?2004h"]
[86.549424, "o", "> "]
[86.549473, "o", "            storage = json.load(f)\r\n\u001b[?2004l\r"]
[86.549492, "o", "\u001b[?2004h> "]
[86.549519, "o", "    except FileNotFoundError:\r\n\u001b[?2004l\r"]
[86.549527, "o", "\u001b[?2004h> "]
[86.549647, "o", "        print(\"Error: merkle_data.json not found. Run 'scan' first.\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.549669, "o", "> "]
[86.54969, "o", "        sys.exit(1)\r\n"]
[86.549711, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.549734, "o", "    # Load proof JSON\r\n\u001b[?2004l\r"]
[86.549753, "o", "\u001b[?2004h> "]
[86.549777, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.549828, "o", "        with open(proof_file, 'r') as f:\r\n\u001b[?2004l\r"]
[86.549852, "o", "\u001b[?2004h"]
[86.549874, "o", "> "]
[86.549926, "o", "            proof_data = json.load(f)\r\n\u001b[?2004l\r"]
[86.549953, "o", "\u001b[?2004h> "]
[86.549999, "o", "    except FileNotFoundError:\r\n\u001b[?2004l\r"]
[86.55002, "o", "\u001b[?2004h> "]
[86.550116, "o", "        print(f\"Error: proof file {proof_file} not found\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.550137, "o", "\u001b[?2004h> "]
[86.550162, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[86.550183, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.550229, "o", "    # Validate proof structure\r\n\u001b[?2004l\r"]
[86.55025, "o", "\u001b[?2004h> "]
[86.550342, "o", "    if 'proof' not in proof_data or not isinstance(proof_data['proof'], list):\r\n\u001b[?2004l\r"]
[86.550363, "o", "\u001b[?2004h> "]
[86.550437, "o", "        print(\"Error: invalid proof format\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.55046, "o", "\u001b[?2004h> "]
[86.550478, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[86.5505, "o", "\u001b[?2004h> "]
[86.550532, "o", "    proof = proof_data['proof']\r\n\u001b[?2004l\r"]
[86.550554, "o", "\u001b[?2004h> "]
[86.550613, "o", "    expected_file_path = proof_data.get('file_path')\r\n\u001b[?2004l\r"]
[86.550634, "o", "\u001b[?2004h> "]
[86.550672, "o", "    if expected_file_path is None:\r\n\u001b[?2004l\r"]
[86.550693, "o", "\u001b[?2004h> "]
[86.550777, "o", "        print(\"Error: proof file missing file_path\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.550798, "o", "\u001b[?2004h> "]
[86.550816, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[86.550843, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.550884, "o", "    # Resolve the file path\r\n\u001b[?2004l\r"]
[86.550906, "o", "\u001b[?2004h> "]
[86.55097, "o", "    # The file_path argument can be absolute or relative\r\n\u001b[?2004l\r"]
[86.550991, "o", "\u001b[?2004h> "]
[86.551025, "o", "    target_path = Path(file_path)\r\n\u001b[?2004l\rumentParser(des\u001b[?2004h"]
[86.551047, "o", "> "]
[86.551088, "o", "    if not target_path.exists():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.551187, "o", "        print(f\"Error: file {file_path} does not exist\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.551208, "o", "\u001b[?2004h> "]
[86.551227, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[86.551249, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.551287, "o", "    # Compute current hash\r\n\u001b[?2004l\r"]
[86.551308, "o", "\u001b[?2004h> "]
[86.551348, "o", "    data = target_path.read_bytes()\r\n\u001b[?2004l\r"]
[86.551369, "o", "\u001b[?2004h> "]
[86.551406, "o", "    current_hash = sha512(data)\r\n\u001b[?2004l\r"]
[86.551428, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.551505, "o", "    # Check if current_hash matches stored file_hashes\r\n\u001b[?2004l\r"]
[86.551525, "o", "\u001b[?2004h> "]
[86.551603, "o", "    stored_hash = storage['file_hashes'].get(expected_file_path)\r\n\u001b[?2004l\r"]
[86.551623, "o", "\u001b[?2004h> "]
[86.551654, "o", "    if stored_hash is None:\r\n\u001b[?2004l\r"]
[86.551675, "o", "\u001b[?2004h> "]
[86.551757, "o", "        # Maybe the stored path is relative to scanned directory\r\n\u001b[?2004l\r"]
[86.551777, "o", "\u001b[?2004h> "]
[86.551847, "o", "        # Try resolving relative to scanned_directory\r\n\u001b[?2004l\r"]
[86.551871, "o", "\u001b[?2004h> "]
[86.55192, "o", "        scanned_dir = storage['scanned_directory']\r\n\u001b[?2004l\r"]
[86.551941, "o", "\u001b[?2004h> "]
[86.552016, "o", "        full_path = os.path.join(scanned_dir, expected_file_path)\r\n\u001b[?2004l\r"]
[86.552037, "o", "\u001b[?2004h> "]
[86.552078, "o", "        if os.path.exists(full_path):\r\n\u001b[?2004l\r"]
[86.552098, "o", "\u001b[?2004h> "]
[86.552167, "o", "            stored_hash = sha512(open(full_path, 'rb').read())\r\n\u001b[?2004l\r"]
[86.552187, "o", "\u001b[?2004h> "]
[86.55221, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.552336, "o", "            print(f\"Error: stored file path {expected_file_path} not found\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.552357, "o", "\u001b[?2004h> "]
[86.552388, "o", "            sys.exit(1)\r\n\u001b[?2004l\r"]
[86.552417, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.552495, "o", "    file_hash_matches = (current_hash == stored_hash)\r\n\u001b[?2004l\r"]
[86.552515, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.552562, "o", "    # Reconstruct root from proof\r\n\u001b[?2004l\r"]
[86.552583, "o", "\u001b[?2004h> "]
[86.552655, "o", "    reconstructed_hashes = {expected_file_path: current_hash}\r\n\u001b[?2004l\r"]
[86.552675, "o", "\u001b[?2004h> "]
[86.55274, "o", "    current_hashes = {expected_file_path: current_hash}\r\n\u001b[?2004l\r"]
[86.552761, "o", "\u001b[?2004h> "]
[86.552824, "o", "    # We need to rebuild the path using proof entries\r\n\u001b[?2004l\r"]
[86.552864, "o", "\u001b[?2004h> "]
[86.552949, "o", "    # Use the same method as build_merkle_tree but in reverse\r\n\u001b[?2004l\r"]
[86.55297, "o", "\u001b[?2004h> "]
[86.553004, "o", "    # We'll simulate the levels\r\n\u001b[?2004l\r"]
[86.553024, "o", "\u001b[?2004h> "]
[86.553043, "o", "    node_hash = current_hash\r\n\u001b[?2004l\r"]
[86.553063, "o", "\u001b[?2004h> "]
[86.553082, "o", "    temp_proof = proof[:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.553102, "o", "> "]
[86.553161, "o", "    # Sort proof by direction? No, we need to process in order from leaf to root\r\n\u001b[?2004l\r"]
[86.553181, "o", "\u001b[?2004h> "]
[86.553216, "o", "    # We'll just iterate through proof entries\r\n\u001b[?2004l\r"]
[86.553237, "o", "\u001b[?2004h> "]
[86.553282, "o", "    # But we need to know sibling hashes; they are entry[1]\r\n\u001b[?2004l\r"]
[86.553302, "o", "\u001b[?2004h> "]
[86.553366, "o", "    # We'll treat each entry as sibling hash, and we need to combine with node_hash\r\n\u001b[?2004l\r"]
[86.553386, "o", "\u001b[?2004h> "]
[86.553443, "o", "    # However, we don't know whether current node was left or right child\r\n\u001b[?2004l\r"]
[86.553463, "o", "\u001b[?2004h> "]
[86.553504, "o", "    # We can use the direction to decide how to combine\r\n\u001b[?2004l\r"]
[86.553523, "o", "\u001b[?2004h> "]
[86.553595, "o", "    # Actually easier: during verification, we can recompute root by walking up using proof\r\n\u001b[?2004l\r"]
[86.553615, "o", "\u001b[?2004h> "]
[86.553668, "o", "    # We maintain a dict of known hashes, starting with the leaf hash\r\n\u001b[?2004l\r"]
[86.553689, "o", "\u001b[?2004h> "]
[86.553721, "o", "    known = {expected_file_path: current_hash}\r\n\u001b[?2004l\r"]
[86.553744, "o", "\u001b[?2004h> "]
[86.553762, "o", "    # We'll simulate up to root\r\n\u001b[?2004l\r"]
[86.553782, "o", "\u001b[?2004h> "]
[86.553857, "o", "    # At each step, we have a set of hashes at current level; we pair them\r\n\u001b[?2004l\r"]
[86.553886, "o", "\u001b[?2004h> "]
[86.553931, "o", "    # But since we only have one path, we can just use the proof entries directly\r\n\u001b[?2004l\r"]
[86.553951, "o", "\u001b[?2004h> "]
[86.554011, "o", "    # The proof entries give sibling hash and direction indicating position\r\n\u001b[?2004l\r"]
[86.55403, "o", "\u001b[?2004h> "]
[86.55415, "o", "    # We can reconstruct by: for each entry, if direction is \"left\", then current node is right child, so combine sibling_hash (left) + current_hash\r\n\u001b[?2004l\r"]
[86.554169, "o", "\u001b[?2004h> "]
[86.554247, "o", "    # If direction is \"right\", current node is left child, so combine current_hash + sibling_hash\r\n\u001b[?2004l\r"]
[86.554268, "o", "\u001b[?2004h> "]
[86.554288, "o", "    # Then hash the concatenation\r\n\u001b[?2004l\r"]
[86.554308, "o", "\u001b[?2004h> "]
[86.554336, "o", "    reconstructed_hash = current_hash\r\n\u001b[?2004l\r"]
[86.554356, "o", "\u001b[?2004h> "]
[86.554384, "o", "    for direction, sibling_hash in proof:\r\n\u001b[?2004l\r"]
[86.55442, "o", "\u001b[?2004h> "]
[86.554438, "o", "        if direction == \"left\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.554457, "o", "> "]
[86.5545, "o", "            # current node is right child, sibling is on left\r\n\u001b[?2004l\r"]
[86.55452, "o", "\u001b[?2004h> "]
[86.554568, "o", "            # So the pair is [sibling_hash, reconstructed_hash]\r\n\u001b[?2004l\r"]
[86.554588, "o", "\u001b[?2004h> "]
[86.554657, "o", "            combined = sibling_hash.encode('utf-8') + reconstructed_hash.encode('utf-8')\r\n\u001b[?2004l\r"]
[86.554677, "o", "\u001b[?2004h> "]
[86.5547, "o", "        elif direction == \"right\":\r\n\u001b[?2004l\r"]
[86.554719, "o", "\u001b[?2004h> "]
[86.554766, "o", "            # current node is left child, sibling is on right\r\n\u001b[?2004l\r"]
[86.554784, "o", "\u001b[?2004h> "]
[86.554865, "o", "            combined = reconstructed_hash.encode('utf-8') + sibling_hash.encode('utf-8')\r\n\u001b[?2004l\r"]
[86.554885, "o", "\u001b[?2004h> "]
[86.554905, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.554967, "o", "            print(f\"Error: invalid direction {direction}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[86.554992, "o", "\u001b[?2004h> "]
[86.555012, "o", "            sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.555051, "o", "        reconstructed_hash = sha512(combined)\r\n\u001b[?2004l\r"]
[86.555071, "o", "\u001b[?2004h> "]
[86.55512, "o", "    root_matches = (reconstructed_hash == storage['root_hash'])\r\n\u001b[?2004l\r"]
[86.55514, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.555175, "o", "    # Prepare verification result\r\n\u001b[?2004l\r"]
[86.555195, "o", "\u001b[?2004h>     result = {\r\n"]
[86.555215, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[86.555246, "o", "        \"root_matches\": root_matches,\r\n\u001b[?2004l\r"]
[86.555266, "o", "\u001b[?2004h> "]
[86.555306, "o", "        \"file_hash_matches_storage\": file_hash_matches,\r\n\u001b[?2004l\r"]
[86.555326, "o", "\u001b[?2004h> "]
[86.555355, "o", "        \"file_path\": expected_file_path,\r\n\u001b[?2004l\r"]
[86.555374, "o", "\u001b[?2004h> "]
[86.555391, "o", "        \"added_files\": [],\r\n\u001b[?2004l\r"]
[86.55541, "o", "\u001b[?2004h> "]
[86.555429, "o", "        \"deleted_files\": [],\r\n\u001b[?2004l\r"]
[86.555449, "o", "\u001b[?2004h> "]
[86.555467, "o", "        \"modified_files\": []\r\n\u001b[?2004l\r"]
[86.555487, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[86.555508, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.555575, "o", "    # Since we are verifying a single file, added/deleted/modified are empty\r\n\u001b[?2004l\r"]
[86.555595, "o", "\u001b[?2004h> "]
[86.555647, "o", "    # But if the file is missing from storage, it would be a deletion\r\n\u001b[?2004l\r"]
[86.555667, "o", "\u001b[?2004h"]
[86.555687, "o", ">     if not file_hash_matches:\r\n\u001b[?2004l\r"]
[86.555707, "o", "\u001b[?2004h> "]
[86.555749, "o", "        result[\"modified_files\"] = [expected_file_path]\r\n\u001b[?2004l\r"]
[86.555769, "o", "\u001b[?2004h> "]
[86.555835, "o", "    # If the file is not in storage at all, it would be added, but we already checked\r\n\u001b[?2004l\r"]
[86.555845, "o", "\u001b[?2004h"]
[86.555881, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.555901, "o", "    # Output result as JSON\r\n\u001b[?2004l\r"]
[86.555921, "o", "\u001b[?2004h> "]
[86.555942, "o", "    print(json.dumps(result))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.55603, "o", "    # If verification fails, ensure \"failed\" appears in stdout or exit non-zero\r\n"]
[86.556046, "o", "\u001b[?2004l\r"]
[86.556067, "o", "\u001b[?2004h> "]
[86.556095, "o", "    if not (root_matches and file_hash_matches):\r\n\u001b[?2004l\r"]
[86.556116, "o", "\u001b[?2004h> "]
[86.556161, "o", "        # Already printed JSON, but we need to ensure exit code is non-zero\r\n\u001b[?2004l\r"]
[86.55617, "o", "\u001b[?2004h> "]
[86.556193, "o", "        sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.556216, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.556237, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[86.556256, "o", "\u001b[?2004h> "]
[86.556302, "o", "    parser = argparse.ArgumentParser(description='Merkle Tree CLI Tool')\r\n\u001b[?2004l\r"]
[86.556321, "o", "\u001b[?2004h> "]
[86.556372, "o", "    subparsers = parser.add_subparsers(dest='command', help='Available commands')\r\n\u001b[?2004l\r"]
[86.556392, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.556413, "o", "    # scan command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.556485, "o", "    scan_parser = subparsers.add_parser('scan', help='Scan a directory and build Merkle tree')\r\n\u001b[?2004l\r"]
[86.556505, "o", "\u001b[?2004h> "]
[86.556545, "o", "    scan_parser.add_argument('directory', help='Directory to scan')\r\n\u001b[?2004l\r"]
[86.556556, "o", "\u001b[?2004h> \r\n"]
[86.556564, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[86.556589, "o", "    # proof command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.556656, "o", "    proof_parser = subparsers.add_parser('proof', help='Generate Merkle proof for a file')\r\n\u001b[?2004l\r"]
[86.556676, "o", "\u001b[?2004h> "]
[86.556742, "o", "    proof_parser.add_argument('file_path', help='Relative file path as stored in merkle_data.json')\r\n\u001b[?2004l\r"]
[86.556762, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.556778, "o", "    # verify command\r\n\u001b[?2004l\r"]
[86.556798, "o", "\u001b[?2004h> "]
[86.556889, "o", "    verify_parser = subparsers.add_parser('verify', help='Verify file integrity using proof')\r\n\u001b[?2004l\r"]
[86.556907, "o", "\u001b[?2004h"]
[86.556925, "o", "> "]
[86.556983, "o", "    verify_parser.add_argument('file_path', help='File path to verify (relative or absolute)')\r\n\u001b[?2004l\r"]
[86.557004, "o", "\u001b[?2004h> "]
[86.557059, "o", "    verify_parser.add_argument('proof_file', help='JSON file containing proof data')\r\n\u001b[?2004l\r"]
[86.55708, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.557102, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r"]
[86.557123, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.557143, "o", "\u001b[?2004h>     if args.command == 'scan':\r\n"]
[86.557162, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[86.557185, "o", "        scan_directory(args.directory)\r\n\u001b[?2004l\r"]
[86.557205, "o", "\u001b[?2004h> "]
[86.557227, "o", "    elif args.command == 'proof':\r\n\u001b[?2004l\r"]
[86.557245, "o", "\u001b[?2004h> "]
[86.557264, "o", "        generate_proof(args.file_path)\r\n\u001b[?2004l\r"]
[86.557272, "o", "\u001b[?2004h> "]
[86.557313, "o", "    elif args.command == 'verify':\r\n\u001b[?2004l\r"]
[86.557325, "o", "\u001b[?2004h> "]
[86.557346, "o", "        verify_file(args.file_path, args.proof_file)\r\n\u001b[?2004l\r"]
[86.557359, "o", "\u001b[?2004h> "]
[86.557369, "o", "    else:\r\n\u001b[?2004l\r"]
[86.557379, "o", "\u001b[?2004h> "]
[86.557397, "o", "        parser.print_help()\r\n\u001b[?2004l\r"]
[86.557408, "o", "\u001b[?2004h> "]
[86.557422, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[86.557434, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.557446, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[86.583874, "o", "\u001b[?2004hroot@710a10b7d8a0:/app# "]
