[93.491868, "o", "        pattern = r'.*(?P<ending>' + self.prompt_pattern + r')'\r\n\u001b[?2004l\r"]
[93.491891, "o", "\u001b[?2004h> "]
[93.491933, "o", "        index = self.child.expect(pattern, timeout=timeout)\r\n\u001b[?2004l\r"]
[93.491954, "o", "\u001b[?2004h> "]
[93.492003, "o", "        # Return everything captured before the prompt\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.492015, "o", "> "]
[93.492139, "o", "        match = self.child.match.group(0)\r\n\u001b[?2004l\r\u001b[?2004h>         return match[:-len(self.prompt_pattern)]\r\n\u001b[?2004l\r"]
[93.492175, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def close(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.492209, "o", "        \"\"\"Close the underlying pseudo-terminal.\"\"\"\r\n\u001b[?2004l\r"]
[93.492226, "o", "\u001b[?2004h> "]
[93.492251, "o", "        if self.child.isalive():\r\n\u001b[?2004l\r"]
[93.492264, "o", "\u001b[?2004h> "]
[93.492298, "o", "            self.child.close(force=True)\r\n\u001b[?2004l\r"]
[93.49231, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.492326, "o", "\u001b[?2004h> "]
[93.492338, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.492351, "o", "> "]
[93.492367, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[93.492377, "o", "\u001b[?2004h> "]
[93.49241, "o", "    # Simple demo when run directly\r\n\u001b[?2004l\r"]
[93.492424, "o", "\u001b[?2004h> "]
[93.492449, "o", "    term = HeadlessTerminal()\r\n\u001b[?2004l\r"]
[93.492461, "o", "\u001b[?2004h> "]
[93.492515, "o", "    term.send_keys('echo \"Hello from headless terminal!\\n\"')\r\n\u001b[?2004l\r"]
[93.492527, "o", "\u001b[?2004h"]
[93.492539, "o", "> "]
[93.492563, "o", "    output = term.read_until_prompt()\r\n\u001b[?2004l\r"]
[93.492576, "o", "\u001b[?2004h> "]
[93.492609, "o", "    print('Captured output:', output)\r\n\u001b[?2004l\r"]
[93.492618, "o", "\u001b[?2004h> "]
[93.492637, "o", "    term.close()\r\n\u001b[?2004l\r"]
[93.492648, "o", "\u001b[?2004h> "]
[93.492659, "o", "EOF\r\n\u001b[?2004l\r"]
[93.498062, "o", "\u001b[?2004hroot@1ed8ef707e60:/app# "]
