[?2004lglobal_votes:
                    violations[idx] = 'BAD_DUPLICATE_VOTE'
                    break
                global_votes.add((node, term))
            elif op == 'LEADER':
                if term in leader_terms_seen:
                    violations[idx] = 'BAD_LEADER_ORDER'
                    break
                leader_terms_seen.add(term)
            elif op == 'APPEND':
                append_terms.append((term, data))
                append_seen_so_far = True
            elif op == 'COMMIT':
                if not append_seen_so_far:
                    violations[idx] = 'BAD_COMMIT_ORDER'
                    break
                commit_terms.append(term)
        if idx in violations:
            continue
        if not append_terms:
            winning_term = None
        else:
            max_term = max(t for t, _ in append_terms)
            max_data_set = {d for t, d in append_terms if t == max_term}
            if len(max_data_set) > 1:
                violations[idx] = 'BAD_CONFLICT'
            winning_term = max_term
        if idx not in violations and winning_term is not None:
            for ct in commit_terms:
                if ct != winning_term:
                    violations[idx] = 'BAD_COMMIT_ORDER'
                    break
        if winning_term is not None:
            if not commit_terms or any(ct != winning_term for ct in commit_terms):
                need_repair.append((idx, winning_term))
    bad_lines = sorted([f"BAD {idx} {reason}" for idx, reason in violations.items()])
    unique_repairs = {}
    for idx, term in need_repair:
        unique_repairs[idx] = (term, idx)
    ins_lines = sorted([f"INS {term} {idx} COMMIT" for idx, (term, _) in unique_repairs.items()], key=lambda x: (int(x.split()[2]), int(x.split()[1])))
    if not bad_lines and not ins_lines:
        return "OK"
    return "\n".join(bad_lines + ins_lines)
