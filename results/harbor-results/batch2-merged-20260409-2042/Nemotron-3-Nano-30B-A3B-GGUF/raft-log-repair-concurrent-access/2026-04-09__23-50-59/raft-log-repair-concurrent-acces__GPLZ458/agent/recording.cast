[281.01444, "i", "global_votes:\n                    violations[idx] = 'BAD_DUPLICATE_VOTE'\n                    break\n                global_votes.add((node, term))\n            elif op == 'LEADER':\n                if term in leader_terms_seen:\n                    violations[idx] = 'BAD_LEADER_ORDER'\n                    break\n                leader_terms_seen.add(term)\n            elif op == 'APPEND':\n                append_terms.append((term, data))\n                append_seen_so_far = True\n            elif op == 'COMMIT':\n                if not append_seen_so_far:\n                    violations[idx] = 'BAD_COMMIT_ORDER'\n                    break\n                commit_terms.append(term)\n        if idx in violations:\n            continue\n        if not append_terms:\n            winning_term = None\n        else:\n            max_term = max(t for t, _ in append_terms)\n            max_data_set = {d for t, d in append_terms if t == max_term}\n            if len(max_data_set) > 1:\n                violations[idx] = 'BAD_CONFLICT'\n     "]
