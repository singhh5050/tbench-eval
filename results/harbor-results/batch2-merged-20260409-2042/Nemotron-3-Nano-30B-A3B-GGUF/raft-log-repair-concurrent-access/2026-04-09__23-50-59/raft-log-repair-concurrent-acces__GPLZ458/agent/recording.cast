[281.013937, "i", "cat > /app/solution.py << 'EOF'\nimport re\nfrom collections import defaultdict\n\ndef solve(lines: list[str]) -> str:\n    node_re = re.compile(r'^n[0-9]+$')\n    entries = []\n    for line in lines:\n        stripped = line.strip()\n        if not stripped or stripped.startswith('#'):\n            continue\n        parts = stripped.split()\n        if len(parts) not in (4, 5):\n            break\n        try:\n            term = int(parts[0])\n            if term < 0:\n                raise ValueError\n            idx = int(parts[1])\n            if idx < 1:\n                raise ValueError\n            node = parts[2]\n            if not node_re.fullmatch(node):\n                raise ValueError\n            op = parts[3]\n            if op not in ('VOTE', 'APPEND', 'COMMIT', 'LEADER'):\n                raise ValueError\n            if op in ('VOTE', 'COMMIT', 'LEADER') and len(parts) != 4:\n                raise ValueError\n            if op == 'APPEND' and len(parts) != 5:\n                raise ValueError\n        except ValueError:"]
[281.014244, "o", "cat > /app/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[281.014373, "i", "\n            break\n        data = parts[4] if op == 'APPEND' else None\n        if any(e.term == term and e.node == node and e.op == op and e.data == data for e in entries):\n            continue\n        entries.append((term, idx, node, op, data))\n    by_idx = defaultdict(list)\n    for e in entries:\n        by_idx[e[1]].append(e)\n    sorted_indices = sorted(by_idx.keys())\n    violations = {}\n    need_repair = []\n    global_votes = set()\n    leader_terms_seen = set()\n    for idx in sorted_indices:\n        evs = by_idx[idx]\n        prev_term = -1\n        for ev in evs:\n            term = ev[0]\n            if term < prev_term:\n                violations[idx] = 'BAD_TERM_REGRESSION'\n                break\n            prev_term = term\n        if idx in violations:\n            continue\n        append_terms = []\n        commit_terms = []\n        append_seen_so_far = False\n        for ev in evs:\n            term, node, op, data = ev[0], ev[2], ev[3], ev[4]\n            if op == 'VOTE':\n                if (node, term) in "]
