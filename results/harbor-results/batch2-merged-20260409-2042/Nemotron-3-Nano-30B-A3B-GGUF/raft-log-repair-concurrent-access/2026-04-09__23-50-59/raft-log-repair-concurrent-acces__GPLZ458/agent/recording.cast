[281.014498, "i", "       winning_term = max_term\n        if idx not in violations and winning_term is not None:\n            for ct in commit_terms:\n                if ct != winning_term:\n                    violations[idx] = 'BAD_COMMIT_ORDER'\n                    break\n        if winning_term is not None:\n            if not commit_terms or any(ct != winning_term for ct in commit_terms):\n                need_repair.append((idx, winning_term))\n    bad_lines = sorted([f\"BAD {idx} {reason}\" for idx, reason in violations.items()])\n    unique_repairs = {}\n    for idx, term in need_repair:\n        unique_repairs[idx] = (term, idx)\n    ins_lines = sorted([f\"INS {term} {idx} COMMIT\" for idx, (term, _) in unique_repairs.items()], key=lambda x: (int(x.split()[2]), int(x.split()[1])))\n    if not bad_lines and not ins_lines:\n        return \"OK\"\n    return \"\\n\".join(bad_lines + ins_lines)\nEOF\n"]
