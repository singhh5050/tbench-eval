[84.709431, "i", "python3 - <<'PY'\nimport mlflow, mlflow.sklearn, numpy as np, sklearn.linear_model as skl\nmlflow.set_tracking_uri(\"http://localhost:8080\")\nexperiment_id = mlflow.create_experiment(\"test_exp\")\nwith mlflow.start_run(experiment_id=experiment_id):\n    mlflow.log_params({\"feature_count\": 3})\n    X = np.random.rand(100, 3)\n    y = np.random.rand(100)\n    model = skl.LinearRegression()\n    model.fit(X, y)\n    mlflow.sklearn.log_model(model, \"model\")\n    run_id = mlflow.active_run().info.run_id\n    model_uri = f\"runs:/{run_id}/model\"\n    mlflow.register_model(model_uri, \"gpt-5\")\nPY\n"]
