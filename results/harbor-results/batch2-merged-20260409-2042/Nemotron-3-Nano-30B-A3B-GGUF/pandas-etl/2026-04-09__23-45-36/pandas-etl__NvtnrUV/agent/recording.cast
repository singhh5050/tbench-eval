[31.555399, "o", "participant_id,first_name,last_name,birth_date,address,phone_number,country,institute,occupation,register_time\r\nbd9b6f88-b84f-4c4d-90f8-b67fe2f1a29a,Citra,Nurdiyanti,05 Feb 1991,\"Gg. Monginsidi No. 08\r\nMedan, Aceh 80734\",(0151) 081 2706,Georgia,UD Prakasa Mandasari,Business Intelligence Engineer,1617634046.0\r\n7dfe3391-6f40-47b6-b4db-0c76ebaf5fc3,Aris,Setiawan,11 Jan 1993,\"Gg. Rajawali Timur No. 7\r\nPrabumulih, MA 09434\",+62 (036) 461 7027,Korea Utara,Universitas Diponegoro,Frontend Engineer,1617634018.0\r\n"]
[31.555562, "o", "\u001b[?2004h"]
[31.555595, "o", "root@90a0c630d774:/app# "]
[79.254497, "i", "cat > /app/process.py << 'EOF'\n"]
[79.254689, "o", "cat > /app/process.py << 'EOF'\r\n\u001b[?2004l\r"]
[79.254789, "o", "\u001b[?2004h> "]
[79.35956, "i", "import csv, re, datetime\n\n\ndef process_address(addr):\n    # Extract postal_code: last sequence of digits at end of address\n    postal = re.search(r'(\\d+)\\s*$', addr)\n    postal_code = postal.group(1) if postal else ''\n    # Split by newline and get the last part\n    parts = addr.splitlines()\n    last_part = parts[-1].strip()\n    # City is the part before the first comma\n    city = last_part.split(',')[0].strip()\n    return postal_code, city\n\n\ndef format_birth_date(bd):\n    try:\n        dt = datetime.datetime.strptime(bd, \"%d %b %Y\")\n        return dt.strftime(\"%Y-%m-%d\")\n    except Exception:\n        return bd\n\n\ndef generate_team_name(row):\n    # FL: uppercase initials of first and last name\n    fl = (row['first_name'][0] + row['last_name'][0]).upper()\n    # I: first letter of each word in institute\n    institute_letters = ''.join([word[0] for word in row['institute'].split()])\n    return f\"{fl}-{row['country']}-{institute_letters}\"\n\n\nwith open('/app/data.csv', 'r') as f_in, open('/app/result.csv', 'w', newli"]
[79.359686, "i", "ne='') as f_out:\n    reader = csv.DictReader(f_in)\n    fieldnames = ['participant_id', 'first_name', 'last_name', 'birth_date', 'address', 'phone_number', 'country', 'institute', 'occupation', 'register_time', 'postal_code', 'city', 'team_name']\n    writer = csv.DictWriter(f_out, fieldnames=fieldnames)\n    writer.writeheader()\n    for row in reader:\n        postal_code, city = process_address(row['address'])\n        row['birth_date'] = format_birth_date(row['birth_date'])\n        row['postal_code'] = postal_code\n        row['city'] = city\n        row['team_name'] = generate_team_name(row)\n        writer.writerow(row)\nEOF\n"]
