[83.869838, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.869887, "o", "        Forward pass of the layer.\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
