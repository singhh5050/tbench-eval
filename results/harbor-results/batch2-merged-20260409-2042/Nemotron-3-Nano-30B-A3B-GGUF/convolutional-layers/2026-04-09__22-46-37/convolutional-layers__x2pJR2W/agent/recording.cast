[83.766493, "o", "\u001b[?2004h> "]
[83.766572, "o", "def get_output_shape(input_shape: tuple, kernel_size: int, stride: int, padding: int, dilation: int = 1) -> tuple:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.766589, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
