[83.869471, "o", "\u001b[?2004h> "]
[83.869496, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self):\r\n\u001b[?2004l\r"]
[83.869531, "o", "\u001b[?2004h>         pass\r\n\u001b[?2004l\r"]
[83.869541, "o", "\u001b[?2004h> "]
[83.869584, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.869612, "o", "    def __call__(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.869649, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.869666, "o", "        Call forward method.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.869691, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.86972, "o", "        return self.forward(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.869729, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.869768, "o", ">     @abstractmethod\r\n\u001b[?2004l\r\u001b[?2004h> "]
