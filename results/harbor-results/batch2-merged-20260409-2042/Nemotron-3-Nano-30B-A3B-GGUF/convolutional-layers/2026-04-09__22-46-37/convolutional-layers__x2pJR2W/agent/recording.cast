[84.272317, "o", "        self.running_var = np.ones(num_features, dtype=np.float64)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[84.272342, "o", "\u001b[?2004h> "]
[84.27239, "o", "    def forward(self, x: np.ndarray, training: bool = True) -> np.ndarray:\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.272404, "o", ">         \"\"\"\r\n"]
[84.272417, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[84.272462, "o", "        Perform forward pass of batch normalization.\r\n\u001b[?2004l\r"]
[84.272476, "o", "\u001b[?2004h> "]
[84.272488, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.272505, "o", "        Args:\r\n\u001b[?2004l\r"]
[84.27252, "o", "\u001b[?2004h> "]
[84.2726, "o", "            x: Input of shape (batch_size, height, width, num_features), dtype float64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.2727, "o", "            training: Whether to use training mode (default True)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         Returns:\r\n\u001b[?2004l\r"]
[84.272727, "o", "\u001b[?2004h> "]
[84.272738, "o", "            Normalized output of same shape, dtype float64\r\n\u001b[?2004l\r"]
[84.272768, "o", "\u001b[?2004h> "]
[84.272789, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.272807, "o", "        if training:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.272859, "o", "            # Compute mean and variance for each channel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.272927, "o", "            mean = np.mean(x, axis=(0, 1, 2))  # Shape: (num_features,)\r\n\u001b[?2004l\r"]
[84.272941, "o", "\u001b[?2004h> "]
[84.272984, "o", "            var = np.var(x, axis=(0, 1, 2))\r\n\u001b[?2004l\r"]
[84.273, "o", "\u001b[?2004h> "]
[84.273013, "o", "            \r\n\u001b[?2004l\r"]
[84.273022, "o", "\u001b[?2004h"]
[84.273034, "o", "> "]
[84.27306, "o", "            # Update running statistics\r\n\u001b[?2004l\r"]
[84.273073, "o", "\u001b[?2004h> "]
[84.273164, "o", "            self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * mean\r\n\u001b[?2004l\r"]
[84.273178, "o", "\u001b[?2004h> "]
[84.273267, "o", "            self.running_var = (1 - self.momentum) * self.running_var + self.momentum * var\r\n\u001b[?2004l\r"]
[84.27328, "o", "\u001b[?2004h> "]
[84.273293, "o", "            \r\n\u001b[?2004l\r"]
[84.273304, "o", "\u001b[?2004h> "]
[84.273353, "o", "            # Normalize using batch statistics\r\n\u001b[?2004l\r"]
[84.273365, "o", "\u001b[?2004h> "]
[84.273428, "o", "            mean_batch = mean.reshape(1, 1, 1, self.num_features)\r\n\u001b[?2004l\r"]
[84.273447, "o", "\u001b[?2004h> "]
[84.273505, "o", "            var_batch = var.reshape(1, 1, 1, self.num_features)\r\n\u001b[?2004l\r"]
[84.273518, "o", "\u001b[?2004h> "]
[84.27357, "o", "            x_norm = (x - mean_batch) / np.sqrt(var_batch + self.eps)\r\n\u001b[?2004l\r"]
[84.273581, "o", "\u001b[?2004h"]
[84.273596, "o", "> "]
[84.273607, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.273638, "o", "            # Normalize using running statistics\r\n\u001b[?2004l\r"]
[84.273652, "o", "\u001b[?2004h> "]
[84.273705, "o", "            mean = self.running_mean.reshape(1, 1, 1, self.num_features)\r\n\u001b[?2004l\r"]
[84.273718, "o", "\u001b[?2004h> "]
[84.273771, "o", "            var = self.running_var.reshape(1, 1, 1, self.num_features)\r\n\u001b[?2004l\r"]
[84.273783, "o", "\u001b[?2004h> "]
[84.273826, "o", "            x_norm = (x - mean) / np.sqrt(var + self.eps)\r\n\u001b[?2004l\r"]
[84.273838, "o", "\u001b[?2004h> "]
[84.273854, "o", "        \r\n\u001b[?2004l\r"]
[84.27387, "o", "\u001b[?2004h> "]
[84.273886, "o", "        # Apply scale and shift\r\n\u001b[?2004l\r"]
[84.2739, "o", "\u001b[?2004h> "]
[84.273992, "o", "        return self.gamma.reshape(1, 1, 1, self.num_features) * x_norm + self.beta.reshape(1, 1, 1, self.num_features)\r\n\u001b[?2004l\r"]
[84.274004, "o", "\u001b[?2004h> "]
[84.274018, "o", "EOF\r\n\u001b[?2004l\r"]
[84.274879, "o", "\u001b[?2004hroot@58396a593594:/app# "]
[84.36938, "i", "cat > /app/src/activation.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\nclass ReLU(BaseLayer):\n    \"\"\"\n    Rectified Linear Unit activation function.\n    \"\"\"\n    def __init__(self):\n        super().__init__()\n    \n    def forward(self, x: np.ndarray) -> np.ndarray:\n        \"\"\"\n        Apply ReLU activation.\n        \n        Args:\n            x: Input array of any shape, dtype float64\n        \n        Returns:\n            Output of same shape, dtype float64\n        \"\"\"\n        return np.maximum(0, x)\n\nclass LeakyReLU(BaseLayer):\n    \"\"\"\n    Leaky Rectified Linear Unit activation function.\n    \"\"\"\n    def __init__(self, negative_slope: float = 0.01):\n        super().__init__()\n        self.negative_slope = negative_slope\n    \n    def forward(self, x: np.ndarray) -> np.ndarray:\n        \"\"\"\n        Apply LeakyReLU activation.\n        \n        Args:\n            x: Input array of any shape, dtype float64\n        \n        Returns:\n            Output of same shape, dtype float64\n        \"\"\"\n        retu"]
[84.369518, "i", "rn np.where(x > 0, x, self.negative_slope * x)\n\nclass Sigmoid(BaseLayer):\n    \"\"\"\n    Sigmoid activation function.\n    \"\"\"\n    def __init__(self):\n        super().__init__()\n    \n    def forward(self, x: np.ndarray) -> np.ndarray:\n        \"\"\"\n        Apply Sigmoid activation function.\n        \n        Args:\n            x: Input array of any shape, dtype float64\n        \n        Returns:\n            Output of same shape, dtype float64\n        \"\"\"\n        # Numerically stable sigmoid implementation\n        # For large positive values: 1 / (1 + exp(-x)) ~ 1\n        # For large negative values: exp(x) / (1 + exp(x))\n        \n        # Handle large positive values\n        pos_mask = x >= 0\n        neg_mask = ~pos_mask\n        \n        # For non-negative values: 1 / (1 + exp(-x))\n        pos_out = 1.0 / (1.0 + np.exp(-x[pos_mask]))\n        \n        # For negative values: exp(x) / (1 + exp(x))\n        # This avoids overflow issues\n        exp_x = np.exp(x[neg_mask])\n        neg_out = exp_x / (1.0 + exp_x)\n        \n "]
[84.369557, "o", "cat > /app/src/activation.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r"]
[84.369567, "i", "       out = np.zeros_like(x)\n        out[pos_mask] = pos_out\n        out[neg_mask] = neg_out\n        \n        return out\nEOF\n"]
[84.369573, "o", "\u001b[?2004h> "]
[84.36978, "o", "from .base import BaseLayer\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class ReLU(BaseLayer):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Rectified Linear Unit activation function.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.369923, "o", "    def __init__(self):\r\n\u001b[?2004l\r\u001b[?2004h>         super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     def forward(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.369982, "o", "        Apply ReLU activation.\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.370016, "o", "            x: Input array of any shape, dtype float64\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.370031, "o", ">         \r\n\u001b[?2004l\r"]
[84.370035, "o", "\u001b[?2004h> "]
[84.370088, "o", "        Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.370203, "o", "            Output of same shape, dtype float64\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         return np.maximum(0, x)\r\n\u001b[?2004l\r"]
[84.370245, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.370274, "o", "class LeakyReLU(BaseLayer):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.37034, "o", "    Leaky Rectified Linear Unit activation function.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.370396, "o", "    def __init__(self, negative_slope: float = 0.01):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.370426, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.370436, "o", "> "]
[84.37048, "o", "        self.negative_slope = negative_slope\r\n\u001b[?2004l\r"]
[84.370506, "o", "\u001b[?2004h> "]
[84.370518, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.370558, "o", "    def forward(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r"]
[84.370597, "o", "\u001b[?2004h>         \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.370633, "o", "        Apply LeakyReLU activation.\r\n\u001b[?2004l\r"]
[84.370655, "o", "\u001b[?2004h> "]
[84.370666, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.370682, "o", "        Args:\r\n\u001b[?2004l\r"]
[84.37072, "o", "\u001b[?2004h> "]
[84.370751, "o", "            x: Input array of any shape, dtype float64\r\n\u001b[?2004l\r"]
[84.370775, "o", "\u001b[?2004h> "]
[84.370786, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.370814, "o", "        Returns:\r\n\u001b[?2004l\r"]
[84.370822, "o", "\u001b[?2004h> "]
[84.370867, "o", "            Output of same shape, dtype float64\r\n\u001b[?2004l\r"]
[84.370878, "o", "\u001b[?2004h> "]
[84.370972, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         return np.where(x > 0, x, self.negative_slope * x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.371004, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> class Sigmoid(BaseLayer):\r\n\u001b[?2004l\r"]
[84.371026, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.371058, "o", "    Sigmoid activation function.\r\n\u001b[?2004l\r"]
[84.371077, "o", "\u001b[?2004h> "]
[84.371086, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.371118, "o", "    def __init__(self):\r\n\u001b[?2004l\r"]
[84.371144, "o", "\u001b[?2004h> "]
[84.371156, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[84.371167, "o", "\u001b[?2004h> "]
[84.371178, "o", "    \r\n\u001b[?2004l\r"]
[84.371189, "o", "\u001b[?2004h> "]
[84.371242, "o", "    def forward(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r"]
[84.371253, "o", "\u001b[?2004h> "]
[84.371273, "o", "        \"\"\"\r\n\u001b[?2004l\r"]
[84.371284, "o", "\u001b[?2004h"]
[84.371304, "o", "> "]
[84.371336, "o", "        Apply Sigmoid activation function.\r\n\u001b[?2004l\r"]
[84.371355, "o", "\u001b[?2004h"]
[84.371407, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h>         Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.371443, "o", "            x: Input array of any shape, dtype float64\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.371459, "o", ">         \r\n\u001b[?2004l\r"]
[84.371464, "o", "\u001b[?2004h> "]
[84.371494, "o", "        Returns:\r\n\u001b[?2004l\r"]
[84.371498, "o", "\u001b[?2004h> "]
[84.371546, "o", "            Output of same shape, dtype float64\r\n\u001b[?2004l\r"]
[84.37156, "o", "\u001b[?2004h> "]
[84.371575, "o", "        \"\"\"\r\n\u001b[?2004l\r"]
[84.371589, "o", "\u001b[?2004h> "]
[84.371633, "o", "        # Numerically stable sigmoid implementation\r\n\u001b[?2004l\r"]
[84.371645, "o", "\u001b[?2004h> "]
[84.371685, "o", "        # For large positive values: 1 / (1 + exp(-x)) ~ 1\r\n\u001b[?2004l\r"]
[84.371696, "o", "\u001b[?2004h> "]
[84.371738, "o", "        # For large negative values: exp(x) / (1 + exp(x))\r\n\u001b[?2004l\r"]
[84.37175, "o", "\u001b[?2004h> "]
[84.371762, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[84.371774, "o", "> "]
[84.371796, "o", "        # Handle large positive values\r\n\u001b[?2004l\r"]
[84.371807, "o", "\u001b[?2004h> "]
[84.371826, "o", "        pos_mask = x >= 0\r\n\u001b[?2004l\r"]
[84.371838, "o", "\u001b[?2004h> "]
[84.37187, "o", "        neg_mask = ~pos_mask\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.371883, "o", ">         \r\n\u001b[?2004l\r"]
[84.371895, "o", "\u001b[?2004h> "]
[84.371932, "o", "        # For non-negative values: 1 / (1 + exp(-x))\r\n\u001b[?2004l\r"]
[84.371944, "o", "\u001b[?2004h> "]
[84.371983, "o", "        pos_out = 1.0 / (1.0 + np.exp(-x[pos_mask]))\r\n\u001b[?2004l\r"]
[84.371996, "o", "\u001b[?2004h> "]
[84.372009, "o", "        \r\n\u001b[?2004l\r"]
[84.372022, "o", "\u001b[?2004h> "]
[84.37205, "o", "        # For negative values: exp(x) / (1 + exp(x))\r\n\u001b[?2004l\r"]
[84.372062, "o", "\u001b[?2004h> "]
[84.37209, "o", "        # This avoids overflow issues\r\n\u001b[?2004l\r"]
[84.372103, "o", "\u001b[?2004h"]
[84.372115, "o", "> "]
[84.372129, "o", "        exp_x = np.exp(x[neg_mask])\r\n\u001b[?2004l\r"]
[84.372139, "o", "\u001b[?2004h> "]
[84.372171, "o", "        neg_out = exp_x / (1.0 + exp_x)\r\n\u001b[?2004l\r"]
[84.372183, "o", "\u001b[?2004h"]
[84.372197, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.372222, "o", "        out = np.zeros_like(x)\r\n\u001b[?2004l\r"]
[84.372233, "o", "\u001b[?2004h> "]
[84.372259, "o", "        out[pos_mask] = pos_out\r\n\u001b[?2004l\r"]
[84.37227, "o", "\u001b[?2004h> "]
[84.372294, "o", "        out[neg_mask] = neg_out\r\n\u001b[?2004l\r"]
[84.372306, "o", "\u001b[?2004h> "]
[84.372318, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.372337, "o", "        return out\r\n\u001b[?2004l\r"]
[84.37235, "o", "\u001b[?2004h"]
[84.372362, "o", "> EOF\r\n\u001b[?2004l\r"]
[84.373274, "o", "\u001b[?2004hroot@58396a593594:/app# "]
[84.474257, "i", "cat > /app/src/__init__.py << 'EOF'\n\"\"\"\nCNN layers implementation from scratch.\n\"\"\"\n# Import all required modules and export them\nfrom .base import BaseLayer\nfrom .conv import Conv2D\nfrom .conv_transpose import Conv2DTranspose\nfrom .pooling import MaxPool2D, AvgPool2D\nfrom .normalization import BatchNorm2D\nfrom .activation import ReLU, LeakyReLU, Sigmoid\nfrom .padding import zero_pad, get_output_shape\n\n# Export all public symbols\n__all__ = [\n    'BaseLayer',\n    'Conv2D',\n    'Conv2DTranspose',\n    'MaxPool2D',\n    'AvgPool2D',\n    'BatchNorm2D',\n    'ReLU',\n    'LeakyReLU',\n    'Sigmoid',\n    'zero_pad',\n    'get_output_shape'\n]\nEOF\n"]
[84.474386, "o", "cat > /app/src/__init__.py << 'EOF'\r\n\u001b[?2004l\r"]
[84.474396, "o", "\u001b[?2004h> "]
[84.474556, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> CNN layers implementation from scratch.\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> # Import all required modules and export them\r\n\u001b[?2004l\r\u001b[?2004h> from .base import BaseLayer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.47461, "o", "from .conv import Conv2D\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.474635, "o", "> from .conv_transpose import Conv2DTranspose\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.474658, "o", "from .pooling import MaxPool2D, AvgPool2D\r\n\u001b[?2004l\r"]
[84.474668, "o", "\u001b[?2004h> "]
[84.474756, "o", "from .normalization import BatchNorm2D\r\n\u001b[?2004l\r\u001b[?2004h> from .activation import ReLU, LeakyReLU, Sigmoid\r\n\u001b[?2004l\r"]
[84.474811, "o", "\u001b[?2004h> from .padding import zero_pad, get_output_shape\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.474843, "o", "# Export all public symbols\r\n\u001b[?2004l\r\u001b[?2004h> __all__ = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.474889, "o", "    'BaseLayer',\r\n\u001b[?2004l\r\u001b[?2004h>     'Conv2D',\r\n\u001b[?2004l\r"]
[84.474919, "o", "\u001b[?2004h>     'Conv2DTranspose',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.474953, "o", "    'MaxPool2D',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.474988, "o", "    'AvgPool2D',\r\n\u001b[?2004l\r\u001b[?2004h>     'BatchNorm2D',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.475028, "o", "    'ReLU',\r\n\u001b[?2004l\r\u001b[?2004h>     'LeakyReLU',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.475053, "o", "    'Sigmoid',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.475077, "o", "    'zero_pad',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.475101, "o", "    'get_output_shape'\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n"]
[84.475127, "o", "\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[84.47596, "o", "\u001b[?2004h"]
