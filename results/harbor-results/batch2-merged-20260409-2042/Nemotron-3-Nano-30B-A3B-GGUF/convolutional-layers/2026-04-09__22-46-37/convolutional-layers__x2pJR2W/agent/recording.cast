[83.869329, "o", "\u001b[?2004h> "]
[83.869338, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.86941, "o", "class BaseLayer(ABC):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
