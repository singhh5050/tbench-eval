[?2004l[?2004h>     
[?2004l[?2004h>     def forward(self, x: np.ndarray, training: bool = True) -> np.ndarray:
[?2004l[?2004h>         """
[?2004l[?2004h>         Perform forward pass of batch normalization.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             x: Input of shape (batch_size, height, width, num_features), dtype float64
[?2004l[?2004h>             training: Whether to use training mode (default True)
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
