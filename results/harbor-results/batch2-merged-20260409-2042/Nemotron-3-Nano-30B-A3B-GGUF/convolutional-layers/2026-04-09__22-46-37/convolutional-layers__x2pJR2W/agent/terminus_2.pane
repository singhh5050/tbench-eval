[?2004l[?2004h> class LeakyReLU(BaseLayer):
[?2004l[?2004h>     """
[?2004l[?2004h>     Leaky Rectified Linear Unit activation function.
[?2004l[?2004h>     """
[?2004l[?2004h>     def __init__(self, negative_slope: float = 0.01):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.negative_slope = negative_slope
[?2004l[?2004h>     
[?2004l[?2004h>     def forward(self, x: np.ndarray) -> np.ndarray:
[?2004l[?2004h>         """
[?2004l[?2004h>         Apply LeakyReLU activation.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             x: Input array of any shape, dtype float64
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             Output of same shape, dtype float64
[?2004l[?2004h>         """
[?2004l[?2004h>         return np.where(x > 0, x, self.negative_slope * x)
