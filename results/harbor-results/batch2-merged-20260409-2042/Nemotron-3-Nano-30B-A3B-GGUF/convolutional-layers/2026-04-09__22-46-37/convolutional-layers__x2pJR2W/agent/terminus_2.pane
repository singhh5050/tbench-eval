[?2004l[?2004h> class ReLU(BaseLayer):
[?2004l[?2004h>     """
[?2004l[?2004h>     Rectified Linear Unit activation function.
[?2004l[?2004h>     """
[?2004l[?2004h>     def __init__(self):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>     
[?2004l[?2004h>     def forward(self, x: np.ndarray) -> np.ndarray:
[?2004l[?2004h>         """
[?2004l[?2004h>         Apply ReLU activation.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             x: Input array of any shape, dtype float64
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             Output of same shape, dtype float64
[?2004l[?2004h>         """
[?2004l[?2004h>         return np.maximum(0, x)
