[?2004l[?2004h>         self.eps = eps
[?2004l[?2004h>         self.momentum = momentum
[?2004l[?2004h>         
[?2004l[?2004h>         # Initialize parameters
[?2004l[?2004h>         self.gamma = np.ones(num_features, dtype=np.float64)  # scale
[?2004l[?2004h>         self.beta = np.zeros(num_features, dtype=np.float64)   # shift
[?2004l[?2004h>         
[?2004l[?2004h>         # Initialize running statistics
[?2004l[?2004h>         self.running_mean = np.zeros(num_features, dtype=np.float64)
