[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from .base import BaseLayer
[?2004l[?2004h> 
[?2004l[?2004h> class MaxPool2D(BaseLayer):
[?2004l[?2004h>     """
[?2004l[?2004h>     Max Pooling layer.
[?2004l[?2004h>     """
[?2004l        for n in range(batch_size):
            for c in range(channels):
                for i in range(0, in_h, stride):
                    for j in range(0, in_w, stride):
                        if i + kernel_size <= in_h and j + kernel_size <= in_w:
                            window = x[n, i:i+kernel_size, j:j+kernel_size, c]
                            output[n, i//stride, j//stride, c] = np.max(window)
        
        return output

class AvgPool2D(BaseLayer):
    """
    Average Pooling layer.
    """
    def __init__(self, kernel_size: int, stride: int | None = None):
        super().__init__()
        self.kernel_size = kernel_size
        self.stride = stride if stride is not None else kernel_size
    
    def forward(self, x: np.ndarray) -> np.ndarray:
        """
        Perform average pooling operation.
        
        Args:
            x: Input of shape (batch_size, height, width, channels), dtype float64
        
        Returns:
            Output of shape (batch_size, out_height, out_width, channels), dtype float64
        """
        batch_size, in_h, in_w, channels = x.shape
        stride = self.stride
        kernel_size = self.kernel_size
        
        out_h = (in_h - kernel_size) // stride + 1
        out_w = (in_w - kernel_size) // stride + 1
        
        output = np.zeros((batch_size, out_h, out_w, channels), dtype=np.float64)
        
        for n in range(batch_size):
            for c in range(channels):
                for i in range(0, in_h, stride):
                    for j in range(0, in_w, stride):
                        if i + kernel_size <= in_h and j + kernel_size <= in_w:
                            window = x[n, i:i+kernel_size, j:j+kernel_size, c]
                            output[n, i//stride, j//stride, c] = np.mean(window)
        
        return output
