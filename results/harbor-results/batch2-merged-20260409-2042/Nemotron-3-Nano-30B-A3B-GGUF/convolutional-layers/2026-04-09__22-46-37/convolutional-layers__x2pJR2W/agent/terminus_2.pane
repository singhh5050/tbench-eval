[?2004l[?2004h>         """
[?2004l[?2004h>         if training:
[?2004l[?2004h>             # Compute mean and variance for each channel
[?2004l[?2004h>             mean = np.mean(x, axis=(0, 1, 2))  # Shape: (num_features,)
[?2004l[?2004h>             var = np.var(x, axis=(0, 1, 2))
[?2004l[?2004h>             
