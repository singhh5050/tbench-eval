[?2004l[?2004hroot@58396a593594:/app# cat > /app/src/conv_transpose.py << 'EOF'
[?2004lsed convolution operation.
        
        Args:
            x: Input of shape (batch_size, height, width, in_channels), dtype float64
        
        Returns:
            Output of shape (batch_size, out_height, out_width, out_channels), dtype float64
        """
        batch_size, in_h, in_w, _ = x.shape
        
        # Calculate output dimensions
        out_h = (in_h - 1) * self.stride - 2 * self.padding + self.kernel_size
        out_w = (in_w - 1) * self.stride - 2 * self.padding + self.kernel_size
        
        # Initialize output
        output = np.zeros((batch_size, out_h, out_w, self.out_channels), dtype=np.float64)
        
        # Perform transposed convolution
        for n in range(batch_size):
            for c_in in range(self.in_channels):
                for kh in range(self.kernel_size):
                    for kw in range(self.kernel_size):
                        # Calculate position in output space
                        h_out = kh + (np.arange(in_h) * self.stride)
                        w_out = kw + (np.arange(in_w) * self.stride)
                        
                        # Remove padding if needed
                        h_start = np.maximum(h_out - self.padding, 0)
                        w_start = np.maximum(w_out - self.padding, 0)
                        h_end = np.minimum(h_out + 1 - self.padding, out_h)
                        w_end = np.minimum(w_out + 1 - self.padding, out_w)
                        
                        # Add contribution
                        output[n, h_start:h_end, w_start:w_end, c_in] += self.weights[c_in, :, kh, kw]
        
        # Add bias
        output += self.bias
        
        return output
