[?2004l[?2004h> class Sigmoid(BaseLayer):
[?2004l[?2004h>     """
[?2004l[?2004h>     Sigmoid activation function.
[?2004l[?2004h>     """
[?2004l[?2004h>     def __init__(self):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>     
[?2004l[?2004h>     def forward(self, x: np.ndarray) -> np.ndarray:
[?2004l[?2004h>         """
[?2004l[?2004h>         Apply Sigmoid activation function.
[?2004l[?2004h>         
[?2004l[?2004h>         Args:
[?2004l[?2004h>             x: Input array of any shape, dtype float64
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             Output of same shape, dtype float64
[?2004l[?2004h>         """
[?2004l[?2004h>         # Numerically stable sigmoid implementation
[?2004l[?2004h>         # For large positive values: 1 / (1 + exp(-x)) ~ 1
[?2004l[?2004h>         # For large negative values: exp(x) / (1 + exp(x))
[?2004l[?2004h>         
[?2004l[?2004h>         # Handle large positive values
[?2004l[?2004h>         pos_mask = x >= 0
[?2004l[?2004h>         neg_mask = ~pos_mask
[?2004l[?2004h>         
[?2004l[?2004h>         # For non-negative values: 1 / (1 + exp(-x))
[?2004l[?2004h>         pos_out = 1.0 / (1.0 + np.exp(-x[pos_mask]))
[?2004l[?2004h>         
[?2004l[?2004h>         # For negative values: exp(x) / (1 + exp(x))
[?2004l[?2004h>         # This avoids overflow issues
[?2004l[?2004h>         exp_x = np.exp(x[neg_mask])
[?2004l[?2004h>         neg_out = exp_x / (1.0 + exp_x)
[?2004l[?2004h>         
[?2004l[?2004h>         out = np.zeros_like(x)
[?2004l[?2004h>         out[pos_mask] = pos_out
[?2004l[?2004h>         out[neg_mask] = neg_out
[?2004l[?2004h>         
[?2004l[?2004h>         return out
