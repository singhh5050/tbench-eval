[126.478472, "o", "def read_books():\r\n\u001b[?2004l\r"]
[126.478483, "o", "\u001b[?2004h> "]
[126.478497, "o", "    books = {}\r\n\u001b[?2004l\r"]
[126.478511, "o", "\u001b[?2004h> "]
[126.478548, "o", "    with open('data/BOOKS.DAT', 'rb') as f:\r\n\u001b[?2004l\r"]
[126.478563, "o", "\u001b[?2004h> "]
[126.478581, "o", "        content = f.read()\r\n\u001b[?2004l\r"]
[126.478594, "o", "\u001b[?2004h>     \r\n"]
[126.47861, "o", "\u001b[?2004l\r\u001b[?2004h"]
[126.478621, "o", "> "]
[126.478778, "o", "    # Each book record is 28 bytes: 4+20+4\r\n\u001b[?2004l\r"]
[126.47881, "o", "\u001b[?2004h> "]
[126.478856, "o", "    for i in range(0, len(content), 28):\r\n\u001b[?2004l\r"]
[126.478867, "o", "\u001b[?2004h> "]
[126.478902, "o", "        record = content[i:i+28]\r\n\u001b[?2004l\r"]
[126.478918, "o", "\u001b[?2004h> "]
[126.47895, "o", "        book_id = record[0:4].decode('ascii')\r\n\u001b[?2004l\r"]
[126.478963, "o", "\u001b[?2004h> "]
[126.47901, "o", "        title = record[4:24].decode('ascii').strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.479025, "o", "> "]
[126.479057, "o", "        owner = record[24:28].decode('ascii')\r\n\u001b[?2004l\r"]
[126.479068, "o", "\u001b[?2004h> "]
[126.4791, "o", "        books[book_id] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.479123, "o", ">             'title': title,\r\n"]
[126.47913, "o", "\u001b[?2004l\r\u001b[?2004h"]
[126.479151, "o", "> "]
[126.479163, "o", "            'owner': owner\r\n\u001b[?2004l\r"]
[126.47919, "o", "\u001b[?2004h> "]
[126.479212, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.479227, "o", "    return books\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[126.479245, "o", "\u001b[?2004h> "]
[126.479262, "o", "# Write ACCOUNTS.DAT\r\n\u001b[?2004l\r"]
[126.479273, "o", "\u001b[?2004h> "]
[126.4793, "o", "def write_accounts(accounts):\r\n"]
[126.479309, "o", "\u001b[?2004l\r"]
[126.47932, "o", "\u001b[?2004h> "]
[126.479331, "o", "    records = []\r\n\u001b[?2004l\r"]
[126.47934, "o", "\u001b[?2004h> "]
[126.479395, "o", "    for acc_id, data in accounts.items():\r\n\u001b[?2004l\r"]
[126.479406, "o", "\u001b[?2004h"]
[126.479418, "o", "> "]
[126.479451, "o", "        name = data['name'].ljust(20)[:20]\r\n\u001b[?2004l\r"]
[126.479464, "o", "\u001b[?2004h> "]
[126.479511, "o", "        balance = f\"{data['balance']:010}\"\r\n\u001b[?2004l\r"]
[126.479524, "o", "\u001b[?2004h> "]
[126.479605, "o", "        records.append(acc_id.encode('ascii') + name.encode('ascii') + balance.encode('ascii'))\r\n\u001b[?2004l\r"]
[126.479616, "o", "\u001b[?2004h> "]
[126.479628, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[126.47964, "o", "> "]
[126.479681, "o", "    with open('data/ACCOUNTS.DAT', 'wb') as f:\r\n\u001b[?2004l\r"]
[126.479693, "o", "\u001b[?2004h> "]
[126.479728, "o", "        f.write(b''.join(records))\r\n\u001b[?2004l\r"]
[126.47974, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[126.479751, "o", "\u001b[?2004h> "]
[126.479773, "o", "# Write BOOKS.DAT\r\n\u001b[?2004l\r"]
[126.479786, "o", "\u001b[?2004h> "]
[126.479809, "o", "def write_books(books):\r\n\u001b[?2004l\r"]
[126.479822, "o", "\u001b[?2004h> "]
[126.47984, "o", "    records = []\r\n"]
[126.479854, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[126.479893, "o", "    for book_id, data in books.items():\r\n\u001b[?2004l\r"]
[126.479906, "o", "\u001b[?2004h> "]
[126.479946, "o", "        title = data['title'].ljust(20)[:20]\r\n\u001b[?2004l\r"]
[126.479958, "o", "\u001b[?2004h> "]
[126.480002, "o", "        owner = data['owner'].ljust(4)[:4]\r\n\u001b[?2004l\r"]
[126.480015, "o", "\u001b[?2004h> "]
[126.480102, "o", "        records.append(book_id.encode('ascii') + title.encode('ascii') + owner.encode('ascii'))\r\n\u001b[?2004l\r"]
[126.480116, "o", "\u001b[?2004h> "]
[126.480128, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[126.480139, "o", "> "]
[126.480171, "o", "    with open('data/BOOKS.DAT', 'wb') as f:\r\n\u001b[?2004l\r"]
[126.480184, "o", "\u001b[?2004h> "]
[126.48022, "o", "        f.write(b''.join(records))\r\n\u001b[?2004l\r"]
[126.480235, "o", "\u001b[?2004h> "]
[126.480246, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.48027, "o", "# Append to TRANSACTIONS.DAT\r\n\u001b[?2004l\r"]
[126.480283, "o", "\u001b[?2004h"]
[126.480295, "o", "> "]
[126.480318, "o", "def append_transaction(trans_data):\r\n\u001b[?2004l\r"]
[126.480332, "o", "\u001b[?2004h> "]
[126.480382, "o", "    with open('data/TRANSACTIONS.DAT', 'ab') as f:\r\n\u001b[?2004l\r"]
[126.480395, "o", "\u001b[?2004h"]
[126.480406, "o", "> "]
[126.480425, "o", "        f.write(trans_data)\r\n\u001b[?2004l\r"]
[126.480437, "o", "\u001b[?2004h> "]
[126.480455, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.480469, "o", "# Main processing\r\n\u001b[?2004l\r"]
[126.480481, "o", "\u001b[?2004h> "]
[126.48051, "o", "accounts = read_accounts()\r\n\u001b[?2004l\r"]
[126.480522, "o", "\u001b[?2004h> "]
[126.480545, "o", "books = read_books()\r\n\u001b[?2004l\r"]
[126.480556, "o", "\u001b[?2004h> \r\n"]
[126.48057, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[126.480604, "o", "# Validate buyer and seller exist\r\n\u001b[?2004l\r"]
[126.480615, "o", "\u001b[?2004h> "]
[126.480652, "o", "buyer_found = buyer_id in accounts\r\n\u001b[?2004l\r"]
[126.480662, "o", "\u001b[?2004h> "]
[126.480698, "o", "seller_found = seller_id in accounts\r\n\u001b[?2004l\r"]
[126.480708, "o", "\u001b[?2004h> "]
[126.480721, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.48073, "o", "> "]
[126.480762, "o", "# Validate book exists and seller is owner\r\n\u001b[?2004l\r"]
[126.480774, "o", "\u001b[?2004h> "]
[126.480807, "o", "book_found = book_id in books\r\n\u001b[?2004l\r"]
[126.480818, "o", "\u001b[?2004h> "]
[126.480887, "o", "valid_owner = books[book_id]['owner'] == seller_id if book_found else False\r\n\u001b[?2004l\r"]
[126.480907, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[126.480918, "o", "\u001b[?2004h> "]
[126.480971, "o", "if buyer_found and seller_found and book_found and valid_owner:\r\n\u001b[?2004l\r"]
[126.480984, "o", "\u001b[?2004h> "]
[126.481012, "o", "    # Update account balances\r\n\u001b[?2004l\r"]
[126.481025, "o", "\u001b[?2004h> "]
[126.481066, "o", "    accounts[buyer_id]['balance'] -= amount\r\n\u001b[?2004l\r"]
[126.48108, "o", "\u001b[?2004h> "]
[126.481122, "o", "    accounts[seller_id]['balance'] += amount\r\n\u001b[?2004l\r"]
[126.481136, "o", "\u001b[?2004h> "]
[126.481149, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[126.48116, "o", "> "]
[126.481179, "o", "    # Update book owner\r\n\u001b[?2004l\r"]
[126.481191, "o", "\u001b[?2004h> "]
[126.481232, "o", "    books[book_id]['owner'] = buyer_id\r\n\u001b[?2004l\r"]
[126.481247, "o", "\u001b[?2004h> "]
[126.481259, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.481285, "o", "    # Write updated files\r\n\u001b[?2004l\r"]
[126.481298, "o", "\u001b[?2004h> "]
[126.481326, "o", "    write_accounts(accounts)\r\n\u001b[?2004l\r"]
[126.481339, "o", "\u001b[?2004h> "]
[126.481364, "o", "    write_books(books)\r\n\u001b[?2004l\r"]
[126.481382, "o", "\u001b[?2004h> "]
[126.481396, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[126.481408, "o", "> "]
[126.481462, "o", "    # Append transaction to TRANSACTIONS.DAT (4+10+4+4 = 22 bytes)\r\n\u001b[?2004l\r"]
[126.481473, "o", "\u001b[?2004h> "]
[126.481498, "o", "    trans_record = (\r\n\u001b[?2004l\r"]
[126.481512, "o", "\u001b[?2004h> "]
[126.481546, "o", "        buyer_id.encode('ascii') + \r\n\u001b[?2004l\r"]
[126.48156, "o", "\u001b[?2004h> "]
[126.481599, "o", "        f\"{amount:010}\".encode('ascii') + \r\n\u001b[?2004l\r"]
[126.481612, "o", "\u001b[?2004h> "]
[126.481646, "o", "        seller_id.encode('ascii') + \r\n\u001b[?2004l\r"]
[126.48166, "o", "\u001b[?2004h> "]
[126.481694, "o", "        book_id.encode('ascii')\r\n\u001b[?2004l\r"]
[126.481704, "o", "\u001b[?2004h> "]
[126.481717, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.481728, "o", "> "]
[126.481759, "o", "    append_transaction(trans_record)\r\n\u001b[?2004l\r"]
[126.481772, "o", "\u001b[?2004h> "]
[126.481784, "o", "    \r\n\u001b[?2004l\r"]
[126.481796, "o", "\u001b[?2004h> "]
[126.481844, "o", "    print(\"Transaction completed successfully\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.481857, "o", "> "]
[126.481868, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.481882, "o", "> "]
[126.481925, "o", "    print(\"Transaction failed due to validation errors\")\r\n\u001b[?2004l\r"]
[126.481937, "o", "\u001b[?2004h> EOL"]
