[394.503656, "o", "cat /app/program.py\r\n\u001b[?2004l\r"]
[394.504087, "o", "# Read input data\r\nwith open('src/INPUT.DAT', 'rb') as f:\r\n    input_data = f.read()\r\n\r\n# Parse input record (fixed-length fields)\r\nbuyer_id = input_data[0:4].decode('ascii')\r\nseller_id = input_data[4:8].decode('ascii')\r\nbook_id = input_data[8:12].decode('ascii')\r\namount_str = input_data[12:22].decode('ascii')\r\namount = int(amount_str)\r\n\r\n# Read ACCOUNTS.DAT\r\ndef read_accounts():\r\n    accounts = {}\r\n    with open('data/ACCOUNTS.DAT', 'rb') as f:\r\n        content = f.read()\r\n    \r\n    # Each account record is 34 bytes: 4+20+10\r\n    for i in range(0, len(content), 34):\r\n        record = content[i:i+34]\r\n        acc_id = record[0:4].decode('ascii')\r\n        acc_name = record[4:24].decode('ascii').strip()\r\n        balance = int(record[24:34].decode('ascii'))\r\n        accounts[acc_id] = {\r\n            'name': acc_name,\r\n            'balance': balance\r\n        }\r\n    return accounts\r\n\r\n# Read BOOKS.DAT\r\ndef read_books():\r\n"]
[394.504116, "o", "    books = {}\r\n    with open('data/BOOKS.DAT', 'rb') as f:\r\n        content = f.read()\r\n    \r\n    # Each book record is 28 bytes: 4+20+4\r\n    for i in range(0, len(content), 28):\r\n        record = content[i:i+28]\r\n        book_id = record[0:4].decode('ascii')\r\n        title = record[4:24].decode('ascii').strip()\r\n        owner = record[24:28].decode('ascii')\r\n        books[book_id] = {\r\n            'title': title,\r\n            'owner': owner\r\n        }\r\n    return books\r\n\r\n# Write ACCOUNTS.DAT\r\ndef write_accounts(accounts):\r\n    records = []\r\n    for acc_id, data in accounts.items():\r\n        name = data['name'].ljust(20)[:20]\r\n        balance = f\"{data['balance']:010}\"\r\n        records.append(acc_id.encode('ascii') + name.encode('ascii') + balance.encode('ascii'))\r\n    \r\n    with open('data/ACCOUNTS.DAT', 'wb') as f:\r\n        f.write(b''.join(records))\r\n\r\n# Write BOOKS.DAT\r\ndef write_books(books):\r\n    records = []\r\n    for book_id, data in books.items():\r\n        title = data['title'].ljust(20)[:20]\r\n     "]
[394.504139, "o", "   owner = data['owner'].ljust(4)[:4]\r\n        records.append(book_id.encode('ascii') + title.encode('ascii') + owner.encode('ascii'))\r\n    \r\n    with open('data/BOOKS.DAT', 'wb') as f:\r\n        f.write(b''.join(records))\r\n\r\n# Append to TRANSACTIONS.DAT\r\ndef append_transaction(trans_data):\r\n    with open('data/TRANSACTIONS.DAT', 'ab') as f:\r\n        f.write(trans_data)\r\n\r\n# Main processing\r\naccounts = read_accounts()\r\nbooks = read_books()\r\n\r\n# Validate buyer and seller exist\r\nbuyer_found = buyer_id in accounts\r\nseller_found = seller_id in accounts\r\n\r\n# Validate book exists and seller is owner\r\nbook_found = book_id in books\r\nvalid_owner = books[book_id]['owner'] == seller_id if book_found else False\r\n\r\nif buyer_found and seller_found and book_found and valid_owner:\r\n    # Update account balances\r\n    accounts[buyer_id]['balance'] -= amount\r\n    accounts[seller_id]['balance'] += amount\r\n    \r\n    # Update book owner\r\n    books[book_id]['owner'] = buyer_id\r\n    \r\n    # Write updated files\r\n    write_accounts(acc"]
