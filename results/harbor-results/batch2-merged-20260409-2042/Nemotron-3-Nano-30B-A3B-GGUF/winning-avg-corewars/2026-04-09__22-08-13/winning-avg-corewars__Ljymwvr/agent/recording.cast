[583.385054, "i", "cat > my_warrior.red << 'EOF'\n;redcode-94\n;name MyWarrior\n;author AI\n;assert CORESIZE == 8000\n\nstart   jmp init\n\ninit    spl 1\n    mov copy, *ptr\n    add #57, ptr\n    mov copy, @ptr\n    jmp loop\n\ncopy    spl 0, 0\nptr     dat 1, 1\n\nloop    djn copy, 2\n      spl 0\n      djn loop, 7\n\n; Bombing sequence 1\nbomb1_start equ 1500\nbomb1_loop spl bomb1_target, @bomb1_start\n      add #277, bomb1_start\n      jmp bomb1_loop\nbomb1_target dat bomb1_target, 0\nbomb1_equ    dat #277, #277\n\n; Bombing sequence 2\nbomb2_start equ 2500\nbomb2_loop spl bomb2_target, @bomb2_start\n      add #311, bomb2_start\n      jmp bomb2_loop\nbomb2_target dat bomb2_target, 0\nbomb2_equ    dat #311, #311\n\n; Protection\nprotect_start 3500\nspl 0, 0\n    djn protect, 11\nprotect spl 0, 0\n    dat 0, 0\n\nend start\nEOF\n"]
