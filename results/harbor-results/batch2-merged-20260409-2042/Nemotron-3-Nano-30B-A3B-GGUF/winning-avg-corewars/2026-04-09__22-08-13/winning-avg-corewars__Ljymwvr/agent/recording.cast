[456.206043, "i", "cat > my_warrior.red << 'EOF'\n;redcode-94\n;name MyWarrior\n;author AI\n;assert CORESIZE == 8000\n\nstart   jmp init\n\ninit    spl 1\n    mov copy, *ptr\n    add #59, ptr\n    mov copy, @ptr\n    jmp loop\n\ncopy    spl 0, 0\nptr     dat 1, 1\n\nloop    djn copy, 2\n      spl 0\n      djn loop, 7\n\n; Bombing sequence - multiple coprime intervals\nbomb1_start equ 1000\nbomb1_loop spl bomb1_target, @bomb1_start\n       add #277, bomb1_start\n       jmp bomb1_loop\n\nbomb1_target dat bomb1_target, 0\nbomb1_equ   dat #277, #277\n\nbomb2_start equ 2000\nbomb2_loop spl bomb2_target, @bomb2_start\n       add #311, bomb2_start\n       jmp bomb2_loop\n\nbomb2_target dat bomb2_target, 0\nbomb2_equ   dat #311, #311\n\n; Anti-imp traps\nimp_trap_start equ 3000\nimp_trap_loop spl imp_trap, @imp_trap_start\n      add #379, imp_trap_start\n      jmp imp_trap_loop\n\nimp_trap  spl 0, -1\n      dat -1, -1\n\n; Protection\nprotect_start equ 4000\norg protect_start\n    spl 0, 0\n    djn protect, 12\n\nprotect spl 0, 0\n    dat 0, 0\n\nend start\nEOF\n"]
