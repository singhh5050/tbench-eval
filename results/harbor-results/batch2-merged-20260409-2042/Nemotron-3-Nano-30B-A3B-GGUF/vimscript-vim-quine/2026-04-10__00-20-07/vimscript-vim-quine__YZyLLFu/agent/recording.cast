[75.193122, "i", "cat > /app/plugin/layout_quine.vim <<'EOF'\n\" Vimscript plugin: LayoutQuine\n\" Provides :LayoutQuine {path} to save current layout as Vimscript\n\nfunction! s:LayoutQuine(path) abort\n  \" Collect tab page information\n  let l:tabs = gettabinfo()\n  \" Open the output file for writing\n  let l:fd = fopen(a:path, 'w')\n  if l:fd < 0\n    echohl ErrorMsg | echomsg 'Cannot open file for writing: ' . a:path | echohl None\n    return\n  endif\n\n  \" Write header\n  call write(l:fd, '# Generated by LayoutQuine\\n')\n  call write(l:fd, '# Recreates tabs, windows, and buffers\\n\\n')\n\n  \" Helper to write a line\n  function! s:write_line(txt) abort\n    call write(l:fd, a:txt . \"\\n\")\n  endfunction\n\n  \" Define helper to edit a buffer safely\n  call s:write_line('function! s:OpenBuffer(bufnr) abort')\n  call s:write_line('  if empty(bufname(a:bufnr))')\n  call s:write_line('    enew')\n  call s:write_line('  else')\n  call s:write_line('    execute \"edit \" . fnameescape(bufname(a:bufnr))')\n  call s:write_line('  endif')\n  call s:write_line('endfun"]
[75.193244, "i", "ction')\n\n  \" Recreate tabs and their windows\n  call s:write_line(\"\\n\"\" Recreate tabs and their windows)\"'\n  for t in range(len(l:tabs))\n    call s:write_line('tabnew')\n    let l:winfos = l:tabs[t].windows\n    for wi in range(len(l:winfos))\n      let win = l:winfos[wi]\n      call s:write_line('\" Window ' . (wi + 1) . ' in tab ' . (t + 1))'\n      call s:write_line('\" Size: ' . win.width . 'x' . win.height . ' Orientation: ' . (win.vertical ? \"vertical\" : \"horizontal\"))'\n      if win.vertical\n        call s:write_line('vertical split')\n      else\n        call s:write_line('split')\n      endif\n      call s:write_line('let win_buf = ' . win.bufnr)\n      call s:write_line('call s:OpenBuffer(win_buf)')\n      \" Attempt to resize the window to original height/width\n      if win.height > 0\n        call s:write_line('resize ' . win.height)\n      endif\n      if win.width > 0\n        call s:write_line('wincmd ' . win.width . 'c')\n      endif\n    endfor\n    \" Switch to next tab if not the last one\n    if t < (len(l:tabs) -"]
[75.193276, "o", "cat > /app/plugin/layout_quine.vim <<'EOF'\r\n\u001b[?2004l\r"]
[75.193287, "i", " 1)\n      call s:write_line('tabnext')\n    endif\n  endfor\n\n  \" Close the file descriptor\n  call close(l:fd)\n  echohl ModeMsg | echomsg \"Layout script written to: \" . a:path | echohl None\nendfunction\n\ncommand! -nargs=1 LayoutQuine call s:LayoutQuine(<f-args>)\nEOF\n"]
[75.193324, "o", "ction')\r\n\r\n  \" Recreate tabs and their windows\r\n  call s:write_line(\"\\n\"\" Recreate tabs and their windows)\"'\r\n  for t in range(len(l:tabs))\r\n    call s:write_line('tabnew')\r\n    let l:winfos = l:tabs[t].windows\r\n    for wi in range(len(l:winfos))\r\n      let win = l:winfos[wi]\r\n      call s:write_line('\" Window ' . (wi + 1) . ' in tab ' . (t + 1))'\r\n      call s:write_line('\" Size: ' . win.width . 'x' . win.height . ' Orientation: ' . (win.vertical ? \"vertical\" : \"horizontal\"))'\r\n      if win.vertical\r\n        call s:write_line('vertical split')\r\n      else\r\n        call s:write_line('split')\r\n      endif\r\n      call s:write_line('let win_buf = ' . win.bufnr)\r\n      call s:write_line('call s:OpenBuffer(win_buf)')\r\n      \" A"]
[75.193348, "o", "ttempt to resize the window to original height/width\r\n      if win.height > 0\r\n        call s:write_line('resize ' . win.height)\r\n      endif\r\n      if win.width > 0\r\n        call s:write_line('wincmd ' . win.width . 'c')\r\n      endif\r\n    endfor\r\n    \" Switch to n"]
[75.193364, "o", "ext tab if not the last one\r\n    if t < (len(l:tabs) - 1)\r\n      call s:write_line('tabnext')\r\n    endif\r\n  endfor\r\n\r\n  \" Close the file des"]
[75.193381, "o", "criptor\r\n  call close(l:fd)\r\n  echohl ModeMsg | echomsg \"Layout script written to: \" . a:path | echohl None\r\nendfunc"]
[75.193396, "o", "tion\r\n\r\ncommand! -nargs=1 LayoutQuine call s:LayoutQuine(<f-args>)\r\nEOF\r\n"]
