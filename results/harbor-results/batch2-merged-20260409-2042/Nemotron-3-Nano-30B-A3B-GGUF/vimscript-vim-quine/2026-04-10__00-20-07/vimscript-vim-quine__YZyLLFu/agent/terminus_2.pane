[?2004lction')

  " Recreate tabs and their windows
  call s:write_line("\n"" Recreate tabs and their windows)"'
  for t in range(len(l:tabs))
    call s:write_line('tabnew')
    let l:winfos = l:tabs[t].windows
    for wi in range(len(l:winfos))
      let win = l:winfos[wi]
      call s:write_line('" Window ' . (wi + 1) . ' in tab ' . (t + 1))'
      call s:write_line('" Size: ' . win.width . 'x' . win.height . ' Orientation: ' . (win.vertical ? "vertical" : "horizontal"))'
      if win.vertical
        call s:write_line('vertical split')
      else
        call s:write_line('split')
      endif
      call s:write_line('let win_buf = ' . win.bufnr)
      call s:write_line('call s:OpenBuffer(win_buf)')
      " Attempt to resize the window to original height/width
      if win.height > 0
        call s:write_line('resize ' . win.height)
      endif
      if win.width > 0
        call s:write_line('wincmd ' . win.width . 'c')
      endif
    endfor
    " Switch to next tab if not the last one
    if t < (len(l:tabs) - 1)
      call s:write_line('tabnext')
    endif
  endfor

  " Close the file descriptor
  call close(l:fd)
  echohl ModeMsg | echomsg "Layout script written to: " . a:path | echohl None
endfunction

command! -nargs=1 LayoutQuine call s:LayoutQuine(<f-args>)
