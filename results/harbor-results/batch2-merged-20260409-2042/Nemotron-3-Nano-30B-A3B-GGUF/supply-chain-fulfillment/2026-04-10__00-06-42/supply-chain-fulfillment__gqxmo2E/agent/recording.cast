[91.604234, "o", "class CompatibilityConstraint:\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.604253, "o", "> "]
[91.60429, "o", "    def __init__(self, data):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.604354, "o", "        self.type = data['constraint_type']\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.60439, "o", "> "]
[91.604438, "o", "        self.shipment_ids = data['shipment_ids']\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.604467, "o", "> "]
[91.604513, "o", "        self.description = data['description']\r\n\u001b[?2004l\r"]
[91.604532, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.604548, "o", "> "]
[91.604592, "o", "def read_jsonl(path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.604627, "o", "    data = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.604668, "o", "    with open(path, 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.604688, "o", "> "]
[91.604724, "o", "        for line in f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.604776, "o", "            if line.strip():\r\n\u001b[?2004l\r"]
[91.604795, "o", "\u001b[?2004h> "]
[91.604852, "o", "                data.append(json.loads(line))\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.604871, "o", "> "]
[91.604891, "o", "    return data\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.604907, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.604962, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.604992, "o", "    # Read all input data\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.60501, "o", "> "]
[91.605112, "o", "    destinations_data = read_jsonl('/app/task_file/input_data/destinations.jsonl')\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.605142, "o", "> "]
[91.605225, "o", "    warehouses_data = read_jsonl('/app/task_file/input_data/warehouses.jsonl')\r\n\u001b[?2004l\r"]
[91.605243, "o", "\u001b[?2004h> "]
[91.60533, "o", "    routes_data = read_jsonl('/app/task_file/input_data/routes.jsonl')\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.605349, "o", "> "]
[91.605439, "o", "    shipments_data = read_jsonl('/app/task_file/input_data/shipments.jsonl')\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.605468, "o", "> "]
[91.60556, "o", "    compatibility_data = read_jsonl('/app/task_file/input_data/compatibility.jsonl')\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.605591, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.605638, "o", "    # Create lookup dictionaries\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.605661, "o", "> "]
[91.605747, "o", "    destinations = {d['destination_id']: d for d in destinations_data}\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.605765, "o", "> "]
[91.605843, "o", "    warehouses = {w['warehouse_id']: w for w in warehouses_data}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.605873, "o", "    routes = {}\r\n\u001b[?2004l\r"]
[91.605892, "o", "\u001b[?2004h> "]
[91.605931, "o", "    for r in routes_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.606004, "o", "        key = (r['warehouse_id'], r['destination_id'])\r\n\u001b[?2004l\r"]
[91.606038, "o", "\u001b[?2004h> "]
[91.606069, "o", "        routes[key] = r\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[91.606088, "o", "\u001b[?2004h> "]
[91.606177, "o", "    shipments = {s['shipment_id']: Shipment(s) for s in shipments_data}\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.606196, "o", ">     \r\n\u001b[?2004l\r"]
[91.606234, "o", "\u001b[?2004h> "]
[91.606264, "o", "    compatibility_constraints = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.60629, "o", "> "]
[91.606327, "o", "    for c in compatibility_data:\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.606357, "o", "> "]
[91.606406, "o", "        constraint = CompatibilityConstraint(c)\r\n\u001b[?2004l\r"]
[91.60644, "o", "\u001b[?2004h> "]
[91.606492, "o", "        compatibility_constraints.append(constraint)\r\n\u001b[?2004l\r"]
[91.606511, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[91.60655, "o", "\u001b[?2004h> "]
[91.606621, "o", "    # Group shipments by destination region for regional quota constraint\r\n\u001b[?2004l\r"]
[91.606642, "o", "\u001b[?2004h> "]
[91.606742, "o", "    destination_regions = {d['destination_id']: d['region'] for d in destinations_data}\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.606782, "o", "> "]
[91.606878, "o", "    shipment_regions = {s.id: destination_regions[s.destination_id] for s in shipments.values()}\r\n\u001b[?2004l\r"]
[91.60691, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[91.606942, "o", "\u001b[?2004h> "]
[91.606973, "o", "    # Count shipments per region\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.60703, "o", "    region_counts = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.607081, "o", "    for s in shipments.values():\r\n\u001b[?2004l\r"]
[91.6071, "o", "\u001b[?2004h> "]
[91.607164, "o", "        region_counts[shipment_regions[s.id]] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.607183, "o", ">     \r\n\u001b[?2004l\r"]
[91.607198, "o", "\u001b[?2004h> "]
[91.607269, "o", "    # Calculate minimum required shipments per region\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.6073, "o", "> "]
[91.607333, "o", "    total_shipments = len(shipments)\r\n\u001b[?2004l\r"]
[91.607353, "o", "\u001b[?2004h> "]
[91.60741, "o", "    num_regions = len(destination_regions)\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.607438, "o", "> "]
[91.607535, "o", "    min_shipments_per_region = total_shipments / (2 * num_regions) if num_regions > 0 else 0\r\n\u001b[?2004l\r"]
[91.607554, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[91.607569, "o", "\u001b[?2004h> "]
[91.607646, "o", "    # Build region counts mapping for each shipment\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.607701, "o", "    shipment_to_region = shipment_regions\r\n\u001b[?2004l\r"]
[91.60772, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[91.607735, "o", "\u001b[?2004h> "]
[91.607788, "o", "    # Prepare output assignments\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.607808, "o", "> "]
[91.607848, "o", "    assignments = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[91.607877, "o", "\u001b[?2004h> "]
[91.607931, "o", "    # For each shipment, find a valid warehouse\r\n\u001b[?2004l\r"]
[91.607951, "o", "\u001b[?2004h> "]
[91.608021, "o", "    # We'll use a greedy approach with constraint checking\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.60804, "o", ">     \r\n\u001b[?2004l\r"]
[91.608055, "o", "\u001b[?2004h> "]
[91.608139, "o", "    # First, let's collect all valid routes for each destination\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.608175, "o", "> "]
[91.608212, "o", "    destination_routes = defaultdict(list)\r\n\u001b[?2004l\r"]
[91.608235, "o", "\u001b[?2004h> "]
[91.608276, "o", "    for route in routes_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.608333, "o", "        destination_routes[route['destination_id']].append(route)\r\n\u001b[?2004l\r"]
[91.608352, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[91.608369, "o", "\u001b[?2004h> "]
[91.608422, "o", "    # Sort shipments by deadline (earlier deadlines first)\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.608458, "o", "> "]
[91.608519, "o", "    sorted_shipments = sorted(shipments.items(), key=lambda x: shipments[x[0]].deadline_hours)\r\n\u001b[?2004l\r"]
[91.608538, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[91.608553, "o", "\u001b[?2004h> "]
[91.608604, "o", "    # Track assignments and usage\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.608673, "o", "    warehouse_assignments = defaultdict(list)  # warehouse_id -> list of shipment_ids\r\n\u001b[?2004l\r"]
[91.608691, "o", "\u001b[?2004h> "]
[91.608775, "o", "    route_usage = defaultdict(lambda: {'volume': 0, 'weight': 0})  # route_key -> {volume, weight}\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.608794, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.608847, "o", "> "]
[91.608879, "o", "    # Track precedence constraints\r\n\u001b[?2004l\r\u001b[?2004h>     precedence_groups = []\r\n\u001b[?2004l\r"]
[91.6089, "o", "\u001b[?2004h> "]
[91.608945, "o", "    for constraint in compatibility_constraints:\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.608974, "o", "> "]
[91.609006, "o", "        if constraint.type == 'precedence':\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.609025, "o", "> "]
[91.609077, "o", "            precedence_groups.append(constraint.shipment_ids)\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.609096, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.609112, "o", "> "]
[91.609153, "o", "    # Process shipments in order of deadline\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.609188, "o", "> "]
[91.609227, "o", "    for shipment_id, shipment in sorted_shipments:\r\n\u001b[?2004l\r"]
[91.609257, "o", "\u001b[?2004h> "]
[91.609297, "o", "        destination = destinations[shipment.destination_id]\r\n\u001b[?2004l\r"]
[91.609311, "o", "\u001b[?2004h>         "]
[91.609351, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.609379, "o", "        # Find valid routes for this destination\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.60943, "o", "        valid_routes = destination_routes[shipment.destination_id]\r\n\u001b[?2004l\r"]
[91.609446, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[91.609459, "o", "\u001b[?2004h> "]
[91.609504, "o", "        # Try to find the best warehouse for this shipment\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.609518, "o", "> "]
[91.609555, "o", "        best_warehouse = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.609584, "o", "        best_arrival_time = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.609608, "o", "        best_cost = float('inf')\r\n\u001b[?2004l\r"]
[91.609623, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[91.609637, "o", "\u001b[?2004h> "]
[91.609685, "o", "        # Group valid warehouses by capability requirements\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.6097, "o", "> "]
[91.609733, "o", "        candidate_warehouses = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.609864, "o", "        for route in valid_routes:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.609946, "o", "            warehouse = warehouses[route['warehouse_id']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.609998, "o", "            if not warehouse.can_handle_shipment(shipment):\r\n\u001b[?2004l\r"]
[91.610027, "o", "\u001b[?2004h> "]
[91.610053, "o", "                continue\r\n\u001b[?2004l\r"]
[91.610068, "o", "\u001b[?2004h> "]
[91.610106, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.610122, "o", "            # Check warehouse availability\r\n\u001b[?2004l\r"]
[91.610159, "o", "\u001b[?2004h> "]
[91.610191, "o", "            if shipment.deadline_hours < warehouse.availability_start:\r\n\u001b[?2004l\r"]
[91.610206, "o", "\u001b[?2004h> "]
[91.610241, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n"]
[91.610256, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[91.610301, "o", "            # Check if route capacities are respected\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.610317, "o", "> "]
[91.610367, "o", "            route_key = (route['warehouse_id'], route['destination_id'])\r\n\u001b[?2004l\r"]
[91.610382, "o", "\u001b[?2004h> "]
[91.610397, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.610438, "o", "> "]
[91.610472, "o", "            # For now, let's just check if we can assign without violating constraints\r\n\u001b[?2004l\r"]
[91.610488, "o", "\u001b[?2004h> "]
[91.610547, "o", "            # This is a simplified approach due to complexity of full optimization\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.610567, "o", ">             \r\n\u001b[?2004l\r"]
[91.610603, "o", "\u001b[?2004h> "]
[91.610642, "o", "            arrival_time = warehouse.availability_start + route.transit_time_hours\r\n\u001b[?2004l\r"]
[91.610657, "o", "\u001b[?2004h>             \r\n"]
[91.610693, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[91.610708, "o", "            # Check delivery window\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.610804, "o", "            if not (destination.delivery_window_start <= arrival_time <= destination.delivery_window_end):\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.61082, "o", "> "]
[91.610856, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n"]
[91.610871, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[91.610902, "o", "            # Check regional quota\r\n\u001b[?2004l\r"]
[91.610917, "o", "\u001b[?2004h> "]
[91.61096, "o", "            shipment_region = shipment_to_region[shipment_id]\r\n\u001b[?2004l\r"]
[91.61099, "o", "\u001b[?2004h> "]
[91.611058, "o", "            current_region_count = len([sid for sid in assignments if shipment_regions[sid] == shipment_region])\r\n\u001b[?2004l\r"]
[91.611077, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[91.611091, "o", "\u001b[?2004h> "]
[91.611157, "o", "            # This is a complex constraint - skip detailed implementation for now\r\n\u001b[?2004l\r"]
[91.611189, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[91.611218, "o", "\u001b[?2004h>             candidate_warehouses.append((\r\n"]
[91.611232, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[91.611292, "o", "                warehouse.base_handling_cost * shipment.volume / 100 + \r\n\u001b[?2004l\r"]
[91.611307, "o", "\u001b[?2004h> "]
[91.611369, "o", "                 route.base_cost_per_km * route.distance_km * shipment.weight / 1000 * \r\n\u001b[?2004l\r"]
[91.611384, "o", "\u001b[?2004h> "]
[91.611426, "o", "                 shipment.priority_multiplier,\r\n\u001b[?2004l\r"]
[91.611454, "o", "\u001b[?2004h> "]
[91.611469, "o", "                arrival_time,\r\n\u001b[?2004l\r"]
[91.611502, "o", "\u001b[?2004h>                 route\r\n\u001b[?2004l\r"]
[91.611517, "o", "\u001b[?2004h> "]
[91.611531, "o", "            ))\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.611551, "o", ">         \r\n\u001b[?2004l\r"]
[91.611607, "o", "\u001b[?2004h>         if not candidate_warehouses:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.61165, "o", "            # If no valid warehouse found, try a broader search\r\n\u001b[?2004l\r"]
[91.611666, "o", "\u001b[?2004h> "]
[91.611705, "o", "            # This should not happen in a valid solution\r\n\u001b[?2004l\r"]
[91.61172, "o", "\u001b[?2004h> "]
[91.611757, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.611787, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.611815, "o", "        # Select warehouse with minimum cost\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.61183, "o", "> "]
[91.611886, "o", "        cost, arrival_time, route = min(candidate_warehouses, key=lambda x: x[0])\r\n\u001b[?2004l\r"]
[91.611902, "o", "\u001b[?2004h>         "]
[91.611936, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.611951, "o", "        # Assign shipment to warehouse\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.611965, "o", "> "]
[91.61201, "o", "        assignments.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.612027, "o", "            'shipment_id': shipment_id,\r\n\u001b[?2004l\r"]
[91.61204, "o", "\u001b[?2004h> "]
[91.61208, "o", "            'warehouse_id': route.warehouse_id,\r\n\u001b[?2004l\r"]
[91.612096, "o", "\u001b[?2004h> "]
[91.612132, "o", "            'destination_id': shipment.destination_id\r\n\u001b[?2004l\r"]
[91.612146, "o", "\u001b[?2004h>         })"]
[91.61218, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.612211, "o", "        # Update tracking variables\r\n\u001b[?2004l\r"]
[91.612226, "o", "\u001b[?2004h> "]
[91.612279, "o", "        warehouse_assignments[route.warehouse_id].append(shipment_id)\r\n\u001b[?2004l\r"]
[91.612295, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[91.612326, "o", "\u001b[?2004h>         # Update route usage\r\n"]
[91.612343, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[91.612394, "o", "        route_key = (route.warehouse_id, route.destination_id)\r\n\u001b[?2004l\r"]
[91.612409, "o", "\u001b[?2004h> "]
[91.612456, "o", "        route_usage[route_key]['volume'] += shipment.volume\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.612508, "o", "        route_usage[route_key]['weight'] += shipment.weight\r\n\u001b[?2004l\r"]
[91.612524, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[91.612536, "o", "\u001b[?2004h> "]
[91.612579, "o", "    # Sort assignments by shipment_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.612618, "o", "    assignments.sort(key=lambda x: x['shipment_id'])\r\n\u001b[?2004l\r"]
[91.612633, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[91.612645, "o", "\u001b[?2004h> "]
[91.612687, "o", "    # Write output to file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.612729, "o", "    output_path = '/app/task_file/output_data/assignments.jsonl'\r\n\u001b[?2004l\r"]
[91.612747, "o", "\u001b[?2004h> "]
[91.612773, "o", "    with open(output_path, 'w') as f:\r\n\u001b[?2004l\r"]
