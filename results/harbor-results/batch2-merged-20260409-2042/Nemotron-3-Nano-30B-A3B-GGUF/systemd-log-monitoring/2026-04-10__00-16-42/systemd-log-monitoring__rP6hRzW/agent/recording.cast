[70.510667, "o", "\u001b[?2004h> After=network.target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.510687, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.510707, "o", "[Service]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.510715, "o", "Type=simple\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.510746, "o", "User=myapp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.51077, "o", "WorkingDirectory=/opt/myapp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.510806, "o", "ExecStart=/opt/myapp/app.py --log-level=INFO\r\n\u001b[?2004l\r"]
[70.510823, "o", "\u001b[?2004h> "]
[70.51084, "o", "Restart=on-failure\r\n\u001b[?2004l\r"]
[70.510857, "o", "\u001b[?2004h> "]
[70.510879, "o", "RestartSec=5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.510894, "o", "[Install]\r\n\u001b[?2004l\r"]
[70.510917, "o", "\u001b[?2004h> "]
[70.510942, "o", "WantedBy=multi-user.target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.510961, "o", "EOF\r\n\u001b[?2004l\r"]
