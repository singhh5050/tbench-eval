[70.510264, "i", "cat > /etc/systemd/system/myapp.service << 'EOF'\n[Unit]\nDescription=My Application Service\nAfter=network.target\n\n[Service]\nType=simple\nUser=myapp\nWorkingDirectory=/opt/myapp\nExecStart=/opt/myapp/app.py --log-level=INFO\nRestart=on-failure\nRestartSec=5\n\n[Install]\nWantedBy=multi-user.target\nEOF\n"]
