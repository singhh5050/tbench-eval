[70.607945, "o", "\u001b[?2004h"]
[70.60804, "o", "root@a50e1f4425c3:/opt/myapp# "]
[70.708672, "i", "cat > /etc/rsyslog.d/50-myapp.conf << 'EOF'\n# Filter for myapp program\nif $programname == 'myapp' then\n    /var/log/app_events.log\n    stop\n\n# Route ERROR level events to app_errors.log\nif $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then /var/log/app_errors.log\n& stop\nEOF\n"]
