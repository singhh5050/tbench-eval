# Time-stepping
for i in range(N):
    # Current ground acceleration
    a_g_i = a_g[i]

    # Effective load vector
    term1 = -M @ np.ones(3) * a_g_i
    term2 = M @ (a0 * u + a2 * v + a3 * a)
    term3 = C @ (a1 * u + a4 * v + a5 * a)
    P_hat = term1 + term2 + term3

    # Solve for new displacement
    u_next = np.linalg.solve(K_hat, P_hat)

    # Update acceleration and velocity
    a_next = a0 * (u_next - u) - a2 * v - a3 * a
    v_next = v + dt * ((1-gamma) * a + gamma * a_next)

    # Store results
    response.append([i*dt, u[0], u[1], u[2]])

    # Prepare for next step
    u = u_next
    v = v_next
    a = a_next

