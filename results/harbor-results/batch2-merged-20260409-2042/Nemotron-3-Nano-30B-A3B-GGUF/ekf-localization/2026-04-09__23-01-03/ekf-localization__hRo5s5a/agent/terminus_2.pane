a3 = 1.0/(2*beta_n) - 1.0
a4 = gamma / beta_n - 1.0
a5 = dt * (gamma/(2*beta_n) - 1.0)

# Effective stiffness matrix at each step
K_hat = K + a0 * M + a1 * C

# Initialize response arrays
u = np.zeros(3)
v = np.zeros(3)
a = np.zeros(3)
