[?2004l[?2004h> import numpy as np
[?2004l[?2004h> # Read ground motion data
[?2004l[?2004h>  data = np.genfromtxt('/app/data/ground_motion.csv', delimiter=',', skip_header=1)
[?2004l[?2004h>  t = data[:,0]
[?2004l[?2004h>  a_g_g = data[:,1]
[?2004l[?2004h>  a_g = a_g_g * 9.81  # convert to m/s^2
[?2004l[?2004h>  dt = np.mean(np.diff(t))
[?2004l[?2004h>  N = len(t)
[?2004l[?2004h> 
[?2004l[?2004h> # Physical parameters
[?2004l[?2004h> m = 2000.0
[?2004l[?2004h> k = 400000.0
[?2004l[?2004h> M = np.diag([m, m, m])
[?2004l[?2004h> K = k * np.array([[2, -1, 0], [-1, 2, -1], [0, -1, 1]])
[?2004l[?2004h> 
[?2004l[?2004h> # Compute damping coefficients alpha, beta_damp for 2% damping in 1st and 3rd modes
[?2004l[?2004h> # Natural frequencies from generalized eigenvalue problem K phi = omega^2 M phi
[?2004l[?2004h> w_sq = np.linalg.eigvals(np.linalg.inv(M) @ K)
[?2004l[?2004h> omega = np.sqrt(w_sq)
[?2004l[?2004h> # Sort to get 1st and 3rd mode frequencies
[?2004l[?2004h> idx = np.argsort(w_sq)
[?2004l[?2004h> omega1 = omega[idx[0]]
[?2004l[?2004h> omega3 = omega[idx[2]]
[?2004l[?2004h> zeta = 0.02
[?2004l[?2004h> # Solve: 0.5*(alpha/omega_i + beta*omega_i) = zeta for i=1,3
[?2004l[?2004h> A = np.array([[1/omega1, omega1], [1/omega3, omega3]])
[?2004l[?2004h> b = np.array([2*zeta, 2*zeta])  # multiply both sides by 2
[?2004l[?2004h> alpha_damp, beta_damp = np.linalg.solve(A, b)
[?2004l[?2004h> C = alpha_damp * M + beta_damp * K
[?2004l[?2004h> 
[?2004l[?2004h> # Newmark-beta parameters
[?2004l[?2004h> gamma = 0.5
[?2004l[?2004h> beta_n = 0.25
[?2004l[?2004h> a0 = 1.0 / (beta_n * dt**2)
[?2004l[?2004h> a1 = gamma / (beta_n * dt)
[?2004l[?2004h> a2 = 1.0 / (beta_n * dt)
[?2004l[?2004h> a3 = 1.0/(2*beta_n) - 1.0
[?2004l[?2004h> a4 = gamma / beta_n - 1.0
[?2004l[?2004h> a5 = dt * (gamma/(2*beta_n) - 1.0)
[?2004l[?2004h> 
[?2004l[?2004h> # Effective stiffness matrix at each step
[?2004l[?2004h> K_hat = K + a0 * M + a1 * C
[?2004l[?2004h> 
[?2004l[?2004h> # Initialize response arrays
[?2004l[?2004h> u = np.zeros(3)
[?2004l[?2004h> v = np.zeros(3)
[?2004l[?2004h> a = np.zeros(3)
[?2004l[?2004h> response = []
[?2004l[?2004h> 
[?2004l[?2004h> # Time-stepping
[?2004l[?2004h> for i in range(N):
[?2004l[?2004h>     # Current ground acceleration
[?2004l[?2004h>     a_g_i = a_g[i]
[?2004l[?2004h>     
[?2004l[?2004h>     # Effective load vector
[?2004l[?2004h>     term1 = -M @ np.ones(3) * a_g_i
[?2004l[?2004h>     term2 = M @ (a0 * u + a2 * v + a3 * a)
[?2004l[?2004h>     term3 = C @ (a1 * u + a4 * v + a5 * a)
[?2004l[?2004h>     P_hat = term1 + term2 + term3
[?2004l[?2004h>     
[?2004l[?2004h>     # Solve for new displacement
[?2004l[?2004h>     u_next = np.linalg.solve(K_hat, P_hat)
[?2004l[?2004h>     
[?2004l[?2004h>     # Update acceleration and velocity
[?2004l[?2004h>     a_next = a0 * (u_next - u) - a2 * v - a3 * a
[?2004l[?2004h>     v_next = v + dt * ((1-gamma) * a + gamma * a_next)
[?2004l[?2004h>     
[?2004l[?2004h>     # Store results
[?2004l[?2004h>     response.append([i*dt, u[0], u[1], u[2]])
[?2004l[?2004h>     
[?2004l[?2004h>     # Prepare for next step
[?2004l[?2004h>     u = u_next
[?2004l[?2004h>     v = v_next
[?2004l[?2004h>     a = a_next
