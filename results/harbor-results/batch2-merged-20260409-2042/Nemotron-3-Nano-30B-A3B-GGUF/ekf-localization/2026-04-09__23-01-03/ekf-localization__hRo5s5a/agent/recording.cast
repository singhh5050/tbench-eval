[235.557022, "i", "cat > /app/simulate.py << 'EOF'\nimport numpy as np\n# Read ground motion data\n data = np.genfromtxt('/app/data/ground_motion.csv', delimiter=',', skip_header=1)\n t = data[:,0]\n a_g_g = data[:,1]\n a_g = a_g_g * 9.81  # convert to m/s^2\n dt = np.mean(np.diff(t))\n N = len(t)\n\n# Physical parameters\nm = 2000.0\nk = 400000.0\nM = np.diag([m, m, m])\nK = k * np.array([[2, -1, 0], [-1, 2, -1], [0, -1, 1]])\n\n# Compute damping coefficients alpha, beta_damp for 2% damping in 1st and 3rd modes\n# Natural frequencies from generalized eigenvalue problem K phi = omega^2 M phi\nw_sq = np.linalg.eigvals(np.linalg.inv(M) @ K)\nomega = np.sqrt(w_sq)\n# Sort to get 1st and 3rd mode frequencies\nidx = np.argsort(w_sq)\nomega1 = omega[idx[0]]\nomega3 = omega[idx[2]]\nzeta = 0.02\n# Solve: 0.5*(alpha/omega_i + beta*omega_i) = zeta for i=1,3\nA = np.array([[1/omega1, omega1], [1/omega3, omega3]])\nb = np.array([2*zeta, 2*zeta])  # multiply both sides by 2\nalpha_damp, beta_damp = np.linalg.solve(A, b)\nC = alpha_damp * M + beta_damp * K\n\n# Newmark-b"]
[235.557235, "o", "cat > /app/simulate.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> # Read ground motion data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.557289, "i", "eta parameters\ngamma = 0.5\nbeta_n = 0.25\na0 = 1.0 / (beta_n * dt**2)\na1 = gamma / (beta_n * dt)\na2 = 1.0 / (beta_n * dt)\na3 = 1.0/(2*beta_n) - 1.0\na4 = gamma / beta_n - 1.0\na5 = dt * (gamma/(2*beta_n) - 1.0)\n\n# Effective stiffness matrix at each step\nK_hat = K + a0 * M + a1 * C\n\n# Initialize response arrays\nu = np.zeros(3)\nv = np.zeros(3)\na = np.zeros(3)\nresponse = []\n\n# Time-stepping\nfor i in range(N):\n    # Current ground acceleration\n    a_g_i = a_g[i]\n    \n    # Effective load vector\n    term1 = -M @ np.ones(3) * a_g_i\n    term2 = M @ (a0 * u + a2 * v + a3 * a)\n    term3 = C @ (a1 * u + a4 * v + a5 * a)\n    P_hat = term1 + term2 + term3\n    \n    # Solve for new displacement\n    u_next = np.linalg.solve(K_hat, P_hat)\n    \n    # Update acceleration and velocity\n    a_next = a0 * (u_next - u) - a2 * v - a3 * a\n    v_next = v + dt * ((1-gamma) * a + gamma * a_next)\n    \n    # Store results\n    response.append([i*dt, u[0], u[1], u[2]])\n    \n    # Prepare for next step\n    u = u_next\n    v = v_next\n    a = a_ne"]
[235.557319, "o", " data = np.genfromtxt('/app/data/ground_motion.csv', delimiter=',', skip_header=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.557355, "i", "xt\n\n# Write response to CSV\noutput_path = '/app/output/response.csv'\nnp.savetxt(output_path, np.column_stack((np.arange(len(response))*dt, [r[1] for r in response], [r[2] for r in response], [r[3] for r in response])), fmt='%.3f,%.6f', header='time,u1,u2,u3', comments='')\nEOF\n"]
