[373.953938, "o", "K_hat = K + a0 * M + a1 * C\r\n\u001b[?2004l\r"]
[373.953952, "o", "\u001b[?2004h"]
[373.953966, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.953992, "o", "# Initialize response arrays\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.954011, "o", "u = np.zeros(3)\r\n\u001b[?2004l\r"]
[373.954026, "o", "\u001b[?2004h> "]
[373.954039, "o", "v = np.zeros(3)\r\n\u001b[?2004l\r"]
[373.954046, "o", "\u001b[?2004h> "]
[373.954061, "o", "a = np.zeros(3)\r\n\u001b[?2004l\r"]
[373.954072, "o", "\u001b[?2004h> "]
[373.954084, "o", "response = []\r\n\u001b[?2004l\r"]
[373.954096, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.954105, "o", "\u001b[?2004h> "]
[373.954119, "o", "# Time-stepping\r\n\u001b[?2004l\r"]
[373.954132, "o", "\u001b[?2004h> "]
[373.954147, "o", "for i in range(N):\r\n\u001b[?2004l\r"]
[373.95416, "o", "\u001b[?2004h> "]
[373.954192, "o", "    # Current ground acceleration\r\n\u001b[?2004l\r"]
[373.954204, "o", "\u001b[?2004h> "]
[373.954229, "o", "    a_g_i = a_g[i]\r\n\u001b[?2004l\r"]
[373.954241, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.954253, "o", "\u001b[?2004h> "]
[373.954287, "o", "    # Effective load vector\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.954321, "o", ">     term1 = -M @ np.ones(3) * a_g_i\r\n\u001b[?2004l\r"]
[373.954334, "o", "\u001b[?2004h> "]
[373.954371, "o", "    term2 = M @ (a0 * u + a2 * v + a3 * a)\r\n\u001b[?2004l\r"]
[373.954384, "o", "\u001b[?2004h> "]
[373.95442, "o", "    term3 = C @ (a1 * u + a4 * v + a5 * a)\r\n\u001b[?2004l\r"]
[373.954432, "o", "\u001b[?2004h> "]
[373.954459, "o", "    P_hat = term1 + term2 + term3\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.954472, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[373.954484, "o", "> "]
[373.954507, "o", "    # Solve for new displacement\r\n\u001b[?2004l\r"]
[373.95452, "o", "\u001b[?2004h> "]
[373.954553, "o", "    u_next = np.linalg.solve(K_hat, P_hat)\r\n\u001b[?2004l\r"]
[373.954565, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.954576, "o", "\u001b[?2004h> "]
[373.954607, "o", "    # Update acceleration and velocity\r\n\u001b[?2004l\r"]
[373.954618, "o", "\u001b[?2004h> "]
[373.954656, "o", "    a_next = a0 * (u_next - u) - a2 * v - a3 * a\r\n\u001b[?2004l\r"]
[373.954688, "o", "\u001b[?2004h> "]
[373.954717, "o", "    v_next = v + dt * ((1-gamma) * a + gamma * a_next)\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.95473, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[373.954742, "o", "> "]
[373.954752, "o", "    # Store results\r\n\u001b[?2004l\r"]
[373.954766, "o", "\u001b[?2004h> "]
[373.954801, "o", "    response.append([i*dt, u[0], u[1], u[2]])\r\n\u001b[?2004l\r"]
[373.954813, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.954825, "o", "\u001b[?2004h> "]
[373.954848, "o", "    # Prepare for next step\r\n\u001b[?2004l\r"]
[373.954859, "o", "\u001b[?2004h> "]
[373.95487, "o", "    u = u_next\r\n\u001b[?2004l\r"]
[373.954876, "o", "\u001b[?2004h> "]
[373.954895, "o", "    v = v_next\r\n\u001b[?2004l\r"]
[373.954907, "o", "\u001b[?2004h> "]
[373.954918, "o", "    a = a_next\r\n\u001b[?2004l\r"]
[373.95493, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.954942, "o", "\u001b[?2004h> "]
[373.954958, "o", "# Write response to CSV\r\n\u001b[?2004l\r"]
[373.954971, "o", "\u001b[?2004h> "]
[373.955003, "o", "output_path = '/app/output/response.csv'\r\n\u001b[?2004l\r"]
[373.955015, "o", "\u001b[?2004h> "]
[373.955125, "o", "data_to_save = np.column_stack((np.arange(len(response))*dt, [r[1] for r in response], [r[2] for r in response], [r[3] for r in response]))\r\n\u001b[?2004l\r"]
[373.955139, "o", "\u001b[?2004h> "]
[373.95523, "o", "np.savetxt(output_path, data_to_save, fmt='%.3f %.6f %.6f %.6f', delimiter=',', header='time,u1,u2,u3', comments='')\r\n\u001b[?2004l\r"]
[373.955238, "o", "\u001b[?2004h> "]
[373.955255, "o", "EOF\r\n\u001b[?2004l\r"]
[373.956208, "o", "\u001b[?2004hroot@e35d21f34863:/app# "]
[374.955261, "i", "python3 /app/simulate.py\n"]
[374.955406, "o", "python3 /app/simulate.py\r\n\u001b[?2004l\r"]
[375.366183, "o", "\u001b[?2004hroot@e35d21f34863:/app# "]
[379.964537, "i", "head -n 5 /app/output/response.csv\n"]
[379.964716, "o", "head -n 5 /app/output/response.csv\r\n\u001b[?2004l\r"]
[379.965409, "o", "time,u1,u2,u3\r\n0.000 0.000000 0.000000 0.000000\r\n0.020 -0.000011 -0.000011 -0.000011\r\n0.040 -0.000044 -0.000046 -0.000046\r\n0.060 -0.000082 -0.000089 -0.000089\r\n"]
[379.965567, "o", "\u001b[?2004h"]
[379.965602, "o", "root@e35d21f34863:/app# "]
