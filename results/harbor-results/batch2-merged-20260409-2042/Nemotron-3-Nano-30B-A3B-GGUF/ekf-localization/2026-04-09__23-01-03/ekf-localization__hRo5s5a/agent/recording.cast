[313.020324, "o", "> "]
[313.020332, "o", "k = 400000.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.02036, "o", "M = np.diag([m, m, m])\r\n\u001b[?2004l\r"]
[313.020375, "o", "\u001b[?2004h> "]
[313.020421, "o", "K = k * np.array([[2, -1, 0], [-1, 2, -1], [0, -1, 1]])\r\n\u001b[?2004l\r"]
[313.020435, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[313.020454, "o", "> "]
[313.020519, "o", "# Compute damping coefficients alpha, beta_damp for 2% damping in 1st and 3rd modes\r\n\u001b[?2004l\r"]
[313.020533, "o", "\u001b[?2004h> "]
[313.020598, "o", "# Natural frequencies from generalized eigenvalue problem K phi = omega^2 M phi\r\n\u001b[?2004l\r\u001b[?2004h"]
[313.020611, "o", "> "]
[313.020649, "o", "w_sq = np.linalg.eigvals(np.linalg.inv(M) @ K)\r\n\u001b[?2004l\r"]
[313.020674, "o", "\u001b[?2004h> "]
[313.020693, "o", "omega = np.sqrt(w_sq)\r\n\u001b[?2004l\r"]
[313.020705, "o", "\u001b[?2004h> "]
[313.020739, "o", "# Sort to get 1st and 3rd mode frequencies\r\n\u001b[?2004l\r"]
[313.020751, "o", "\u001b[?2004h> "]
[313.020772, "o", "idx = np.argsort(w_sq)\r\n\u001b[?2004l\r"]
[313.020784, "o", "\u001b[?2004h> "]
[313.020804, "o", "omega1 = omega[idx[0]]\r\n\u001b[?2004l\r"]
[313.020817, "o", "\u001b[?2004h> "]
[313.020835, "o", "omega3 = omega[idx[2]]\r\n\u001b[?2004l\r"]
[313.020849, "o", "\u001b[?2004h> "]
[313.020874, "o", "zeta = 0.02\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.02092, "o", "# Solve: 0.5*(alpha/omega_i + beta*omega_i) = zeta for i=1,3\r\n\u001b[?2004l\r"]
[313.020932, "o", "\u001b[?2004h> "]
[313.020981, "o", "A = np.array([[1/omega1, omega1], [1/omega3, omega3]])\r\n\u001b[?2004l\r"]
[313.021023, "o", "\u001b[?2004h> "]
[313.021072, "o", "b = np.array([2*zeta, 2*zeta])  # multiply both sides by 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.021093, "o", "alpha_damp, beta_damp = np.linalg.solve(A, b)\r\n\u001b[?2004l\r"]
[313.021107, "o", "\u001b[?2004h> "]
[313.021132, "o", "C = alpha_damp * M + beta_damp * K\r\n\u001b[?2004l\r"]
[313.021144, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[313.021156, "o", "> "]
[313.021201, "o", "# Newmark-beta parameters\r\n\u001b[?2004l\r\u001b[?2004h> gamma = 0.5\r\n"]
[313.021248, "o", "\u001b[?2004l\r\u001b[?2004h> beta_n = 0.25\r\n\u001b[?2004l\r\u001b[?2004h"]
[313.021271, "o", "> a0 = 1.0 / (beta_n * dt**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.021296, "o", "a1 = gamma / (beta_n * dt)\r\n\u001b[?2004l\r"]
[313.021315, "o", "\u001b[?2004h> "]
[313.021325, "o", "a2 = 1.0 / (beta_n * dt)\r\n\u001b[?2004l\r"]
[313.02135, "o", "\u001b[?2004h> "]
[313.021372, "o", "a3 = 1.0/(2*beta_n) - 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[313.021394, "o", "> a4 = gamma / beta_n - 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[313.021413, "o", "> "]
[313.021435, "o", "a5 = dt * (gamma/(2*beta_n) - 1.0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[313.021455, "o", "\u001b[?2004h> "]
[313.021481, "o", "# Effective stiffness matrix at each step\r\n\u001b[?2004l\r"]
[313.021502, "o", "\u001b[?2004h> "]
[313.021523, "o", "K_hat = K + a0 * M + a1 * C\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[313.021543, "o", "\u001b[?2004h> "]
[313.021564, "o", "# Initialize response arrays\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.021584, "o", "u = np.zeros(3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[313.021605, "o", "> v = np.zeros(3)\r\n\u001b[?2004l\r"]
[313.021626, "o", "\u001b[?2004h> "]
[313.021646, "o", "a = np.zeros(3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.021672, "o", "response = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.021693, "o", "# Time-stepping\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.021713, "o", "for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h"]
[313.021733, "o", "> "]
[313.021762, "o", "    # Current ground acceleration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.021794, "o", "    a_g_i = a_g[i]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.021816, "o", "    # Effective load vector\r\n\u001b[?2004l\r"]
[313.021834, "o", "\u001b[?2004h> "]
[313.021856, "o", "    term1 = -M @ np.ones(3) * a_g_i\r\n\u001b[?2004l\r\u001b[?2004h"]
[313.021874, "o", "> "]
[313.021898, "o", "    term2 = M @ (a0 * u + a2 * v + a3 * a)\r\n\u001b[?2004l\r"]
[313.021919, "o", "\u001b[?2004h> "]
[313.021941, "o", "    term3 = C @ (a1 * u + a4 * v + a5 * a)\r\n\u001b[?2004l\r"]
[313.021962, "o", "\u001b[?2004h> "]
[313.021982, "o", "    P_hat = term1 + term2 + term3\r\n\u001b[?2004l\r\u001b[?2004h"]
[313.022003, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[313.022025, "o", ">     # Solve for new displacement\r\n\u001b[?2004l\r"]
[313.02205, "o", "\u001b[?2004h> "]
[313.022069, "o", "    u_next = np.linalg.solve(K_hat, P_hat)\r\n\u001b[?2004l\r"]
[313.022092, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.022119, "o", "    # Update acceleration and velocity\r\n\u001b[?2004l\r"]
[313.022141, "o", "\u001b[?2004h> "]
[313.022168, "o", "    a_next = a0 * (u_next - u) - a2 * v - a3 * a\r\n\u001b[?2004l\r"]
[313.02219, "o", "\u001b[?2004h> "]
[313.022222, "o", "    v_next = v + dt * ((1-gamma) * a + gamma * a_next)\r\n\u001b[?2004l\r"]
[313.022243, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[313.022261, "o", "\u001b[?2004h> "]
[313.022284, "o", "    # Store results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.022305, "o", "    response.append([i*dt, u[0], u[1], u[2]])\r\n\u001b[?2004l\r"]
[313.022324, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.022346, "o", "    # Prepare for next step\r\n\u001b[?2004l\r"]
[313.02237, "o", "\u001b[?2004h>     u = u_next\r\n\u001b[?2004l\r"]
[313.022396, "o", "\u001b[?2004h>     v = v_next\r\n\u001b[?2004l\r"]
[313.022419, "o", "\u001b[?2004h> "]
[313.022439, "o", "    a = a_next\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.022466, "o", "# Write response to CSV\r\n\u001b[?2004l\r"]
[313.02249, "o", "\u001b[?2004h> "]
[313.022518, "o", "output_path = '/app/output/response.csv'\r\n\u001b[?2004l\r"]
[313.022537, "o", "\u001b[?2004h> "]
[313.022697, "o", "np.savetxt(output_path, np.column_stack((np.arange(len(response))*dt, [r[1] for r in response], [r[2] for r in response], [r[3] for r in response])), fmt='%.3f,%.6f', header='time,u1,u2,u3', comments='')\r\n\u001b[?2004l\r"]
[313.022725, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[313.023601, "o", "\u001b[?2004hroot@e35d21f34863:/app# "]
[314.023724, "i", "python3 /app/simulate.py\n"]
[314.023881, "o", "python3 /app/simulate.py\r\n\u001b[?2004l\r"]
[314.374162, "o", "Traceback (most recent call last):\r\n"]
[314.374529, "o", "  File \u001b[35m\"/app/simulate.py\"\u001b[0m, line \u001b[35m78\u001b[0m, in \u001b[35m<module>\u001b[0m\r\n    \u001b[31mnp.savetxt\u001b[0m\u001b[1;31m(output_path, np.column_stack((np.arange(len(response))*dt, [r[1] for r in response], [r[2] for r in response], [r[3] for r in response])), fmt='%.3f,%.6f', header='time,u1,u2,u3', comments='')\u001b[0m\r\n    \u001b[31m~~~~~~~~~~\u001b[0m\u001b[1;31m^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n"]
