[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from .base import BaseLayer
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class ReLU(BaseLayer):
[?2004l[?2004h>     def __init__(self):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x: np.ndarray) -> np.ndarray:
