[?2004hroot@8c37df19d273:/app# cat <<'EOF' > /app/src/conv_transpose.py
[?2004lhts = np.random.uniform(-limit, limit, size=(in_channels, out_channels, kernel_size, kernel_size)).astype(np.float64)
        self.bias = np.zeros(out_channels, dtype=np.float64)

    def forward(self, x: np.ndarray) -> np.ndarray:
        """Forward pass of the transposed convolution.

        Parameters
        ----------
        x : np.ndarray
            Input tensor of shape (batch, height, width, in_channels).
        Returns
        -------
        np.ndarray
            Output tensor of shape (batch, out_height, out_width, out_channels).
        """
        x = x.astype(np.float64, copy=False)
        batch, h_in, w_in, _ = x.shape

        # Output spatial dimensions per the formula:
        # out = (in - 1) * stride - 2 * padding + kernel_size
        out_h = (h_in - 1) * self.stride - 2 * self.padding + self.kernel_size
        out_w = (w_in - 1) * self.stride - 2 * self.padding + self.kernel_size
        out = np.zeros((batch, out_h, out_w, self.out_channels), dtype=np.float64)

        for b in range(batch):
            for i in range(h_in):
                for j in range(w_in):
                    out_i = i * self.stride - self.padding
                    out_j = j * self.stride - self.padding
                    for ic in range(self.in_channels):
                        inp_val = x[b, i, j, ic]
                        if inp_val == 0:
                            continue
                        w = self.weights[ic]  # shape (out_channels, kernel_size, kernel_size)
                        for oc in range(self.out_channels):
                            for ki in range(self.kernel_size):
                                for kj in range(self.kernel_size):
                                    oi = out_i + ki
                                    oj = out_j + kj
                                    if 0 <= oi < out_h and 0 <= oj < out_w:
                                        out[b, oi, oj, oc] += inp_val * w[oc, ki, kj]
        # Add bias (broadcast over batch and spatial dimensions)
        out += self.bias.reshape((1, 1, 1, self.out_channels))
        return out
