[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from .base import BaseLayer
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class BatchNorm2D(BaseLayer):
[?2004l[?2004h>     def __init__(self, num_features: int, eps: float = 1e-5, momentum: float = 0.1):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.num_features = num_features
[?2004l[?2004h>         self.eps = eps
[?2004l[?2004h>         self.momentum = momentum
[?2004l[?2004h>         # Learnable parameters
[?2004l[?2004h>         self.gamma = np.ones(num_features, dtype=np.float64)
[?2004l[?2004h>         self.beta = np.zeros(num_features, dtype=np.float64)
[?2004l[?2004h>         # Running statistics
[?2004l[?2004h>         self.running_mean = np.zeros(num_features, dtype=np.float64)
[?2004l[?2004h>         self.running_var = np.ones(num_features, dtype=np.float64)
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x: np.ndarray, training: bool = True) -> np.ndarray:
[?2004l[?2004h>         """Apply batch normalization.
[?2004l[?2004h> 
[?2004l[?2004h>         Parameters
[?2004l[?2004h>         ----------
[?2004l[?2004h>         x : np.ndarray
[?2004l[?2004h>             Input tensor of shape (batch, height, width, channels).
[?2004l[?2004h>         training : bool, default True
[?2004l[?2004h>             If True, use batch statistics and update running estimates.
[?2004l[?2004h>             If False, use the stored running statistics.
[?2004l[?2004h>         """
[?2004l[?2004h>         x = x.astype(np.float64, copy=False)
[?2004l[?2004h>         # Compute per‑channel mean and variance over (batch, height, width)
[?2004l[?2004h>         if training:
[?2004l[?2004h>             batch_mean = np.mean(x, axis=(0, 1, 2))
[?2004l[?2004h>             batch_var = np.var(x, axis=(0, 1, 2))
[?2004l[?2004h>             # Update running statistics
[?2004l[?2004h>             self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * batch_mean
[?2004l[?2004h>             self.running_var = (1 - self.momentum) * self.running_var + self.momentum * batch_var
[?2004l[?2004h>             mean = batch_mean
[?2004l[?2004h>             var = batch_var
[?2004l[?2004h>         else:
[?2004l[?2004h>             mean = self.running_mean
[?2004l[?2004h>             var = self.running_var
[?2004l[?2004h> 
[?2004l[?2004h>         # Reshape for broadcasting: (1,1,1,C)
[?2004l[?2004h>         mean_reshaped = mean.reshape((1, 1, 1, self.num_features))
[?2004l[?2004h>         var_reshaped = var.reshape((1, 1, 1, self.num_features))
[?2004l[?2004h>         gamma_reshaped = self.gamma.reshape((1, 1, 1, self.num_features))
[?2004l[?2004h>         beta_reshaped = self.beta.reshape((1, 1, 1, self.num_features))
[?2004l[?2004h> 
[?2004l[?2004h>         x_norm = (x - mean_reshaped) / np.sqrt(var_reshaped + self.eps)
[?2004l[?2004h>         out = gamma_reshaped * x_norm + beta_reshaped
[?2004l[?2004h>         return out
