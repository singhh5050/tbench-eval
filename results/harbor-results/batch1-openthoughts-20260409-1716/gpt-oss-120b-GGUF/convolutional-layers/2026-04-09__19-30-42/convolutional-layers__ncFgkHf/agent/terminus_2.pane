[?2004h> """Convolution layer implementation using NumPy.
[?2004l[?2004h> 
[?2004l[?2004h> Implements a 2‑D convolution with optional padding, stride, dilation and
[?2004l[?2004h> Xavier/Glorot uniform weight initialization.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from .base import BaseLayer
[?2004l[?2004h> from .padding import zero_pad, get_output_shape
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class Conv2D(BaseLayer):
[?2004l[?2004h>     def __init__(
[?2004l[?2004h>         self,
[?2004l[?2004h>         in_channels: int,
[?2004l[?2004h>         out_channels: int,
[?2004l[?2004h>         kernel_size: int,
[?2004l[?2004h>         stride: int = 1,
[?2004l[?2004h>         padding: int = 0,
[?2004l[?2004h>         dilation: int = 1,
[?2004l[?2004h>     ):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.in_channels = in_channels
[?2004l[?2004h>         self.out_channels = out_channels
[?2004l[?2004h>         self.kernel_size = kernel_size
[?2004l[?2004h>         self.stride = stride
[?2004l[?2004h>         self.padding = padding
[?2004l[?2004h>         self.dilation = dilation
[?2004l[?2004h> 
[?2004l[?2004h>         # Xavier/Glorot uniform initialization
[?2004l[?2004h>         fan_in = in_channels * kernel_size * kernel_size
[?2004l[?2004h>         fan_out = out_channels * kernel_size * kernel_size
[?2004l[?2004h>         limit = np.sqrt(6.0 / (fan_in + fan_out))
[?2004l[?2004h>         self.weights = np.random.uniform(-limit, limit, size=(out_channels, in_channels, kernel_size, kernel_size)).astype(np.float64)
[?2004l[?2004h>         self.bias = np.zeros(out_channels, dtype=np.float64)
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x: np.ndarray) -> np.ndarray:
[?2004l[?2004h>         # Ensure correct dtype
[?2004l[?2004h>         x = x.astype(np.float64, copy=False)
[?2004l[?2004h>         batch, h_in, w_in, _ = x.shape
[?2004l[?2004h> 
[?2004l[?2004h>         # Pad input if needed
[?2004l[?2004h>         if self.padding > 0:
[?2004l[?2004h>             x_padded = zero_pad(x, self.padding)
[?2004l[?2004h>         else:
[?2004l[?2004h>             x_padded = x
[?2004l[?2004h> 
[?2004l[?2004h>         # Compute output spatial dimensions
[?2004l[?2004h>         out_h, out_w = get_output_shape((h_in, w_in), self.kernel_size, self.stride, self.padding, self.dilation)
[?2004l[?2004h>         out = np.zeros((batch, out_h, out_w, self.out_channels), dtype=np.float64)
[?2004l[?2004h> 
[?2004l[?2004h>         # Effective kernel size after dilation
[?2004l[?2004h>         k_eff = self.dilation * (self.kernel_size - 1) + 1
[?2004l[?2004h> 
[?2004l[?2004h>         for b in range(batch):
[?2004l[?2004h>             for i in range(out_h):
[?2004l[?2004h>                 for j in range(out_w):
[?2004l[?2004h>                     # Compute the top‑left corner of the receptive field in the padded input
[?2004l[?2004h>                     start_i = i * self.stride
[?2004l[?2004h>                     start_j = j * self.stride
[?2004l[?2004h>                     # Extract the region with dilation
[?2004l[?2004h>                     region = x_padded[
[?2004l[?2004h>                         b,
[?2004l[?2004h>                         start_i : start_i + k_eff : self.dilation,
[?2004l[?2004h>                         start_j : start_j + k_eff : self.dilation,
[?2004l[?2004h>                         :
[?2004l[?2004h>                     ]  # shape (kernel_size, kernel_size, in_channels)
[?2004l[?2004h>                     # region shape should be (kernel_size, kernel_size, in_channels)
[?2004l[?2004h>                     # Compute convolution for each output channel
[?2004l[?2004h>                     for oc in range(self.out_channels):
[?2004l[?2004h>                         w = self.weights[oc]  # shape (in_channels, kernel_size, kernel_size)
[?2004l[?2004h>                         # Move axes to match region shape for broadcasting
[?2004l[?2004h>                         w_t = np.transpose(w, (1, 2, 0))  # (kernel_size, kernel_size, in_channels)
[?2004l[?2004h>                         out[b, i, j, oc] = np.sum(region * w_t) + self.bias[oc]
[?2004l[?2004h>         return out
