[?2004l[?2004h> """Transposed convolution (deconvolution) layer using NumPy.
[?2004l[?2004h> 
[?2004l Perform the transposed convolution using explicit loops.
        for b in range(batch):
            for i in range(h_in):
                for j in range(w_in):
                    # Top‑left corner in the output where the kernel is placed
                    out_i = i * self.stride - self.padding
                    out_j = j * self.stride - self.padding
                    for ic in range(self.in_channels):
                        inp_val = x[b, i, j, ic]
                        if inp_val == 0:
                            continue
                        # Weight slice for this input channel: shape (out_channels, k, k)
                        w = self.weights[ic]  # (out_channels, kernel_size, kernel_size)
                        for oc in range(self.out_channels):
                            for ki in range(self.kernel_size):
                                for kj in range(self.kernel_size):
                                    out_i_pos = out_i + ki
                                    out_j_pos = out_j + kj
                                    if 0 <= out_i_pos < out_h and 0 <= out_j_pos < out_w:
                                        out[b, out_i_pos, out_j_pos, oc] += inp_val * w[oc, ki, kj]
        # Add bias (broadcast over batch and spatial dimensions)
        out += self.bias.reshape((1, 1, 1, self.out_channels))
        return out
EOF
[?2004h> Implements the forward pass of a Conv2DTranspose (also called deconv) with
[?2004l[?2004h> Xavier/Glorot uniform weight initialization.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from .base import BaseLayer
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class Conv2DTranspose(BaseLayer):
[?2004l[?2004h>     def __init__(
[?2004l[?2004h>         self,
[?2004l[?2004h>         in_channels: int,
[?2004l[?2004h>         out_channels: int,
[?2004l[?2004h>         kernel_size: int,
[?2004l[?2004h>         stride: int = 1,
[?2004l[?2004h>         padding: int = 0,
[?2004l[?2004h>     ):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.in_channels = in_channels
[?2004l[?2004h>         self.out_channels = out_channels
[?2004l[?2004h>         self.kernel_size = kernel_size
[?2004l[?2004h>         self.stride = stride
[?2004l[?2004h>         self.padding = padding
[?2004l[?2004h> 
[?2004l[?2004h>         # Xavier/Glorot uniform initialization
[?2004l[?2004h>         fan_in = in_channels * kernel_size * kernel_size
[?2004l[?2004h>         fan_out = out_channels * kernel_size * kernel_size
[?2004l[?2004h>         limit = np.sqrt(6.0 / (fan_in + fan_out))
[?2004l[?2004h>         # Shape: (in_channels, out_channels, kernel_size, kernel_size)
[?2004l[?2004h>         self.weights = np.random.uniform(-limit, limit, size=(in_channels, out_channels, kernel_size, kernel_size)).astype(np.float64)
[?2004l[?2004h>         self.bias = np.zeros(out_channels, dtype=np.float64)
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x: np.ndarray) -> np.ndarray:
[?2004l[?2004h>         """Forward pass of the transposed convolution.
[?2004l[?2004h> 
[?2004l[?2004h>         Parameters
[?2004l[?2004h>         ----------
[?2004l[?2004h>         x : np.ndarray
[?2004l[?2004h>             Input tensor of shape (batch, height, width, in_channels).
[?2004l[?2004h>         Returns
[?2004l[?2004h>         -------
[?2004l[?2004h>         np.ndarray
[?2004l[?2004h>             Output tensor of shape (batch, out_height, out_width, out_channels).
[?2004l[?2004h>         """
[?2004l[?2004h>         x = x.astype(np.float64, copy=False)
[?2004l[?2004h>         batch, h_in, w_in, _ = x.shape
[?2004l[?2004h> 
[?2004l[?2004h>         # Output spatial dimensions according to the formula:
[?2004l[?2004h>         # out = (in - 1) * stride - 2 * padding + kernel_size
[?2004l[?2004h>         out_h = (h_in - 1) * self.stride - 2 * self.padding + self.kernel_size
[?2004l[?2004h>         out_w = (w_in - 1) * self.stride - 2 * self.padding + self.kernel_size
