[?2004l[?2004h> 
[?2004l[?2004h> class Sigmoid(BaseLayer):
[?2004l[?2004h>     def __init__(self):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x: np.ndarray) -> np.ndarray:
[?2004l[?2004h>         x = x.astype(np.float64, copy=False)
[?2004l[?2004h>         # Numerically stable sigmoid
[?2004l[?2004h>         pos_mask = x >= 0
[?2004l[?2004h>         neg_mask = ~pos_mask
[?2004l[?2004h>         result = np.empty_like(x, dtype=np.float64)
[?2004l[?2004h>         result[pos_mask] = 1 / (1 + np.exp(-x[pos_mask]))
[?2004l[?2004h>         exp_x = np.exp(x[neg_mask])
[?2004l[?2004h>         result[neg_mask] = exp_x / (1 + exp_x)
[?2004l[?2004h>         return result
[?2004l[?2004h> EOF
