[332.41804, "i", "cat <<'EOF' > /app/src/normalization.py\n\"\"\"Batch Normalization layer for 2‑D inputs (NHWC) using NumPy.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass BatchNorm2D(BaseLayer):\n    def __init__(self, num_features: int, eps: float = 1e-5, momentum: float = 0.1):\n        super().__init__()\n        self.num_features = num_features\n        self.eps = eps\n        self.momentum = momentum\n        # Learnable parameters\n        self.gamma = np.ones(num_features, dtype=np.float64)\n        self.beta = np.zeros(num_features, dtype=np.float64)\n        # Running statistics\n        self.running_mean = np.zeros(num_features, dtype=np.float64)\n        self.running_var = np.ones(num_features, dtype=np.float64)\n\n    def forward(self, x: np.ndarray, training: bool = True) -> np.ndarray:\n        \"\"\"Apply batch normalization.\n\n        Parameters\n        ----------\n        x : np.ndarray\n            Input tensor of shape (batch, height, width, channels).\n        training : bool, de"]
[332.418215, "i", "fault True\n            If True, use batch statistics and update running estimates.\n            If False, use the stored running statistics.\n        \"\"\"\n        x = x.astype(np.float64, copy=False)\n        # Compute per‑channel mean and variance over (batch, height, width)\n        if training:\n            batch_mean = np.mean(x, axis=(0, 1, 2))\n            batch_var = np.var(x, axis=(0, 1, 2))\n            # Update running statistics\n            self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * batch_mean\n            self.running_var = (1 - self.momentum) * self.running_var + self.momentum * batch_var\n            mean = batch_mean\n            var = batch_var\n        else:\n            mean = self.running_mean\n            var = self.running_var\n\n        # Reshape for broadcasting: (1,1,1,C)\n        mean_reshaped = mean.reshape((1, 1, 1, self.num_features))\n        var_reshaped = var.reshape((1, 1, 1, self.num_features))\n        gamma_reshaped = self.gamma.reshape((1, 1, 1, self.num_f"]
[332.418285, "o", "cat <<'EOF' > /app/src/normalization.py\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Batch Normalization layer for 2‑D inputs (NHWC) using NumPy.\r\n\u001b[?2004l\r\u001b[?2004h"]
[332.41833, "i", "eatures))\n        beta_reshaped = self.beta.reshape((1, 1, 1, self.num_features))\n\n        x_norm = (x - mean_reshaped) / np.sqrt(var_reshaped + self.eps)\n        out = gamma_reshaped * x_norm + beta_reshaped\n        return out\nEOF\n"]
[332.418367, "o", "> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
