[96.078537, "o", "\u001b[?2004h> "]
[96.078582, "o", "        # No parameters required by the specification.\r\n\u001b[?2004l\r"]
[96.078596, "o", "\u001b[?2004h> "]
[96.078617, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[96.078632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.078646, "o", "\u001b[?2004h> "]
[96.078684, "o", "    def __call__(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r"]
[96.078722, "o", "\u001b[?2004h> "]
[96.078736, "o", "        \"\"\"Make the layer callable.\r\n\u001b[?2004l\r"]
[96.078749, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.078764, "o", "\u001b[?2004h> "]
