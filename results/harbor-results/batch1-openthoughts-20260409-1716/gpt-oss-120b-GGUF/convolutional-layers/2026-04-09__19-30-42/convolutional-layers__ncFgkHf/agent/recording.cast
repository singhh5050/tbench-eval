[191.107265, "o", "        out_w = (w_in - self.kernel_size) // self.stride + 1\r\n\u001b[?2004l\r"]
[191.10728, "o", "\u001b[?2004h> "]
[191.107337, "o", "        out = np.empty((batch, out_h, out_w, c), dtype=np.float64)\r\n\u001b[?2004l\r"]
[191.107355, "o", "\u001b[?2004h> "]
[191.107372, "o", "        for b in range(batch):\r\n\u001b[?2004l\r"]
[191.107387, "o", "\u001b[?2004h> "]
[191.107414, "o", "            for i in range(out_h):\r\n\u001b[?2004l\r"]
[191.107427, "o", "\u001b[?2004h> "]
[191.107469, "o", "                for j in range(out_w):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.107523, "o", "                    h_start = i * self.stride\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.107568, "o", "                    w_start = j * self.stride\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.107659, "o", "                    window = x[b, h_start:h_start + self.kernel_size, w_start:w_start + self.kernel_size, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.107673, "o", "> "]
[191.107732, "o", "                    out[b, i, j, :] = np.mean(window, axis=(0, 1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.107746, "o", "> "]
[191.107761, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.107775, "o", "EOF\r\n\u001b[?2004l\r"]
[191.10867, "o", "\u001b[?2004hroot@8c37df19d273:/app# "]
[192.113348, "i", "cat <<'EOF' > /app/src/normalization.py\n\"\"\"Batch Normalization layer for 2‑D inputs (NHWC) using NumPy.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass BatchNorm2D(BaseLayer):\n    def __init__(self, num_features: int, eps: float = 1e-5, momentum: float = 0.1):\n        super().__init__()\n        self.num_features = num_features\n        self.eps = eps\n        self.momentum = momentum\n        self.gamma = np.ones(num_features, dtype=np.float64)\n        self.beta = np.zeros(num_features, dtype=np.float64)\n        self.running_mean = np.zeros(num_features, dtype=np.float64)\n        self.running_var = np.ones(num_features, dtype=np.float64)\n\n    def forward(self, x: np.ndarray, training: bool = True) -> np.ndarray:\n        x = x.astype(np.float64, copy=False)\n        # Compute mean and var across (batch, height, width) for each channel\n        if training:\n            batch_mean = np.mean(x, axis=(0, 1, 2))\n            batch_var = np.var(x, axis=(0, 1, 2))\n         "]
[192.113395, "i", "   # Update running statistics\n            self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * batch_mean\n            self.running_var = (1 - self.momentum) * self.running_var + self.momentum * batch_var\n            mean = batch_mean\n            var = batch_var\n        else:\n            mean = self.running_mean\n            var = self.running_var\n        # Normalize\n        x_norm = (x - mean.reshape((1, 1, 1, self.num_features))) / np.sqrt(var.reshape((1, 1, 1, self.num_features)) + self.eps)\n        out = self.gamma.reshape((1, 1, 1, self.num_features)) * x_norm + self.beta.reshape((1, 1, 1, self.num_features))\n        return out\nEOF\n"]
