[47.547376, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: /app/src/padding.py\n+\"\"\"Utility functions for padding and output‑shape calculation.\n+\n+The functions operate on tensors in NHWC format (batch, height, width,\n+channels) as required by the rest of the library.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import numpy as np\n+from typing import Tuple\n+\n+\n+def zero_pad(x: np.ndarray, pad: int) -> np.ndarray:\n+    \"\"\"Pad the spatial dimensions of ``x`` with zeros.\n+\n+    Parameters\n+    ----------\n+    x : np.ndarray\n+        Input tensor of shape ``(batch, height, width, channels)``.\n+    pad : int\n+        Number of zero rows/columns to add on *each* side.\n+\n+    Returns\n+    -------\n+    np.ndarray\n+        Padded tensor with shape ``(batch, height + 2*pad, width + 2*pad,\n+        channels)`` and ``dtype`` ``float64``.\n+    \"\"\"\n+    if pad == 0:\n+        return x.astype(np.float64, copy=False)\n+    if x.ndim != 4:\n+        raise ValueError(\"zero_pad expects a 4‑D tensor (NHWC)\")\n+    # Use np.pad with a p"]
[47.547536, "i", "ad width that only affects H and W dimensions.\n+    padded = np.pad(\n+        x,\n+        pad_width=((0, 0), (pad, pad), (pad, pad), (0, 0)),\n+        mode=\"constant\",\n+        constant_values=0,\n+    )\n+    return padded.astype(np.float64, copy=False)\n+\n+\n+def get_output_shape(\n+    input_shape: Tuple[int, int],\n+    kernel_size: int,\n+    stride: int,\n+    padding: int,\n+    dilation: int = 1,\n+) -> Tuple[int, int]:\n+    \"\"\"Compute the spatial output shape of a convolution/pooling layer.\n+\n+    The formula follows the definition used in most deep‑learning frameworks:\n+\n+    ``output = (input + 2*padding - dilation*(kernel-1) - 1) // stride + 1``\n+    \"\"\"\n+    h_in, w_in = input_shape\n+    def dim_out(dim: int) -> int:\n+        return (dim + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\n+    return dim_out(h_in), dim_out(w_in)\n+\n*** End Patch\nPATCH\n"]
