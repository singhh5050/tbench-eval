[45.545944, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: /app/src/__init__.py\n+\"\"\"Top‑level package for the NumPy‑only CNN implementation.\n+\n+This module re‑exports the core building blocks so that users can import\n+them directly from ``src``:\n+\n+    from src import Conv2D, ReLU, zero_pad, ...\n+\n+Only the symbols required by the task description are exported.\n+\"\"\"\n+\n+from .base import BaseLayer\n+from .conv import Conv2D\n+from .conv_transpose import Conv2DTranspose\n+from .pooling import MaxPool2D, AvgPool2D\n+from .normalization import BatchNorm2D\n+from .activation import ReLU, LeakyReLU, Sigmoid\n+from .padding import zero_pad, get_output_shape\n+\n+__all__ = [\n+    \"BaseLayer\",\n+    \"Conv2D\",\n+    \"Conv2DTranspose\",\n+    \"MaxPool2D\",\n+    \"AvgPool2D\",\n+    \"BatchNorm2D\",\n+    \"ReLU\",\n+    \"LeakyReLU\",\n+    \"Sigmoid\",\n+    \"zero_pad\",\n+    \"get_output_shape\",\n+]\n+\n*** End Patch\nPATCH\n"]
