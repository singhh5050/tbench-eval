[96.078822, "o", "\u001b[?2004h> "]
[96.078832, "o", "        \"\"\"\r\n"]
[96.078843, "o", "\u001b[?2004l\r"]
[96.078855, "o", "\u001b[?2004h> "]
[96.078878, "o", "        return self.forward(x)\r\n\u001b[?2004l\r"]
[96.078888, "o", "\u001b[?2004h> \r\n"]
[96.0789, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[96.078922, "o", "    @abc.abstractmethod\r\n\u001b[?2004l\r"]
[96.078933, "o", "\u001b[?2004h> "]
[96.078995, "o", "    def forward(self, x: np.ndarray) -> np.ndarray:  # pragma: no cover\r\n\u001b[?2004l\r"]
[96.079005, "o", "\u001b[?2004h> "]
[96.079038, "o", "        \"\"\"Compute the forward pass.\r\n\u001b[?2004l\r"]
[96.079048, "o", "\u001b[?2004h> "]
[96.079059, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.079125, "o", "        Sub‑classes must override this method.  The implementation should\r\n\u001b[?2004l\r"]
[96.079137, "o", "\u001b[?2004h> "]
[96.079196, "o", "        ensure that the returned array has ``dtype`` ``float64``.\r\n\u001b[?2004l\r"]
[96.079206, "o", "\u001b[?2004h"]
[96.079218, "o", "> "]
[96.079229, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.079265, "o", "        raise NotImplementedError\r\n\u001b[?2004l\r"]
