[191.105044, "i", "cat <<'EOF' > /app/src/pooling.py\n\"\"\"Pooling layer implementations (max and average) using NumPy.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass MaxPool2D(BaseLayer):\n    def __init__(self, kernel_size: int, stride: int | None = None):\n        super().__init__()\n        self.kernel_size = kernel_size\n        self.stride = stride if stride is not None else kernel_size\n\n    def forward(self, x: np.ndarray) -> np.ndarray:\n        x = x.astype(np.float64, copy=False)\n        batch, h_in, w_in, c = x.shape\n        out_h = (h_in - self.kernel_size) // self.stride + 1\n        out_w = (w_in - self.kernel_size) // self.stride + 1\n        out = np.empty((batch, out_h, out_w, c), dtype=np.float64)\n        for b in range(batch):\n            for i in range(out_h):\n                for j in range(out_w):\n                    h_start = i * self.stride\n                    w_start = j * self.stride\n                    window = x[b, h_start:h_start + self.kernel_size, w_start:w_st"]
[191.105232, "i", "art + self.kernel_size, :]\n                    out[b, i, j, :] = np.max(window, axis=(0, 1))\n        return out\n\n\nclass AvgPool2D(BaseLayer):\n    def __init__(self, kernel_size: int, stride: int | None = None):\n        super().__init__()\n        self.kernel_size = kernel_size\n        self.stride = stride if stride is not None else kernel_size\n\n    def forward(self, x: np.ndarray) -> np.ndarray:\n        x = x.astype(np.float64, copy=False)\n        batch, h_in, w_in, c = x.shape\n        out_h = (h_in - self.kernel_size) // self.stride + 1\n        out_w = (w_in - self.kernel_size) // self.stride + 1\n        out = np.empty((batch, out_h, out_w, c), dtype=np.float64)\n        for b in range(batch):\n            for i in range(out_h):\n                for j in range(out_w):\n                    h_start = i * self.stride\n                    w_start = j * self.stride\n                    window = x[b, h_start:h_start + self.kernel_size, w_start:w_start + self.kernel_size, :]\n                    out[b, i, j, :] = np.mean(w"]
