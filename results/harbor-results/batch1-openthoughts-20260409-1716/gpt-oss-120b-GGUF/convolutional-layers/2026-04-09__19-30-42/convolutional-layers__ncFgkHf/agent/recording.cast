[95.57072, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> __all__ = [\r\n\u001b[?2004l\r\u001b[?2004h>     \"BaseLayer\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"Conv2D\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"Conv2DTranspose\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"MaxPool2D\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"AvgPool2D\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"BatchNorm2D\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"ReLU\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"LeakyReLU\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"Sigmoid\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"zero_pad\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"get_output_shape\",\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
