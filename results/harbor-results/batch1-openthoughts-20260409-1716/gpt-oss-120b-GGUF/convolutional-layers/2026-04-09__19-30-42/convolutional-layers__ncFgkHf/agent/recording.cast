[193.114314, "i", "cat <<'EOF' > /app/src/activation.py\n\"\"\"Activation functions implemented as layers.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass ReLU(BaseLayer):\n    def __init__(self):\n        super().__init__()\n\n    def forward(self, x: np.ndarray) -> np.ndarray:\n        return np.maximum(0, x.astype(np.float64, copy=False))\n\n\nclass LeakyReLU(BaseLayer):\n    def __init__(self, negative_slope: float = 0.01):\n        super().__init__()\n        self.negative_slope = negative_slope\n\n    def forward(self, x: np.ndarray) -> np.ndarray:\n        x = x.astype(np.float64, copy=False)\n        return np.where(x > 0, x, self.negative_slope * x)\n\n\nclass Sigmoid(BaseLayer):\n    def __init__(self):\n        super().__init__()\n\n    def forward(self, x: np.ndarray) -> np.ndarray:\n        x = x.astype(np.float64, copy=False)\n        # Numerically stable sigmoid\n        pos_mask = x >= 0\n        neg_mask = ~pos_mask\n        result = np.empty_like(x, dtype=np.float64)\n        result[pos_mask] ="]
[193.114462, "i", " 1 / (1 + np.exp(-x[pos_mask]))\n        exp_x = np.exp(x[neg_mask])\n        result[neg_mask] = exp_x / (1 + exp_x)\n        return result\nEOF\n"]
