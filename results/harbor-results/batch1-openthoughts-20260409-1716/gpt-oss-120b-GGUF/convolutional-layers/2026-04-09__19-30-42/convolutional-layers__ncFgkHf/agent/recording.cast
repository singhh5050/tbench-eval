[96.078163, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[96.07818, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.078204, "o", "class BaseLayer(abc.ABC):\r\n\u001b[?2004l\r"]
[96.078224, "o", "\u001b[?2004h> "]
[96.07829, "o", "    \"\"\"Abstract base class for neural‑network layers.\r\n\u001b[?2004l\r"]
[96.078316, "o", "\u001b[?2004h"]
[96.078341, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.078392, "o", "    Sub‑classes must implement the ``forward`` method which receives a NumPy\r\n\u001b[?2004l\r"]
[96.078415, "o", "\u001b[?2004h> "]
[96.07846, "o", "    ``ndarray`` and returns a ``ndarray`` of type ``float64``.\r\n\u001b[?2004l\r"]
[96.078467, "o", "\u001b[?2004h> "]
[96.078487, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[96.078501, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
