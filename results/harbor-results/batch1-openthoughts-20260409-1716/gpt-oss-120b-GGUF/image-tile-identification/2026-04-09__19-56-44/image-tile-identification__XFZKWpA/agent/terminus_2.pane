[?2004l[?2004h> import cv2
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> 
[?2004l[?2004h> def rgb_to_color_name(rgb):
[?2004l[?2004h>     # Simple mapping to basic colors based on dominant channel values
[?2004l[?2004h>     r, g, b = rgb
[?2004l[?2004h>     # Define thresholds for basic colors
[?2004l[?2004h>     if r > 200 and g < 80 and b < 80:
[?2004l[?2004h>         return "red"
[?2004l[?2004h>     if g > 200 and r < 80 and b < 80:
[?2004l[?2004h>         return "green"
[?2004l[?2004h>     if b > 200 and r < 80 and g < 80:
[?2004l[?2004h>         return "blue"
[?2004l[?2004h>     if r > 200 and g > 200 and b < 80:
[?2004l[?2004h>         return "yellow"
[?2004l[?2004h>     # fallback: choose the max channel
[?2004l[?2004h>     max_idx = np.argmax([r, g, b])
[?2004l[?2004h>     return ["red", "green", "blue"][max_idx]
[?2004l[?2004h> 
[?2004l[?2004h> def dominant_background_color(image_path):
[?2004l[?2004h>     img = Image.open(image_path).convert('RGB')
[?2004l[?2004h>     pixels = np.array(img).reshape(-1, 3)
[?2004l[?2004h>     # Count most common color (approximate by rounding to nearest 10)
[?2004l[?2004h>     rounded = (pixels // 10) * 10
[?2004l[?2004h>     most_common = Counter(map(tuple, rounded)).most_common(1)[0][0]
[?2004l[?2004h>     return rgb_to_color_name(most_common)
[?2004l[?2004h> 
[?2004l[?2004h> def generate_digit_template(digit, size):
[?2004l[?2004h>     # Create a blank white image
[?2004l[?2004h>     tmpl = np.full((size[1], size[0]), 255, dtype=np.uint8)
[?2004l[?2004h>     # Choose a font and scale that fits the image
[?2004l[?2004h>     font = cv2.FONT_HERSHEY_SIMPLEX
[?2004l[?2004h>     # Estimate font scale based on image height
[?2004l[?2004h>     scale = size[1] / 100.0
[?2004l[?2004h>     thickness = max(2, int(size[1] / 50))
[?2004l[?2004h>     text = str(digit)
[?2004l[?2004h>     # Get text size
[?2004l[?2004h>     (text_w, text_h), baseline = cv2.getTextSize(text, font, scale, thickness)
[?2004l[?2004h>     # Center the text
[?2004l[?2004h>     org = ((size[0] - text_w) // 2, (size[1] + text_h) // 2)
[?2004l[?2004h>     cv2.putText(tmpl, text, org, font, scale, 0, thickness, lineType=cv2.LINE_AA)
[?2004l[?2004h>     return tmpl
[?2004l[?2004h> 
[?2004l[?2004h> def recognize_digit(image_path, size):
[?2004l[?2004h>     img = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)
[?2004l[?2004h>     # Invert if background is light (most tiles have dark digit on light bg)
[?2004l[?2004h>     _, thresh = cv2.threshold(img, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
[?2004l[?2004h>     best_digit = None
[?2004l[?2004h>     best_score = -1
[?2004l[?2004h>     for d in range(1, 5):
[?2004l[?2004h>         tmpl = generate_digit_template(d, size)
[?2004l[?2004h>         res = cv2.matchTemplate(thresh, tmpl, cv2.TM_CCOEFF_NORMED)
[?2004l[?2004h>         _, max_val, _, _ = cv2.minMaxLoc(res)
[?2004l[?2004h>         if max_val > best_score:
[?2004l[?2004h>             best_score = max_val
[?2004l[?2004h>             best_digit = d
[?2004l[?2004h>     return best_digit
[?2004l[?2004h> 
[?2004l[?2004h> tiles_dir = '/workdir/data/tiles'
[?2004l[?2004h> tiles = [f for f in os.listdir(tiles_dir) if f.lower().endswith('.png')]
[?2004l[?2004h> analysis = {}
[?2004l[?2004h> # Determine image size from first tile (all tiles share size)
[?2004l[?2004h> sample_path = os.path.join(tiles_dir, tiles[0])
[?2004l[?2004h> sample_img = cv2.imread(sample_path)
[?2004l[?2004h> height, width = sample_img.shape[:2]
[?2004l[?2004h> size = (width, height)
[?2004l[?2004h> 
[?2004l[?2004h> for tile in sorted(tiles):
[?2004l[?2004h>     path = os.path.join(tiles_dir, tile)
