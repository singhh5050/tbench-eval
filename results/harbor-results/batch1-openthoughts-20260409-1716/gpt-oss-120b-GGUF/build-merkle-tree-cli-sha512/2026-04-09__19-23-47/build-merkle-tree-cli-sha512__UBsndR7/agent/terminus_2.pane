            parent_hash = sha512_hex((left_hash + right_hash).encode())
            # update proofs for leaves in left subtree
            for idx in left_idxs:
                path = leaf_paths[idx]
                proofs[path].append(["right", right_hash])
            # update proofs for leaves in right subtree
            for idx in right_idxs:
                path = leaf_paths[idx]
                proofs[path].append(["left", left_hash])
            new_level.append((parent_hash, left_idxs + right_idxs))
        level = new_level
    root_hash = level[0][0]
    return root_hash, proofs

def load_data():
    if not os.path.exists('/app/merkle_data.json'):
        return None
    with open('/app/merkle_data.json', 'r') as f:
        return json.load(f)

def save_data(data):
    with open('/app/merkle_data.json', 'w') as f:
        json.dump(data, f, indent=2)

def cmd_scan(args):
    target_dir = os.path.abspath(args.directory)
    file_entries = []
    for root, dirs, files in os.walk(target_dir):
        for name in files:
            full_path = os.path.join(root, name)
            if not os.path.islink(full_path) and os.path.isfile(full_path):
                rel_path = os.path.relpath(full_path, start=target_dir)
                rel_path = rel_path.replace(os.sep, '/')
                file_hash = compute_file_hash(full_path)
                file_entries.append((rel_path, file_hash))
    # sort entries for deterministic order
    file_entries.sort(key=lambda x: x[0])
    root_hash, proofs = build_merkle_tree(file_entries)
    file_hashes_dict = {p: h for p, h in file_entries}
    data = {
        "root_hash": root_hash,
        "proofs": proofs,
        "file_hashes": file_hashes_dict,
        "scanned_directory": target_dir,
    }
    save_data(data)
    print(f"Scanned {len(file_entries)} files. Root hash: {root_hash}")

def cmd_proof(args):
    data = load_data()
    if data is None:
        print("Error: merkle_data.json not found. Run scan first.", file=sys.stderr)
        sys.exit(1)
    proof = data.get("proofs", {}).get(args.file_path)
    if proof is None:
        print(f"Error: No proof found for '{args.file_path}'.", file=sys.stderr)
        sys.exit(1)
    output = {"file_path": args.file_path, "proof": proof}
    print(json.dumps(output, indent=2))

def reconstruct_root_from_proof(leaf_hash, proof):
    cur = leaf_hash
    for direction, sibling in proof:
        if direction == "right":
            combined = cur + sibling
        else:  # left
            combined = sibling + cur
        cur = sha512_hex(combined.encode())
    return cur

