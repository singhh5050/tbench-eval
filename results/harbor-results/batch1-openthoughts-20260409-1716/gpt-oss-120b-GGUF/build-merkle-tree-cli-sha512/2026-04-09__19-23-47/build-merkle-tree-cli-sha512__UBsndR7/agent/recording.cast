[145.156926, "i", "\n    save_data(data)\n    print(f\"Scanned {len(file_entries)} files. Root hash: {root_hash}\")\n\ndef cmd_proof(args):\n    data = load_data()\n    if data is None:\n        print(\"Error: merkle_data.json not found. Run scan first.\", file=sys.stderr)\n        sys.exit(1)\n    proof = data.get(\"proofs\", {}).get(args.file_path)\n    if proof is None:\n        print(f\"Error: No proof found for '{args.file_path}'.\", file=sys.stderr)\n        sys.exit(1)\n    output = {\"file_path\": args.file_path, \"proof\": proof}\n    print(json.dumps(output, indent=2))\n\ndef reconstruct_root_from_proof(leaf_hash, proof):\n    cur = leaf_hash\n    for direction, sibling in proof:\n        if direction == \"right\":\n            combined = cur + sibling\n        else:  # left\n            combined = sibling + cur\n        cur = sha512_hex(combined.encode())\n    return cur\n\ndef cmd_verify(args):\n    data = load_data()\n    if data is None:\n        print(\"Error: merkle_data.json not found. Run scan first.\", file=sys.stderr)\n        sys.exit(1)\n    try:\n     "]
