[145.157208, "o", " \"proof\": proof}\r\n    print(json.dumps(output, indent=2))\r\n\r\ndef reconstruct_root_from_proof(leaf_"]
[145.15722, "o", "hash, proof):\r\n    cur = leaf_hash\r\n    for direction, sibling in proof:\r\n        if direction"]
[145.157231, "o", " == \"right\":\r\n            combined = cur + sibling\r\n        el"]
[145.157243, "o", "se:  # left\r\n            combined = sibling + cur\r\n        c"]
[145.157262, "o", "ur = sha512_hex(combined.encode())\r\n    return cur\r\n\r\ndef cmd_verify(args):\r\n    data = load_data()\r\n    if data is None:\r\n        print(\"Erro"]
[145.157283, "o", "r: merkle_data.json not found. Run scan first.\", file=sys.stder"]
[145.157296, "o", "r)\r\n        sys.exit(1)\r\n    try:\r\n        with open(args.proof_file, '\u001b[?2004h"]
[145.157309, "o", "> "]
[145.157341, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[145.157357, "o", "\u001b[?2004h> "]
[145.157428, "o", "import argparse, os, json, hashlib, sys\r\n\u001b[?2004l\r"]
[145.157441, "o", "\u001b[?2004h> "]
[145.157454, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[145.157467, "o", "> "]
[145.157507, "o", "def sha512_hex(data: bytes) -> str:\r\n\u001b[?2004l\r"]
[145.15752, "o", "\u001b[?2004h> "]
[145.157578, "o", "    return hashlib.sha512(data).hexdigest()\r\n\u001b[?2004l\r"]
[145.157589, "o", "\u001b[?2004h> \r\n"]
[145.157601, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.157674, "o", "def compute_file_hash(path: str) -> str:\r\n"]
[145.157691, "o", "\u001b[?2004l\r\u001b[?2004h"]
[145.157705, "o", "> "]
[145.157738, "o", "    h = hashlib.sha512()\r\n\u001b[?2004l\r"]
[145.15775, "o", "\u001b[?2004h> "]
[145.157796, "o", "    with open(path, 'rb') as f:\r\n\u001b[?2004l\r"]
[145.157807, "o", "\u001b[?2004h> "]
[145.157838, "o", "        while True:\r\n\u001b[?2004l\r"]
[145.157848, "o", "\u001b[?2004h> "]
[145.157893, "o", "            chunk = f.read(8192)\r\n\u001b[?2004l\r"]
[145.157904, "o", "\u001b[?2004h> "]
[145.157942, "o", "            if not chunk:\r\n\u001b[?2004l\r"]
[145.157952, "o", "\u001b[?2004h> "]
[145.157985, "o", "                break\r\n\u001b[?2004l\r"]
[145.157998, "o", "\u001b[?2004h> "]
[145.158035, "o", "            h.update(chunk)\r\n\u001b[?2004l\r"]
[145.158045, "o", "\u001b[?2004h> "]
[145.158085, "o", "    return h.hexdigest()\r\n\u001b[?2004l\r"]
[145.158096, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[145.158105, "o", "\u001b[?2004h> "]
[145.158159, "o", "def build_merkle_tree(file_hashes):\r\n\u001b[?2004l\r"]
[145.158171, "o", "\u001b[?2004h> "]
[145.158255, "o", "    \"\"\"Build Merkle tree and return root hash and proofs.\r\n\u001b[?2004l\r"]
[145.158265, "o", "\u001b[?2004h> "]
[145.15837, "o", "    file_hashes: list of (relative_path, leaf_hash) in deterministic order.\r\n\u001b[?2004l\r"]
[145.15838, "o", "\u001b[?2004h> "]
[145.158522, "o", "    Returns (root_hash, proofs_dict) where proofs_dict maps path -> list of [direction, sibling_hash].\r\n\u001b[?2004l\r"]
[145.158532, "o", "\u001b[?2004h> "]
[145.158546, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[145.158557, "o", "\u001b[?2004h> "]
[145.158593, "o", "    if not file_hashes:\r\n"]
[145.158604, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.158638, "o", "        return \"\", {}\r\n\u001b[?2004l\r"]
[145.15866, "o", "\u001b[?2004h> "]
[145.158715, "o", "    leaf_paths = [p for p, _ in file_hashes]\r\n\u001b[?2004l\r"]
[145.158728, "o", "\u001b[?2004h> "]
[145.15879, "o", "    leaf_hashes = [h for _, h in file_hashes]\r\n\u001b[?2004l\r"]
[145.158801, "o", "\u001b[?2004h> "]
[145.158874, "o", "    proofs = {p: [] for p in leaf_paths}\r\n\u001b[?2004l\r"]
[145.158888, "o", "\u001b[?2004h> "]
[145.158946, "o", "    # each element: (hash, [leaf_indices])\r\n\u001b[?2004l\r"]
[145.158957, "o", "\u001b[?2004h> "]
[145.159048, "o", "    level = [(leaf_hashes[i], [i]) for i in range(len(leaf_hashes))]\r\n\u001b[?2004l\r"]
[145.159058, "o", "\u001b[?2004h> "]
[145.159097, "o", "    while len(level) > 1:\r\n\u001b[?2004l\r"]
[145.159108, "o", "\u001b[?2004h> "]
[145.159157, "o", "        if len(level) % 2 == 1:\r\n\u001b[?2004l\r"]
[145.159167, "o", "\u001b[?2004h> "]
[145.159237, "o", "            # duplicate last element for odd count\r\n\u001b[?2004l\r"]
[145.159246, "o", "\u001b[?2004h> "]
[145.159314, "o", "            level.append(level[-1])\r\n\u001b[?2004l\r"]
[145.159326, "o", "\u001b[?2004h> "]
[145.159375, "o", "        new_level = []\r\n\u001b[?2004l\r"]
[145.159387, "o", "\u001b[?2004h> "]
[145.159472, "o", "        for i in range(0, len(level), 2):\r\n\u001b[?2004l\r"]
[145.159484, "o", "\u001b[?2004h> "]
[145.159571, "o", "            left_hash, left_idxs = level[i]\r\n\u001b[?2004l\r"]
[145.159583, "o", "\u001b[?2004h> "]
[145.159679, "o", "            right_hash, right_idxs = level[i + 1]\r\n\u001b[?2004l\r"]
[145.159693, "o", "\u001b[?2004h> "]
[145.159789, "o", "            parent_hash = sha512_hex((left_hash + right_hash).encode())\r\n\u001b[?2004l\r"]
[145.159806, "o", "\u001b[?2004h"]
[145.159834, "o", "> "]
[145.159871, "o", "            # update proofs for leaves in left subtree\r\n\u001b[?2004l\r"]
[145.15989, "o", "\u001b[?2004h> "]
[145.159928, "o", "            for idx in left_idxs:\r\n\u001b[?2004l\r"]
[145.159934, "o", "\u001b[?2004h"]
[145.159968, "o", "> "]
[145.159998, "o", "                path = leaf_paths[idx]\r\n\u001b[?2004l\r"]
[145.160027, "o", "\u001b[?2004h> "]
[145.160128, "o", "                proofs[path].append([\"right\", right_hash])\r\n"]
[145.16014, "o", "\u001b[?2004l\r"]
[145.160177, "o", "\u001b[?2004h"]
[145.160191, "o", "> "]
[145.160264, "o", "            # update proofs for leaves in right subtree\r\n\u001b[?2004l\r"]
[145.160277, "o", "\u001b[?2004h> "]
[145.160316, "o", "            for idx in right_idxs:\r\n\u001b[?2004l\r"]
[145.16033, "o", "\u001b[?2004h> "]
[145.160376, "o", "                path = leaf_paths[idx]\r\n\u001b[?2004l\r"]
[145.160389, "o", "\u001b[?2004h> "]
[145.160454, "o", "                proofs[path].append([\"left\", left_hash])\r\n\u001b[?2004l\r"]
[145.160468, "o", "\u001b[?2004h> "]
[145.160538, "o", "            new_level.append((parent_hash, left_idxs + right_idxs))\r\n\u001b[?2004l\r"]
[145.160564, "o", "\u001b[?2004h> "]
[145.160581, "o", "        level = new_level\r\n\u001b[?2004l\r"]
[145.160596, "o", "\u001b[?2004h> "]
[145.160619, "o", "    root_hash = level[0][0]\r\n\u001b[?2004l\r"]
[145.160632, "o", "\u001b[?2004h> "]
[145.16067, "o", "    return root_hash, proofs\r\n\u001b[?2004l\r"]
[145.160683, "o", "\u001b[?2004h"]
[145.160696, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.160718, "o", "def load_data():\r\n\u001b[?2004l\r\u001b[?2004h"]
[145.160722, "o", "> "]
[145.160778, "o", "    if not os.path.exists('/app/merkle_data.json'):\r\n"]
[145.160781, "o", "\u001b[?2004l\r"]
[145.160792, "o", "\u001b[?2004h> "]
[145.160812, "o", "        return None\r\n\u001b[?2004l\r"]
[145.160824, "o", "\u001b[?2004h> "]
[145.160873, "o", "    with open('/app/merkle_data.json', 'r') as f:\r\n\u001b[?2004l\r"]
[145.160887, "o", "\u001b[?2004h> "]
[145.160914, "o", "        return json.load(f)\r\n\u001b[?2004l\r"]
[145.160927, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[145.16094, "o", "\u001b[?2004h> "]
[145.160959, "o", "def save_data(data):\r\n\u001b[?2004l\r"]
[145.160971, "o", "\u001b[?2004h"]
[145.160984, "o", "> "]
[145.161015, "o", "    with open('/app/merkle_data.json', 'w') as f:\r\n\u001b[?2004l\r"]
[145.161027, "o", "\u001b[?2004h"]
[145.16104, "o", "> "]
[145.161052, "o", "        json.dump(data, f, indent=2)\r\n\u001b[?2004l\r"]
[145.161067, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[145.161078, "o", "\u001b[?2004h> "]
[145.161089, "o", "def cmd_scan(args):\r\n\u001b[?2004l\r"]
[145.1611, "o", "\u001b[?2004h> "]
[145.161137, "o", "    target_dir = os.path.abspath(args.directory)\r\n\u001b[?2004l\r"]
[145.16115, "o", "\u001b[?2004h> "]
[145.161164, "o", "    file_entries = []\r\n\u001b[?2004l\r"]
[145.161177, "o", "\u001b[?2004h"]
[145.161189, "o", "> "]
[145.161214, "o", "    for root, dirs, files in os.walk(target_dir):\r\n\u001b[?2004l\r"]
[145.161227, "o", "\u001b[?2004h"]
[145.161239, "o", "> "]
[145.161251, "o", "        for name in files:\r\n"]
[145.161263, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[145.161293, "o", "            full_path = os.path.join(root, name)\r\n\u001b[?2004l\r"]
[145.161306, "o", "\u001b[?2004h> "]
[145.161363, "o", "            if not os.path.islink(full_path) and os.path.isfile(full_path):\r\n\u001b[?2004l\r"]
[145.161376, "o", "\u001b[?2004h"]
[145.161389, "o", "> "]
[145.161429, "o", "                rel_path = os.path.relpath(full_path, start=target_dir)\r\n\u001b[?2004l\r"]
[145.161441, "o", "\u001b[?2004h> "]
[145.161484, "o", "                rel_path = rel_path.replace(os.sep, '/')\r\n\u001b[?2004l\r"]
[145.161496, "o", "\u001b[?2004h"]
[145.161509, "o", "> "]
[145.161538, "o", "                file_hash = compute_file_hash(full_path)\r\n\u001b[?2004l\r"]
[145.16155, "o", "\u001b[?2004h"]
[145.161562, "o", "> "]
[145.161594, "o", "                file_entries.append((rel_path, file_hash))\r\n\u001b[?2004l\r"]
[145.161606, "o", "\u001b[?2004h"]
[145.161619, "o", "> "]
[145.161638, "o", "    # sort entries for deterministic order\r\n\u001b[?2004l\r"]
[145.161656, "o", "\u001b[?2004h"]
[145.161669, "o", "> "]
[145.161684, "o", "    file_entries.sort(key=lambda x: x[0])\r\n\u001b[?2004l\r"]
[145.161696, "o", "\u001b[?2004h> "]
[145.161738, "o", "    root_hash, proofs = build_merkle_tree(file_entries)\r\n\u001b[?2004l\r"]
[145.161751, "o", "\u001b[?2004h> "]
[145.161791, "o", "    file_hashes_dict = {p: h for p, h in file_entries}\r\n\u001b[?2004l\r"]
[145.161805, "o", "\u001b[?2004h> "]
[145.161817, "o", "    data = {\r\n\u001b[?2004l\r"]
[145.161828, "o", "\u001b[?2004h> "]
[145.161847, "o", "        \"root_hash\": root_hash,\r\n\u001b[?2004l\r"]
[145.16186, "o", "\u001b[?2004h> "]
[145.161878, "o", "        \"proofs\": proofs,\r\n\u001b[?2004l\r"]
[145.16189, "o", "\u001b[?2004h> "]
[145.161921, "o", "        \"file_hashes\": file_hashes_dict,\r\n\u001b[?2004l\r"]
[145.161935, "o", "\u001b[?2004h> "]
[145.161963, "o", "        \"scanned_directory\": target_dir,\r\n\u001b[?2004l\r"]
[145.161976, "o", "\u001b[?2004h> "]
[145.161988, "o", "    }\r\n\u001b[?2004l\r"]
[145.162, "o", "\u001b[?2004h> "]
[145.162013, "o", "    save_data(data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.16207, "o", "    print(f\"Scanned {len(file_entries)} files. Root hash: {root_hash}\")\r\n\u001b[?2004l\r"]
[145.162079, "o", "\u001b[?2004h"]
[145.16209, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.162107, "o", "def cmd_proof(args):\r\n\u001b[?2004l\r"]
[145.162119, "o", "\u001b[?2004h> "]
[145.162135, "o", "    data = load_data()\r\n\u001b[?2004l\r"]
[145.162146, "o", "\u001b[?2004h> "]
[145.162162, "o", "    if data is None:\r\n\u001b[?2004l\r"]
[145.162173, "o", "\u001b[?2004h"]
[145.162183, "o", "> "]
[145.162238, "o", "        print(\"Error: merkle_data.json not found. Run scan first.\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[145.162243, "o", "\u001b[?2004h"]
[145.162259, "o", "> "]
[145.162271, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[145.162282, "o", "\u001b[?2004h> "]
[145.162318, "o", "    proof = data.get(\"proofs\", {}).get(args.file_path)\r\n\u001b[?2004l\r"]
[145.16233, "o", "\u001b[?2004h> "]
[145.162345, "o", "    if proof is None:\r\n\u001b[?2004l\r"]
[145.162355, "o", "\u001b[?2004h> "]
[145.162417, "o", "        print(f\"Error: No proof found for '{args.file_path}'.\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[145.162428, "o", "\u001b[?2004h> "]
[145.162443, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[145.162453, "o", "\u001b[?2004h> "]
[145.162499, "o", "    output = {\"file_path\": args.file_path, \"proof\": proof}\r\n\u001b[?2004l\r"]
[145.16251, "o", "\u001b[?2004h"]
[145.16252, "o", "> "]
[145.16254, "o", "    print(json.dumps(output, indent=2))\r\n\u001b[?2004l\r"]
[145.162549, "o", "\u001b[?2004h> "]
[145.16256, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.162599, "o", "def reconstruct_root_from_proof(leaf_hash, proof):\r\n\u001b[?2004l\r"]
[145.16261, "o", "\u001b[?2004h> "]
[145.162625, "o", "    cur = leaf_hash\r\n\u001b[?2004l\r"]
[145.162635, "o", "\u001b[?2004h> "]
[145.162676, "o", "    for direction, sibling in proof:\r\n\u001b[?2004l\r"]
[145.162684, "o", "\u001b[?2004h"]
[145.162697, "o", "> "]
[145.162711, "o", "        if direction == \"right\":\r\n\u001b[?2004l\r"]
[145.162724, "o", "\u001b[?2004h> "]
[145.162755, "o", "            combined = cur + sibling\r\n\u001b[?2004l\r"]
[145.162766, "o", "\u001b[?2004h"]
[145.162776, "o", "> "]
[145.162786, "o", "        else:  # left\r\n\u001b[?2004l\r"]
[145.162796, "o", "\u001b[?2004h> "]
[145.162823, "o", "            combined = sibling + cur\r\n\u001b[?2004l\r"]
[145.162833, "o", "\u001b[?2004h> "]
[145.16287, "o", "        cur = sha512_hex(combined.encode())\r\n\u001b[?2004l\r"]
[145.162881, "o", "\u001b[?2004h> "]
[145.162893, "o", "    return cur\r\n\u001b[?2004l\r"]
[145.162903, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[145.162913, "o", "\u001b[?2004h> "]
[145.16293, "o", "def cmd_verify(args):\r\n\u001b[?2004l\r"]
[145.16294, "o", "\u001b[?2004h> "]
[145.16296, "o", "    data = load_data()\r\n\u001b[?2004l\r"]
[145.162971, "o", "\u001b[?2004h> "]
[145.162986, "o", "    if data is None:\r\n\u001b[?2004l\r"]
[145.162996, "o", "\u001b[?2004h> "]
[145.163066, "o", "        print(\"Error: merkle_data.json not found. Run scan first.\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[145.163076, "o", "\u001b[?2004h> "]
[145.163091, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[145.163102, "o", "\u001b[?2004h> "]
[145.163112, "o", "    try:\r\n\u001b[?2004l\r"]
[145.163122, "o", "\u001b[?2004h> "]
[145.163158, "o", "        with open(args.proof_file, 'r') as f:\r\n\u001b[?2004l\r"]
[145.163168, "o", "\u001b[?2004h> "]
[145.163199, "o", "            proof_json = json.load(f)\r\n\u001b[?2004l\r"]
[145.16321, "o", "\u001b[?2004h> "]
[145.163233, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[145.163243, "o", "\u001b[?2004h> "]
[145.163295, "o", "        print(f\"Error reading proof file: {e}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[145.163316, "o", "\u001b[?2004h> "]
[145.163327, "o", "        sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[145.163337, "o", "> "]
[145.16336, "o", "    proof = proof_json.get(\"proof\")\r\n\u001b[?2004l\r"]
[145.16337, "o", "\u001b[?2004h> "]
[145.163389, "o", "    if proof is None:\r\n\u001b[?2004l\r"]
[145.163398, "o", "\u001b[?2004h"]
[145.163408, "o", "> "]
[145.163462, "o", "        print(\"Invalid proof file: missing 'proof' field.\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[145.163483, "o", "\u001b[?2004h> "]
[145.163493, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[145.163503, "o", "\u001b[?2004h> "]
[145.163524, "o", "    file_path = args.file_path\r\n\u001b[?2004l\r"]
[145.163534, "o", "\u001b[?2004h> "]
[145.163565, "o", "    if not os.path.isabs(file_path):\r\n\u001b[?2004l\r"]
[145.163575, "o", "\u001b[?2004h"]
[145.163586, "o", "> "]
[145.163621, "o", "        scanned_dir = data.get(\"scanned_directory\", \"\")\r\n\u001b[?2004l\r"]
[145.163632, "o", "\u001b[?2004h> "]
[145.163698, "o", "        file_path = os.path.join(scanned_dir, file_path)\r\n\u001b[?2004l\r"]
[145.163707, "o", "\u001b[?2004h"]
[145.163718, "o", "> "]
[145.163738, "o", "    if not os.path.isfile(file_path):\r\n\u001b[?2004l\r"]
[145.163748, "o", "\u001b[?2004h> "]
[145.163809, "o", "        print(f\"Verification failed: file '{args.file_path}' does not exist.\")\r\n\u001b[?2004l\r"]
[145.163819, "o", "\u001b[?2004h> "]
[145.163835, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[145.163846, "o", "\u001b[?2004h> "]
[145.163881, "o", "    leaf_hash = compute_file_hash(file_path)\r\n\u001b[?2004l\r"]
[145.163891, "o", "\u001b[?2004h> "]
[145.163942, "o", "    computed_root = reconstruct_root_from_proof(leaf_hash, proof)\r\n\u001b[?2004l\r"]
[145.163953, "o", "\u001b[?2004h> "]
[145.163986, "o", "    stored_root = data.get(\"root_hash\", \"\")\r\n\u001b[?2004l\r"]
[145.163996, "o", "\u001b[?2004h> "]
[145.164025, "o", "    if computed_root == stored_root:\r\n\u001b[?2004l\r"]
[145.164036, "o", "\u001b[?2004h"]
[145.164047, "o", "> "]
[145.164067, "o", "        print(\"Verification succeeded.\")\r\n\u001b[?2004l\r"]
[145.164077, "o", "\u001b[?2004h> "]
[145.164093, "o", "        sys.exit(0)\r\n\u001b[?2004l\r"]
[145.164103, "o", "\u001b[?2004h> "]
[145.164114, "o", "    else:\r\n\u001b[?2004l\r"]
[145.164124, "o", "\u001b[?2004h> "]
[145.164183, "o", "        print(\"Verification failed: computed root does not match stored root.\")\r\n\u001b[?2004l\r"]
[145.164192, "o", "\u001b[?2004h"]
[145.164203, "o", "> "]
[145.164211, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[145.164221, "o", "\u001b[?2004h"]
[145.164231, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.164239, "o", "def main():\r\n\u001b[?2004l\r"]
[145.16425, "o", "\u001b[?2004h"]
[145.16426, "o", "> "]
[145.16432, "o", "    parser = argparse.ArgumentParser(description=\"Merkle Tree CLI Tool with SHA-512\")\r\n\u001b[?2004l\r"]
[145.164331, "o", "\u001b[?2004h> "]
[145.164384, "o", "    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\u001b[?2004l\r"]
[145.164393, "o", "\u001b[?2004h> "]
[145.164469, "o", "    scan_parser = subparsers.add_parser(\"scan\", help=\"Scan a directory and build a Merkle tree\")\r\n\u001b[?2004l\r"]
[145.164481, "o", "\u001b[?2004h> "]
[145.164538, "o", "    scan_parser.add_argument(\"directory\", help=\"Target directory to scan\")\r\n\u001b[?2004l\r"]
[145.164548, "o", "\u001b[?2004h> "]
[145.164582, "o", "    scan_parser.set_defaults(func=cmd_scan)\r\n\u001b[?2004l\r"]
[145.164591, "o", "\u001b[?2004h"]
[145.1646, "o", "> "]
[145.164669, "o", "    proof_parser = subparsers.add_parser(\"proof\", help=\"Generate Merkle proof for a file\")\r\n\u001b[?2004l\r"]
[145.164678, "o", "\u001b[?2004h> "]
[145.16476, "o", "    proof_parser.add_argument(\"file_path\", help=\"Relative path of the file as stored in merkle_data.json\")\r\n\u001b[?2004l\r"]
[145.164771, "o", "\u001b[?2004h"]
[145.164774, "o", "> "]
[145.164805, "o", "    proof_parser.set_defaults(func=cmd_proof)\r\n\u001b[?2004l\r"]
[145.164815, "o", "\u001b[?2004h"]
[145.164826, "o", "> "]
[145.164889, "o", "    verify_parser = subparsers.add_parser(\"verify\", help=\"Verify a file against a Merkle proof\")\r\n\u001b[?2004l\r"]
[145.164899, "o", "\u001b[?2004h> "]
[145.164978, "o", "    verify_parser.add_argument(\"file_path\", help=\"Path to the file to verify (relative or absolute)\")\r\n\u001b[?2004l\r"]
[145.165002, "o", "\u001b[?2004h> "]
[145.165072, "o", "    verify_parser.add_argument(\"proof_file\", help=\"JSON file containing the proof (output of proof command)\")\r\n\u001b[?2004l\r"]
[145.165083, "o", "\u001b[?2004h> "]
[145.165122, "o", "    verify_parser.set_defaults(func=cmd_verify)\r\n\u001b[?2004l\r"]
[145.165132, "o", "\u001b[?2004h"]
[145.165141, "o", "> "]
[145.165158, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r"]
[145.165168, "o", "\u001b[?2004h> "]
[145.165182, "o", "    args.func(args)\r\n\u001b[?2004l\r"]
[145.165192, "o", "\u001b[?2004h> "]
[145.165203, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.165225, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[145.165234, "o", "\u001b[?2004h> "]
[145.165245, "o", "    main()\r\n\u001b[?2004l\r"]
[145.165256, "o", "\u001b[?2004h"]
[145.165265, "o", "> PY\r\n\u001b[?2004l\r"]
