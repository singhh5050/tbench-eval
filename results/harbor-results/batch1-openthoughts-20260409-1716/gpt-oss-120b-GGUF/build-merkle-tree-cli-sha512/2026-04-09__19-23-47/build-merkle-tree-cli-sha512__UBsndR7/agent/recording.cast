[78.660675, "o", "\u001b[?2004h> "]
[78.660741, "o", "    verify_parser.add_argument(\"file_path\", help=\"Path to the file to verify (relative or absolute)\")\r\n\u001b[?2004l\r"]
[78.660761, "o", "\u001b[?2004h> "]
