[78.656849, "i", "                file_hash = compute_file_hash(full_path)\n                file_entries.append((rel_path, file_hash))\n    # sort entries for deterministic order\n    file_entries.sort(key=lambda x: x[0])\n    root_hash, proofs = build_merkle_tree(file_entries)\n    file_hashes_dict = {p: h for p, h in file_entries}\n    data = {\n        \"root_hash\": root_hash,\n        \"proofs\": proofs,\n        \"file_hashes\": file_hashes_dict,\n        \"scanned_directory\": target_dir,\n    }\n    save_data(data)\n    print(f\"Scanned {len(file_entries)} files. Root hash: {root_hash}\")\n\ndef cmd_proof(args):\n    data = load_data()\n    if data is None:\n        print(\"Error: merkle_data.json not found. Run scan first.\", file=sys.stderr)\n        sys.exit(1)\n    proof = data.get(\"proofs\", {}).get(args.file_path)\n    if proof is None:\n        print(f\"Error: No proof found for '{args.file_path}'.\", file=sys.stderr)\n        sys.exit(1)\n    output = {\"file_path\": args.file_path, \"proof\": proof}\n    print(json.dumps(output, indent=2))\n\ndef reconstr"]
[78.657011, "i", "uct_root_from_proof(leaf_hash, proof):\n    cur = leaf_hash\n    for direction, sibling in proof:\n        if direction == \"right\":\n            combined = cur + sibling\n        else:  # left\n            combined = sibling + cur\n        cur = sha512_hex(combined.encode())\n    return cur\n\ndef cmd_verify(args):\n    data = load_data()\n    if data is None:\n        print(\"Error: merkle_data.json not found. Run scan first.\", file=sys.stderr)\n        sys.exit(1)\n    # Load proof JSON\n    try:\n        with open(args.proof_file, 'r') as f:\n            proof_json = json.load(f)\n    except Exception as e:\n        print(f\"Error reading proof file: {e}\", file=sys.stderr)\n        sys.exit(1)\n    proof = proof_json.get(\"proof\")\n    if proof is None:\n        print(\"Invalid proof file: missing 'proof' field.\", file=sys.stderr)\n        sys.exit(1)\n    # Resolve file path\n    file_path = args.file_path\n    if not os.path.isabs(file_path):\n        # relative to scanned directory\n        scanned_dir = data.get(\"scanned_directory\", \"\""]
[78.657069, "o", "                file_hash = compute_file_hash(full_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.657092, "i", ")\n        file_path = os.path.join(scanned_dir, file_path)\n    if not os.path.isfile(file_path):\n        print(f\"Verification failed: file '{args.file_path}' does not exist.\")\n        sys.exit(1)\n    leaf_hash = compute_file_hash(file_path)\n    computed_root = reconstruct_root_from_proof(leaf_hash, proof)\n    stored_root = data.get(\"root_hash\", \"\")\n    if computed_root == stored_root:\n        print(\"Verification succeeded.\")\n        sys.exit(0)\n    else:\n        print(\"Verification failed: computed root does not match stored root.\")\n        sys.exit(1)\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Merkle Tree CLI Tool with SHA-512\")\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n    # scan\n    scan_parser = subparsers.add_parser(\"scan\", help=\"Scan a directory and build a Merkle tree\")\n    scan_parser.add_argument(\"directory\", help=\"Target directory to scan\")\n    scan_parser.set_defaults(func=cmd_scan)\n    # proof\n    proof_parser = subparsers.add_parser(\"proof\", help=\"G"]
