[78.657132, "i", "enerate Merkle proof for a file\")\n    proof_parser.add_argument(\"file_path\", help=\"Relative path of the file as stored in merkle_data.json\")\n    proof_parser.set_defaults(func=cmd_proof)\n    # verify\n    verify_parser = subparsers.add_parser(\"verify\", help=\"Verify a file against a Merkle proof\")\n    verify_parser.add_argument(\"file_path\", help=\"Path to the file to verify (relative or absolute)\")\n    verify_parser.add_argument(\"proof_file\", help=\"JSON file containing the proof (output of proof command)\")\n    verify_parser.set_defaults(func=cmd_verify)\n    args = parser.parse_args()\n    args.func(args)\n\nif __name__ == \"__main__\":\n    main()\nPY\n"]
