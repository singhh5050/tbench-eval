[92.94206, "o", ">         # Already covered.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.942122, "o", "availability['charlie'] = complement(busy, year_start, year_end)\r\n\u001b[?2004l\r"]
[92.942129, "o", "\u001b[?2004h> \r\n"]
[92.942154, "o", "\u001b[?2004l\r"]
[92.942176, "o", "\u001b[?2004h> "]
[92.942196, "o", "# Bob (SHIFT CSV – off days are available)\r\n\u001b[?2004l\r"]
[92.942205, "o", "\u001b[?2004h> "]
[92.942227, "o", "available_days = []\r\n\u001b[?2004l\r"]
[92.94225, "o", "\u001b[?2004h> with open('bob_schedule.txt') as f:\r\n\u001b[?2004l\r"]
[92.94227, "o", "\u001b[?2004h"]
[92.942279, "o", ">     for line in f:\r\n\u001b[?2004l\r"]
[92.942304, "o", "\u001b[?2004h> "]
[92.942349, "o", "        m = re.search(r'SHIFT:\\s*(\\d{4}-\\d{2}-\\d{2}),off,', line)\r\n\u001b[?2004l\r"]
[92.942369, "o", "\u001b[?2004h> "]
[92.942377, "o", "        if m:\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.9424, "o", "> "]
[92.942431, "o", "            available_days.append(parse_date(m.group(1)))\r\n\u001b[?2004l\r"]
[92.942451, "o", "\u001b[?2004h> "]
[92.942473, "o", "# Merge consecutive days into ranges\r\n\u001b[?2004l\r"]
[92.942493, "o", "\u001b[?2004h> "]
[92.942501, "o", "available_days.sort()\r\n\u001b[?2004l\r"]
[92.942526, "o", "\u001b[?2004h> "]
[92.942548, "o", "avail = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.942569, "o", "if available_days:\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.94258, "o", "> "]
[92.942604, "o", "    start = prev = available_days[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.942638, "o", "    for d in available_days[1:]:\r\n\u001b[?2004l\r"]
[92.942659, "o", "\u001b[?2004h> "]
[92.942686, "o", "        if d == prev + timedelta(days=1):\r\n\u001b[?2004l\r"]
[92.942706, "o", "\u001b[?2004h> "]
[92.942715, "o", "            prev = d\r\n\u001b[?2004l\r"]
[92.942742, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[92.942767, "o", "\u001b[?2004h> "]
[92.942813, "o", "            avail.append({\"start\": start.isoformat(), \"end\": prev.isoformat()})\r\n\u001b[?2004l\r"]
[92.942823, "o", "\u001b[?2004h> "]
[92.942847, "o", "            start = prev = d\r\n\u001b[?2004l\r"]
[92.942869, "o", "\u001b[?2004h> "]
[92.942914, "o", "    avail.append({\"start\": start.isoformat(), \"end\": prev.isoformat()})\r\n\u001b[?2004l\r"]
[92.942937, "o", "\u001b[?2004h> "]
[92.94296, "o", "availability['bob'] = avail\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[92.942974, "o", "\u001b[?2004h> "]
[92.943001, "o", "# Write JSON\r\n\u001b[?2004l\r"]
[92.943022, "o", "\u001b[?2004h> "]
[92.943044, "o", "with open('all_availability.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.943076, "o", "    json.dump(availability, f, indent=2)\r\n\u001b[?2004l\r"]
