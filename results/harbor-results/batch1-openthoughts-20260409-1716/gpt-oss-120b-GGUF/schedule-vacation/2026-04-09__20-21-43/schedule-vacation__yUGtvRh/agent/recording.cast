[92.938312, "i", "cat > parse_and_generate.py <<'PY'\n#!/usr/bin/env python3\nimport json, re\nfrom datetime import datetime, timedelta\n\ndef month_to_num(m):\n    return datetime.strptime(m, \"%B\").month\n\ndef parse_date(s):\n    return datetime.strptime(s, \"%Y-%m-%d\").date()\n\ndef date_range(start, end):\n    d = start\n    while d <= end:\n        yield d\n        d += timedelta(days=1)\n\ndef complement(busy, year_start, year_end):\n    busy = sorted(busy)\n    avail = []\n    cur = year_start\n    for b_start, b_end in busy:\n        if cur < b_start:\n            avail.append({\"start\": cur.isoformat(), \"end\": (b_start - timedelta(days=1)).isoformat()})\n        cur = max(cur, b_end + timedelta(days=1))\n    if cur <= year_end:\n        avail.append({\"start\": cur.isoformat(), \"end\": year_end.isoformat()})\n    return avail\n\nyear_start = datetime(2025,1,1).date()\nyear_end   = datetime(2025,12,31).date()\n\navailability = {}\n\n# Alice (UNAVAILABLE periods)\nbusy = []\nwith open('alice_schedule.txt') as f:\n    for line in f:\n        m = re.search(r'UNAVA"]
[92.938354, "i", "ILABLE:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*to\\s*(\\d{4}-\\d{2}-\\d{2})', line)\n        if m:\n            busy.append((parse_date(m.group(1)), parse_date(m.group(2))))\navailability['alice'] = complement(busy, year_start, year_end)\n\n# Dana (BUSY periods similar to Alice)\nbusy = []\nwith open('dana_schedule.txt') as f:\n    for line in f:\n        m = re.search(r'BUSY:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*to\\s*(\\d{4}-\\d{2}-\\d{2})', line)\n        if m:\n            busy.append((parse_date(m.group(1)), parse_date(m.group(2))))\navailability['dana'] = complement(busy, year_start, year_end)\n\n# Charlie (TRAVEL_TEXT – unavailable periods)\nbusy = []\nwith open('charlie_schedule.txt') as f:\n    for line in f:\n        # Full month range like \"January 2025 - May 2025\"\n        m = re.search(r'(January|February|March|April|May|June|July|August|September|October|November|December)\\s+(\\d{4})\\s*-\\s*(January|February|March|April|May|June|July|August|September|October|November|December)\\s+(\\d{4})', line)\n        if m:\n            start = datetime(int(m.group("]
[92.93837, "i", "2)), month_to_num(m.group(1)), 1).date()\n            end_month = month_to_num(m.group(3))\n            # last day of end month\n            if end_month == 12:\n                end = datetime(int(m.group(4)), 12, 31).date()\n            else:\n                end = (datetime(int(m.group(4)), end_month+1, 1) - timedelta(days=1)).date()\n            busy.append((start, end))\n            continue\n        # Day range within a month e.g., \"June 15-30, 2025\"\n        m = re.search(r'(January|February|March|April|May|June|July|August|September|October|November|December)\\s+(\\d+)-(\\d+),\\s*(\\d{4})', line)\n        if m:\n            month = month_to_num(m.group(1))\n            year = int(m.group(4))\n            start = datetime(year, month, int(m.group(2))).date()\n            end   = datetime(year, month, int(m.group(3))).date()\n            busy.append((start, end))\n            continue\n        # Single date range like \"July 26-27, 2025\" handled above\n        # Single full month range handled above\n        # Also handle \"August"]
[92.938521, "i", " 4-31, 2025\"\n        # Already covered.\navailability['charlie'] = complement(busy, year_start, year_end)\n\n# Bob (SHIFT CSV – off days are available)\navailable_days = []\nwith open('bob_schedule.txt') as f:\n    for line in f:\n        m = re.search(r'SHIFT:\\s*(\\d{4}-\\d{2}-\\d{2}),off,', line)\n        if m:\n            available_days.append(parse_date(m.group(1)))\n# Merge consecutive days into ranges\navailable_days.sort()\navail = []\nif available_days:\n    start = prev = available_days[0]\n    for d in available_days[1:]:\n        if d == prev + timedelta(days=1):\n            prev = d\n        else:\n            avail.append({\"start\": start.isoformat(), \"end\": prev.isoformat()})\n            start = prev = d\n    avail.append({\"start\": start.isoformat(), \"end\": prev.isoformat()})\navailability['bob'] = avail\n\n# Write JSON\nwith open('all_availability.json', 'w') as f:\n    json.dump(availability, f, indent=2)\nPY\n"]
