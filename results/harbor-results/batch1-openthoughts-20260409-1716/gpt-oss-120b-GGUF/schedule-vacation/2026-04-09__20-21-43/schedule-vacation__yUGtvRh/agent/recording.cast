[92.939739, "o", "\u001b[?2004h> "]
[92.939765, "o", "with open('alice_schedule.txt') as f:\r\n\u001b[?2004l\r"]
[92.939786, "o", "\u001b[?2004h> "]
[92.939799, "o", "    for line in f:\r\n\u001b[?2004l\r"]
[92.939811, "o", "\u001b[?2004h> "]
[92.939884, "o", "        m = re.search(r'UNAVAILABLE:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*to\\s*(\\d{4}-\\d{2}-\\d{2})', line)\r\n"]
[92.939893, "o", "\u001b[?2004l\r\u001b[?2004h"]
[92.939903, "o", "> "]
[92.939923, "o", "        if m:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.939979, "o", "            busy.append((parse_date(m.group(1)), parse_date(m.group(2))))\r\n"]
[92.93999, "o", "\u001b[?2004l\r"]
[92.940003, "o", "\u001b[?2004h> "]
[92.94006, "o", "availability['alice'] = complement(busy, year_start, year_end)\r\n\u001b[?2004l\r"]
[92.940075, "o", "\u001b[?2004h"]
[92.940089, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.940115, "o", "# Dana (BUSY periods similar to Alice)\r\n"]
[92.940128, "o", "\u001b[?2004l\r"]
[92.94014, "o", "\u001b[?2004h> busy = []\r\n\u001b[?2004l\r"]
[92.940151, "o", "\u001b[?2004h> "]
[92.940179, "o", "with open('dana_schedule.txt') as f:\r\n\u001b[?2004l\r"]
[92.940195, "o", "\u001b[?2004h> "]
[92.940209, "o", "    for line in f:\r\n"]
[92.94022, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[92.940289, "o", "        m = re.search(r'BUSY:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*to\\s*(\\d{4}-\\d{2}-\\d{2})', line)\r\n\u001b[?2004l\r"]
[92.9403, "o", "\u001b[?2004h> "]
[92.940311, "o", "        if m:\r\n\u001b[?2004l\r"]
[92.940335, "o", "\u001b[?2004h> "]
[92.940379, "o", "            busy.append((parse_date(m.group(1)), parse_date(m.group(2))))\r\n\u001b[?2004l\r"]
[92.940391, "o", "\u001b[?2004h> "]
[92.940441, "o", "availability['dana'] = complement(busy, year_start, year_end)\r\n\u001b[?2004l\r"]
[92.940454, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[92.940464, "o", "\u001b[?2004h> "]
[92.940504, "o", "# Charlie (TRAVEL_TEXT – unavailable periods)\r\n\u001b[?2004l\r"]
[92.940515, "o", "\u001b[?2004h> "]
[92.940526, "o", "busy = []\r\n\u001b[?2004l\r"]
[92.940538, "o", "\u001b[?2004h> "]
[92.940568, "o", "with open('charlie_schedule.txt') as f:\r\n"]
[92.94058, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[92.940595, "o", "    for line in f:\r\n\u001b[?2004l\r"]
[92.940605, "o", "\u001b[?2004h> "]
[92.940664, "o", "        # Full month range like \"January 2025 - May 2025\"\r\n\u001b[?2004l\r"]
[92.940675, "o", "\u001b[?2004h> "]
[92.940872, "o", "        m = re.search(r'(January|February|March|April|May|June|July|August|September|October|November|December)\\s+(\\d{4})\\s*-\\s*(January|February|March|April|May|June|July|August|September|October|November|December)\\s+(\\d{4})', line)\r\n\u001b[?2004l\r"]
[92.940889, "o", "\u001b[?2004h> "]
[92.940901, "o", "        if m:\r\n\u001b[?2004l\r"]
[92.94091, "o", "\u001b[?2004h"]
[92.940924, "o", "> "]
[92.940981, "o", "            start = datetime(int(m.group(2)), month_to_num(m.group(1)), 1).date()\r\n\u001b[?2004l\r"]
[92.940993, "o", "\u001b[?2004h> "]
[92.941035, "o", "            end_month = month_to_num(m.group(3))\r\n"]
[92.941047, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[92.941079, "o", "            # last day of end month\r\n\u001b[?2004l\r"]
[92.94109, "o", "\u001b[?2004h> "]
[92.94112, "o", "            if end_month == 12:\r\n\u001b[?2004l\r"]
[92.941134, "o", "\u001b[?2004h> "]
[92.941187, "o", "                end = datetime(int(m.group(4)), 12, 31).date()\r\n\u001b[?2004l\r"]
[92.9412, "o", "\u001b[?2004h> "]
[92.941213, "o", "            else:\r\n"]
[92.941223, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[92.941297, "o", "                end = (datetime(int(m.group(4)), end_month+1, 1) - timedelta(days=1)).date()\r\n\u001b[?2004l\r"]
[92.941309, "o", "\u001b[?2004h> "]
[92.941336, "o", "            busy.append((start, end))\r\n\u001b[?2004l\r"]
[92.941347, "o", "\u001b[?2004h> "]
[92.941363, "o", "            continue\r\n\u001b[?2004l\r"]
[92.941374, "o", "\u001b[?2004h"]
[92.941385, "o", "> "]
[92.941425, "o", "        # Day range within a month e.g., \"June 15-30, 2025\"\r\n\u001b[?2004l\r"]
[92.941438, "o", "\u001b[?2004h> "]
[92.941548, "o", "        m = re.search(r'(January|February|March|April|May|June|July|August|September|October|November|December)\\s+(\\d+)-(\\d+),\\s*(\\d{4})', line)\r\n\u001b[?2004l\r"]
[92.941563, "o", "\u001b[?2004h> "]
[92.941581, "o", "        if m:\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.941599, "o", "> "]
[92.941618, "o", "            month = month_to_num(m.group(1))\r\n\u001b[?2004l\r"]
[92.941628, "o", "\u001b[?2004h> "]
[92.941662, "o", "            year = int(m.group(4))\r\n\u001b[?2004l\r"]
[92.941673, "o", "\u001b[?2004h> "]
[92.94173, "o", "            start = datetime(year, month, int(m.group(2))).date()\r\n\u001b[?2004l\r"]
[92.941743, "o", "\u001b[?2004h> "]
[92.941792, "o", "            end   = datetime(year, month, int(m.group(3))).date()\r\n\u001b[?2004l\r"]
[92.941803, "o", "\u001b[?2004h> "]
[92.941833, "o", "            busy.append((start, end))\r\n\u001b[?2004l\r"]
[92.941843, "o", "\u001b[?2004h> "]
[92.941861, "o", "            continue\r\n\u001b[?2004l\r"]
[92.941871, "o", "\u001b[?2004h> "]
[92.941926, "o", "        # Single date range like \"July 26-27, 2025\" handled above\r\n\u001b[?2004l\r"]
[92.941951, "o", "\u001b[?2004h"]
[92.941962, "o", "> "]
[92.942014, "o", "        # Single full month range handled above\r\n\u001b[?2004l\r"]
[92.942021, "o", "\u001b[?2004h>         # Also handle \"August 4-31, 2025\"\r\n\u001b[?2004l\r"]
