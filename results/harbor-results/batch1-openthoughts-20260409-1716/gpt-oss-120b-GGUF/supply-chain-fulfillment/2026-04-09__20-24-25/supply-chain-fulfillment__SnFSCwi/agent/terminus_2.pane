[?2004hroot@7019c07b36ed:/app# cat > /app/task_file/scripts/assign_shipments_cost_balanced.py << 'PY'
[?2004l[?2004h> import json, sys
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> 
[?2004l[?2004h> input_dir = Path('/app/task_file/input_data')
[?2004l[?2004h> output_file = Path('/app/task_file/output_data/assignments.jsonl')
[?2004l[?2004h> 
[?2004l[?2004h> def load_jsonl(p):
[?2004l[?2004h>     with open(p) as f:
[?2004l[?2004h>         return [json.loads(line) for line in f if line.strip()]
[?2004l[?2004h> 
[?2004l[?2004h> shipments = load_jsonl(input_dir / 'shipments.jsonl')
[?2004l[?2004h> warehouses = {w['warehouse_id']: w for w in load_jsonl(input_dir / 'warehouses.jsonl')}
[?2004l[?2004h> routes = {}
[?2004l[?2004h> for r in load_jsonl(input_dir / 'routes.jsonl'):
[?2004l[?2004h>     routes[(r['warehouse_id'], r['destination_id'])] = {
[?2004l[?2004h>         'route_id': r['route_id'],
[?2004l[?2004h>         'distance_km': r['distance_km'],
[?2004l[?2004h>         'base_cost_per_km': r['base_cost_per_km'],
[?2004l[?2004h>         'transit_time_hours': r['transit_time_hours'],
[?2004l[?2004h>         'capacity_volume': r['capacity_volume'],
[?2004l[?2004h>         'capacity_weight': r['capacity_weight'],
[?2004l[?2004h>         'allows_hazmat': r['allows_hazmat'],
[?2004l[?2004h>         'allows_refrigerated': r['allows_refrigerated'],
[?2004l[?2004h>         'allows_oversized': r['allows_oversized'],
[?2004l[?2004h>         'used_volume': 0,
[?2004l[?2004h>         'used_weight': 0,
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> destinations = {d['destination_id']: d for d in load_jsonl(input_dir / 'destinations.jsonl')}
[?2004l[?2004h> 
[?2004l[?2004h> # Initialize usage counters
[?2004l[?2004h> for w in warehouses.values():
[?2004l[?2004h>     w['used_volume'] = 0
[?2004l[?2004h>     w['used_weight'] = 0
[?2004l[?2004h> 
[?2004l[?2004h> assignments = []
[?2004l[?2004h> 
[?2004l[?2004h> def capabilities_ok(shipment, wh, rt):
[?2004l[?2004h>     if shipment['requires_hazmat'] and not (wh['handles_hazmat'] and rt['allows_hazmat']):
[?2004l[?2004h>         return False
[?2004l[?2004h>     if shipment['requires_refrigerated'] and not (wh['handles_refrigerated'] and rt['allows_refrigerated']):
[?2004l[?2004h>         return False
[?2004l[?2004h>     if shipment['requires_oversized'] and not (wh['handles_oversized'] and rt['allows_oversized']):
[?2004l[?2004h>         return False
[?2004l[?2004h>     return True
[?2004l[?2004h> 
[?2004l[?2004h> MAX_UTILIZATION = 0.5  # do not exceed 50% of volume capacity to keep balance
[?2004l[?2004h> 
[?2004l[?2004h> for shipment in sorted(shipments, key=lambda s: s['shipment_id']):
[?2004l[?2004h>     dest_id = shipment['destination_id']
[?2004l[?2004h>     dest = destinations[dest_id]
[?2004l[?2004h>     feasible = []
[?2004l[?2004h>     for wid, wh in warehouses.items():
[?2004l[?2004h>         route_key = (wid, dest_id)
[?2004l[?2004h>         if route_key not in routes:
[?2004l[?2004h>             continue
[?2004l[?2004h>         rt = routes[route_key]
[?2004l[?2004h>         if not capabilities_ok(shipment, wh, rt):
[?2004l[?2004h>             continue
[?2004l[?2004h>         arrival = wh['availability_start'] + rt['transit_time_hours']
[?2004l[?2004h>         if arrival > shipment['deadline_hours']:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if arrival < dest['delivery_window_start'] or arrival > dest['delivery_window_end']:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if wh['used_volume'] + shipment['volume'] > wh['volume_capacity']:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if wh['used_weight'] + shipment['weight'] > wh['weight_capacity']:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if rt['used_volume'] + shipment['volume'] > rt['capacity_volume']:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if rt['used_weight'] + shipment['weight'] > rt['capacity_weight']:
[?2004l[?2004h>             continue
[?2004l[?2004h>         # cost metric (handling + route transport cost estimate)
[?2004l[?2004h>         cost_metric = wh['base_handling_cost'] + rt['base_cost_per_km'] * rt['distance_km']
[?2004l[?2004h>         utilization = (wh['used_volume'] + shipment['volume']) / wh['volume_capacity']
[?2004l[?2004h>         feasible.append((cost_metric, utilization, wid, wh, rt))
[?2004l[?2004h>     chosen = None
[?2004l[?2004h>     if feasible:
[?2004l[?2004h>         # Prefer those respecting max utilization first
[?2004l[?2004h>         under_util = [f for f in feasible if f[1] <= MAX_UTILIZATION]
[?2004l[?2004h>         candidates = under_util if under_util else feasible
[?2004l[?2004h>         # Select lowest cost metric
[?2004l[?2004h>         candidates.sort(key=lambda x: x[0])
[?2004l[?2004h>         _, _, chosen_wid, chosen_wh, chosen_rt = candidates[0]
[?2004l[?2004h>         chosen = (chosen_wid, chosen_wh, chosen_rt)
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Fallback to hub (warehouse 3)
[?2004l[?2004h>         hub_id = 3
[?2004l[?2004h>         if (hub_id, dest_id) not in routes:
[?2004l[?2004h>             sys.stderr.write(f"No route for hub for shipment {shipment['shipment_id']}\n")
[?2004l[?2004h>             sys.exit(1)
[?2004l[?2004h>         chosen_wid = hub_id
[?2004l[?2004h>         chosen_wh = warehouses[hub_id]
[?2004l[?2004h>         chosen_rt = routes[(hub_id, dest_id)]
[?2004l[?2004h>         chosen = (chosen_wid, chosen_wh, chosen_rt)
[?2004l[?2004h>     # Update usage
[?2004l[?2004h>     chosen_wid, chosen_wh, chosen_rt = chosen
[?2004l[?2004h>     chosen_wh['used_volume'] += shipment['volume']
[?2004l[?2004h>     chosen_wh['used_weight'] += shipment['weight']
[?2004l[?2004h>     chosen_rt['used_volume'] += shipment['volume']
[?2004l[?2004h>     chosen_rt['used_weight'] += shipment['weight']
[?2004l[?2004h>     assignments.append({
[?2004l[?2004h>         'shipment_id': shipment['shipment_id'],
[?2004l[?2004h>         'warehouse_id': chosen_wid,
[?2004l[?2004h>         'destination_id': dest_id
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> assignments.sort(key=lambda a: a['shipment_id'])
[?2004l[?2004h> output_file.parent.mkdir(parents=True, exist_ok=True)
