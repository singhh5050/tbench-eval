[124.096871, "o", ">             continue\r\n"]
[124.096891, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[124.096923, "o", "        # All checks passed – assign\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.096941, "o", "> "]
