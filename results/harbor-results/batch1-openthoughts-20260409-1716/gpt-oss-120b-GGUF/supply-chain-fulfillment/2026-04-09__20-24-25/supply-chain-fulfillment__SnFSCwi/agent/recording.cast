[124.096989, "o", "> "]
[124.097018, "o", "        wh['used_weight'] += shipment['weight']\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.09704, "o", "> "]
[124.097066, "o", "        rt['used_volume'] += shipment['volume']\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.097085, "o", "> "]
[124.097114, "o", "        rt['used_weight'] += shipment['weight']\r\n\u001b[?2004l\r"]
[124.097133, "o", "\u001b[?2004h> "]
