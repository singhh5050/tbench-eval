[210.51279, "o", "\u001b[?2004h> "]
[210.51291, "o", "    if shipment['requires_oversized'] and not (wh['handles_oversized'] and rt['allows_oversized']):\r\n\u001b[?2004l\r"]
[210.51293, "o", "\u001b[?2004h> "]
[210.512951, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.512973, "o", "    return True\r\n\u001b[?2004l\r"]
[210.512994, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.513058, "o", "# Process shipments in order of ID (could also prioritize by deadline or priority)\r\n\u001b[?2004l\r\u001b[?2004h"]
[210.513093, "o", "> "]
[210.513119, "o", "for shipment in sorted(shipments, key=lambda s: s['shipment_id']):\r\n\u001b[?2004l\r"]
[210.513129, "o", "\u001b[?2004h> "]
[210.513161, "o", "    dest_id = shipment['destination_id']\r\n\u001b[?2004l\r"]
[210.513171, "o", "\u001b[?2004h> "]
[210.513198, "o", "    dest = destinations[dest_id]\r\n\u001b[?2004l\r"]
[210.51322, "o", "\u001b[?2004h> "]
[210.51324, "o", "    feasible = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.513263, "o", "    for wid, wh in warehouses.items():\r\n\u001b[?2004l\r"]
[210.513272, "o", "\u001b[?2004h> "]
[210.513302, "o", "        route_key = (wid, dest_id)\r\n\u001b[?2004l\r"]
[210.513321, "o", "\u001b[?2004h> "]
[210.51334, "o", "        if route_key not in routes:\r\n\u001b[?2004l\r"]
[210.513351, "o", "\u001b[?2004h> "]
[210.513368, "o", "            continue\r\n\u001b[?2004l\r"]
[210.513398, "o", "\u001b[?2004h> "]
[210.513408, "o", "        rt = routes[route_key]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.513436, "o", "        # Capability check\r\n\u001b[?2004l\r\u001b[?2004h"]
[210.513444, "o", "> "]
[210.513484, "o", "        if not capabilities_ok(shipment, wh, rt):\r\n\u001b[?2004l\r"]
[210.513493, "o", "\u001b[?2004h> "]
[210.513511, "o", "            continue\r\n\u001b[?2004l\r"]
[210.513519, "o", "\u001b[?2004h> "]
[210.513554, "o", "        # Timing check\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.513606, "o", "        arrival = wh['availability_start'] + rt['transit_time_hours']\r\n\u001b[?2004l\r"]
[210.513615, "o", "\u001b[?2004h> "]
[210.513661, "o", "        if arrival > shipment['deadline_hours']:\r\n\u001b[?2004l\r"]
[210.51367, "o", "\u001b[?2004h> "]
[210.513696, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[210.513705, "o", "> "]
[210.513777, "o", "        if arrival < dest['delivery_window_start'] or arrival > dest['delivery_window_end']:\r\n\u001b[?2004l\r"]
[210.513789, "o", "\u001b[?2004h> "]
[210.513814, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.513844, "o", "        # Capacity checks\r\n\u001b[?2004l\r"]
[210.513859, "o", "\u001b[?2004h> "]
[210.513924, "o", "        if wh['used_volume'] + shipment['volume'] > wh['volume_capacity']:\r\n\u001b[?2004l\r"]
[210.513934, "o", "\u001b[?2004h> "]
[210.513956, "o", "            continue\r\n\u001b[?2004l\r"]
[210.513965, "o", "\u001b[?2004h> "]
[210.514025, "o", "        if wh['used_weight'] + shipment['weight'] > wh['weight_capacity']:\r\n\u001b[?2004l\r"]
[210.514035, "o", "\u001b[?2004h> "]
[210.514058, "o", "            continue\r\n\u001b[?2004l\r"]
[210.514075, "o", "\u001b[?2004h> "]
[210.514131, "o", "        if rt['used_volume'] + shipment['volume'] > rt['capacity_volume']:\r\n\u001b[?2004l\r"]
[210.51414, "o", "\u001b[?2004h> "]
[210.514164, "o", "            continue\r\n\u001b[?2004l\r"]
[210.514185, "o", "\u001b[?2004h> "]
[210.514232, "o", "        if rt['used_weight'] + shipment['weight'] > rt['capacity_weight']:\r\n\u001b[?2004l\r"]
[210.514241, "o", "\u001b[?2004h> "]
[210.514263, "o", "            continue\r\n\u001b[?2004l\r"]
[210.514274, "o", "\u001b[?2004h> "]
[210.514334, "o", "        # Compute current utilization ratio for balancing (volume based)\r\n\u001b[?2004l\r"]
[210.514344, "o", "\u001b[?2004h> "]
[210.514426, "o", "        utilization = wh['used_volume'] / wh['volume_capacity'] if wh['volume_capacity'] > 0 else 0\r\n\u001b[?2004l\r"]
[210.514446, "o", "\u001b[?2004h> "]
[210.514477, "o", "        feasible.append((utilization, wid, wh, rt))\r\n\u001b[?2004l\r"]
[210.514487, "o", "\u001b[?2004h> "]
[210.51451, "o", "    if feasible:\r\n\u001b[?2004l\r"]
[210.51452, "o", "\u001b[?2004h> "]
[210.514566, "o", "        # Choose warehouse with lowest utilization\r\n\u001b[?2004l\r"]
[210.514575, "o", "\u001b[?2004h> "]
[210.514614, "o", "        feasible.sort(key=lambda x: x[0])\r\n\u001b[?2004l\r"]
[210.514626, "o", "\u001b[?2004h> "]
[210.514674, "o", "        _, chosen_wid, chosen_wh, chosen_rt = feasible[0]\r\n\u001b[?2004l\r"]
[210.514684, "o", "\u001b[?2004h> "]
[210.514693, "o", "    else:\r\n\u001b[?2004l\r"]
[210.514725, "o", "\u001b[?2004h> "]
[210.514759, "o", "        # Fallback to hub (warehouse 3) – assume route exists\r\n\u001b[?2004l\r"]
[210.514769, "o", "\u001b[?2004h> "]
[210.514792, "o", "        chosen_wid = 3\r\n\u001b[?2004l\r"]
[210.514802, "o", "\u001b[?2004h> "]
[210.514845, "o", "        if (chosen_wid, dest_id) not in routes:\r\n\u001b[?2004l\r"]
[210.514857, "o", "\u001b[?2004h> "]
[210.514938, "o", "            sys.stderr.write(f\"No route for fallback hub for shipment {shipment['shipment_id']}\\n\")\r\n\u001b[?2004l\r"]
[210.514955, "o", "\u001b[?2004h> "]
[210.514975, "o", "            sys.exit(1)\r\n\u001b[?2004l\r"]
[210.51499, "o", "\u001b[?2004h> "]
[210.515024, "o", "        chosen_wh = warehouses[chosen_wid]\r\n\u001b[?2004l\r"]
[210.515034, "o", "\u001b[?2004h> "]
[210.515073, "o", "        chosen_rt = routes[(chosen_wid, dest_id)]\r\n\u001b[?2004l\r"]
[210.515082, "o", "\u001b[?2004h> "]
[210.515148, "o", "        # No further checks; we trust capacities are sufficient for fallback\r\n\u001b[?2004l\r"]
[210.515168, "o", "\u001b[?2004h> "]
[210.515178, "o", "    # Update usage\r\n\u001b[?2004l\r\u001b[?2004h"]
[210.515202, "o", "> "]
[210.51523, "o", "    chosen_wh['used_volume'] += shipment['volume']\r\n\u001b[?2004l\r"]
[210.51524, "o", "\u001b[?2004h> "]
[210.515285, "o", "    chosen_wh['used_weight'] += shipment['weight']\r\n\u001b[?2004l\r"]
[210.515306, "o", "\u001b[?2004h> "]
[210.515336, "o", "    chosen_rt['used_volume'] += shipment['volume']\r\n\u001b[?2004l\r"]
[210.515346, "o", "\u001b[?2004h> "]
[210.515392, "o", "    chosen_rt['used_weight'] += shipment['weight']\r\n\u001b[?2004l\r"]
[210.515402, "o", "\u001b[?2004h> "]
[210.515427, "o", "    assignments.append({\r\n\u001b[?2004l\r"]
[210.515443, "o", "\u001b[?2004h> "]
[210.515476, "o", "        'shipment_id': shipment['shipment_id'],\r\n\u001b[?2004l\r"]
[210.515486, "o", "\u001b[?2004h> "]
[210.515519, "o", "        'warehouse_id': chosen_wid,\r\n\u001b[?2004l\r"]
[210.515529, "o", "\u001b[?2004h> "]
[210.515561, "o", "        'destination_id': dest_id\r\n\u001b[?2004l\r"]
[210.51557, "o", "\u001b[?2004h> "]
[210.515579, "o", "    })\r\n\u001b[?2004l\r"]
[210.515587, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[210.5156, "o", "\u001b[?2004h"]
[210.515611, "o", "> "]
[210.515646, "o", "# Sort assignments by shipment_id before writing\r\n\u001b[?2004l\r"]
[210.515665, "o", "\u001b[?2004h> "]
[210.515699, "o", "assignments.sort(key=lambda a: a['shipment_id'])\r\n\u001b[?2004l\r"]
[210.515711, "o", "\u001b[?2004h> "]
[210.515752, "o", "output_file.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[210.515762, "o", "\u001b[?2004h> "]
[210.515796, "o", "with open(output_file, 'w') as f:\r\n\u001b[?2004l\r"]
[210.515806, "o", "\u001b[?2004h> "]
[210.515832, "o", "    for a in assignments:\r\n\u001b[?2004l\r"]
[210.515841, "o", "\u001b[?2004h> "]
[210.515881, "o", "        f.write(json.dumps(a) + '\\n')\r\n\u001b[?2004l\r"]
[210.515891, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[210.515899, "o", "\u001b[?2004h> "]
[210.515947, "o", "print(f\"Assignments written: {len(assignments)}\")\r\n\u001b[?2004l\r"]
