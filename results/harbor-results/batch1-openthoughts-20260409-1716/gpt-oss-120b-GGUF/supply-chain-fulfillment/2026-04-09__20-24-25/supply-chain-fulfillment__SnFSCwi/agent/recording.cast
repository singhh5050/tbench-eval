[124.096197, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.096217, "o", "> "]
[124.096236, "o", "        # Timing check\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.096291, "o", "        arrival = wh['availability_start'] + rt['transit_time_hours']\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.096311, "o", "> "]
[124.09634, "o", "        if arrival > shipment['deadline_hours']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.09636, "o", ">             continue\r\n\u001b[?2004l\r"]
[124.096379, "o", "\u001b[?2004h> "]
