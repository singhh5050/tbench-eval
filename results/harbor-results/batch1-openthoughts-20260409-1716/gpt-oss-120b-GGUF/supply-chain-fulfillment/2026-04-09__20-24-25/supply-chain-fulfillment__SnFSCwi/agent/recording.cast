[124.097306, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[124.097326, "o", "\u001b[?2004h>         assigned = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.097345, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.097366, "o", ">     if not assigned:\r\n"]
[124.097387, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[124.097456, "o", "        # Fallback to hub (warehouse 3) – assume route exists and capacities are sufficient\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.097481, "o", "        hub_id = 3\r\n\u001b[?2004l\r"]
[124.0975, "o", "\u001b[?2004h> "]
[124.097522, "o", "        if (hub_id, dest_id) in routes:\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.09754, "o", "> "]
[124.09756, "o", "            wh = warehouses[hub_id]\r\n\u001b[?2004l\r"]
[124.097579, "o", "\u001b[?2004h> "]
[124.097603, "o", "            rt = routes[(hub_id, dest_id)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.097622, "o", "> "]
[124.097666, "o", "            # Basic checks (skip capability because hub handles all)\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.097685, "o", "> "]
[124.097715, "o", "            wh['used_volume'] += shipment['volume']\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.097734, "o", "> "]
[124.097766, "o", "            wh['used_weight'] += shipment['weight']\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.097785, "o", "> "]
[124.09782, "o", "            rt['used_volume'] += shipment['volume']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.097868, "o", "            rt['used_weight'] += shipment['weight']\r\n\u001b[?2004l\r"]
[124.097889, "o", "\u001b[?2004h> "]
[124.097908, "o", "            assignments.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.097961, "o", "                'shipment_id': shipment['shipment_id'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.097981, "o", "> "]
[124.098003, "o", "                'warehouse_id': hub_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.098022, "o", "> "]
[124.098045, "o", "                'destination_id': dest_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.098066, "o", ">             })\r\n\u001b[?2004l\r"]
[124.098086, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[124.098105, "o", "\u001b[?2004h> "]
[124.098173, "o", "            sys.stderr.write(f\"No feasible assignment for shipment {shipment['shipment_id']}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.098193, "o", "> "]
[124.098213, "o", "            sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
