[216.012585, "o", "ls -l /app/task_file/output_data\r\n\u001b[?2004l\r"]
[216.013865, "o", "total 64\r\n"]
[216.013905, "o", "-rw-r--r-- 1 root root 62416 Apr 10 02:28 assignments.jsonl\r\n"]
[216.014216, "o", "\u001b[?2004hroot@7019c07b36ed:/app# "]
[216.119365, "i", "head -n 5 /app/task_file/output_data/assignments.jsonl\n"]
[216.119604, "o", "head -n 5 /app/task_file/output_data/assignments.jsonl\r\n\u001b[?2004l\r"]
[216.120436, "o", "{\"shipment_id\": 1, \"warehouse_id\": 13, \"destination_id\": 46}\r\n{\"shipment_id\": 2, \"warehouse_id\": 14, \"destination_id\": 56}\r\n{\"shipment_id\": 3, \"warehouse_id\": 17, \"destination_id\": 58}\r\n{\"shipment_id\": 4, \"warehouse_id\": 18, \"destination_id\": 57}\r\n{\"shipment_id\": 5, \"warehouse_id\": 6, \"destination_id\": 50}\r\n"]
[216.120615, "o", "\u001b[?2004hroot@7019c07b36ed:/app# "]
[216.20854, "i", "python3 /app/task_file/scripts/model.py /app/task_file/input_data /app/task_file/output_data/assignments.jsonl\n"]
[216.208824, "o", "python3 /app/task_file/scripts/model.py /app/task_file/input_data /app/task_file/output_data/assignments.jsonl\r\n\u001b[?2004l\r"]
[216.263191, "o", "{\r\n  \"is_valid\": true,\r\n  \"cost_score\": 0.6546,\r\n  \"on_time_delivery_score\": 1.0,\r\n  \"warehouse_balance_score\": 1.0,\r\n  \"route_clustering_score\": 0.4812,\r\n  \"hub_utilization_score\": 1.0,\r\n  \"network_fragmentation_score\": 0.0,\r\n  \"multi_hop_penalty_score\": 1.0,\r\n  \"priority_fairness_score\": 0.3333,\r\n  \"destination_consolidation_score\": 0.5,\r\n  \"total_score\": 0.6276\r\n}\r\n"]
[216.268034, "o", "\u001b[?2004hroot@7019c07b36ed:/app# "]
[298.918543, "i", "cat > /app/task_file/scripts/assign_shipments_cost_balanced.py << 'PY'\nimport json, sys\nfrom pathlib import Path\n\ninput_dir = Path('/app/task_file/input_data')\noutput_file = Path('/app/task_file/output_data/assignments.jsonl')\n\ndef load_jsonl(p):\n    with open(p) as f:\n        return [json.loads(line) for line in f if line.strip()]\n\nshipments = load_jsonl(input_dir / 'shipments.jsonl')\nwarehouses = {w['warehouse_id']: w for w in load_jsonl(input_dir / 'warehouses.jsonl')}\nroutes = {}\nfor r in load_jsonl(input_dir / 'routes.jsonl'):\n    routes[(r['warehouse_id'], r['destination_id'])] = {\n        'route_id': r['route_id'],\n        'distance_km': r['distance_km'],\n        'base_cost_per_km': r['base_cost_per_km'],\n        'transit_time_hours': r['transit_time_hours'],\n        'capacity_volume': r['capacity_volume'],\n        'capacity_weight': r['capacity_weight'],\n        'allows_hazmat': r['allows_hazmat'],\n        'allows_refrigerated': r['allows_refrigerated'],\n        'allows_oversized': r['allows_oversized'],\n        'used_volume': 0,\n        'used_weight': 0,\n    }\n\ndestinations = {d['destination_id']: d for d in load_jsonl(input_dir / 'destinations.jsonl')}\n\n# Initialize usage counters\nfor w in warehouses.values():\n    w['used_volume'] = 0\n    w['used_weight'] = 0\n\nassignments = []\n\ndef capabilities_ok(shipment, wh, rt):\n    if shipment['requires_hazmat'] and not (wh['handles_hazmat'] and rt['allows_hazmat']):\n        return False\n    if shipment['requires_refrigerated'] and not (wh['handles_refrigerated'] and rt['allows_refrigerated']):\n        return False\n    if shipment['requires_oversized'] and not (wh['handles_oversized'] and rt['allows_oversized']):\n        return False\n    return True\n\nMAX_UTILIZATION = 0.5  # do not exceed 50% of volume capacity to keep balance\n\nfor shipment in sorted(shipments, key=lambda s: s['shipment_id']):\n    dest_id = shipment['destination_id']\n    dest = destinations[dest_id]\n    feasible = []\n    for wid, wh in warehouses.items():\n        route_key = (wid, dest_id)\n        if route_key not in routes:\n            continue\n        rt = routes[route_key]\n        if not capabilities_ok(shipment, wh, rt):\n            continue\n        arrival = wh['availability_start'] + rt['transit_time_hours']\n        if arrival > shipment['deadline_hours']:\n            continue\n        if arrival < dest['delivery_window_start'] or arrival > dest['delivery_window_end']:\n            continue\n        if wh['used_volume'] + shipment['volume'] > wh['volume_capacity']:\n            continue\n        if wh['used_weight'] + shipment['weight'] > wh['weight_capacity']:\n            continue\n        if rt['used_volume'] + shipment['volume'] > rt['capacity_volume']:\n            continue\n        if rt['used_weight'] + shipment['weight'] > rt['capacity_weight']:\n            continue\n        # cost metric (handling + route transport cost estimate)\n        cost_metric = wh['base_handling_cost'] + rt['base_cost_per_km'] * rt['distance_km']\n        utilization = (wh['used_volume'] + shipment['volume']) / wh['volume_capacity']\n        feasible.append((cost_metric, utilization, wid, wh, rt))\n    chosen = None\n    if feasible:\n        # Prefer those respecting max utilization first\n        under_util = [f for f in feasible if f[1] <= MAX_UTILIZATION]\n        candidates = under_util if under_util else feasible\n        # Select lowest cost metric\n        candidates.sort(key=lambda x: x[0])\n        _, _, chosen_wid, chosen_wh, chosen_rt = candidates[0]\n        chosen = (chosen_wid, chosen_wh, chosen_rt)\n    else:\n        # Fallback to hub (warehouse 3)\n        hub_id = 3\n        if (hub_id, dest_id) not in routes:\n            sys.stderr.write(f\"No route for hub for shipment {shipment['shipment_id']}\\n\")\n            sys.exit(1)\n        chosen_wid = hub_id\n        chosen_wh = warehouses[hub_id]\n        chosen_rt = routes[(hub_id, dest_id)]\n        chosen = (chosen_wid, chosen_wh, chosen_rt)\n    # Update usage\n    chosen_wid, chosen_wh, chosen_rt = chosen\n    chosen_wh['used_volume'] += shipment['volume']\n    chosen_wh['used_weig"]
[298.918739, "i", "ht'] += shipment['weight']\n    chosen_rt['used_volume'] += shipment['volume']\n    chosen_rt['used_weight'] += shipment['weight']\n    assignments.append({\n        'shipment_id': shipment['shipment_id'],\n        'warehouse_id': chosen_wid,\n        'destination_id': dest_id\n    })\n\nassignments.sort(key=lambda a: a['shipment_id'])\noutput_file.parent.mkdir(parents=True, exist_ok=True)\nwith open(output_file, 'w') as f:\n    for a in assignments:\n        f.write(json.dumps(a) + '\\n')\nprint(f\"Assignments written: {len(assignments)}\")\nPY\n"]
