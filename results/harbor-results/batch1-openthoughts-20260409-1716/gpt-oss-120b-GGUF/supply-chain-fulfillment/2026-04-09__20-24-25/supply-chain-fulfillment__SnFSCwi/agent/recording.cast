[298.920441, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.920471, "o", "# Initialize usage counters\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.920491, "o", "> "]
[298.920512, "o", "for w in warehouses.values():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.920542, "o", "    w['used_volume'] = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.920572, "o", "    w['used_weight'] = 0\r\n\u001b[?2004l\r"]
[298.920592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.920613, "o", "assignments = []\r\n\u001b[?2004l\r"]
[298.920633, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.92075, "o", "def capabilities_ok(shipment, wh, rt):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.920814, "o", "    if shipment['requires_hazmat'] and not (wh['handles_hazmat'] and rt['allows_hazmat']):\r\n\u001b[?2004l\r\u001b[?2004h>         return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.920892, "o", "    if shipment['requires_refrigerated'] and not (wh['handles_refrigerated'] and rt['allows_refrigerated']):\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.920912, "o", ">         return False\r\n\u001b[?2004l\r"]
[298.920928, "o", "\u001b[?2004h> "]
[298.921005, "o", "    if shipment['requires_oversized'] and not (wh['handles_oversized'] and rt['allows_oversized']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.921034, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.921068, "o", "    return True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.921133, "o", "MAX_UTILIZATION = 0.5  # do not exceed 50% of volume capacity to keep balance\r\n\u001b[?2004l\r"]
[298.92115, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[298.921189, "o", "> "]
[298.921222, "o", "for shipment in sorted(shipments, key=lambda s: s['shipment_id']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.92126, "o", "    dest_id = shipment['destination_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.921294, "o", "    dest = destinations[dest_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.921325, "o", ">     feasible = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.921359, "o", "    for wid, wh in warehouses.items():\r\n\u001b[?2004l\r"]
[298.921376, "o", "\u001b[?2004h> "]
[298.921423, "o", "        route_key = (wid, dest_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.921442, "o", "        if route_key not in routes:\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.921481, "o", "> "]
[298.921519, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         rt = routes[route_key]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.921553, "o", "        if not capabilities_ok(shipment, wh, rt):\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.921569, "o", "> "]
[298.92163, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.921666, "o", "        arrival = wh['availability_start'] + rt['transit_time_hours']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.9217, "o", "        if arrival > shipment['deadline_hours']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.921733, "o", ">             continue\r\n\u001b[?2004l\r"]
[298.921753, "o", "\u001b[?2004h> "]
[298.921824, "o", "        if arrival < dest['delivery_window_start'] or arrival > dest['delivery_window_end']:\r\n\u001b[?2004l\r"]
[298.921841, "o", "\u001b[?2004h> "]
[298.921883, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.921985, "o", "> "]
[298.922007, "o", "        if wh['used_volume'] + shipment['volume'] > wh['volume_capacity']:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.922029, "o", "        if wh['used_weight'] + shipment['weight'] > wh['weight_capacity']:\r\n\u001b[?2004l\r"]
[298.922055, "o", "\u001b[?2004h> "]
[298.922074, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.92213, "o", "        if rt['used_volume'] + shipment['volume'] > rt['capacity_volume']:\r\n\u001b[?2004l\r"]
[298.92215, "o", "\u001b[?2004h> "]
[298.922168, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.92223, "o", "        if rt['used_weight'] + shipment['weight'] > rt['capacity_weight']:\r\n\u001b[?2004l\r"]
[298.922252, "o", "\u001b[?2004h>             continue\r\n"]
[298.922271, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[298.922315, "o", "        # cost metric (handling + route transport cost estimate)\r\n\u001b[?2004l\r"]
[298.922364, "o", "\u001b[?2004h> "]
[298.922395, "o", "        cost_metric = wh['base_handling_cost'] + rt['base_cost_per_km'] * rt['distance_km']\r\n\u001b[?2004l\r"]
[298.922416, "o", "\u001b[?2004h> "]
[298.92247, "o", "        utilization = (wh['used_volume'] + shipment['volume']) / wh['volume_capacity']\r\n\u001b[?2004l\r"]
[298.922489, "o", "\u001b[?2004h> "]
[298.922558, "o", "        feasible.append((cost_metric, utilization, wid, wh, rt))\r\n\u001b[?2004l\r"]
[298.922578, "o", "\u001b[?2004h> "]
[298.922597, "o", "    chosen = None\r\n\u001b[?2004l\r"]
[298.922617, "o", "\u001b[?2004h> "]
[298.922635, "o", "    if feasible:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.922674, "o", "        # Prefer those respecting max utilization first\r\n\u001b[?2004l\r"]
[298.922695, "o", "\u001b[?2004h> "]
[298.922741, "o", "        under_util = [f for f in feasible if f[1] <= MAX_UTILIZATION]\r\n\u001b[?2004l\r"]
[298.922759, "o", "\u001b[?2004h> "]
[298.922796, "o", "        candidates = under_util if under_util else feasible\r\n\u001b[?2004l\r"]
[298.922818, "o", "\u001b[?2004h> "]
[298.922838, "o", "        # Select lowest cost metric\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.922889, "o", "        candidates.sort(key=lambda x: x[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.922941, "o", "        _, _, chosen_wid, chosen_wh, chosen_rt = candidates[0]\r\n\u001b[?2004l\r"]
[298.922961, "o", "\u001b[?2004h> "]
[298.92299, "o", "        chosen = (chosen_wid, chosen_wh, chosen_rt)\r\n\u001b[?2004l\r"]
[298.923008, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.923026, "o", "> "]
[298.923046, "o", "        # Fallback to hub (warehouse 3)\r\n\u001b[?2004l\r"]
[298.923067, "o", "\u001b[?2004h>         hub_id = 3\r\n\u001b[?2004l\r"]
[298.923085, "o", "\u001b[?2004h> "]
[298.923114, "o", "        if (hub_id, dest_id) not in routes:\r\n\u001b[?2004l\r"]
[298.923134, "o", "\u001b[?2004h> "]
[298.923194, "o", "            sys.stderr.write(f\"No route for hub for shipment {shipment['shipment_id']}\\n\")\r\n\u001b[?2004l\r"]
[298.923213, "o", "\u001b[?2004h> "]
[298.923234, "o", "            sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.923253, "o", "        chosen_wid = hub_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.923272, "o", "> "]
[298.923291, "o", "        chosen_wh = warehouses[hub_id]\r\n\u001b[?2004l\r"]
[298.923309, "o", "\u001b[?2004h> "]
[298.923337, "o", "        chosen_rt = routes[(hub_id, dest_id)]\r\n\u001b[?2004l\r"]
[298.923356, "o", "\u001b[?2004h> "]
[298.923384, "o", "        chosen = (chosen_wid, chosen_wh, chosen_rt)\r\n\u001b[?2004l\r"]
[298.923404, "o", "\u001b[?2004h> "]
[298.923418, "o", "    # Update usage\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.923456, "o", "    chosen_wid, chosen_wh, chosen_rt = chosen\r\n\u001b[?2004l\r"]
[298.923474, "o", "\u001b[?2004h> "]
[298.923505, "o", "    chosen_wh['used_volume'] += shipment['volume']\r\n\u001b[?2004l\r"]
[298.923523, "o", "\u001b[?2004h> "]
[298.923555, "o", "    chosen_wh['used_weight'] += shipment['weight']\r\n\u001b[?2004l\r"]
[298.923572, "o", "\u001b[?2004h> "]
[298.923608, "o", "    chosen_rt['used_volume'] += shipment['volume']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.923651, "o", "    chosen_rt['used_weight'] += shipment['weight']\r\n\u001b[?2004l\r"]
[298.923669, "o", "\u001b[?2004h> "]
[298.923687, "o", "    assignments.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.923726, "o", "        'shipment_id': shipment['shipment_id'],\r\n\u001b[?2004l\r"]
[298.923744, "o", "\u001b[?2004h> "]
[298.923763, "o", "        'warehouse_id': chosen_wid,\r\n\u001b[?2004l\r"]
[298.923782, "o", "\u001b[?2004h> "]
[298.923797, "o", "        'destination_id': dest_id\r\n\u001b[?2004l\r"]
[298.923814, "o", "\u001b[?2004h>     })\r\n"]
[298.923831, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.923871, "o", "assignments.sort(key=lambda a: a['shipment_id'])\r\n\u001b[?2004l\r"]
[298.92389, "o", "\u001b[?2004h> "]
[298.923923, "o", "output_file.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[298.923942, "o", "\u001b[?2004h> "]
[298.923959, "o", "with open(output_file, 'w') as f:\r\n\u001b[?2004l\r"]
[298.92398, "o", "\u001b[?2004h> "]
[298.923998, "o", "    for a in assignments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.924033, "o", "        f.write(json.dumps(a) + '\\n')\r\n\u001b[?2004l\r"]
[298.924051, "o", "\u001b[?2004h> "]
[298.924082, "o", "print(f\"Assignments written: {len(assignments)}\")\r\n\u001b[?2004l\r"]
[298.9241, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[298.925151, "o", "\u001b[?2004hroot@7019c07b36ed:/app# "]
[299.420166, "i", "python3 /app/task_file/scripts/assign_shipments_cost_balanced.py\n"]
[299.420403, "o", "python3 /app/task_file/scripts/assign_shipments_cost_balanced.py\r\n"]
[299.420528, "o", "\u001b[?2004l\r"]
[299.462698, "o", "Assignments written: 1000\r\n"]
[299.466528, "o", "\u001b[?2004hroot@7019c07b36ed:/app# "]
[304.422339, "i", "head -n 5 /app/task_file/output_data/assignments.jsonl\n"]
[304.422784, "o", "head -n 5 /app/task_file/output_data/assignments.jsonl\r\n\u001b[?2004l\r"]
[304.423799, "o", "{\"shipment_id\": 1, \"warehouse_id\": 18, \"destination_id\": 46}\r\n{\"shipment_id\": 2, \"warehouse_id\": 18, \"destination_id\": 56}\r\n{\"shipment_id\": 3, \"warehouse_id\": 22, \"destination_id\": 58}\r\n{\"shipment_id\": 4, \"warehouse_id\": 22, \"destination_id\": 57}\r\n{\"shipment_id\": 5, \"warehouse_id\": 17, \"destination_id\": 50}\r\n"]
[304.423979, "o", "\u001b[?2004hroot@7019c07b36ed:/app# "]
[304.521292, "i", "python3 /app/task_file/scripts/model.py /app/task_file/input_data /app/task_file/output_data/assignments.jsonl\n"]
[304.521641, "o", "python3 /app/task_file/scripts/model.py /app/task_file/input_data /app/task_file/output_data/assignments.jsonl\r\n\u001b[?2004l\r"]
[304.5722, "o", "{\r\n  \"is_valid\": true,\r\n  \"cost_score\": 1.0,\r\n  \"on_time_delivery_score\": 1.0,\r\n  \"warehouse_balance_score\": 0.7562,\r\n  \"route_clustering_score\": 0.9871,\r\n  \"hub_utilization_score\": 1.0,\r\n  \"network_fragmentation_score\": 0.4267,\r\n  \"multi_hop_penalty_score\": 1.0,\r\n  \"priority_fairness_score\": 0.6667,\r\n  \"destination_consolidation_score\": 0.5,\r\n  \"total_score\": 0.7751\r\n}\r\n"]
[304.576726, "o", "\u001b[?2004hroot@7019c07b36ed:/app# "]
