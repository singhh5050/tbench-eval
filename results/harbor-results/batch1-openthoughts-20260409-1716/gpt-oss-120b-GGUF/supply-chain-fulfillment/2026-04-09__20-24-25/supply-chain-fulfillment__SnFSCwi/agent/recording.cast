[124.096466, "o", "> "]
[124.096485, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.096504, "o", "        # Capacity checks\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.096523, "o", "> "]
[124.096572, "o", "        if wh['used_volume'] + shipment['volume'] > wh['volume_capacity']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.096591, "o", ">             continue\r\n\u001b[?2004l\r"]
[124.096614, "o", "\u001b[?2004h> "]
[124.096662, "o", "        if wh['used_weight'] + shipment['weight'] > wh['weight_capacity']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.096683, "o", ">             continue\r\n"]
[124.096701, "o", "\u001b[?2004l\r\u001b[?2004h> "]
