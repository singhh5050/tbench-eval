[124.092869, "i", "cat > /app/task_file/scripts/assign_shipments.py << 'PY'\nimport json, os, sys\nfrom pathlib import Path\n\ninput_dir = Path('/app/task_file/input_data')\noutput_file = Path('/app/task_file/output_data/assignments.jsonl')\n\n# Load data\ndef load_jsonl(path):\n    with open(path) as f:\n        return [json.loads(line) for line in f if line.strip()]\n\nshipments = load_jsonl(input_dir / 'shipments.jsonl')\nwarehouses = {w['warehouse_id']: w for w in load_jsonl(input_dir / 'warehouses.jsonl')}\nroutes = {}\nfor r in load_jsonl(input_dir / 'routes.jsonl'):\n    routes[(r['warehouse_id'], r['destination_id'])] = {\n        'route_id': r['route_id'],\n        'distance_km': r['distance_km'],\n        'base_cost_per_km': r['base_cost_per_km'],\n        'transit_time_hours': r['transit_time_hours'],\n        'capacity_volume': r['capacity_volume'],\n        'capacity_weight': r['capacity_weight'],\n        'allows_hazmat': r['allows_hazmat'],\n        'allows_refrigerated': r['allows_refrigerated'],\n        'allows_oversized': r['allows_oversized'],\n        'used_volume': 0,\n        'used_weight': 0,\n    }\n\ndestinations = {d['destination_id']: d for d in load_jsonl(input_dir / 'destinations.jsonl')}\n\n# Track remaining capacities for warehouses\nfor w in warehouses.values():\n    w['used_volume'] = 0\n    w['used_weight'] = 0\n\nassignments = []\n\n# Helper to check capability compatibility\ndef capabilities_ok(shipment, warehouse, route):\n    if shipment['requires_hazmat'] and not (warehouse['handles_hazmat'] and route['allows_hazmat']):\n        return False\n    if shipment['requires_refrigerated'] and not (warehouse['handles_refrigerated'] and route['allows_refrigerated']):\n        return False\n    if shipment['requires_oversized'] and not (warehouse['handles_oversized'] and route['allows_oversized']):\n        return False\n    return True\n\n# Sort warehouses by handling cost (cheapest first)\nwarehouse_order = sorted(warehouses.keys(), key=lambda wid: warehouses[wid]['base_handling_cost'])\n\nfor shipment in sorted(shipments, key=lambda s: s['shipment_id']):\n    dest_id = shipment['destination_id']\n    dest = destinations[dest_id]\n    assigned = False\n    for wid in warehouse_order:\n        wh = warehouses[wid]\n        route_key = (wid, dest_id)\n        if route_key not in routes:\n            continue\n        rt = routes[route_key]\n        # Capability check\n        if not capabilities_ok(shipment, wh, rt):\n            continue\n        # Timing check\n        arrival = wh['availability_start'] + rt['transit_time_hours']\n        if arrival > shipment['deadline_hours']:\n            continue\n        if arrival < dest['delivery_window_start'] or arrival > dest['delivery_window_end']:\n            continue\n        # Capacity checks\n        if wh['used_volume'] + shipment['volume'] > wh['volume_capacity']:\n            continue\n        if wh['used_weight'] + shipment['weight'] > wh['weight_capacity']:\n            continue\n        if rt['used_volume'] + shipment['volume'] > rt['capacity_volume']:\n            continue\n        if rt['used_weight'] + shipment['weight'] > rt['capacity_weight']:\n            continue\n        # All checks passed – assign\n        wh['used_volume'] += shipment['volume']\n        wh['used_weight'] += shipment['weight']\n        rt['used_volume'] += shipment['volume']\n        rt['used_weight'] += shipment['weight']\n        assignments.append({\n            'shipment_id': shipment['shipment_id'],\n            'warehouse_id': wid,\n            'destination_id': dest_id\n        })\n        assigned = True\n        break\n    if not assigned:\n        # Fallback to hub (warehouse 3) – assume route exists and capacities are sufficient\n        hub_id = 3\n        if (hub_id, dest_id) in routes:\n            wh = warehouses[hub_id]\n            rt = routes[(hub_id, dest_id)]\n            # Basic checks (skip capability because hub handles all)\n            wh['used_volume'] += shipment['volume']\n            wh['used_weight'] += shipment['weight']\n            rt['used_volume'] += shipment['volume']\n            rt['used_weight'] += shipment['weight']\n            ass"]
[124.093016, "i", "ignments.append({\n                'shipment_id': shipment['shipment_id'],\n                'warehouse_id': hub_id,\n                'destination_id': dest_id\n            })\n        else:\n            sys.stderr.write(f\"No feasible assignment for shipment {shipment['shipment_id']}\\n\")\n            sys.exit(1)\n\n# Ensure assignments are sorted by shipment_id\nassignments.sort(key=lambda a: a['shipment_id'])\n\noutput_file.parent.mkdir(parents=True, exist_ok=True)\nwith open(output_file, 'w') as f:\n    for a in assignments:\n        f.write(json.dumps(a) + '\\n')\n\nprint(f\"Assignments written: {len(assignments)}\")\nPY\n"]
[124.093222, "o", "cat > /app/task_file/scripts/assign_shipments.py << 'PY'\r\n"]
