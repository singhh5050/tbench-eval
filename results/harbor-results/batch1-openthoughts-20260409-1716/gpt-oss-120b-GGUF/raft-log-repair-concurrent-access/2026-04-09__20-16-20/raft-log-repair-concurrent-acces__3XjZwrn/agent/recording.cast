[169.41236, "i", "appends_per_index.items():\n        if app_list:\n            winning_term[idx] = max(a['term'] for a in app_list)\n    # ---------- Validate COMMIT entries ----------\n    for idx, commit_list in commits_per_index.items():\n        if idx not in appends_per_index or not appends_per_index[idx]:\n            # no prior APPEND at this index\n            for _ in commit_list:\n                bad[idx].add('BAD_COMMIT_ORDER')\n            continue\n        win_term = winning_term.get(idx)\n        for c in commit_list:\n            if c['term'] != win_term:\n                bad[idx].add('BAD_COMMIT_ORDER')\n    # ---------- Log matching property ----------\n    committed_indices = sorted([i for i, t in winning_term.items() if i in commits_per_index and not bad[i].intersection({'BAD_COMMIT_ORDER'})])\n    for i in committed_indices:\n        committed_term = winning_term[i]\n        nxt = i + 1\n        if nxt in min_term_per_index:\n            if min_term_per_index[nxt] < committed_term:\n                bad[nxt].add('BAD_LOG_MATCH'"]
