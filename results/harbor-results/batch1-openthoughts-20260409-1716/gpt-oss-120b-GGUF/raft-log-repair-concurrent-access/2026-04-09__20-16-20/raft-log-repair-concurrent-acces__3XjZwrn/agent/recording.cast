[169.411846, "i", "cat > /app/solution.py <<'PY'\nimport re\nfrom collections import defaultdict\n\ndef solve(lines: list[str]) -> str:\n    # ---------- Helpers ----------\n    node_pat = re.compile(r'^n[0-9]+$')\n    allowed_ops = {'VOTE', 'APPEND', 'COMMIT', 'LEADER'}\n\n    # ---------- Parsing ----------\n    entries = []  # list of dicts preserving file order\n    seen = set()  # exact duplicate detection\n    for raw in lines:\n        line = raw.strip()\n        if not line or line.startswith('#'):\n            continue\n        parts = line.split()\n        # basic field count validation\n        if len(parts) not in (4, 5):\n            break  # malformed -> hard cutoff\n        term_s, index_s, node, op = parts[0], parts[1], parts[2], parts[3]\n        data = parts[4] if len(parts) == 5 else None\n        # op‑specific field count check\n        if op == 'APPEND' and data is None:\n            break\n        if op != 'APPEND' and data is not None:\n            break\n        # numeric checks\n        if not term_s.isdigit() or int(term_s) < 0"]
[169.412109, "o", "cat > /app/solution.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> from collections import defaultdict\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.412196, "i", ":\n            break\n        if not index_s.isdigit() or int(index_s) < 1:\n            break\n        term = int(term_s)\n        index = int(index_s)\n        # node pattern\n        if not node_pat.fullmatch(node):\n            break\n        if op not in allowed_ops:\n            break\n        key = (term, index, node, op, data)\n        if key in seen:\n            continue  # exact duplicate, skip\n        seen.add(key)\n        entries.append({\n            'term': term,\n            'index': index,\n            'node': node,\n            'op': op,\n            'data': data,\n        })\n    # ---------- Group by index ----------\n    by_index = defaultdict(list)\n    for e in entries:\n        by_index[e['index']].append(e)\n    # ---------- State tracking ----------\n    bad = defaultdict(set)          # index -> set of reasons\n    votes_per_term = defaultdict(set)   # term -> set of nodes that have voted\n    leader_first = {}               # term -> first index where LEADER appeared\n    appends_per_index = defaultdict(list)"]
[169.412247, "o", "def solve(lines: list[str]) -> str:\r\n\u001b[?2004l\r\u001b[?2004h>     # ---------- Helpers ----------\r\n\u001b[?2004l\r\u001b[?2004h>     node_pat = re.compile(r'^n[0-9]+$')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.412265, "i", "   # index -> list of APPEND entries\n    commits_per_index = defaultdict(list)   # index -> list of COMMIT entries\n    min_term_per_index = {}         # index -> minimal term seen at this index\n    # Process entries in original order to catch term regression & vote/leader rules\n    for e in entries:\n        idx = e['index']\n        term = e['term']\n        op = e['op']\n        # maintain minimal term per index\n        if idx not in min_term_per_index or term < min_term_per_index[idx]:\n            min_term_per_index[idx] = term\n        if op == 'VOTE':\n            if e['node'] in votes_per_term[term]:\n                bad[idx].add('BAD_DUPLICATE_VOTE')\n            else:\n                votes_per_term[term].add(e['node'])\n        elif op == 'LEADER':\n            if term not in leader_first:\n                leader_first[term] = idx\n            else:\n                if idx > leader_first[term]:\n                    bad[idx].add('BAD_LEADER_ORDER')\n        elif op == 'APPEND':\n            # term regression detection"]
[169.412287, "i", " within the same index\n            # compare with previous term seen for this index (keep last term)\n            lst = appends_per_index[idx]\n            if lst:\n                if term < lst[-1]['term']:\n                    bad[idx].add('BAD_TERM_REGRESSION')\n            # conflict detection (same term, different data)\n            for prev in lst:\n                if prev['term'] == term and prev['data'] != e['data']:\n                    bad[idx].add('BAD_CONFLICT')\n                    break\n            lst.append(e)\n            appends_per_index[idx].append(e)\n        elif op == 'COMMIT':\n            # term regression detection similar to APPEND\n            lst = commits_per_index[idx]\n            if lst:\n                if term < lst[-1]['term']:\n                    bad[idx].add('BAD_TERM_REGRESSION')\n            commits_per_index[idx].append(e)\n        else:\n            bad[idx].add('BAD_OPERATION')\n    # ---------- Determine winning term per index ----------\n    winning_term = {}\n    for idx, app_list in "]
