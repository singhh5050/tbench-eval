[169.417545, "o", "            if lst:\r\n\u001b[?2004l\r"]
[169.417556, "o", "\u001b[?2004h> "]
[169.417591, "o", "                if term < lst[-1]['term']:\r\n\u001b[?2004l\r"]
[169.4176, "o", "\u001b[?2004h"]
[169.417613, "o", "> "]
[169.41765, "o", "                    bad[idx].add('BAD_TERM_REGRESSION')\r\n\u001b[?2004l\r"]
[169.417662, "o", "\u001b[?2004h> "]
[169.417701, "o", "            commits_per_index[idx].append(e)\r\n"]
[169.417713, "o", "\u001b[?2004l\r\u001b[?2004h"]
[169.417724, "o", "> "]
[169.417735, "o", "        else:\r\n"]
[169.417746, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.4178, "o", "            bad[idx].add('BAD_OPERATION')\r\n"]
[169.417811, "o", "\u001b[?2004l\r"]
[169.417823, "o", "\u001b[?2004h> "]
[169.417896, "o", "    # ---------- Determine winning term per index ----------\r\n\u001b[?2004l\r"]
[169.417907, "o", "\u001b[?2004h"]
[169.417918, "o", "> "]
[169.417941, "o", "    winning_term = {}\r\n\u001b[?2004l\r"]
[169.41795, "o", "\u001b[?2004h"]
[169.417966, "o", "> "]
[169.418036, "o", "    for idx, app_list in appends_per_index.items():\r\n\u001b[?2004l\r"]
[169.418049, "o", "\u001b[?2004h"]
[169.41806, "o", "> "]
[169.418075, "o", "        if app_list:\r\n\u001b[?2004l\r"]
[169.418085, "o", "\u001b[?2004h"]
[169.418096, "o", "> "]
[169.418171, "o", "            winning_term[idx] = max(a['term'] for a in app_list)\r\n\u001b[?2004l\r"]
[169.418182, "o", "\u001b[?2004h> "]
[169.418226, "o", "    # ---------- Validate COMMIT entries ----------\r\n\u001b[?2004l\r"]
[169.418236, "o", "\u001b[?2004h> "]
[169.418284, "o", "    for idx, commit_list in commits_per_index.items():\r\n\u001b[?2004l\r"]
[169.418294, "o", "\u001b[?2004h> "]
[169.418355, "o", "        if idx not in appends_per_index or not appends_per_index[idx]:\r\n\u001b[?2004l\r"]
[169.418368, "o", "\u001b[?2004h> "]
[169.418405, "o", "            # no prior APPEND at this index\r\n\u001b[?2004l\r"]
[169.418417, "o", "\u001b[?2004h> "]
[169.418444, "o", "            for _ in commit_list:\r\n\u001b[?2004l\r"]
[169.418454, "o", "\u001b[?2004h> "]
[169.418497, "o", "                bad[idx].add('BAD_COMMIT_ORDER')\r\n\u001b[?2004l\r"]
[169.418509, "o", "\u001b[?2004h> "]
[169.418526, "o", "            continue\r\n\u001b[?2004l\r"]
[169.418536, "o", "\u001b[?2004h> "]
[169.418571, "o", "        win_term = winning_term.get(idx)\r\n"]
[169.418582, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.418609, "o", "        for c in commit_list:\r\n\u001b[?2004l\r"]
[169.418621, "o", "\u001b[?2004h> "]
[169.418653, "o", "            if c['term'] != win_term:\r\n"]
[169.418664, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.418706, "o", "                bad[idx].add('BAD_COMMIT_ORDER')\r\n\u001b[?2004l\r"]
[169.418717, "o", "\u001b[?2004h> "]
[169.418759, "o", "    # ---------- Log matching property ----------\r\n\u001b[?2004l\r"]
[169.41877, "o", "\u001b[?2004h> "]
[169.418896, "o", "    committed_indices = sorted([i for i, t in winning_term.items() if i in commits_per_index and not bad[i].intersection({'BAD_COMMIT_ORDER'})])\r\n\u001b[?2004l\r"]
[169.418913, "o", "\u001b[?2004h> "]
[169.418935, "o", "    for i in committed_indices:\r\n"]
[169.418946, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.418988, "o", "        committed_term = winning_term[i]\r\n\u001b[?2004l\r"]
[169.419, "o", "\u001b[?2004h> "]
[169.419016, "o", "        nxt = i + 1\r\n\u001b[?2004l\r"]
[169.419028, "o", "\u001b[?2004h> "]
[169.419061, "o", "        if nxt in min_term_per_index:\r\n"]
[169.419072, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.419121, "o", "            if min_term_per_index[nxt] < committed_term:\r\n\u001b[?2004l\r"]
[169.419132, "o", "\u001b[?2004h> "]
[169.41917, "o", "                bad[nxt].add('BAD_LOG_MATCH')\r\n\u001b[?2004l\r"]
[169.419182, "o", "\u001b[?2004h> "]
[169.419237, "o", "    # ---------- Determine missing commits for repairs ----------\r\n\u001b[?2004l\r"]
[169.419248, "o", "\u001b[?2004h> "]
[169.419264, "o", "    inserts = []\r\n\u001b[?2004l\r"]
[169.419274, "o", "\u001b[?2004h> "]
[169.419315, "o", "    for idx, apps in appends_per_index.items():\r\n"]
[169.419327, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.419346, "o", "        if not apps:\r\n\u001b[?2004l\r"]
[169.419357, "o", "\u001b[?2004h> "]
[169.419374, "o", "            continue\r\n\u001b[?2004l\r"]
[169.419385, "o", "\u001b[?2004h> "]
[169.41942, "o", "        win_term = winning_term.get(idx)\r\n"]
[169.419431, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.419531, "o", "        # check if there is a valid COMMIT (i.e., a COMMIT entry with correct term and not flagged BAD_COMMIT_ORDER)\r\n\u001b[?2004l\r"]
[169.419543, "o", "\u001b[?2004h> "]
[169.41957, "o", "        has_valid_commit = False\r\n\u001b[?2004l\r"]
[169.41958, "o", "\u001b[?2004h"]
[169.419592, "o", "> "]
[169.419624, "o", "        for c in commits_per_index.get(idx, []):\r\n\u001b[?2004l\r"]
[169.419634, "o", "\u001b[?2004h> "]
[169.4197, "o", "            if c['term'] == win_term and 'BAD_COMMIT_ORDER' not in bad[idx]:\r\n\u001b[?2004l\r"]
[169.419712, "o", "\u001b[?2004h> "]
[169.419744, "o", "                has_valid_commit = True\r\n\u001b[?2004l\r"]
[169.419757, "o", "\u001b[?2004h> "]
[169.419775, "o", "                break\r\n\u001b[?2004l\r"]
[169.419787, "o", "\u001b[?2004h> "]
[169.419813, "o", "        if not has_valid_commit:\r\n"]
[169.419825, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.419864, "o", "            inserts.append((idx, win_term))\r\n"]
[169.419875, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.419909, "o", "    # ---------- Build output ----------\r\n"]
[169.41992, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.419938, "o", "    bad_lines = []\r\n\u001b[?2004l\r"]
[169.41995, "o", "\u001b[?2004h> "]
[169.419985, "o", "    for idx in sorted(bad.keys()):\r\n\u001b[?2004l\r"]
[169.420015, "o", "\u001b[?2004h> "]
[169.420046, "o", "        for reason in sorted(bad[idx]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.420066, "o", "> "]
[169.420116, "o", "            bad_lines.append(f\"BAD {idx} {reason}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.420155, "o", "> "]
[169.420177, "o", "    ins_lines = []\r\n\u001b[?2004l\r"]
[169.420189, "o", "\u001b[?2004h> "]
[169.420244, "o", "    for idx, term in sorted(inserts, key=lambda x: (x[0], x[1])):\r\n\u001b[?2004l\r"]
[169.420255, "o", "\u001b[?2004h> "]
[169.420296, "o", "        ins_lines.append(f\"INS {term} {idx} COMMIT\")\r\n\u001b[?2004l\r"]
[169.42031, "o", "\u001b[?2004h> "]
[169.420346, "o", "    if not bad_lines and not ins_lines:\r\n\u001b[?2004l\r"]
[169.420357, "o", "\u001b[?2004h> "]
[169.420379, "o", "        return \"OK\"\r\n\u001b[?2004l\r"]
[169.420395, "o", "\u001b[?2004h> "]
[169.420432, "o", "    return \"\\n\".join(bad_lines + ins_lines)\r\n\u001b[?2004l\r"]
[169.420444, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[169.420456, "o", "\u001b[?2004h> "]
[169.420506, "o", "# The module exposes only the solve function as required.\r\n\u001b[?2004l\r"]
[169.420518, "o", "\u001b[?2004h> PY"]
