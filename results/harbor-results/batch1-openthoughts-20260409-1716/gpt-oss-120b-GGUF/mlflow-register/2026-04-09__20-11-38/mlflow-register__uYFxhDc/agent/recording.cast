[30.696698, "o", "\u001b[?2004hroot@e561d9a06ffd:/app# "]
[31.231373, "i", "cat > train.py <<'PYTHON'\nimport mlflow\nimport mlflow.sklearn\nimport numpy as np\nfrom sklearn.linear_model import LinearRegression\n\nmlflow.set_tracking_uri('http://localhost:8080')\nmlflow.set_experiment('default')\n\nwith mlflow.start_run() as run:\n    # Random dataset with 100 samples and 3 features\n    X = np.random.rand(100, 3)\n    y = np.random.rand(100)\n    model = LinearRegression()\n    model.fit(X, y)\n    # Log the model and register it as gpt-5\n    mlflow.sklearn.log_model(model, 'model', registered_model_name='gpt-5')\n    # Log a simple metric (RMSE) for demonstration\n    predictions = model.predict(X)\n    rmse = np.sqrt(((predictions - y) ** 2).mean())\n    mlflow.log_metric('rmse', rmse)\nPYTHON\n"]
[31.231523, "o", "cat > train.py <<'PYTHON'\r\n\u001b[?2004l\r"]
