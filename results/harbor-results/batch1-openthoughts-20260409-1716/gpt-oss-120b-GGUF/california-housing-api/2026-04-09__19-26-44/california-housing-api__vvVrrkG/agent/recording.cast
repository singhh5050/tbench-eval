[77.100263, "o", "# Ridge Regression (default alpha)\r\n\u001b[?2004l\r"]
[77.100274, "o", "\u001b[?2004h"]
[77.100285, "o", "> "]
[77.100309, "o", "ridge_res = evaluate(Ridge(alpha=1.0), 'ridge')\r\n\u001b[?2004l\r"]
[77.10032, "o", "\u001b[?2004h> "]
[77.100337, "o", "models.append(ridge_res)\r\n\u001b[?2004l\r"]
[77.100348, "o", "\u001b[?2004h> "]
[77.100382, "o", "# Random Forest Regressor (reasonable defaults)\r\n\u001b[?2004l\r"]
[77.100394, "o", "\u001b[?2004h> "]
[77.100452, "o", "rf = RandomForestRegressor(n_estimators=200, random_state=42, n_jobs=4)\r\n\u001b[?2004l\r"]
[77.100464, "o", "\u001b[?2004h> "]
[77.10049, "o", "rf_res = evaluate(rf, 'random_forest')\r\n\u001b[?2004l\r"]
[77.100501, "o", "\u001b[?2004h"]
[77.100512, "o", "> "]
[77.100523, "o", "models.append(rf_res)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.100536, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.100564, "o", "# Determine best model by validation R2\r\n\u001b[?2004l\r"]
[77.100575, "o", "\u001b[?2004h> "]
[77.100608, "o", "best = max(models, key=lambda x: x['val_r2'])\r\n\u001b[?2004l\r"]
[77.100619, "o", "\u001b[?2004h> "]
[77.100641, "o", "best_name = best['model_name']\r\n\u001b[?2004l\r"]
[77.100652, "o", "\u001b[?2004h> "]
[77.100679, "o", "# Copy best model to best_model.pkl\r\n\u001b[?2004l\r"]
[77.10069, "o", "\u001b[?2004h> "]
[77.100766, "o", "shutil.copyfile(os.path.join(models_dir, f\"{best_name}.pkl\"), os.path.join(models_dir, 'best_model.pkl'))\r\n\u001b[?2004l\r"]
[77.100778, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.100788, "o", "\u001b[?2004h> "]
[77.100824, "o", "# Save model comparison JSON (exclude model objects)\r\n\u001b[?2004l\r"]
[77.100835, "o", "\u001b[?2004h> "]
[77.100845, "o", "comp_list = []\r\n\u001b[?2004l\r"]
[77.100856, "o", "\u001b[?2004h> "]
[77.100868, "o", "for m in models:\r\n\u001b[?2004l\r"]
[77.100878, "o", "\u001b[?2004h> "]
[77.100895, "o", "    comp_list.append({\r\n\u001b[?2004l\r"]
[77.100905, "o", "\u001b[?2004h> "]
[77.100934, "o", "        \"model_name\": m['model_name'],\r\n\u001b[?2004l\r"]
[77.100945, "o", "\u001b[?2004h> "]
[77.100969, "o", "        \"train_r2\": m['train_r2'],\r\n\u001b[?2004l\r"]
[77.10098, "o", "\u001b[?2004h> "]
[77.101002, "o", "        \"val_r2\": m['val_r2'],\r\n\u001b[?2004l\r"]
[77.101013, "o", "\u001b[?2004h> "]
[77.10103, "o", "        \"mae\": m['mae'],\r\n\u001b[?2004l\r"]
[77.101042, "o", "\u001b[?2004h> "]
[77.101058, "o", "        \"mse\": m['mse'],\r\n\u001b[?2004l\r"]
[77.101069, "o", "\u001b[?2004h> "]
[77.101087, "o", "        \"rmse\": m['rmse']\r\n\u001b[?2004l\r"]
[77.101099, "o", "\u001b[?2004h> "]
[77.10111, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.101123, "o", "model_comp = {\r\n\u001b[?2004l\r"]
[77.101134, "o", "\u001b[?2004h> "]
[77.101152, "o", "    \"models\": comp_list,\r\n\u001b[?2004l\r"]
[77.101163, "o", "\u001b[?2004h> "]
[77.101186, "o", "    \"best_model_name\": best_name\r\n\u001b[?2004l\r"]
[77.101197, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[77.101208, "o", "\u001b[?2004h> "]
[77.10126, "o", "with open(os.path.join(output_dir, 'model_comparison.json'), 'w') as f:\r\n\u001b[?2004l\r"]
[77.101268, "o", "\u001b[?2004h> "]
[77.101301, "o", "    json.dump(model_comp, f, indent=2)\r\n\u001b[?2004l\r"]
[77.101314, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[77.101325, "o", "> "]
[77.101339, "o", "# Create FastAPI app file\r\n\u001b[?2004l\r"]
[77.10135, "o", "\u001b[?2004h> "]
[77.101361, "o", "api_code = f\"\"\"\r\n\u001b[?2004l\r"]
[77.101372, "o", "\u001b[?2004h> "]
[77.101406, "o", "from fastapi import FastAPI, HTTPException\r\n\u001b[?2004l\r"]
[77.101418, "o", "\u001b[?2004h"]
[77.10143, "o", "> "]
[77.101442, "o", "from pydantic import BaseModel\r\n\u001b[?2004l\r"]
[77.101453, "o", "\u001b[?2004h> "]
[77.101462, "o", "import pickle\r\n\u001b[?2004l\r"]
[77.101471, "o", "\u001b[?2004h> "]
[77.101485, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[77.101496, "o", "\u001b[?2004h> "]
[77.101507, "o", "import os\r\n\u001b[?2004l\r"]
[77.101519, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[77.101532, "o", "> "]
[77.101543, "o", "app = FastAPI()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.101552, "o", "\u001b[?2004h"]
[77.101562, "o", "> "]
[77.101596, "o", "model_path = '{os.path.join(models_dir, 'best_model.pkl')}'\r\n\u001b[?2004l\r"]
[77.10161, "o", "\u001b[?2004h> "]
[77.101627, "o", "model_name = '{best_name}'\r\n\u001b[?2004l\r"]
[77.101639, "o", "\u001b[?2004h> "]
[77.101651, "o", "model = None\r\n\u001b[?2004l\r"]
[77.101664, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.101674, "o", "\u001b[?2004h> "]
[77.101688, "o", "@app.on_event('startup')\r\n\u001b[?2004l\r"]
[77.101697, "o", "\u001b[?2004h> "]
[77.10171, "o", "def load_model():\r\n\u001b[?2004l\r"]
[77.101722, "o", "\u001b[?2004h> "]
[77.101735, "o", "    global model\r\n\u001b[?2004l\r"]
[77.101744, "o", "\u001b[?2004h> "]
[77.10177, "o", "    if not os.path.exists(model_path):\r\n\u001b[?2004l\r"]
[77.10178, "o", "\u001b[?2004h> "]
[77.101817, "o", "        raise RuntimeError('Model file not found')\r\n\u001b[?2004l\r"]
[77.101829, "o", "\u001b[?2004h> "]
[77.101853, "o", "    with open(model_path, 'rb') as f:\r\n\u001b[?2004l\r"]
[77.101865, "o", "\u001b[?2004h> "]
[77.101886, "o", "        model = pickle.load(f)\r\n\u001b[?2004l\r"]
[77.101897, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.101907, "o", "\u001b[?2004h> "]
[77.10193, "o", "class PredictRequest(BaseModel):\r\n\u001b[?2004l\r"]
[77.101941, "o", "\u001b[?2004h> "]
[77.101959, "o", "    features: list[float]\r\n\u001b[?2004l\r"]
[77.101969, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.101981, "o", "\u001b[?2004h> "]
[77.102005, "o", "class PredictBatchRequest(BaseModel):\r\n\u001b[?2004l\r"]
[77.102015, "o", "\u001b[?2004h> "]
[77.102042, "o", "    features_list: list[list[float]]\r\n\u001b[?2004l\r"]
[77.102053, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.102063, "o", "\u001b[?2004h> "]
[77.102077, "o", "@app.post('/predict')\r\n\u001b[?2004l\r"]
[77.102088, "o", "\u001b[?2004h> "]
[77.102118, "o", "def predict(req: PredictRequest):\r\n\u001b[?2004l\r"]
[77.102129, "o", "\u001b[?2004h> "]
[77.10216, "o", "    if len(req.features) != 8:\r\n\u001b[?2004l\r"]
[77.102169, "o", "\u001b[?2004h"]
[77.10218, "o", "> "]
[77.102249, "o", "        raise HTTPException(status_code=400, detail='Exactly 8 features required')\r\n\u001b[?2004l\r"]
[77.10226, "o", "\u001b[?2004h> "]
[77.102307, "o", "    arr = np.array(req.features).reshape(1, -1)\r\n\u001b[?2004l\r"]
[77.102316, "o", "\u001b[?2004h"]
[77.102327, "o", "> "]
[77.10235, "o", "    pred = model.predict(arr)[0]\r\n\u001b[?2004l\r"]
[77.10236, "o", "\u001b[?2004h"]
[77.102371, "o", "> "]
[77.102429, "o", "    return {{'prediction': float(pred), 'model_name': model_name}}\r\n\u001b[?2004l\r"]
[77.10244, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.102448, "o", "\u001b[?2004h> "]
[77.102472, "o", "@app.get('/health')\r\n\u001b[?2004l\r"]
[77.102481, "o", "\u001b[?2004h> "]
[77.102498, "o", "def health():\r\n\u001b[?2004l\r"]
[77.102508, "o", "\u001b[?2004h> "]
[77.102575, "o", "    return {{'status': 'healthy', 'model_loaded': model is not None}}\r\n\u001b[?2004l\r"]
[77.102586, "o", "\u001b[?2004h> "]
[77.102597, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.102623, "o", "@app.get('/model-info')\r\n\u001b[?2004l\r"]
[77.102634, "o", "\u001b[?2004h> "]
[77.102654, "o", "def model_info():\r\n\u001b[?2004l\r"]
[77.102663, "o", "\u001b[?2004h"]
[77.102674, "o", "> "]
[77.102702, "o", "    return {{'model_name': model_name,\r\n\u001b[?2004l\r"]
[77.102712, "o", "\u001b[?2004h"]
[77.102723, "o", "> "]
[77.102757, "o", "             'model_type': type(model).__name__,\r\n\u001b[?2004l\r"]
[77.102768, "o", "\u001b[?2004h> "]
[77.102792, "o", "             'features_count': 8}}\r\n\u001b[?2004l\r"]
[77.102803, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.102814, "o", "\u001b[?2004h> "]
[77.102833, "o", "@app.post('/predict-batch')\r\n\u001b[?2004l\r"]
[77.102844, "o", "\u001b[?2004h> "]
[77.102875, "o", "def predict_batch(req: PredictBatchRequest):\r\n\u001b[?2004l\r"]
[77.102886, "o", "\u001b[?2004h> "]
[77.102912, "o", "    for feats in req.features_list:\r\n\u001b[?2004l\r"]
[77.102923, "o", "\u001b[?2004h> "]
[77.102942, "o", "        if len(feats) != 8:\r\n\u001b[?2004l\r"]
[77.102953, "o", "\u001b[?2004h> "]
[77.103029, "o", "            raise HTTPException(status_code=400, detail='Each feature list must contain exactly 8 values')\r\n\u001b[?2004l\r"]
[77.10304, "o", "\u001b[?2004h> "]
[77.103067, "o", "    arr = np.array(req.features_list)\r\n\u001b[?2004l\r"]
[77.103078, "o", "\u001b[?2004h> "]
[77.103105, "o", "    preds = model.predict(arr).tolist()\r\n\u001b[?2004l\r"]
[77.103116, "o", "\u001b[?2004h> "]
[77.103155, "o", "    return {{'predictions': [float(p) for p in preds],\r\n\u001b[?2004l\r"]
[77.103166, "o", "\u001b[?2004h> "]
[77.103193, "o", "             'model_name': model_name,\r\n\u001b[?2004l\r"]
[77.103204, "o", "\u001b[?2004h> "]
[77.103228, "o", "             'count': len(preds)}}\r\n\u001b[?2004l\r"]
[77.103239, "o", "\u001b[?2004h> \"\"\"\r\n"]
[77.103249, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[77.103291, "o", "with open(os.path.join(api_dir, 'app.py'), 'w') as f:\r\n\u001b[?2004l\r"]
[77.103302, "o", "\u001b[?2004h> "]
[77.103317, "o", "    f.write(api_code)\r\n\u001b[?2004l\r"]
[77.103328, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.103339, "o", "\u001b[?2004h> "]
[77.103367, "o", "print('Pipeline completed successfully')\r\n\u001b[?2004l\r"]
[77.103378, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[77.104953, "o", "\u001b[?2004hroot@92b752064dda:/app# "]
[77.597573, "i", "python3 /app/pipeline.py\n"]
[77.597696, "o", "python3 /app/pipeline.py\r\n\u001b[?2004l\r"]
[88.177134, "o", "Pipeline completed successfully\r\n"]
[88.345321, "o", "\u001b[?2004hroot@92b752064dda:/app# "]
[92.593989, "i", "nohup uvicorn api.app:app --host 0.0.0.0 --port 8000 > /app/output/uvicorn.log 2>&1 &\n"]
[92.594154, "o", "nohup uvicorn api.app:app --host 0.0.0.0 --port 8000 > /app/output/uvicorn.log 2>&1 &\r\n\u001b[?2004l\r"]
[92.594418, "o", "[1] 240\r\n"]
[92.594461, "o", "\u001b[?2004h"]
[92.59448, "o", "root@92b752064dda:/app# "]
[93.093483, "i", "sleep 5\n"]
[93.093741, "o", "sleep 5\r\n\u001b[?2004l\r"]
[98.092462, "i", "curl -s http://localhost:8000/health\n"]
[98.09263, "o", "curl -s http://localhost:8000/health\r\n"]
[98.094522, "o", "\u001b[?2004hroot@92b752064dda:/app# "]
[98.094582, "o", "curl -s http://localhost:8000/health\r\n\u001b[?2004l\r"]
[98.117383, "o", "{\"status\":\"healthy\",\"model_loaded\":true}"]
[98.119069, "o", "\u001b[?2004h"]
[98.119096, "o", "root@92b752064dda:/app# "]
[98.299564, "i", "cat > /app/test_api.py << 'PY'\nimport os, json, csv, requests, pandas as pd, numpy as np\nfrom sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\n\n# Load validation set using split info\nsplit_path = '/app/output/split_info.json'\nwith open(split_path) as f:\n    split = json.load(f)\nval_idx = split['validation_indices']\n\ntrain_csv = '/app/data/train.csv'\ndf = pd.read_csv(train_csv)\nfeatures = ['MedInc','HouseAge','AveRooms','AveBedrms','Population','AveOccup','Latitude','Longitude']\nif 'median_house_value' in df.columns:\n    target_col = 'median_house_value'\nelse:\n    target_col = df.columns[-1]\nX = df[features]\ny = df[target_col]\nX_val = X.iloc[val_idx].reset_index(drop=True)\ny_val = y.iloc[val_idx].reset_index(drop=True)\n\npredictions = []\nurl = 'http://localhost:8000/predict'\nfor i, row in X_val.iterrows():\n    resp = requests.post(url, json={'features': row.tolist()})\n    if resp.status_code != 200:\n        raise RuntimeError(f'Prediction failed: {resp.text}')\n    pred = resp.json()['pre"]
[98.299774, "i", "diction']\n    predictions.append(pred)\n\n# Save to CSV\nout_path = '/app/output/api_predictions.csv'\nwith open(out_path, 'w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerow(['sample_index', 'y_true', 'y_pred', 'absolute_error'])\n    for i, (yt, yp) in enumerate(zip(y_val, predictions)):\n        writer.writerow([i, float(yt), float(yp), float(abs(yt - yp))])\n\n# Compute metrics\nmae = mean_absolute_error(y_val, predictions)\nmse = mean_squared_error(y_val, predictions)\nrmse = np.sqrt(mse)\nr2 = r2_score(y_val, predictions)\nmetrics = {\n    'sample_count': len(predictions),\n    'mae': mae,\n    'mse': mse,\n    'rmse': rmse,\n    'r2_score': r2\n}\nwith open('/app/output/api_metrics.json', 'w') as f:\n    json.dump(metrics, f, indent=2)\nprint('API testing completed')\nPY\n"]
