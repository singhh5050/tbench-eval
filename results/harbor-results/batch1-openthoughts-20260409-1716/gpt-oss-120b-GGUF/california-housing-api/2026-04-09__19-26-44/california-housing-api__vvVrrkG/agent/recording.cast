[98.300943, "o", "    pred = resp.json()['prediction']\r\n\u001b[?2004l\r"]
[98.300954, "o", "\u001b[?2004h> "]
[98.30098, "o", "    predictions.append(pred)\r\n\u001b[?2004l\r"]
[98.300996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.301009, "o", "\u001b[?2004h> "]
[98.301023, "o", "# Save to CSV\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.301036, "o", "> "]
[98.301067, "o", "out_path = '/app/output/api_predictions.csv'\r\n\u001b[?2004l\r"]
[98.30108, "o", "\u001b[?2004h> "]
[98.301115, "o", "with open(out_path, 'w', newline='') as f:\r\n\u001b[?2004l\r"]
[98.301127, "o", "\u001b[?2004h> "]
[98.301151, "o", "    writer = csv.writer(f)\r\n\u001b[?2004l\r"]
[98.301163, "o", "\u001b[?2004h> "]
[98.301227, "o", "    writer.writerow(['sample_index', 'y_true', 'y_pred', 'absolute_error'])\r\n\u001b[?2004l\r"]
[98.301239, "o", "\u001b[?2004h> "]
[98.301287, "o", "    for i, (yt, yp) in enumerate(zip(y_val, predictions)):\r\n\u001b[?2004l\r"]
[98.301299, "o", "\u001b[?2004h> "]
[98.301364, "o", "        writer.writerow([i, float(yt), float(yp), float(abs(yt - yp))])\r\n\u001b[?2004l\r"]
[98.301375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.301388, "o", "\u001b[?2004h> "]
[98.301401, "o", "# Compute metrics\r\n"]
[98.301415, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[98.301456, "o", "mae = mean_absolute_error(y_val, predictions)\r\n\u001b[?2004l\r"]
[98.301468, "o", "\u001b[?2004h> "]
[98.301506, "o", "mse = mean_squared_error(y_val, predictions)\r\n\u001b[?2004l\r"]
[98.301517, "o", "\u001b[?2004h> "]
[98.301535, "o", "rmse = np.sqrt(mse)\r\n\u001b[?2004l\r"]
[98.301546, "o", "\u001b[?2004h> "]
[98.301581, "o", "r2 = r2_score(y_val, predictions)\r\n\u001b[?2004l\r"]
[98.301594, "o", "\u001b[?2004h> "]
[98.301605, "o", "metrics = {\r\n\u001b[?2004l\r"]
[98.301615, "o", "\u001b[?2004h> "]
[98.301649, "o", "    'sample_count': len(predictions),\r\n\u001b[?2004l\r"]
[98.301661, "o", "\u001b[?2004h> "]
[98.301677, "o", "    'mae': mae,\r\n\u001b[?2004l\r"]
[98.301687, "o", "\u001b[?2004h"]
[98.301699, "o", "> "]
[98.301711, "o", "    'mse': mse,\r\n\u001b[?2004l\r"]
[98.301739, "o", "\u001b[?2004h> "]
[98.301758, "o", "    'rmse': rmse,\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.301772, "o", ">     'r2_score': r2\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.301786, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.301799, "o", "> "]
[98.301838, "o", "with open('/app/output/api_metrics.json', 'w') as f:\r\n\u001b[?2004l\r"]
[98.301851, "o", "\u001b[?2004h> "]
[98.301882, "o", "    json.dump(metrics, f, indent=2)\r\n\u001b[?2004l\r"]
[98.301894, "o", "\u001b[?2004h> "]
[98.301921, "o", "print('API testing completed')\r\n\u001b[?2004l\r"]
[98.301932, "o", "\u001b[?2004h> "]
[98.301944, "o", "PY\r\n\u001b[?2004l\r"]
[98.30274, "o", "\u001b[?2004hroot@92b752064dda:/app# "]
