[?2004hroot@083b1cf53ca0:/app# cat > /app/aggregate.py <<'PY'
[?2004l[?2004h> import json, glob, collections
[?2004l[?2004h> 
[?2004l[?2004h> user_totals = {}
[?2004l[?2004h> tag_counts = collections.Counter()
[?2004l[?2004h> 
[?2004l[?2004h> for fname in glob.glob('/app/records_*.jsonl'):
[?2004l[?2004h>     with open(fname, 'r') as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             line = line.strip()
[?2004l[?2004h>             if not line:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             rec = json.loads(line)
[?2004l[?2004h>             user = rec.get('user')
[?2004l[?2004h>             amount = float(rec.get('amount', 0))
[?2004l[?2004h>             items = int(rec.get('items', 0))
[?2004l[?2004h>             # accumulate per‑user totals
[?2004l[?2004h>             if user not in user_totals:
[?2004l[?2004h>                 user_totals[user] = {'total_amount': 0.0, 'total_items': 0}
[?2004l[?2004h>             user_totals[user]['total_amount'] += amount
[?2004l[?2004h>             user_totals[user]['total_items'] += items
[?2004l[?2004h>             # accumulate tag counts
[?2004l[?2004h>             for tag in rec.get('tags', []):
[?2004l[?2004h>                 tag_counts[tag] += 1
[?2004l[?2004h> 
[?2004l[?2004h> # top 5 users by total amount (descending)
[?2004l[?2004h> top_users = sorted(user_totals.items(), key=lambda kv: kv[1]['total_amount'], reverse=True)[:5]
[?2004l[?2004h> top_users_dict = {
[?2004l[?2004h>     user: {
[?2004l[?2004h>         'total_amount': round(data['total_amount'] + 1e-8, 2),
[?2004l[?2004h>         'total_items': data['total_items']
[?2004l[?2004h>     } for user, data in top_users
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # top 5 tags by count (descending)
[?2004l[?2004h> top_tags = tag_counts.most_common(5)
[?2004l[?2004h> top_tags_dict = {tag: {'count': cnt} for tag, cnt in top_tags}
[?2004l[?2004h> 
[?2004l[?2004h> output = {
[?2004l[?2004h>     'top_5_users_by_amount': top_users_dict,
[?2004l[?2004h>     'top_5_tags_by_count': top_tags_dict
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/aggregates.json', 'w') as out_f:
[?2004l[?2004h>     json.dump(output, out_f, indent=2)
[?2004l[?2004h> PY
