[?2004l" LayoutQuine Vim plugin
" Recreates the current Vim layout into a script file.

function! LayoutQuine#Generate(path) abort
  let l:out = a:path
  " Write a header
  call writefile(['" Generated by LayoutQuine'], l:out)

  " Remember current tab
  let l:orig_tab = tabpagenr()

  " Iterate over all tabs
  for l:tabnr in range(1, tabpagenr('$'))
    execute 'tabnext' l:tabnr
    " Record tab creation (skip the first tab, which already exists)
    if l:tabnr != 1
      call writefile(['tabnew'], l:out, 'a')
    endif
    " Emit split commands that reproduce the window layout of this tab
    call s:EmitLayout(winlayout(), l:out)
    " After the layout, restore the buffer shown in each window
    for l:w in range(1, winnr('$'))
      execute l:w . 'wincmd w'
      let l:buf = winbufnr(l:w)
      if l:buf > 0
        call writefile(['buffer ' . l:buf], l:out, 'a')
      endif
    endfor
  endfor

