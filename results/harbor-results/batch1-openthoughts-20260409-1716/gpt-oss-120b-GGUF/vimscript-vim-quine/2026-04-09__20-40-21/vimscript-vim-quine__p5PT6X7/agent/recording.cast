[69.802936, "o", "        call writefile(['buffer ' . l:buf], l:out, 'a')\r\n\u001b[?2004l\r"]
[69.802977, "o", "\u001b[?2004h"]
[69.802994, "o", ">       endif\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.803001, "o", "    endfor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.803009, "o", "  endfor\r\n\u001b[?2004l\r"]
[69.803017, "o", "\u001b[?2004h"]
[69.803028, "o", "> \r\n\u001b[?2004l\r"]
[69.803033, "o", "\u001b[?2004h> "]
[69.803064, "o", "  \" Return to the original tab\r\n"]
[69.803102, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[69.803128, "o", "  execute 'tabnext' l:orig_tab\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.803142, "o", "> endfunction\r\n\u001b[?2004l\r"]
[69.803156, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.803211, "o", "\" Recursive helper that walks the structure returned by winlayout()\r\n\u001b[?2004l\r"]
[69.803226, "o", "\u001b[?2004h> "]
[69.803259, "o", "function! s:EmitLayout(layout, out) abort\r\n\u001b[?2004l\r"]
[69.803276, "o", "\u001b[?2004h> "]
[69.803312, "o", "  \" layout is a List: [type, children]\r\n\u001b[?2004l\r"]
[69.803326, "o", "\u001b[?2004h"]
[69.803339, "o", "> "]
[69.80335, "o", "  if a:layout[0] ==# 'leaf'\r\n\u001b[?2004l\r"]
[69.803363, "o", "\u001b[?2004h"]
[69.803374, "o", "> "]
[69.803407, "o", "    \" A leaf represents a window – nothing to do.\r\n\u001b[?2004l\r"]
[69.803418, "o", "\u001b[?2004h> "]
[69.803435, "o", "    return\r\n\u001b[?2004l\r"]
[69.803447, "o", "\u001b[?2004h> "]
[69.803472, "o", "  elseif a:layout[0] ==# 'col'\r\n\u001b[?2004l\r"]
[69.803483, "o", "\u001b[?2004h> "]
[69.803541, "o", "    \" Column split – first child is the leftmost window.\r\n\u001b[?2004l\r"]
[69.803553, "o", "\u001b[?2004h> "]
[69.803592, "o", "    for l:i in range(0, len(a:layout[1]) - 1)\r\n\u001b[?2004l\r"]
[69.803604, "o", "\u001b[?2004h> "]
[69.803618, "o", "      if l:i > 0\r\n\u001b[?2004l\r"]
[69.803628, "o", "\u001b[?2004h"]
[69.803641, "o", "> "]
[69.803686, "o", "        call writefile(['vertical split'], a:out, 'a')\r\n\u001b[?2004l\r"]
[69.803699, "o", "\u001b[?2004h> "]
[69.80371, "o", "      endif\r\n\u001b[?2004l\r"]
[69.803722, "o", "\u001b[?2004h> "]
[69.803768, "o", "      call s:EmitLayout(a:layout[1][l:i], a:out)\r\n\u001b[?2004l\r"]
[69.803781, "o", "\u001b[?2004h> "]
[69.803791, "o", "    endfor\r\n\u001b[?2004l\r"]
[69.803802, "o", "\u001b[?2004h> "]
[69.803833, "o", "  elseif a:layout[0] ==# 'row'\r\n\u001b[?2004l\r"]
[69.803843, "o", "\u001b[?2004h"]
[69.803854, "o", "> "]
[69.803894, "o", "    \" Row split – first child is the top window.\r\n\u001b[?2004l\r"]
[69.803905, "o", "\u001b[?2004h> "]
[69.803948, "o", "    for l:i in range(0, len(a:layout[1]) - 1)\r\n\u001b[?2004l\r"]
[69.803961, "o", "\u001b[?2004h"]
[69.803972, "o", ">       if l:i > 0\r\n"]
[69.803983, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[69.804029, "o", "        call writefile(['split'], a:out, 'a')\r\n\u001b[?2004l\r"]
[69.804041, "o", "\u001b[?2004h> "]
[69.804051, "o", "      endif\r\n\u001b[?2004l\r"]
[69.804061, "o", "\u001b[?2004h"]
[69.804072, "o", "> "]
[69.804112, "o", "      call s:EmitLayout(a:layout[1][l:i], a:out)\r\n\u001b[?2004l\r"]
[69.804125, "o", "\u001b[?2004h> "]
[69.80414, "o", "    endfor\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.804153, "o", "> "]
[69.804167, "o", "  endif\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.804177, "o", "endfunction\r\n\u001b[?2004l\r"]
[69.804189, "o", "\u001b[?2004h"]
[69.804204, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.804271, "o", "command! -nargs=1 LayoutQuine call LayoutQuine#Generate(<f-args>)\r\n\u001b[?2004l\r"]
[69.804284, "o", "\u001b[?2004h> "]
[69.8043, "o", "EOF\r\n\u001b[?2004l\r"]
[69.805336, "o", "\u001b[?2004hroot@6bfb56d69203:/app# "]
[71.801395, "i", "ls -l /app/plugin/layout_quine.vim\n"]
[71.801572, "o", "ls -l /app/plugin/layout_quine.vim\r\n\u001b[?2004l\r"]
[71.803319, "o", "-rw-r--r-- 1 root root 1849 Apr 10 02:41 /app/plugin/layout_quine.vim\r\n"]
[71.803476, "o", "\u001b[?2004h"]
[71.803505, "o", "root@6bfb56d69203:/app# "]
[71.899667, "i", "cat /app/plugin/layout_quine.vim | head -n 30\n"]
[71.899757, "o", "cat /app/plugin/layout_quine.vim | head -n 30\r\n"]
[71.899765, "o", "\u001b[?2004l\r"]
[71.900434, "o", "\" LayoutQuine Vim plugin\r\n\" Recreates the current Vim layout into a script file.\r\n\r\nfunction! LayoutQuine#Generate(path) abort\r\n  let l:out = a:path\r\n"]
[71.90044, "o", "  \" Write a header\r\n  call writefile(['\" Generated by LayoutQuine'], l:out)\r\n\r\n  \" Remember current tab\r\n  let l:orig_tab = tabpagenr()\r\n\r\n  \" Iterate over all tabs\r\n"]
[71.900444, "o", "  for l:tabnr in range(1, tabpagenr('$'))\r\n    execute 'tabnext' l:tabnr\r\n"]
[71.900501, "o", "    \" Record tab creation (skip the first tab, which already exists)\r\n    if l:tabnr != 1\r\n      call writefile(['tabnew'], l:out, 'a')\r\n    endif\r\n    \" Emit split commands that reproduce the window layout of this tab\r\n    call s:EmitLayout(winlayout(), l:out)\r\n    \" After the layout, restore the buffer shown in each window\r\n    for l:w in range(1, winnr('$'))\r\n      execute l:w . 'wincmd w'\r\n      let l:buf = winbufnr(l:w)\r\n      if l:buf > 0\r\n        call writefile(['buffer ' . l:buf], l:out, 'a')\r\n      endif\r\n    endfor\r\n  endfor\r\n\r\n"]
[71.900582, "o", "\u001b[?2004h"]
[71.900593, "o", "root@6bfb56d69203:/app# "]
