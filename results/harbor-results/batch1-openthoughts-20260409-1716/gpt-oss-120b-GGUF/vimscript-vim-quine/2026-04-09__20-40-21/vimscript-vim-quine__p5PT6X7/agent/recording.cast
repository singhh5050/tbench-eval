[25.937792, "i", "f l:i > 1\n        call writefile(['split'], a:out, 'a')\n      endif\n      call s:EmitLayout(a:layout[1][l:i-1], a:out)\n    endfor\n    return\n  endif\nendfunction\n\ncommand! -nargs=1 LayoutQuine call LayoutQuine#Generate(<f-args>)\nEOF\n"]
