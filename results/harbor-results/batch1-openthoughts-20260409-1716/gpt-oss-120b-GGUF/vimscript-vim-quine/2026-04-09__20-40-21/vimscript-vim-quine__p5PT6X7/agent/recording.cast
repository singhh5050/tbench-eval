[69.801591, "i", "cat <<'EOF' > /app/plugin/layout_quine.vim\n\" LayoutQuine Vim plugin\n\" Recreates the current Vim layout into a script file.\n\nfunction! LayoutQuine#Generate(path) abort\n  let l:out = a:path\n  \" Write a header\n  call writefile(['\" Generated by LayoutQuine'], l:out)\n\n  \" Remember current tab\n  let l:orig_tab = tabpagenr()\n\n  \" Iterate over all tabs\n  for l:tabnr in range(1, tabpagenr('$'))\n    execute 'tabnext' l:tabnr\n    \" Record tab creation (skip the first tab, which already exists)\n    if l:tabnr != 1\n      call writefile(['tabnew'], l:out, 'a')\n    endif\n    \" Emit split commands that reproduce the window layout of this tab\n    call s:EmitLayout(winlayout(), l:out)\n    \" After the layout, restore the buffer shown in each window\n    for l:w in range(1, winnr('$'))\n      execute l:w . 'wincmd w'\n      let l:buf = winbufnr(l:w)\n      if l:buf > 0\n        call writefile(['buffer ' . l:buf], l:out, 'a')\n      endif\n    endfor\n  endfor\n\n  \" Return to the original tab\n  execute 'tabnext' l:orig_tab\nendfunction\n\n\" "]
[69.801826, "i", "Recursive helper that walks the structure returned by winlayout()\nfunction! s:EmitLayout(layout, out) abort\n  \" layout is a List: [type, children]\n  if a:layout[0] ==# 'leaf'\n    \" A leaf represents a window – nothing to do.\n    return\n  elseif a:layout[0] ==# 'col'\n    \" Column split – first child is the leftmost window.\n    for l:i in range(0, len(a:layout[1]) - 1)\n      if l:i > 0\n        call writefile(['vertical split'], a:out, 'a')\n      endif\n      call s:EmitLayout(a:layout[1][l:i], a:out)\n    endfor\n  elseif a:layout[0] ==# 'row'\n    \" Row split – first child is the top window.\n    for l:i in range(0, len(a:layout[1]) - 1)\n      if l:i > 0\n        call writefile(['split'], a:out, 'a')\n      endif\n      call s:EmitLayout(a:layout[1][l:i], a:out)\n    endfor\n  endif\nendfunction\n\ncommand! -nargs=1 LayoutQuine call LayoutQuine#Generate(<f-args>)\nEOF\n"]
[69.801867, "o", "cat <<'EOF' > /app/plugin/layout_quine.vim\r\n\u001b[?2004l\r\u001b[?2004h> \" LayoutQuine Vim plugin\r\n\u001b[?2004l\r\u001b[?2004h> "]
