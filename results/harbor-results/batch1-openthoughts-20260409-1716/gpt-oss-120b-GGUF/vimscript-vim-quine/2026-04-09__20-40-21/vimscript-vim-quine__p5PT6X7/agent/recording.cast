[25.937586, "i", "cat <<'EOF' > /app/plugin/layout_quine.vim\nfunction! LayoutQuine#Generate(path)\n  \" Open the output file for writing\n  let l:out = a:path\n  call writefile(['\" Generated by LayoutQuine'], l:out)\n\n  \" Get list of tabpages\n  let l:tablist = tabpagelist()\n  let l:curtab = tabpagenr()\n  \" Iterate over tabs\n  for l:tabnr in l:tablist\n    \" Switch to tab\n    execute 'tabnext' l:tabnr\n    \" Record tab creation (skip first tab as it's already open)\n    if l:tabnr != 1\n      call writefile(['tabnew'], l:out, 'a')\n    endif\n    \" Get windows in this tab\n    let l:wins = win_findbuf(0)\n    \" For each window, capture split layout using winlayout()\n    \" Use recursive helper to emit splits\n    call s:EmitLayout(winlayout(), l:out)\n    \" After layout, edit each buffer in its window\n    let l:winnr = 1\n    for l:buf in range(1, bufnr('$'))\n      if bufexists(l:buf) && bufloaded(l:buf)\n        \" Find windows showing this buffer\n        for l:w in range(1, winnr('$'))\n          if winbufnr(l:w) == l:buf\n            execute l:w"]
[25.937725, "i", " . 'wincmd w'\n            execute 'edit #' . l:buf\n          endif\n        endfor\n      endif\n    endfor\n  endfor\n  \" Return to original tab\n  execute 'tabnext' l:curtab\nendfunction\n\n\" Recursive function to emit split commands based on winlayout()\nfunction! s:EmitLayout(layout, out) abort\n  if type(a:layout) == type([]) && len(a:layout) == 2 && a:layout[0] ==# 'leaf'\n    \" leaf node, nothing to do (window already exists)\n    return\n  endif\n  if type(a:layout) == type([]) && len(a:layout) == 2 && a:layout[0] ==# 'col'\n    \" column split: first window is left, then split vertically for each subsequent\n    for l:i in range(1, len(a:layout[1]))\n      if l:i > 1\n        call writefile(['vertical split'], a:out, 'a')\n      endif\n      call s:EmitLayout(a:layout[1][l:i-1], a:out)\n    endfor\n    return\n  endif\n  if type(a:layout) == type([]) && len(a:layout) == 2 && a:layout[0] ==# 'row'\n    \" row split: first window is top, then split horizontally for each subsequent\n    for l:i in range(1, len(a:layout[1]))\n      i"]
