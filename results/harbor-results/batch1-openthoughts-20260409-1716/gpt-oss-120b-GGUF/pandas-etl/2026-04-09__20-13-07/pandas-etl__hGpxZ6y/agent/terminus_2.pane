import pandas as pd, re, datetime

df = pd.read_csv('/app/data.csv', dtype=str)

def extract_postal(addr):
    m = re.search(r'(\d{5,})\s*$', str(addr).strip())
    return m.group(1) if m else ''

def extract_city(addr):
    parts = str(addr).split('\n')
    if len(parts) >= 2:
        return parts[1].split(',')[0].strip()
    return ''

def format_birth(b):
    try:
        dt = datetime.datetime.strptime(b.strip(), '%d %b %Y')
        return dt.strftime('%Y-%m-%d')
    except Exception:
        return b

def make_team(row):
    fl = (row['first_name'][0] + row['last_name'][0]).upper()
    country = row['country']
    institute = row['institute']
    i_letters = ''.join([w[0].upper() for w in str(institute).split() if w])
    return f"{fl}-{country}-{i_letters}"

# Apply transformations
df['postal_code'] = df['address'].apply(extract_postal)
df['city'] = df['address'].apply(extract_city)
df['birth_date'] = df['birth_date'].apply(format_birth)
df['team_name'] = df.apply(make_team, axis=1)

# Desired column order
cols = [
    'participant_id', 'first_name', 'last_name', 'birth_date', 'address',
    'phone_number', 'country', 'institute', 'occupation', 'register_time',
    'postal_code', 'city', 'team_name'
]

df = df[cols]

df.to_csv('/app/result.csv', index=False)
