[37.723343, "i", "python - <<'PY'\nimport pandas as pd, re, datetime\ndf = pd.read_csv('/app/data.csv', dtype=str)\n\ndef extract_postal(addr):\n    m = re.search(r'(\\d{5,})\\s*$', str(addr).strip())\n    return m.group(1) if m else ''\n\ndef extract_city(addr):\n    parts = str(addr).split('\\n')\n    if len(parts) >= 2:\n        return parts[1].split(',')[0].strip()\n    return ''\n\ndef format_birth(b):\n    try:\n        dt = datetime.datetime.strptime(b.strip(), '%d %b %Y')\n        return dt.strftime('%Y-%m-%d')\n    except Exception:\n        return b\n\ndef make_team(row):\n    fl = (row['first_name'][0] + row['last_name'][0]).upper()\n    country = row['country']\n    institute = row['institute']\n    i_letters = ''.join([w[0].upper() for w in str(institute).split() if w])\n    return f\"{fl}-{country}-{i_letters}\"\n\ndf['postal_code'] = df['address'].apply(extract_postal)\ndf['city'] = df['address'].apply(extract_city)\ndf['birth_date'] = df['birth_date'].apply(format_birth)\ndf['team_name'] = df.apply(make_team, axis=1)\ncols = ['participant_id','fir"]
[37.723488, "i", "st_name','last_name','birth_date','address','phone_number','country','institute','occupation','register_time','postal_code','city','team_name']\ndf = df[cols]\ndf.to_csv('/app/result.csv', index=False)\nPY\n"]
