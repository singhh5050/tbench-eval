[?2004l[?2004h>   -out "$INT_CERT"
[?2004l[?2004h> 
[?2004l[?2004h> # Clean up CSR and serial files
[?2004l[?2004h> rm -f "$INT_CSR" "$CA_DIR/root-ca.srl"
[?2004l[?2004h> EOS
