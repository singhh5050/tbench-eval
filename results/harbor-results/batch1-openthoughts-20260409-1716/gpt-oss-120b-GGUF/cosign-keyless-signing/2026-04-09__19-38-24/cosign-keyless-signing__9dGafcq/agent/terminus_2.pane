[?2004l[?2004h> #!/usr/bin/env bash
[?2004l[?2004h> set -euo pipefail
[?2004l[?2004h> 
[?2004l[?2004h> # Directories
[?2004l[?2004h> CA_DIR="/app/ca"
[?2004l[?2004h> 
[?2004l[?2004h> # Clean any existing CA files
[?2004l[?2004h> rm -rf "$CA_DIR"/*
[?2004l[?2004h> 
[?2004l[?2004h> # Root CA
[?2004l[?2004h> ROOT_KEY="$CA_DIR/root-ca-key.pem"
[?2004l[?2004h> ROOT_CERT="$CA_DIR/root-ca.pem"
[?2004l[?2004h> openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
[?2004l[?2004h>   -subj "/CN=Software Signing Root CA/O=SecureBuild/C=US" \
[?2004l[?2004h>   -addext "basicConstraints=critical,CA:TRUE" \
[?2004l[?2004h>   -addext "keyUsage=critical,keyCertSign,cRLSign" \
[?2004l[?2004h>   -keyout "$ROOT_KEY" -out "$ROOT_CERT"
[?2004l[?2004h> 
[?2004l[?2004h> # Intermediate CA key and CSR
[?2004l[?2004h> INT_KEY="$CA_DIR/intermediate-ca-key.pem"
[?2004l[?2004h> INT_CSR="$CA_DIR/intermediate-ca.csr"
[?2004l[?2004h> openssl req -new -newkey rsa:4096 -sha256 -nodes \
[?2004l[?2004h>   -subj "/CN=Build Pipeline Intermediate CA/O=SecureBuild/C=US" \
[?2004l[?2004h>   -keyout "$INT_KEY" -out "$INT_CSR"
[?2004l[?2004h> 
[?2004l[?2004h> # Create a temporary OpenSSL config for CA extensions
[?2004l[?2004h> EXTFILE=$(mktemp)
[?2004l[?2004h> cat > "$EXTFILE" <<'EOT'
[?2004l[?2004h> [ v3_ca ]
[?2004l[?2004h> basicConstraints=critical,CA:TRUE,pathlen:0
[?2004l[?2004h> keyUsage=critical,keyCertSign,digitalSignature
[?2004l[?2004h> EOT
[?2004l[?2004h> 
[?2004l[?2004h> # Sign Intermediate CA with Root CA using the extensions file
[?2004l[?2004h> INT_CERT="$CA_DIR/intermediate-ca.pem"
[?2004l[?2004h> openssl x509 -req -in "$INT_CSR" -CA "$ROOT_CERT" -CAkey "$ROOT_KEY" -CAcreateserial \
[?2004l[?2004h>   -days 1825 -sha256 -extfile "$EXTFILE" -extensions v3_ca -out "$INT_CERT"
[?2004l[?2004h> 
[?2004l[?2004h> # Clean up temporary files
[?2004l[?2004h> rm -f "$INT_CSR" "$CA_DIR/root-ca.srl" "$EXTFILE"
[?2004l[?2004h> EOS
