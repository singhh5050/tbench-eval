[84.088238, "i", "cat > /app/sign_artifact.sh <<'EOS'\n#!/usr/bin/env bash\nset -euo pipefail\n\nif [[ $# -ne 2 ]]; then\n  echo \"Usage: $0 <artifact-path> <build-id>\"\n  exit 1\nfi\n\nARTIFACT=\"$1\"\nBUILD_ID=\"$2\"\nBASE_NAME=\"$(basename \"$ARTIFACT\")\"\n\n# Verify artifact exists\nif [[ ! -f \"$ARTIFACT\" ]]; then\n  echo \"Artifact not found: $ARTIFACT\"\n  exit 1\nfi\n\n# Compute checksum\nCHECKSUM=$(sha256sum \"$ARTIFACT\" | awk '{print $1}')\n\n# Directories\nSIGNING_DIR=\"/app/signing\"\nSIGNED_DIR=\"/app/signed\"\nCA_DIR=\"/app/ca\"\n\n# Ephemeral EC key (P‑256)\nEPHEMERAL_KEY=\"$SIGNING_DIR/key_${BUILD_ID}.pem\"\nopenssl ecparam -name prime256v1 -genkey -noout -out \"$EPHEMERAL_KEY\"\n\n# CSR for signing certificate\nCSR=\"$SIGNING_DIR/csr_${BUILD_ID}.pem\"\nopenssl req -new -key \"$EPHEMERAL_KEY\" -subj \"/CN=build-${BUILD_ID},O=SecureBuild,C=US\" -out \"$CSR\"\n\n# Signing certificate (valid 1 day)\nCERT=\"$SIGNING_DIR/cert_${BUILD_ID}.pem\"\nopenssl x509 -req -in \"$CSR\" -CA \"$CA_DIR/intermediate-ca.pem\" -CAkey \"$CA_DIR/intermediate-ca-key.pem\" -CAcreateserial \\\n  -days 1 -sha256 \\\n  -addext \"basicConstraints=critical,CA:FALSE\" \\\n  -addext \"keyUsage=critical,digitalSignature\" \\\n  -out \"$CERT\"\n\n# Sign the artifact\nSIG_FILE=\"$SIGNED_DIR/${BASE_NAME}.sig\"\nopenssl dgst -sha256 -sign \"$EPHEMERAL_KEY\" -out \"$SIG_FILE\" \"$ARTIFACT\"\n\n# Create provenance JSON\nTIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)\nPROV_JSON=\"$SIGNED_DIR/${BASE_NAME}.provenance.json\"\ncat > \"$PROV_JSON\" <<JSON\n{\n  \"buildID\": \"${BUILD_ID}\",\n  \"artifact\": \"${BASE_NAME}\",\n  \"sha256\": \"${CHECKSUM}\",\n  \"signedAt\": \"${TIMESTAMP}\",\n  \"signer\": \"build-${BUILD_ID}\",\n  \"certificateChain\": [\"intermediate-ca\", \"root-ca\"]\n}\nJSON\n\n# Sign provenance JSON\nPROV_SIG=\"$SIGNED_DIR/${BASE_NAME}.provenance.sig\"\nopenssl dgst -sha256 -sign \"$EPHEMERAL_KEY\" -out \"$PROV_SIG\" \"$PROV_JSON\"\n\n# Assemble certificate chain (signing cert + intermediate + root)\nCHAIN_FILE=\"$SIGNED_DIR/${BASE_NAME}.chain.pem\"\ncat \"$CERT\" \"$CA_DIR/intermediate-ca.pem\" \"$CA_DIR/root-ca.pem\" > \"$CHAIN_FILE\"\n\n# Cleanup: delete private key and CSR\nrm -f \"$EPHEMERAL_KEY\" \"$CSR\"\nEOS\n"]
