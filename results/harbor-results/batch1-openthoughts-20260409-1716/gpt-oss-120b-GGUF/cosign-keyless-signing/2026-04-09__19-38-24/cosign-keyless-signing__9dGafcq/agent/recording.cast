[193.952164, "o", "CHECKSUM=$(sha256sum \"$ARTIFACT\" | awk '{print $1}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[193.95221, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.952234, "o", "# Directories\r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.952252, "o", "SIGNING_DIR=\"/app/signing\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.952277, "o", "SIGNED_DIR=\"/app/signed\"\r\n\u001b[?2004l\r"]
[193.952288, "o", "\u001b[?2004h> "]
[193.952311, "o", "CA_DIR=\"/app/ca\"\r\n\u001b[?2004l\r"]
[193.952331, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[193.952346, "o", "> "]
[193.952364, "o", "# Ephemeral EC key (P‑256)\r\n\u001b[?2004l\r"]
[193.952382, "o", "\u001b[?2004h> "]
[193.952424, "o", "EPHEMERAL_KEY=\"$SIGNING_DIR/key_${BUILD_ID}.pem\"\r\n\u001b[?2004l\r"]
[193.952434, "o", "\u001b[?2004h> "]
[193.952503, "o", "openssl ecparam -name prime256v1 -genkey -noout -out \"$EPHEMERAL_KEY\"\r\n\u001b[?2004l\r"]
[193.952522, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[193.952539, "o", "\u001b[?2004h> "]
[193.952563, "o", "# CSR for signing certificate\r\n\u001b[?2004l\r"]
[193.952584, "o", "\u001b[?2004h> "]
[193.95262, "o", "CSR=\"$SIGNING_DIR/csr_${BUILD_ID}.pem\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.952753, "o", "openssl req -new -key \"$EPHEMERAL_KEY\" -subj \"/CN=build-${BUILD_ID},O=SecureBuild,C=US\" -out \"$CSR\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[193.952785, "o", "> "]
[193.952843, "o", "# Create temporary extensions file for the signing certificate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.952873, "o", "EXTFILE=$(mktemp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.952896, "o", "cat > \"$EXTFILE\" <<'EOT'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.952907, "o", "[ v3_sign ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[193.952918, "o", "> "]
[193.952952, "o", "basicConstraints=critical,CA:FALSE\r\n\u001b[?2004l\r"]
[193.952971, "o", "\u001b[?2004h> "]
[193.953018, "o", "keyUsage=critical,digitalSignature\r\n\u001b[?2004l\r"]
[193.953029, "o", "\u001b[?2004h> "]
[193.953058, "o", "EOT\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[193.953179, "o", "> # Signing certificate (valid 1 day)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.954053, "o", "CERT=\"$SIGNING_DIR/cert_${BUILD_ID}.pem\"\r\n\u001b[?2004l\r\u001b[?2004h> openssl x509 -req -in \"$CSR\" -CA \"$CA_DIR/intermediate-ca.pem\" -CAkey \"$CA_DIR/intermediate-ca-key.pem\" -CAcreateserial \\\r\n\u001b[?2004l\r\u001b[?2004h>   -days 1 -sha256 -extfile \"$EXTFILE\" -extensions v3_sign -out \"$CERT\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Clean up the temporary extensions file\r\n\u001b[?2004l\r\u001b[?2004h> rm -f \"$EXTFILE\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Sign the artifact\r\n\u001b[?2004l\r\u001b[?2004h> SIG_FILE=\"$SIGNED_DIR/${BASE_NAME}.sig\"\r\n\u001b[?2004l\r\u001b[?2004h> openssl dgst -sha256 -sign \"$EPHEMERAL_KEY\" -out \"$SIG_FILE\" \"$ARTIFACT\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Create provenance JSON\r\n\u001b[?2004l\r\u001b[?2004h> TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)\r\n\u001b[?2004l\r\u001b[?2004h> PROV_JSON=\"$SIGNED_DIR/${BASE_NAME}.provenance.json\"\r\n\u001b[?2004l\r\u001b[?2004h> cat > \"$PROV_JSON\" <<JSON\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h>   \"buildID\": \"${BUILD_ID}\",\r\n\u001b[?2004l\r\u001b[?2004h>   \"artifact\": \"${BASE_NAME}\",\r\n\u001b[?2004l\r\u001b[?2004h>   \"sha256\": \"${CHECKSUM}\",\r\n\u001b[?2004l\r\u001b[?2004h>   \"signedAt\": \"${TIMESTAMP}\",\r\n\u001b[?2004l\r\u001b[?2004h>   \"signer\": \"build-${BUILD_ID}\",\r\n\u001b[?2004l\r"]
[193.954084, "o", "\u001b[?2004h> "]
[193.954098, "o", "  \"certificateChain\": [\"intermediate-ca\", \"root-ca\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.954126, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> JSON\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[193.954148, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[193.954169, "o", "# Sign provenance JSON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.954216, "o", "PROV_SIG=\"$SIGNED_DIR/${BASE_NAME}.provenance.sig\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.954282, "o", "openssl dgst -sha256 -sign \"$EPHEMERAL_KEY\" -out \"$PROV_SIG\" \"$PROV_JSON\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[193.954302, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.954362, "o", "# Assemble certificate chain (signing cert + intermediate + root)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.954405, "o", "CHAIN_FILE=\"$SIGNED_DIR/${BASE_NAME}.chain.pem\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[193.954424, "o", "> "]
[193.954481, "o", "cat \"$CERT\" \"$CA_DIR/intermediate-ca.pem\" \"$CA_DIR/root-ca.pem\" > \"$CHAIN_FILE\"\r\n\u001b[?2004l\r"]
[193.9545, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[193.954536, "o", "# Cleanup: delete private key and CSR\r\n\u001b[?2004l\r"]
[193.954585, "o", "\u001b[?2004h> "]
[193.954613, "o", "rm -f \"$EPHEMERAL_KEY\" \"$CSR\"\r\n\u001b[?2004l\r\u001b[?2004h> EOS\r\n\u001b[?2004l\r"]
[193.95551, "o", "\u001b[?2004hroot@874732d32470:/app# "]
[194.54645, "i", "chmod +x /app/sign_artifact.sh\n"]
[194.546747, "o", "chmod +x /app/sign_artifact.sh\r\n\u001b[?2004l\r"]
[194.547599, "o", "\u001b[?2004hroot@874732d32470:/app# "]
[194.645397, "i", "/app/sign_artifact.sh /app/artifacts/app.bin build-001\n"]
[194.645623, "o", "/app/sign_artifact.sh /app/artifacts/app.bin build-001\r\n\u001b[?2004l\r"]
[194.667416, "o", "Certificate request self-signature ok\r\nsubject=CN=build-build-001,O=SecureBuild,C=US\r\n"]
[194.68529, "o", "\u001b[?2004hroot@874732d32470:/app# "]
[195.643531, "i", "/app/verify_artifact.sh /app/artifacts/app.bin\n"]
[195.643826, "o", "/app/verify_artifact.sh /app/artifacts/app.bin\r\n\u001b[?2004l\r"]
[195.677488, "o", "VERIFICATION_PASSED\r\n"]
[195.677713, "o", "\u001b[?2004hroot@874732d32470:/app# "]
