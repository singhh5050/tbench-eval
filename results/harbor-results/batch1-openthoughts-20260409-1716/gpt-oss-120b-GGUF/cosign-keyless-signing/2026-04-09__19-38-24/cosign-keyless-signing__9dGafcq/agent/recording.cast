[84.689341, "o", "\u001b[?2004hroot@874732d32470:/app# "]
[84.788158, "i", "cat > /app/verify_artifact.sh <<'EOS'\n#!/usr/bin/env bash\nset -euo pipefail\n\nif [[ $# -ne 1 ]]; then\n  echo \"Usage: $0 <artifact-path>\"\n  exit 1\nfi\n\nARTIFACT=\"$1\"\nBASE_NAME=\"$(basename \"$ARTIFACT\")\"\nSIGNED_DIR=\"/app/signed\"\nCA_DIR=\"/app/ca\"\n\n# Expected files\nSIG_FILE=\"$SIGNED_DIR/${BASE_NAME}.sig\"\nPROV_JSON=\"$SIGNED_DIR/${BASE_NAME}.provenance.json\"\nPROV_SIG=\"$SIGNED_DIR/${BASE_NAME}.provenance.sig\"\nCHAIN_FILE=\"$SIGNED_DIR/${BASE_NAME}.chain.pem\"\n\n# Verify existence\nfor f in \"$ARTIFACT\" \"$SIG_FILE\" \"$PROV_JSON\" \"$PROV_SIG\" \"$CHAIN_FILE\"; do\n  if [[ ! -f \"$f\" ]]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\n  fi\ndone\n\n# Extract signing certificate (first cert in chain)\nSIGNING_CERT=\"/tmp/signing_cert_$$.pem\"\nawk 'BEGIN{c=0} /-----BEGIN CERTIFICATE-----/{c++} c==1' \"$CHAIN_FILE\" > \"$SIGNING_CERT\"\n\n# Verify chain: signing cert -> intermediate -> root\n# intermediate is the second cert in chain\nINTERMEDIATE_CERT=\"/tmp/intermediate_cert_$$.pem\"\nawk 'BEGIN{c=0} /-----BEGIN CERTIFICATE-----/{c++} c==2' \"$CHAIN_FILE\" > \"$INTERMEDIATE_CERT\"\n\n# Verify intermediate is signed by root and signing cert by intermediate\nopenssl verify -CAfile \"$CA_DIR/root-ca.pem\" -untrusted \"$INTERMEDIATE_CERT\" \"$SIGNING_CERT\" > /dev/null 2>&1 || {\n  echo \"VERIFICATION_FAILED\"\n  rm -f \"$SIGNING_CERT\" \"$INTERMEDIATE_CERT\"\n  exit 1\n}\n\n# Extract public key from signing certificate\nPUBKEY=\"/tmp/pubkey_$$.pem\"\nopenssl x509 -in \"$SIGNING_CERT\" -pubkey -noout > \"$PUBKEY\"\n\n# Verify artifact signature\nopenssl dgst -sha256 -verify \"$PUBKEY\" -signature \"$SIG_FILE\" \"$ARTIFACT\" > /dev/null 2>&1 || {\n  echo \"VERIFICATION_FAILED\"\n  rm -f \"$SIGNING_CERT\" \"$INTERMEDIATE_CERT\" \"$PUBKEY\"\n  exit 1\n}\n\n# Verify provenance signature\nopenssl dgst -sha256 -verify \"$PUBKEY\" -signature \"$PROV_SIG\" \"$PROV_JSON\" > /dev/null 2>&1 || {\n  echo \"VERIFICATION_FAILED\"\n  rm -f \"$SIGNING_CERT\" \"$INTERMEDIATE_CERT\" \"$PUBKEY\"\n  exit 1\n}\n\n# Validate provenance content\nEXPECTED_CHECKSUM=$(sha256sum \"$ARTIFACT\" | awk '{print $1}')\n# Use jq to parse fields (jq must be installed)\nART_NAME=$(jq -r '.artifact' \"$PROV_JSON\")\nPROV_CHECKSUM=$(jq -r '.sha256' \"$PROV_JSON\")\nBUILD_ID=$(jq -r '.buildID' \"$PROV_JSON\")\nSIGNED_AT=$(jq -r '.signedAt' \"$PROV_JSON\")\nSIGNER=$(jq -r '.signer' \"$PROV_JSON\")\n\nif [[ \"$ART_NAME\" != \"$BASE_NAME\" ]] || [[ \"$PROV_CHECKSUM\" != \"$EXPECTED_CHECKSUM\" ]] || [[ -z \"$BUILD_ID\" ]] || [[ -z \"$SIGNED_AT\" ]] || [[ -z \"$SIGNER\" ]]; then\n  echo \"VERIFICATION_FAILED\"\n  rm -f \"$SIGNING_CERT\" \"$INTERMEDIATE_CERT\" \"$PUBKEY\"\n  exit 1\nfi\n\n# Clean up temp files\nrm -f \"$SIGNING_CERT\" \"$INTERMEDIATE_CERT\" \"$PUBKEY\"\n\necho \"VERIFICATION_PASSED\"\nexit 0\nEOS\n"]
