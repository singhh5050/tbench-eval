[152.699709, "i", "cat > /app/setup_ca.sh <<'EOS'\n#!/usr/bin/env bash\nset -euo pipefail\n\n# Directories\nCA_DIR=\"/app/ca\"\n\n# Clean any existing CA files\nrm -rf \"$CA_DIR\"/*\n\n# Root CA\nROOT_KEY=\"$CA_DIR/root-ca-key.pem\"\nROOT_CERT=\"$CA_DIR/root-ca.pem\"\nopenssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \\\n  -subj \"/CN=Software Signing Root CA/O=SecureBuild/C=US\" \\\n  -addext \"basicConstraints=critical,CA:TRUE\" \\\n  -addext \"keyUsage=critical,keyCertSign,cRLSign\" \\\n  -keyout \"$ROOT_KEY\" -out \"$ROOT_CERT\"\n\n# Intermediate CA key and CSR\nINT_KEY=\"$CA_DIR/intermediate-ca-key.pem\"\nINT_CSR=\"$CA_DIR/intermediate-ca.csr\"\nopenssl req -new -newkey rsa:4096 -sha256 -nodes \\\n  -subj \"/CN=Build Pipeline Intermediate CA/O=SecureBuild/C=US\" \\\n  -keyout \"$INT_KEY\" -out \"$INT_CSR\"\n\n# Create a temporary OpenSSL config for CA extensions\nEXTFILE=$(mktemp)\ncat > \"$EXTFILE\" <<'EOT'\n[ v3_ca ]\nbasicConstraints=critical,CA:TRUE,pathlen:0\nkeyUsage=critical,keyCertSign,digitalSignature\nEOT\n\n# Sign Intermediate CA with Root CA using the extensions file\nINT_CERT=\"$CA_DIR/intermediate-ca.pem\"\nopenssl x509 -req -in \"$INT_CSR\" -CA \"$ROOT_CERT\" -CAkey \"$ROOT_KEY\" -CAcreateserial \\\n  -days 1825 -sha256 -extfile \"$EXTFILE\" -extensions v3_ca -out \"$INT_CERT\"\n\n# Clean up temporary files\nrm -f \"$INT_CSR\" \"$CA_DIR/root-ca.srl\" \"$EXTFILE\"\nEOS\n"]
[152.699933, "o", "cat > /app/setup_ca.sh <<'EOS'\r\n\u001b[?2004l\r"]
