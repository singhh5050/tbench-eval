[84.791255, "o", "\u001b[?2004h> "]
[84.791291, "o", "SIGNED_AT=$(jq -r '.signedAt' \"$PROV_JSON\")\r\n\u001b[?2004l\r"]
[84.791321, "o", "\u001b[?2004h> "]
[84.791347, "o", "SIGNER=$(jq -r '.signer' \"$PROV_JSON\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[84.791359, "o", "\u001b[?2004h> "]
[84.791484, "o", "if [[ \"$ART_NAME\" != \"$BASE_NAME\" ]] || [[ \"$PROV_CHECKSUM\" != \"$EXPECTED_CHECKSUM\" ]] || [[ -z \"$BUILD_ID\" ]] || [[ -z \"$SIGNED_AT\" ]] || [[ -z \"$SIGNER\" ]]; then\r\n\u001b[?2004l\r"]
[84.791494, "o", "\u001b[?2004h> "]
[84.791518, "o", "  echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r"]
