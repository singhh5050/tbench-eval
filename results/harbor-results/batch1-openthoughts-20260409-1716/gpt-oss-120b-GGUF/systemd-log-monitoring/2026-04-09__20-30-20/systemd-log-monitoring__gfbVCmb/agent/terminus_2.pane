[?2004l[?2004h>         "level": level,
[?2004l[?2004h>         "message": message,
[?2004l[?2004h>         "service": "myapp"
[?2004l[?2004h>     }
[?2004l[?2004h>     logger.info(json.dumps(entry))
[?2004l[?2004h> 
[?2004l[?2004h> # Startup event
[?2004l[?2004h> log_event('INFO', 'Service started')
[?2004l[?2004h> 
[?2004l[?2004h> while True:
[?2004l[?2004h>     # Periodic heartbeat (INFO)
