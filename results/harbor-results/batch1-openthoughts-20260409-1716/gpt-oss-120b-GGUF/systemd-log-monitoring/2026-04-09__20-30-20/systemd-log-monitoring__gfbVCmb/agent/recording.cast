[71.60939, "i", "cat > /usr/local/bin/check_service_health.sh <<'EOF'\n#!/usr/bin/env bash\nSERVICE=\"myapp\"\nWINDOW=\"5 minutes\"\nNOW=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\n# Count restarts (systemd reports \"Started\" in MESSAGE)\nRESTARTS=$(journalctl -u \"$SERVICE\" --since \"5 minutes ago\" -o cat | grep -c \"Started\")\n# Count error events (JSON level field)\nERRORS=$(journalctl -u \"$SERVICE\" --since \"5 minutes ago\" -o cat | grep -c \"\\\"level\\\":\\\"ERROR\\\"\")\nRESTART_LOOP_DETECTED=false\nif [ \"$RESTARTS\" -gt 3 ]; then\n    RESTART_LOOP_DETECTED=true\nfi\ncat <<JSON\n{\n  \"service\": \"$SERVICE\",\n  \"time_window\": \"5 minutes\",\n  \"restarts\": $RESTARTS,\n  \"errors\": $ERRORS,\n  \"restart_loop_detected\": $RESTART_LOOP_DETECTED,\n  \"timestamp\": \"$NOW\"\n}\nJSON\nEOF\n"]
