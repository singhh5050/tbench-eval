[64.765755, "o", "\u001b[?2004h> "]
[64.765782, "o", "u_prev = np.zeros(3, dtype=np.float64)\r\n\u001b[?2004l\r"]
[64.765794, "o", "\u001b[?2004h> "]
[64.765824, "o", "v_prev = np.zeros(3, dtype=np.float64)\r\n\u001b[?2004l\r"]
[64.765836, "o", "\u001b[?2004h> "]
[64.765884, "o", "# Initial acceleration from equation of motion: M*a0 = -M*I*ug0\r\n\u001b[?2004l\r"]
[64.765896, "o", "\u001b[?2004h> "]
[64.765908, "o", "ug0 = ug[0]\r\n\u001b[?2004l\r"]
[64.765921, "o", "\u001b[?2004h> "]
[64.765955, "o", "a_prev = -I * ug0  # because M cancels out\r\n\u001b[?2004l\r"]
[64.765966, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[64.765979, "o", "> "]
[64.765994, "o", "# Containers for results\r\n\u001b[?2004l\r"]
[64.766007, "o", "\u001b[?2004h> "]
[64.766046, "o", "u_hist = np.empty((len(time), 3), dtype=np.float64)\r\n\u001b[?2004l\r"]
[64.766058, "o", "\u001b[?2004h> "]
[64.766079, "o", "# Store initial state\r\n\u001b[?2004l\r"]
[64.766092, "o", "\u001b[?2004h> "]
[64.766113, "o", "u_hist[0, :] = u_prev\r\n\u001b[?2004l\r"]
[64.766127, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.76615, "o", "# Time stepping loop\r\n\u001b[?2004l\r"]
[64.766163, "o", "\u001b[?2004h> "]
[64.766185, "o", "for i in range(1, len(time)):\r\n\u001b[?2004l\r"]
[64.766195, "o", "\u001b[?2004h> "]
[64.766208, "o", "    ug_i = ug[i]\r\n\u001b[?2004l\r"]
[64.76622, "o", "\u001b[?2004h> "]
[64.766242, "o", "    # Effective load vector\r\n\u001b[?2004l\r"]
[64.766254, "o", "\u001b[?2004h> "]
[64.766276, "o", "    term1 = -M @ (I * ug_i)\r\n\u001b[?2004l\r"]
[64.766288, "o", "\u001b[?2004h> "]
[64.76633, "o", "    term2 = M @ (a0 * u_prev + a2 * v_prev + a3 * a_prev)\r\n\u001b[?2004l\r"]
[64.766342, "o", "\u001b[?2004h> "]
[64.766385, "o", "    term3 = C @ (a1 * u_prev + a4 * v_prev + a5 * a_prev)\r\n\u001b[?2004l\r"]
[64.766398, "o", "\u001b[?2004h> "]
[64.766423, "o", "    P_hat = term1 + term2 + term3\r\n\u001b[?2004l\r"]
[64.766435, "o", "\u001b[?2004h> "]
[64.766459, "o", "    # Solve for new displacement\r\n\u001b[?2004l\r"]
[64.76647, "o", "\u001b[?2004h> "]
[64.766504, "o", "    u_new = np.linalg.solve(K_hat, P_hat)\r\n\u001b[?2004l\r"]
[64.766516, "o", "\u001b[?2004h> "]
[64.766564, "o", "    # Update acceleration and velocity (exact Newmark formulas)\r\n\u001b[?2004l\r"]
[64.766577, "o", "\u001b[?2004h> "]
[64.766623, "o", "    a_new = a0 * (u_new - u_prev) - a2 * v_prev - a3 * a_prev\r\n\u001b[?2004l\r"]
[64.766636, "o", "\u001b[?2004h> "]
[64.766685, "o", "    v_new = v_prev + dt * ((1.0 - gamma) * a_prev + gamma * a_new)\r\n\u001b[?2004l\r"]
[64.766699, "o", "\u001b[?2004h> "]
[64.766712, "o", "    # Store\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.766727, "o", "> "]
[64.766743, "o", "    u_hist[i, :] = u_new\r\n\u001b[?2004l\r"]
[64.766753, "o", "\u001b[?2004h> "]
[64.766776, "o", "    # Prepare for next step\r\n\u001b[?2004l\r"]
[64.766787, "o", "\u001b[?2004h> "]
[64.766823, "o", "    u_prev, v_prev, a_prev = u_new, v_new, a_new\r\n\u001b[?2004l\r"]
[64.766836, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.766848, "o", "\u001b[?2004h> "]
[64.766869, "o", "# ----- Write results -----\r\n\u001b[?2004l\r"]
[64.766881, "o", "\u001b[?2004h> "]
[64.766924, "o", "output_path = '/app/output/response.csv'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.766971, "o", "# Prepare DataFrame with required formatting\r\n\u001b[?2004l\r"]
[64.766981, "o", "\u001b[?2004h> "]
[64.767012, "o", "out_df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[64.767023, "o", "\u001b[?2004h> "]
[64.767063, "o", "    'time': np.round(time, 3),\r\n\u001b[?2004l\r"]
[64.767077, "o", "\u001b[?2004h> "]
[64.767102, "o", "    'u1': np.round(u_hist[:, 0], 6),\r\n\u001b[?2004l\r"]
[64.767115, "o", "\u001b[?2004h> "]
[64.767141, "o", "    'u2': np.round(u_hist[:, 1], 6),\r\n\u001b[?2004l\r"]
[64.767151, "o", "\u001b[?2004h> "]
[64.767199, "o", "    'u3': np.round(u_hist[:, 2], 6)\r\n\u001b[?2004l\r"]
[64.767212, "o", "\u001b[?2004h> "]
[64.767225, "o", "})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.767286, "o", "# Ensure three decimal places for time and six for displacements in the CSV\r\n\u001b[?2004l\r"]
[64.767298, "o", "\u001b[?2004h> "]
[64.767345, "o", "out_df.to_csv(output_path, index=False, float_format='%.6f')\r\n\u001b[?2004l\r"]
[64.767357, "o", "\u001b[?2004h> "]
[64.767408, "o", "print(f\"Simulation completed. Results written to {output_path}\")\r\n\u001b[?2004l\r"]
[64.76742, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
