[64.761508, "i", "cat > /app/run_simulation.py << 'PY'\n#!/usr/bin/env python3\nimport numpy as np, pandas as pd, os, sys\nfrom scipy.linalg import eigh\n\n# ----- Parameters -----\nmass_val = 2000.0  # kg per floor\nstiff_val = 400000.0  # N/m per story\nzeta = 0.02  # target damping ratio\n\ng = 9.81  # m/s^2 per G\n\n# ----- Load ground motion -----\ninput_path = '/app/data/ground_motion.csv'\nif not os.path.isfile(input_path):\n    sys.stderr.write(f\"Input file {input_path} not found\\n\")\n    sys.exit(1)\n\ndata = pd.read_csv(input_path)\n# Expect columns: time, accel_g\nif not {'time', 'accel_g'}.issubset(data.columns):\n    sys.stderr.write(\"CSV must contain 'time' and 'accel_g' columns\\n\")\n    sys.exit(1)\n\ntime = data['time'].to_numpy(dtype=np.float64)\naccel_g = data['accel_g'].to_numpy(dtype=np.float64)\n# Convert ground acceleration to m/s^2\nug = accel_g * g\n\n# Time step (assumed constant)\nif len(time) < 2:\n    sys.stderr.write(\"Not enough time steps in input data\\n\")\n    sys.exit(1)\n\ndt = time[1] - time[0]\n# Simple safety check for unifor"]
[64.761654, "i", "m step\nif not np.allclose(np.diff(time), dt, atol=1e-9):\n    sys.stderr.write(\"Time step is not constant; aborting\\n\")\n    sys.exit(1)\n\n# ----- Build system matrices -----\nM = np.diag([mass_val, mass_val, mass_val])\n# Stiffness matrix for 3‑story shear building\nk1 = k2 = k3 = stiff_val\nK = np.array([\n    [k1 + k2, -k2,      0.0],\n    [-k2,      k2 + k3, -k3],\n    [0.0,     -k3,       k3]\n], dtype=np.float64)\n\n# ----- Rayleigh damping coefficients (alpha, beta) -----\n# Solve generalized eigenproblem K*phi = omega^2 * M * phi\nomega2, _ = eigh(K, M)\n# Ensure sorting (eigh returns ascending order)\nomega = np.sqrt(np.maximum(omega2, 0.0))\n# First and third modes (indices 0 and 2)\nomega1 = omega[0]\nomega3 = omega[2]\n# Linear system: [1/omega_i, omega_i] * [alpha, beta]^T = 2*zeta\nA = np.array([[1.0/omega1, omega1],\n              [1.0/omega3, omega3]])\nB = np.full(2, 2.0 * zeta)\nalpha, beta = np.linalg.solve(A, B)\nC = alpha * M + beta * K\n\n# ----- Newmark‑Beta integration (average acceleration) -----\ngamma = 0.5"]
[64.761682, "o", "cat > /app/run_simulation.py << 'PY'\r\n\u001b[?2004l\r\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[64.761706, "i", "\nbeta_nb = 0.25\n\n# Integration constants\na0 = 1.0 / (beta_nb * dt ** 2)\na1 = gamma / (beta_nb * dt)\na2 = 1.0 / (beta_nb * dt)\na3 = 1.0 / (2.0 * beta_nb) - 1.0\n# Additional constants used in effective load vector\na4 = gamma / beta_nb - 1.0\na5 = dt * (gamma / (2.0 * beta_nb) - 1.0)\n\n# Effective stiffness matrix (constant for linear system)\nK_hat = K + a0 * M + a1 * C\n\n# Influence vector (all floors move with ground)\nI = np.ones(3, dtype=np.float64)\n\n# Initial conditions (zero displacement and velocity)\nu_prev = np.zeros(3, dtype=np.float64)\nv_prev = np.zeros(3, dtype=np.float64)\n# Initial acceleration from equation of motion: M*a0 = -M*I*ug0\nug0 = ug[0]\na_prev = -I * ug0  # because M cancels out\n\n# Containers for results\nu_hist = np.empty((len(time), 3), dtype=np.float64)\n# Store initial state\nu_hist[0, :] = u_prev\n\n# Time stepping loop\nfor i in range(1, len(time)):\n    ug_i = ug[i]\n    # Effective load vector\n    term1 = -M @ (I * ug_i)\n    term2 = M @ (a0 * u_prev + a2 * v_prev + a3 * a_prev)\n    term3 = C @ "]
[64.761781, "o", "\u001b[?2004h> import numpy as np, pandas as pd, os, sys\r\n\u001b[?2004l\r"]
[64.761837, "i", "(a1 * u_prev + a4 * v_prev + a5 * a_prev)\n    P_hat = term1 + term2 + term3\n    # Solve for new displacement\n    u_new = np.linalg.solve(K_hat, P_hat)\n    # Update acceleration and velocity (exact Newmark formulas)\n    a_new = a0 * (u_new - u_prev) - a2 * v_prev - a3 * a_prev\n    v_new = v_prev + dt * ((1.0 - gamma) * a_prev + gamma * a_new)\n    # Store\n    u_hist[i, :] = u_new\n    # Prepare for next step\n    u_prev, v_prev, a_prev = u_new, v_new, a_new\n\n# ----- Write results -----\noutput_path = '/app/output/response.csv'\n# Prepare DataFrame with required formatting\nout_df = pd.DataFrame({\n    'time': np.round(time, 3),\n    'u1': np.round(u_hist[:, 0], 6),\n    'u2': np.round(u_hist[:, 1], 6),\n    'u3': np.round(u_hist[:, 2], 6)\n})\n# Ensure three decimal places for time and six for displacements in the CSV\nout_df.to_csv(output_path, index=False, float_format='%.6f')\nprint(f\"Simulation completed. Results written to {output_path}\")\nPY\n"]
