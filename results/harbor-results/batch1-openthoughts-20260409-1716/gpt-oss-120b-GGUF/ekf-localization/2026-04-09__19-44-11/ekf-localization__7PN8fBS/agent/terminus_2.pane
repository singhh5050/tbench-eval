[?2004l[?2004h> stiff_val = 400000.0  # N/m per story
[?2004l[?2004h> zeta = 0.02  # target damping ratio
[?2004l[?2004h> 
[?2004l[?2004h> g = 9.81  # m/s^2 per G
[?2004l[?2004h> 
[?2004l[?2004h> # ----- Load ground motion -----
