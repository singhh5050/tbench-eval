[?2004l[?2004h> if not {'time', 'accel_g'}.issubset(data.columns):
[?2004l[?2004h>     sys.stderr.write("CSV must contain 'time' and 'accel_g' columns\n")
[?2004l[?2004h>     sys.exit(1)
[?2004l[?2004h> 
