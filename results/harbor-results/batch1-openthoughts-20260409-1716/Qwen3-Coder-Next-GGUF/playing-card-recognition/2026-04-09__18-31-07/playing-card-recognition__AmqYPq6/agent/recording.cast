[191.736233, "i", "python3 << 'EOF'\ntry:\n    import pytesseract\n    print('pytesseract available')\nexcept:\n    print('pytesseract not available')\n\nimport cv2\nimport numpy as np\n\nfor i in range(1, 7):\n    filepath = f'/workdir/data/cards/card_{i}.png'\n    img = cv2.imread(filepath)\n    \n    # Extract rank area (top left)\n    rank_area = img[5:80, 5:90]\n    \n    # Convert to grayscale and threshold\n    gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)\n    _, binary = cv2.threshold(gray, 200, 255, cv2.THRESH_BINARY)\n    \n    # Save for OCR\n    cv2.imwrite(f'/tmp/rank_{i}_ocr.jpg', binary)\n    \n    print(f'card_{i}.png rank area saved')\nEOF\n"]
