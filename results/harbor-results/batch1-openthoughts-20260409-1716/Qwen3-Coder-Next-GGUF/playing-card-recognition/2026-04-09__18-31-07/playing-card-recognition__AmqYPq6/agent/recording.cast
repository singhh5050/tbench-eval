[147.332987, "i", "python3 << 'EOF'\nfrom PIL import Image\nimport os\n\nfor i in range(1, 7):\n    filepath = f'/workdir/data/cards/card_{i}.png'\n    img = Image.open(filepath)\n    \n    # Convert RGBA to RGB\n    rgb_img = img.convert('RGB')\n    rgb_img.save(f'/tmp/card_{i}_rgb.jpg')\n    \n    w, h = img.size\n    top_left = img.crop((10, 10, 80, 80))\n    top_left.convert('RGB').save(f'/tmp/top_left_{i}.jpg')\n    \n    center = img.crop((w//2-50, h//2-50, w//2+50, h//2+50))\n    center.convert('RGB').save(f'/tmp/center_{i}.jpg')\n    \n    print(f'card_{i}.png processed')\nEOF\n"]
