[68.868167, "i", "python3 << 'EOF'\nimport cv2\nimport numpy as np\n\nfor i in range(1, 7):\n    filepath = f'/workdir/data/cards/card_{i}.png'\n    img = cv2.imread(filepath)\n    \n    # Extract top-left corner where rank is displayed\n    h, w = img.shape[:2]\n    # The rank is typically in top-left corner\n    rank_area = img[10:80, 10:80]\n    \n    # Save the rank area for inspection\n    cv2.imwrite(f'/tmp/rank_{i}.jpg', rank_area)\n    \n    # Convert to grayscale and threshold\n    gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)\n    _, thresh = cv2.threshold(gray, 127, 255, cv2.THRESH_BINARY_INV)\n    \n    # Find contours\n    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    \n    print(f'card_{i}.png - Rank area contours: {len(contours)}')\n    if contours:\n        areas = [cv2.contourArea(c) for c in contours]\n        print(f'  Largest contour area: {max(areas):.0f}')\nEOF\n"]
