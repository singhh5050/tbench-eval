[158.425155, "i", "python3 << 'EOF'\nimport cv2\nimport numpy as np\n\nfor i in range(1, 7):\n    filepath = f'/workdir/data/cards/card_{i}.png'\n    img = cv2.imread(filepath)\n    \n    # Get the top left corner where rank is\n    rank_area = img[15:65, 15:65]\n    \n    # Convert to grayscale\n    gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)\n    \n    # Apply threshold to get binary image\n    _, binary = cv2threshold(gray, 128, 255, cv2.THRESH_BINARY_INV)\n    \n    # Count connected components\n    num_labels, labels, stats, centroids = cv2.connectedComponentsWithStats(binary)\n    \n    print(f'card_{i}.png - Rank area: {num_labels-1} components (excluding background)')\nEOF\n"]
