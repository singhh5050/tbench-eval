[273.609716, "i", "python3 << 'EOF'\nimport cv2\nimport numpy as np\n\n# Let's look for the specific pattern of '4'\n# A '4' has: vertical line on right, horizontal bar across middle, and sometimes a diagonal\n\nfor i in range(1, 7):\n    filepath = f'/workdir/data/cards/card_{i}.png'\n    img = cv2.imread(filepath)\n    \n    rank_area = img[10:70, 10:70]\n    gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)\n    _, binary = cv2.threshold(gray, 128, 255, cv2.THRESH_BINARY_INV)\n    \n    contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    \n    if contours:\n        x, y, w, h = cv2.boundingRect(max(contours, key=cv2.contourArea))\n        digit = binary[y:y+h, x:x+w]\n        \n        # Check for horizontal bar in middle\n        mid_row = digit[digit.shape[0]//2]\n        mid_black = np.sum(mid_row == 0) / len(mid_row)\n        \n        # Check for vertical bar on right\n        right_col = digit[:, int(3*digit.shape[1]/4):]\n        right_black = np.sum(right_col == 0) / right_col.size\n        \n        # Check "]
[273.609923, "i", "top vs bottom\n        top_half = digit[:digit.shape[0]//2]\n        bottom_half = digit[digit.shape[0]//2:]\n        top_black = np.sum(top_half == 0) / top_half.size\n        bottom_black = np.sum(bottom_half == 0) / bottom_half.size\n        \n        print(f'card_{i}.png - Mid horiz: {mid_black:.2%}, Right vert: {right_black:.2%}, Top: {top_black:.2%}, Bottom: {bottom_black:.2%}')\nEOF\n"]
[273.609939, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import cv2\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r"]
