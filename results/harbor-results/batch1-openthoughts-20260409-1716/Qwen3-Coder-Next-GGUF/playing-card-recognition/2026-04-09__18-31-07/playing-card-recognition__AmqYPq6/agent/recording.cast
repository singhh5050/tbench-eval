[291.23748, "i", "python3 << 'EOF'\nimport cv2\nimport numpy as np\n\n# Let's look for the '4' pattern more systematically\n# '4' typically has: vertical line on right, horizontal bar across middle-right, diagonal from top-left to center\n\nfor i in range(1, 7):\n    filepath = f'/workdir/data/cards/card_{i}.png'\n    img = cv2.imread(filepath)\n    \n    rank_area = img[10:70, 10:70]\n    gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)\n    _, binary = cv2.threshold(gray, 128, 255, cv2.THRESH_BINARY_INV)\n    \n    contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    \n    if contours:\n        x, y, w, h = cv2.boundingRect(max(contours, key=cv2.contourArea))\n        digit = binary[y:y+h, x:x+w]\n        \n        # Divide into 3 vertical sections\n        left = digit[:, :digit.shape[1]//3]\n        mid = digit[:, digit.shape[1]//3:2*digit.shape[1]//3]\n        right = digit[:, 2*digit.shape[1]//3:]\n        \n        left_black = np.sum(left == 0) / left.size\n        mid_black = np.sum(mid == 0) / mid.size\n    "]
[291.237613, "i", "    right_black = np.sum(right == 0) / right.size\n        \n        print(f'card_{i}.png - Left: {left_black:.2%}, Mid: {mid_black:.2%}, Right: {right_black:.2%}')\nEOF\n"]
