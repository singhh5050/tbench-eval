[222.600506, "i", "python3 << 'EOF'\nimport cv2\nimport numpy as np\n\nfor i in range(1, 7):\n    filepath = f'/workdir/data/cards/card_{i}.png'\n    img = cv2.imread(filepath)\n    \n    # Extract rank area\n    rank_area = img[10:70, 10:70]\n    gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)\n    _, binary = cv2.threshold(gray, 128, 255, cv2.THRESH_BINARY_INV)\n    \n    # Find contours\n    contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    \n    if contours:\n        # Get the main contour\n        main_contour = max(contours, key=cv2.contourArea)\n        x, y, w, h = cv2.boundingRect(main_contour)\n        \n        # Calculate aspect ratio\n        aspect_ratio = w / h if h > 0 else 0\n        \n        # Crop the digit\n        digit = binary[y:y+h, x:x+w]\n        \n        # Calculate horizontal and vertical projections\n        vert_proj = np.sum(digit == 0, axis=0)\n        horiz_proj = np.sum(digit == 0, axis=1)\n        \n        # Check if there are gaps in the projection (for '4' pattern)\n        if le"]
[222.600627, "i", "n(vert_proj) > 0:\n            max_v = np.max(vert_proj)\n            min_v = np.min(vert_proj)\n            v_range = max_v - min_v\n        else:\n            v_range = 0\n        \n        print(f'card_{i}.png - W: {w}, H: {h}, Aspect: {aspect_ratio:.2f}, V_range: {v_range}')\nEOF\n"]
