[442.257268, "i", "python3 -c \"\nimport cv2\nimport numpy as np\n\nfor i in [1, 2, 3, 4, 5, 6]:\n    filepath = '/workdir/data/cards/card_' + str(i) + '.png'\n    img = cv2.imread(filepath)\n    rank_area = img[10:70, 10:70]\n    gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)\n    _, binary = cv2.threshold(gray, 128, 255, cv2.THRESH_BINARY_INV)\n    contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    if contours:\n        x, y, w, h = cv2.boundingRect(max(contours, key=cv2.contourArea))\n        digit = binary[y:y+h, x:x+w]\n        right_third = digit[:, int(2*digit.shape[1]/3):]\n        left_two_thirds = digit[:, :int(2*digit.shape[1]/3)]\n        right_black = float(np.sum(right_third == 0)) / right_third.size\n        left_black = float(np.sum(left_two_thirds == 0)) / left_two_thirds.size\n        print('card_' + str(i) + '.png - Right: ' + str(round(right_black*100, 1)) + '%, Left: ' + str(round(left_black*100, 1)) + '%')\n\"\n"]
