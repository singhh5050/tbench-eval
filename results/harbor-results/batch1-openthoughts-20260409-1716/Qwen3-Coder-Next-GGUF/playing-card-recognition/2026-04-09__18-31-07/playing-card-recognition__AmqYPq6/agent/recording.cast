[222.601149, "o", "    contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\r\n\u001b[?2004l\r"]
[222.601162, "o", "\u001b[?2004h> "]
[222.601173, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[222.601184, "o", "> "]
[222.601194, "o", "    if contours:\r\n\u001b[?2004l\r"]
[222.601207, "o", "\u001b[?2004h> "]
[222.601233, "o", "        # Get the main contour\r\n\u001b[?2004l\r"]
[222.601244, "o", "\u001b[?2004h> "]
[222.601291, "o", "        main_contour = max(contours, key=cv2.contourArea)\r\n\u001b[?2004l\r"]
[222.601302, "o", "\u001b[?2004h> "]
[222.601344, "o", "        x, y, w, h = cv2.boundingRect(main_contour)\r\n\u001b[?2004l\r"]
[222.601355, "o", "\u001b[?2004h> "]
[222.601366, "o", "        "]
[222.601376, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[222.601386, "o", "> "]
[222.601411, "o", "        # Calculate aspect ratio\r\n\u001b[?2004l\r"]
[222.601422, "o", "\u001b[?2004h"]
[222.601433, "o", "> "]
[222.601464, "o", "        aspect_ratio = w / h if h > 0 else 0\r\n\u001b[?2004l\r"]
[222.601475, "o", "\u001b[?2004h> "]
[222.601485, "o", "        \r\n\u001b[?2004l\r"]
[222.601496, "o", "\u001b[?2004h> "]
[222.60152, "o", "        # Crop the digit\r\n\u001b[?2004l\r"]
[222.601531, "o", "\u001b[?2004h> "]
[222.601563, "o", "        digit = binary[y:y+h, x:x+w]\r\n\u001b[?2004l\r"]
[222.601573, "o", "\u001b[?2004h> "]
[222.601583, "o", "        \r\n\u001b[?2004l\r"]
[222.601594, "o", "\u001b[?2004h> "]
[222.601652, "o", "        # Calculate horizontal and vertical projections\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.601699, "o", "        vert_proj = np.sum(digit == 0, axis=0)\r\n\u001b[?2004l\r"]
[222.601718, "o", "\u001b[?2004h"]
[222.60173, "o", "> "]
[222.601756, "o", "        horiz_proj = np.sum(digit == 0, axis=1)\r\n\u001b[?2004l\r"]
[222.601766, "o", "\u001b[?2004h> "]
[222.601778, "o", "        \r\n\u001b[?2004l\r"]
[222.60179, "o", "\u001b[?2004h"]
[222.601799, "o", "> "]
[222.60185, "o", "        # Check if there are gaps in the projection (for '4' pattern)\r\n\u001b[?2004l\r"]
[222.601861, "o", "\u001b[?2004h> "]
[222.601889, "o", "        if len(vert_proj) > 0:\r\n\u001b[?2004l\r"]
[222.601902, "o", "\u001b[?2004h> "]
[222.601944, "o", "            max_v = np.max(vert_proj)\r\n\u001b[?2004l\r\u001b[?2004h"]
[222.601956, "o", "> "]
[222.601982, "o", "            min_v = np.min(vert_proj)\r\n\u001b[?2004l\r"]
[222.60199, "o", "\u001b[?2004h"]
[222.602001, "o", "> "]
[222.602026, "o", "            v_range = max_v - min_v\r\n\u001b[?2004l\r"]
[222.602036, "o", "\u001b[?2004h"]
[222.602047, "o", "> "]
[222.602057, "o", "        else:\r\n\u001b[?2004l\r"]
[222.602066, "o", "\u001b[?2004h> "]
[222.602089, "o", "            v_range = 0\r\n\u001b[?2004l\r"]
[222.602097, "o", "\u001b[?2004h"]
[222.602107, "o", "> "]
[222.602115, "o", "        \r\n\u001b[?2004l\r"]
[222.602124, "o", "\u001b[?2004h> "]
[222.602198, "o", "        print(f'card_{i}.png - W: {w}, H: {h}, Aspect: {aspect_ratio:.2f}, V_range: {v_range}')\r\n\u001b[?2004l\r"]
[222.602211, "o", "\u001b[?2004h> "]
[222.60222, "o", "EOF\r\n\u001b[?2004l\r"]
