[179.311541, "i", "python3 << 'EOF'\nimport cv2\nimport numpy as np\n\nfor i in range(1, 7):\n    filepath = f'/workdir/data/cards/card_{i}.png'\n    img = cv2.imread(filepath)\n    \n    rank_area = img[15:65, 15:65]\n    gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)\n    _, binary = cv2.threshold(gray, 128, 255, cv2.THRESH_BINARY_INV)\n    \n    # Get the bounding box of the main contour\n    contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    if contours:\n        x, y, w, h = cv2.boundingRect(contours[0])\n        # Crop to the digit region\n        digit = binary[y:y+h, x:x+w]\n        \n        # Calculate vertical projection\n        vert_proj = np.sum(digit == 0, axis=0)\n        \n        print(f'card_{i}.png - Bounding box: {w}x{h}')\n        print(f'  Vertical proj (first 10): {vert_proj[:10]}')\nEOF\n"]
