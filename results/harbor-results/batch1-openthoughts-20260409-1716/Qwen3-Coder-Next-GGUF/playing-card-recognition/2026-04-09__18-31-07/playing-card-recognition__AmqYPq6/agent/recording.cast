[83.916126, "i", "python3 << 'EOF'\nimport cv2\nimport numpy as np\n\nfor i in range(1, 7):\n    filepath = f'/workdir/data/cards/card_{i}.png'\n    img = cv2.imread(filepath)\n    \n    # Check the center of the card where the main suit symbol is\n    h, w = img.shape[:2]\n    center_y, center_x = h // 2, w // 2\n    \n    # Look at the main center symbol\n    center_area = img[center_y-100:center_y+100, center_x-100:center_x+100]\n    \n    # Count red pixels (hearts, diamonds)\n    hsv = cv2.cvtColor(center_area, cv2.COLOR_BGR2HSV)\n    lower_red1 = np.array([0, 50, 50])\n    upper_red1 = np.array([10, 255, 255])\n    lower_red2 = np.array([160, 50, 50])\n    upper_red2 = np.array([180, 255, 255])\n    mask1 = cv2.inRange(hsv, lower_red1, upper_red1)\n    mask2 = cv2.inRange(hsv, lower_red2, upper_red2)\n    red_pixels = cv2.countNonZero(mask1 + mask2)\n    \n    # Count black pixels\n    gray = cv2.cvtColor(center_area, cv2.COLOR_BGR2GRAY)\n    black_pixels = cv2.countNonZero(gray < 100)\n    \n    total = center_area.shape[0] * center_area.shape[1]\n "]
[83.916175, "i", "   print(f'card_{i}.png - Red: {red_pixels/total:.2%}, Black: {black_pixels/total:.2%}')\nEOF\n"]
[83.916182, "o", "python3 << 'EOF'"]
