[255.787211, "i", "python3 << 'EOF'\nimport cv2\nimport numpy as np\n\nfor i in range(1, 7):\n    filepath = f'/workdir/data/cards/card_{i}.png'\n    img = cv2.imread(filepath)\n    \n    rank_area = img[10:70, 10:70]\n    gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)\n    _, binary = cv2.threshold(gray, 128, 255, cv2.THRESH_BINARY_INV)\n    \n    # Find contours\n    contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    \n    if contours:\n        # Get the bounding box\n        x, y, w, h = cv2.boundingRect(max(contours, key=cv2.contourArea))\n        digit = binary[y:y+h, x:x+w]\n        \n        # Calculate the right-side coverage (for '4' which has vertical line on right)\n        right_third = digit[:, int(2*digit.shape[1]/3):]\n        left_two_thirds = digit[:, :int(2*digit.shape[1]/3)]\n        \n        right_black = np.sum(right_third == 0) / right_third.size\n        left_black = np.sum(left_two_thirds == 0) / left_two_thirds.size\n        \n        print(f'card_{i}.png - Right 1/3 black: {right_black:."]
[255.78735, "i", "2%}, Left 2/3 black: {left_black:.2%}')\nEOF\n"]
