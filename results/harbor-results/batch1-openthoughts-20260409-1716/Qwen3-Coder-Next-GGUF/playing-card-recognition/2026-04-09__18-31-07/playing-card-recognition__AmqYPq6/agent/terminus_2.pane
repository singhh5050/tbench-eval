[?2004l[?2004h> # Let's analyze the suit color and try to identify the '4'
[?2004l[?2004h> # Red suits: hearts, diamonds
[?2004l[?2004h> # Black suits: clubs, spades
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(1, 7):
[?2004l[?2004h>     filepath = f'/workdir/data/cards/card_{i}.png'
[?2004l[?2004h>     img = cv2.imread(filepath)
[?2004l[?2004h>     
[?2004l[?2004h>     # Convert to HSV to detect colors
[?2004l[?2004h>     hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
[?2004l[?2004h>     
[?2004l[?2004h>     # Detect red (hearts, diamonds)
[?2004l[?2004h>     lower_red1 = np.array([0, 50, 50])
[?2004l[?2004h>     upper_red1 = np.array([10, 255, 255])
[?2004l[?2004h>     lower_red2 = np.array([160, 50, 50])
[?2004l[?2004h>     upper_red2 = np.array([180, 255, 255])
[?2004l[?2004h>     mask1 = cv2.inRange(hsv, lower_red1, upper_red1)
[?2004l[?2004h>     mask2 = cv2.inRange(hsv, lower_red2, upper_red2)
[?2004l[?2004h>     red_mask = cv2.bitwise_or(mask1, mask2)
[?2004l[?2004h>     red_pixels = np.count_nonzero(red_mask)
[?2004l[?2004h>     
[?2004l[?2004h>     # Detect black
[?2004l[?2004h>     gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     black_mask = gray < 50
[?2004l[?2004h>     black_pixels = np.count_nonzero(black_mask)
[?2004l[?2004h>     
[?2004l[?2004h>     total = img.shape[0] * img.shape[1]
[?2004l[?2004h>     
[?2004l[?2004h>     print(f'card_{i}.png - Red: {red_pixels/total:.2%}, Black: {black_pixels/total:.2%}')
[?2004l[?2004h>     
[?2004l[?2004h>     # Determine suit color
[?2004l[?2004h>     if red_pixels > black_pixels:
[?2004l[?2004h>         print(f'  -> Likely RED suit (hearts or diamonds)')
