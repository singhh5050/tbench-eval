[?2004hroot@85192a4178f3:/workdir# python3 << 'EOF'
[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Let's look for the '4' pattern more systematically
[?2004l[?2004h> # '4' typically has: vertical line on right, horizontal bar across middle-right, diagonal from top-left to center
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(1, 7):
[?2004l[?2004h>     filepath = f'/workdir/data/cards/card_{i}.png'
[?2004l[?2004h>     img = cv2.imread(filepath)
[?2004l[?2004h>     
[?2004l[?2004h>     rank_area = img[10:70, 10:70]
[?2004l[?2004h>     gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     _, binary = cv2.threshold(gray, 128, 255, cv2.THRESH_BINARY_INV)
[?2004l[?2004h>     
[?2004l[?2004h>     contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
[?2004l[?2004h>     
[?2004l[?2004h>     if contours:
[?2004l[?2004h>         x, y, w, h = cv2.boundingRect(max(contours, key=cv2.contourArea))
[?2004l[?2004h>         digit = binary[y:y+h, x:x+w]
[?2004l[?2004h>         
[?2004l[?2004h>         # Divide into 3 vertical sections
[?2004l[?2004h>         left = digit[:, :digit.shape[1]//3]
[?2004l[?2004h>         mid = digit[:, digit.shape[1]//3:2*digit.shape[1]//3]
[?2004l[?2004h>         right = digit[:, 2*digit.shape[1]//3:]
[?2004l[?2004h>         
[?2004l[?2004h>         left_black = np.sum(left == 0) / left.size
[?2004l[?2004h>         mid_black = np.sum(mid == 0) / mid.size
[?2004l[?2004h>         right_black = np.sum(right == 0) / right.size
[?2004l[?2004h>         
[?2004l[?2004h>         print(f'card_{i}.png - Left: {left_black:.2%}, Mid: {mid_black:.2%}, Right: {right_black:.2%}')
