[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Let's look for the specific pattern of '4'
[?2004l[?2004h> # A '4' has: vertical line on right, horizontal bar across middle, and sometimes a diagonal
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(1, 7):
[?2004l[?2004h>     filepath = f'/workdir/data/cards/card_{i}.png'
[?2004l[?2004h>     img = cv2.imread(filepath)
[?2004l[?2004h>     
[?2004l[?2004h>     rank_area = img[10:70, 10:70]
[?2004l[?2004h>     gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     _, binary = cv2.threshold(gray, 128, 255, cv2.THRESH_BINARY_INV)
[?2004l[?2004h>     
[?2004l[?2004h>     contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
[?2004l[?2004h>     
[?2004l[?2004h>     if contours:
[?2004l[?2004h>         x, y, w, h = cv2.boundingRect(max(contours, key=cv2.contourArea))
[?2004l[?2004h>         digit = binary[y:y+h, x:x+w]
[?2004l[?2004h>         
[?2004l[?2004h>         # Check for horizontal bar in middle
[?2004l[?2004h>         mid_row = digit[digit.shape[0]//2]
[?2004l[?2004h>         mid_black = np.sum(mid_row == 0) / len(mid_row)
[?2004l[?2004h>         
[?2004l[?2004h>         # Check for vertical bar on right
[?2004l[?2004h>         right_col = digit[:, int(3*digit.shape[1]/4):]
[?2004l[?2004h>         right_black = np.sum(right_col == 0) / right_col.size
[?2004l[?2004h>         
[?2004l[?2004h>         # Check top vs bottom
[?2004l[?2004h>         top_half = digit[:digit.shape[0]//2]
[?2004l[?2004h>         bottom_half = digit[digit.shape[0]//2:]
[?2004l[?2004h>         top_black = np.sum(top_half == 0) / top_half.size
[?2004l[?2004h>         bottom_black = np.sum(bottom_half == 0) / bottom_half.size
[?2004l[?2004h>         
[?2004l[?2004h>         print(f'card_{i}.png - Mid horiz: {mid_black:.2%}, Right vert: {right_black:.2%}, Top: {top_black:.2%}, Bottom: {bottom_black:.2%}')
