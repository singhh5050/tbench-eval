[?2004l[?2004h> 
[?2004l[?2004h> for i in [1, 2, 3, 4, 5, 6]:
[?2004l[?2004h>     filepath = '/workdir/data/cards/card_' + str(i) + '.png'
[?2004l[?2004h>     img = cv2.imread(filepath)
[?2004l[?2004h>     rank_area = img[10:70, 10:70]
[?2004l[?2004h>     gray = cv2.cvtColor(rank_area, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     _, binary = cv2.threshold(gray, 128, 255, cv2.THRESH_BINARY_INV)
[?2004l[?2004h>     contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
[?2004l[?2004h>     if contours:
[?2004l[?2004h>         x, y, w, h = cv2.boundingRect(max(contours, key=cv2.contourArea))
[?2004l[?2004h>         digit = binary[y:y+h, x:x+w]
[?2004l[?2004h>         right_third = digit[:, int(2*digit.shape[1]/3):]
[?2004l[?2004h>         left_two_thirds = digit[:, :int(2*digit.shape[1]/3)]
[?2004l[?2004h>         right_black = float(np.sum(right_third == 0)) / right_third.size
[?2004l[?2004h>         left_black = float(np.sum(left_two_thirds == 0)) / left_two_thirds.size
[?2004l[?2004h>         print('card_' + str(i) + '.png - Right: ' + str(round(right_black*100, 1)) + '%, Left: ' + str(round(left_black*100, 1)) + '%')
