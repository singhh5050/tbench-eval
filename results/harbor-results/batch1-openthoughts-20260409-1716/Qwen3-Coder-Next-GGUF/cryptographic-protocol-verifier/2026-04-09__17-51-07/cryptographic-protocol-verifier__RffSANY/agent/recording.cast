[126.133876, "o", "CRYPTOGRAPHIC ASSUMPTIONS\r\n\u001b[?2004l\r"]
[126.133887, "o", "\u001b[?2004h"]
[126.133898, "o", "> "]
[126.133909, "o", "------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
