[126.13352, "o", "\u001b[?2004h> "]
[126.133555, "o", "Zero-Knowledge Breaks: {zero_knowledge_failures}\r\n\u001b[?2004l\r"]
[126.133567, "o", "\u001b[?2004h"]
[126.133578, "o", "> "]
[126.1336, "o", "Security Reduction Flaws: {reduction_failures}\r\n\u001b[?2004l\r"]
[126.133614, "o", "\u001b[?2004h"]
[126.133625, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.13364, "o", "ATTACK SIMULATION RESULTS\r\n\u001b[?2004l\r"]
[126.133651, "o", "\u001b[?2004h"]
[126.133662, "o", "> "]
[126.133672, "o", "------------------------\r\n\u001b[?2004l\r"]
[126.133683, "o", "\u001b[?2004h> "]
[126.133711, "o", "Chosen-Message Attacks: 0.1% success rate\r\n\u001b[?2004l\r"]
[126.133722, "o", "\u001b[?2004h> "]
[126.133749, "o", "Man-in-the-Middle: 0.1% success rate\r\n\u001b[?2004l\r"]
[126.13376, "o", "\u001b[?2004h> "]
[126.133794, "o", "Timing Side-Channels: 0 vulnerabilities detected\r\n\u001b[?2004l\r"]
[126.133806, "o", "\u001b[?2004h> "]
[126.133837, "o", "Concurrent Composition: 128 bits remaining\r\n\u001b[?2004l\r"]
