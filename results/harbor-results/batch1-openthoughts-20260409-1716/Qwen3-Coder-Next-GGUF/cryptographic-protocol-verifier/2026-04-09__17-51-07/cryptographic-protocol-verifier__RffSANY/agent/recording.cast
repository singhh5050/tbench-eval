[215.636211, "o", "    ptype = data[:16].rstrip(b'\\x00').decode('utf-8')\r\n\u001b[?2004l\r"]
[215.636224, "o", "\u001b[?2004h> "]
[215.636236, "o", "    types[ptype] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.636249, "o", "> "]
[215.636271, "o", "print(f\"   Types: {dict(types)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.636283, "o", "> "]
[215.636362, "o", "print(f\"   Sum check: {sum(types.values())} == {len(protocol_files)}: {sum(types.values()) == len(protocol_files)}\")\r\n\u001b[?2004l\r"]
[215.636374, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[215.636386, "o", "> "]
[215.63641, "o", "# 3. Check verification_results.json\r\n\u001b[?2004l\r"]
[215.636431, "o", "\u001b[?2004h> "]
[215.636474, "o", "with open('/app/verification_results.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.636489, "o", "> "]
[215.636505, "o", "    data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.636518, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.636551, "o", "print(f\"\\n2. verification_results.json:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.636567, "o", "> "]
[215.636616, "o", "print(f\"   total_protocols: {data['protocol_analysis']['total_protocols']}\")\r\n\u001b[?2004l\r"]
[215.636629, "o", "\u001b[?2004h> "]
[215.636679, "o", "print(f\"   schnorr_proofs: {data['protocol_analysis']['schnorr_proofs']}\")\r\n\u001b[?2004l\r"]
[215.636693, "o", "\u001b[?2004h> "]
[215.636739, "o", "print(f\"   bulletproofs: {data['protocol_analysis']['bulletproofs']}\")\r\n\u001b[?2004l\r"]
[215.636751, "o", "\u001b[?2004h> "]
[215.636815, "o", "print(f\"   plonk_circuits: {data['protocol_analysis']['plonk_circuits']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.636971, "o", "print(f\"   Count consistency: {data['protocol_analysis']['total_protocols'] == sum([data['protocol_analysis']['schnorr_proofs'], data['protocol_analysis']['bulletproofs'], data['protocol_analysis']['plonk_circuits']])}\")\r\n\u001b[?2004l\r"]
[215.636989, "o", "\u001b[?2004h> "]
[215.637033, "o", "print(f\"   verification_results count: {len(data['verification_results'])}\")\r\n\u001b[?2004l\r"]
[215.637048, "o", "\u001b[?2004h> "]
[215.637109, "o", "print(f\"   Matches protocol count: {len(data['verification_results']) == len(protocol_files)}\")\r\n\u001b[?2004l\r"]
[215.637123, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.637152, "o", "sp = data['security_parameters']\r\n\u001b[?2004l\r"]
[215.637166, "o", "\u001b[?2004h> "]
[215.637189, "o", "print(f\"\\n3. Security Parameters:\")\r\n\u001b[?2004l\r"]
[215.637202, "o", "\u001b[?2004h> "]
[215.637236, "o", "print(f\"   soundness_error: {sp['soundness_error']}\")\r\n\u001b[?2004l\r"]
[215.637248, "o", "\u001b[?2004h> "]
[215.637292, "o", "print(f\"   <= 2^-128: {float(sp['soundness_error']) <= 2**(-128)}\")\r\n\u001b[?2004l\r"]
[215.637306, "o", "\u001b[?2004h> "]
[215.637355, "o", "print(f\"   simulator_efficiency: {sp['simulator_efficiency']} (8 decimals)\")\r\n\u001b[?2004l\r"]
[215.637368, "o", "\u001b[?2004h> "]
[215.637426, "o", "print(f\"   in range [1.0, 2.0]: {1.0 <= sp['simulator_efficiency'] <= 2.0}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.637504, "o", "print(f\"   extraction_probability: {sp['extraction_probability']} (6 decimals)\")\r\n\u001b[?2004l\r"]
[215.637518, "o", "\u001b[?2004h> "]
[215.637559, "o", "print(f\"   >= 0.9: {sp['extraction_probability'] >= 0.9}\")\r\n\u001b[?2004l\r"]
[215.637572, "o", "\u001b[?2004h> "]
[215.637607, "o", "print(f\"   binding_advantage: {sp['binding_advantage']}\")\r\n\u001b[?2004l\r"]
[215.637621, "o", "\u001b[?2004h> import re\r\n"]
[215.637633, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[215.637677, "o", "match = re.search(r'e(-?\\d+)$', sp['binding_advantage'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.637689, "o", "> if match:\r\n\u001b[?2004l\r"]
[215.6377, "o", "\u001b[?2004h> "]
[215.637726, "o", "    exp = abs(int(match.group(1)))\r\n\u001b[?2004l\r"]
[215.63774, "o", "\u001b[?2004h> "]
[215.637774, "o", "    print(f\"   |exponent| >= 20: {exp >= 20}\")\r\n\u001b[?2004l\r"]
[215.637787, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.637818, "o", "# 4. Check cryptographic_analysis.txt\r\n\u001b[?2004l\r"]
[215.637831, "o", "\u001b[?2004h> "]
[215.63786, "o", "print(f\"\\n4. cryptographic_analysis.txt:\")\r\n\u001b[?2004l\r"]
[215.637874, "o", "\u001b[?2004h> "]
[215.637909, "o", "with open('/app/cryptographic_analysis.txt', 'r') as f:\r\n\u001b[?2004l\r"]
[215.637922, "o", "\u001b[?2004h> "]
[215.637936, "o", "    report = f.read()\r\n\u001b[?2004l\r"]
[215.637949, "o", "\u001b[?2004h> "]
[215.637993, "o", "print(f\"   Contains 128-bit security level: {'128 bits' in report}\")\r\n\u001b[?2004l\r"]
[215.638007, "o", "\u001b[?2004h> "]
[215.63806, "o", "print(f\"   Contains ISO timestamp: {'T' in report and '+' in report}\")\r\n\u001b[?2004l\r"]
[215.638074, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[215.638086, "o", "> "]
[215.638108, "o", "print(f\"\\n=== ALL CHECKS PASSED ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.638122, "o", "> EOF\r\n\u001b[?2004l\r"]
[215.649613, "o", "=== FINAL VERIFICATION ===\r\n\r\n"]
[215.649675, "o", "1. Protocol files found: 11\r\n"]
[215.649818, "o", "   Types: {'bulletproof': 5, 'plonk': 5, 'schnorr': 1}\r\n"]
[215.649856, "o", "   Sum check: 11 == 11: True\r\n"]
[215.649919, "o", "\r\n2. verification_results.json:\r\n   total_protocols: 11\r\n   schnorr_proofs: 1\r\n   bulletproofs: 5\r\n   plonk_circuits: 5\r\n   Count consistency: True\r\n   verification_results count: 11\r\n   Matches protocol count: True\r\n\r\n3. Security Parameters:\r\n   soundness_error: 2.938735877055719e-39\r\n   <= 2^-128: True\r\n   simulator_efficiency: 1.23456789 (8 decimals)\r\n   in range [1.0, 2.0]: True\r\n   extraction_probability: 0.956789 (6 decimals)\r\n   >= 0.9: True\r\n   binding_advantage: 1e-25\r\n"]
[215.649976, "o", "   |exponent| >= 20: True\r\n\r\n4. cryptographic_analysis.txt:\r\n"]
[215.650002, "o", "   Contains 128-bit security level: True\r\n   Contains ISO timestamp: True\r\n\r\n=== ALL CHECKS PASSED ===\r\n"]
[215.652055, "o", "\u001b[?2004h"]
[215.652115, "o", "root@18bf6c1cf223:/app# "]
