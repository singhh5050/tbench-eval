[54.614731, "i", "python3 << 'EOF'\nimport struct\nimport json\n\n# Parse protocol_006.zkp (schnorr)\nwith open('protocol_006.zkp', 'rb') as f:\n    data = f.read()\n\nprotocol_type = data[:16].rstrip(b'\\x00').decode('utf-8')\njson_len = struct.unpack('<I', data[24:28])[0]\njson_data = data[28:28+json_len].decode('utf-8')\n\nprint(\"Schnorr Protocol:\")\nprint(f\"Type: {protocol_type}\")\nprint(f\"JSON: {json_data}\\n\")\n\n# Check other files\nimport os\nfor i in range(11):\n    fname = f'protocol_{i:03d}.zkp'\n    if os.path.exists(fname):\n        with open(fname, 'rb') as f:\n            data = f.read()\n        ptype = data[:16].rstrip(b'\\x00').decode('utf-8')\n        print(f\"{fname}: {ptype}\")\nEOF\n"]
