[126.134316, "o", "\u001b[?2004h> "]
[126.134361, "o", "    print(f\"Report written to cryptographic_analysis.txt\")\r\n\u001b[?2004l\r"]
[126.134372, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[126.134382, "o", "\u001b[?2004h> "]
