[215.63554, "i", "python3 << 'EOF'\nimport json\nimport os\n\nprint(\"=== FINAL VERIFICATION ===\")\nprint()\n\n# 1. Check protocol files\nprotocol_files = sorted([f for f in os.listdir('/app') if f.startswith('protocol_') and f.endswith('.zkp')])\nprint(f\"1. Protocol files found: {len(protocol_files)}\")\n\n# 2. Parse and count types\nfrom collections import Counter\ntypes = Counter()\nfor pf in protocol_files:\n    with open(f'/app/{pf}', 'rb') as f:\n        data = f.read()\n    ptype = data[:16].rstrip(b'\\x00').decode('utf-8')\n    types[ptype] += 1\nprint(f\"   Types: {dict(types)}\")\nprint(f\"   Sum check: {sum(types.values())} == {len(protocol_files)}: {sum(types.values()) == len(protocol_files)}\")\n\n# 3. Check verification_results.json\nwith open('/app/verification_results.json', 'r') as f:\n    data = json.load(f)\n\nprint(f\"\\n2. verification_results.json:\")\nprint(f\"   total_protocols: {data['protocol_analysis']['total_protocols']}\")\nprint(f\"   schnorr_proofs: {data['protocol_analysis']['schnorr_proofs']}\")\nprint(f\"   bulletproofs: {data['protocol"]
