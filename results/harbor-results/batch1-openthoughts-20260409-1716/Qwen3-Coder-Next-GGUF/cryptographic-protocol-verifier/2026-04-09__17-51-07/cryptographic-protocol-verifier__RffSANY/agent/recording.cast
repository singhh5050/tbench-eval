[39.229656, "i", "python3 << 'EOF'\nimport struct\nimport json\n\nwith open('protocol_000.zkp', 'rb') as f:\n    data = f.read()\n\n# Parse header\nprotocol_type = data[:16].rstrip(b'\\x00').decode('utf-8')\ntimestamp = struct.unpack('<Q', data[16:24])[0]\njson_len = struct.unpack('<I', data[24:28])[0]\njson_data = data[28:28+json_len].decode('utf-8')\npadding = data[28+json_len:]\n\nprint(f\"Protocol Type: {protocol_type}\")\nprint(f\"Timestamp: {timestamp}\")\nprint(f\"JSON Length: {json_len}\")\nprint(f\"JSON Data: {json_data}\")\nprint(f\"Padding Length: {len(padding)}\")\n\n# Parse JSON\nprotocol = json.loads(json_data)\nprint(f\"Protocol: {protocol}\")\nEOF\n"]
