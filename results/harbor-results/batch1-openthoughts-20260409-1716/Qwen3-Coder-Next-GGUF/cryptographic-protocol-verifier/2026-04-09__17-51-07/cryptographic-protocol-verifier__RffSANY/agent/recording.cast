[126.133341, "o", "\u001b[?2004h> "]
[126.133358, "o", "FORMAL VERIFICATION RESULTS\r\n\u001b[?2004l\r"]
[126.13337, "o", "\u001b[?2004h"]
[126.133381, "o", "> "]
[126.133392, "o", "---------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.133403, "o", "> "]
[126.133462, "o", "Soundness Violations: {soundness_failures}\r\n\u001b[?2004l\r"]
[126.133475, "o", "\u001b[?2004h> "]
