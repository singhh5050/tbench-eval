[104.227534, "i", "cat > /usr/local/bin/check_service_health.sh << 'SCRIPT'\n#!/bin/bash\n\nSERVICE=\"myapp\"\nTIME_WINDOW=\"5 minutes\"\n\n# Get logs from last 5 minutes in JSON format\nLOGS=$(journalctl -u $SERVICE --since \"5 minutes ago\" --json 2>/dev/null)\n\n# Count restart events (Started messages) - ensure we get a clean number\nRESTARTS=$(echo \"$LOGS\" | grep '\"MESSAGE\":\".*Started\"' 2>/dev/null | wc -l | tr -d ' ')\n\n# Count error events\nERRORS=$(echo \"$LOGS\" | grep '\"level\":\"ERROR\"' 2>/dev/null | wc -l | tr -d ' ')\n\n# Default to 0 if empty\nRESTARTS=${RESTARTS:-0}\nERRORS=${ERRORS:-0}\n\n# Detect restart loop: more than 3 restarts in 5 minutes\nif [ \"$RESTARTS\" -gt 3 ]; then\n    RESTART_LOOP=\"true\"\nelse\n    RESTART_LOOP=\"false\"\nfi\n\n# Generate timestamp\nTIMESTAMP=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\n\n# Output JSON report\ncat << EOF\n{\n  \"service\": \"$SERVICE\",\n  \"time_window\": \"$TIME_WINDOW\",\n  \"restarts\": $RESTARTS,\n  \"errors\": $ERRORS,\n  \"restart_loop_detected\": $RESTART_LOOP,\n  \"timestamp\": \"$TIMESTAMP\"\n}\nEOF\nSCRIPT\n"]
[104.227694, "o", "cat > /usr/local/bin/check_service_health.sh << 'SCRIPT'\r\n\u001b[?2004l\r"]
[104.227712, "o", "\u001b[?2004h> "]
