[20.876654, "o", "\u001b[?2004hroot@ac4d5de4c098:/opt/myapp# "]
[20.966293, "i", "cat > /opt/myapp/app.py << 'EOF'\n#!/usr/bin/env python3\nimport argparse\nimport json\nimport logging\nimport sys\nimport time\nimport datetime\n\ndef setup_logging(log_level):\n    # Configure logging to output JSON to stdout\n    root = logging.getLogger()\n    root.setLevel(getattr(logging, log_level))\n    \n    # Create a handler that outputs to stdout\n    handler = logging.StreamHandler(sys.stdout)\n    handler.setLevel(getattr(logging, log_level))\n    \n    # Create a custom formatter that outputs JSON\n    class JSONFormatter(logging.Formatter):\n        def format(self, record):\n            log_entry = {\n                \"timestamp\": datetime.datetime.utcnow().strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n                \"level\": record.levelname,\n                \"message\": record.getMessage(),\n                \"service\": \"myapp\"\n            }\n            return json.dumps(log_entry)\n    \n    handler.setFormatter(JSONFormatter())\n    root.addHandler(handler)\n    \n    return root\n\ndef main():\n    parser = argparse.ArgumentParser(desc"]
[20.966352, "i", "ription='MyApp - JSON logging service')\n    parser.add_argument('--log-level', default='INFO', choices=['INFO', 'ERROR', 'WARN'],\n                        help='Logging level (INFO, ERROR, WARN)')\n    args = parser.parse_args()\n    \n    logger = setup_logging(args.log_level)\n    \n    logger.info(\"Service started\")\n    \n    try:\n        while True:\n            logger.info(\"Processing batch\")\n            time.sleep(5)\n            logger.warn(\"Memory usage high\")\n            time.sleep(5)\n            logger.error(\"Connection timeout\")\n            time.sleep(5)\n    except KeyboardInterrupt:\n        logger.info(\"Service stopped gracefully\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
