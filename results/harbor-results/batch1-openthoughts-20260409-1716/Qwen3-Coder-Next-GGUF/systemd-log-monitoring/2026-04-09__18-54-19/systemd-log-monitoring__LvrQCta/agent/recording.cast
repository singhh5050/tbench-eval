[53.071704, "i", "cat > /usr/local/bin/check_service_health.sh << 'SCRIPT'\n#!/bin/bash\n\nSERVICE=\"myapp\"\nTIME_WINDOW=\"5 minutes\"\n\n# Get logs from last 5 minutes in JSON format\nLOGS=$(journalctl -u $SERVICE --since \"5 minutes ago\" --json 2>/dev/null)\n\n# Count restart events (Started messages)\nRESTARTS=$(echo \"$LOGS\" | grep -c '\"MESSAGE\":\".*Started\"' 2>/dev/null || echo 0)\n\n# Count error events\nERRORS=$(echo \"$LOGS\" | grep -c '\"level\":\"ERROR\"' 2>/dev/null || echo 0)\n\n# Detect restart loop: more than 3 restarts in 5 minutes\nif [ \"$RESTARTS\" -gt 3 ]; then\n    RESTART_LOOP=\"true\"\nelse\n    RESTART_LOOP=\"false\"\nfi\n\n# Generate timestamp\nTIMESTAMP=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\n\n# Output JSON report\ncat << EOF\n{\n  \"service\": \"$SERVICE\",\n  \"time_window\": \"$TIME_WINDOW\",\n  \"restarts\": $RESTARTS,\n  \"errors\": $ERRORS,\n  \"restart_loop_detected\": $RESTART_LOOP,\n  \"timestamp\": \"$TIMESTAMP\"\n}\nEOF\nSCRIPT\n"]
[53.071842, "o", "cat > /usr/local/bin/check_service_health.sh << 'SCRIPT'\r\n\u001b[?2004l\r"]
[53.071877, "o", "\u001b[?2004h> "]
[53.071899, "o", "#!/bin/bash\r\n\u001b[?2004l\r"]
[53.071914, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[53.071923, "o", "\u001b[?2004h> "]
[53.071972, "o", "SERVICE=\"myapp\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.071992, "o", "TIME_WINDOW=\"5 minutes\"\r\n\u001b[?2004l\r"]
[53.072006, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[53.072021, "o", "\u001b[?2004h> "]
[53.072076, "o", "# Get logs from last 5 minutes in JSON format\r\n\u001b[?2004l\r"]
[53.07209, "o", "\u001b[?2004h> "]
[53.072181, "o", "LOGS=$(journalctl -u $SERVICE --since \"5 minutes ago\" --json 2>/dev/null)\r\n\u001b[?2004l\r"]
[53.072195, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[53.072208, "o", "\u001b[?2004h> "]
[53.072263, "o", "# Count restart events (Started messages)\r\n\u001b[?2004l\r"]
[53.072278, "o", "\u001b[?2004h> "]
[53.072379, "o", "RESTARTS=$(echo \"$LOGS\" | grep -c '\"MESSAGE\":\".*Started\"' 2>/dev/null || echo 0)\r\n\u001b[?2004l\r"]
[53.072397, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[53.07241, "o", "\u001b[?2004h> "]
[53.072434, "o", "# Count error events\r\n\u001b[?2004l\r"]
[53.072454, "o", "\u001b[?2004h> "]
[53.07254, "o", "ERRORS=$(echo \"$LOGS\" | grep -c '\"level\":\"ERROR\"' 2>/dev/null || echo 0)\r\n\u001b[?2004l\r"]
[53.072552, "o", "\u001b[?2004h> "]
[53.072565, "o", "\r\n\u001b[?2004l\r"]
[53.072577, "o", "\u001b[?2004h> "]
[53.072688, "o", "# Detect restart loop: more than 3 restarts in 5 minutes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.072744, "o", "if [ \"$RESTARTS\" -gt 3 ]; then\r\n\u001b[?2004l\r\u001b[?2004h>     RESTART_LOOP=\"true\"\r\n\u001b[?2004l\r"]
[53.07277, "o", "\u001b[?2004h> else\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.072794, "o", "    RESTART_LOOP=\"false\"\r\n\u001b[?2004l\r"]
[53.072815, "o", "\u001b[?2004h"]
[53.07284, "o", "> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[53.07286, "o", "\u001b[?2004h> # Generate timestamp\r\n"]
[53.072882, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.072891, "o", "> "]
[53.072927, "o", "TIMESTAMP=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\r\n\u001b[?2004l\r"]
[53.072953, "o", "\u001b[?2004h> \r\n"]
[53.072977, "o", "\u001b[?2004l\r\u001b[?2004h> # Output JSON report\r\n"]
[53.073001, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.073024, "o", "> cat << EOF\r\n\u001b[?2004l\r"]
[53.073045, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.073065, "o", "  \"service\": \"$SERVICE\",\r\n\u001b[?2004l\r"]
[53.073087, "o", "\u001b[?2004h"]
[53.073107, "o", "> "]
[53.073129, "o", "  \"time_window\": \"$TIME_WINDOW\",\r\n\u001b[?2004l\r"]
[53.073152, "o", "\u001b[?2004h> "]
[53.073173, "o", "  \"restarts\": $RESTARTS,\r\n"]
[53.073197, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[53.073218, "o", "  \"errors\": $ERRORS,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.073267, "o", "  \"restart_loop_detected\": $RESTART_LOOP,\r\n\u001b[?2004l\r"]
[53.073288, "o", "\u001b[?2004h"]
[53.073311, "o", ">   \"timestamp\": \"$TIMESTAMP\""]
[53.073331, "o", "\r\n\u001b[?2004l\r"]
[53.073354, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[53.073363, "o", "\u001b[?2004h> "]
[53.073392, "o", "SCRIPT\r\n\u001b[?2004l\r"]
