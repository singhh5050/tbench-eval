[161.343999, "o", "echo '=== Python App ===' && cat /opt/myapp/app.py | head -20\r\n\u001b[?2004l\r"]
[161.344102, "o", "=== Python App ===\r\n"]
[161.344844, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport json\r\nimport logging\r\nimport sys\r\nimport time\r\nimport datetime\r\n\r\ndef setup_logging(log_level):\r\n    # Configure logging to output JSON to stdout\r\n    root = logging.getLogger()\r\n    root.setLevel(getattr(logging, log_level))\r\n    \r\n"]
[161.344892, "o", "    # Create a handler that outputs to stdout\r\n    handler = logging.StreamHandler(sys.stdout)\r\n    handler.setLevel(getattr(logging, log_level))\r\n    \r\n    # Create a custom formatter that outputs JSON\r\n    class JSONFormatter(logging.Formatter):\r\n        def format(self, record):\r\n"]
[161.345082, "o", "\u001b[?2004h"]
[161.345104, "o", "root@ac4d5de4c098:/opt/myapp# "]
[161.551716, "i", "echo '=== Systemd Service ===' && cat /etc/systemd/system/myapp.service\n"]
[161.551848, "o", "echo '=== Systemd Service ===' && cat /etc/systemd/system/myapp.service\r\n"]
[161.551874, "o", "\u001b[?2004l\r"]
[161.551906, "o", "=== Systemd Service ===\r\n"]
[161.552492, "o", "[Unit]\r\nDescription=MyApp - JSON logging service\r\nAfter=network.target\r\n\r\n[Service]\r\nType=simple\r\nUser=myapp\r\nGroup=myapp\r\nWorkingDirectory=/opt/myapp\r\nExecStart=/opt/myapp/app.py --log-level=INFO\r\nRestart=on-failure\r\nRestartSec=5\r\nStandardOutput=journal\r\nStandardError=journal\r\nSyslogIdentifier=myapp\r\n\r\n[Install]\r\nWantedBy=multi-user.target\r\n"]
[161.552616, "o", "\u001b[?2004h"]
[161.552641, "o", "root@ac4d5de4c098:/opt/myapp# "]
[161.745213, "i", "echo '=== Rsyslog Config ===' && cat /etc/rsyslog.d/50-myapp.conf\n"]
[161.745346, "o", "echo '=== Rsyslog Config ===' && cat /etc/rsyslog.d/50-myapp.conf\r\n\u001b[?2004l\r"]
[161.745399, "o", "=== Rsyslog Config ===\r\n"]
[161.746138, "o", "# myapp log routing configuration\r\n\r\n# Route all myapp logs to app_events.log\r\nif $programname == 'myapp' then /var/log/app_events.log\r\n& stop\r\n\r\n# Route ERROR level events to separate file\r\nif $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then /var/log/app_errors.log\r\n& stop\r\n"]
[161.746239, "o", "\u001b[?2004hroot@ac4d5de4c098:/opt/myapp# "]
[161.948625, "i", "echo '=== Logrotate Config ===' && cat /etc/logrotate.d/myapp\n"]
[161.948816, "o", "echo '=== Logrotate Config ===' && cat /etc/logrotate.d/myapp\r\n\u001b[?2004l\r"]
[161.948874, "o", "=== Logrotate Config ===\r\n"]
[161.949298, "o", "/var/log/app_events.log /var/log/app_errors.log {\r\n    daily\r\n    rotate 7\r\n    compress\r\n    delaycompress\r\n    missingok\r\n    notifempty\r\n    create 644 myapp myapp\r\n    postrotate\r\n        /usr/bin/systemctl reload rsyslog > /dev/null 2>&1 || true\r\n    endscript\r\n}\r\n"]
[161.949402, "o", "\u001b[?2004h"]
[161.949415, "o", "root@ac4d5de4c098:/opt/myapp# "]
[162.154341, "i", "echo '=== Monitoring Script ===' && cat /usr/local/bin/check_service_health.sh\n"]
[162.154482, "o", "echo '=== Monitoring Script ===' && cat /usr/local/bin/check_service_health.sh\r\n\u001b[?2004l\r"]
[162.154517, "o", "=== Monitoring Script ===\r\n"]
[162.155147, "o", "#!/bin/bash\r\n\r\nSERVICE=\"myapp\"\r\nTIME_WINDOW=\"5 minutes\"\r\n\r\n# Get logs from last 5 minutes in JSON format\r\nLOGS=$(journalctl -u $SERVICE --since \"5 minutes ago\" --json 2>/dev/null)\r\n\r\n# Count restart events (Started messages) - ensure we get a clean number\r\nRESTARTS=$(echo \"$LOGS\" | grep '\"MESSAGE\":\".*Started\"' 2>/dev/null | wc -l | tr -d ' ')\r\n\r\n# Count error events\r\nERRORS=$(echo \"$LOGS\" | grep '\"level\":\"ERROR\"' 2>/dev/null | wc -l | tr -d ' ')\r\n\r\n# Default to 0 if empty\r\nRESTARTS=${RESTARTS:-0}\r\nERRORS=${ERRORS:-0}\r\n\r\n# Detect restart loop: more than 3 restarts in 5 minutes\r\nif [ \"$RESTARTS\" -gt 3 ]; then\r\n    RESTART_LOOP=\"true\"\r\nelse\r\n    RESTART_LOOP=\"false\"\r\nfi\r\n\r\n# Generate timestamp\r\nTIMESTAMP=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\r\n\r\n# Output JSON report\r\ncat << EOF\r\n{\r\n  \"service\": \"$SERVICE\",\r\n  \"time_window\": \"$TIME_WINDOW\",\r\n"]
[162.155169, "o", "  \"restarts\": $RESTARTS,\r\n  \"errors\": $ERRORS,\r\n  \"restart_loop_detected\": $RESTART_LOOP,\r\n  \"timestamp\": \"$TIMESTAMP\"\r\n}\r\nEOF\r\n"]
[162.155273, "o", "\u001b[?2004h"]
[162.155289, "o", "root@ac4d5de4c098:/opt/myapp# "]
