[38.76794, "i", "cat > /etc/rsyslog.d/50-myapp.conf << 'EOF'\n# myapp log routing configuration\n\n# Route all myapp logs to app_events.log\nif $programname == 'myapp' then /var/log/app_events.log\n& stop\n\n# Route ERROR level events to separate file\nif $programname == 'myapp' and $msg contains '\"level\":\"ERROR\"' then /var/log/app_errors.log\n& stop\nEOF\n"]
