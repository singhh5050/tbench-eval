[?2004hroot@1adde69d8662:/workdir# python3 << 'EOF'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> tiles_dir = '/workdir/data/tiles/'
[?2004l[?2004h> tile_files = ['tile_001.png', 'tile_002.png', 'tile_003.png', 'tile_004.png']
[?2004l[?2004h> 
[?2004l[?2004h> # Let me analyze the patterns more carefully
[?2004l[?2004h> for tile_file in tile_files:
[?2004l[?2004h>     path = os.path.join(tiles_dir, tile_file)
[?2004l[?2004h>     img = Image.open(path)
[?2004l[?2004h>     arr = np.array(img)
[?2004l[?2004h>     
[?2004l[?2004h>     bg_color = arr[0, 0]
[?2004l[?2004h>     is_background = np.all(arr == bg_color, axis=2)
[?2004l[?2004h>     
[?2004l[?2004h>     fg_pixels = np.argwhere(~is_background)
[?2004l[?2004h>     min_y, min_x = fg_pixels.min(axis=0)
[?2004l[?2004h>     max_y, max_x = fg_pixels.max(axis=0)
[?2004l[?2004h>     
[?2004l[?2004h>     region = arr[min_y:max_y+1, min_x:max_x+1]
[?2004l[?2004h>     number_vals = region[:,:,0]
[?2004l[?2004h>     
[?2004l[?2004h>     # Use threshold to create binary image
[?2004l[?2004h>     threshold = 5
[?2004l[?2004h>     binary = (number_vals > threshold).astype(np.uint8)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate some features
[?2004l[?2004h>     height, width = binary.shape
[?2004l[?2004h>     total_pixels = np.sum(binary)
[?2004l[?2004h>     
[?2004l[?2004h>     # Count holes (pixels surrounded by foreground on all sides)
[?2004l[?2004h>     holes = 0
[?2004l[?2004h>     for i in range(1, height-1):
[?2004l[?2004h>         for j in range(1, width-1):
[?2004l[?2004h>             if binary[i, j] == 0 and binary[i-1, j] == 1 and binary[i+1, j] == 1 and binary[i, j-1] == 1 and binary[i, j+1] == 1:
[?2004l[?2004h>                 holes += 1
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if top is connected (for 1 vs 0/8)
[?2004l[?2004h>     top_connected = np.any(binary[0, :])
[?2004l[?2004h>     bottom_connected = np.any(binary[-1, :])
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"{tile_file}:")
[?2004l[?2004h>     print(f"  Size: {width}x{height}, Total pixels: {total_pixels}")
[?2004l[?2004h>     print(f"  Top connected: {top_connected}, Bottom connected: {bottom_connected}")
[?2004l[?2004h>     print(f"  Holes: {holes}")
[?2004l[?2004h>     print()
