[?2004l[?2004h>     
[?2004l[?2004h>     bg_color = arr[0, 0]
[?2004l[?2004h>     
[?2004l[?2004h>     # Find foreground pixels (non-background)
[?2004l[?2004h>     is_background = np.all(arr == bg_color, axis=2)
[?2004l[?2004h>     fg_pixels = np.argwhere(~is_background)
