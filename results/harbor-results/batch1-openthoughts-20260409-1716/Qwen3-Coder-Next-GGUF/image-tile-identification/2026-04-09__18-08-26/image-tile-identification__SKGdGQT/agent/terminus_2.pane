[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> tiles_dir = '/workdir/data/tiles/'
[?2004l[?2004h> tile_files = ['tile_001.png', 'tile_002.png', 'tile_003.png', 'tile_004.png']
[?2004l[?2004h> 
[?2004l[?2004h> for tile_file in tile_files:
[?2004l[?2004h>     path = os.path.join(tiles_dir, tile_file)
[?2004l[?2004h>     img = Image.open(path)
[?2004l[?2004h>     arr = np.array(img)
[?2004l[?2004h>     
[?2004l[?2004h>     # Convert to grayscale for easier analysis
[?2004l[?2004h>     # Blue bg: [0,0,255], Red bg: [255,0,0], Yellow bg: [255,255,0], Green bg: [0,255,0]
[?2004l[?2004h>     
[?2004l[?2004h>     # Find the dominant non-background color (the number color)
[?2004l[?2004h>     # The number appears to be black/dark colored on colored background
[?2004l[?2004h>     
[?2004l[?2004h>     # Check for the number by looking at where pixels differ from background
[?2004l[?2004h>     bg_color = arr[0, 0]
[?2004l[?2004h>     
[?2004l[?2004h>     # Find all unique colors that are not the background
[?2004l[?2004h>     flat = arr.reshape(-1, 3)
[?2004l[?2004h>     unique_colors = np.unique(flat, axis=0)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"{tile_file}:")
[?2004l[?2004h>     print(f"  Background color: {bg_color}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Count how many pixels are NOT background
[?2004l[?2004h>     is_background = np.all(arr == bg_color, axis=2)
[?2004l[?2004h>     bg_count = np.sum(is_background)
[?2004l[?2004h>     fg_count = np.sum(~is_background)
[?2004l[?2004h>     print(f"  Background pixels: {bg_count}")
[?2004l[?2004h>     print(f"  Foreground (number) pixels: {fg_count}")
[?2004l[?2004h>     print()
