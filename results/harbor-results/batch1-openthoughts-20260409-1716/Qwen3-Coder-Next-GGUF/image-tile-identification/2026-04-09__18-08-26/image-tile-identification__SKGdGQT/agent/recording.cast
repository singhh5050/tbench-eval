[16.586664, "i", "python3 << 'EOF'\nfrom PIL import Image\nimport numpy as np\nimport os\n\n# List all tiles\ntiles_dir = '/workdir/data/tiles/'\ntile_files = ['tile_001.png', 'tile_002.png', 'tile_003.png', 'tile_004.png']\n\nfor tile_file in tile_files:\n    path = os.path.join(tiles_dir, tile_file)\n    img = Image.open(path)\n    print(f\"{tile_file}: size={img.size}, mode={img.mode}\")\n    \n    # Convert to numpy array and examine pixel data\n    arr = np.array(img)\n    print(f\"  Shape: {arr.shape}\")\n    print(f\"  Unique values: {np.unique(arr)}\")\n    print()\nEOF\n"]
