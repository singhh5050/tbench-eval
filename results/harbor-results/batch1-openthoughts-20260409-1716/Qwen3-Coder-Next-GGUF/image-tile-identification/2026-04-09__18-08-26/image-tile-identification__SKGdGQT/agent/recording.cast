[219.060406, "i", "python3 << 'EOF'\nfrom PIL import Image\nimport numpy as np\nimport os\n\ntiles_dir = '/workdir/data/tiles/'\ntile_files = ['tile_001.png', 'tile_002.png', 'tile_003.png', 'tile_004.png']\n\nfor tile_file in tile_files:\n    path = os.path.join(tiles_dir, tile_file)\n    img = Image.open(path)\n    arr = np.array(img)\n    \n    bg_color = arr[0, 0]\n    is_background = np.all(arr == bg_color, axis=2)\n    \n    # Get bounding box of foreground\n    fg_pixels = np.argwhere(~is_background)\n    min_y, min_x = fg_pixels.min(axis=0)\n    max_y, max_x = fg_pixels.max(axis=0)\n    \n    # Extract number region\n    region = arr[min_y:max_y+1, min_x:max_x+1]\n    \n    # The number is in grayscale (R=G=B)\n    # Extract the grayscale value\n    number_vals = region[:,:,0]  # All channels should be equal for number\n    \n    print(f\"{tile_file}:\")\n    for row in number_vals:\n        line = ''.join('#' if v > 0 else ' ' for v in row)\n        print(f\"  {line}\")\n    print()\nEOF\n"]
