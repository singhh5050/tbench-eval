[254.083347, "o", "                # Map to 0-9\r\n\u001b[?2004l\r\u001b[?2004h>                 idx = min(9, int(v * 10 / 255))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[254.083384, "o", "                line += str(idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
