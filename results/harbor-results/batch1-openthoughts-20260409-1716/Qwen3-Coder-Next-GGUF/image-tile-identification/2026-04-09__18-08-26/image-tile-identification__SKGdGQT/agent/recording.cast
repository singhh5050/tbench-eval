[183.349229, "i", "python3 << 'EOF'\nfrom PIL import Image\nimport numpy as np\nimport os\n\ntiles_dir = '/workdir/data/tiles/'\ntile_files = ['tile_001.png', 'tile_002.png', 'tile_003.png', 'tile_004.png']\n\nfor tile_file in tile_files:\n    path = os.path.join(tiles_dir, tile_file)\n    img = Image.open(path)\n    arr = np.array(img)\n    \n    bg_color = arr[0, 0]\n    \n    # Create a simpler visualization - just show where foreground is\n    is_background = np.all(arr == bg_color, axis=2)\n    \n    # Get bounding box\n    fg_pixels = np.argwhere(~is_background)\n    min_y, min_x = fg_pixels.min(axis=0)\n    max_y, max_x = fg_pixels.max(axis=0)\n    \n    # Get the number region\n    region = arr[min_y:max_y+1, min_x:max_x+1]\n    \n    # Find the dominant non-background color in the region\n    flat_region = region.reshape(-1, 3)\n    unique_colors = np.unique(flat_region, axis=0)\n    \n    print(f\"{tile_file} (bg={list(bg_color)}):\")\n    print(f\"  Number of unique colors in region: {len(unique_colors)}\")\n    print(f\"  First 5 unique colors: {unique"]
[183.349344, "i", "_colors[:5]}\")\n    print(f\"  Last 5 unique colors: {unique_colors[-5:]}\")\n    \n    # Check if number is in center\n    height, width = max_y - min_y + 1, max_x - min_x + 1\n    center_y, center_x = (min_y + max_y) // 2, (min_x + max_x) // 2\n    print(f\"  Region: {width}x{height}, center: ({center_x}, {center_y})\")\n    print()\nEOF\n"]
