[400.148985, "o", "\r\n\u001b[?2004l\r"]
[400.149321, "o", "\u001b[?2004h"]
[400.149332, "o", "> "]
[400.149393, "o", "for tile_file in tile_files:\r\n\u001b[?2004l\r"]
[400.149419, "o", "\u001b[?2004h> "]
[400.14944, "o", "    path = os.path.join(tiles_dir, tile_file)\r\n\u001b[?2004l\r"]
[400.14945, "o", "\u001b[?2004h> "]
[400.14947, "o", "    img = Image.open(path)\r\n\u001b[?2004l\r"]
[400.149481, "o", "\u001b[?2004h> "]
[400.149498, "o", "    arr = np.array(img)\r\n\u001b[?2004l\r"]
[400.149505, "o", "\u001b[?2004h> "]
[400.149519, "o", "    \r\n\u001b[?2004l\r"]
[400.149529, "o", "\u001b[?2004h> "]
[400.149541, "o", "    bg_color = arr[0, 0]\r\n\u001b[?2004l\r"]
[400.149551, "o", "\u001b[?2004h> "]
[400.149591, "o", "    is_background = np.all(arr == bg_color, axis=2)\r\n\u001b[?2004l\r"]
[400.149598, "o", "\u001b[?2004h> "]
[400.149626, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.14966, "o", "    fg_pixels = np.argwhere(~is_background)\r\n\u001b[?2004l\r"]
[400.149672, "o", "\u001b[?2004h> "]
[400.149708, "o", "    min_y, min_x = fg_pixels.min(axis=0)\r\n\u001b[?2004l\r"]
[400.14972, "o", "\u001b[?2004h> "]
[400.149755, "o", "    max_y, max_x = fg_pixels.max(axis=0)\r\n\u001b[?2004l\r"]
[400.149766, "o", "\u001b[?2004h"]
[400.149777, "o", ">     \r\n\u001b[?2004l\r"]
[400.14979, "o", "\u001b[?2004h> "]
[400.149828, "o", "    region = arr[min_y:max_y+1, min_x:max_x+1]\r\n\u001b[?2004l\r"]
[400.149841, "o", "\u001b[?2004h> "]
[400.149871, "o", "    number_vals = region[:,:,0]\r\n\u001b[?2004l\r"]
[400.149884, "o", "\u001b[?2004h> "]
[400.149897, "o", "    \r\n\u001b[?2004l\r"]
[400.149908, "o", "\u001b[?2004h> "]
[400.149943, "o", "    # Use threshold to create binary image\r\n\u001b[?2004l\r"]
[400.149954, "o", "\u001b[?2004h> "]
[400.149974, "o", "    threshold = 5\r\n\u001b[?2004l\r"]
[400.149986, "o", "\u001b[?2004h> "]
[400.150043, "o", "    binary = (number_vals > threshold).astype(np.uint8)\r\n\u001b[?2004l\r"]
[400.150053, "o", "\u001b[?2004h> "]
[400.150064, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[400.150073, "o", "> "]
[400.150097, "o", "    # Calculate some features\r\n\u001b[?2004l\r"]
[400.150108, "o", "\u001b[?2004h> "]
[400.150138, "o", "    height, width = binary.shape\r\n\u001b[?2004l\r"]
[400.150148, "o", "\u001b[?2004h> "]
[400.150179, "o", "    total_pixels = np.sum(binary)\r\n\u001b[?2004l\r"]
[400.150188, "o", "\u001b[?2004h> "]
[400.150198, "o", "    \r\n\u001b[?2004l\r"]
[400.150211, "o", "\u001b[?2004h> "]
[400.150263, "o", "    # Count holes (pixels surrounded by foreground on all sides)\r\n\u001b[?2004l\r"]
[400.15027, "o", "\u001b[?2004h> "]
[400.150288, "o", "    holes = 0\r\n\u001b[?2004l\r"]
[400.150299, "o", "\u001b[?2004h> "]
[400.150329, "o", "    for i in range(1, height-1):\r\n\u001b[?2004l\r"]
[400.15034, "o", "\u001b[?2004h> "]
[400.150372, "o", "        for j in range(1, width-1):\r\n\u001b[?2004l\r"]
[400.150386, "o", "\u001b[?2004h> "]
[400.150486, "o", "            if binary[i, j] == 0 and binary[i-1, j] == 1 and binary[i+1, j] == 1 and binary[i, j-1] == 1 and binary[i, j+1] == 1:\r\n\u001b[?2004l\r"]
[400.1505, "o", "\u001b[?2004h> "]
[400.150544, "o", "                holes += 1\r\n\u001b[?2004l\r"]
[400.150571, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.1506, "o", "    # Check if top is connected (for 1 vs 0/8)\r\n\u001b[?2004l\r"]
[400.150615, "o", "\u001b[?2004h> "]
[400.150648, "o", "    top_connected = np.any(binary[0, :])\r\n\u001b[?2004l\r"]
[400.150693, "o", "\u001b[?2004h> "]
[400.150733, "o", "    bottom_connected = np.any(binary[-1, :])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.150763, "o", "    print(f\"{tile_file}:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[400.150824, "o", "    print(f\"  Size: {width}x{height}, Total pixels: {total_pixels}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[400.150847, "o", "> "]
[400.15091, "o", "    print(f\"  Top connected: {top_connected}, Bottom connected: {bottom_connected}\")\r\n\u001b[?2004l\r"]
[400.150933, "o", "\u001b[?2004h> "]
[400.150953, "o", "    print(f\"  Holes: {holes}\")\r\n\u001b[?2004l\r"]
[400.150976, "o", "\u001b[?2004h>     print()\r\n\u001b[?2004l\r"]
[400.150997, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[400.339706, "o", "tile_001.png:\r\n  Size: 9x12, Total pixels: 29\r\n  Top connected: False, Bottom connected: False\r\n  Holes: 0\r\n\r\n"]
[400.340644, "o", "tile_002.png:\r\n  Size: 7x12, Total pixels: 43\r\n  Top connected: True, Bottom connected: True\r\n  Holes: 0\r\n\r\n"]
[400.341611, "o", "tile_003.png:\r\n  Size: 10x12, Total pixels: 78\r\n  Top connected: True, Bottom connected: True\r\n  Holes: 0\r\n\r\n"]
[400.342579, "o", "tile_004.png:\r\n  Size: 9x12, Total pixels: 27\r\n  Top connected: False, Bottom connected: False\r\n  Holes: 0\r\n\r\n"]
[400.3529, "o", "\u001b[?2004hroot@1adde69d8662:/workdir# "]
