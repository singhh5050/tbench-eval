[294.640849, "o", "tile_001.png:\r\n  Bounding box: (95,96) to (103,107)\r\n  Center: (99,101)\r\n"]
[294.640882, "o", "  Center pixel: [163 163 163]\r\n\r\n"]
[294.64184, "o", "tile_002.png:\r\n  Bounding box: (96,96) to (102,107)\r\n  Center: (99,101)\r\n"]
[294.641873, "o", "  Center pixel: [0 0 0]\r\n\r\n"]
[294.642787, "o", "tile_003.png:\r\n  Bounding box: (95,96) to (104,107)\r\n  Center: (99,101)\r\n"]
