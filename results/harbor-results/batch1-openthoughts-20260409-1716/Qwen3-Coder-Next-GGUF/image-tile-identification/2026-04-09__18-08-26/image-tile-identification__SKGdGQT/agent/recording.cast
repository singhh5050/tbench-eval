[339.069264, "o", "\u001b[?2004h> "]
[339.069299, "o", "    # Find threshold to separate number from any noise\r\n\u001b[?2004l\r"]
[339.06931, "o", "\u001b[?2004h> "]
[339.069357, "o", "    threshold = np.percentile(number_vals[number_vals > 0], 50)\r\n\u001b[?2004l\r\u001b[?2004h"]
