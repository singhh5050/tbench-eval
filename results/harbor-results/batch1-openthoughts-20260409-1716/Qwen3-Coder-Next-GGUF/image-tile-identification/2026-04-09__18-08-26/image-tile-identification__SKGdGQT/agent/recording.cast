[315.216387, "i", "pip install opencv-python -q && python3 << 'EOF'\nimport cv2\nimport numpy as np\nimport os\n\ntiles_dir = '/workdir/data/tiles/'\ntile_files = ['tile_001.png', 'tile_002.png', 'tile_003.png', 'tile_004.png']\n\nfor tile_file in tile_files:\n    path = os.path.join(tiles_dir, tile_file)\n    img = cv2.imread(path)\n    \n    # Get background color from top-left corner\n    bg_color = img[0, 0]\n    \n    # Create mask for non-background pixels\n    diff = cv2.absdiff(img, bg_color)\n    gray = cv2.cvtColor(diff, cv2.COLOR_BGR2GRAY)\n    mask = gray > 10\n    \n    # Find contours\n    contours, _ = cv2.findContours(mask.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    \n    print(f\"{tile_file}:\")\n    print(f\"  Background: {list(bg_color)}\")\n    print(f\"  Contours found: {len(contours)}\")\n    \n    if contours:\n        # Get bounding box of largest contour\n        cnt = max(contours, key=cv2.contourArea)\n        x, y, w, h = cv2.boundingRect(cnt)\n        print(f\"  Bounding box: ({x},{y}) size {w}x{h}\")\n        \n    "]
[315.216511, "i", "    # Draw the contour\n        contour_img = np.zeros((h, w), dtype=np.uint8)\n        cnt_in_region = cnt.copy()\n        cnt_in_region[:, 0, 0] -= x\n        cnt_in_region[:, 0, 1] -= y\n        cv2.drawContours(contour_img, [cnt_in_region], -1, 255, 1)\n        \n        print(\"  Contour outline:\")\n        for row in contour_img:\n            line = ''.join('#' if v else ' ' for v in row)\n            print(f\"    {line}\")\n    print()\nEOF\n"]
