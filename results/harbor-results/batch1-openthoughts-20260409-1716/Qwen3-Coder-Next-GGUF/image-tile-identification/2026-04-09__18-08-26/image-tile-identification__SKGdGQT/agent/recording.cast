[277.58788, "i", "python3 << 'EOF'\nfrom PIL import Image\nimport numpy as np\nimport os\n\ntiles_dir = '/workdir/data/tiles/'\ntile_files = ['tile_001.png', 'tile_002.png', 'tile_003.png', 'tile_004.png']\n\nfor tile_file in tile_files:\n    path = os.path.join(tiles_dir, tile_file)\n    img = Image.open(path)\n    arr = np.array(img)\n    \n    bg_color = arr[0, 0]\n    is_background = np.all(arr == bg_color, axis=2)\n    \n    fg_pixels = np.argwhere(~is_background)\n    min_y, min_x = fg_pixels.min(axis=0)\n    max_y, max_x = fg_pixels.max(axis=0)\n    \n    region = arr[min_y:max_y+1, min_x:max_x+1]\n    number_vals = region[:,:,0]\n    \n    # Find the actual number pixels (exclude background colors)\n    # The number is grayscale (R=G=B), background has one dominant color\n    # Find pixels where R=G=B (grayscale) vs where one channel dominates\n    \n    # Get unique colors in the region\n    flat = region.reshape(-1, 3)\n    unique_colors = np.unique(flat, axis=0)\n    \n    # Filter to only grayscale-like colors (where all channels are similar)\n  "]
[277.588038, "i", "  grayscale_mask = np.abs(unique_colors[:,0] - unique_colors[:,1]) < 5\n    grayscale_mask &= np.abs(unique_colors[:,1] - unique_colors[:,2]) < 5\n    grayscale_colors = unique_colors[grayscale_mask]\n    \n    print(f\"{tile_file}:\")\n    print(f\"  Number region: {region.shape[1]}x{region.shape[0]}\")\n    print(f\"  Unique grayscale colors: {len(grayscale_colors)}\")\n    \n    # Show the shape using only grayscale pixels\n    is_grayscale = np.abs(number_vals - number_vals) < 5  # Always true for R channel\n    # Actually, let's look at the pattern differently\n    \n    # Threshold to show the actual shape\n    threshold = np.median(number_vals[number_vals > 0])\n    binary = (number_vals > threshold).astype(int)\n    \n    print(f\"  Threshold: {threshold}\")\n    print(f\"  Binary shape:\")\n    for row in binary:\n        line = ''.join('#' if v else ' ' for v in row)\n        print(f\"    {line}\")\n    print()\nEOF\n"]
