[271.282135, "o", "> "]
[271.282153, "o", "            \"destination_id\": dest_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.282173, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.282192, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.282224, "o", "        remaining.remove(best_sid)\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.282243, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.282268, "o", "    # Sort by shipment_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.282287, "o", "> "]
