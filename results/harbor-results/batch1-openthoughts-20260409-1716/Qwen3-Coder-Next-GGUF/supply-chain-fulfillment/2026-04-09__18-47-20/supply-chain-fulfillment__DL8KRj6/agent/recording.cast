[360.098056, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.098078, "o", "    # Check thresholds\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.098097, "o", "> "]
[360.098121, "o", "    meets_total = result['total_score'] >= 0.6468\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.098141, "o", "> "]
[360.098163, "o", "    meets_cost = result['cost_score'] >= 0.6965\r\n\u001b[?2004l\r"]
[360.098181, "o", "\u001b[?2004h> "]
[360.098215, "o", "    meets_ontime = result['on_time_delivery_score'] >= 0.995\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.098236, "o", "> "]
[360.098273, "o", "    meets_balance = result['warehouse_balance_score'] >= 0.2548\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.098292, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.098317, "o", "    print(f'\\nThreshold Check:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.098371, "o", "    print(f'  Total: {\\\"PASS\\\" if meets_total else \\\"FAIL\\\"}')\r\n\u001b[?2004l\r"]
[360.098388, "o", "\u001b[?2004h> "]
[360.098436, "o", "    print(f'  Cost: {\\\"PASS\\\" if meets_cost else \\\"FAIL\\\"}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.098484, "o", "    print(f'  On-Time: {\\\"PASS\\\" if meets_ontime else \\\"FAIL\\\"}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.098496, "o", "> "]
[360.098542, "o", "    print(f'  Balance: {\\\"PASS\\\" if meets_balance else \\\"FAIL\\\"}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.098562, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.098617, "o", "    print(f'Errors: {result[\\\"validation_errors\\\"][:10]}')\r\n\u001b[?2004l\r"]
[360.098629, "o", "\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
