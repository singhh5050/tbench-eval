[151.312646, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.312674, "o", "def compute_cost(shipment, warehouse, route):\r\n\u001b[?2004l\r"]
[151.312692, "o", "\u001b[?2004h> "]
[151.312718, "o", "    \"\"\"Compute fulfillment cost for an assignment.\"\"\"\r\n\u001b[?2004l\r"]
[151.312735, "o", "\u001b[?2004h> "]
[151.312775, "o", "    h = warehouse[\"base_handling_cost\"] * (shipment[\"volume\"] / 100)\r\n\u001b[?2004l\r"]
[151.312791, "o", "\u001b[?2004h> "]
[151.312841, "o", "    t = route[\"base_cost_per_km\"] * route[\"distance_km\"] * (shipment[\"weight\"] / 1000)\r\n\u001b[?2004l\r"]
[151.312855, "o", "\u001b[?2004h> "]
[151.312877, "o", "    m = shipment[\"priority_multiplier\"]\r\n\u001b[?2004l\r"]
[151.312893, "o", "\u001b[?2004h> "]
[151.31291, "o", "    return (h + t) * m\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.312924, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.312942, "o", "def solve(input_dir, output_file):\r\n\u001b[?2004l\r"]
[151.312958, "o", "\u001b[?2004h> "]
[151.312973, "o", "    \"\"\"Main solving function.\"\"\"\r\n\u001b[?2004l\r"]
[151.312991, "o", "\u001b[?2004h> "]
[151.313047, "o", "    shipments, warehouses, destinations, routes, routes_by_key, compatibility = load_data(input_dir)\r\n\u001b[?2004l\r"]
[151.313055, "o", "\u001b[?2004h> "]
[151.313078, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[151.313093, "o", "> "]
[151.313101, "o", "    # Build valid assignments for each shipment\r\n\u001b[?2004l\r"]
[151.313121, "o", "\u001b[?2004h> "]
[151.313138, "o", "    shipment_valid = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.313162, "o", "    for sid, shipment in shipments.items():\r\n\u001b[?2004l\r"]
[151.313178, "o", "\u001b[?2004h> "]
[151.313233, "o", "        valid = get_valid_routes_for_shipment(shipment, warehouses, routes_by_key, destinations)\r\n\u001b[?2004l\r"]
[151.313249, "o", "\u001b[?2004h> "]
[151.313267, "o", "        shipment_valid[sid] = valid\r\n\u001b[?2004l\r"]
[151.313284, "o", "\u001b[?2004h> "]
[151.313298, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.313339, "o", "    # Sort shipments by priority (critical first) for better assignment\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.313358, "o", "> "]
[151.313394, "o", "    priority_order = {\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}\r\n\u001b[?2004l\r"]
[151.313417, "o", "\u001b[?2004h> "]
[151.313472, "o", "    sorted_shipments = sorted(shipments.values(), key=lambda s: priority_order.get(s[\"priority\"], 2))\r\n\u001b[?2004l\r"]
[151.313489, "o", "\u001b[?2004h>     \r\n"]
[151.313506, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[151.31352, "o", "    # Track warehouse loads\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.313547, "o", "    warehouse_volume = defaultdict(int)\r\n\u001b[?2004l\r"]
[151.313561, "o", "\u001b[?2004h> "]
[151.313583, "o", "    warehouse_weight = defaultdict(int)\r\n\u001b[?2004l\r"]
[151.313599, "o", "\u001b[?2004h>     \r\n"]
[151.313612, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[151.313628, "o", "    # Track route usage\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.313652, "o", "    route_volume = defaultdict(int)\r\n\u001b[?2004l\r"]
[151.313667, "o", "\u001b[?2004h> "]
[151.313686, "o", "    route_weight = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.3137, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.313719, "o", "    assignments = []\r\n\u001b[?2004l\r"]
[151.313734, "o", "\u001b[?2004h>     \r\n"]
[151.313749, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[151.313764, "o", "    for shipment in sorted_shipments:\r\n\u001b[?2004l\r"]
[151.31378, "o", "\u001b[?2004h> "]
[151.313798, "o", "        sid = shipment[\"shipment_id\"]\r\n\u001b[?2004l\r"]
[151.313813, "o", "\u001b[?2004h> "]
[151.31383, "o", "        valid = shipment_valid[sid]\r\n\u001b[?2004l\r"]
[151.313845, "o", "\u001b[?2004h> "]
[151.313859, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.313874, "o", "        if not valid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.313923, "o", "            print(f\"Warning: No valid assignment for shipment {sid}\")\r\n\u001b[?2004l\r"]
[151.313939, "o", "\u001b[?2004h> "]
[151.313955, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.313971, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[151.313985, "o", ">         # Score each option\r\n\u001b[?2004l\r"]
[151.313999, "o", "\u001b[?2004h> "]
[151.314015, "o", "        scored = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.314061, "o", "        for wh_id, dest_id, route, warehouse, arrival_time in valid:\r\n\u001b[?2004l\r"]
[151.314077, "o", "\u001b[?2004h> "]
[151.314101, "o", "            # Check warehouse capacity constraints\r\n\u001b[?2004l\r"]
[151.314116, "o", "\u001b[?2004h> "]
[151.314153, "o", "            new_vol = warehouse_volume[wh_id] + shipment[\"volume\"]\r\n\u001b[?2004l\r"]
[151.314168, "o", "\u001b[?2004h> "]
[151.314205, "o", "            new_weight = warehouse_weight[wh_id] + shipment[\"weight\"]\r\n\u001b[?2004l\r"]
[151.314221, "o", "\u001b[?2004h> "]
[151.314235, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.314268, "o", "            if new_vol > warehouse[\"volume_capacity\"]:\r\n\u001b[?2004l\r"]
[151.314277, "o", "\u001b[?2004h> "]
[151.314296, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.314338, "o", "            if new_weight > warehouse[\"weight_capacity\"]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.314354, "o", "> "]
[151.314375, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.314389, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.314412, "o", "            # Check route capacity\r\n\u001b[?2004l\r"]
[151.314427, "o", "\u001b[?2004h> "]
[151.314471, "o", "            new_route_vol = route_volume[(wh_id, dest_id)] + shipment[\"volume\"]\r\n\u001b[?2004l\r"]
[151.314487, "o", "\u001b[?2004h> "]
[151.314532, "o", "            new_route_weight = route_weight[(wh_id, dest_id)] + shipment[\"weight\"]\r\n\u001b[?2004l\r"]
[151.314546, "o", "\u001b[?2004h> "]
[151.314559, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.314595, "o", "            if new_route_vol > route[\"capacity_volume\"]:\r\n\u001b[?2004l\r"]
[151.314611, "o", "\u001b[?2004h> "]
[151.314625, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.314669, "o", "            if new_route_weight > route[\"capacity_weight\"]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.314685, "o", "> "]
[151.314698, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.314713, "o", "            \r\n\u001b[?2004l\r"]
[151.314726, "o", "\u001b[?2004h> "]
[151.314756, "o", "            cost = compute_cost(shipment, warehouse, route)\r\n\u001b[?2004l\r"]
[151.31477, "o", "\u001b[?2004h> "]
[151.314783, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.314823, "o", "            # Score: lower cost is better, also consider balance\r\n\u001b[?2004l\r"]
[151.314839, "o", "\u001b[?2004h> "]
[151.314901, "o", "            utilization = new_vol / warehouse[\"volume_capacity\"] if warehouse[\"volume_capacity\"] > 0 else 1\r\n\u001b[?2004l\r"]
[151.314916, "o", "\u001b[?2004h> "]
[151.31493, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.314962, "o", "            # Prefer less utilized warehouses for balance\r\n\u001b[?2004l\r"]
[151.314977, "o", "\u001b[?2004h> "]
[151.314998, "o", "            score = cost + utilization * 10\r\n\u001b[?2004l\r"]
[151.315015, "o", "\u001b[?2004h> "]
[151.315029, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.31508, "o", "            scored.append((score, cost, wh_id, dest_id, route, warehouse, arrival_time))\r\n\u001b[?2004l\r"]
[151.315095, "o", "\u001b[?2004h> "]
[151.315108, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.315123, "o", "        if not scored:\r\n\u001b[?2004l\r"]
[151.315136, "o", "\u001b[?2004h> "]
[151.315171, "o", "            print(f\"Warning: No feasible assignment for shipment {sid}\")\r\n\u001b[?2004l\r"]
[151.315186, "o", "\u001b[?2004h> "]
[151.3152, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.315214, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[151.315229, "o", "> "]
[151.315246, "o", "        # Pick best option (lowest score)\r\n\u001b[?2004l\r"]
[151.31526, "o", "\u001b[?2004h> "]
[151.31528, "o", "        scored.sort(key=lambda x: x[0])\r\n\u001b[?2004l\r"]
[151.315299, "o", "\u001b[?2004h> "]
[151.315312, "o", "        best = scored[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.315326, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.315377, "o", "        _, cost, wh_id, dest_id, route, warehouse, arrival_time = best\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.315392, "o", "> "]
[151.315406, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.315421, "o", "        # Update tracking\r\n\u001b[?2004l\r"]
[151.315435, "o", "\u001b[?2004h> "]
[151.315458, "o", "        warehouse_volume[wh_id] += shipment[\"volume\"]\r\n\u001b[?2004l\r"]
[151.315473, "o", "\u001b[?2004h> "]
[151.315499, "o", "        warehouse_weight[wh_id] += shipment[\"weight\"]\r\n\u001b[?2004l\r"]
[151.315514, "o", "\u001b[?2004h> "]
[151.315547, "o", "        route_volume[(wh_id, dest_id)] += shipment[\"volume\"]\r\n\u001b[?2004l\r"]
[151.315561, "o", "\u001b[?2004h> "]
[151.315593, "o", "        route_weight[(wh_id, dest_id)] += shipment[\"weight\"]\r\n\u001b[?2004l\r"]
[151.315609, "o", "\u001b[?2004h> "]
[151.315624, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.315639, "o", "        assignments.append({\r\n\u001b[?2004l\r"]
[151.315652, "o", "\u001b[?2004h> "]
[151.315665, "o", "            \"shipment_id\": sid,\r\n\u001b[?2004l\r"]
[151.315679, "o", "\u001b[?2004h> "]
[151.315694, "o", "            \"warehouse_id\": wh_id,\r\n\u001b[?2004l\r"]
[151.315708, "o", "\u001b[?2004h> "]
[151.315728, "o", "            \"destination_id\": dest_id\r\n\u001b[?2004l\r"]
[151.315742, "o", "\u001b[?2004h> "]
[151.315754, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[151.315769, "o", "\u001b[?2004h> "]
[151.315783, "o", "    # Sort by shipment_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.315822, "o", "    assignments.sort(key=lambda x: x[\"shipment_id\"])\r\n\u001b[?2004l\r"]
[151.315837, "o", "\u001b[?2004h>     \r\n"]
[151.31585, "o", "\u001b[?2004l\r\u001b[?2004h>     # Write output\r\n"]
[151.315868, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[151.315897, "o", "    output_file.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[151.315911, "o", "\u001b[?2004h> "]
[151.31593, "o", "    with open(output_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[151.315944, "o", "\u001b[?2004h> "]
[151.315957, "o", "        for a in assignments:\r\n\u001b[?2004l\r"]
[151.315971, "o", "\u001b[?2004h> "]
[151.315992, "o", "            f.write(json.dumps(a) + \"\\n\")\r\n\u001b[?2004l\r"]
[151.316007, "o", "\u001b[?2004h> "]
[151.316022, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.316046, "o", "    print(f\"Wrote {len(assignments)} assignments\")\r\n\u001b[?2004l\r"]
[151.31606, "o", "\u001b[?2004h> "]
[151.316075, "o", "    return assignments\r\n\u001b[?2004l\r"]
[151.316089, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.316104, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[151.316118, "o", "\u001b[?2004h> "]
[151.316146, "o", "    input_dir = Path(\"/app/task_file/input_data\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.316163, "o", "> "]
[151.316199, "o", "    output_file = Path(\"/app/task_file/output_data/assignments.jsonl\")\r\n\u001b[?2004l\r"]
[151.316214, "o", "\u001b[?2004h> "]
[151.316229, "o", "    solve(input_dir, output_file)\r\n\u001b[?2004l\r"]
[151.316243, "o", "\u001b[?2004h> "]
[151.316256, "o", "ENDOFSCRIPT\r\n\u001b[?2004l\r"]
[151.317275, "o", "\u001b[?2004h"]
[151.317283, "o", "root@b12cd1002d87:/app# "]
[158.474256, "i", "python3 /app/solve.py\n"]
[158.474485, "o", "python3 /app/solve.py\r\n\u001b[?2004l\r"]
[158.562375, "o", "Warning: No feasible assignment for shipment 990\r\n"]
[158.564016, "o", "Wrote 999 assignments\r\n"]
[158.56859, "o", "\u001b[?2004hroot@b12cd1002d87:/app# "]
[177.081572, "i", "python3 -c \"\nimport sys\nfrom pathlib import Path\nsys.path.append('/app/task_file/scripts')\nfrom model import SupplyChainModel\n\nmodel = SupplyChainModel()\nresult = model.evaluate(\n    input_dir=Path('/app/task_file/input_data'),\n    output_file=Path('/app/task_file/output_data/assignments.jsonl')\n)\n\nprint(f'Valid: {result[\\\"is_valid\\\"]}')\nif result['is_valid']:\n    print(f'Total Score: {result[\\\"total_score\\\"]:.4f}')\n    print(f'Cost Score: {result[\\\"cost_score\\\"]:.4f}')\n    print(f'On-Time Score: {result[\\\"on_time_delivery_score\\\"]:.4f}')\n    print(f'Balance Score: {result[\\\"warehouse_balance_score\\\"]:.4f}')\nelse:\n    print(f'Errors: {result[\\\"validation_errors\\\"][:10]}')\n\"\n"]
[177.08181, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
