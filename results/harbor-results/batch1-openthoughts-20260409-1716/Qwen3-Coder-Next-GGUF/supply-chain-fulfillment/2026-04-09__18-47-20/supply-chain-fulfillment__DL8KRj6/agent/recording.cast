[360.096537, "i", "python3 -c \"\nimport sys\nfrom pathlib import Path\nsys.path.append('/app/task_file/scripts')\nfrom model import SupplyChainModel\n\nmodel = SupplyChainModel()\nresult = model.evaluate(\n    input_dir=Path('/app/task_file/input_data'),\n    output_file=Path('/app/task_file/output_data/assignments.jsonl')\n)\n\nprint(f'Valid: {result[\\\"is_valid\\\"]}')\nif result['is_valid']:\n    print(f'Total Score: {result[\\\"total_score\\\"]:.4f} (threshold: 0.6468)')\n    print(f'Cost Score: {result[\\\"cost_score\\\"]:.4f} (threshold: 0.6965)')\n    print(f'On-Time Score: {result[\\\"on_time_delivery_score\\\"]:.4f} (threshold: 0.995)')\n    print(f'Balance Score: {result[\\\"warehouse_balance_score\\\"]:.4f} (threshold: 0.2548)')\n    \n    # Check thresholds\n    meets_total = result['total_score'] >= 0.6468\n    meets_cost = result['cost_score'] >= 0.6965\n    meets_ontime = result['on_time_delivery_score'] >= 0.995\n    meets_balance = result['warehouse_balance_score'] >= 0.2548\n    \n    print(f'\\nThreshold Check:')\n    print(f'  Total: {\\\"PASS\\\" if meets_total else \\\"FAIL\\\"}')\n    print(f'  Cost: {\\\"PASS\\\" if meets_cost else \\\"FAIL\\\"}')\n    print(f'  On-Time: {\\\"PASS\\\" if meets_ontime else \\\"FAIL\\\"}')\n    print(f'  Balance: {\\\"PASS\\\" if meets_balance else \\\"FAIL\\\"}')\nelse:\n    print(f'Errors: {result[\\\"validation_errors\\\"][:10]}')\n\"\n"]
