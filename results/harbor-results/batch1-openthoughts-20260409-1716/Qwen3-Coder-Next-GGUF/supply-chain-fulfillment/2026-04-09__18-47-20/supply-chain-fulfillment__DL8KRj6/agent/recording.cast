[177.081945, "o", "> model = SupplyChainModel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.081969, "o", "result = model.evaluate(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.082012, "o", "    input_dir=Path('/app/task_file/input_data'),\r\n\u001b[?2004l\r"]
[177.082029, "o", "\u001b[?2004h> "]
[177.082071, "o", "    output_file=Path('/app/task_file/output_data/assignments.jsonl')\r\n\u001b[?2004l\r"]
[177.082081, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[177.082093, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.082103, "o", "\u001b[?2004h> "]
[177.082155, "o", "print(f'Valid: {result[\\\"is_valid\\\"]}')\r\n\u001b[?2004l\r"]
[177.082179, "o", "\u001b[?2004h> if result['is_valid']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.082215, "o", "    print(f'Total Score: {result[\\\"total_score\\\"]:.4f}')\r\n\u001b[?2004l\r"]
[177.082233, "o", "\u001b[?2004h> "]
[177.082266, "o", "    print(f'Cost Score: {result[\\\"cost_score\\\"]:.4f}')\r\n\u001b[?2004l\r"]
[177.082285, "o", "\u001b[?2004h> "]
[177.082335, "o", "    print(f'On-Time Score: {result[\\\"on_time_delivery_score\\\"]:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.082344, "o", "> "]
[177.082462, "o", "    print(f'Balance Score: {result[\\\"warehouse_balance_score\\\"]:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.082556, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.082571, "o", "    print(f'Errors: {result[\\\"validation_errors\\\"][:10]}')\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
[177.160984, "o", "Valid: False\r\nErrors: ['Constraint 1 (Completeness): Missing shipments: [990]']\r\n"]
[177.166142, "o", "\u001b[?2004h"]
[177.166155, "o", "root@b12cd1002d87:/app# "]
[208.509955, "i", "python3 << 'EOF'\nimport json\nfrom pathlib import Path\n\n# Load data\nwith open('/app/task_file/input_data/shipments.jsonl') as f:\n    shipments = {json.loads(line)['shipment_id']: json.loads(line) for line in f}\n\nwith open('/app/task_file/input_data/warehouses.jsonl') as f:\n    warehouses = {json.loads(line)['warehouse_id']: json.loads(line) for line in f}\n\nwith open('/app/task_file/input_data/routes.jsonl') as f:\n    routes = {}\n    routes_by_key = {}\n    for line in f:\n        r = json.loads(line)\n        routes[r['route_id']] = r\n        routes_by_key[(r['warehouse_id'], r['destination_id'])] = r\n\nwith open('/app/task_file/input_data/destinations.jsonl') as f:\n    destinations = {json.loads(line)['destination_id']: json.loads(line) for line in f}\n\nshipment = shipments[990]\nprint(f\"Shipment 990: {shipment}\")\nprint(f\"\\nDestination: {destinations[shipment['destination_id']]}\")\n\nprint(\"\\nLooking for valid routes:\")\nfor (wh_id, dest_id), route in routes_by_key.items():\n    if dest_id != shipment['destination_id']:\n        continue\n    wh = warehouses[wh_id]\n    dest = destinations[dest_id]\n    \n    # Check capabilities\n    if shipment['requires_hazmat'] and not wh['handles_hazmat']:\n        continue\n    if shipment['requires_refrigerated'] and not wh['handles_refrigerated']:\n        continue\n    if shipment['requires_oversized'] and not wh['handles_oversized']:\n        continue\n    \n    # Check route capabilities\n    if shipment['requires_hazmat'] and not route['allows_hazmat']:\n        continue\n    if shipment['requires_refrigerated'] and not route['allows_refrigerated']:\n        continue\n    if shipment['requires_oversized'] and not route['allows_oversized']:\n        continue\n    \n    # Check capacities\n    if shipment['volume'] > route['capacity_volume']:\n        continue\n    if shipment['weight'] > route['capacity_weight']:\n        continue\n    if shipment['volume'] > wh['volume_capacity']:\n        continue\n    if shipment['weight'] > wh['weight_capacity']:\n        continue\n    \n    arrival = wh['availability_start'] + route['transit_time_hours']\n    \n    # Check deadline\n    if arrival > shipment['deadline_hours']:\n        print(f\"  WH{wh_id} -> Dest{dest_id}: arrival={arrival:.2f}, deadline={shipment['deadline_hours']} - FAIL (late)\")\n        continue\n    \n    # Check time window\n    if arrival < dest['delivery_window_start'] or arrival > dest['delivery_window_end']:\n        print(f\"  WH{wh_id} -> Dest{dest_id}: arrival={arrival:.2f}, window=[{dest['delivery_window_start']}, {dest['delivery_window_end']}] - FAIL (time window)\")\n        continue\n    \n    print(f\"  WH{wh_id} -> Dest{dest_id}: arrival={arrival:.2f}, cost={(wh['base_handling_cost'] * shipment['volume']/100 + route['base_cost_per_km'] * route['distance_km'] * shipment['weight']/1000) * shipment['priority_multiplier']:.2f}\")\nEOF\n"]
[208.51016, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.510181, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.510277, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[208.510353, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/task_file/input_data/shipments.jsonl') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.51038, "o", "    shipments = {json.loads(line)['shipment_id']: json.loads(line) for line in f}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.510457, "o", "with open('/app/task_file/input_data/warehouses.jsonl') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.510506, "o", "    warehouses = {json.loads(line)['warehouse_id']: json.loads(line) for line in f}\r\n\u001b[?2004l\r"]
[208.510528, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
