[300.060462, "i", "python3 -c \"\nimport sys\nfrom pathlib import Path\nsys.path.append('/app/task_file/scripts')\nfrom model import SupplyChainModel\n\nmodel = SupplyChainModel()\nresult = model.evaluate(\n    input_dir=Path('/app/task_file/input_data'),\n    output_file=Path('/app/task_file/output_data/assignments.jsonl')\n)\n\nprint(f'Valid: {result[\\\"is_valid\\\"]}')\nif result['is_valid']:\n    print(f'Total Score: {result[\\\"total_score\\\"]:.4f}')\n    print(f'Cost Score: {result[\\\"cost_score\\\"]:.4f}')\n    print(f'On-Time Score: {result[\\\"on_time_delivery_score\\\"]:.4f}')\n    print(f'Balance Score: {result[\\\"warehouse_balance_score\\\"]:.4f}')\n    print(f'Clustering: {result[\\\"clustering_score\\\"]:.4f}')\n    print(f'Hub: {result[\\\"hub_utilization_score\\\"]:.4f}')\n    print(f'Fragmentation: {result[\\\"fragmentation_score\\\"]:.4f}')\n    print(f'Multi-hop: {result[\\\"multi_hop_score\\\"]:.4f}')\n    print(f'Priority: {result[\\\"priority_fairness_score\\\"]:.4f}')\n    print(f'Consolidation: {result[\\\"destination_consolidation_score\\\"]:.4f}')\nelse:\n    print(f'Errors: {result[\\\"validation_errors\\\"][:10]}')\n\"\n"]
