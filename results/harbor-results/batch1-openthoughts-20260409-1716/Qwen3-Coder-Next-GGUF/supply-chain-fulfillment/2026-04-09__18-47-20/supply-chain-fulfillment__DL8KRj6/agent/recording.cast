[271.273082, "o", "\u001b[?2004h> "]
[271.273109, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.27312, "o", "    routes = {}\r\n\u001b[?2004l\r"]
[271.273132, "o", "\u001b[?2004h> "]
[271.27317, "o", "    routes_by_key = {}\r\n\u001b[?2004l\r"]
[271.273186, "o", "\u001b[?2004h> "]
[271.273233, "o", "    with open(input_dir / \"routes.jsonl\") as f:\r\n\u001b[?2004l\r"]
[271.273245, "o", "\u001b[?2004h> "]
[271.273274, "o", "        for line in f:\r\n\u001b[?2004l\r"]
[271.273284, "o", "\u001b[?2004h> "]
[271.273326, "o", "            r = json.loads(line)\r\n\u001b[?2004l\r"]
[271.273349, "o", "\u001b[?2004h> "]
[271.273396, "o", "            routes[r[\"route_id\"]] = r\r\n\u001b[?2004l\r"]
[271.273406, "o", "\u001b[?2004h> "]
[271.273485, "o", "            key = (r[\"warehouse_id\"], r[\"destination_id\"])\r\n\u001b[?2004l\r"]
[271.273496, "o", "\u001b[?2004h> "]
[271.273539, "o", "            routes_by_key[key] = r\r\n\u001b[?2004l\r"]
[271.273549, "o", "\u001b[?2004h> "]
[271.273575, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.273603, "o", "> "]
[271.273621, "o", "    compatibility = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.27368, "o", "    with open(input_dir / \"compatibility.jsonl\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.27369, "o", "> "]
[271.273719, "o", "        for line in f:\r\n\u001b[?2004l\r"]
[271.27373, "o", "\u001b[?2004h> "]
[271.273797, "o", "            compatibility.append(json.loads(line))\r\n\u001b[?2004l\r"]
[271.273808, "o", "\u001b[?2004h>     "]
[271.273818, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.273851, "o", "> "]
[271.273932, "o", "    return shipments, warehouses, destinations, routes, routes_by_key, compatibility\r\n\u001b[?2004l\r"]
[271.273955, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.273971, "o", "\u001b[?2004h> "]
[271.274062, "o", "def get_valid_routes_for_shipment(shipment, warehouses, routes_by_key, destinations):\r\n\u001b[?2004l\r"]
[271.274073, "o", "\u001b[?2004h> "]
[271.274167, "o", "    \"\"\"Find all valid (warehouse, destination) pairs for a shipment.\"\"\"\r\n\u001b[?2004l\r"]
[271.274188, "o", "\u001b[?2004h> "]
[271.274211, "o", "    valid = []\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[271.274232, "o", "\u001b[?2004h> "]
[271.274298, "o", "    for (wh_id, dest_id), route in routes_by_key.items():\r\n\u001b[?2004l\r"]
[271.274317, "o", "\u001b[?2004h> "]
[271.274371, "o", "        if dest_id != shipment[\"destination_id\"]:\r\n\u001b[?2004l\r"]
[271.274393, "o", "\u001b[?2004h> "]
[271.27441, "o", "            continue\r\n\u001b[?2004l\r"]
[271.274431, "o", "\u001b[?2004h> "]
[271.27444, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.274498, "o", "        warehouse = warehouses[wh_id]\r\n\u001b[?2004l\r"]
[271.274551, "o", "\u001b[?2004h> "]
[271.274581, "o", "        dest_info = destinations[dest_id]\r\n\u001b[?2004l\r"]
[271.27461, "o", "\u001b[?2004h> "]
[271.27462, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.274629, "o", "> "]
[271.2747, "o", "        # Check warehouse capabilities\r\n\u001b[?2004l\r"]
[271.27473, "o", "\u001b[?2004h> "]
[271.274845, "o", "        if shipment[\"requires_hazmat\"] and not warehouse[\"handles_hazmat\"]:\r\n\u001b[?2004l\r"]
[271.274855, "o", "\u001b[?2004h> "]
[271.274897, "o", "            continue\r\n\u001b[?2004l\r"]
[271.274907, "o", "\u001b[?2004h> "]
[271.275063, "o", "        if shipment[\"requires_refrigerated\"] and not warehouse[\"handles_refrigerated\"]:\r\n\u001b[?2004l\r"]
[271.275081, "o", "\u001b[?2004h> "]
[271.275116, "o", "            continue\r\n\u001b[?2004l\r"]
[271.27514, "o", "\u001b[?2004h> "]
[271.275271, "o", "        if shipment[\"requires_oversized\"] and not warehouse[\"handles_oversized\"]:\r\n\u001b[?2004l\r"]
[271.275289, "o", "\u001b[?2004h> "]
[271.275325, "o", "            continue\r\n\u001b[?2004l\r"]
[271.275344, "o", "\u001b[?2004h> "]
[271.275368, "o", "        \r\n\u001b[?2004l\r"]
[271.275386, "o", "\u001b[?2004h> "]
[271.275447, "o", "        # Check route capabilities\r\n\u001b[?2004l\r"]
[271.275457, "o", "\u001b[?2004h> "]
[271.275592, "o", "        if shipment[\"requires_hazmat\"] and not route[\"allows_hazmat\"]:\r\n\u001b[?2004l\r"]
[271.275602, "o", "\u001b[?2004h> "]
[271.275643, "o", "            continue\r\n\u001b[?2004l\r"]
[271.275654, "o", "\u001b[?2004h> "]
[271.275814, "o", "        if shipment[\"requires_refrigerated\"] and not route[\"allows_refrigerated\"]:\r\n\u001b[?2004l\r"]
[271.275825, "o", "\u001b[?2004h> "]
[271.27587, "o", "            continue\r\n\u001b[?2004l\r"]
[271.275881, "o", "\u001b[?2004h> "]
[271.276027, "o", "        if shipment[\"requires_oversized\"] and not route[\"allows_oversized\"]:\r\n\u001b[?2004l\r"]
[271.276037, "o", "\u001b[?2004h> "]
[271.276082, "o", "            continue\r\n\u001b[?2004l\r"]
[271.276092, "o", "\u001b[?2004h> "]
[271.276114, "o", "        \r\n\u001b[?2004l\r"]
[271.276124, "o", "\u001b[?2004h> "]
[271.276184, "o", "        # Check route capacity\r\n\u001b[?2004l\r"]
[271.276194, "o", "\u001b[?2004h> "]
[271.276289, "o", "        if shipment[\"volume\"] > route[\"capacity_volume\"]:\r\n\u001b[?2004l\r"]
[271.276299, "o", "\u001b[?2004h> "]
[271.276324, "o", "            continue\r\n\u001b[?2004l\r"]
[271.276346, "o", "\u001b[?2004h> "]
[271.276418, "o", "        if shipment[\"weight\"] > route[\"capacity_weight\"]:\r\n\u001b[?2004l\r"]
[271.276429, "o", "\u001b[?2004h> "]
[271.276458, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.276468, "o", "> "]
[271.276488, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.276533, "o", "        # Check warehouse capacity\r\n\u001b[?2004l\r"]
[271.276543, "o", "\u001b[?2004h> "]
[271.276626, "o", "        if shipment[\"volume\"] > warehouse[\"volume_capacity\"]:\r\n\u001b[?2004l\r"]
[271.276636, "o", "\u001b[?2004h> "]
[271.276667, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.276677, "o", "> "]
[271.276756, "o", "        if shipment[\"weight\"] > warehouse[\"weight_capacity\"]:\r\n\u001b[?2004l\r"]
[271.276765, "o", "\u001b[?2004h> "]
[271.276793, "o", "            continue\r\n\u001b[?2004l\r"]
[271.276803, "o", "\u001b[?2004h> "]
[271.276827, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.276884, "o", "        # Check arrival time <= deadline\r\n\u001b[?2004l\r"]
[271.276895, "o", "\u001b[?2004h> "]
[271.277006, "o", "        arrival_time = warehouse[\"availability_start\"] + route[\"transit_time_hours\"]\r\n\u001b[?2004l\r"]
[271.277017, "o", "\u001b[?2004h> "]
[271.277086, "o", "        if arrival_time > shipment[\"deadline_hours\"]:\r\n\u001b[?2004l\r"]
[271.277097, "o", "\u001b[?2004h> "]
[271.277127, "o", "            continue\r\n\u001b[?2004l\r"]
[271.277137, "o", "\u001b[?2004h> "]
[271.277146, "o", "        \r\n\u001b[?2004l\r"]
[271.277159, "o", "\u001b[?2004h> "]
[271.277212, "o", "        # Check destination time window\r\n\u001b[?2004l\r"]
[271.277222, "o", "\u001b[?2004h> "]
[271.277375, "o", "        if arrival_time < dest_info[\"delivery_window_start\"] or arrival_time > dest_info[\"delivery_window_end\"]:\r\n\u001b[?2004l\r"]
[271.277384, "o", "\u001b[?2004h> "]
[271.277414, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.277436, "o", "> "]
[271.277454, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.277495, "o", "        # Check warehouse availability\r\n\u001b[?2004l\r"]
[271.277506, "o", "\u001b[?2004h> "]
[271.277607, "o", "        if warehouse[\"availability_start\"] >= warehouse[\"availability_end\"]:\r\n\u001b[?2004l\r"]
[271.277617, "o", "\u001b[?2004h> "]
[271.277645, "o", "            continue\r\n\u001b[?2004l\r"]
[271.277656, "o", "\u001b[?2004h> "]
[271.277751, "o", "        if shipment[\"deadline_hours\"] < warehouse[\"availability_start\"]:\r\n\u001b[?2004l\r"]
[271.277766, "o", "\u001b[?2004h> "]
[271.27779, "o", "            continue\r\n\u001b[?2004l\r"]
[271.277801, "o", "\u001b[?2004h> "]
[271.277827, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.277916, "o", "        valid.append((wh_id, dest_id, route, warehouse, arrival_time))\r\n\u001b[?2004l\r"]
[271.277926, "o", "\u001b[?2004h> "]
[271.277937, "o", "    \r\n\u001b[?2004l\r"]
[271.277974, "o", "\u001b[?2004h> "]
[271.277998, "o", "    return valid\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.278048, "o", "def compute_cost(shipment, warehouse, route):\r\n\u001b[?2004l\r"]
[271.27807, "o", "\u001b[?2004h> "]
[271.278126, "o", "    \"\"\"Compute fulfillment cost for an assignment.\"\"\"\r\n\u001b[?2004l\r"]
[271.278137, "o", "\u001b[?2004h> "]
[271.278228, "o", "    h = warehouse[\"base_handling_cost\"] * (shipment[\"volume\"] / 100)\r\n\u001b[?2004l\r"]
[271.278239, "o", "\u001b[?2004h> "]
[271.278352, "o", "    t = route[\"base_cost_per_km\"] * route[\"distance_km\"] * (shipment[\"weight\"] / 1000)\r\n\u001b[?2004l\r"]
[271.27838, "o", "\u001b[?2004h> "]
[271.278411, "o", "    m = shipment[\"priority_multiplier\"]\r\n\u001b[?2004l\r"]
[271.278422, "o", "\u001b[?2004h> "]
[271.278445, "o", "    return (h + t) * m\r\n\u001b[?2004l\r"]
[271.278454, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.278477, "o", "\u001b[?2004h> "]
[271.278497, "o", "def solve(input_dir, output_file):\r\n\u001b[?2004l\r"]
[271.278508, "o", "\u001b[?2004h> "]
[271.278556, "o", "    \"\"\"Main solving function with MRV heuristic.\"\"\"\r\n\u001b[?2004l\r"]
[271.278566, "o", "\u001b[?2004h> "]
[271.278655, "o", "    shipments, warehouses, destinations, routes, routes_by_key, compatibility = load_data(input_dir)\r\n\u001b[?2004l\r"]
[271.278666, "o", "\u001b[?2004h>     \r\n"]
[271.278676, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[271.278727, "o", "    # Build valid assignments for each shipment\r\n\u001b[?2004l\r"]
[271.278736, "o", "\u001b[?2004h> "]
[271.278764, "o", "    shipment_valid = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.278806, "o", "    for sid, shipment in shipments.items():\r\n\u001b[?2004l\r"]
[271.278816, "o", "\u001b[?2004h> "]
[271.278903, "o", "        valid = get_valid_routes_for_shipment(shipment, warehouses, routes_by_key, destinations)\r\n\u001b[?2004l\r"]
[271.278913, "o", "\u001b[?2004h> "]
[271.278947, "o", "        shipment_valid[sid] = valid\r\n\u001b[?2004l\r"]
[271.278958, "o", "\u001b[?2004h>     \r\n"]
[271.278983, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[271.279004, "o", "    # Track warehouse loads\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.279044, "o", "    warehouse_volume = defaultdict(int)\r\n\u001b[?2004l\r"]
[271.279053, "o", "\u001b[?2004h> "]
[271.279091, "o", "    warehouse_weight = defaultdict(int)\r\n\u001b[?2004l\r"]
[271.279102, "o", "\u001b[?2004h> "]
[271.279112, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.279143, "o", ">     # Track route usage\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.279153, "o", "> "]
[271.279187, "o", "    route_volume = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.279197, "o", "> "]
[271.279227, "o", "    route_weight = defaultdict(int)\r\n\u001b[?2004l\r"]
[271.279237, "o", "\u001b[?2004h>     \r\n"]
[271.279247, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[271.27928, "o", "    # Track used assignments\r\n\u001b[?2004l\r"]
[271.2793, "o", "\u001b[?2004h> "]
[271.279319, "o", "    assigned = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.279337, "o", "    assignments = []\r\n\u001b[?2004l\r"]
[271.279348, "o", "\u001b[?2004h> "]
[271.279385, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.279431, "o", "    # Sort by number of valid options (MRV - minimum remaining values)\r\n\u001b[?2004l\r"]
[271.279441, "o", "\u001b[?2004h> "]
[271.279529, "o", "    # This processes constrained shipments first\r\n"]
[271.279541, "o", "\u001b[?2004l\r"]
[271.279601, "o", "\u001b[?2004h> "]
[271.279623, "o", "    remaining = list(shipments.keys())\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[271.279644, "o", "\u001b[?2004h> "]
[271.279663, "o", "    while remaining:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.279702, "o", "        # Find shipment with fewest valid options\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.279722, "o", "> "]
[271.279743, "o", "        best_sid = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.279762, "o", "        best_options = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.279782, "o", "> "]
[271.279799, "o", "        best_count = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.279819, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.279836, "o", "> "]
[271.279853, "o", "        for sid in remaining:\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.279873, "o", "> "]
[271.279893, "o", "            valid = shipment_valid[sid]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.279912, "o", "> "]
[271.279934, "o", "            count = len(valid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.279963, "o", "            if count < best_count:\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.279983, "o", "> "]
[271.28, "o", "                best_count = count\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.28002, "o", "> "]
[271.28004, "o", "                best_sid = sid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.280071, "o", "                best_options = valid\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280091, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.280119, "o", "        if best_count == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280138, "o", "> "]
[271.280184, "o", "            print(f\"Warning: Shipment {best_sid} has no valid assignment\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280203, "o", "> "]
[271.280223, "o", "            remaining.remove(best_sid)\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280243, "o", ">             continue\r\n"]
[271.280262, "o", "\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[271.280283, "o", "\u001b[?2004h> "]
[271.280305, "o", "        # Score each option and pick best\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280324, "o", ">         scored = []\r\n"]
[271.280343, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[271.280406, "o", "        for wh_id, dest_id, route, warehouse, arrival_time in best_options:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.28047, "o", "            new_vol = warehouse_volume[wh_id] + shipments[best_sid][\"volume\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280488, "o", "> "]
[271.280538, "o", "            new_weight = warehouse_weight[wh_id] + shipments[best_sid][\"weight\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280558, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280578, "o", "> "]
[271.280609, "o", "            if new_vol > warehouse[\"volume_capacity\"]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280628, "o", "> "]
[271.280648, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.280689, "o", "            if new_weight > warehouse[\"weight_capacity\"]:\r\n\u001b[?2004l\r"]
[271.280709, "o", "\u001b[?2004h> "]
[271.280728, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.28075, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.280816, "o", "            new_route_vol = route_volume[(wh_id, dest_id)] + shipments[best_sid][\"volume\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280835, "o", "> "]
[271.280892, "o", "            new_route_weight = route_weight[(wh_id, dest_id)] + shipments[best_sid][\"weight\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280912, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280932, "o", "> "]
[271.280965, "o", "            if new_route_vol > route[\"capacity_volume\"]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.280984, "o", "> "]
[271.281002, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.281047, "o", "            if new_route_weight > route[\"capacity_weight\"]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281066, "o", "> "]
[271.281087, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.281106, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.281157, "o", "            cost = compute_cost(shipments[best_sid], warehouse, route)\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281176, "o", "> "]
[271.281248, "o", "            utilization = new_vol / warehouse[\"volume_capacity\"] if warehouse[\"volume_capacity\"] > 0 else 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281267, "o", "> "]
[271.281288, "o", "            score = cost + utilization * 5\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281307, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281327, "o", "> "]
[271.281394, "o", "            scored.append((score, cost, wh_id, dest_id, route, warehouse, arrival_time))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.281415, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.281439, "o", "        if not scored:\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281458, "o", "> "]
[271.281518, "o", "            print(f\"Warning: Shipment {best_sid} has no feasible assignment with current loads\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281538, "o", "> "]
[271.281557, "o", "            remaining.remove(best_sid)\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281577, "o", ">             continue\r\n"]
[271.281596, "o", "\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[271.281616, "o", "\u001b[?2004h> "]
[271.28164, "o", "        scored.sort(key=lambda x: x[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281663, "o", "> "]
[271.281707, "o", "        _, cost, wh_id, dest_id, route, warehouse, arrival_time = scored[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281726, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.281753, "o", "        # Update tracking\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281772, "o", "> "]
[271.281811, "o", "        warehouse_volume[wh_id] += shipments[best_sid][\"volume\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281829, "o", "> "]
[271.281868, "o", "        warehouse_weight[wh_id] += shipments[best_sid][\"weight\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281887, "o", "> "]
[271.28193, "o", "        route_volume[(wh_id, dest_id)] += shipments[best_sid][\"volume\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.281952, "o", "> "]
[271.281993, "o", "        route_weight[(wh_id, dest_id)] += shipments[best_sid][\"weight\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.282012, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.282042, "o", "        assignments.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.28206, "o", "> "]
