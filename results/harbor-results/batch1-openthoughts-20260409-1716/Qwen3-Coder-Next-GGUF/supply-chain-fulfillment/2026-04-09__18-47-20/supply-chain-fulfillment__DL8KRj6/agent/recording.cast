[91.618431, "o", "def compute_cost(shipment, warehouse, route):\r\n\u001b[?2004l\r"]
[91.618452, "o", "\u001b[?2004h> "]
[91.6185, "o", "    \"\"\"Compute fulfillment cost for an assignment.\"\"\"\r\n\u001b[?2004l\r"]
[91.618517, "o", "\u001b[?2004h> "]
[91.618584, "o", "    h = warehouse[\"base_handling_cost\"] * (shipment[\"volume\"] / 100)\r\n\u001b[?2004l\r"]
[91.618602, "o", "\u001b[?2004h> "]
[91.618684, "o", "    t = route[\"base_cost_per_km\"] * route[\"distance_km\"] * (shipment[\"weight\"] / 1000)\r\n\u001b[?2004l\r"]
[91.6187, "o", "\u001b[?2004h> "]
[91.618734, "o", "    m = shipment[\"priority_multiplier\"]\r\n\u001b[?2004l\r"]
[91.618753, "o", "\u001b[?2004h> "]
[91.618771, "o", "    return (h + t) * m\r\n\u001b[?2004l\r"]
[91.618789, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.618806, "o", "\u001b[?2004h> "]
[91.618828, "o", "def solve(input_dir, output_file):\r\n\u001b[?2004l\r"]
[91.618845, "o", "\u001b[?2004h> "]
[91.618872, "o", "    \"\"\"Main solving function.\"\"\"\r\n\u001b[?2004l\r"]
[91.618889, "o", "\u001b[?2004h> "]
[91.618988, "o", "    shipments, warehouses, destinations, routes, routes_by_key, compatibility = load_data(input_dir)\r\n\u001b[?2004l\r"]
[91.619006, "o", "\u001b[?2004h> "]
[91.619021, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.619064, "o", "    # Build valid assignments for each shipment\r\n\u001b[?2004l\r"]
[91.619083, "o", "\u001b[?2004h> "]
[91.619098, "o", "    shipment_valid = {}\r\n\u001b[?2004l\r"]
[91.619115, "o", "\u001b[?2004h> "]
[91.619151, "o", "    for sid, shipment in shipments.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.61917, "o", "> "]
[91.61922, "o", "        valid = get_valid_routes_for_shipment(shipment, warehouses, routes_by_key)\r\n\u001b[?2004l\r"]
[91.619236, "o", "\u001b[?2004h> "]
[91.619257, "o", "        shipment_valid[sid] = valid\r\n\u001b[?2004l\r"]
[91.619275, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[91.619292, "o", "\u001b[?2004h> "]
[91.619333, "o", "    # Sort shipments by priority (critical first) for better assignment\r\n\u001b[?2004l\r"]
[91.619351, "o", "\u001b[?2004h> "]
[91.619404, "o", "    priority_order = {\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.619487, "o", "    sorted_shipments = sorted(shipments.values(), key=lambda s: priority_order.get(s[\"priority\"], 2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.619504, "o", ">     \r\n\u001b[?2004l\r"]
[91.61952, "o", "\u001b[?2004h> "]
[91.619538, "o", "    # Track warehouse loads\r\n\u001b[?2004l\r"]
[91.619552, "o", "\u001b[?2004h> "]
[91.619577, "o", "    warehouse_volume = defaultdict(int)\r\n\u001b[?2004l\r"]
[91.619595, "o", "\u001b[?2004h> "]
[91.619616, "o", "    warehouse_weight = defaultdict(int)\r\n\u001b[?2004l\r"]
[91.619634, "o", "\u001b[?2004h>     \r\n"]
[91.619653, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[91.61967, "o", "    # Track which warehouses are used\r\n\u001b[?2004l\r"]
[91.619688, "o", "\u001b[?2004h> "]
[91.619703, "o", "    used_warehouses = set()\r\n\u001b[?2004l\r"]
[91.619721, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.619736, "o", "> "]
[91.619754, "o", "    # Track route usage\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.619769, "o", "> "]
[91.619787, "o", "    route_volume = defaultdict(int)\r\n\u001b[?2004l\r"]
[91.619803, "o", "\u001b[?2004h> "]
[91.619821, "o", "    route_weight = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.619837, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.61988, "o", "    # Track shipments per destination region for quota\r\n\u001b[?2004l\r"]
[91.619898, "o", "\u001b[?2004h> "]
[91.61992, "o", "    region_shipments = defaultdict(list)\r\n\u001b[?2004l\r"]
[91.619939, "o", "\u001b[?2004h>     \r\n"]
[91.619958, "o", "\u001b[?2004l\r\u001b[?2004h>     assignments = []\r\n\u001b[?2004l\r"]
[91.619976, "o", "\u001b[?2004h> "]
[91.619992, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.620012, "o", "    for shipment in sorted_shipments:\r\n\u001b[?2004l\r"]
[91.620028, "o", "\u001b[?2004h> "]
[91.620049, "o", "        sid = shipment[\"shipment_id\"]\r\n\u001b[?2004l\r"]
[91.620067, "o", "\u001b[?2004h> "]
[91.620087, "o", "        valid = shipment_valid[sid]\r\n\u001b[?2004l\r"]
[91.620106, "o", "\u001b[?2004h> "]
[91.620122, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.62014, "o", "        if not valid:\r\n\u001b[?2004l\r"]
[91.620156, "o", "\u001b[?2004h> "]
[91.620192, "o", "            print(f\"Warning: No valid assignment for shipment {sid}\")\r\n\u001b[?2004l\r"]
[91.62021, "o", "\u001b[?2004h> "]
[91.620226, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.620247, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.620262, "o", ">         # Score each option\r\n"]
[91.620278, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[91.620292, "o", "        scored = []\r\n\u001b[?2004l\r"]
[91.620307, "o", "\u001b[?2004h> "]
[91.620352, "o", "        for wh_id, dest_id, route, warehouse, arrival_time in valid:\r\n\u001b[?2004l\r"]
[91.620373, "o", "\u001b[?2004h> "]
[91.620406, "o", "            # Check warehouse capacity constraints\r\n\u001b[?2004l\r"]
[91.620417, "o", "\u001b[?2004h> "]
[91.620467, "o", "            new_vol = warehouse_volume[wh_id] + shipment[\"volume\"]\r\n\u001b[?2004l\r"]
[91.620484, "o", "\u001b[?2004h> "]
[91.620527, "o", "            new_weight = warehouse_weight[wh_id] + shipment[\"weight\"]\r\n\u001b[?2004l\r"]
[91.620544, "o", "\u001b[?2004h> "]
[91.62056, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.620599, "o", "            if new_vol > warehouse[\"volume_capacity\"]:\r\n\u001b[?2004l\r"]
[91.620618, "o", "\u001b[?2004h> "]
[91.620637, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.620681, "o", "            if new_weight > warehouse[\"weight_capacity\"]:\r\n\u001b[?2004l\r"]
[91.620698, "o", "\u001b[?2004h> "]
[91.620714, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.620729, "o", "            \r\n\u001b[?2004l\r"]
[91.620747, "o", "\u001b[?2004h> "]
[91.620765, "o", "            # Check route capacity\r\n\u001b[?2004l\r"]
[91.620783, "o", "\u001b[?2004h> "]
[91.620835, "o", "            new_route_vol = route_volume[(wh_id, dest_id)] + shipment[\"volume\"]\r\n\u001b[?2004l\r"]
[91.620853, "o", "\u001b[?2004h> "]
[91.620906, "o", "            new_route_weight = route_weight[(wh_id, dest_id)] + shipment[\"weight\"]\r\n\u001b[?2004l\r"]
[91.620925, "o", "\u001b[?2004h> "]
[91.620942, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.620979, "o", "            if new_route_vol > route[\"capacity_volume\"]:\r\n\u001b[?2004l\r"]
[91.620996, "o", "\u001b[?2004h> "]
[91.621015, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.621063, "o", "            if new_route_weight > route[\"capacity_weight\"]:\r\n\u001b[?2004l\r"]
[91.62108, "o", "\u001b[?2004h> "]
[91.621096, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.62111, "o", "            \r\n\u001b[?2004l\r"]
[91.621128, "o", "\u001b[?2004h> "]
[91.621159, "o", "            # Check hazmat/refrigerated consistency\r\n\u001b[?2004l\r"]
[91.621177, "o", "\u001b[?2004h> "]
[91.621233, "o", "            # If warehouse already has hazmat, can't add refrigerated and vice versa\r\n\u001b[?2004l\r"]
[91.621249, "o", "\u001b[?2004h> "]
[91.621299, "o", "            # But we don't track this yet, so skip for now and check later\r\n\u001b[?2004l\r"]
[91.621317, "o", "\u001b[?2004h> "]
[91.621333, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.621399, "o", "            cost = compute_cost(shipment, warehouse, route)\r\n\u001b[?2004l\r"]
[91.621421, "o", "\u001b[?2004h> "]
[91.621443, "o", "            \r\n\u001b[?2004l\r"]
[91.621466, "o", "\u001b[?2004h> "]
[91.621518, "o", "            # Score: lower cost is better, also consider balance\r\n\u001b[?2004l\r"]
[91.621536, "o", "\u001b[?2004h> "]
[91.62158, "o", "            # Use warehouse utilization as a factor\r\n\u001b[?2004l\r"]
[91.6216, "o", "\u001b[?2004h> "]
[91.621682, "o", "            utilization = new_vol / warehouse[\"volume_capacity\"] if warehouse[\"volume_capacity\"] > 0 else 1\r\n\u001b[?2004l\r"]
[91.621701, "o", "\u001b[?2004h> "]
[91.62172, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.621775, "o", "            # Prefer less utilized warehouses for balance\r\n\u001b[?2004l\r"]
[91.621794, "o", "\u001b[?2004h> "]
[91.621852, "o", "            score = cost + utilization * 10  # Penalize high utilization\r\n\u001b[?2004l\r"]
[91.621871, "o", "\u001b[?2004h> "]
[91.621888, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.621966, "o", "            scored.append((score, cost, wh_id, dest_id, route, warehouse, arrival_time))\r\n\u001b[?2004l\r"]
[91.621985, "o", "\u001b[?2004h> "]
[91.622006, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.622029, "o", "        if not scored:\r\n\u001b[?2004l\r"]
[91.622047, "o", "\u001b[?2004h> "]
[91.622112, "o", "            print(f\"Warning: No feasible assignment for shipment {sid}\")\r\n\u001b[?2004l\r"]
[91.62213, "o", "\u001b[?2004h> "]
[91.622154, "o", "            continue\r\n\u001b[?2004l\r"]
[91.622174, "o", "\u001b[?2004h> "]
[91.622194, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.622232, "o", "        # Pick best option (lowest score)\r\n\u001b[?2004l\r"]
[91.62225, "o", "\u001b[?2004h> "]
[91.622284, "o", "        scored.sort(key=lambda x: x[0])\r\n\u001b[?2004l\r"]
[91.622302, "o", "\u001b[?2004h> "]
[91.622326, "o", "        best = scored[0]\r\n\u001b[?2004l\r"]
[91.622343, "o", "\u001b[?2004h> "]
[91.622368, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.622384, "o", "> "]
[91.622481, "o", "        _, cost, wh_id, dest_id, route, warehouse, arrival_time = best\r\n\u001b[?2004l\r"]
[91.62252, "o", "\u001b[?2004h> "]
[91.62254, "o", "        \r\n\u001b[?2004l\r"]
[91.622557, "o", "\u001b[?2004h> "]
[91.622577, "o", "        # Update tracking\r\n\u001b[?2004l\r"]
[91.622594, "o", "\u001b[?2004h> "]
[91.622639, "o", "        warehouse_volume[wh_id] += shipment[\"volume\"]\r\n\u001b[?2004l\r"]
[91.622657, "o", "\u001b[?2004h> "]
[91.6227, "o", "        warehouse_weight[wh_id] += shipment[\"weight\"]\r\n\u001b[?2004l\r"]
[91.622717, "o", "\u001b[?2004h> "]
[91.622767, "o", "        route_volume[(wh_id, dest_id)] += shipment[\"volume\"]\r\n\u001b[?2004l\r"]
[91.622783, "o", "\u001b[?2004h> "]
[91.622834, "o", "        route_weight[(wh_id, dest_id)] += shipment[\"weight\"]\r\n\u001b[?2004l\r"]
[91.62285, "o", "\u001b[?2004h> "]
[91.622877, "o", "        used_warehouses.add(wh_id)\r\n\u001b[?2004l\r"]
[91.622897, "o", "\u001b[?2004h> "]
[91.622952, "o", "        region_shipments[destinations[dest_id][\"region\"]].append(sid)\r\n\u001b[?2004l\r"]
[91.622969, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[91.622987, "o", "\u001b[?2004h> "]
[91.623013, "o", "        assignments.append({\r\n\u001b[?2004l\r"]
[91.623031, "o", "\u001b[?2004h> "]
[91.623055, "o", "            \"shipment_id\": sid,\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.623073, "o", "> "]
[91.6231, "o", "            \"warehouse_id\": wh_id,\r\n\u001b[?2004l\r"]
[91.623116, "o", "\u001b[?2004h> "]
[91.623145, "o", "            \"destination_id\": dest_id\r\n\u001b[?2004l\r"]
[91.623162, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[91.623179, "o", "\u001b[?2004h>     \r\n"]
[91.623196, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[91.623222, "o", "    # Sort by shipment_id\r\n\u001b[?2004l\r"]
[91.623239, "o", "\u001b[?2004h> "]
[91.623285, "o", "    assignments.sort(key=lambda x: x[\"shipment_id\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.623301, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.623318, "o", "> "]
[91.623336, "o", "    # Write output\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.62342, "o", "    output_file.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[91.623444, "o", "\u001b[?2004h> "]
[91.623485, "o", "    with open(output_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[91.623495, "o", "\u001b[?2004h> "]
[91.623532, "o", "        for a in assignments:\r\n\u001b[?2004l\r"]
[91.623542, "o", "\u001b[?2004h> "]
[91.623586, "o", "            f.write(json.dumps(a) + \"\\n\")\r\n\u001b[?2004l\r"]
[91.623596, "o", "\u001b[?2004h> "]
[91.623606, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.623618, "o", "> "]
[91.623687, "o", "    print(f\"Wrote {len(assignments)} assignments\")\r\n\u001b[?2004l\r"]
[91.623708, "o", "\u001b[?2004h> "]
[91.623725, "o", "    return assignments\r\n\u001b[?2004l\r"]
[91.623734, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.623758, "o", "\u001b[?2004h> "]
[91.623775, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.623815, "o", "    input_dir = Path(\"/app/task_file/input_data\")\r\n\u001b[?2004l\r"]
[91.623824, "o", "\u001b[?2004h> "]
[91.623883, "o", "    output_file = Path(\"/app/task_file/output_data/assignments.jsonl\")\r\n\u001b[?2004l\r"]
[91.623891, "o", "\u001b[?2004h> "]
[91.623919, "o", "    solve(input_dir, output_file)\r\n\u001b[?2004l\r"]
[91.623927, "o", "\u001b[?2004h> "]
[91.623935, "o", "ENDOFSCRIPT\r\n\u001b[?2004l\r"]
[91.624995, "o", "\u001b[?2004hroot@b12cd1002d87:/app# "]
[99.505066, "i", "python3 /app/solve.py\n"]
[99.505312, "o", "python3 /app/solve.py\r\n\u001b[?2004l\r"]
[99.53103, "o", "Traceback (most recent call last):\r\n  File \"/app/solve.py\", line 225, in <module>\r\n"]
[99.531119, "o", "    solve(input_dir, output_file)\r\n  File \"/app/solve.py\", line 119, in solve\r\n"]
[99.531163, "o", "    valid = get_valid_routes_for_shipment(shipment, warehouses, routes_by_key)\r\n"]
[99.531184, "o", "            ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/app/solve.py\", line 92, in get_valid_routes_for_shipment\r\n"]
[99.531204, "o", "    if arrival_time < dest[\"delivery_window_start\"] or arrival_time > dest[\"delivery_window_end\"]:\r\n"]
[99.531221, "o", "                      ~~~~^^^^^^^^^^^^^^^^^^^^^^^^^\r\nKeyError: 'delivery_window_start'\r\n"]
[99.534826, "o", "\u001b[?2004h"]
[99.534837, "o", "root@b12cd1002d87:/app# "]
[151.307315, "i", "cat > /app/solve.py << 'ENDOFSCRIPT'\n#!/usr/bin/env python3\n\"\"\"\nSupply Chain Fulfillment Optimization Solution\n\"\"\"\n\nimport json\nfrom collections import defaultdict\nfrom pathlib import Path\n\ndef load_data(input_dir):\n    \"\"\"Load all input data files.\"\"\"\n    shipments = {}\n    with open(input_dir / \"shipments.jsonl\") as f:\n        for line in f:\n            s = json.loads(line)\n            shipments[s[\"shipment_id\"]] = s\n    \n    warehouses = {}\n    with open(input_dir / \"warehouses.jsonl\") as f:\n        for line in f:\n            w = json.loads(line)\n            warehouses[w[\"warehouse_id\"]] = w\n    \n    destinations = {}\n    with open(input_dir / \"destinations.jsonl\") as f:\n        for line in f:\n            d = json.loads(line)\n            destinations[d[\"destination_id\"]] = d\n    \n    routes = {}\n    routes_by_key = {}\n    with open(input_dir / \"routes.jsonl\") as f:\n        for line in f:\n            r = json.loads(line)\n            routes[r[\"route_id\"]] = r\n            key = (r[\"warehouse_id\"], r[\"destination_id\"])\n            routes_by_key[key] = r\n    \n    compatibility = []\n    with open(input_dir / \"compatibility.jsonl\") as f:\n        for line in f:\n            compatibility.append(json.loads(line))\n    \n    return shipments, warehouses, destinations, routes, routes_by_key, compatibility\n\ndef get_valid_routes_for_shipment(shipment, warehouses, routes_by_key, destinations):\n    \"\"\"Find all valid (warehouse, destination) pairs for a shipment.\"\"\"\n    valid = []\n    \n    for (wh_id, dest_id), route in routes_by_key.items():\n        # Must be going to correct destination\n        if dest_id != shipment[\"destination_id\"]:\n            continue\n        \n        warehouse = warehouses[wh_id]\n        dest_info = destinations[dest_id]\n        \n        # Check warehouse capabilities\n        if shipment[\"requires_hazmat\"] and not warehouse[\"handles_hazmat\"]:\n            continue\n        if shipment[\"requires_refrigerated\"] and not warehouse[\"handles_refrigerated\"]:\n            continue\n        if shipment[\"requires_oversized\"] and not warehouse[\"handles_oversized\"]:\n            continue\n        \n        # Check route capabilities\n        if shipment[\"requires_hazmat\"] and not route[\"allows_hazmat\"]:\n            continue\n        if shipment[\"requires_refrigerated\"] and not route[\"allows_refrigerated\"]:\n            continue\n        if shipment[\"requires_oversized\"] and not route[\"allows_oversized\"]:\n            continue\n        \n        # Check route capacity\n        if shipment[\"volume\"] > route[\"capacity_volume\"]:\n            continue\n        if shipment[\"weight\"] > route[\"capacity_weight\"]:\n            continue\n        \n        # Check warehouse capacity\n        if shipment[\"volume\"] > warehouse[\"volume_capacity\"]:\n            continue\n        if shipment[\"weight\"] > warehouse[\"weight_capacity\"]:\n            continue\n        \n        # Check arrival time <= deadline\n        arrival_time = warehouse[\"availability_start\"] + route[\"transit_time_hours\"]\n        if arrival_time > shipment[\"deadline_hours\"]:\n            continue\n        \n        # Check destination time window\n        if arrival_time < dest_info[\"delivery_window_start\"] or arrival_time > dest_info[\"delivery_window_end\"]:\n            continue\n        \n        # Check warehouse availability\n        if warehouse[\"availability_start\"] >= warehouse[\"availability_end\"]:\n            continue\n        if shipment[\"deadline_hours\"] < warehouse[\"availability_start\"]:\n            continue\n        \n        valid.append((wh_id, dest_id, route, warehouse, arrival_time))\n    \n    return valid\n\ndef compute_cost(shipment, warehouse, route):\n    \"\"\"Compute fulfillment cost for an assignment.\"\"\"\n    h = warehouse[\"base_handling_cost\"] * (shipment[\"volume\"] / 100)\n    t = route[\"base_cost_per_km\"] * route[\"distance_km\"] * (shipment[\"weight\"] / 1000)\n    m = shipment[\"priority_multiplier\"]\n    return (h + t) * m\n\ndef solve(input_dir, output_file):\n    \"\"\"Main solving function.\"\"\"\n    shipments, warehouses, destinations, routes, routes_by_key, compatibility = load_data(input_dir)\n    \n  "]
[151.307453, "i", "  # Build valid assignments for each shipment\n    shipment_valid = {}\n    for sid, shipment in shipments.items():\n        valid = get_valid_routes_for_shipment(shipment, warehouses, routes_by_key, destinations)\n        shipment_valid[sid] = valid\n    \n    # Sort shipments by priority (critical first) for better assignment\n    priority_order = {\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}\n    sorted_shipments = sorted(shipments.values(), key=lambda s: priority_order.get(s[\"priority\"], 2))\n    \n    # Track warehouse loads\n    warehouse_volume = defaultdict(int)\n    warehouse_weight = defaultdict(int)\n    \n    # Track route usage\n    route_volume = defaultdict(int)\n    route_weight = defaultdict(int)\n    \n    assignments = []\n    \n    for shipment in sorted_shipments:\n        sid = shipment[\"shipment_id\"]\n        valid = shipment_valid[sid]\n        \n        if not valid:\n            print(f\"Warning: No valid assignment for shipment {sid}\")\n            continue\n        \n        # Score each option\n        scored = []\n        for wh_id, dest_id, route, warehouse, arrival_time in valid:\n            # Check warehouse capacity constraints\n            new_vol = warehouse_volume[wh_id] + shipment[\"volume\"]\n            new_weight = warehouse_weight[wh_id] + shipment[\"weight\"]\n            \n            if new_vol > warehouse[\"volume_capacity\"]:\n                continue\n            if new_weight > warehouse[\"weight_capacity\"]:\n                continue\n            \n            # Check route capacity\n            new_route_vol = route_volume[(wh_id, dest_id)] + shipment[\"volume\"]\n            new_route_weight = route_weight[(wh_id, dest_id)] + shipment[\"weight\"]\n            \n            if new_route_vol > route[\"capacity_volume\"]:\n                continue\n            if new_route_weight > route[\"capacity_weight\"]:\n                continue\n            \n            cost = compute_cost(shipment, warehouse, route)\n            \n            # Score: lower cost is better, also consider balance\n            utilization = new_vol / warehouse[\"volume_capacity\"] if warehouse[\"volume_capacity\"] > 0 else 1\n            \n            # Prefer less utilized warehouses for balance\n            score = cost + utilization * 10\n            \n            scored.append((score, cost, wh_id, dest_id, route, warehouse, arrival_time))\n        \n        if not scored:\n            print(f\"Warning: No feasible assignment for shipment {sid}\")\n            continue\n        \n        # Pick best option (lowest score)\n        scored.sort(key=lambda x: x[0])\n        best = scored[0]\n        \n        _, cost, wh_id, dest_id, route, warehouse, arrival_time = best\n        \n        # Update tracking\n        warehouse_volume[wh_id] += shipment[\"volume\"]\n        warehouse_weight[wh_id] += shipment[\"weight\"]\n        route_volume[(wh_id, dest_id)] += shipment[\"volume\"]\n        route_weight[(wh_id, dest_id)] += shipment[\"weight\"]\n        \n        assignments.append({\n            \"shipment_id\": sid,\n            \"warehouse_id\": wh_id,\n            \"destination_id\": dest_id\n        })\n    \n    # Sort by shipment_id\n    assignments.sort(key=lambda x: x[\"shipment_id\"])\n    \n    # Write output\n    output_file.parent.mkdir(parents=True, exist_ok=True)\n    with open(output_file, \"w\") as f:\n        for a in assignments:\n            f.write(json.dumps(a) + \"\\n\")\n    \n    print(f\"Wrote {len(assignments)} assignments\")\n    return assignments\n\nif __name__ == \"__main__\":\n    input_dir = Path(\"/app/task_file/input_data\")\n    output_file = Path(\"/app/task_file/output_data/assignments.jsonl\")\n    solve(input_dir, output_file)\nENDOFSCRIPT\n"]
[151.307584, "o", "cat > /app/solve.py << 'ENDOFSCRIPT'\r\n"]
