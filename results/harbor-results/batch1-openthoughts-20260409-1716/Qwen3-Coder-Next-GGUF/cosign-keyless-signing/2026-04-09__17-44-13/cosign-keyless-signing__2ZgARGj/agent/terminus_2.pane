[?2004hroot@2928fe68ba2e:/app# cat > /app/setup_ca.sh << 'EOF'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # CA Hierarchy Setup Script
[?2004l[?2004h> # Creates Root CA and Intermediate CA for the signing pipeline
[?2004l[?2004h> 
[?2004l[?2004h> set -e
[?2004l[?2004h> 
[?2004l[?2004h> # Create directory structure
[?2004l[?2004h> mkdir -p /app/ca /app/signing /app/signed
[?2004l[?2004h> 
[?2004l[?2004h> # Root CA configuration
[?2004l[?2004h> ROOT_CA_CONFIG=$(cat << 'CNF'
[?2004l[?2004h> [req]
[?2004l[?2004h> distinguished_name = req_distinguished_name
[?2004l[?2004h> x509_extensions = v3_ca
[?2004l[?2004h> prompt = no
[?2004l[?2004h> 
[?2004l[?2004h> [req_distinguished_name]
[?2004l[?2004h> CN = Software Signing Root CA
[?2004l[?2004h> O = SecureBuild
[?2004l[?2004h> C = US
[?2004l[?2004h> 
[?2004l[?2004h> [v3_ca]
[?2004l[?2004h> subjectKeyIdentifier = hash
[?2004l[?2004h> authorityKeyIdentifier = keyid:always,issuer
[?2004l[?2004h> basicConstraints = critical, CA:TRUE
[?2004l[?2004h> keyUsage = critical, keyCertSign, cRLSign
[?2004l[?2004h> CNF
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Intermediate CA configuration
[?2004l[?2004h> INT_CA_CONFIG=$(cat << 'CNF'
[?2004l[?2004h> [req]
[?2004l[?2004h> distinguished_name = req_distinguished_name
[?2004l[?2004h> prompt = no
[?2004l[?2004h> 
[?2004l[?2004h> [req_distinguished_name]
[?2004l[?2004h> CN = Build Pipeline Intermediate CA
[?2004l[?2004h> O = SecureBuild
[?2004l[?2004h> C = US
[?2004l[?2004h> 
[?2004l[?2004h> [v3_intermediate_ca]
[?2004l[?2004h> subjectKeyIdentifier = hash
[?2004l[?2004h> authorityKeyIdentifier = keyid:always,issuer
[?2004l[?2004h> basicConstraints = critical, CA:TRUE, pathlen:0
[?2004l[?2004h> keyUsage = critical, keyCertSign, digitalSignature
[?2004l[?2004h> CNF
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Generate Root CA private key (4096-bit RSA)
[?2004l[?2004h> echo "Generating Root CA private key..."
[?2004l[?2004h> openssl genrsa -out /app/ca/root-ca-key.pem 4096
[?2004l[?2004h> 
[?2004l[?2004h> # Generate Root CA self-signed certificate
[?2004l[?2004h> openssl req -new -x509 -days 3650 -key /app/ca/root-ca-key.pem \
[?2004l[?2004h>     -out /app/ca/root-ca.pem \
[?2004l[?2004h>     -subj "/CN=Software Signing Root CA/O=SecureBuild/C=US" \
[?2004l[?2004h>     -addext "basicConstraints=critical,CA:TRUE" \
[?2004l[?2004h>     -addext "keyUsage=critical,keyCertSign,cRLSign"
[?2004l[?2004h> 
[?2004l[?2004h> echo "Root CA certificate created: /app/ca/root-ca.pem"
[?2004l[?2004h> 
[?2004l[?2004h> # Generate Intermediate CA private key
[?2004l[?2004h> echo "Generating Intermediate CA private key..."
[?2004l[?2004h> openssl genrsa -out /app/ca/intermediate-ca-key.pem 4096
[?2004l[?2004h> 
[?2004l[?2004h> # Generate Intermediate CA CSR
[?2004l[?2004h> openssl req -new -key /app/ca/intermediate-ca-key.pem \
[?2004l[?2004h>     -out /app/ca/intermediate-ca.csr \
[?2004l[?2004h>     -subj "/CN=Build Pipeline Intermediate CA/O=SecureBuild/C=US"
[?2004l[?2004h> 
[?2004l[?2004h> # Sign Intermediate CA with Root CA
[?2004l[?2004h> openssl x509 -req -days 1825 -in /app/ca/intermediate-ca.csr \
[?2004l[?2004h>     -CA /app/ca/root-ca.pem \
[?2004l[?2004h>     -CAkey /app/ca/root-ca-key.pem \
[?2004l[?2004h>     -CAcreateserial \
[?2004l[?2004h>     -out /app/ca/intermediate-ca.pem \
[?2004l[?2004h>     -extfile <(echo -e "basicConstraints=critical,CA:TRUE,pathlen:0\nkeyUsage=critical,keyCertSign,digitalSignature\nsubjectKeyIdentifier=hash\nauthorityKeyIdentifier=keyid:always,issuer")
[?2004l[?2004h> 
[?2004l[?2004h> echo "Intermediate CA certificate created: /app/ca/intermediate-ca.pem"
[?2004l[?2004h> 
[?2004l[?2004h> # Clean up CSR file
[?2004l[?2004h> rm -f /app/ca/intermediate-ca.csr
[?2004l[?2004h> 
[?2004l[?2004h> echo "CA hierarchy setup complete!"
[?2004l[?2004h> echo "Root CA: /app/ca/root-ca.pem"
[?2004l[?2004h> echo "Intermediate CA: /app/ca/intermediate-ca.pem"
[?2004l[?2004h> EOF
[?2004l[?2004hroot@2928fe68ba2e:/app# chmod +x /app/setup_ca.sh
[?2004l[?2004hroot@2928fe68ba2e:/app# cat > /app/sign_artifact.sh << 'EOF'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Artifact Signing Script
[?2004l[?2004h> # Signs artifacts with ephemeral keys that are destroyed after use
[?2004l[?2004h> 
[?2004l[?2004h> set -e
[?2004l[?2004h> 
[?2004l[?2004h> # Check arguments
[?2004l[?2004h> if [ $# -ne 2 ]; then
[?2004l[?2004h>     echo "Usage: $0 <artifact-path> <build-id>"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> ARTIFACT_PATH="$1"
[?2004l[?2004h> BUILD_ID="$2"
[?2004l[?2004h> 
[?2004l[?2004h> # Validate artifact exists
[?2004l[?2004h> if [ ! -f "$ARTIFACT_PATH" ]; then
[?2004l[?2004h>     echo "Error: Artifact not found: $ARTIFACT_PATH"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Create output directories if they don't exist
[?2004l[?2004h> mkdir -p /app/signing /app/signed
[?2004l[?2004h> 
[?2004l[?2004h> # Get artifact name and calculate SHA256
[?2004l[?2004h> ARTIFACT_NAME=$(basename "$ARTIFACT_PATH")
[?2004l[?2004h> SHA256=$(sha256sum "$ARTIFACT_PATH" | awk '{print $1}')
[?2004l[?2004h> 
[?2004l[?2004h> # Generate ephemeral ECDSA P-256 keypair
[?2004l[?2004h> echo "Generating ephemeral ECDSA keypair..."
[?2004l[?2004h> EPHEMERAL_KEY="/app/signing/ephemeral-key-${BUILD_ID}.pem"
[?2004l[?2004h> openssl ecparam -genkey -name prime256v1 -noout -out "$EPHEMERAL_KEY"
[?2004l[?2004h> 
[?2004l[?2004h> # Create signing certificate signed by Intermediate CA
[?2004l[?2004h> CERT_SUBJECT="CN=build-${BUILD_ID},O=SecureBuild,C=US"
[?2004l[?2004h> 
[?2004l[?2004h> echo "Creating signing certificate..."
[?2004l[?2004h> 
[?2004l[?2004h> # Generate CSR for ephemeral key
[?2004l[?2004h> openssl req -new -key "$EPHEMERAL_KEY" \
[?2004l[?2004h>     -out /app/signing/cert-${BUILD_ID}.csr \
[?2004l[?2004h>     -subj "/CN=build-${BUILD_ID}/O=SecureBuild/C=US"
[?2004l[?2004h> 
[?2004l[?2004h> # Create extensions file for ephemeral certificate
[?2004l[?2004h> cat > /app/signing/ephemeral-ext.cnf << EXTN
[?2004l[?2004h> basicConstraints=CA:FALSE
[?2004l[?2004h> keyUsage=critical,digitalSignature
[?2004l[?2004h> extendedKeyUsage=codeSigning
[?2004l[?2004h> subjectKeyIdentifier=hash
[?2004l[?2004h> authorityKeyIdentifier=keyid:always,issuer
[?2004l[?2004h> EXTN
[?2004l[?2004h> 
[?2004l[?2004h> # Sign the certificate with Intermediate CA (1 day validity)
[?2004l[?2004h> openssl x509 -req \
[?2004l[?2004h>     -days 1 \
[?2004l[?2004h>     -in /app/signing/cert-${BUILD_ID}.csr \
[?2004l[?2004h>     -CA /app/ca/intermediate-ca.pem \
[?2004l[?2004h>     -CAkey /app/ca/intermediate-ca-key.pem \
[?2004l[?2004h>     -CAcreateserial \
[?2004l[?2004h>     -out /app/signing/cert_${BUILD_ID}.pem \
[?2004l[?2004h>     -extfile /app/signing/ephemeral-ext.cnf \
[?2004l[?2004h>     -sha256
[?2004l[?2004h> 
[?2004l[?2004h> # Sign the artifact with ephemeral key
[?2004l[?2004h> echo "Signing artifact..."
[?2004l[?2004h> openssl dgst -sha256 -sign "$EPHEMERAL_KEY" \
[?2004l[?2004h>     -out "/app/signed/${ARTIFACT_NAME}.sig" \
[?2004l[?2004h>     "$ARTIFACT_PATH"
[?2004l[?2004h> 
[?2004l[?2004h> # Create provenance attestation JSON
[?2004l[?2004h> TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
[?2004l[?2004h> cat > "/app/signed/${ARTIFACT_NAME}.provenance.json" << PROV
[?2004l[?2004h> {
[?2004l[?2004h>   "buildID": "${BUILD_ID}",
[?2004l[?2004h>   "artifact": "${ARTIFACT_NAME}",
[?2004l[?2004h>   "sha256": "${SHA256}",
[?2004l[?2004h>   "signedAt": "${TIMESTAMP}",
[?2004l[?2004h>   "signer": "build-${BUILD_ID}",
[?2004l[?2004h>   "certificateChain": ["intermediate-ca", "root-ca"]
[?2004l[?2004h> }
[?2004l[?2004h> PROV
[?2004l[?2004h> 
[?2004l[?2004h> # Sign the provenance JSON
[?2004l[?2004h> echo "Signing provenance attestation..."
[?2004l[?2004h> openssl dgst -sha256 -sign "$EPHEMERAL_KEY" \
[?2004l[?2004h>     -out "/app/signed/${ARTIFACT_NAME}.provenance.sig" \
[?2004l[?2004h>     "/app/signed/${ARTIFACT_NAME}.provenance.json"
[?2004l[?2004h> 
[?2004l[?2004h> # Create certificate chain bundle
[?2004l[?2004h> echo "Creating certificate chain..."
[?2004l[?2004h> cat /app/signing/cert_${BUILD_ID}.pem \
[?2004l[?2004h>     /app/ca/intermediate-ca.pem \
[?2004l[?2004h>     /app/ca/root-ca.pem \
[?2004l[?2004h>     > "/app/signed/${ARTIFACT_NAME}.chain.pem"
[?2004l[?2004h> 
[?2004l[?2004h> # Destroy ephemeral private key
[?2004l[?2004h> echo "Destroying ephemeral key..."
[?2004l[?2004h> rm -f "$EPHEMERAL_KEY"
[?2004l[?2004h> rm -f /app/signing/cert-${BUILD_ID}.csr
[?2004l[?2004h> rm -f /app/signing/ephemeral-ext.cnf
[?2004l[?2004h> 
[?2004l[?2004h> # Clean up signing directory
[?2004l[?2004h> echo "Cleaning up signing artifacts..."
[?2004l[?2004h> rm -f /app/signing/cert_${BUILD_ID}.pem
[?2004l[?2004h> 
[?2004l[?2004h> # Remove any remaining ephemeral key files
[?2004l[?2004h> find /app/signing -name "ephemeral-key-*.pem" -type f -delete 2>/dev/null || true
[?2004l[?2004h> 
[?2004l[?2004h> echo "Signing complete!"
[?2004l[?2004h> echo "Artifact: $ARTIFACT_PATH"
[?2004l[?2004h> echo "Build ID: $BUILD_ID"
[?2004l[?2004h> echo "SHA256: $SHA256"
[?2004l[?2004h> echo ""
[?2004l[?2004h> echo "Output files:"
[?2004l[?2004h> echo "  - Signature: /app/signed/${ARTIFACT_NAME}.sig"
[?2004l[?2004h> echo "  - Provenance: /app/signed/${ARTIFACT_NAME}.provenance.json"
[?2004l[?2004h> echo "  - Provenance Signature: /app/signed/${ARTIFACT_NAME}.provenance.sig"
[?2004l[?2004h> echo "  - Chain: /app/signed/${ARTIFACT_NAME}.chain.pem"
[?2004l[?2004h> EOF
[?2004l[?2004hroot@2928fe68ba2e:/app# chmod +x /app/sign_artifact.sh
[?2004l[?2004hroot@2928fe68ba2e:/app# cat > /app/verify_artifact.sh << 'EOF'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Artifact Verification Script
[?2004l[?2004h> # Verifies signed artifacts using certificate chain and signatures
[?2004l[?2004h> 
[?2004l[?2004h> set -e
[?2004l[?2004h> 
[?2004l[?2004h> # Check arguments
[?2004l[?2004h> if [ $# -ne 1 ]; then
[?2004l[?2004h>     echo "Usage: $0 <artifact-path>"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> ARTIFACT_PATH="$1"
[?2004l[?2004h> 
[?2004l[?2004h> # Extract artifact name
[?2004l[?2004h> ARTIFACT_NAME=$(basename "$ARTIFACT_PATH")
[?2004l[?2004h> 
[?2004l[?2004h> # Define file paths
[?2004l[?2004h> SIG_FILE="/app/signed/${ARTIFACT_NAME}.sig"
[?2004l[?2004h> PROVENANCE_JSON="/app/signed/${ARTIFACT_NAME}.provenance.json"
[?2004l[?2004h> PROVENANCE_SIG="/app/signed/${ARTIFACT_NAME}.provenance.sig"
[?2004l[?2004h> CHAIN_FILE="/app/signed/${ARTIFACT_NAME}.chain.pem"
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: File existence checks
[?2004l[?2004h> echo "Checking required files..."
[?2004l[?2004h> 
[?2004l[?2004h> if [ ! -f "$ARTIFACT_PATH" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if [ ! -f "$SIG_FILE" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if [ ! -f "$PROVENANCE_JSON" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if [ ! -f "$PROVENANCE_SIG" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if [ ! -f "$CHAIN_FILE" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> echo "All required files present."
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Extract signing certificate from chain and validate
[?2004l[?2004h> echo "Validating certificate chain..."
[?2004l[?2004h> 
[?2004l[?2004h> # Extract the first certificate (signing certificate) from the chain
[?2004l[?2004h> openssl x509 -in "$CHAIN_FILE" -noout > /tmp/signing_cert.pem 2>/dev/null
[?2004l[?2004h> 
[?2004l[?2004h> # Verify the chain using OpenSSL's verify command
[?2004l[?2004h> # We need to verify that:
[?2004l[?2004h> # 1. The signing cert was signed by intermediate CA
[?2004l[?2004h> # 2. The intermediate CA was signed by root CA
[?2004l[?2004h> 
[?2004l[?2004h> # Create a CA bundle for verification
[?2004l[?2004h> CA_BUNDLE="/tmp/ca-bundle.pem"
[?2004l[?2004h> cat /app/ca/intermediate-ca.pem /app/ca/root-ca.pem > "$CA_BUNDLE"
[?2004l[?2004h> 
[?2004l[?2004h> # Verify the chain
[?2004l[?2004h> if ! openssl verify -CAfile "$CA_BUNDLE" /tmp/signing_cert.pem > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Check certificate validity (not expired)
[?2004l[?2004h> if ! openssl x509 -in /tmp/signing_cert.pem -noout -checkend 0 2>/dev/null; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Verify intermediate CA is signed by root CA
[?2004l[?2004h> if ! openssl verify -CAfile /app/ca/root-ca.pem /app/ca/intermediate-ca.pem > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> echo "Certificate chain valid."
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Extract public key from signing certificate
[?2004l[?2004h> echo "Extracting public key from signing certificate..."
[?2004l[?2004h> openssl x509 -in /tmp/signing_cert.pem -pubkey -noout > /tmp/pubkey.pem
[?2004l[?2004h> 
[?2004l[?2004h> # Step 4: Verify artifact signature
[?2004l[?2004h> echo "Verifying artifact signature..."
[?2004l[?2004h> if ! openssl dgst -sha256 -verify /tmp/pubkey.pem -signature "$SIG_FILE" "$ARTIFACT_PATH" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> echo "Artifact signature verified."
[?2004l[?2004h> 
[?2004l[?2004h> # Step 5: Verify provenance signature
[?2004l[?2004h> echo "Verifying provenance signature..."
[?2004l[?2004h> if ! openssl dgst -sha256 -verify /tmp/pubkey.pem -signature "$PROVENANCE_SIG" "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> echo "Provenance signature verified."
[?2004l[?2004h> 
[?2004l[?2004h> # Step 6: Validate provenance content
[?2004l[?2004h> echo "Validating provenance content..."
[?2004l[?2004h> 
[?2004l[?2004h> # Check required fields exist
[?2004l[?2004h> if ! jq -e '.buildID' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if ! jq -e '.artifact' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if ! jq -e '.sha256' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if ! jq -e '.signedAt' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if ! jq -e '.signer' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if ! jq -e '.certificateChain' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Verify artifact name matches
[?2004l[?2004h> PROVENANCE_ARTIFACT=$(jq -r '.artifact' "$PROVENANCE_JSON")
[?2004l[?2004h> if [ "$PROVENANCE_ARTIFACT" != "$ARTIFACT_NAME" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Verify SHA256 checksum
