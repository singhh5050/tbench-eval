[?2004l[?2004hroot@2928fe68ba2e:/app# openssl crl2pkcs7 -nocrl -certfile /app/signed/release.tar.gz.chain.pem | openssl pkcs7 -print_certs -outform PEM -out $TMP_DIR/signing_cert.pem 2>/dev/null
