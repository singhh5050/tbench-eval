[?2004hroot@2928fe68ba2e:/app# cat > /app/verify_artifact.sh << 'EOF'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Artifact Verification Script
[?2004l[?2004h> # Verifies signed artifacts using certificate chain and signatures
[?2004l[?2004h> 
[?2004l[?2004h> set -e
[?2004l[?2004h> 
[?2004l[?2004h> # Check arguments
[?2004l[?2004h> if [ $# -ne 1 ]; then
[?2004l[?2004h>     echo "Usage: $0 <artifact-path>"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> ARTIFACT_PATH="$1"
[?2004l[?2004h> 
[?2004l[?2004h> # Extract artifact name
[?2004l[?2004h> ARTIFACT_NAME=$(basename "$ARTIFACT_PATH")
[?2004l[?2004h> 
[?2004l[?2004h> # Define file paths
[?2004l[?2004h> SIG_FILE="/app/signed/${ARTIFACT_NAME}.sig"
[?2004l[?2004h> PROVENANCE_JSON="/app/signed/${ARTIFACT_NAME}.provenance.json"
[?2004l[?2004h> PROVENANCE_SIG="/app/signed/${ARTIFACT_NAME}.provenance.sig"
[?2004l[?2004h> CHAIN_FILE="/app/signed/${ARTIFACT_NAME}.chain.pem"
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: File existence checks
[?2004l[?2004h> echo "Checking required files..."
[?2004l[?2004h> 
[?2004l[?2004h> if [ ! -f "$ARTIFACT_PATH" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if [ ! -f "$SIG_FILE" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if [ ! -f "$PROVENANCE_JSON" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if [ ! -f "$PROVENANCE_SIG" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if [ ! -f "$CHAIN_FILE" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> echo "All required files present."
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Extract signing certificate and validate chain
[?2004l[?2004h> echo "Validating certificate chain..."
[?2004l[?2004h> 
[?2004l[?2004h> # Create temp directory for working files
[?2004l[?2004h> TMP_DIR=$(mktemp -d)
[?2004l[?2004h> trap "rm -rf $TMP_DIR" EXIT
[?2004l[?2004h> 
[?2004l[?2004h> # Extract the first certificate (signing certificate) from the chain
[?2004l[?2004h> openssl crl2pkcs7 -nocrl -certfile "$CHAIN_FILE" | openssl pkcs7 -print_certs -outform PEM -out "$TMP_DIR/signing_cert.pem" 2>/dev/null
[?2004l[?2004h> 
[?2004l[?2004h> # Verify the signing cert against the CA chain (intermediate + root)
[?2004l[?2004h> # First verify intermediate is signed by root
[?2004l[?2004h> if ! openssl verify -CAfile /app/ca/root-ca.pem /app/ca/intermediate-ca.pem > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Verify signing cert is signed by intermediate (which is signed by root)
[?2004l[?2004h> # Use the intermediate CA as the CAfile for verification
[?2004l[?2004h> if ! openssl verify -CAfile /app/ca/intermediate-ca.pem -untrusted /app/ca/root-ca.pem "$TMP_DIR/signing_cert.pem" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Check certificate validity (not expired)
[?2004l[?2004h> if ! openssl x509 -in "$TMP_DIR/signing_cert.pem" -noout -checkend 0 2>/dev/null; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> echo "Certificate chain valid."
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Extract public key from signing certificate
[?2004l[?2004h> echo "Extracting public key from signing certificate..."
[?2004l[?2004h> openssl x509 -in "$TMP_DIR/signing_cert.pem" -pubkey -noout > "$TMP_DIR/pubkey.pem"
[?2004l[?2004h> 
[?2004l[?2004h> # Step 4: Verify artifact signature
[?2004l[?2004h> echo "Verifying artifact signature..."
[?2004l[?2004h> if ! openssl dgst -sha256 -verify "$TMP_DIR/pubkey.pem" -signature "$SIG_FILE" "$ARTIFACT_PATH" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> echo "Artifact signature verified."
[?2004l[?2004h> 
[?2004l[?2004h> # Step 5: Verify provenance signature
[?2004l[?2004h> echo "Verifying provenance signature..."
[?2004l[?2004h> if ! openssl dgst -sha256 -verify "$TMP_DIR/pubkey.pem" -signature "$PROVENANCE_SIG" "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> echo "Provenance signature verified."
[?2004l[?2004h> 
[?2004l[?2004h> # Step 6: Validate provenance content
[?2004l[?2004h> echo "Validating provenance content..."
[?2004l[?2004h> 
[?2004l[?2004h> # Check required fields exist
[?2004l[?2004h> if ! jq -e '.buildID' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if ! jq -e '.artifact' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if ! jq -e '.sha256' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if ! jq -e '.signedAt' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if ! jq -e '.signer' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> if ! jq -e '.certificateChain' "$PROVENANCE_JSON" > /dev/null 2>&1; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Verify artifact name matches
[?2004l[?2004h> PROVENANCE_ARTIFACT=$(jq -r '.artifact' "$PROVENANCE_JSON")
[?2004l[?2004h> if [ "$PROVENANCE_ARTIFACT" != "$ARTIFACT_NAME" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Verify SHA256 checksum
[?2004l[?2004h> ACTUAL_SHA256=$(sha256sum "$ARTIFACT_PATH" | awk '{print $1}')
[?2004l[?2004h> PROVENANCE_SHA256=$(jq -r '.sha256' "$PROVENANCE_JSON")
[?2004l[?2004h> if [ "$ACTUAL_SHA256" != "$PROVENANCE_SHA256" ]; then
[?2004l[?2004h>     echo "VERIFICATION_FAILED"
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> echo "Provenance content validated."
[?2004l[?2004h> echo "Artifact SHA256: $ACTUAL_SHA256"
[?2004l[?2004h> 
[?2004l[?2004h> echo ""
[?2004l[?2004h> echo "VERIFICATION_PASSED"
[?2004l[?2004h> exit 0
[?2004l[?2004h> EOF
[?2004l[?2004hroot@2928fe68ba2e:/app# chmod +x /app/verify_artifact.sh
[?2004l[?2004hroot@2928fe68ba2e:/app# /app/verify_artifact.sh /app/artifacts/release.tar.gz
[?2004lChecking required files...
All required files present.
