[64.55579, "o", "\u001b[?2004h> "]
[64.555804, "o", "mkdir -p /app/signing /app/signed\r\n\u001b[?2004l\r"]
[64.555813, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.555833, "o", "\u001b[?2004h> "]
[64.555853, "o", "# Get artifact name and calculate SHA256\r\n\u001b[?2004l\r"]
[64.55587, "o", "\u001b[?2004h> "]
[64.555892, "o", "ARTIFACT_NAME=$(basename \"$ARTIFACT_PATH\")\r\n\u001b[?2004l\r"]
[64.555911, "o", "\u001b[?2004h> "]
[64.555941, "o", "SHA256=$(sha256sum \"$ARTIFACT_PATH\" | awk '{print $1}')\r\n\u001b[?2004l\r"]
[64.555957, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.555978, "o", "\u001b[?2004h> "]
[64.555994, "o", "# Generate ephemeral ECDSA P-256 keypair\r\n\u001b[?2004l\r"]
[64.556002, "o", "\u001b[?2004h> "]
[64.556038, "o", "echo \"Generating ephemeral ECDSA keypair...\"\r\n\u001b[?2004l\r"]
[64.556055, "o", "\u001b[?2004h> "]
[64.556089, "o", "EPHEMERAL_KEY=\"/app/signing/ephemeral-key-${BUILD_ID}.pem\"\r\n\u001b[?2004l\r"]
[64.556106, "o", "\u001b[?2004h> "]
[64.55616, "o", "openssl ecparam -genkey -name prime256v1 -noout -out \"$EPHEMERAL_KEY\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[64.556186, "o", "> "]
[64.556205, "o", "# Create signing certificate signed by Intermediate CA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.556254, "o", "CERT_SUBJECT=\"CN=build-${BUILD_ID},O=SecureBuild,C=US\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.556272, "o", "> \r\n\u001b[?2004l\r"]
[64.556287, "o", "\u001b[?2004h> "]
[64.556303, "o", "echo \"Creating signing certificate...\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.55632, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.556343, "o", "# Generate CSR for ephemeral key\r\n\u001b[?2004l\r"]
[64.556352, "o", "\u001b[?2004h> "]
[64.556392, "o", "openssl req -new -key \"$EPHEMERAL_KEY\" \\\r\n\u001b[?2004l\r"]
[64.556402, "o", "\u001b[?2004h> "]
[64.556434, "o", "    -out /app/signing/cert-${BUILD_ID}.csr \\\r\n\u001b[?2004l\r"]
[64.556454, "o", "\u001b[?2004h> "]
[64.556477, "o", "    -subj \"/CN=build-${BUILD_ID}/O=SecureBuild/C=US\"\r\n\u001b[?2004l\r"]
[64.556488, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.556512, "o", "\u001b[?2004h> "]
[64.556537, "o", "# Create extensions file for ephemeral certificate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.55657, "o", "cat > /app/signing/ephemeral-ext.cnf << EXTN\r\n\u001b[?2004l\r"]
[64.556578, "o", "\u001b[?2004h> "]
[64.556597, "o", "basicConstraints=CA:FALSE\r\n\u001b[?2004l\r"]
[64.556605, "o", "\u001b[?2004h> "]
[64.556636, "o", "keyUsage=critical,digitalSignature\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.556658, "o", "extendedKeyUsage=codeSigning\r\n\u001b[?2004l\r"]
[64.556674, "o", "\u001b[?2004h> "]
[64.556691, "o", "subjectKeyIdentifier=hash\r\n\u001b[?2004l\r"]
[64.556706, "o", "\u001b[?2004h> "]
[64.556731, "o", "authorityKeyIdentifier=keyid:always,issuer\r\n\u001b[?2004l\r"]
[64.556746, "o", "\u001b[?2004h> EXTN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.556755, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.556803, "o", "# Sign the certificate with Intermediate CA (1 day validity)\r\n\u001b[?2004l\r"]
[64.556812, "o", "\u001b[?2004h> "]
[64.556832, "o", "openssl x509 -req \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.556849, "o", "    -days 1 \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.556885, "o", "    -in /app/signing/cert-${BUILD_ID}.csr \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.556901, "o", "> "]
[64.556919, "o", "    -CA /app/ca/intermediate-ca.pem \\\r\n\u001b[?2004l\r"]
[64.556936, "o", "\u001b[?2004h> "]
[64.55696, "o", "    -CAkey /app/ca/intermediate-ca-key.pem \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.556981, "o", "> "]
[64.556996, "o", "    -CAcreateserial \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.557036, "o", "    -out /app/signing/cert_${BUILD_ID}.pem \\\r\n\u001b[?2004l\r"]
[64.557047, "o", "\u001b[?2004h> "]
[64.557076, "o", "    -extfile /app/signing/ephemeral-ext.cnf \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.557096, "o", "    -sha256\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.557104, "o", "\u001b[?2004h> "]
[64.557135, "o", "# Sign the artifact with ephemeral key\r\n\u001b[?2004l\r"]
[64.557143, "o", "\u001b[?2004h> "]
[64.557164, "o", "echo \"Signing artifact...\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.557201, "o", "openssl dgst -sha256 -sign \"$EPHEMERAL_KEY\" \\\r\n\u001b[?2004l\r"]
[64.55721, "o", "\u001b[?2004h> "]
[64.557241, "o", "    -out \"/app/signed/${ARTIFACT_NAME}.sig\" \\\r\n\u001b[?2004l\r"]
[64.55725, "o", "\u001b[?2004h> "]
[64.557268, "o", "    \"$ARTIFACT_PATH\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.557276, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.55731, "o", "# Create provenance attestation JSON\r\n\u001b[?2004l\r"]
[64.557324, "o", "\u001b[?2004h> "]
[64.557347, "o", "TIMESTAMP=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\r\n\u001b[?2004l\r"]
[64.557355, "o", "\u001b[?2004h> "]
[64.557398, "o", "cat > \"/app/signed/${ARTIFACT_NAME}.provenance.json\" << PROV\r\n\u001b[?2004l\r"]
[64.557408, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[64.557428, "o", "\u001b[?2004h> "]
[64.557439, "o", "  \"buildID\": \"${BUILD_ID}\",\r\n\u001b[?2004l\r"]
[64.557458, "o", "\u001b[?2004h> "]
[64.557473, "o", "  \"artifact\": \"${ARTIFACT_NAME}\",\r\n\u001b[?2004l\r"]
[64.557481, "o", "\u001b[?2004h> "]
[64.557499, "o", "  \"sha256\": \"${SHA256}\",\r\n\u001b[?2004l\r"]
[64.557514, "o", "\u001b[?2004h> "]
[64.557532, "o", "  \"signedAt\": \"${TIMESTAMP}\",\r\n\u001b[?2004l\r"]
[64.557543, "o", "\u001b[?2004h> "]
[64.557565, "o", "  \"signer\": \"build-${BUILD_ID}\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.557607, "o", "  \"certificateChain\": [\"intermediate-ca\", \"root-ca\"]\r\n\u001b[?2004l\r"]
[64.557618, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[64.55764, "o", "\u001b[?2004h> "]
[64.557657, "o", "PROV\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.557683, "o", "# Sign the provenance JSON\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.5577, "o", "> "]
[64.557724, "o", "echo \"Signing provenance attestation...\"\r\n\u001b[?2004l\r"]
[64.557742, "o", "\u001b[?2004h> "]
[64.557802, "o", "openssl dgst -sha256 -sign \"$EPHEMERAL_KEY\" \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.557829, "o", "    -out \"/app/signed/${ARTIFACT_NAME}.provenance.sig\" \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.557845, "o", "> "]
[64.557868, "o", "    \"/app/signed/${ARTIFACT_NAME}.provenance.json\"\r\n\u001b[?2004l\r"]
[64.557876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.557902, "o", "\u001b[?2004h> "]
[64.557913, "o", "# Create certificate chain bundle\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.557922, "o", "> "]
[64.557946, "o", "echo \"Creating certificate chain...\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.557967, "o", "> "]
[64.557992, "o", "cat /app/signing/cert_${BUILD_ID}.pem \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.558013, "o", "    /app/ca/intermediate-ca.pem \\\r\n\u001b[?2004l\r"]
[64.55802, "o", "\u001b[?2004h> "]
[64.558041, "o", "    /app/ca/root-ca.pem \\\r\n\u001b[?2004l\r"]
[64.558049, "o", "\u001b[?2004h> "]
[64.558082, "o", "    > \"/app/signed/${ARTIFACT_NAME}.chain.pem\"\r\n\u001b[?2004l\r"]
[64.558097, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.558111, "o", "\u001b[?2004h> "]
[64.558119, "o", "# Destroy ephemeral private key\r\n\u001b[?2004l\r"]
[64.558126, "o", "\u001b[?2004h> "]
[64.558153, "o", "echo \"Destroying ephemeral key...\"\r\n\u001b[?2004l\r"]
[64.558161, "o", "\u001b[?2004h> "]
[64.55818, "o", "rm -f \"$EPHEMERAL_KEY\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.558189, "o", "> "]
[64.558215, "o", "rm -f /app/signing/cert-${BUILD_ID}.csr\r\n\u001b[?2004l\r"]
[64.558224, "o", "\u001b[?2004h> "]
[64.558253, "o", "rm -f /app/signing/ephemeral-ext.cnf\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.558268, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.558286, "o", "# Clean up signing directory\r\n\u001b[?2004l\r"]
[64.558294, "o", "\u001b[?2004h> "]
[64.558322, "o", "echo \"Cleaning up signing artifacts...\"\r\n\u001b[?2004l\r"]
[64.558338, "o", "\u001b[?2004h> "]
[64.558358, "o", "rm -f /app/signing/cert_${BUILD_ID}.pem\r\n\u001b[?2004l\r"]
[64.558366, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.558373, "o", "\u001b[?2004h> "]
[64.558405, "o", "# Remove any remaining ephemeral key files\r\n\u001b[?2004l\r"]
[64.558413, "o", "\u001b[?2004h> "]
[64.55847, "o", "find /app/signing -name \"ephemeral-key-*.pem\" -type f -delete 2>/dev/null || true\r\n\u001b[?2004l\r"]
[64.558478, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.558486, "o", "\u001b[?2004h> "]
[64.558513, "o", "echo \"Signing complete!\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.558537, "o", "echo \"Artifact: $ARTIFACT_PATH\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.558545, "o", "> "]
[64.558567, "o", "echo \"Build ID: $BUILD_ID\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.558585, "o", "echo \"SHA256: $SHA256\"\r\n\u001b[?2004l\r"]
[64.558593, "o", "\u001b[?2004h> "]
[64.5586, "o", "echo \"\"\r\n\u001b[?2004l\r"]
[64.558632, "o", "\u001b[?2004h> "]
[64.558647, "o", "echo \"Output files:\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.558666, "o", "echo \"  - Signature: /app/signed/${ARTIFACT_NAME}.sig\"\r\n\u001b[?2004l\r"]
[64.558673, "o", "\u001b[?2004h> "]
[64.55872, "o", "echo \"  - Provenance: /app/signed/${ARTIFACT_NAME}.provenance.json\"\r\n\u001b[?2004l\r"]
[64.558728, "o", "\u001b[?2004h> "]
[64.55878, "o", "echo \"  - Provenance Signature: /app/signed/${ARTIFACT_NAME}.provenance.sig\"\r\n\u001b[?2004l\r"]
[64.558788, "o", "\u001b[?2004h> "]
[64.558828, "o", "echo \"  - Chain: /app/signed/${ARTIFACT_NAME}.chain.pem\"\r\n\u001b[?2004l\r"]
[64.558835, "o", "\u001b[?2004h> EOF\r\n"]
[64.558845, "o", "\u001b[?2004l\r"]
[64.559741, "o", "\u001b[?2004hroot@2928fe68ba2e:/app# "]
[64.559763, "o", "chmod +x /app/sign_artifact.sh\r\n\u001b[?2004l\r"]
[64.56046, "o", "\u001b[?2004hroot@2928fe68ba2e:/app# "]
[102.319421, "i", "cat > /app/verify_artifact.sh << 'EOF'\n#!/bin/bash\n# Artifact Verification Script\n# Verifies signed artifacts using certificate chain and signatures\n\nset -e\n\n# Check arguments\nif [ $# -ne 1 ]; then\n    echo \"Usage: $0 <artifact-path>\"\n    exit 1\nfi\n\nARTIFACT_PATH=\"$1\"\n\n# Extract artifact name\nARTIFACT_NAME=$(basename \"$ARTIFACT_PATH\")\n\n# Define file paths\nSIG_FILE=\"/app/signed/${ARTIFACT_NAME}.sig\"\nPROVENANCE_JSON=\"/app/signed/${ARTIFACT_NAME}.provenance.json\"\nPROVENANCE_SIG=\"/app/signed/${ARTIFACT_NAME}.provenance.sig\"\nCHAIN_FILE=\"/app/signed/${ARTIFACT_NAME}.chain.pem\"\n\n# Step 1: File existence checks\necho \"Checking required files...\"\n\nif [ ! -f \"$ARTIFACT_PATH\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif [ ! -f \"$SIG_FILE\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif [ ! -f \"$PROVENANCE_JSON\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif [ ! -f \"$PROVENANCE_SIG\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif [ ! -f \"$CHAIN_FILE\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\necho \"All required files present.\"\n\n# Step 2: Extract signing certificate from chain and validate\necho \"Validating certificate chain...\"\n\n# Extract the first certificate (signing certificate) from the chain\nopenssl x509 -in \"$CHAIN_FILE\" -noout > /tmp/signing_cert.pem 2>/dev/null\n\n# Verify the chain using OpenSSL's verify command\n# We need to verify that:\n# 1. The signing cert was signed by intermediate CA\n# 2. The intermediate CA was signed by root CA\n\n# Create a CA bundle for verification\nCA_BUNDLE=\"/tmp/ca-bundle.pem\"\ncat /app/ca/intermediate-ca.pem /app/ca/root-ca.pem > \"$CA_BUNDLE\"\n\n# Verify the chain\nif ! openssl verify -CAfile \"$CA_BUNDLE\" /tmp/signing_cert.pem > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\n# Check certificate validity (not expired)\nif ! openssl x509 -in /tmp/signing_cert.pem -noout -checkend 0 2>/dev/null; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\n# Verify intermediate CA is signed by root CA\nif ! openssl verify -CAfile /app/ca/root-ca.pem /app/ca/intermediate-ca.pem > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\necho \"Certificate chain valid.\"\n\n# Step 3: Extract public key from signing certificate\necho \"Extracting public key from signing certificate...\"\nopenssl x509 -in /tmp/signing_cert.pem -pubkey -noout > /tmp/pubkey.pem\n\n# Step 4: Verify artifact signature\necho \"Verifying artifact signature...\"\nif ! openssl dgst -sha256 -verify /tmp/pubkey.pem -signature \"$SIG_FILE\" \"$ARTIFACT_PATH\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\necho \"Artifact signature verified.\"\n\n# Step 5: Verify provenance signature\necho \"Verifying provenance signature...\"\nif ! openssl dgst -sha256 -verify /tmp/pubkey.pem -signature \"$PROVENANCE_SIG\" \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\necho \"Provenance signature verified.\"\n\n# Step 6: Validate provenance content\necho \"Validating provenance content...\"\n\n# Check required fields exist\nif ! jq -e '.buildID' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif ! jq -e '.artifact' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif ! jq -e '.sha256' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif ! jq -e '.signedAt' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif ! jq -e '.signer' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif ! jq -e '.certificateChain' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\n# Verify artifact name matches\nPROVENANCE_ARTIFACT=$(jq -r '.artifact' \"$PROVENANCE_JSON\")\nif [ \"$PROVENANCE_ARTIFACT\" != \"$ARTIFACT_NAME\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\n# Verify SHA256 checksum\nACTUAL_SHA256=$(sha256sum \"$ARTIFACT_PATH\" | awk '{print $1}')\nPROVENANCE_SHA256=$(jq -r '.sha256' \"$PROVENANCE_JSON\")\nif [ \"$ACTUAL_SHA256\" != \"$PROVENANCE_SHA256\" ]; then\n  "]
[102.319568, "i", "  echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\necho \"Provenance content validated.\"\necho \"Artifact SHA256: $ACTUAL_SHA256\"\n\n# Cleanup\nrm -f /tmp/signing_cert.pem /tmp/pubkey.pem \"$CA_BUNDLE\"\n\necho \"\"\necho \"VERIFICATION_PASSED\"\nexit 0\nEOF\nchmod +x /app/verify_artifact.sh\n"]
[102.319805, "o", "cat > /app/verify_artifact.sh << 'EOF'\r\n\u001b[?2004l\r"]
[102.319893, "o", "\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> # Artifact Verification Script\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.319953, "o", "# Verifies signed artifacts using certificate chain and signatures\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.320003, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.320037, "o", "set -e\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check arguments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.320083, "o", "if [ $# -ne 1 ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.320157, "o", "    echo \"Usage: $0 <artifact-path>\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r"]
[102.320188, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.320337, "o", "ARTIFACT_PATH=\"$1\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Extract artifact name\r\n\u001b[?2004l\r\u001b[?2004h> ARTIFACT_NAME=$(basename \"$ARTIFACT_PATH\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Define file paths\r\n\u001b[?2004l\r"]
[102.320396, "o", "\u001b[?2004h> SIG_FILE=\"/app/signed/${ARTIFACT_NAME}.sig\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.32043, "o", "PROVENANCE_JSON=\"/app/signed/${ARTIFACT_NAME}.provenance.json\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.320477, "o", "PROVENANCE_SIG=\"/app/signed/${ARTIFACT_NAME}.provenance.sig\"\r\n\u001b[?2004l\r"]
[102.320496, "o", "\u001b[?2004h> "]
[102.320539, "o", "CHAIN_FILE=\"/app/signed/${ARTIFACT_NAME}.chain.pem\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.32056, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.320584, "o", "# Step 1: File existence checks\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.320604, "o", "> "]
[102.320622, "o", "echo \"Checking required files...\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.320642, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.320669, "o", "if [ ! -f \"$ARTIFACT_PATH\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.320688, "o", "> "]
[102.320707, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r"]
[102.320727, "o", "\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r"]
[102.320746, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[102.320765, "o", "\u001b[?2004h> "]
[102.320785, "o", "if [ ! -f \"$SIG_FILE\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.320809, "o", "> "]
[102.320829, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.320871, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[102.320908, "o", "\u001b[?2004h> "]
[102.32097, "o", "if [ ! -f \"$PROVENANCE_JSON\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321025, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321058, "o", "if [ ! -f \"$PROVENANCE_SIG\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321081, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321102, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.321121, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321151, "o", "if [ ! -f \"$CHAIN_FILE\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321182, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.321204, "o", ">     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321224, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[102.321242, "o", "\u001b[?2004h> "]
[102.321263, "o", "echo \"All required files present.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.321289, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321332, "o", "# Step 2: Extract signing certificate from chain and validate\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.32135, "o", "> "]
[102.321376, "o", "echo \"Validating certificate chain...\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.321394, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321445, "o", "# Extract the first certificate (signing certificate) from the chain\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.321465, "o", "> "]
[102.321511, "o", "openssl x509 -in \"$CHAIN_FILE\" -noout > /tmp/signing_cert.pem 2>/dev/null\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.32153, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321571, "o", "# Verify the chain using OpenSSL's verify command\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.32159, "o", "> "]
[102.321609, "o", "# We need to verify that:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321653, "o", "# 1. The signing cert was signed by intermediate CA\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.321673, "o", "> "]
[102.3217, "o", "# 2. The intermediate CA was signed by root CA\r\n\u001b[?2004l\r"]
[102.321724, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[102.321742, "o", "> "]
[102.321763, "o", "# Create a CA bundle for verification\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.321781, "o", "> "]
[102.321801, "o", "CA_BUNDLE=\"/tmp/ca-bundle.pem\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.321817, "o", "> "]
[102.32186, "o", "cat /app/ca/intermediate-ca.pem /app/ca/root-ca.pem > \"$CA_BUNDLE\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.321871, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.32191, "o", "# Verify the chain\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.321996, "o", "if ! openssl verify -CAfile \"$CA_BUNDLE\" /tmp/signing_cert.pem > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322034, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322058, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322124, "o", "# Check certificate validity (not expired)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322191, "o", "if ! openssl x509 -in /tmp/signing_cert.pem -noout -checkend 0 2>/dev/null; then\r\n\u001b[?2004l\r"]
[102.322212, "o", "\u001b[?2004h> "]
[102.322258, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n"]
[102.322296, "o", "\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322371, "o", "# Verify intermediate CA is signed by root CA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322423, "o", "if ! openssl verify -CAfile /app/ca/root-ca.pem /app/ca/intermediate-ca.pem > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.322458, "o", ">     echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322489, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.322507, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322549, "o", "echo \"Certificate chain valid.\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[102.322574, "o", "> "]
[102.322606, "o", "# Step 3: Extract public key from signing certificate\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.322658, "o", "> "]
[102.322677, "o", "echo \"Extracting public key from signing certificate...\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322727, "o", "openssl x509 -in /tmp/signing_cert.pem -pubkey -noout > /tmp/pubkey.pem\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322744, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322787, "o", "# Step 4: Verify artifact signature\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322819, "o", "echo \"Verifying artifact signature...\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.322911, "o", "if ! openssl dgst -sha256 -verify /tmp/pubkey.pem -signature \"$SIG_FILE\" \"$ARTIFACT_PATH\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[102.322928, "o", "\u001b[?2004h> "]
[102.322978, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
[102.322996, "o", "\u001b[?2004h> "]
[102.323037, "o", "echo \"Artifact signature verified.\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[102.323053, "o", "\u001b[?2004h> "]
[102.323094, "o", "# Step 5: Verify provenance signature\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.323127, "o", "echo \"Verifying provenance signature...\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.323224, "o", "if ! openssl dgst -sha256 -verify /tmp/pubkey.pem -signature \"$PROVENANCE_SIG\" \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[102.323241, "o", "\u001b[?2004h> "]
[102.323286, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
[102.323304, "o", "\u001b[?2004h> "]
[102.323346, "o", "echo \"Provenance signature verified.\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.323384, "o", "# Step 6: Validate provenance content\r\n\u001b[?2004l\r"]
[102.3234, "o", "\u001b[?2004h> "]
[102.323445, "o", "echo \"Validating provenance content...\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.323475, "o", "# Check required fields exist\r\n\u001b[?2004l\r"]
[102.323492, "o", "\u001b[?2004h> "]
[102.323546, "o", "if ! jq -e '.buildID' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.323577, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.323594, "o", ">     exit 1\r\n\u001b[?2004l\r"]
[102.323608, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.323627, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.323691, "o", "if ! jq -e '.artifact' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.323708, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.323722, "o", "    exit 1\r\n\u001b[?2004l\r"]
[102.323737, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.323753, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.323823, "o", "if ! jq -e '.sha256' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.323842, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.32388, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.323931, "o", "if ! jq -e '.signedAt' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.323947, "o", "> "]
[102.323991, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n"]
[102.324008, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[102.324022, "o", "> "]
[102.324069, "o", "if ! jq -e '.signer' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324094, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r"]
[102.324113, "o", "\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r"]
[102.32415, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324199, "o", "if ! jq -e '.certificateChain' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.324215, "o", "> "]
[102.324255, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324271, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[102.324284, "o", "\u001b[?2004h> "]
[102.324335, "o", "# Verify artifact name matches\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324365, "o", "PROVENANCE_ARTIFACT=$(jq -r '.artifact' \"$PROVENANCE_JSON\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.324399, "o", "> "]
[102.324417, "o", "if [ \"$PROVENANCE_ARTIFACT\" != \"$ARTIFACT_NAME\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324456, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324487, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
[102.324504, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324542, "o", "# Verify SHA256 checksum\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.32457, "o", "ACTUAL_SHA256=$(sha256sum \"$ARTIFACT_PATH\" | awk '{print $1}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.324589, "o", "> "]
[102.324625, "o", "PROVENANCE_SHA256=$(jq -r '.sha256' \"$PROVENANCE_JSON\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.324641, "o", "> "]
[102.324678, "o", "if [ \"$ACTUAL_SHA256\" != \"$PROVENANCE_SHA256\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324705, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r"]
[102.324721, "o", "\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r"]
[102.324758, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324786, "o", "echo \"Provenance content validated.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324824, "o", "echo \"Artifact SHA256: $ACTUAL_SHA256\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[102.324839, "o", "\u001b[?2004h> "]
[102.324877, "o", "# Cleanup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324905, "o", "rm -f /tmp/signing_cert.pem /tmp/pubkey.pem \"$CA_BUNDLE\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324921, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.324933, "o", "echo \"\"\r\n\u001b[?2004l\r"]
[102.324985, "o", "\u001b[?2004h> echo \"VERIFICATION_PASSED\"\r\n\u001b[?2004l\r\u001b[?2004h> exit 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.325004, "o", "EOF\r\n\u001b[?2004l\r"]
[102.325852, "o", "\u001b[?2004hroot@2928fe68ba2e:/app# "]
[102.325935, "o", "chmod +x /app/verify_artifact.sh\r\n\u001b[?2004l\r"]
[102.32673, "o", "\u001b[?2004hroot@2928fe68ba2e:/app# "]
[110.047556, "i", "/app/setup_ca.sh\n"]
[110.047851, "o", "/app/setup_ca.sh\r\n\u001b[?2004l\r"]
[110.051193, "o", "Generating Root CA private key...\r\n"]
[110.231514, "o", "Root CA certificate created: /app/ca/root-ca.pem\r\nGenerating Intermediate CA private key...\r\n"]
[111.155053, "o", "Certificate request self-signature ok\r\nsubject=CN=Build Pipeline Intermediate CA, O=SecureBuild, C=US\r\n"]
[111.159957, "o", "Intermediate CA certificate created: /app/ca/intermediate-ca.pem\r\n"]
[111.16156, "o", "CA hierarchy setup complete!\r\nRoot CA: /app/ca/root-ca.pem\r\nIntermediate CA: /app/ca/intermediate-ca.pem\r\n"]
[111.16197, "o", "\u001b[?2004h"]
[111.162, "o", "root@2928fe68ba2e:/app# "]
