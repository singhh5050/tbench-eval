[116.445883, "o", "ls -la /app/ca/\r\n"]
[116.445898, "o", "\u001b[?2004l\r"]
[116.446945, "o", "total 32\r\n"]
[116.446977, "o", "drwxr-xr-x 1 root root 4096 Apr  9 23:46 .\r\ndrwxr-xr-x 1 root root 4096 Apr  9 23:46 ..\r\n-rw------- 1 root root 3272 Apr  9 23:46 intermediate-ca-key.pem\r\n"]
[116.447001, "o", "-rw-r--r-- 1 root root 1976 Apr  9 23:46 intermediate-ca.pem\r\n-rw------- 1 root root 3272 Apr  9 23:46 root-ca-key.pem\r\n-rw-r--r-- 1 root root 1964 Apr  9 23:46 root-ca.pem\r\n-rw-r--r-- 1 root root   41 Apr  9 23:46 root-ca.srl\r\n"]
[116.447219, "o", "\u001b[?2004hroot@2928fe68ba2e:/app# "]
[116.537793, "i", "/app/sign_artifact.sh /app/artifacts/release.tar.gz build-001\n"]
[116.538099, "o", "/app/sign_artifact.sh /app/artifacts/release.tar.gz build-001\r\n\u001b[?2004l\r"]
[116.542526, "o", "Generating ephemeral ECDSA keypair...\r\n"]
[116.54842, "o", "Creating signing certificate...\r\n"]
[116.560542, "o", "Certificate request self-signature ok\r\nsubject=CN=build-build-001, O=Sec"]
[116.560575, "o", "ureBuild, C=US\r\n"]
[116.565123, "o", "Signing artifact...\r\n"]
[116.570496, "o", "Signing provenance attestation...\r\n"]
[116.574182, "o", "Creating certificate chain...\r\n"]
[116.575151, "o", "Destroying ephemeral key...\r\n"]
[116.576945, "o", "Cleaning up signing artifacts...\r\n"]
[116.578381, "o", "Signing complete!\r\nArtifact: /app/artifacts/release.tar.gz\r\nBuild ID: build-001\r\nSHA256: b876932d4bbad3033d1fafd1d7bcb9111e88a0a15a7e564f15805c5d6c6309c3\r\n\r\nOutput files:\r\n"]
[116.57842, "o", "  - Signature: /app/signed/release.tar.gz.sig\r\n  - Provenance: /app/signed/release.tar.gz.provenance.json\r\n  - Provenance Signature: /app/signed/release.tar.gz.provenance.sig\r\n  - Chain: /app/signed/release.tar.gz.chain.pem\r\n"]
[116.578638, "o", "\u001b[?2004h"]
[116.578662, "o", "root@2928fe68ba2e:/app# "]
