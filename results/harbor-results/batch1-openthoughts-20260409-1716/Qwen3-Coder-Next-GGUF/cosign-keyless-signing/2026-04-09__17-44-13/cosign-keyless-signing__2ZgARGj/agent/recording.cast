[201.74941, "o", "\u001b[?2004hroot@2928fe68ba2e:/app# "]
[238.551445, "i", "cat > /app/verify_artifact.sh << 'EOF'\n#!/bin/bash\n# Artifact Verification Script\n# Verifies signed artifacts using certificate chain and signatures\n\nset -e\n\n# Check arguments\nif [ $# -ne 1 ]; then\n    echo \"Usage: $0 <artifact-path>\"\n    exit 1\nfi\n\nARTIFACT_PATH=\"$1\"\n\n# Extract artifact name\nARTIFACT_NAME=$(basename \"$ARTIFACT_PATH\")\n\n# Define file paths\nSIG_FILE=\"/app/signed/${ARTIFACT_NAME}.sig\"\nPROVENANCE_JSON=\"/app/signed/${ARTIFACT_NAME}.provenance.json\"\nPROVENANCE_SIG=\"/app/signed/${ARTIFACT_NAME}.provenance.sig\"\nCHAIN_FILE=\"/app/signed/${ARTIFACT_NAME}.chain.pem\"\n\n# Step 1: File existence checks\necho \"Checking required files...\"\n\nif [ ! -f \"$ARTIFACT_PATH\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif [ ! -f \"$SIG_FILE\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif [ ! -f \"$PROVENANCE_JSON\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif [ ! -f \"$PROVENANCE_SIG\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif [ ! -f \"$CHAIN_FILE\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\necho \"All required files present.\"\n\n# Step 2: Extract signing certificate and validate chain\necho \"Validating certificate chain...\"\n\n# Create temp directory for working files\nTMP_DIR=$(mktemp -d)\ntrap \"rm -rf $TMP_DIR\" EXIT\n\n# Extract the first certificate (signing certificate) from the chain\nopenssl crl2pkcs7 -nocrl -certfile \"$CHAIN_FILE\" | openssl pkcs7 -print_certs -outform PEM -out \"$TMP_DIR/signing_cert.pem\" 2>/dev/null\n\n# Verify the signing cert against the CA chain (intermediate + root)\n# First verify intermediate is signed by root\nif ! openssl verify -CAfile /app/ca/root-ca.pem /app/ca/intermediate-ca.pem > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\n# Create CA chain bundle for verification\nCA_CHAIN_BUNDLE=\"$TMP_DIR/ca-chain.pem\"\ncat /app/ca/intermediate-ca.pem /app/ca/root-ca.pem > \"$CA_CHAIN_BUNDLE\"\n\n# Verify signing cert is signed by the CA chain\nif ! openssl verify -CAfile \"$CA_CHAIN_BUNDLE\" \"$TMP_DIR/signing_cert.pem\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\n# Check certificate validity (not expired)\nif ! openssl x509 -in \"$TMP_DIR/signing_cert.pem\" -noout -checkend 0 2>/dev/null; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\necho \"Certificate chain valid.\"\n\n# Step 3: Extract public key from signing certificate\necho \"Extracting public key from signing certificate...\"\nopenssl x509 -in \"$TMP_DIR/signing_cert.pem\" -pubkey -noout > \"$TMP_DIR/pubkey.pem\"\n\n# Step 4: Verify artifact signature\necho \"Verifying artifact signature...\"\nif ! openssl dgst -sha256 -verify \"$TMP_DIR/pubkey.pem\" -signature \"$SIG_FILE\" \"$ARTIFACT_PATH\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\necho \"Artifact signature verified.\"\n\n# Step 5: Verify provenance signature\necho \"Verifying provenance signature...\"\nif ! openssl dgst -sha256 -verify \"$TMP_DIR/pubkey.pem\" -signature \"$PROVENANCE_SIG\" \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\necho \"Provenance signature verified.\"\n\n# Step 6: Validate provenance content\necho \"Validating provenance content...\"\n\n# Check required fields exist\nif ! jq -e '.buildID' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif ! jq -e '.artifact' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif ! jq -e '.sha256' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif ! jq -e '.signedAt' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif ! jq -e '.signer' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\nif ! jq -e '.certificateChain' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\n# Verify artifact name matches\nPROVENANCE_ARTIFACT=$(jq -r '.artifact' \"$PROVENANCE_JSON\")\nif [ \"$PROVENANCE_ARTIFACT\" != \"$ARTIFACT_NAME\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\n# Verify SHA256 checksum\nACTUAL_SHA256=$(sha256sum \"$ARTIFACT_PATH\" "]
[238.551501, "i", "| awk '{print $1}')\nPROVENANCE_SHA256=$(jq -r '.sha256' \"$PROVENANCE_JSON\")\nif [ \"$ACTUAL_SHA256\" != \"$PROVENANCE_SHA256\" ]; then\n    echo \"VERIFICATION_FAILED\"\n    exit 1\nfi\n\necho \"Provenance content validated.\"\necho \"Artifact SHA256: $ACTUAL_SHA256\"\n\necho \"\"\necho \"VERIFICATION_PASSED\"\nexit 0\nEOF\nchmod +x /app/verify_artifact.sh\n"]
