[32.760974, "i", "cat > /app/setup_ca.sh << 'EOF'\n#!/bin/bash\n# CA Hierarchy Setup Script\n# Creates Root CA and Intermediate CA for the signing pipeline\n\nset -e\n\n# Create directory structure\nmkdir -p /app/ca /app/signing /app/signed\n\n# Root CA configuration\nROOT_CA_CONFIG=$(cat << 'CNF'\n[req]\ndistinguished_name = req_distinguished_name\nx509_extensions = v3_ca\nprompt = no\n\n[req_distinguished_name]\nCN = Software Signing Root CA\nO = SecureBuild\nC = US\n\n[v3_ca]\nsubjectKeyIdentifier = hash\nauthorityKeyIdentifier = keyid:always,issuer\nbasicConstraints = critical, CA:TRUE\nkeyUsage = critical, keyCertSign, cRLSign\nCNF\n)\n\n# Intermediate CA configuration\nINT_CA_CONFIG=$(cat << 'CNF'\n[req]\ndistinguished_name = req_distinguished_name\nprompt = no\n\n[req_distinguished_name]\nCN = Build Pipeline Intermediate CA\nO = SecureBuild\nC = US\n\n[v3_intermediate_ca]\nsubjectKeyIdentifier = hash\nauthorityKeyIdentifier = keyid:always,issuer\nbasicConstraints = critical, CA:TRUE, pathlen:0\nkeyUsage = critical, keyCertSign, digitalSignature\nCNF\n)\n\n# Generate Root CA private key (4096-bit RSA)\necho \"Generating Root CA private key...\"\nopenssl genrsa -out /app/ca/root-ca-key.pem 4096\n\n# Generate Root CA self-signed certificate\nopenssl req -new -x509 -days 3650 -key /app/ca/root-ca-key.pem \\\n    -out /app/ca/root-ca.pem \\\n    -subj \"/CN=Software Signing Root CA/O=SecureBuild/C=US\" \\\n    -addext \"basicConstraints=critical,CA:TRUE\" \\\n    -addext \"keyUsage=critical,keyCertSign,cRLSign\"\n\necho \"Root CA certificate created: /app/ca/root-ca.pem\"\n\n# Generate Intermediate CA private key\necho \"Generating Intermediate CA private key...\"\nopenssl genrsa -out /app/ca/intermediate-ca-key.pem 4096\n\n# Generate Intermediate CA CSR\nopenssl req -new -key /app/ca/intermediate-ca-key.pem \\\n    -out /app/ca/intermediate-ca.csr \\\n    -subj \"/CN=Build Pipeline Intermediate CA/O=SecureBuild/C=US\"\n\n# Sign Intermediate CA with Root CA\nopenssl x509 -req -days 1825 -in /app/ca/intermediate-ca.csr \\\n    -CA /app/ca/root-ca.pem \\\n    -CAkey /app/ca/root-ca-key.pem \\\n    -CAcreateserial \\\n    -out /app/ca/intermediate-ca.pem \\\n    -extfile <(echo -e \"basicConstraints=critical,CA:TRUE,pathlen:0\\nkeyUsage=critical,keyCertSign,digitalSignature\\nsubjectKeyIdentifier=hash\\nauthorityKeyIdentifier=keyid:always,issuer\")\n\necho \"Intermediate CA certificate created: /app/ca/intermediate-ca.pem\"\n\n# Clean up CSR file\nrm -f /app/ca/intermediate-ca.csr\n\necho \"CA hierarchy setup complete!\"\necho \"Root CA: /app/ca/root-ca.pem\"\necho \"Intermediate CA: /app/ca/intermediate-ca.pem\"\nEOF\nchmod +x /app/setup_ca.sh\n"]
