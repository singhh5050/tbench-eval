[238.55641, "o", "> \r\n\u001b[?2004l\r"]
[238.556421, "o", "\u001b[?2004h> "]
[238.556477, "o", "if ! jq -e '.sha256' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[238.556489, "o", "\u001b[?2004h> "]
[238.556515, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r"]
[238.556525, "o", "\u001b[?2004h"]
[238.55655, "o", ">     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
[238.556569, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[238.556591, "o", "\u001b[?2004h> "]
[238.556627, "o", "if ! jq -e '.signedAt' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[238.556636, "o", "\u001b[?2004h> "]
[238.556664, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r"]
[238.556673, "o", "\u001b[?2004h> "]
[238.5567, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.556709, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[238.556718, "o", "> "]
[238.556823, "o", "if ! jq -e '.signer' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.556887, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.556946, "o", "if ! jq -e '.certificateChain' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.557107, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify artifact name matches\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.557151, "o", "PROVENANCE_ARTIFACT=$(jq -r '.artifact' \"$PROVENANCE_JSON\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.557185, "o", "if [ \"$PROVENANCE_ARTIFACT\" != \"$ARTIFACT_NAME\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.557202, "o", "> "]
[238.557241, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r"]
[238.557258, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
[238.557295, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify SHA256 checksum\r\n"]
[238.557312, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[238.557368, "o", "ACTUAL_SHA256=$(sha256sum \"$ARTIFACT_PATH\" | awk '{print $1}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.557384, "o", "> "]
