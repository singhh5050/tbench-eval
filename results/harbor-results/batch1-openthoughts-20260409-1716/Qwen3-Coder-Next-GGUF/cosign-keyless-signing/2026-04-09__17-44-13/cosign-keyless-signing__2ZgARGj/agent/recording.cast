[64.554973, "i", "cat > /app/sign_artifact.sh << 'EOF'\n#!/bin/bash\n# Artifact Signing Script\n# Signs artifacts with ephemeral keys that are destroyed after use\n\nset -e\n\n# Check arguments\nif [ $# -ne 2 ]; then\n    echo \"Usage: $0 <artifact-path> <build-id>\"\n    exit 1\nfi\n\nARTIFACT_PATH=\"$1\"\nBUILD_ID=\"$2\"\n\n# Validate artifact exists\nif [ ! -f \"$ARTIFACT_PATH\" ]; then\n    echo \"Error: Artifact not found: $ARTIFACT_PATH\"\n    exit 1\nfi\n\n# Create output directories if they don't exist\nmkdir -p /app/signing /app/signed\n\n# Get artifact name and calculate SHA256\nARTIFACT_NAME=$(basename \"$ARTIFACT_PATH\")\nSHA256=$(sha256sum \"$ARTIFACT_PATH\" | awk '{print $1}')\n\n# Generate ephemeral ECDSA P-256 keypair\necho \"Generating ephemeral ECDSA keypair...\"\nEPHEMERAL_KEY=\"/app/signing/ephemeral-key-${BUILD_ID}.pem\"\nopenssl ecparam -genkey -name prime256v1 -noout -out \"$EPHEMERAL_KEY\"\n\n# Create signing certificate signed by Intermediate CA\nCERT_SUBJECT=\"CN=build-${BUILD_ID},O=SecureBuild,C=US\"\n\necho \"Creating signing certificate...\"\n\n# Generate CSR for ephemeral key\nopenssl req -new -key \"$EPHEMERAL_KEY\" \\\n    -out /app/signing/cert-${BUILD_ID}.csr \\\n    -subj \"/CN=build-${BUILD_ID}/O=SecureBuild/C=US\"\n\n# Create extensions file for ephemeral certificate\ncat > /app/signing/ephemeral-ext.cnf << EXTN\nbasicConstraints=CA:FALSE\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=codeSigning\nsubjectKeyIdentifier=hash\nauthorityKeyIdentifier=keyid:always,issuer\nEXTN\n\n# Sign the certificate with Intermediate CA (1 day validity)\nopenssl x509 -req \\\n    -days 1 \\\n    -in /app/signing/cert-${BUILD_ID}.csr \\\n    -CA /app/ca/intermediate-ca.pem \\\n    -CAkey /app/ca/intermediate-ca-key.pem \\\n    -CAcreateserial \\\n    -out /app/signing/cert_${BUILD_ID}.pem \\\n    -extfile /app/signing/ephemeral-ext.cnf \\\n    -sha256\n\n# Sign the artifact with ephemeral key\necho \"Signing artifact...\"\nopenssl dgst -sha256 -sign \"$EPHEMERAL_KEY\" \\\n    -out \"/app/signed/${ARTIFACT_NAME}.sig\" \\\n    \"$ARTIFACT_PATH\"\n\n# Create provenance attestation JSON\nTIMESTAMP=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\ncat > \"/app/signed/${ARTIFACT_NAME}.provenance.json\" << PROV\n{\n  \"buildID\": \"${BUILD_ID}\",\n  \"artifact\": \"${ARTIFACT_NAME}\",\n  \"sha256\": \"${SHA256}\",\n  \"signedAt\": \"${TIMESTAMP}\",\n  \"signer\": \"build-${BUILD_ID}\",\n  \"certificateChain\": [\"intermediate-ca\", \"root-ca\"]\n}\nPROV\n\n# Sign the provenance JSON\necho \"Signing provenance attestation...\"\nopenssl dgst -sha256 -sign \"$EPHEMERAL_KEY\" \\\n    -out \"/app/signed/${ARTIFACT_NAME}.provenance.sig\" \\\n    \"/app/signed/${ARTIFACT_NAME}.provenance.json\"\n\n# Create certificate chain bundle\necho \"Creating certificate chain...\"\ncat /app/signing/cert_${BUILD_ID}.pem \\\n    /app/ca/intermediate-ca.pem \\\n    /app/ca/root-ca.pem \\\n    > \"/app/signed/${ARTIFACT_NAME}.chain.pem\"\n\n# Destroy ephemeral private key\necho \"Destroying ephemeral key...\"\nrm -f \"$EPHEMERAL_KEY\"\nrm -f /app/signing/cert-${BUILD_ID}.csr\nrm -f /app/signing/ephemeral-ext.cnf\n\n# Clean up signing directory\necho \"Cleaning up signing artifacts...\"\nrm -f /app/signing/cert_${BUILD_ID}.pem\n\n# Remove any remaining ephemeral key files\nfind /app/signing -name \"ephemeral-key-*.pem\" -type f -delete 2>/dev/null || true\n\necho \"Signing complete!\"\necho \"Artifact: $ARTIFACT_PATH\"\necho \"Build ID: $BUILD_ID\"\necho \"SHA256: $SHA256\"\necho \"\"\necho \"Output files:\"\necho \"  - Signature: /app/signed/${ARTIFACT_NAME}.sig\"\necho \"  - Provenance: /app/signed/${ARTIFACT_NAME}.provenance.json\"\necho \"  - Provenance Signature: /app/signed/${ARTIFACT_NAME}.provenance.sig\"\necho \"  - Chain: /app/signed/${ARTIFACT_NAME}.chain.pem\"\nEOF\nchmod +x /app/sign_artifact.sh\n"]
[64.555244, "o", "cat > /app/sign_artifact.sh << 'EOF'\r\n\u001b[?2004l\r"]
