[238.557445, "o", "> "]
[238.557486, "o", "if [ \"$ACTUAL_SHA256\" != \"$PROVENANCE_SHA256\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.557503, "o", "> "]
[238.557538, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n"]
[238.55756, "o", "\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.557573, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.557614, "o", "echo \"Provenance content validated.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.557631, "o", "> "]
[238.557666, "o", "echo \"Artifact SHA256: $ACTUAL_SHA256\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
