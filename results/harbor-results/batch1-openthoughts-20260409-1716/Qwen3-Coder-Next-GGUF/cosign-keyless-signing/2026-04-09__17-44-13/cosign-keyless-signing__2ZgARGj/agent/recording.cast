[173.802598, "o", "\u001b[?2004h> "]
[173.802651, "o", "trap \"rm -rf $TMP_DIR\" EXIT\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[173.80267, "o", "> "]
[173.802714, "o", "# Extract the first certificate (signing certificate) from the chain\r\n\u001b[?2004l\r"]
[173.802726, "o", "\u001b[?2004h> "]
[173.802853, "o", "openssl crl2pkcs7 -nocrl -certfile \"$CHAIN_FILE\" | openssl pkcs7 -print_certs -outform PEM -out \"$TMP_DIR/signing_cert.pem\" 2>/dev/null\r\n\u001b[?2004l\r"]
[173.802873, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[173.802891, "o", "> "]
[173.802946, "o", "# Verify the signing cert against the CA chain (intermediate + root)\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.802967, "o", "> "]
[173.803007, "o", "# First verify intermediate is signed by root\r\n\u001b[?2004l\r"]
[173.803025, "o", "\u001b[?2004h> "]
[173.803108, "o", "if ! openssl verify -CAfile /app/ca/root-ca.pem /app/ca/intermediate-ca.pem > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[173.803126, "o", "\u001b[?2004h> "]
[173.80315, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r"]
[173.803173, "o", "\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r"]
[173.80319, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.803206, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.803276, "o", "# Verify signing cert is signed by intermediate (which is signed by root)\r\n\u001b[?2004l\r"]
[173.803293, "o", "\u001b[?2004h> "]
[173.80334, "o", "# Use the intermediate CA as the CAfile for verification\r\n\u001b[?2004l\r"]
[173.803357, "o", "\u001b[?2004h> "]
[173.803475, "o", "if ! openssl verify -CAfile /app/ca/intermediate-ca.pem -untrusted /app/ca/root-ca.pem \"$TMP_DIR/signing_cert.pem\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[173.803492, "o", "\u001b[?2004h> "]
[173.803522, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r"]
[173.803539, "o", "\u001b[?2004h> "]
[173.803555, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.803572, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.803589, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.803636, "o", "# Check certificate validity (not expired)\r\n\u001b[?2004l\r"]
[173.803653, "o", "\u001b[?2004h> "]
[173.803732, "o", "if ! openssl x509 -in \"$TMP_DIR/signing_cert.pem\" -noout -checkend 0 2>/dev/null; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.803751, "o", "> "]
[173.803773, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r"]
[173.803793, "o", "\u001b[?2004h>     exit 1\r\n"]
[173.803811, "o", "\u001b[?2004l\r\u001b[?2004h> fi"]
[173.803832, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.80385, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.803879, "o", "echo \"Certificate chain valid.\"\r\n\u001b[?2004l\r"]
[173.803897, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[173.803915, "o", "> "]
[173.803957, "o", "# Step 3: Extract public key from signing certificate\r\n\u001b[?2004l\r"]
[173.80398, "o", "\u001b[?2004h> "]
[173.80403, "o", "echo \"Extracting public key from signing certificate...\"\r\n\u001b[?2004l\r"]
[173.804048, "o", "\u001b[?2004h> "]
[173.804119, "o", "openssl x509 -in \"$TMP_DIR/signing_cert.pem\" -pubkey -noout > \"$TMP_DIR/pubkey.pem\"\r\n\u001b[?2004l\r"]
[173.804142, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[173.804152, "o", "> "]
[173.804186, "o", "# Step 4: Verify artifact signature\r\n\u001b[?2004l\r"]
[173.804203, "o", "\u001b[?2004h> "]
[173.804235, "o", "echo \"Verifying artifact signature...\"\r\n\u001b[?2004l\r"]
[173.804253, "o", "\u001b[?2004h> "]
[173.804356, "o", "if ! openssl dgst -sha256 -verify \"$TMP_DIR/pubkey.pem\" -signature \"$SIG_FILE\" \"$ARTIFACT_PATH\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.804381, "o", "> "]
[173.804402, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.804423, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.804446, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.804457, "o", "> "]
[173.804494, "o", "echo \"Artifact signature verified.\"\r\n\u001b[?2004l\r"]
[173.804521, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.804544, "o", "# Step 5: Verify provenance signature\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.804566, "o", "> "]
[173.80463, "o", "echo \"Verifying provenance signature...\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.804726, "o", "if ! openssl dgst -sha256 -verify \"$TMP_DIR/pubkey.pem\" -signature \"$PROVENANCE_SIG\" \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.804757, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r"]
[173.804786, "o", "\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.804804, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.80485, "o", "echo \"Provenance signature verified.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.804879, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.804911, "o", "# Step 6: Validate provenance content\r\n\u001b[?2004l\r"]
[173.804937, "o", "\u001b[?2004h> "]
[173.804971, "o", "echo \"Validating provenance content...\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[173.804989, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[173.805024, "o", "# Check required fields exist\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.805086, "o", "if ! jq -e '.buildID' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[173.805105, "o", "\u001b[?2004h> "]
[173.805138, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.805164, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
[173.805185, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[173.805198, "o", "> "]
[173.805258, "o", "if ! jq -e '.artifact' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.805288, "o", ">     echo \"VERIFICATION_FAILED\"\r\n"]
[173.805316, "o", "\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r"]
[173.805332, "o", "\u001b[?2004h> fi\r\n"]
[173.805346, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[173.805364, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.805429, "o", "if ! jq -e '.sha256' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[173.805458, "o", "\u001b[?2004h>     echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r"]
[173.805475, "o", "\u001b[?2004h> "]
[173.805506, "o", "    exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.805523, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[173.80556, "o", "> "]
[173.80559, "o", "if ! jq -e '.signedAt' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[173.805607, "o", "\u001b[?2004h> "]
[173.805649, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n\u001b[?2004l\r"]
[173.805665, "o", "\u001b[?2004h> fi\r\n"]
[173.80568, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[173.805694, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[173.805761, "o", "if ! jq -e '.signer' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[173.805788, "o", "\u001b[?2004h> "]
[173.805805, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.805818, "o", "    exit 1\r\n\u001b[?2004l\r"]
[173.80586, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.805928, "o", "if ! jq -e '.certificateChain' \"$PROVENANCE_JSON\" > /dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[173.805945, "o", "\u001b[?2004h> "]
[173.805985, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.806002, "o", "    exit 1\r\n\u001b[?2004l\r"]
[173.806085, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
[173.806122, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify artifact name matches\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.806157, "o", "PROVENANCE_ARTIFACT=$(jq -r '.artifact' \"$PROVENANCE_JSON\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.806207, "o", "if [ \"$PROVENANCE_ARTIFACT\" != \"$ARTIFACT_NAME\" ]; then\r\n\u001b[?2004l\r"]
[173.806223, "o", "\u001b[?2004h> "]
[173.806259, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.806276, "o", "    exit 1\r\n\u001b[?2004l\r"]
[173.80629, "o", "\u001b[?2004h> fi\r\n"]
[173.806331, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.806362, "o", "# Verify SHA256 checksum\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.806393, "o", "> "]
[173.806423, "o", "ACTUAL_SHA256=$(sha256sum \"$ARTIFACT_PATH\" | awk '{print $1}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.806477, "o", "PROVENANCE_SHA256=$(jq -r '.sha256' \"$PROVENANCE_JSON\")\r\n\u001b[?2004l\r"]
[173.806506, "o", "\u001b[?2004h> "]
[173.806537, "o", "if [ \"$ACTUAL_SHA256\" != \"$PROVENANCE_SHA256\" ]; then\r\n\u001b[?2004l\r"]
[173.806554, "o", "\u001b[?2004h> "]
[173.80659, "o", "    echo \"VERIFICATION_FAILED\"\r\n\u001b[?2004l\r\u001b[?2004h>     exit 1\r\n"]
[173.806607, "o", "\u001b[?2004l\r\u001b[?2004h> fi"]
[173.806624, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[173.80664, "o", "\u001b[?2004h> "]
[173.806692, "o", "echo \"Provenance content validated.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.806724, "o", "echo \"Artifact SHA256: $ACTUAL_SHA256\"\r\n\u001b[?2004l\r"]
[173.80674, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[173.806754, "o", "> echo \"\""]
[173.806768, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.806819, "o", "echo \"VERIFICATION_PASSED\"\r\n\u001b[?2004l\r\u001b[?2004h> exit 0\r\n"]
[173.806835, "o", "\u001b[?2004l\r\u001b[?2004h> EOF"]
[173.80685, "o", "\r\n\u001b[?2004l\r"]
[173.807945, "o", "\u001b[?2004hroot@2928fe68ba2e:/app# "]
[173.807983, "o", "chmod +x /app/verify_artifact.sh\r\n\u001b[?2004l\r"]
[173.808725, "o", "\u001b[?2004hroot@2928fe68ba2e:/app# "]
