[52.136626, "i", "cat > /app/simulate.py << 'EOF'\nimport numpy as np\nimport csv\n\n# Physical parameters\nm = 2000.0  # kg (lumped mass at each floor)\nk = 400000.0  # N/m (shear stiffness between floors)\nzeta = 0.02  # 2% damping ratio\n\n# Number of stories (DOFs)\nn = 3\n\n# Mass matrix (diagonal)\nM = np.diag([m, m, m])\n\n# Stiffness matrix for 3-story shear building\n# K = [[2k, -k, 0], [-k, 2k, -k], [0, -k, k]]\nK = np.array([\n    [2*k, -k, 0],\n    [-k, 2*k, -k],\n    [0, -k, k]\n])\n\n# Read ground motion data\ntime_data = []\naccel_g_data = []  # in G-force\n\nwith open('/app/data/ground_motion.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        time_data.append(float(row['time']))\n        accel_g_data.append(float(row['accel_g']))\n\ntime_data = np.array(time_data)\naccel_g_data = np.array(accel_g_data)\ndt = time_data[1] - time_data[0]  # Time step\n\n# Convert ground acceleration from G to m/s^2\ng = 9.81  # m/s^2\naccel_data = accel_g_data * g  # in m/s^2\n\n# Rayleigh damping: C = alpha*M + beta*K\n# Need to find alpha"]
[52.136776, "i", " and beta such that damping ratio = 2% for mode 1 and mode 3\n# Solve: 1/2 * (alpha/omega_i + beta*omega_i) = zeta for i=1,3\n\n# Eigenvalue problem: (K - omega^2*M)*phi = 0\n# Solve generalized eigenvalue problem K*phi = omega^2*M*phi\neigenvalues, eigenvectors = np.linalg.eig(np.linalg.inv(M) @ K)\n\n# Get natural frequencies (square root of eigenvalues)\nnatural_freqs_sq = eigenvalues\nnatural_freqs = np.sqrt(natural_freqs_sq)\n\n# Sort by frequency\nidx = np.argsort(natural_freqs)\nnatural_freqs = natural_freqs[idx]\n\nomega1 = natural_freqs[0]  # 1st mode frequency\nomega3 = natural_freqs[2]  # 3rd mode frequency\n\nprint(f\"Natural frequencies (rad/s): {natural_freqs}\")\nprint(f\"1st mode omega: {omega1}\")\nprint(f\"3rd mode omega: {omega3}\")\n\n# Solve for alpha and beta\n# System: [1/omega1, omega1] [alpha] = [2*zeta]\n#         [1/omega3, omega3] [beta]  = [2*zeta]\nA = np.array([[1/omega1, omega1], [1/omega3, omega3]])\nb = np.array([2*zeta, 2*zeta])\nalpha, beta = np.linalg.solve(A, b)\n\nprint(f\"Rayleigh damping coefficients: al"]
[52.136802, "o", "cat > /app/simulate.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r"]
[52.136817, "i", "pha={alpha}, beta={beta}\")\n\n# Damping matrix\nC = alpha * M + beta * K\n\nprint(f\"Mass matrix:\\n{M}\")\nprint(f\"Stiffness matrix:\\n{K}\")\nprint(f\"Damping matrix:\\n{C}\")\n\n# Newmark-Beta parameters (Average Acceleration Method)\ngamma = 0.5\nbeta_newmark = 0.25\n\n# Integration constants\na0 = 1.0 / (beta_newmark * dt**2)\na1 = gamma / (beta_newmark * dt)\na2 = 1.0 / (beta_newmark * dt)\na3 = 1.0 / (2*beta_newmark) - 1\na4 = gamma / beta_newmark - 1\na5 = dt * (gamma / (2*beta_newmark) - 1)\n\nprint(f\"\\nNewmark constants: a0={a0}, a1={a1}, a2={a2}, a3={a3}, a4={a4}, a5={a5}\")\n\n# Effective stiffness matrix\nK_eff = K + a0 * M + a1 * C\n\n# Influence vector\niota = np.array([1.0, 1.0, 1.0])\n\n# Initialize response arrays\nn_steps = len(time_data)\nu = np.zeros((n_steps, 3))  # Displacement\nv = np.zeros((n_steps, 3))  # Velocity\na = np.zeros((n_steps, 3))  # Acceleration\n\n# Initial conditions\nu[0] = 0.0\nv[0] = 0.0\n# Initial acceleration: M*a0 = -M*iota*accel_data[0] - C*v0 - K*u0\na[0] = -iota * accel_data[0]\n\n# Time stepping\nfor i in rang"]
[52.136841, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.136847, "i", "e(n_steps - 1):\n    # Effective load at t+dt\n    # P_eff = -M*iota*accel(t+dt) + M*(a0*u_t + a2*v_t + a3*a_t) + C*(a1*u_t + a4*v_t + a5*a_t)\n    P_eff = -M @ (iota * accel_data[i+1]) + \\\n            M @ (a0 * u[i] + a2 * v[i] + a3 * a[i]) + \\\n            C @ (a1 * u[i] + a4 * v[i] + a5 * a[i])\n    \n    # Solve for displacement\n    u[i+1] = np.linalg.solve(K_eff, P_eff)\n    \n    # Update acceleration and velocity\n    a[i+1] = a0 * (u[i+1] - u[i]) - a2 * v[i] - a3 * a[i]\n    v[i+1] = v[i] + dt * ((1 - gamma) * a[i] + gamma * a[i+1])\n\n# Write output\nwith open('/app/output/response.csv', 'w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerow(['time', 'u1', 'u2', 'u3'])\n    for i in range(n_steps):\n        writer.writerow([f'{time_data[i]:.3f}', f'{u[i,0]:.6f}', f'{u[i,1]:.6f}', f'{u[i,2]:.6f}'])\n\nprint(f\"\\nSimulation complete. Output written to /app/output/response.csv\")\nprint(f\"Max displacements: u1={np.max(np.abs(u[:,0])):.6f}, u2={np.max(np.abs(u[:,1])):.6f}, u3={np.max(np.abs(u[:,2])):.6f}\")\nEO"]
