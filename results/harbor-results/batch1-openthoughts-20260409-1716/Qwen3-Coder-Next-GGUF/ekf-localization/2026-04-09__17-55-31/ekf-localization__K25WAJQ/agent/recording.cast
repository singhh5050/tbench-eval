[52.140509, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.140519, "o", "\u001b[?2004h"]
[52.140532, "o", "> "]
[52.140606, "o", "print(f\"\\nNewmark constants: a0={a0}, a1={a1}, a2={a2}, a3={a3}, a4={a4}, a5={a5}\")\r\n\u001b[?2004l\r"]
[52.140618, "o", "\u001b[?2004h> \r\n"]
[52.140629, "o", "\u001b[?2004l\r\u001b[?2004h"]
[52.14064, "o", "> "]
[52.14067, "o", "# Effective stiffness matrix\r\n\u001b[?2004l\r"]
[52.140683, "o", "\u001b[?2004h> "]
[52.140712, "o", "K_eff = K + a0 * M + a1 * C\r\n\u001b[?2004l\r"]
[52.140723, "o", "\u001b[?2004h> \r\n"]
[52.140734, "o", "\u001b[?2004l\r\u001b[?2004h"]
[52.140747, "o", "> "]
[52.140766, "o", "# Influence vector\r\n\u001b[?2004l\r"]
[52.140779, "o", "\u001b[?2004h> "]
[52.140813, "o", "iota = np.array([1.0, 1.0, 1.0])\r\n\u001b[?2004l\r"]
[52.140824, "o", "\u001b[?2004h> \r\n"]
[52.140836, "o", "\u001b[?2004l\r\u001b[?2004h"]
[52.140848, "o", "> "]
[52.140875, "o", "# Initialize response arrays\r\n\u001b[?2004l\r"]
[52.140888, "o", "\u001b[?2004h> "]
[52.140917, "o", "n_steps = len(time_data)\r\n\u001b[?2004l\r"]
[52.140928, "o", "\u001b[?2004h> "]
[52.140972, "o", "u = np.zeros((n_steps, 3))  # Displacement\r\n\u001b[?2004l\r"]
[52.140985, "o", "\u001b[?2004h> "]
[52.141031, "o", "v = np.zeros((n_steps, 3))  # Velocity\r\n\u001b[?2004l\r"]
[52.141043, "o", "\u001b[?2004h> "]
[52.141085, "o", "a = np.zeros((n_steps, 3))  # Acceleration\r\n\u001b[?2004l\r"]
[52.141098, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.141109, "o", "\u001b[?2004h> "]
[52.141138, "o", "# Initial conditions\r\n\u001b[?2004l\r"]
[52.141149, "o", "\u001b[?2004h> "]
[52.141164, "o", "u[0] = 0.0\r\n\u001b[?2004l\r"]
[52.141176, "o", "\u001b[?2004h> "]
[52.141193, "o", "v[0] = 0.0\r\n\u001b[?2004l\r"]
[52.141206, "o", "\u001b[?2004h> "]
[52.141271, "o", "# Initial acceleration: M*a0 = -M*iota*accel_data[0] - C*v0 - K*u0\r\n\u001b[?2004l\r"]
[52.141282, "o", "\u001b[?2004h> "]
[52.141315, "o", "a[0] = -iota * accel_data[0]\r\n\u001b[?2004l\r"]
[52.141326, "o", "\u001b[?2004h> "]
[52.14134, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.141364, "o", "# Time stepping\r\n\u001b[?2004l\r"]
[52.141377, "o", "\u001b[?2004h> "]
[52.141407, "o", "for i in range(n_steps - 1):\r\n\u001b[?2004l\r"]
[52.141418, "o", "\u001b[?2004h> "]
[52.141451, "o", "    # Effective load at t+dt\r\n\u001b[?2004l\r"]
[52.141464, "o", "\u001b[?2004h> "]
[52.141551, "o", "    # P_eff = -M*iota*accel(t+dt) + M*(a0*u_t + a2*v_t + a3*a_t) + C*(a1*u_t + a4*v_t + a5*a_t)\r\n\u001b[?2004l\r"]
[52.141566, "o", "\u001b[?2004h> "]
[52.141611, "o", "    P_eff = -M @ (iota * accel_data[i+1]) + \\\r\n\u001b[?2004l\r"]
[52.141622, "o", "\u001b[?2004h> "]
[52.141678, "o", "            M @ (a0 * u[i] + a2 * v[i] + a3 * a[i]) + \\\r\n\u001b[?2004l\r"]
[52.141691, "o", "\u001b[?2004h> "]
[52.141741, "o", "            C @ (a1 * u[i] + a4 * v[i] + a5 * a[i])\r\n\u001b[?2004l\r"]
[52.141752, "o", "\u001b[?2004h"]
[52.141764, "o", ">     \r\n"]
[52.141775, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[52.141804, "o", "    # Solve for displacement\r\n\u001b[?2004l\r"]
[52.141815, "o", "\u001b[?2004h> "]
[52.141873, "o", "    u[i+1] = np.linalg.solve(K_eff, P_eff)\r\n\u001b[?2004l\r"]
[52.141894, "o", "\u001b[?2004h> "]
[52.141906, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.141917, "o", "> "]
[52.14194, "o", "    # Update acceleration and velocity\r\n\u001b[?2004l\r"]
[52.141951, "o", "\u001b[?2004h> "]
[52.141987, "o", "    a[i+1] = a0 * (u[i+1] - u[i]) - a2 * v[i] - a3 * a[i]\r\n\u001b[?2004l\r"]
[52.142, "o", "\u001b[?2004h> "]
[52.142045, "o", "    v[i+1] = v[i] + dt * ((1 - gamma) * a[i] + gamma * a[i+1])\r\n\u001b[?2004l\r"]
[52.142062, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.142076, "o", "\u001b[?2004h> # Write output"]
[52.14209, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.142122, "o", "with open('/app/output/response.csv', 'w', newline='') as f:\r\n\u001b[?2004l\r"]
[52.142136, "o", "\u001b[?2004h> "]
[52.142149, "o", "    writer = csv.writer(f)\r\n\u001b[?2004l\r"]
[52.142164, "o", "\u001b[?2004h> "]
[52.142195, "o", "    writer.writerow(['time', 'u1', 'u2', 'u3'])\r\n\u001b[?2004l\r"]
[52.142206, "o", "\u001b[?2004h> "]
[52.142224, "o", "    for i in range(n_steps):\r\n\u001b[?2004l\r"]
[52.142236, "o", "\u001b[?2004h> "]
[52.142296, "o", "        writer.writerow([f'{time_data[i]:.3f}', f'{u[i,0]:.6f}', f'{u[i,1]:.6f}', f'{u[i,2]:.6f}'])\r\n\u001b[?2004l\r"]
[52.142308, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.142363, "o", "print(f\"\\nSimulation complete. Output written to /app/output/response.csv\")\r\n\u001b[?2004l\r"]
[52.142377, "o", "\u001b[?2004h> "]
[52.142457, "o", "print(f\"Max displacements: u1={np.max(np.abs(u[:,0])):.6f}, u2={np.max(np.abs(u[:,1])):.6f}, u3={np.max(np.abs(u[:,2])):.6f}\")\r\n\u001b[?2004l\r"]
[52.14247, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[52.145533, "o", "\u001b[?2004hroot@aa803a54905b:/app# "]
[53.142263, "i", "python3 /app/simulate.py\n"]
[53.142462, "o", "python3 /app/simulate.py\r\n\u001b[?2004l\r"]
[53.449283, "o", "Natural frequencies (rad/s): [ 6.29384245 17.63495468 25.48324785]\r\n1st mode omega: 6.293842454258952\r\n3rd mode omega: 25.48324784527069\r\nRayleigh damping coefficients: alpha=0.2018907906912316, beta=0.0012587684908517906\r\n"]
[53.449336, "o", "Mass matrix:\r\n[[2000.    0.    0.]\r\n [   0. 2000.    0.]\r\n [   0.    0. 2000.]]\r\n"]
[53.449392, "o", "Stiffness matrix:\r\n[[ 800000. -400000.       0.]\r\n [-400000.  800000. -400000.]\r\n [      0. -400000.  400000.]]\r\n"]
[53.449442, "o", "Damping matrix:\r\n[[1410.79637406 -503.50739634    0.        ]\r\n [-503.50739634 1410.79637406 -503.50739634]\r\n [   0.         -503.50739634  907.28897772]]\r\n"]
[53.449498, "o", "\r\nNewmark constants: a0=10000.0, a1=100.0, a2=200.0, a3=1.0, a4=1.0, a5=0.0\r\n"]
[53.473093, "o", "\r\nSimulation complete. Output written to /app/output/response.csv\r\n"]
[53.473118, "o", "Max displacements: u1=0.074816, u2=0.133214, u3=0.171159\r\n"]
[53.484171, "o", "\u001b[?2004h"]
[53.484182, "o", "root@aa803a54905b:/app# "]
