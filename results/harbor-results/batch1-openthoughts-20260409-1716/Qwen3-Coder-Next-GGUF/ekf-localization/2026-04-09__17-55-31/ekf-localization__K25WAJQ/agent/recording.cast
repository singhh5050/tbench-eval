[108.283454, "i", "python3 -c \"\nimport numpy as np\n\n# Verify integration constants\ndt = 0.02\ngamma = 0.5\nbeta = 0.25\n\na0 = 1.0 / (beta * dt**2)\na1 = gamma / (beta * dt)\na2 = 1.0 / (beta * dt)\na3 = 1.0 / (2*beta) - 1\na4 = gamma / beta - 1\na5 = dt * (gamma / (2*beta) - 1)\n\nprint('a0 =', a0, '(expected: 1/(0.25*0.02^2) = 10000)')\nprint('a1 =', a1, '(expected: 0.5/(0.25*0.02) = 100)')\nprint('a2 =', a2, '(expected: 1/(0.25*0.02) = 200)')\nprint('a3 =', a3, '(expected: 1/(2*0.25) - 1 = 1.0)')\nprint('a4 =', a4, '(expected: 0.5/0.25 - 1 = 1.0)')\nprint('a5 =', a5, '(expected: 0.02*(0.5/(2*0.25) - 1) = 0.0)')\n\"\n"]
[108.283613, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r"]
[108.283642, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Verify integration constants\r\n\u001b[?2004l\r"]
[108.283664, "o", "\u001b[?2004h> dt = 0.02\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.283686, "o", "> gamma = 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.283708, "o", "beta = 0.25\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.283729, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.283758, "o", "a0 = 1.0 / (beta * dt**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.283787, "o", "a1 = gamma / (beta * dt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.283818, "o", "a2 = 1.0 / (beta * dt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.283834, "o", "> "]
[108.283853, "o", "a3 = 1.0 / (2*beta) - 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.283876, "o", "a4 = gamma / beta - 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.283895, "o", "> "]
[108.283916, "o", "a5 = dt * (gamma / (2*beta) - 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.283936, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.283984, "o", "print('a0 =', a0, '(expected: 1/(0.25*0.02^2) = 10000)')\r\n\u001b[?2004l\r"]
[108.284003, "o", "\u001b[?2004h> "]
[108.284052, "o", "print('a1 =', a1, '(expected: 0.5/(0.25*0.02) = 100)')\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.28407, "o", "> "]
[108.284107, "o", "print('a2 =', a2, '(expected: 1/(0.25*0.02) = 200)')\r\n\u001b[?2004l\r"]
[108.284127, "o", "\u001b[?2004h> "]
[108.284162, "o", "print('a3 =', a3, '(expected: 1/(2*0.25) - 1 = 1.0)')\r\n\u001b[?2004l\r"]
[108.28418, "o", "\u001b[?2004h> "]
[108.284226, "o", "print('a4 =', a4, '(expected: 0.5/0.25 - 1 = 1.0)')\r\n\u001b[?2004l\r"]
[108.284241, "o", "\u001b[?2004h> "]
[108.284293, "o", "print('a5 =', a5, '(expected: 0.02*(0.5/(2*0.25) - 1) = 0.0)')\r\n\u001b[?2004l\r"]
[108.284305, "o", "\u001b[?2004h> \"\r\n"]
[108.284317, "o", "\u001b[?2004l\r"]
[108.64321, "o", "a0 = 10000.0 (expected: 1/(0.25*0.02^2) = 10000)\r\na1 = 100.0 (expected: 0.5/(0.25*0.02) = 100)\r\na2 = 200.0 (expected: 1/(0.25*0.02) = 200)\r\na3 = 1.0 (expected: 1/(2*0.25) - 1 = 1.0)\r\na4 = 1.0 (expected: 0.5/0.25 - 1 = 1.0)\r\na5 = 0.0 (expected: 0.02*(0.5/(2*0.25) - 1) = 0.0)\r\n"]
[108.652296, "o", "\u001b[?2004hroot@aa803a54905b:/app# "]
[121.452053, "i", "cat /app/simulate.py | grep -A 20 'Time stepping'\n"]
[121.452263, "o", "cat /app/simulate.py | grep -A 20 'Time stepping'\r\n\u001b[?2004l\r"]
[121.453275, "o", "# Time stepping\r\nfor i in range(n_steps - 1):\r\n    # Effective load at t+dt\r\n    # P_eff = -M*iota*accel(t+dt) + M*(a0*u_t + a2*v_t + a3*a_t) + C*(a1*u_t + a4*v_t + a5*a_t)\r\n    P_eff = -M @ (iota * accel_data[i+1]) + \\\r\n            M @ (a0 * u[i] + a2 * v[i] + a3 * a[i]) + \\\r\n            C @ (a1 * u[i] + a4 * v[i] + a5 * a[i])\r\n    \r\n    # Solve for displacement\r\n    u[i+1] = np.linalg.solve(K_eff, P_eff)\r\n    "]
[121.453319, "o", "\r\n    # Update acceleration and velocity\r\n    a[i+1] = a0 * (u[i+1] - u[i]) - a2 * v[i] - a3 * a[i]\r\n    v[i+1] = v[i] + dt * ((1 - gamma) * a[i] + gamma * a[i+1])\r\n\r\n# Write output\r\nwith open('/app/output/response.csv', 'w', newline='') as f:\r\n    writer = csv.writer(f)\r\n    writer.writerow(['time', 'u1', 'u2', 'u3'])\r\n    for i in range(n_steps):\r\n        writer.writerow([f'{time_data[i]:.3f}', f'{u[i,0]:.6f}', f'{u[i,1]:.6f}', f'{u[i,2]:.6f}'])\r\n"]
[121.453481, "o", "\u001b[?2004hroot@aa803a54905b:/app# "]
[133.104656, "i", "ls -la /app/output/ && head -3 /app/output/response.csv && tail -3 /app/output/response.csv\n"]
