[89.654193, "o", "...\r\n"]
[89.654727, "o", "19.920,-0.004293,-0.007928,-0.010081\r\r\n19.940,-0.003898,-0.007009,-0.008715\r\r\n19.960,-0.003441,-0.005983,-0.007221\r\r\n19.980,-0.002915,-0.004858,-0.005636\r\r\n20.000,-0.002315,-0.003647,-0.003997\r\r\n"]
