[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Verify integration constants
[?2004l[?2004h> dt = 0.02
[?2004l[?2004h> gamma = 0.5
[?2004l[?2004h> beta = 0.25
[?2004l[?2004h> 
[?2004l[?2004h> a0 = 1.0 / (beta * dt**2)
[?2004l[?2004h> a1 = gamma / (beta * dt)
[?2004l[?2004h> a2 = 1.0 / (beta * dt)
