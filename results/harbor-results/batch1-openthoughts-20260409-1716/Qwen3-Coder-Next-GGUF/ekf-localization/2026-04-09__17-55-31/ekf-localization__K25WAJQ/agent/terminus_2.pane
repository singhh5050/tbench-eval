[?2004l[?2004h> print('a0 =', a0, '(expected: 1/(0.25*0.02^2) = 10000)')
[?2004l[?2004h> print('a1 =', a1, '(expected: 0.5/(0.25*0.02) = 100)')
[?2004l[?2004h> print('a2 =', a2, '(expected: 1/(0.25*0.02) = 200)')
[?2004l[?2004h> print('a3 =', a3, '(expected: 1/(2*0.25) - 1 = 1.0)')
[?2004l[?2004h> print('a4 =', a4, '(expected: 0.5/0.25 - 1 = 1.0)')
