[?2004hroot@aa803a54905b:/app# cat > /app/simulate.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import csv
[?2004l[?2004h> 
[?2004l[?2004h> # Physical parameters
[?2004l[?2004h> m = 2000.0  # kg (lumped mass at each floor)
[?2004l[?2004h> k = 400000.0  # N/m (shear stiffness between floors)
[?2004l[?2004h> zeta = 0.02  # 2% damping ratio
[?2004l[?2004h> 
[?2004l[?2004h> # Number of stories (DOFs)
[?2004l[?2004h> n = 3
[?2004l[?2004h> 
[?2004l[?2004h> # Mass matrix (diagonal)
[?2004l[?2004h> M = np.diag([m, m, m])
[?2004l[?2004h> 
[?2004l[?2004h> # Stiffness matrix for 3-story shear building
[?2004l[?2004h> # K = [[2k, -k, 0], [-k, 2k, -k], [0, -k, k]]
[?2004l[?2004h> K = np.array([
[?2004l[?2004h>     [2*k, -k, 0],
[?2004l[?2004h>     [-k, 2*k, -k],
[?2004l[?2004h>     [0, -k, k]
[?2004l[?2004h> ])
[?2004l[?2004h> 
[?2004l[?2004h> # Read ground motion data
[?2004l[?2004h> time_data = []
[?2004l[?2004h> accel_g_data = []  # in G-force
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/data/ground_motion.csv', 'r') as f:
[?2004l[?2004h>     reader = csv.DictReader(f)
[?2004l[?2004h>     for row in reader:
[?2004l[?2004h>         time_data.append(float(row['time']))
[?2004l[?2004h>         accel_g_data.append(float(row['accel_g']))
[?2004l[?2004h> 
[?2004l[?2004h> time_data = np.array(time_data)
[?2004l[?2004h> accel_g_data = np.array(accel_g_data)
[?2004l[?2004h> dt = time_data[1] - time_data[0]  # Time step
[?2004l[?2004h> 
[?2004l[?2004h> # Convert ground acceleration from G to m/s^2
[?2004l[?2004h> g = 9.81  # m/s^2
[?2004l[?2004h> accel_data = accel_g_data * g  # in m/s^2
[?2004l[?2004h> 
[?2004l[?2004h> # Rayleigh damping: C = alpha*M + beta*K
[?2004l[?2004h> # Need to find alpha and beta such that damping ratio = 2% for mode 1 and mode 3
[?2004l[?2004h> # Solve: 1/2 * (alpha/omega_i + beta*omega_i) = zeta for i=1,3
[?2004l[?2004h> 
[?2004l[?2004h> # Eigenvalue problem: (K - omega^2*M)*phi = 0
[?2004l[?2004h> # Solve generalized eigenvalue problem K*phi = omega^2*M*phi
[?2004l[?2004h> eigenvalues, eigenvectors = np.linalg.eig(np.linalg.inv(M) @ K)
[?2004l[?2004h> 
[?2004l[?2004h> # Get natural frequencies (square root of eigenvalues)
[?2004l[?2004h> natural_freqs_sq = eigenvalues
[?2004l[?2004h> natural_freqs = np.sqrt(natural_freqs_sq)
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by frequency
[?2004l[?2004h> idx = np.argsort(natural_freqs)
[?2004l[?2004h> natural_freqs = natural_freqs[idx]
[?2004l[?2004h> 
[?2004l[?2004h> omega1 = natural_freqs[0]  # 1st mode frequency
[?2004l[?2004h> omega3 = natural_freqs[2]  # 3rd mode frequency
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Natural frequencies (rad/s): {natural_freqs}")
[?2004l[?2004h> print(f"1st mode omega: {omega1}")
[?2004l[?2004h> print(f"3rd mode omega: {omega3}")
[?2004l[?2004h> 
[?2004l[?2004h> # Solve for alpha and beta
[?2004l[?2004h> # System: [1/omega1, omega1] [alpha] = [2*zeta]
[?2004l[?2004h> #         [1/omega3, omega3] [beta]  = [2*zeta]
[?2004l[?2004h> A = np.array([[1/omega1, omega1], [1/omega3, omega3]])
[?2004l[?2004h> b = np.array([2*zeta, 2*zeta])
[?2004l[?2004h> alpha, beta = np.linalg.solve(A, b)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Rayleigh damping coefficients: alpha={alpha}, beta={beta}")
[?2004l[?2004h> 
[?2004l[?2004h> # Damping matrix
[?2004l[?2004h> C = alpha * M + beta * K
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Mass matrix:\n{M}")
[?2004l[?2004h> print(f"Stiffness matrix:\n{K}")
[?2004l[?2004h> print(f"Damping matrix:\n{C}")
[?2004l[?2004h> 
[?2004l[?2004h> # Newmark-Beta parameters (Average Acceleration Method)
[?2004l[?2004h> gamma = 0.5
[?2004l[?2004h> beta_newmark = 0.25
[?2004l[?2004h> 
[?2004l[?2004h> # Integration constants
[?2004l[?2004h> a0 = 1.0 / (beta_newmark * dt**2)
[?2004l[?2004h> a1 = gamma / (beta_newmark * dt)
[?2004l[?2004h> a2 = 1.0 / (beta_newmark * dt)
[?2004l[?2004h> a3 = 1.0 / (2*beta_newmark) - 1
[?2004l[?2004h> a4 = gamma / beta_newmark - 1
[?2004l[?2004h> a5 = dt * (gamma / (2*beta_newmark) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nNewmark constants: a0={a0}, a1={a1}, a2={a2}, a3={a3}, a4={a4}, a5={a5}")
[?2004l[?2004h> 
[?2004l[?2004h> # Effective stiffness matrix
[?2004l[?2004h> K_eff = K + a0 * M + a1 * C
[?2004l[?2004h> 
[?2004l[?2004h> # Influence vector
[?2004l[?2004h> iota = np.array([1.0, 1.0, 1.0])
[?2004l[?2004h> 
[?2004l[?2004h> # Initialize response arrays
[?2004l[?2004h> n_steps = len(time_data)
[?2004l[?2004h> u = np.zeros((n_steps, 3))  # Displacement
[?2004l[?2004h> v = np.zeros((n_steps, 3))  # Velocity
[?2004l[?2004h> a = np.zeros((n_steps, 3))  # Acceleration
[?2004l[?2004h> 
[?2004l[?2004h> # Initial conditions
[?2004l[?2004h> u[0] = 0.0
[?2004l[?2004h> v[0] = 0.0
[?2004l[?2004h> # Initial acceleration: M*a0 = -M*iota*accel_data[0] - C*v0 - K*u0
[?2004l[?2004h> a[0] = -iota * accel_data[0]
[?2004l[?2004h> 
[?2004l[?2004h> # Time stepping
[?2004l[?2004h> for i in range(n_steps - 1):
[?2004l[?2004h>     # Effective load at t+dt
[?2004l[?2004h>     # P_eff = -M*iota*accel(t+dt) + M*(a0*u_t + a2*v_t + a3*a_t) + C*(a1*u_t + a4*v_t + a5*a_t)
[?2004l[?2004h>     P_eff = -M @ (iota * accel_data[i+1]) + \
[?2004l[?2004h>             M @ (a0 * u[i] + a2 * v[i] + a3 * a[i]) + \
[?2004l[?2004h>             C @ (a1 * u[i] + a4 * v[i] + a5 * a[i])
[?2004l[?2004h>     
[?2004l[?2004h>     # Solve for displacement
[?2004l[?2004h>     u[i+1] = np.linalg.solve(K_eff, P_eff)
[?2004l[?2004h>     
[?2004l[?2004h>     # Update acceleration and velocity
[?2004l[?2004h>     a[i+1] = a0 * (u[i+1] - u[i]) - a2 * v[i] - a3 * a[i]
[?2004l[?2004h>     v[i+1] = v[i] + dt * ((1 - gamma) * a[i] + gamma * a[i+1])
[?2004l[?2004h> 
[?2004l[?2004h> # Write output
[?2004l[?2004h> with open('/app/output/response.csv', 'w', newline='') as f:
[?2004l[?2004h>     writer = csv.writer(f)
[?2004l[?2004h>     writer.writerow(['time', 'u1', 'u2', 'u3'])
[?2004l[?2004h>     for i in range(n_steps):
[?2004l[?2004h>         writer.writerow([f'{time_data[i]:.3f}', f'{u[i,0]:.6f}', f'{u[i,1]:.6f}', f'{u[i,2]:.6f}'])
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nSimulation complete. Output written to /app/output/response.csv")
[?2004l[?2004h> print(f"Max displacements: u1={np.max(np.abs(u[:,0])):.6f}, u2={np.max(np.abs(u[:,1])):.6f}, u3={np.max(np.abs(u[:,2])):.6f}")
[?2004l[?2004h> EOF
