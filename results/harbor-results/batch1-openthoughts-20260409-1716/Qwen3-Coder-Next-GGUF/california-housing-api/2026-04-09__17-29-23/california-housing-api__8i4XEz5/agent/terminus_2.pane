[?2004hroot@ec00c077f56c:/app# cat > train_models.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> import pickle
[?2004l[?2004h> import os
[?2004l[?2004h> from sklearn.model_selection import train_test_split
[?2004l[?2004h> from sklearn.linear_model import LinearRegression, Ridge
[?2004l[?2004h> from sklearn.ensemble import RandomForestRegressor
[?2004l[?2004h> from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: Load data
[?2004ltr[?2004h> print("Loading data...")
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> print(f"Training data shape: {train_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Split data
[?2004l[?2004h> X = train_df.drop('target', axis=1)
[?2004l[?2004h> y = train_df['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Reset index before split
[?2004l[?2004h> X = X.reset_index(drop=True)
[?2004l[?2004h> y = y.reset_index(drop=True)
[?2004l[?2004h> 
[?2004l[?2004h> X_train, X_val, y_train, y_val = train_test_split(
[?2004l[?2004h>     X, y, test_size=0.2, random_state=42
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Save split info
[?2004l[?2004h> split_info = {
[?2004l[?2004h>     "train_size": len(X_train),
[?2004l[?2004h>     "validation_size": len(X_val),
[?2004l[?2004h>     "random_state": 42,
[?2004l[?2004h>     "test_size": 0.2,
[?2004l[?2004h>     "train_indices": sorted(X_train.index.tolist()),
[?2004l[?2004h>     "validation_indices": sorted(X_val.index.tolist())
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/output/split_info.json', 'w') as f:
[?2004l[?2004h>     json.dump(split_info, f, indent=2)
[?2004l[?2004h> print(f"Split info saved. Train: {len(X_train)}, Val: {len(X_val)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Train models
[?2004l[?2004h> print("\nTraining models...")
[?2004l[?2004h> 
[?2004l[?2004h> models = {}
[?2004l[?2004h> model_metrics = []
[?2004l[?2004h> 
[?2004l[?2004h> # Model 1: Linear Regression
[?2004l[?2004h> print("Training Linear Regression...")
[?2004l[?2004h> lr_model = LinearRegression()
[?2004l[?2004h> lr_model.fit(X_train, y_train)
[?2004l[?2004h> lr_train_r2 = r2_score(y_train, lr_model.predict(X_train))
[?2004l[?2004h> lr_val_r2 = r2_score(y_val, lr_model.predict(X_val))
[?2004l[?2004h> lr_mae = mean_absolute_error(y_val, lr_model.predict(X_val))
[?2004l[?2004h> lr_mse = mean_squared_error(y_val, lr_model.predict(X_val))
[?2004l[?2004h> lr_rmse = np.sqrt(lr_mse)
[?2004l[?2004h> 
[?2004l[?2004h> models['linear_regression'] = lr_model
[?2004l[?2004h> model_metrics.append({
[?2004l[?2004h>     "model_name": "linear_regression",
[?2004l[?2004h>     "train_r2": round(lr_train_r2, 6),
[?2004l[?2004h>     "val_r2": round(lr_val_r2, 6),
[?2004l[?2004h>     "mae": round(lr_mae, 6),
[?2004l[?2004h>     "mse": round(lr_mse, 6),
[?2004l[?2004h>     "rmse": round(lr_rmse, 6)
[?2004l[?2004h> })
[?2004l[?2004h> print(f"  Train R²: {lr_train_r2:.4f}, Val R²: {lr_val_r2:.4f}, MAE: {lr_mae:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Model 2: Ridge Regression
[?2004l[?2004h> print("Training Ridge Regression...")
[?2004l[?2004h> ridge_model = Ridge(alpha=1.0)
[?2004l[?2004h> ridge_model.fit(X_train, y_train)
[?2004l[?2004h> ridge_train_r2 = r2_score(y_train, ridge_model.predict(X_train))
[?2004l[?2004h> ridge_val_r2 = r2_score(y_val, ridge_model.predict(X_val))
[?2004l[?2004h> ridge_mae = mean_absolute_error(y_val, ridge_model.predict(X_val))
[?2004l[?2004h> ridge_mse = mean_squared_error(y_val, ridge_model.predict(X_val))
[?2004l[?2004h> ridge_rmse = np.sqrt(ridge_mse)
[?2004l[?2004h> 
[?2004l[?2004h> models['ridge'] = ridge_model
[?2004l[?2004h> model_metrics.append({
[?2004l[?2004h>     "model_name": "ridge",
[?2004l[?2004h>     "train_r2": round(ridge_train_r2, 6),
[?2004l[?2004h>     "val_r2": round(ridge_val_r2, 6),
[?2004l[?2004h>     "mae": round(ridge_mae, 6),
[?2004l[?2004h>     "mse": round(ridge_mse, 6),
[?2004l[?2004h>     "rmse": round(ridge_rmse, 6)
[?2004l[?2004h> })
[?2004l[?2004h> print(f"  Train R²: {ridge_train_r2:.4f}, Val R²: {ridge_val_r2:.4f}, MAE: {ridge_mae:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Model 3: Random Forest
[?2004l[?2004h> print("Training Random Forest...")
[?2004l[?2004h> rf_model = RandomForestRegressor(n_estimators=100, random_state=42, n_jobs=-1)
[?2004l[?2004h> rf_model.fit(X_train, y_train)
[?2004l[?2004h> rf_train_r2 = r2_score(y_train, rf_model.predict(X_train))
[?2004l[?2004h> rf_val_r2 = r2_score(y_val, rf_model.predict(X_val))
[?2004l[?2004h> rf_mae = mean_absolute_error(y_val, rf_model.predict(X_val))
[?2004l[?2004h> rf_mse = mean_squared_error(y_val, rf_model.predict(X_val))
[?2004l[?2004h> rf_rmse = np.sqrt(rf_mse)
[?2004l[?2004h> 
[?2004l[?2004h> models['random_forest'] = rf_model
[?2004l[?2004h> model_metrics.append({
[?2004l[?2004h>     "model_name": "random_forest",
[?2004l[?2004h>     "train_r2": round(rf_train_r2, 6),
[?2004l[?2004h>     "val_r2": round(rf_val_r2, 6),
[?2004l[?2004h>     "mae": round(rf_mae, 6),
[?2004l[?2004h>     "mse": round(rf_mse, 6),
[?2004l[?2004h>     "rmse": round(rf_rmse, 6)
[?2004l[?2004h> })
[?2004l[?2004h> print(f"  Train R²: {rf_train_r2:.4f}, Val R²: {rf_val_r2:.4f}, MAE: {rf_mae:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 4: Select best model and save all
[?2004l[?2004h> print("\nSaving models...")
[?2004l[?2004h> 
[?2004l[?2004h> # Find best model based on validation R²
[?2004l[?2004h> best_model_name = max(model_metrics, key=lambda x: x['val_r2'])['model_name']
[?2004l[?2004h> print(f"Best model: {best_model_name} with val R² = {max(m['val_r2'] for m in model_metrics):.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save all models
[?2004l[?2004h> for name, model in models.items():
[?2004l[?2004h>     with open(f'/app/models/{name}.pkl', 'wb') as f:
[?2004l[?2004h>         pickle.dump(model, f)
[?2004l[?2004h>     print(f"  Saved {name}.pkl")
[?2004l[?2004h> 
[?2004l[?2004h> # Save best model as best_model.pkl
[?2004l[?2004h> with open('/app/models/best_model.pkl', 'wb') as f:
[?2004l[?2004h>     pickle.dump(models[best_model_name], f)
[?2004l[?2004h> print(f"  Saved best_model.pkl ({best_model_name})")
[?2004l[?2004h> 
[?2004l[?2004h> # Save model comparison
[?2004l[?2004h> model_comparison = {
[?2004l[?2004h>     "models": model_metrics,
[?2004l[?2004h>     "best_model_name": best_model_name
[?2004l[?2004h> }
[?2004l[?2004h> with open('/app/output/model_comparison.json', 'w') as f:
[?2004l[?2004h>     json.dump(model_comparison, f, indent=2)
[?2004l[?2004h> print("Model comparison saved.")
[?2004l[?2004h> 
[?2004l[?2004h> print("\nAll training complete!")
[?2004l[?2004h> print("\nModel Performance Summary:")
[?2004l[?2004h> for m in model_metrics:
[?2004l[?2004h>     print(f"  {m['model_name']}: Val R²={m['val_r2']}, MAE={m['mae']}")
[?2004l[?2004h> EOF
