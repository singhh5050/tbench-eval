[?2004l[?2004h> import pandas as pd
[?2004l)
predictions = []
for i in range(len(X_val)):
    features = X_val.iloc[i].tolist()
    response = requests.post(f"{api_url}/predict", json={"features": features})
    pred = response.json()['prediction']
    predictions.append(pred)
    if (i + 1) % 500 == 0:
        print(f"  Processed {i + 1}/{len(X_val)} samples")

# Save predictions to CSV
print("Saving predictions to CSV...")
api_results = pd.DataFrame({
    'sample_index': range(len(predictions)),
    'y_true': y_val.values,
    'y_pred': predictions,
    'absolute_error': np.abs(y_val.values - np.array(predictions))
})
api_results.to_csv('/app/output/api_predictions.csv', index=False)
print(f"Saved {len(api_results)} predictions to api_predictions.csv")

# Calculate metrics
print("Calculating metrics...")
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error

mae = mean_absolute_error(y_val, predictions)
mse = mean_squared_error(y_val, predictions)
rmse = np.sqrt(mse)
r2 = r2_score(y_val, predictions)

api_metrics = {
    "sample_count": len(predictions),
    "mae": round(mae, 6),
    "mse": round(mse, 6),
    "rmse": round(rmse, 6),
    "r2_score": round(r2, 6)
}

with open('/app/output/api_metrics.json', 'w') as f:
    json.dump(api_metrics, f, indent=2)

print("\nAPI Metrics:")
print(f"  Sample count: {api_metrics['sample_count']}")
print(f"  MAE: {api_metrics['mae']}")
print(f"  MSE: {api_metrics['mse']}")
print(f"  RMSE: {api_metrics['rmse']}")
print(f"  R² Score: {api_metrics['r2_score']}")

print("\nValidation quality checks:")
print(f"  R² > 0.6: {'PASS' if r2 > 0.6 else 'FAIL'} ({r2:.4f})")
print(f"  MAE < 0.8: {'PASS' if mae < 0.8 else 'FAIL'} ({mae:.4f})")
