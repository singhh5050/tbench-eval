[?2004l[?2004h>     'y_pred': predictions,
[?2004l[?2004h>     'absolute_error': np.abs(y_val.values - np.array(predictions))
[?2004l[?2004h> })
[?2004l[?2004h> api_results.to_csv('/app/output/api_predictions.csv', index=False)
