[104.491682, "o", "{\r\n  \"models\": [\r\n    {\r\n      \"model_name\": \"linear_regression\",\r\n      \"train_r2\": 0.613149,\r\n      \"val_r2\": 0.609702,\r\n      \"mae\": 0.540714,\r\n      \"mse\": 0.538606,\r\n      \"rmse\": 0.733898\r\n    },\r\n    {\r\n      \"model_name\": \"ridge\",\r\n      \"train_r2\": 0.613149,\r\n      \"val_r2\": 0.6097,\r\n      \"mae\": 0.540731,\r\n      \"mse\": 0.53861,\r\n      \"rmse\": 0.7339\r\n    },\r\n    {\r\n      \"model_name\": \"random_forest\",\r\n      \"train_r2\": 0.973213,\r\n      \"val_r2\": 0.798486,\r\n      \"mae\": 0.345861,\r\n      \"mse\": 0.278088,\r\n"]
