[185.487056, "o", "\u001b[?2004h> "]
[185.487163, "o", "from fastapi import FastAPI\r\n\u001b[?2004l\r\u001b[?2004h> from fastapi.responses import JSONResponse\r\n\u001b[?2004l\r"]
[185.487192, "o", "\u001b[?2004h> "]
[185.487209, "o", "from pydantic import BaseModel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.487252, "o", "from typing import List, Optional\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.487274, "o", "import pickle\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.487287, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.487301, "o", "> "]
[185.487314, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.487328, "o", "\u001b[?2004h> "]
