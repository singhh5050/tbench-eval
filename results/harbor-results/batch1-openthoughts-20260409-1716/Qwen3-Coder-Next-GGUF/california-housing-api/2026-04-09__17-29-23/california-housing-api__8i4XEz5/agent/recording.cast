[233.882986, "o", "print(\"Loading data...\")\r\n\u001b[?2004l\r"]
[233.883009, "o", "\u001b[?2004h> "]
[233.883048, "o", "train_df = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r"]
[233.883061, "o", "\u001b[?2004h> "]
[233.883123, "o", "X_val = pd.read_csv('/app/output/val_features.csv') if False else None\r\n\u001b[?2004l\r"]
[233.883136, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[233.883149, "o", "> "]
[233.883193, "o", "# Actually, we need to reload and split the same way\r\n\u001b[?2004l\r"]
[233.883218, "o", "\u001b[?2004h> "]
[233.88327, "o", "from sklearn.model_selection import train_test_split\r\n\u001b[?2004l\r"]
[233.883282, "o", "\u001b[?2004h> "]
[233.883294, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[233.88331, "o", "> "]
[233.883361, "o", "train_df = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r"]
[233.88338, "o", "\u001b[?2004h> "]
[233.883424, "o", "X = train_df.drop('target', axis=1)\r\n\u001b[?2004l\r"]
[233.883455, "o", "\u001b[?2004h> "]
[233.883476, "o", "y = train_df['target']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.883524, "o", "X = X.reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.883549, "o", "y = y.reset_index(drop=True)\r\n\u001b[?2004l\r"]
[233.883631, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load split info to get the exact same indices\r\n\u001b[?2004l\r"]
[233.8837, "o", "\u001b[?2004h> with open('/app/output/split_info.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.883733, "o", "    split_info = json.load(f)\r\n\u001b[?2004l\r"]
[233.883762, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.883795, "o", "val_indices = split_info['validation_indices']\r\n\u001b[?2004l\r"]
[233.883801, "o", "\u001b[?2004h> "]
[233.883856, "o", "X_val = X.loc[val_indices].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[233.883883, "o", "\u001b[?2004h> "]
[233.883914, "o", "y_val = y.loc[val_indices].reset_index(drop=True)\r\n\u001b[?2004l\r"]
[233.883918, "o", "\u001b[?2004h"]
[233.883926, "o", "> \r\n\u001b[?2004l\r"]
[233.883933, "o", "\u001b[?2004h> "]
[233.884006, "o", "print(f\"Validation set: {len(X_val)} samples\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[233.884087, "o", "> \r\n\u001b[?2004l\r"]
[233.884167, "o", "\u001b[?2004h> # API URL\r\n\u001b[?2004l\r\u001b[?2004h> api_url = \"http://localhost:8000\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.884189, "o", "\r\n\u001b[?2004l\r"]
[233.884212, "o", "\u001b[?2004h"]
[233.884233, "o", "> "]
[233.884254, "o", "# Make predictions for each sample\r\n\u001b[?2004l\r"]
[233.884277, "o", "\u001b[?2004h> "]
[233.884299, "o", "print(\"Making API predictions...\")\r\n\u001b[?2004l\r"]
[233.88432, "o", "\u001b[?2004h> predictions = []\r\n"]
[233.884341, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[233.884362, "o", "for i in range(len(X_val)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.88438, "o", "    features = X_val.iloc[i].tolist()\r\n\u001b[?2004l\r"]
[233.884401, "o", "\u001b[?2004h> "]
[233.884448, "o", "    response = requests.post(f\"{api_url}/predict\", json={\"features\": features})\r\n\u001b[?2004l\r"]
[233.884467, "o", "\u001b[?2004h> "]
[233.884487, "o", "    pred = response.json()['prediction']\r\n\u001b[?2004l\r"]
[233.884515, "o", "\u001b[?2004h> "]
[233.884538, "o", "    predictions.append(pred)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.884575, "o", "    if (i + 1) % 500 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.884609, "o", "        print(f\"  Processed {i + 1}/{len(X_val)} samples\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.884616, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[233.884634, "o", "> "]
[233.884666, "o", "# Save predictions to CSV\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.884716, "o", "print(\"Saving predictions to CSV...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.884747, "o", "api_results = pd.DataFrame({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.88477, "o", "    'sample_index': range(len(predictions)),\r\n\u001b[?2004l\r"]
[233.884793, "o", "\u001b[?2004h>     'y_true': y_val.values,\r\n\u001b[?2004l\r"]
[233.884816, "o", "\u001b[?2004h> "]
[233.884839, "o", "    'y_pred': predictions,\r\n\u001b[?2004l\r"]
[233.884861, "o", "\u001b[?2004h> "]
[233.884887, "o", "    'absolute_error': np.abs(y_val.values - np.array(predictions))\r\n\u001b[?2004l\r"]
[233.884908, "o", "\u001b[?2004h> })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.884962, "o", "api_results.to_csv('/app/output/api_predictions.csv', index=False)\r\n\u001b[?2004l\r"]
[233.88498, "o", "\u001b[?2004h> "]
[233.885038, "o", "print(f\"Saved {len(api_results)} predictions to api_predictions.csv\")\r\n\u001b[?2004l\r"]
[233.885058, "o", "\u001b[?2004h> \r\n"]
[233.885082, "o", "\u001b[?2004l\r\u001b[?2004h> # Calculate metrics\r\n"]
[233.885104, "o", "\u001b[?2004l\r\u001b[?2004h> print(\"Calculating metrics...\")\r\n\u001b[?2004l\r"]
[233.885123, "o", "\u001b[?2004h> "]
[233.885177, "o", "from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\r\n\u001b[?2004l\r"]
[233.885198, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[233.885219, "o", "\u001b[?2004h> "]
[233.885243, "o", "mae = mean_absolute_error(y_val, predictions)\r\n\u001b[?2004l\r"]
[233.885264, "o", "\u001b[?2004h> "]
[233.885287, "o", "mse = mean_squared_error(y_val, predictions)\r\n\u001b[?2004l\r"]
[233.885308, "o", "\u001b[?2004h> rmse = np.sqrt(mse)\r\n\u001b[?2004l\r"]
[233.885328, "o", "\u001b[?2004h> "]
[233.885352, "o", "r2 = r2_score(y_val, predictions)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[233.885373, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[233.885397, "o", "api_metrics = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.885418, "o", "    \"sample_count\": len(predictions),\r\n\u001b[?2004l\r"]
[233.885455, "o", "\u001b[?2004h>     \"mae\": round(mae, 6),\r\n\u001b[?2004l\r\u001b[?2004h"]
[233.885494, "o", ">     \"mse\": round(mse, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.885517, "o", "    \"rmse\": round(rmse, 6),\r\n\u001b[?2004l\r\u001b[?2004h"]
[233.88553, "o", "> "]
[233.885557, "o", "    \"r2_score\": round(r2, 6)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[233.88557, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[233.885582, "o", "\u001b[?2004h> "]
[233.885623, "o", "with open('/app/output/api_metrics.json', 'w') as f:\r\n\u001b[?2004l\r"]
[233.885637, "o", "\u001b[?2004h> "]
[233.885669, "o", "    json.dump(api_metrics, f, indent=2)\r\n\u001b[?2004l\r"]
[233.885682, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[233.885695, "o", "\u001b[?2004h> "]
[233.885715, "o", "print(\"\\nAPI Metrics:\")\r\n\u001b[?2004l\r"]
[233.885727, "o", "\u001b[?2004h> "]
[233.885771, "o", "print(f\"  Sample count: {api_metrics['sample_count']}\")\r\n\u001b[?2004l\r"]
[233.885783, "o", "\u001b[?2004h> "]
[233.885814, "o", "print(f\"  MAE: {api_metrics['mae']}\")\r\n\u001b[?2004l\r"]
[233.885827, "o", "\u001b[?2004h> "]
[233.885857, "o", "print(f\"  MSE: {api_metrics['mse']}\")\r\n\u001b[?2004l\r"]
[233.885869, "o", "\u001b[?2004h> "]
[233.8859, "o", "print(f\"  RMSE: {api_metrics['rmse']}\")\r\n\u001b[?2004l\r"]
[233.886538, "o", "\u001b[?2004h> print(f\"  R² Score: {api_metrics['r2_score']}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nValidation quality checks:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  R² > 0.6: {'PASS' if r2 > 0.6 else 'FAIL'} ({r2:.4f})\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  MAE < 0.8: {'PASS' if mae < 0.8 else 'FAIL'} ({mae:.4f})\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[233.887325, "o", "\u001b[?2004hroot@ec00c077f56c:/app# "]
[234.880467, "i", "python test_api.py\n"]
[234.880676, "o", "python test_api.py\r\n\u001b[?2004l\r"]
