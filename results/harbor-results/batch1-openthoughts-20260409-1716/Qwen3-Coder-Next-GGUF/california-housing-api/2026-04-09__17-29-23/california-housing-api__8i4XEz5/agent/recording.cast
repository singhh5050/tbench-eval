[185.488159, "o", "\u001b[?2004h> "]
[185.48818, "o", "async def health_check():\r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r"]
[185.488201, "o", "\u001b[?2004h> "]
[185.488222, "o", "        \"status\": \"healthy\",\r\n\u001b[?2004l\r"]
[185.488232, "o", "\u001b[?2004h> "]
[185.488285, "o", "        \"model_loaded\": best_model is not None\r\n\u001b[?2004l\r"]
[185.488313, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.488336, "o", "\r\n\u001b[?2004l\r"]
[185.488361, "o", "\u001b[?2004h> "]
[185.488384, "o", "@app.get(\"/model-info\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.488404, "o", "async def get_model_info():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.488425, "o", "    return {\r\n\u001b[?2004l\r"]
[185.488445, "o", "\u001b[?2004h> "]
[185.488465, "o", "        \"model_name\": model_name,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.488524, "o", "        \"model_type\": type(best_model).__name__ if best_model else \"unknown\",\r\n\u001b[?2004l\r"]
[185.488543, "o", "\u001b[?2004h> "]
[185.488562, "o", "        \"features_count\": 8\r\n\u001b[?2004l\r"]
[185.488582, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[185.488599, "o", "\u001b[?2004h> "]
[185.488617, "o", "\r\n\u001b[?2004l\r"]
[185.488637, "o", "\u001b[?2004h> "]
[185.488657, "o", "@app.post(\"/predict\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.488684, "o", "async def predict_single(input_data: PredictInput):\r\n\u001b[?2004l\r"]
[185.488703, "o", "\u001b[?2004h> "]
[185.48872, "o", "    if best_model is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.488738, "o", "> "]
[185.488786, "o", "        return JSONResponse(content={\"error\": \"Model not loaded\"}, status_code=503)\r\n\u001b[?2004l\r"]
[185.488805, "o", "\u001b[?2004h> "]
[185.488826, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
