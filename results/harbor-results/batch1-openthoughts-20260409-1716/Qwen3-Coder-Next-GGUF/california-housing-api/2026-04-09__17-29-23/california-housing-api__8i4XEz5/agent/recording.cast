[185.487392, "o", "> "]
[185.48741, "o", "model_name = \"random_forest\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.487426, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.487443, "o", "# Request/Response models\r\n\u001b[?2004l\r"]
[185.487456, "o", "\u001b[?2004h> "]
[185.487476, "o", "class PredictInput(BaseModel):\r\n\u001b[?2004l\r"]
[185.487491, "o", "\u001b[?2004h> "]
[185.487513, "o", "    features: List[float]\r\n\u001b[?2004l\r"]
[185.487524, "o", "\u001b[?2004h> "]
[185.48754, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.487586, "o", "class PredictBatchInput(BaseModel):\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.487612, "o", "> "]
[185.487627, "o", "    features_list: List[List[float]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.487641, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[185.487653, "o", "> "]
[185.487677, "o", "# Initialize FastAPI app\r\n\u001b[?2004l\r"]
[185.487691, "o", "\u001b[?2004h> "]
[185.487754, "o", "app = FastAPI(title=\"California Housing Prediction API\")\r\n\u001b[?2004l\r"]
[185.487765, "o", "\u001b[?2004h> "]
[185.487777, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.487812, "o", "@app.on_event(\"startup\")\r\n\u001b[?2004l\r"]
[185.488075, "o", "\u001b[?2004h> async def load_model():\r\n\u001b[?2004l\r\u001b[?2004h>     global best_model\r\n\u001b[?2004l\r\u001b[?2004h>     with open('/app/models/best_model.pkl', 'rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         best_model = pickle.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Model loaded: {type(best_model).__name__}\")\r\n\u001b[?2004l\r"]
[185.488101, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.488122, "o", "\u001b[?2004h> "]
