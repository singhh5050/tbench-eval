[185.486683, "i", "cat > /app/api/app.py << 'EOF'\nfrom fastapi import FastAPI\nfrom fastapi.responses import JSONResponse\nfrom pydantic import BaseModel\nfrom typing import List, Optional\nimport pickle\nimport numpy as np\nimport pandas as pd\n\n# Global variable for the model\nbest_model = None\nmodel_name = \"random_forest\"\n\n# Request/Response models\nclass PredictInput(BaseModel):\n    features: List[float]\n\nclass PredictBatchInput(BaseModel):\n    features_list: List[List[float]]\n\n# Initialize FastAPI app\napp = FastAPI(title=\"California Housing Prediction API\")\n\n@app.on_event(\"startup\")\nasync def load_model():\n    global best_model\n    with open('/app/models/best_model.pkl', 'rb') as f:\n        best_model = pickle.load(f)\n    print(f\"Model loaded: {type(best_model).__name__}\")\n\n@app.get(\"/health\")\nasync def health_check():\n    return {\n        \"status\": \"healthy\",\n        \"model_loaded\": best_model is not None\n    }\n\n@app.get(\"/model-info\")\nasync def get_model_info():\n    return {\n        \"model_name\": model_name,\n        \"model_type\":"]
[185.486805, "i", " type(best_model).__name__ if best_model else \"unknown\",\n        \"features_count\": 8\n    }\n\n@app.post(\"/predict\")\nasync def predict_single(input_data: PredictInput):\n    if best_model is None:\n        return JSONResponse(content={\"error\": \"Model not loaded\"}, status_code=503)\n    \n    features_array = np.array(input_data.features).reshape(1, -1)\n    prediction = best_model.predict(features_array)[0]\n    \n    return {\n        \"prediction\": float(prediction),\n        \"model_name\": model_name\n    }\n\n@app.post(\"/predict-batch\")\nasync def predict_batch(input_data: PredictBatchInput):\n    if best_model is None:\n        return JSONResponse(content={\"error\": \"Model not loaded\"}, status_code=503)\n    \n    features_array = np.array(input_data.features_list)\n    predictions = best_model.predict(features_array)\n    \n    return {\n        \"predictions\": [float(p) for p in predictions],\n        \"model_name\": model_name,\n        \"count\": len(predictions)\n    }\nEOF\n"]
[185.486823, "o", "cat > /app/api/app.py << 'EOF'\r\n\u001b[?2004l\r"]
[185.486859, "o", " type(best_model).__name__ if best_model else \"unknown\",\r\n        \"features_count\": 8\r\n    }\r\n\r\n@app.post(\"/predic"]
