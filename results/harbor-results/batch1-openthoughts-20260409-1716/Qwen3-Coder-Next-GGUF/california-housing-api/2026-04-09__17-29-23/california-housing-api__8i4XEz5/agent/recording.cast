[63.442114, "o", "ridge_model = Ridge(alpha=1.0)\r\n\u001b[?2004l\r"]
[63.442123, "o", "\u001b[?2004h> "]
[63.442147, "o", "ridge_model.fit(X_train, y_train)\r\n\u001b[?2004l\r"]
[63.442156, "o", "\u001b[?2004h> "]
[63.442199, "o", "ridge_train_r2 = r2_score(y_train, ridge_model.predict(X_train))\r\n\u001b[?2004l\r"]
[63.442208, "o", "\u001b[?2004h> "]
[63.442247, "o", "ridge_val_r2 = r2_score(y_val, ridge_model.predict(X_val))\r\n\u001b[?2004l\r"]
[63.442256, "o", "\u001b[?2004h> "]
[63.442302, "o", "ridge_mae = mean_absolute_error(y_val, ridge_model.predict(X_val))\r\n\u001b[?2004l\r"]
[63.442312, "o", "\u001b[?2004h> "]
[63.442371, "o", "ridge_mse = mean_squared_error(y_val, ridge_model.predict(X_val))\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.442387, "o", "> "]
[63.442422, "o", "ridge_rmse = np.sqrt(ridge_mse)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.442463, "o", "\u001b[?2004h> "]
[63.442506, "o", "models['ridge'] = ridge_model\r\n\u001b[?2004l\r\u001b[?2004h> model_metrics.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.442523, "o", "> "]
[63.442537, "o", "    \"model_name\": \"ridge\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.442547, "o", "> "]
[63.442595, "o", "    \"train_r2\": round(ridge_train_r2, 6),\r\n\u001b[?2004l\r"]
[63.442643, "o", "\u001b[?2004h>     \"val_r2\": round(ridge_val_r2, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.442675, "o", "    \"mae\": round(ridge_mae, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.442765, "o", "    \"mse\": round(ridge_mse, 6),\r\n\u001b[?2004l\r\u001b[?2004h>     \"rmse\": round(ridge_rmse, 6)\r\n\u001b[?2004l\r\u001b[?2004h> })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.442845, "o", "print(f\"  Train R²: {ridge_train_r2:.4f}, Val R²: {ridge_val_r2:.4f}, MAE: {ridge_mae:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.442867, "o", "# Model 3: Random Forest\r\n\u001b[?2004l\r"]
[63.442879, "o", "\u001b[?2004h> "]
[63.442895, "o", "print(\"Training Random Forest...\")\r\n\u001b[?2004l\r"]
[63.442907, "o", "\u001b[?2004h> "]
[63.442963, "o", "rf_model = RandomForestRegressor(n_estimators=100, random_state=42, n_jobs=-1)\r\n\u001b[?2004l\r"]
[63.442974, "o", "\u001b[?2004h> "]
[63.44304, "o", "rf_model.fit(X_train, y_train)\r\n\u001b[?2004l\r"]
[63.443046, "o", "\u001b[?2004h"]
[63.44308, "o", "> "]
[63.44311, "o", "rf_train_r2 = r2_score(y_train, rf_model.predict(X_train))\r\n\u001b[?2004l\r"]
[63.443123, "o", "\u001b[?2004h"]
[63.443134, "o", "> "]
[63.443167, "o", "rf_val_r2 = r2_score(y_val, rf_model.predict(X_val))\r\n"]
[63.44318, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[63.443233, "o", "rf_mae = mean_absolute_error(y_val, rf_model.predict(X_val))\r\n\u001b[?2004l\r"]
[63.443242, "o", "\u001b[?2004h> "]
[63.443296, "o", "rf_mse = mean_squared_error(y_val, rf_model.predict(X_val))\r\n\u001b[?2004l\r"]
[63.443308, "o", "\u001b[?2004h> "]
[63.443385, "o", "rf_rmse = np.sqrt(rf_mse)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> models['random_forest'] = rf_model"]
[63.443394, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.443423, "o", "model_metrics.append({\r\n\u001b[?2004l\r"]
[63.443431, "o", "\u001b[?2004h> "]
[63.443501, "o", "    \"model_name\": \"random_forest\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.443527, "o", "    \"train_r2\": round(rf_train_r2, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.443535, "o", "    \"val_r2\": round(rf_val_r2, 6),\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.443559, "o", "> "]
[63.44358, "o", "    \"mae\": round(rf_mae, 6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.4436, "o", "    \"mse\": round(rf_mse, 6),\r\n\u001b[?2004l\r"]
[63.443621, "o", "\u001b[?2004h> "]
[63.443642, "o", "    \"rmse\": round(rf_rmse, 6)\r\n\u001b[?2004l\r\u001b[?2004h> })\r\n\u001b[?2004l\r"]
[63.443658, "o", "\u001b[?2004h> "]
[63.443698, "o", "print(f\"  Train R²: {rf_train_r2:.4f}, Val R²: {rf_val_r2:.4f}, MAE: {rf_mae:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.443715, "o", "> \r\n\u001b[?2004l\r"]
[63.443739, "o", "\u001b[?2004h> "]
[63.443763, "o", "# Step 4: Select best model and save all\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.443786, "o", "print(\"\\nSaving models...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.443806, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.443828, "o", "# Find best model based on validation R²\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.443881, "o", "best_model_name = max(model_metrics, key=lambda x: x['val_r2'])['model_name']\r\n\u001b[?2004l\r"]
[63.443899, "o", "\u001b[?2004h> "]
[63.443963, "o", "print(f\"Best model: {best_model_name} with val R² = {max(m['val_r2'] for m in model_metrics):.4f}\")\r\n\u001b[?2004l\r"]
[63.443984, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.444004, "o", "> # Save all models\r\n\u001b[?2004l\r"]
[63.444026, "o", "\u001b[?2004h> "]
[63.444048, "o", "for name, model in models.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.444077, "o", "    with open(f'/app/models/{name}.pkl', 'wb') as f:\r\n\u001b[?2004l\r"]
[63.444097, "o", "\u001b[?2004h> "]
[63.444121, "o", "        pickle.dump(model, f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.444145, "o", ">     print(f\"  Saved {name}.pkl\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.444162, "o", "\u001b[?2004h> "]
[63.44418, "o", "# Save best model as best_model.pkl\r\n\u001b[?2004l\r"]
[63.444201, "o", "\u001b[?2004h> "]
[63.444225, "o", "with open('/app/models/best_model.pkl', 'wb') as f:\r\n\u001b[?2004l\r"]
[63.444244, "o", "\u001b[?2004h> "]
[63.444264, "o", "    pickle.dump(models[best_model_name], f)\r\n\u001b[?2004l\r"]
[63.444285, "o", "\u001b[?2004h> "]
[63.444309, "o", "print(f\"  Saved best_model.pkl ({best_model_name})\")\r\n\u001b[?2004l\r"]
[63.444327, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.444346, "o", "\u001b[?2004h> "]
[63.444355, "o", "# Save model comparison\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.444397, "o", "model_comparison = {\r\n\u001b[?2004l\r\u001b[?2004h>     \"models\": model_metrics,\r\n\u001b[?2004l\r"]
[63.44444, "o", "\u001b[?2004h> "]
[63.444493, "o", "    \"best_model_name\": best_model_name\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.444513, "o", "with open('/app/output/model_comparison.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.444543, "o", "    json.dump(model_comparison, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.44456, "o", "print(\"Model comparison saved.\")\r\n\u001b[?2004l\r"]
[63.444572, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.444585, "o", "> "]
[63.444601, "o", "print(\"\\nAll training complete!\")\r\n\u001b[?2004l\r"]
[63.444611, "o", "\u001b[?2004h> "]
[63.444636, "o", "print(\"\\nModel Performance Summary:\")\r\n\u001b[?2004l\r"]
[63.444647, "o", "\u001b[?2004h> "]
[63.444662, "o", "for m in model_metrics:\r\n\u001b[?2004l\r"]
[63.444674, "o", "\u001b[?2004h> "]
[63.444729, "o", "    print(f\"  {m['model_name']}: Val R²={m['val_r2']}, MAE={m['mae']}\")\r\n\u001b[?2004l\r"]
[63.444754, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[63.445814, "o", "\u001b[?2004hroot@ec00c077f56c:/app# "]
