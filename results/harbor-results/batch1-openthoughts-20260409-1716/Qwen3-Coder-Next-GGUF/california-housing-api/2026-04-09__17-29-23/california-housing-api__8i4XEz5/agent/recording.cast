[185.489249, "o", "\u001b[?2004h> "]
[185.489312, "o", "        return JSONResponse(content={\"error\": \"Model not loaded\"}, status_code=503)\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.489331, "o", ">     \r\n"]
[185.489352, "o", "\u001b[?2004l\r\u001b[?2004h> "]
