[335.916072, "i", "python3 << 'EOF'\nimport pickle\nimport numpy as np\nimport pandas as pd\nimport json\nimport requests\n\n# Load the best model\nwith open('/app/models/best_model.pkl', 'rb') as f:\n    model = pickle.load(f)\n\n# Load validation data\ntrain_df = pd.read_csv('/app/data/train.csv')\nX = train_df.drop('target', axis=1)\ny = train_df['target']\nX = X.reset_index(drop=True)\ny = y.reset_index(drop=True)\n\nwith open('/app/output/split_info.json') as f:\n    split_info = json.load(f)\n\nval_indices = split_info['validation_indices']\nX_val = X.loc[val_indices].reset_index(drop=True)\ny_val = y.loc[val_indices].reset_index(drop=True)\n\n# Get direct model predictions for first 5 samples\ndirect_preds = model.predict(X_val.iloc[:5])\n\n# Get API predictions for first 5 samples\napi_preds = []\nfor i in range(5):\n    resp = requests.post('http://localhost:8000/predict', json={'features': X_val.iloc[i].tolist()})\n    api_preds.append(resp.json()['prediction'])\n\nprint(\"Direct model predictions:\", [round(p, 6) for p in direct_preds])\nprint(\"API pred"]
[335.916182, "i", "ictions:\", [round(p, 6) for p in api_preds])\nprint(\"Match:\", np.allclose(direct_preds, api_preds))\n\n# Verify API predictions file\napi_df = pd.read_csv('/app/output/api_predictions.csv')\nprint(f\"\\nAPI predictions CSV has {len(api_df)} rows\")\nprint(f\"First prediction: {api_df.iloc[0]['y_pred']}\")\nEOF\n"]
