[233.882314, "i", "cat > test_api.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport json\nimport requests\nimport time\n\n# Wait for server to be ready\ntime.sleep(1)\n\n# Load validation data\nprint(\"Loading data...\")\ntrain_df = pd.read_csv('/app/data/train.csv')\nX_val = pd.read_csv('/app/output/val_features.csv') if False else None\n\n# Actually, we need to reload and split the same way\nfrom sklearn.model_selection import train_test_split\n\ntrain_df = pd.read_csv('/app/data/train.csv')\nX = train_df.drop('target', axis=1)\ny = train_df['target']\nX = X.reset_index(drop=True)\ny = y.reset_index(drop=True)\n\n# Load split info to get the exact same indices\nwith open('/app/output/split_info.json') as f:\n    split_info = json.load(f)\n\nval_indices = split_info['validation_indices']\nX_val = X.loc[val_indices].reset_index(drop=True)\ny_val = y.loc[val_indices].reset_index(drop=True)\n\nprint(f\"Validation set: {len(X_val)} samples\")\n\n# API URL\napi_url = \"http://localhost:8000\"\n\n# Make predictions for each sample\nprint(\"Making API predictions...\""]
[233.882479, "i", ")\npredictions = []\nfor i in range(len(X_val)):\n    features = X_val.iloc[i].tolist()\n    response = requests.post(f\"{api_url}/predict\", json={\"features\": features})\n    pred = response.json()['prediction']\n    predictions.append(pred)\n    if (i + 1) % 500 == 0:\n        print(f\"  Processed {i + 1}/{len(X_val)} samples\")\n\n# Save predictions to CSV\nprint(\"Saving predictions to CSV...\")\napi_results = pd.DataFrame({\n    'sample_index': range(len(predictions)),\n    'y_true': y_val.values,\n    'y_pred': predictions,\n    'absolute_error': np.abs(y_val.values - np.array(predictions))\n})\napi_results.to_csv('/app/output/api_predictions.csv', index=False)\nprint(f\"Saved {len(api_results)} predictions to api_predictions.csv\")\n\n# Calculate metrics\nprint(\"Calculating metrics...\")\nfrom sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\n\nmae = mean_absolute_error(y_val, predictions)\nmse = mean_squared_error(y_val, predictions)\nrmse = np.sqrt(mse)\nr2 = r2_score(y_val, predictions)\n\napi_metrics = {\n    \"sam"]
[233.882545, "o", "cat > test_api.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r)\r\npredictions = []\r\nfor i in range(len(X_val)):\r\n    features = X_val.iloc[i].tolist()\r\n    response = requests.post(f\"{api_url}/predict\", json={\"features\": features})\r\n    pred = response.json()['prediction']\r\n    predictions.append(pred)\r\n    if (i + 1) % 500 == 0:\r\n        print(f\"  Processed {i + 1}/{len(X_val)} samples\")\r\n\r\n# Save predictions to CSV\r\nprint(\"Saving predictions to CSV...\")\r\napi_results = pd.DataFrame({\r\n    'sample_index': range(len(predictions)),\r\n    'y_true': y_val.valu"]
[233.88257, "i", "ple_count\": len(predictions),\n    \"mae\": round(mae, 6),\n    \"mse\": round(mse, 6),\n    \"rmse\": round(rmse, 6),\n    \"r2_score\": round(r2, 6)\n}\n\nwith open('/app/output/api_metrics.json', 'w') as f:\n    json.dump(api_metrics, f, indent=2)\n\nprint(\"\\nAPI Metrics:\")\nprint(f\"  Sample count: {api_metrics['sample_count']}\")\nprint(f\"  MAE: {api_metrics['mae']}\")\nprint(f\"  MSE: {api_metrics['mse']}\")\nprint(f\"  RMSE: {api_metrics['rmse']}\")\nprint(f\"  R² Score: {api_metrics['r2_score']}\")\n\nprint(\"\\nValidation quality checks:\")\nprint(f\"  R² > 0.6: {'PASS' if r2 > 0.6 else 'FAIL'} ({r2:.4f})\")\nprint(f\"  MAE < 0.8: {'PASS' if mae < 0.8 else 'FAIL'} ({mae:.4f})\")\nEOF\n"]
