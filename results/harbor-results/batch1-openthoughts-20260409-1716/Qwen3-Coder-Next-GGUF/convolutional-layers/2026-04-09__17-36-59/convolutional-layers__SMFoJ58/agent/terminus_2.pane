[?2004l[?2004h>     """Batch Normalization layer for 2D data (NHWC format)."""
[?2004l[?2004h>     
[?2004l[?2004h>     def __init__(self, num_features: int, eps: float = 1e-5, momentum: float = 0.1):
[?2004l[?2004h>         """
[?2004l[?2004h>         Args:
[?2004l[?2004h>             num_features: number of channels (C in NHWC format)
[?2004l[?2004h>             eps: small constant for numerical stability (default 1e-5)
[?2004l[?2004h>             momentum: momentum for running mean/variance update (default 0.1)
[?2004l[?2004h>         """
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.num_features = num_features
[?2004l[?2004h>         self.eps = eps
[?2004l[?2004h>         self.momentum = momentum
[?2004l[?2004h>         
[?2004l[?2004h>         # Scale (gamma) initialized to ones
[?2004l[?2004h>         self.gamma = np.ones(num_features, dtype=np.float64)
[?2004l[?2004h>         # Shift (beta) initialized to zeros
[?2004l[?2004h>         self.beta = np.zeros(num_features, dtype=np.float64)
[?2004l[?2004h>         # Running statistics for inference
[?2004l[?2004h>         self.running_mean = np.zeros(num_features, dtype=np.float64)
[?2004l[?2004h>         self.running_var = np.ones(num_features, dtype=np.float64)
[?2004l[?2004h>     
[?2004l[?2004h>     def forward(self, x: np.ndarray, training: bool = True) -> np.ndarray:
[?2004l[?2004h>         """
[?2004l[?2004h>         Args:
[?2004l[?2004h>             x: input of shape (batch_size, height, width, num_features), dtype float64
[?2004l[?2004h>             training: if True, use batch statistics and update running stats;
[?2004l[?2004h>                      if False, use running stats
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             normalized output of same shape, dtype float64
[?2004l[?2004h>         """
[?2004l[?2004h>         batch_size, height, width, num_features = x.shape
[?2004l[?2004h>         
[?2004l[?2004h>         if training:
[?2004l[?2004h>             # Compute batch statistics across batch, height, width
[?2004l[?2004h>             # Axis 0=batch, 1=height, 2=width, 3=channels
[?2004l[?2004h>             batch_mean = np.mean(x, axis=(0, 1, 2))  # (num_features,)
[?2004l[?2004h>             batch_var = np.var(x, axis=(0, 1, 2))    # (num_features,)
[?2004l[?2004h>             
[?2004l[?2004h>             # Update running statistics
[?2004l[?2004h>             self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * batch_mean
[?2004l[?2004h>             self.running_var = (1 - self.momentum) * self.running_var + self.momentum * batch_var
[?2004l[?2004h>             
[?2004l[?2004h>             # Normalize
[?2004l[?2004h>             normalized = (x - batch_mean) / np.sqrt(batch_var + self.eps)
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Use running statistics for inference
[?2004l[?2004h>             normalized = (x - self.running_mean) / np.sqrt(self.running_var + self.eps)
[?2004l[?2004h>         
[?2004l[?2004h>         # Scale and shift
[?2004l[?2004h>         output = self.gamma * normalized + self.beta
[?2004l[?2004h>         
[?2004l[?2004h>         return output
