[?2004l[?2004h>                         for ki in range(self.kernel_size):
[?2004l[?2004h>                             for kj in range(self.kernel_size):
[?2004l[?2004h>                                 h_idx = h_start + ki * self.dilation
[?2004l[?2004h>                                 w_idx = w_start + kj * self.dilation
[?2004l[?2004h>                                 region[ki, kj, :] = x_padded[b, h_idx, w_idx, :]
[?2004l[?2004h>                         
[?2004l[?2004h>                         # Convolution: sum over in_channels, kernel_h, kernel_w
