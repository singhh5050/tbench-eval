[?2004l[?2004h>         self.weights = np.random.uniform(-limit, limit, 
[?2004l[?2004h>                                           (out_channels, in_channels, kernel_size, kernel_size)).astype(np.float64)
[?2004l[?2004h>         # Bias shape: (out_channels,)
[?2004l[?2004h>         self.bias = np.zeros(out_channels, dtype=np.float64)
[?2004l[?2004h>     
[?2004l[?2004h>     def forward(self, x: np.ndarray) -> np.ndarray:
[?2004l[?2004h>         """
[?2004l[?2004h>         Args:
[?2004l[?2004h>             x: input of shape (batch_size, height, width, in_channels), dtype float64
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             output of shape (batch_size, out_height, out_width, out_channels), dtype float64
[?2004l[?2004h>         """
[?2004l[?2004h>         batch_size, height, width, _ = x.shape
[?2004l[?2004h>         
[?2004l[?2004h>         # Apply padding
