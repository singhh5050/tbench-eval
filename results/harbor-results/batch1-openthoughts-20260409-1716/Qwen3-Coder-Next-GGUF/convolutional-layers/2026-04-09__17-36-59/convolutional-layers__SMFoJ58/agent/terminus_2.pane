[?2004l[?2004h> class MaxPool2D(BaseLayer):
[?2004l[?2004h>     """Max Pooling layer."""
[?2004l[?2004h>     
[?2004l[?2004h>     def __init__(self, kernel_size: int, stride: int | None = None):
[?2004l[?2004h>         """
[?2004l[?2004h>         Args:
[?2004l[?2004h>             kernel_size: size of pooling window (positive integer)
[?2004l[?2004h>             stride: stride of pooling (positive integer, defaults to kernel_size if None)
[?2004l[?2004h>         """
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.kernel_size = kernel_size
[?2004l[?2004h>         self.stride = stride if stride is not None else kernel_size
[?2004l[?2004h>     
[?2004l[?2004h>     def forward(self, x: np.ndarray) -> np.ndarray:
[?2004l[?2004h>         """
[?2004l[?2004h>         Args:
[?2004l[?2004h>             x: input of shape (batch_size, height, width, channels), dtype float64
[?2004l[?2004h>         
[?2004l[?2004h>         Returns:
[?2004l[?2004h>             output of shape (batch_size, out_height, out_width, channels), dtype float64
[?2004l[?2004h>         """
[?2004l[?2004h>         batch_size, height, width, channels = x.shape
[?2004l[?2004h>         
[?2004l[?2004h>         out_h = (height - self.kernel_size) // self.stride + 1
[?2004l[?2004h>         out_w = (width - self.kernel_size) // self.stride + 1
[?2004l[?2004h>         
[?2004l[?2004h>         output = np.zeros((batch_size, out_h, out_w, channels), dtype=np.float64)
[?2004l[?2004h>         
[?2004l[?2004h>         for b in range(batch_size):
[?2004l[?2004h>             for i in range(out_h):
[?2004l[?2004h>                 for j in range(out_w):
[?2004l[?2004h>                     h_start = i * self.stride
[?2004l[?2004h>                     w_start = j * self.stride
[?2004l[?2004h>                     region = x[b, h_start:h_start + self.kernel_size, 
[?2004l[?2004h>                                w_start:w_start + self.kernel_size, :]
[?2004l[?2004h>                     output[b, i, j, :] = np.max(region, axis=(0, 1))
[?2004l[?2004h>         
[?2004l[?2004h>         return output
