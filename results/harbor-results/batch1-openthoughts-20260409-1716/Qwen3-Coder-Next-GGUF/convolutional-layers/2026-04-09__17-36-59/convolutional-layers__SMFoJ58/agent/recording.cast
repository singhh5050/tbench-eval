[207.930964, "i", "python3 << 'EOF'\nimport numpy as np\nimport sys\nsys.path.insert(0, '/app')\n\nfrom src import *\n\nprint(\"Additional verification tests...\\n\")\n\n# Test that Conv2D with stride > 1 works correctly\nprint(\"=== Verifying Conv2D with stride=2 ===\")\nconv = Conv2D(1, 1, 3, stride=2, padding=0, dilation=1)\n# Use simple weights for verification\nconv.weights = np.ones((1, 1, 3, 3), dtype=np.float64)\nconv.bias = np.zeros(1, dtype=np.float64)\n\n# Input: 4x4 with all ones\nx = np.ones((1, 4, 4, 1), dtype=np.float64)\nout = conv.forward(x)\nprint(f\"Input shape: {x.shape}\")\nprint(f\"Output shape: {out.shape}\")\nprint(f\"Output: {out}\")\n# With stride=2, padding=0, kernel=3, input=4:\n# output = (4 + 0 - 1) // 2 + 1 = 2\n# Output should be 9 at position 0,0 (3x3 sum of ones)\nassert out.shape == (1, 2, 2, 1)\nprint(\"Stride verification: OK\\n\")\n\n# Test Conv2D with dilation\nprint(\"=== Verifying Conv2D with dilation=2 ===\")\nconv = Conv2D(1, 1, 3, stride=1, padding=0, dilation=2)\nconv.weights = np.ones((1, 1, 3, 3), dtype=np.float64)\nconv.bias = "]
[207.931142, "i", "np.zeros(1, dtype=np.float64)\n\n# Input: 5x5 with all ones\nx = np.ones((1, 5, 5, 1), dtype=np.float64)\nout = conv.forward(x)\nprint(f\"Input shape: {x.shape}\")\nprint(f\"Output shape: {out.shape}\")\n# With dilation=2, kernel effectively expands to 5x5\n# output = (5 + 0 - 5 - 1) // 1 + 1 = 1\nassert out.shape == (1, 1, 1, 1)\nprint(\"Dilation verification: OK\\n\")\n\n# Test BatchNorm inference mode\nprint(\"=== Verifying BatchNorm inference mode ===\")\nbn = BatchNorm2D(2)\nx = np.random.randn(4, 8, 8, 2).astype(np.float64)\n\n# First run in training mode to accumulate running stats\nbn.forward(x, training=True)\nrunning_mean_before = bn.running_mean.copy()\n\n# Run again to update stats\nbn.forward(x, training=True)\nrunning_mean_after = bn.running_mean.copy()\n\nprint(f\"Running mean before: {running_mean_before}\")\nprint(f\"Running mean after: {running_mean_after}\")\n\n# Inference should use running stats\nout_train = bn.forward(x, training=True)\nout_infer = bn.forward(x, training=False)\nprint(f\"Output shapes match: {out_train.shape == out"]
