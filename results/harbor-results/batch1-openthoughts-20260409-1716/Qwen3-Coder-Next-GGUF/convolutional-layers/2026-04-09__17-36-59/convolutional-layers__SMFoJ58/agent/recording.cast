[207.931243, "i", "_infer.shape}\")\nprint(\"BatchNorm inference: OK\\n\")\n\n# Test that __call__ works\nprint(\"=== Verifying __call__ method ===\")\nrelu = ReLU()\nx = np.array([-1, 0, 1], dtype=np.float64)\nout1 = relu.forward(x)\nout2 = relu(x)  # Using __call__\nassert np.allclose(out1, out2)\nprint(\"__call__ method: OK\\n\")\n\n# Test output dtype is always float64\nprint(\"=== Verifying float64 dtype ===\")\nfor layer_name, layer in [\n    ('Conv2D', Conv2D(3, 4, 3)),\n    ('Conv2DTranspose', Conv2DTranspose(4, 5, 3)),\n    ('MaxPool2D', MaxPool2D(2)),\n    ('AvgPool2D', AvgPool2D(2)),\n    ('BatchNorm2D', BatchNorm2D(4)),\n    ('ReLU', ReLU()),\n    ('LeakyReLU', LeakyReLU()),\n    ('Sigmoid', Sigmoid()),\n]:\n    x = np.random.randn(2, 8, 8, 4).astype(np.float64)\n    out = layer.forward(x) if hasattr(layer, 'forward') else layer(x)\n    assert out.dtype == np.float64, f\"{layer_name} should output float64, got {out.dtype}\"\n    print(f\"{layer_name}: float64 OK\")\n\nprint(\"\\n\" + \"=\"*50)\nprint(\"ALL VERIFICATION TESTS PASSED!\")\nprint(\"=\"*50)\nEOF\n"]
