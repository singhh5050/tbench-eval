[351.630616, "o", "\u001b[?2004h> "]
[351.630683, "o", "assert padded.shape == (2, 6, 6, 3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[351.630728, "o", "print(\"zero_pad: OK\")\r\n"]
[351.630739, "o", "\u001b[?2004l\r\u001b[?2004h"]
[351.630749, "o", "> \r\n\u001b[?2004l\r"]
[351.630759, "o", "\u001b[?2004h> "]
[351.63083, "o", "out = get_output_shape((28, 28), 3, 1, 1)\r\n\u001b[?2004l\r"]
[351.630847, "o", "\u001b[?2004h> "]
[351.630889, "o", "assert out == (28, 28)\r\n\u001b[?2004l\r"]
[351.630902, "o", "\u001b[?2004h> "]
[351.630981, "o", "out = get_output_shape((32, 32), 4, 2, 1)\r\n\u001b[?2004l\r"]
[351.631006, "o", "\u001b[?2004h> "]
[351.631044, "o", "assert out == (16, 16)\r\n\u001b[?2004l\r"]
[351.631055, "o", "\u001b[?2004h> "]
[351.631102, "o", "print(\"get_output_shape: OK\\n\")\r\n\u001b[?2004l\r"]
[351.631113, "o", "\u001b[?2004h> "]
[351.631124, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[351.631155, "o", "# Test BaseLayer (abstract)\r\n\u001b[?2004l\r"]
[351.631165, "o", "\u001b[?2004h> "]
[351.631199, "o", "print(\"=== Testing BaseLayer ===\")\r\n\u001b[?2004l\r"]
[351.631209, "o", "\u001b[?2004h> "]
[351.631221, "o", "try:\r\n\u001b[?2004l\r"]
[351.631231, "o", "\u001b[?2004h> "]
[351.631252, "o", "    base = BaseLayer()\r\n\u001b[?2004l\r"]
[351.631261, "o", "\u001b[?2004h> "]
[351.63133, "o", "    print(\"ERROR: Should not be able to instantiate BaseLayer\")\r\n\u001b[?2004l\r"]
[351.631341, "o", "\u001b[?2004h"]
[351.631351, "o", "> "]
[351.631361, "o", "except TypeError:\r\n\u001b[?2004l\r"]
[351.631371, "o", "\u001b[?2004h> "]
[351.631381, "o", "    pass\r\n\u001b[?2004l\r"]
[351.631392, "o", "\u001b[?2004h> "]
[351.631418, "o", "print(\"BaseLayer: OK\\n\")\r\n\u001b[?2004l\r"]
[351.631428, "o", "\u001b[?2004h> \r\n"]
[351.631439, "o", "\u001b[?2004l\r\u001b[?2004h"]
[351.63145, "o", "> "]
[351.631461, "o", "# Test Conv2D\r\n\u001b[?2004l\r"]
[351.631471, "o", "\u001b[?2004h> "]
[351.631498, "o", "print(\"=== Testing Conv2D ===\")\r\n\u001b[?2004l\r"]
[351.631509, "o", "\u001b[?2004h> "]
[351.631551, "o", "conv = Conv2D(3, 16, 3, stride=1, padding=1)\r\n\u001b[?2004l\r"]
[351.631563, "o", "\u001b[?2004h> "]
[351.63161, "o", "x = np.random.randn(2, 28, 28, 3).astype(np.float64)\r\n\u001b[?2004l\r"]
[351.631621, "o", "\u001b[?2004h> "]
[351.631642, "o", "out = conv.forward(x)\r\n\u001b[?2004l\r"]
[351.631654, "o", "\u001b[?2004h> "]
[351.631687, "o", "assert out.shape == (2, 28, 28, 16)\r\n\u001b[?2004l\r"]
[351.631696, "o", "\u001b[?2004h> "]
[351.631752, "o", "assert hasattr(conv, 'weights') and hasattr(conv, 'bias')\r\n\u001b[?2004l\r"]
[351.631762, "o", "\u001b[?2004h> "]
[351.631816, "o", "assert conv.in_channels == 3 and conv.out_channels == 16\r\n\u001b[?2004l\r"]
[351.631831, "o", "\u001b[?2004h> "]
[351.631877, "o", "assert conv.kernel_size == 3 and conv.stride == 1\r\n\u001b[?2004l\r"]
[351.631889, "o", "\u001b[?2004h> "]
[351.631932, "o", "assert conv.padding == 1 and conv.dilation == 1\r\n\u001b[?2004l\r"]
[351.631942, "o", "\u001b[?2004h> "]
[351.631971, "o", "print(\"Conv2D basic: OK\")\r\n\u001b[?2004l\r"]
[351.631986, "o", "\u001b[?2004h> \r\n"]
[351.631997, "o", "\u001b[?2004l\r\u001b[?2004h"]
[351.632007, "o", "> "]
[351.632052, "o", "conv = Conv2D(3, 8, 3, stride=2, padding=0, dilation=1)\r\n\u001b[?2004l\r"]
[351.632073, "o", "\u001b[?2004h"]
[351.632087, "o", "> "]
[351.632112, "o", "x = np.random.randn(2, 32, 32, 3).astype(np.float64)\r\n\u001b[?2004l\r"]
[351.632122, "o", "\u001b[?2004h> "]
[351.632144, "o", "out = conv.forward(x)\r\n\u001b[?2004l\r"]
[351.632154, "o", "\u001b[?2004h> "]
[351.632188, "o", "assert out.shape == (2, 15, 15, 8)\r\n\u001b[?2004l\r"]
[351.6322, "o", "\u001b[?2004h> "]
[351.632242, "o", "print(\"Conv2D stride/dilation: OK\\n\")\r\n\u001b[?2004l\r"]
[351.632254, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[351.632265, "o", "\u001b[?2004h> "]
[351.632289, "o", "# Test Conv2DTranspose\r\n\u001b[?2004l\r"]
[351.632298, "o", "\u001b[?2004h> "]
[351.632336, "o", "print(\"=== Testing Conv2DTranspose ===\")\r\n\u001b[?2004l\r"]
[351.632344, "o", "\u001b[?2004h> "]
[351.632397, "o", "conv_t = Conv2DTranspose(8, 16, 3, stride=2, padding=1)\r\n\u001b[?2004l\r"]
[351.632408, "o", "\u001b[?2004h> "]
[351.632455, "o", "x = np.random.randn(2, 16, 16, 8).astype(np.float64)\r\n\u001b[?2004l\r"]
[351.632466, "o", "\u001b[?2004h> "]
[351.632488, "o", "out = conv_t.forward(x)\r\n\u001b[?2004l\r"]
[351.6325, "o", "\u001b[?2004h> "]
[351.632537, "o", "expected_out_h = (16 - 1) * 2 - 2 * 1 + 3\r\n\u001b[?2004l\r"]
[351.632549, "o", "\u001b[?2004h> "]
[351.632586, "o", "expected_out_w = (16 - 1) * 2 - 2 * 1 + 3\r\n\u001b[?2004l\r"]
[351.632594, "o", "\u001b[?2004h> "]
[351.632651, "o", "assert out.shape == (2, expected_out_h, expected_out_w, 16)\r\n\u001b[?2004l\r"]
[351.632662, "o", "\u001b[?2004h> "]
[351.632718, "o", "assert hasattr(conv_t, 'weights') and hasattr(conv_t, 'bias')\r\n\u001b[?2004l\r"]
[351.632726, "o", "\u001b[?2004h> "]
[351.632783, "o", "assert conv_t.in_channels == 8 and conv_t.out_channels == 16\r\n\u001b[?2004l\r"]
[351.632795, "o", "\u001b[?2004h> "]
[351.632843, "o", "assert conv_t.kernel_size == 3 and conv_t.stride == 2\r\n\u001b[?2004l\r"]
[351.632859, "o", "\u001b[?2004h> "]
[351.632885, "o", "assert conv_t.padding == 1\r\n\u001b[?2004l\r"]
[351.632893, "o", "\u001b[?2004h> "]
[351.63294, "o", "print(\"Conv2DTranspose: OK\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[351.632952, "o", "> \r\n\u001b[?2004l\r"]
[351.632964, "o", "\u001b[?2004h> "]
[351.632977, "o", "# Test MaxPool2D\r\n\u001b[?2004l\r"]
[351.632988, "o", "\u001b[?2004h> "]
[351.633057, "o", "print(\"=== Testing MaxPool2D ===\")\r\n"]
[351.63307, "o", "\u001b[?2004l\r"]
[351.633093, "o", "\u001b[?2004h"]
[351.633097, "o", "> "]
[351.63312, "o", "pool = MaxPool2D(2, stride=2)\r\n\u001b[?2004l\r"]
[351.633131, "o", "\u001b[?2004h"]
[351.633141, "o", "> "]
[351.633164, "o", "x = np.random.randn(2, 32, 32, 8).astype(np.float64)\r\n\u001b[?2004l\r"]
[351.633172, "o", "\u001b[?2004h"]
[351.63318, "o", "> "]
[351.63319, "o", "out = pool.forward(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[351.6332, "o", "> "]
[351.633218, "o", "assert out.shape == (2, 16, 16, 8)\r\n\u001b[?2004l\r"]
[351.633226, "o", "\u001b[?2004h> "]
[351.633259, "o", "assert pool.kernel_size == 2 and pool.stride == 2\r\n\u001b[?2004l\r"]
[351.633278, "o", "\u001b[?2004h> "]
[351.63329, "o", "print(\"MaxPool2D: OK\\n\")\r\n"]
[351.6333, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[351.633311, "o", "\u001b[?2004h> "]
[351.633324, "o", "# Test AvgPool2D\r\n\u001b[?2004l\r"]
[351.633333, "o", "\u001b[?2004h"]
[351.633344, "o", "> "]
[351.633362, "o", "print(\"=== Testing AvgPool2D ===\")\r\n\u001b[?2004l\r"]
[351.633373, "o", "\u001b[?2004h> "]
[351.633398, "o", "pool = AvgPool2D(2, stride=2)\r\n\u001b[?2004l\r"]
[351.633408, "o", "\u001b[?2004h> "]
[351.633451, "o", "x = np.random.randn(2, 32, 32, 8).astype(np.float64)\r\n\u001b[?2004l\r"]
[351.633462, "o", "\u001b[?2004h> "]
[351.633478, "o", "out = pool.forward(x)\r\n\u001b[?2004l\r"]
[351.633488, "o", "\u001b[?2004h> "]
[351.633517, "o", "assert out.shape == (2, 16, 16, 8)\r\n\u001b[?2004l\r"]
[351.633528, "o", "\u001b[?2004h> "]
[351.633548, "o", "print(\"AvgPool2D: OK\\n\")\r\n\u001b[?2004l\r"]
[351.633558, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[351.633568, "o", "\u001b[?2004h> "]
[351.633583, "o", "# Test BatchNorm2D\r\n\u001b[?2004l\r"]
[351.633591, "o", "\u001b[?2004h"]
[351.6336, "o", "> "]
[351.633633, "o", "print(\"=== Testing BatchNorm2D ===\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[351.633666, "o", "> "]
[351.633681, "o", "bn = BatchNorm2D(16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[351.6337, "o", "x = np.random.randn(4, 8, 8, 16).astype(np.float64)\r\n"]
[351.63371, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[351.633738, "o", "out = bn.forward(x, training=True)\r\n"]
[351.633747, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[351.633776, "o", "assert out.shape == (4, 8, 8, 16)\r\n\u001b[?2004l\r"]
[351.633785, "o", "\u001b[?2004h> "]
[351.633827, "o", "assert hasattr(bn, 'gamma') and hasattr(bn, 'beta')\r\n\u001b[?2004l\r"]
[351.633837, "o", "\u001b[?2004h> "]
[351.633893, "o", "assert hasattr(bn, 'running_mean') and hasattr(bn, 'running_var')\r\n\u001b[?2004l\r"]
[351.633903, "o", "\u001b[?2004h> "]
[351.633945, "o", "assert bn.num_features == 16 and bn.eps == 1e-5 and bn.momentum == 0.1\r\n\u001b[?2004l\r"]
[351.633953, "o", "\u001b[?2004h> "]
[351.633972, "o", "print(\"BatchNorm2D: OK\\n\")\r\n\u001b[?2004l\r"]
[351.633981, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[351.63399, "o", "\u001b[?2004h> "]
[351.634, "o", "# Test ReLU\r\n\u001b[?2004l\r\u001b[?2004h"]
[351.634009, "o", "> "]
[351.634023, "o", "print(\"=== Testing ReLU ===\")\r\n\u001b[?2004l\r"]
[351.634033, "o", "\u001b[?2004h> "]
[351.634042, "o", "relu = ReLU()\r\n\u001b[?2004l\r"]
[351.634051, "o", "\u001b[?2004h> "]
[351.634088, "o", "x = np.array([[-1, 0, 1], [-2, 0.5, 2]], dtype=np.float64)\r\n\u001b[?2004l\r"]
[351.634095, "o", "\u001b[?2004h> "]
[351.634111, "o", "out = relu.forward(x)\r\n\u001b[?2004l\r"]
[351.634121, "o", "\u001b[?2004h> "]
[351.634159, "o", "expected = np.array([[0, 0, 1], [0, 0.5, 2]], dtype=np.float64)\r\n\u001b[?2004l\r"]
[351.63417, "o", "\u001b[?2004h> "]
[351.634189, "o", "assert np.allclose(out, expected)\r\n\u001b[?2004l\r"]
[351.634199, "o", "\u001b[?2004h> "]
[351.63421, "o", "print(\"ReLU: OK\\n\")\r\n\u001b[?2004l\r"]
[351.634219, "o", "\u001b[?2004h> "]
[351.634229, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[351.634238, "o", "# Test LeakyReLU\r\n\u001b[?2004l\r"]
[351.634248, "o", "\u001b[?2004h> "]
[351.634267, "o", "print(\"=== Testing LeakyReLU ===\")\r\n\u001b[?2004l\r"]
[351.634274, "o", "\u001b[?2004h> "]
[351.6343, "o", "lrelu = LeakyReLU(negative_slope=0.01)\r\n\u001b[?2004l\r"]
[351.634309, "o", "\u001b[?2004h> "]
[351.634345, "o", "x = np.array([[-1, 0, 1], [-2, 0.5, 2]], dtype=np.float64)\r\n\u001b[?2004l\r"]
[351.634354, "o", "\u001b[?2004h> "]
[351.634369, "o", "out = lrelu.forward(x)\r\n\u001b[?2004l\r"]
[351.634379, "o", "\u001b[?2004h> "]
[351.634422, "o", "expected = np.array([[-0.01, 0, 1], [-0.02, 0.5, 2]], dtype=np.float64)\r\n\u001b[?2004l\r"]
[351.634429, "o", "\u001b[?2004h> "]
[351.634452, "o", "assert np.allclose(out, expected)\r\n\u001b[?2004l\r"]
[351.63446, "o", "\u001b[?2004h> "]
[351.634482, "o", "assert lrelu.negative_slope == 0.01\r\n\u001b[?2004l\r"]
[351.634492, "o", "\u001b[?2004h> "]
[351.634506, "o", "print(\"LeakyReLU: OK\\n\")\r\n"]
[351.634516, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[351.634525, "o", "\u001b[?2004h> "]
[351.634535, "o", "# Test Sigmoid\r\n\u001b[?2004l\r"]
[351.634545, "o", "\u001b[?2004h> "]
[351.634561, "o", "print(\"=== Testing Sigmoid ===\")\r\n\u001b[?2004l\r"]
[351.63457, "o", "\u001b[?2004h> "]
[351.634582, "o", "sigmoid = Sigmoid()\r\n\u001b[?2004l\r"]
[351.63459, "o", "\u001b[?2004h> "]
[351.634621, "o", "x = np.array([0.0, 1.0, -1.0], dtype=np.float64)\r\n\u001b[?2004l\r"]
[351.634631, "o", "\u001b[?2004h> "]
[351.634645, "o", "out = sigmoid.forward(x)\r\n\u001b[?2004l\r"]
[351.634656, "o", "\u001b[?2004h> "]
[351.634686, "o", "expected = np.array([0.5, 0.73105858, 0.26894142])\r\n\u001b[?2004l\r"]
[351.634694, "o", "\u001b[?2004h> "]
[351.634724, "o", "assert np.allclose(out, expected, atol=1e-5)\r\n\u001b[?2004l\r"]
[351.634734, "o", "\u001b[?2004h> "]
[351.634747, "o", "print(\"Sigmoid: OK\\n\")\r\n\u001b[?2004l\r"]
[351.634757, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[351.634768, "o", "\u001b[?2004h> "]
[351.634779, "o", "# Test __call__ method\r\n"]
[351.634789, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[351.634814, "o", "print(\"=== Testing __call__ method ===\")\r\n\u001b[?2004l\r"]
[351.634825, "o", "\u001b[?2004h> "]
[351.634835, "o", "relu = ReLU()\r\n\u001b[?2004l\r"]
[351.634845, "o", "\u001b[?2004h> "]
[351.634872, "o", "x = np.array([-1, 0, 1], dtype=np.float64)\r\n\u001b[?2004l\r"]
[351.634882, "o", "\u001b[?2004h> "]
[351.634895, "o", "out1 = relu.forward(x)\r\n\u001b[?2004l\r"]
[351.634905, "o", "\u001b[?2004h> "]
[351.634915, "o", "out2 = relu(x)\r\n\u001b[?2004l\r"]
[351.634924, "o", "\u001b[?2004h> "]
[351.634943, "o", "assert np.allclose(out1, out2)\r\n"]
[351.634953, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[351.634972, "o", "print(\"__call__ method: OK\\n\")\r\n\u001b[?2004l\r"]
[351.634981, "o", "\u001b[?2004h> "]
[351.63499, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[351.635009, "o", "# Test all outputs are float64\r\n"]
[351.635018, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[351.635045, "o", "print(\"=== Verifying float64 dtype ===\")\r\n\u001b[?2004l\r"]
[351.635055, "o", "\u001b[?2004h> "]
[351.63507, "o", "for layer_name, layer in [\r\n\u001b[?2004l\r"]
[351.635079, "o", "\u001b[?2004h> "]
[351.6351, "o", "    ('Conv2D', Conv2D(3, 4, 3)),\r\n\u001b[?2004l\r"]
[351.635109, "o", "\u001b[?2004h> "]
[351.635142, "o", "    ('Conv2DTranspose', Conv2DTranspose(4, 5, 3)),\r\n\u001b[?2004l\r"]
[351.635151, "o", "\u001b[?2004h> "]
[351.635171, "o", "    ('MaxPool2D', MaxPool2D(2)),\r\n\u001b[?2004l\r"]
[351.63518, "o", "\u001b[?2004h> "]
[351.635201, "o", "    ('AvgPool2D', AvgPool2D(2)),\r\n\u001b[?2004l\r"]
[351.635209, "o", "\u001b[?2004h> "]
[351.635233, "o", "    ('BatchNorm2D', BatchNorm2D(4)),\r\n\u001b[?2004l\r"]
[351.635243, "o", "\u001b[?2004h> "]
[351.635255, "o", "    ('ReLU', ReLU()),\r\n\u001b[?2004l\r"]
[351.635266, "o", "\u001b[?2004h> "]
[351.635285, "o", "    ('LeakyReLU', LeakyReLU()),\r\n"]
[351.635295, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[351.635312, "o", "    ('Sigmoid', Sigmoid()),\r\n\u001b[?2004l\r"]
[351.635321, "o", "\u001b[?2004h> "]
[351.635331, "o", "]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[351.635366, "o", "    x = np.random.randn(2, 8, 8, 4).astype(np.float64)\r\n\u001b[?2004l\r"]
[351.635375, "o", "\u001b[?2004h> "]
[351.635418, "o", "    out = layer.forward(x) if hasattr(layer, 'forward') else layer(x)\r\n\u001b[?2004l\r"]
[351.635425, "o", "\u001b[?2004h> "]
[351.635486, "o", "    assert out.dtype == np.float64, f\"{layer_name} should output float64, got {out.dtype}\"\r\n"]
[351.635496, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[351.635522, "o", "print(\"All layers output float64: OK\\n\")\r\n"]
[351.635532, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
