[247.722195, "o", "\u001b[?2004h> "]
[247.722206, "o", "        \"\"\"\r\n\u001b[?2004l\r"]
[247.722219, "o", "\u001b[?2004h> "]
[247.722231, "o", "        Args:\r\n\u001b[?2004l\r"]
[247.722242, "o", "\u001b[?2004h> "]
[247.722312, "o", "            x: input of shape (batch_size, height, width, in_channels), dtype float64\r\n\u001b[?2004l\r"]
