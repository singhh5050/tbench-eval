[170.336832, "i", "t.forward(x)\nprint(f\"Input: {x.shape}\")\nprint(f\"Output: {out.shape}\")\nexpected_out_h = (16 - 1) * 2 - 2 * 1 + 3\nexpected_out_w = (16 - 1) * 2 - 2 * 1 + 3\nassert out.shape == (2, expected_out_h, expected_out_w, 16), f\"Expected (2, {expected_out_h}, {expected_out_w}, 16), got {out.shape}\"\nprint(\"Conv2DTranspose: OK\\n\")\n\n# Test MaxPool2D\nprint(\"=== Testing MaxPool2D ===\")\npool = MaxPool2D(2, stride=2)\nx = np.random.randn(2, 32, 32, 8).astype(np.float64)\nout = pool.forward(x)\nprint(f\"Input: {x.shape}\")\nprint(f\"Output: {out.shape}\")\nassert out.shape == (2, 16, 16, 8), f\"Expected (2, 16, 16, 8), got {out.shape}\"\nprint(\"MaxPool2D: OK\\n\")\n\n# Test AvgPool2D\nprint(\"=== Testing AvgPool2D ===\")\npool = AvgPool2D(2, stride=2)\nx = np.random.randn(2, 32, 32, 8).astype(np.float64)\nout = pool.forward(x)\nprint(f\"Input: {x.shape}\")\nprint(f\"Output: {out.shape}\")\nassert out.shape == (2, 16, 16, 8), f\"Expected (2, 16, 16, 8), got {out.shape}\"\nprint(\"AvgPool2D: OK\\n\")\n\n# Test BatchNorm2D\nprint(\"=== Testing BatchNorm2D ===\")\nbn = Bat"]
