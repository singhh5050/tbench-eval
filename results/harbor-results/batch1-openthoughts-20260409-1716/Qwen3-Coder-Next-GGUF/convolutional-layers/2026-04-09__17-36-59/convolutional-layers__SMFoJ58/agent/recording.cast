[377.917064, "i", "python3 << 'EOF'\nimport numpy as np\nimport sys\nsys.path.insert(0, '/app')\n\nfrom src import *\n\nprint(\"Testing all layers with correct channel counts...\\n\")\n\n# Test all outputs are float64 with correct channel counts\nprint(\"=== Verifying float64 dtype ===\")\nfor layer_name, layer, in_ch in [\n    ('Conv2D', Conv2D(3, 4, 3), 3),\n    ('Conv2DTranspose', Conv2DTranspose(4, 5, 3), 4),\n    ('MaxPool2D', MaxPool2D(2), 4),\n    ('AvgPool2D', AvgPool2D(2), 4),\n    ('BatchNorm2D', BatchNorm2D(4), 4),\n    ('ReLU', ReLU(), 4),\n    ('LeakyReLU', LeakyReLU(), 4),\n    ('Sigmoid', Sigmoid(), 4),\n]:\n    x = np.random.randn(2, 8, 8, in_ch).astype(np.float64)\n    out = layer.forward(x) if hasattr(layer, 'forward') else layer(x)\n    assert out.dtype == np.float64, f\"{layer_name} should output float64, got {out.dtype}\"\n    print(f\"{layer_name}: float64 OK\")\n\nprint(\"\\n\" + \"=\"*50)\nprint(\"ALL LAYERS VERIFIED!\")\nprint(\"=\"*50)\nEOF\n"]
