[170.336544, "i", "python3 << 'EOF'\nimport numpy as np\nimport sys\nsys.path.insert(0, '/app')\n\nfrom src import *\n\nprint(\"Testing all layers...\\n\")\n\n# Test padding\nprint(\"=== Testing padding ===\")\nx = np.ones((2, 4, 4, 3), dtype=np.float64)\npadded = zero_pad(x, 1)\nprint(f\"Original shape: {x.shape}\")\nprint(f\"Padded shape: {padded.shape}\")\nassert padded.shape == (2, 6, 6, 3), f\"Expected (2, 6, 6, 3), got {padded.shape}\"\nprint(\"zero_pad: OK\\n\")\n\n# Test get_output_shape\nprint(\"=== Testing get_output_shape ===\")\nout = get_output_shape((28, 28), 3, 1, 1)\nprint(f\"(28, 28) with k=3, s=1, p=1: {out}\")\nassert out == (28, 28), f\"Expected (28, 28), got {out}\"\n\nout = get_output_shape((32, 32), 4, 2, 1)\nprint(f\"(32, 32) with k=4, s=2, p=1: {out}\")\nassert out == (16, 16), f\"Expected (16, 16), got {out}\"\nprint(\"get_output_shape: OK\\n\")\n\n# Test BaseLayer (abstract)\nprint(\"=== Testing BaseLayer ===\")\ntry:\n    base = BaseLayer()\n    print(\"ERROR: Should not be able to instantiate BaseLayer\")\nexcept TypeError as e:\n    print(f\"Cannot instantiate Bas"]
[170.336726, "i", "eLayer (expected): {e}\")\nprint(\"BaseLayer: OK\\n\")\n\n# Test Conv2D\nprint(\"=== Testing Conv2D ===\")\nconv = Conv2D(3, 16, 3, stride=1, padding=1)\nx = np.random.randn(2, 28, 28, 3).astype(np.float64)\nout = conv.forward(x)\nprint(f\"Input: {x.shape}\")\nprint(f\"Output: {out.shape}\")\nassert out.shape == (2, 28, 28, 16), f\"Expected (2, 28, 28, 16), got {out.shape}\"\nassert hasattr(conv, 'weights') and hasattr(conv, 'bias')\nprint(\"Conv2D: OK\\n\")\n\n# Test Conv2D with stride and dilation\nprint(\"=== Testing Conv2D with stride and dilation ===\")\nconv = Conv2D(3, 8, 3, stride=2, padding=0, dilation=1)\nx = np.random.randn(2, 32, 32, 3).astype(np.float64)\nout = conv.forward(x)\nprint(f\"Input: {x.shape}\")\nprint(f\"Output: {out.shape}\")\nassert out.shape == (2, 15, 15, 8), f\"Expected (2, 15, 15, 8), got {out.shape}\"\nprint(\"Conv2D stride/dilation: OK\\n\")\n\n# Test Conv2DTranspose\nprint(\"=== Testing Conv2DTranspose ===\")\nconv_t = Conv2DTranspose(8, 16, 3, stride=2, padding=1)\nx = np.random.randn(2, 16, 16, 8).astype(np.float64)\nout = conv_"]
