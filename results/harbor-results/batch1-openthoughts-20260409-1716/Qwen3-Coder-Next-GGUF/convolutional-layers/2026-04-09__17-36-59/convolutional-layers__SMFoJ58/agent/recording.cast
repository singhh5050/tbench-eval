[351.630178, "i", "axPool2D(2)),\n    ('AvgPool2D', AvgPool2D(2)),\n    ('BatchNorm2D', BatchNorm2D(4)),\n    ('ReLU', ReLU()),\n    ('LeakyReLU', LeakyReLU()),\n    ('Sigmoid', Sigmoid()),\n]:\n    x = np.random.randn(2, 8, 8, 4).astype(np.float64)\n    out = layer.forward(x) if hasattr(layer, 'forward') else layer(x)\n    assert out.dtype == np.float64, f\"{layer_name} should output float64, got {out.dtype}\"\nprint(\"All layers output float64: OK\\n\")\n\nprint(\"=\"*50)\nprint(\"ALL TESTS PASSED!\")\nprint(\"=\"*50)\nEOF\n"]
