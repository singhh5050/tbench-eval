[247.723048, "o", "> "]
[247.723132, "o", "        output = np.zeros((batch_size, out_h, out_w, self.out_channels), dtype=np.float64)\r\n\u001b[?2004l\r"]
[247.723146, "o", "\u001b[?2004h> "]
