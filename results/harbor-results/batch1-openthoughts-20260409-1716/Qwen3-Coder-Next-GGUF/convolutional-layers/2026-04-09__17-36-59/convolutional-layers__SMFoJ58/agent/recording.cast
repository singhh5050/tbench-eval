[170.336935, "i", "chNorm2D(16)\nx = np.random.randn(4, 8, 8, 16).astype(np.float64)\nout = bn.forward(x, training=True)\nprint(f\"Input: {x.shape}\")\nprint(f\"Output: {out.shape}\")\nassert out.shape == (4, 8, 8, 16), f\"Expected (4, 8, 8, 16), got {out.shape}\"\nassert hasattr(bn, 'gamma') and hasattr(bn, 'beta')\nassert hasattr(bn, 'running_mean') and hasattr(bn, 'running_var')\nprint(\"BatchNorm2D: OK\\n\")\n\n# Test ReLU\nprint(\"=== Testing ReLU ===\")\nrelu = ReLU()\nx = np.array([[-1, 0, 1], [-2, 0.5, 2]], dtype=np.float64)\nout = relu.forward(x)\nexpected = np.array([[0, 0, 1], [0, 0.5, 2]], dtype=np.float64)\nassert np.allclose(out, expected), f\"Expected {expected}, got {out}\"\nprint(\"ReLU: OK\\n\")\n\n# Test LeakyReLU\nprint(\"=== Testing LeakyReLU ===\")\nlrelu = LeakyReLU(negative_slope=0.01)\nx = np.array([[-1, 0, 1], [-2, 0.5, 2]], dtype=np.float64)\nout = lrelu.forward(x)\nexpected = np.array([[-0.01, 0, 1], [-0.02, 0.5, 2]], dtype=np.float64)\nassert np.allclose(out, expected), f\"Expected {expected}, got {out}\"\nassert lrelu.negative_slope == 0.01\npr"]
