[351.630134, "i", "est LeakyReLU\nprint(\"=== Testing LeakyReLU ===\")\nlrelu = LeakyReLU(negative_slope=0.01)\nx = np.array([[-1, 0, 1], [-2, 0.5, 2]], dtype=np.float64)\nout = lrelu.forward(x)\nexpected = np.array([[-0.01, 0, 1], [-0.02, 0.5, 2]], dtype=np.float64)\nassert np.allclose(out, expected)\nassert lrelu.negative_slope == 0.01\nprint(\"LeakyReLU: OK\\n\")\n\n# Test Sigmoid\nprint(\"=== Testing Sigmoid ===\")\nsigmoid = Sigmoid()\nx = np.array([0.0, 1.0, -1.0], dtype=np.float64)\nout = sigmoid.forward(x)\nexpected = np.array([0.5, 0.73105858, 0.26894142])\nassert np.allclose(out, expected, atol=1e-5)\nprint(\"Sigmoid: OK\\n\")\n\n# Test __call__ method\nprint(\"=== Testing __call__ method ===\")\nrelu = ReLU()\nx = np.array([-1, 0, 1], dtype=np.float64)\nout1 = relu.forward(x)\nout2 = relu(x)\nassert np.allclose(out1, out2)\nprint(\"__call__ method: OK\\n\")\n\n# Test all outputs are float64\nprint(\"=== Verifying float64 dtype ===\")\nfor layer_name, layer in [\n    ('Conv2D', Conv2D(3, 4, 3)),\n    ('Conv2DTranspose', Conv2DTranspose(4, 5, 3)),\n    ('MaxPool2D', M"]
