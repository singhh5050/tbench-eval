[112.376132, "i", "cat > /app/src/padding.py << 'EOF'\nimport numpy as np\n\n\ndef zero_pad(x: np.ndarray, pad: int) -> np.ndarray:\n    \"\"\"Add zero padding to the input array.\n    \n    Args:\n        x: input of shape (batch_size, height, width, channels), dtype float64\n        pad: padding size (same padding on all sides)\n    \n    Returns:\n        padded array of shape (batch_size, height + 2*pad, width + 2*pad, channels), dtype float64\n    \"\"\"\n    if pad == 0:\n        return x\n    return np.pad(x, ((0, 0), (pad, pad), (pad, pad), (0, 0)), mode='constant', constant_values=0)\n\n\ndef get_output_shape(input_shape: tuple, kernel_size: int, stride: int, padding: int, dilation: int = 1) -> tuple:\n    \"\"\"Calculate output shape for convolution operation.\n    \n    Args:\n        input_shape: (height, width) tuple of integers\n        kernel_size: size of square kernel\n        stride: stride of convolution\n        padding: zero-padding added to both sides\n        dilation: spacing between kernel elements (default 1)\n    \n    Returns:\n        (o"]
[112.376307, "i", "utput_height, output_width) tuple of integers\n    \n    Formula: output_dim = (input_dim + 2*padding - dilation*(kernel_size-1) - 1) // stride + 1\n    \"\"\"\n    input_height, input_width = input_shape\n    output_height = (input_height + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\n    output_width = (input_width + 2 * padding - dilation * (kernel_size - 1) - 1) // stride + 1\n    return (output_height, output_width)\nEOF\n"]
[112.376375, "o", "cat > /app/src/padding.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def zero_pad(x: np.ndarray, pad: int) -> np.ndarray:\r\n\u001b[?2004l\r\u001b[?2004h> "]
