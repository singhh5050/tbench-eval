[247.720749, "o", "\u001b[?2004h> "]
[247.720888, "o", "            stride: stride of convolution (positive integer, default 1)\r\n"]
[247.720894, "o", "\u001b[?2004l\r"]
[247.720927, "o", "\u001b[?2004h"]
[247.720961, "o", "> "]
[247.721013, "o", "            padding: zero-padding added to both sides (non-negative integer, default 0)\r\n\u001b[?2004l\r"]
[247.721031, "o", "\u001b[?2004h> "]
[247.721107, "o", "            dilation: spacing between kernel elements (positive integer, default 1)\r\n\u001b[?2004l\r"]
[247.721122, "o", "\u001b[?2004h"]
[247.721135, "o", "> "]
[247.721148, "o", "        \"\"\"\r\n"]
[247.721181, "o", "\u001b[?2004l\r"]
[247.72121, "o", "\u001b[?2004h> "]
[247.721235, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.721247, "o", "        self.in_channels = in_channels\r\n\u001b[?2004l\r"]
[247.721262, "o", "\u001b[?2004h> "]
[247.721292, "o", "        self.out_channels = out_channels\r\n"]
[247.721307, "o", "\u001b[?2004l\r\u001b[?2004h"]
[247.721321, "o", "> "]
[247.721337, "o", "        self.kernel_size = kernel_size\r\n\u001b[?2004l\r"]
[247.72137, "o", "\u001b[?2004h> "]
[247.721416, "o", "        self.stride = stride\r\n\u001b[?2004l\r\u001b[?2004h>         self.padding = padding\r\n\u001b[?2004l\r"]
[247.72146, "o", "\u001b[?2004h> "]
[247.721491, "o", "        self.dilation = dilation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.721513, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[247.721551, "o", "        # Xavier/Glorot uniform initialization\r\n\u001b[?2004l\r"]
[247.721567, "o", "\u001b[?2004h> "]
[247.721613, "o", "        fan_in = in_channels * kernel_size * kernel_size\r\n\u001b[?2004l\r"]
[247.721619, "o", "\u001b[?2004h> "]
[247.721673, "o", "        fan_out = out_channels * kernel_size * kernel_size\r\n\u001b[?2004l\r"]
[247.721697, "o", "\u001b[?2004h> "]
[247.72173, "o", "        limit = np.sqrt(6.0 / (fan_in + fan_out))\r\n\u001b[?2004l\r"]
[247.72175, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[247.721766, "o", "\u001b[?2004h> "]
[247.721827, "o", "        # Weights shape: (out_channels, in_channels, kernel_size, kernel_size)\r\n\u001b[?2004l\r"]
[247.721839, "o", "\u001b[?2004h> "]
[247.721892, "o", "        self.weights = np.random.uniform(-limit, limit, \r\n\u001b[?2004l\r"]
[247.721905, "o", "\u001b[?2004h> "]
[247.722005, "o", "                                          (out_channels, in_channels, kernel_size, kernel_size)).astype(np.float64)\r\n\u001b[?2004l\r"]
[247.722022, "o", "\u001b[?2004h> "]
[247.722046, "o", "        # Bias shape: (out_channels,)\r\n\u001b[?2004l\r"]
[247.722059, "o", "\u001b[?2004h> "]
