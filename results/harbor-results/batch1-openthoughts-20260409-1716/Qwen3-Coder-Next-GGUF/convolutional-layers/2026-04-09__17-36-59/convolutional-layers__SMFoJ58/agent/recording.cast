[351.629786, "i", "python3 << 'EOF'\nimport numpy as np\nimport sys\nsys.path.insert(0, '/app')\n\nfrom src import *\n\nprint(\"Running comprehensive test suite...\\n\")\n\n# Test padding\nprint(\"=== Testing padding ===\")\nx = np.ones((2, 4, 4, 3), dtype=np.float64)\npadded = zero_pad(x, 1)\nassert padded.shape == (2, 6, 6, 3)\nprint(\"zero_pad: OK\")\n\nout = get_output_shape((28, 28), 3, 1, 1)\nassert out == (28, 28)\nout = get_output_shape((32, 32), 4, 2, 1)\nassert out == (16, 16)\nprint(\"get_output_shape: OK\\n\")\n\n# Test BaseLayer (abstract)\nprint(\"=== Testing BaseLayer ===\")\ntry:\n    base = BaseLayer()\n    print(\"ERROR: Should not be able to instantiate BaseLayer\")\nexcept TypeError:\n    pass\nprint(\"BaseLayer: OK\\n\")\n\n# Test Conv2D\nprint(\"=== Testing Conv2D ===\")\nconv = Conv2D(3, 16, 3, stride=1, padding=1)\nx = np.random.randn(2, 28, 28, 3).astype(np.float64)\nout = conv.forward(x)\nassert out.shape == (2, 28, 28, 16)\nassert hasattr(conv, 'weights') and hasattr(conv, 'bias')\nassert conv.in_channels == 3 and conv.out_channels == 16\nassert conv.kernel_"]
[351.630005, "i", "size == 3 and conv.stride == 1\nassert conv.padding == 1 and conv.dilation == 1\nprint(\"Conv2D basic: OK\")\n\nconv = Conv2D(3, 8, 3, stride=2, padding=0, dilation=1)\nx = np.random.randn(2, 32, 32, 3).astype(np.float64)\nout = conv.forward(x)\nassert out.shape == (2, 15, 15, 8)\nprint(\"Conv2D stride/dilation: OK\\n\")\n\n# Test Conv2DTranspose\nprint(\"=== Testing Conv2DTranspose ===\")\nconv_t = Conv2DTranspose(8, 16, 3, stride=2, padding=1)\nx = np.random.randn(2, 16, 16, 8).astype(np.float64)\nout = conv_t.forward(x)\nexpected_out_h = (16 - 1) * 2 - 2 * 1 + 3\nexpected_out_w = (16 - 1) * 2 - 2 * 1 + 3\nassert out.shape == (2, expected_out_h, expected_out_w, 16)\nassert hasattr(conv_t, 'weights') and hasattr(conv_t, 'bias')\nassert conv_t.in_channels == 8 and conv_t.out_channels == 16\nassert conv_t.kernel_size == 3 and conv_t.stride == 2\nassert conv_t.padding == 1\nprint(\"Conv2DTranspose: OK\\n\")\n\n# Test MaxPool2D\nprint(\"=== Testing MaxPool2D ===\")\npool = MaxPool2D(2, stride=2)\nx = np.random.randn(2, 32, 32, 8).astype(np.float64)\no"]
