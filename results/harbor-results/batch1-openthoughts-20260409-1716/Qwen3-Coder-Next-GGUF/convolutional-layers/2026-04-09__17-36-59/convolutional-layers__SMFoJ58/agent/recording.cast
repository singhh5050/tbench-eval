[112.486594, "o", "        limit = np.sqrt(6.0 / (fan_in + fan_out))\r\n\u001b[?2004l\r"]
[112.486623, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.486685, "o", "        # Weights shape: (out_channels, in_channels, kernel_size, kernel_size)\r\n\u001b[?2004l\r"]
[112.486698, "o", "\u001b[?2004h> "]
[112.486747, "o", "        self.weights = np.random.uniform(-limit, limit, \r\n\u001b[?2004l\r"]
[112.486761, "o", "\u001b[?2004h> "]
[112.486867, "o", "                                          (out_channels, in_channels, kernel_size, kernel_size)).astype(np.float64)\r\n\u001b[?2004l\r"]
[112.486881, "o", "\u001b[?2004h> "]
[112.486911, "o", "        # Bias shape: (out_channels,)\r\n\u001b[?2004l\r"]
[112.486921, "o", "\u001b[?2004h> "]
[112.486979, "o", "        self.bias = np.zeros(out_channels, dtype=np.float64)\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.486992, "o", ">     \r\n\u001b[?2004l\r"]
[112.487005, "o", "\u001b[?2004h> "]
[112.487046, "o", "    def forward(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r"]
[112.48706, "o", "\u001b[?2004h> "]
[112.487073, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.487085, "o", "> "]
[112.487099, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.48711, "o", "> "]
[112.487178, "o", "            x: input of shape (batch_size, height, width, in_channels), dtype float64\r\n\u001b[?2004l\r"]
[112.487197, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[112.487213, "o", "\u001b[?2004h> "]
[112.487224, "o", "        Returns:\r\n\u001b[?2004l\r"]
[112.487236, "o", "\u001b[?2004h> "]
[112.487314, "o", "            output of shape (batch_size, out_height, out_width, out_channels), dtype float64\r\n\u001b[?2004l\r"]
[112.487327, "o", "\u001b[?2004h> "]
[112.487341, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.487384, "o", "        batch_size, height, width, _ = x.shape\r\n\u001b[?2004l\r"]
[112.487397, "o", "\u001b[?2004h> "]
[112.487411, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.487434, "o", "        # Apply padding\r\n\u001b[?2004l\r"]
[112.487446, "o", "\u001b[?2004h> "]
[112.487485, "o", "        x_padded = zero_pad(x, self.padding)\r\n\u001b[?2004l\r"]
[112.487497, "o", "\u001b[?2004h> "]
[112.487511, "o", "        \r\n\u001b[?2004l\r"]
[112.487525, "o", "\u001b[?2004h> "]
[112.487549, "o", "        # Calculate output dimensions\r\n\u001b[?2004l\r"]
[112.487561, "o", "\u001b[?2004h> "]
[112.487685, "o", "        out_h = (height + 2 * self.padding - self.dilation * (self.kernel_size - 1) - 1) // self.stride + 1\r\n\u001b[?2004l\r"]
[112.487697, "o", "\u001b[?2004h> "]
[112.487788, "o", "        out_w = (width + 2 * self.padding - self.dilation * (self.kernel_size - 1) - 1) // self.stride + 1\r\n\u001b[?2004l\r"]
[112.4878, "o", "\u001b[?2004h> "]
[112.487811, "o", "        \r\n"]
[112.487824, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[112.487902, "o", "        output = np.zeros((batch_size, out_h, out_w, self.out_channels), dtype=np.float64)\r\n\u001b[?2004l\r"]
[112.487912, "o", "\u001b[?2004h"]
[112.487924, "o", "> "]
[112.487938, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.487959, "o", "        # Perform convolution\r\n\u001b[?2004l\r"]
[112.487969, "o", "\u001b[?2004h> "]
[112.488002, "o", "        for b in range(batch_size):\r\n\u001b[?2004l\r"]
[112.488013, "o", "\u001b[?2004h> "]
[112.48806, "o", "            for c_out in range(self.out_channels):\r\n\u001b[?2004l\r"]
[112.488072, "o", "\u001b[?2004h> "]
[112.488105, "o", "                for i in range(out_h):\r\n\u001b[?2004l\r"]
[112.488117, "o", "\u001b[?2004h> "]
[112.488153, "o", "                    for j in range(out_w):\r\n\u001b[?2004l\r"]
[112.488164, "o", "\u001b[?2004h> "]
[112.488207, "o", "                        # Calculate input position\r\n\u001b[?2004l\r"]
[112.48822, "o", "\u001b[?2004h> "]
[112.488261, "o", "                        h_start = i * self.stride\r\n\u001b[?2004l\r"]
[112.488273, "o", "\u001b[?2004h> "]
[112.488315, "o", "                        w_start = j * self.stride\r\n\u001b[?2004l\r"]
[112.488326, "o", "\u001b[?2004h> "]
[112.488347, "o", "                        \r\n\u001b[?2004l\r"]
[112.488359, "o", "\u001b[?2004h> "]
[112.488408, "o", "                        # Extract region (with dilation)\r\n\u001b[?2004l\r"]
[112.488421, "o", "\u001b[?2004h> "]
[112.488518, "o", "                        region = np.zeros((self.kernel_size, self.kernel_size, self.in_channels), dtype=np.float64)\r\n\u001b[?2004l\r"]
[112.488531, "o", "\u001b[?2004h> "]
[112.48858, "o", "                        for ki in range(self.kernel_size):\r\n\u001b[?2004l\r"]
[112.488592, "o", "\u001b[?2004h> "]
[112.488645, "o", "                            for kj in range(self.kernel_size):\r\n\u001b[?2004l\r"]
[112.488657, "o", "\u001b[?2004h> "]
[112.488715, "o", "                                h_idx = h_start + ki * self.dilation\r\n\u001b[?2004l\r"]
[112.488728, "o", "\u001b[?2004h> "]
[112.488785, "o", "                                w_idx = w_start + kj * self.dilation\r\n\u001b[?2004l\r"]
[112.488798, "o", "\u001b[?2004h> "]
[112.489345, "o", "                                region[ki, kj, :] = x_padded[b, h_idx, w_idx, :]\r\n"]
[112.489362, "o", "\u001b[?2004l\r"]
[112.489394, "o", "\u001b[?2004h> "]
[112.489419, "o", "                        \r\n\u001b[?2004l\r"]
[112.489433, "o", "\u001b[?2004h> "]
[112.489494, "o", "                        # Convolution: sum over in_channels, kernel_h, kernel_w\r\n\u001b[?2004l\r"]
[112.489507, "o", "\u001b[?2004h> "]
[112.489572, "o", "                        kernel = self.weights[c_out]  # (in_channels, kernel_size, kernel_size)\r\n\u001b[?2004l\r"]
[112.489587, "o", "\u001b[?2004h> "]
[112.489665, "o", "                        conv_sum = np.sum(region * kernel.transpose(1, 2, 0))  # transpose to match region shape\r\n\u001b[?2004l\r"]
[112.489678, "o", "\u001b[?2004h> "]
[112.4897, "o", "                        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.489762, "o", "                        output[b, i, j, c_out] = conv_sum + self.bias[c_out]\r\n\u001b[?2004l\r"]
[112.489776, "o", "\u001b[?2004h> "]
[112.489789, "o", "        \r\n\u001b[?2004l\r"]
[112.489803, "o", "\u001b[?2004h> "]
[112.489819, "o", "        return output\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.489831, "o", "> EOF\r\n\u001b[?2004l\r"]
[112.490744, "o", "\u001b[?2004hroot@b05171444938:/app# "]
[112.571277, "i", "cat > /app/src/conv_transpose.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass Conv2DTranspose(BaseLayer):\n    \"\"\"2D Transposed Convolution layer (deconvolution/upsampling).\"\"\"\n    \n    def __init__(self, in_channels: int, out_channels: int, kernel_size: int,\n                 stride: int = 1, padding: int = 0):\n        \"\"\"\n        Args:\n            in_channels: number of input channels (positive integer)\n            out_channels: number of output filters (positive integer)\n            kernel_size: size of square kernel (positive integer)\n            stride: stride of transposed convolution (positive integer, default 1)\n            padding: zero-padding to remove from output (non-negative integer, default 0)\n        \"\"\"\n        super().__init__()\n        self.in_channels = in_channels\n        self.out_channels = out_channels\n        self.kernel_size = kernel_size\n        self.stride = stride\n        self.padding = padding\n        \n        # Xavier/Glorot uniform initialization\n        fan_in "]
[112.571412, "i", "= in_channels * kernel_size * kernel_size\n        fan_out = out_channels * kernel_size * kernel_size\n        limit = np.sqrt(6.0 / (fan_in + fan_out))\n        \n        # Weights shape: (in_channels, out_channels, kernel_size, kernel_size)\n        self.weights = np.random.uniform(-limit, limit,\n                                          (in_channels, out_channels, kernel_size, kernel_size)).astype(np.float64)\n        # Bias shape: (out_channels,)\n        self.bias = np.zeros(out_channels, dtype=np.float64)\n    \n    def forward(self, x: np.ndarray) -> np.ndarray:\n        \"\"\"\n        Args:\n            x: input of shape (batch_size, height, width, in_channels), dtype float64\n        \n        Returns:\n            output of shape (batch_size, out_height, out_width, out_channels), dtype float64\n        \n        Output size formula: out_dim = (in_dim - 1) * stride - 2*padding + kernel_size\n        \"\"\"\n        batch_size, height, width, _ = x.shape\n        \n        # Calculate output dimensions\n        out_h = (height "]
[112.571458, "o", "cat > /app/src/conv_transpose.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.571469, "i", "- 1) * self.stride - 2 * self.padding + self.kernel_size\n        out_w = (width - 1) * self.stride - 2 * self.padding + self.kernel_size\n        \n        output = np.zeros((batch_size, out_h, out_w, self.out_channels), dtype=np.float64)\n        \n        # Perform transposed convolution\n        for b in range(batch_size):\n            for i in range(height):\n                for j in range(width):\n                    # For each input position, spread to output positions\n                    h_out = i * self.stride - self.padding\n                    w_out = j * self.stride - self.padding\n                    \n                    for ki in range(self.kernel_size):\n                        for kj in range(self.kernel_size):\n                            h_idx = h_out + ki\n                            w_idx = w_out + kj\n                            \n                            if 0 <= h_idx < out_h and 0 <= w_idx < out_w:\n                                # For each output channel\n                                for c_out in"]
[112.571524, "o", "from .base import BaseLayer\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.571543, "i", " range(self.out_channels):\n                                    # Sum over input channels and kernel weights\n                                    for c_in in range(self.in_channels):\n                                        val = x[b, i, j, c_in]\n                                        kernel_val = self.weights[c_in, c_out, ki, kj]\n                                        output[b, h_idx, w_idx, c_out] += val * kernel_val\n        \n        # Add bias\n        for b in range(batch_size):\n            for i in range(out_h):\n                for j in range(out_w):\n                    output[b, i, j, :] += self.bias\n        \n        return output\nEOF\n"]
[112.57156, "o", "- 1) * self.stride - 2 * self.padding + self.kernel_size\r\n        out_w = (width - 1) * self.stride - 2 * self.padding + self.kernel_size\r\n        \r\n        output = np.zeros((batch_size, out_h, out_w, self.out_channels), dtype=np.float64)\r\n        \r\n        # Perform transposed convolution\r\n        for b in range(batch_size):\r\n            for i in range(height):\r\n                for j in range(width):\r\n                    # For each input position, spread to output positions\r\n                    h_out = i * self.stride - self.padding\r\n                    "]
[112.571575, "o", "w_out = j * self.stride - self.padding\r\n                    \r\n                    for ki in "]
[112.571589, "o", "range(self.kernel_size):\r\n                        for kj in range(self.kernel_size):\r\n           "]
[112.571605, "o", "                 h_idx = h_out + ki\r\n                            w_idx = w_out + kj\r\n "]
[112.57162, "o", "                           \r\n                            if 0 <= h_idx < out_h and 0 <= w_idx < out_w"]
[112.571633, "o", ":\r\n                                # For each output channel\r\n                                for c_out in"]
[112.571648, "o", " range(self.out_channels):\r\n                             "]
[112.571663, "o", "       # Sum over input channels and kernel weights\r\n             "]
[112.571679, "o", "                       for c_in in range(self.in_channels):\r\n                "]
[112.571694, "o", "                        val = x[b, i, j, c_in]\r\n                                        kernel_val = self.weights[c_in, c_out"]
[112.571708, "o", ", ki, kj]\r\n                 "]
[112.571723, "o", "                       output[b, h_idx, w_idx, c_out] += val * kernel_val\r\n        \r\n        # Add bi"]
[112.571738, "o", "as\r\n        for b in range(batch_size):\r\n        "]
[112.571755, "o", "    for i in range(out_h):\r\n                for j in range(out_w):\r\n                    output[b, i, j, :] += self.bias\r\n        \r\n        return output\r\nEOF\r\n\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.571816, "o", "class Conv2DTranspose(BaseLayer):\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.571834, "o", "> "]
[112.571883, "o", "    \"\"\"2D Transposed Convolution layer (deconvolution/upsampling).\"\"\"\r\n\u001b[?2004l\r"]
[112.571894, "o", "\u001b[?2004h> "]
[112.571908, "o", "    \r\n\u001b[?2004l\r"]
[112.571921, "o", "\u001b[?2004h> "]
[112.571968, "o", "    def __init__(self, in_channels: int, out_channels: int, kernel_size: int,\r\n\u001b[?2004l\r"]
[112.571981, "o", "\u001b[?2004h> "]
[112.572019, "o", "                 stride: int = 1, padding: int = 0):\r\n\u001b[?2004l\r"]
[112.572031, "o", "\u001b[?2004h> "]
[112.572043, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.572057, "o", ">         Args:\r\n\u001b[?2004l\r"]
[112.572067, "o", "\u001b[?2004h> "]
[112.572115, "o", "            in_channels: number of input channels (positive integer)\r\n\u001b[?2004l\r"]
[112.572129, "o", "\u001b[?2004h> "]
[112.572171, "o", "            out_channels: number of output filters (positive integer)\r\n\u001b[?2004l\r"]
[112.572177, "o", "\u001b[?2004h> "]
[112.572232, "o", "            kernel_size: size of square kernel (positive integer)\r\n\u001b[?2004l\r"]
[112.572252, "o", "\u001b[?2004h> "]
[112.572308, "o", "            stride: stride of transposed convolution (positive integer, default 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.572374, "o", "            padding: zero-padding to remove from output (non-negative integer, default 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.57242, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.572439, "o", "> "]
[112.572454, "o", "        self.in_channels = in_channels\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.572488, "o", "        self.out_channels = out_channels\r\n\u001b[?2004l\r"]
[112.572503, "o", "\u001b[?2004h> "]
[112.572528, "o", "        self.kernel_size = kernel_size\r\n\u001b[?2004l\r"]
[112.57254, "o", "\u001b[?2004h> "]
[112.572557, "o", "        self.stride = stride\r\n\u001b[?2004l\r"]
[112.572572, "o", "\u001b[?2004h> "]
[112.572592, "o", "        self.padding = padding\r\n\u001b[?2004l\r"]
[112.572606, "o", "\u001b[?2004h> "]
[112.57262, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.572654, "o", "        # Xavier/Glorot uniform initialization\r\n\u001b[?2004l\r"]
[112.572667, "o", "\u001b[?2004h> "]
[112.572704, "o", "        fan_in = in_channels * kernel_size * kernel_size\r\n\u001b[?2004l\r"]
[112.572717, "o", "\u001b[?2004h> "]
[112.572754, "o", "        fan_out = out_channels * kernel_size * kernel_size\r\n\u001b[?2004l\r"]
[112.572768, "o", "\u001b[?2004h> "]
[112.5728, "o", "        limit = np.sqrt(6.0 / (fan_in + fan_out))\r\n\u001b[?2004l\r"]
[112.572813, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[112.572827, "o", "\u001b[?2004h> "]
[112.572888, "o", "        # Weights shape: (in_channels, out_channels, kernel_size, kernel_size)\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.572902, "o", "> "]
[112.572938, "o", "        self.weights = np.random.uniform(-limit, limit,\r\n\u001b[?2004l\r"]
[112.572951, "o", "\u001b[?2004h> "]
[112.573025, "o", "                                          (in_channels, out_channels, kernel_size, kernel_size)).astype(np.float64)\r\n\u001b[?2004l\r"]
[112.573041, "o", "\u001b[?2004h> "]
[112.573065, "o", "        # Bias shape: (out_channels,)\r\n\u001b[?2004l\r"]
[112.573079, "o", "\u001b[?2004h> "]
[112.573116, "o", "        self.bias = np.zeros(out_channels, dtype=np.float64)\r\n\u001b[?2004l\r"]
[112.573129, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[112.573143, "o", "\u001b[?2004h> "]
[112.573182, "o", "    def forward(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.573195, "o", "        \"\"\"\r\n\u001b[?2004l\r"]
[112.573207, "o", "\u001b[?2004h> "]
[112.57322, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.573279, "o", "            x: input of shape (batch_size, height, width, in_channels), dtype float64\r\n\u001b[?2004l\r"]
[112.573293, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[112.573307, "o", "\u001b[?2004h> "]
[112.57332, "o", "        Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.573384, "o", "            output of shape (batch_size, out_height, out_width, out_channels), dtype float64\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.573397, "o", ">         \r\n\u001b[?2004l\r"]
[112.57341, "o", "\u001b[?2004h> "]
[112.573468, "o", "        Output size formula: out_dim = (in_dim - 1) * stride - 2*padding + kernel_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.573482, "o", "        \"\"\"\r\n\u001b[?2004l\r"]
[112.573495, "o", "\u001b[?2004h> "]
[112.573536, "o", "        batch_size, height, width, _ = x.shape\r\n\u001b[?2004l\r"]
[112.573574, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.573594, "o", "        # Calculate output dimensions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.573644, "o", "        out_h = (height - 1) * self.stride - 2 * self.padding + self.kernel_size\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.57366, "o", "> "]
[112.573703, "o", "        out_w = (width - 1) * self.stride - 2 * self.padding + self.kernel_size\r\n\u001b[?2004l\r"]
[112.573718, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[112.573731, "o", "\u001b[?2004h> "]
[112.573784, "o", "        output = np.zeros((batch_size, out_h, out_w, self.out_channels), dtype=np.float64)\r\n\u001b[?2004l\r"]
[112.5738, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[112.573814, "o", "\u001b[?2004h> "]
[112.573835, "o", "        # Perform transposed convolution\r\n\u001b[?2004l\r"]
[112.573858, "o", "\u001b[?2004h> "]
[112.573878, "o", "        for b in range(batch_size):\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.573893, "o", "> "]
[112.573909, "o", "            for i in range(height):\r\n\u001b[?2004l\r"]
[112.573925, "o", "\u001b[?2004h> "]
[112.573944, "o", "                for j in range(width):\r\n\u001b[?2004l\r"]
[112.573959, "o", "\u001b[?2004h> "]
[112.574, "o", "                    # For each input position, spread to output positions\r\n\u001b[?2004l\r"]
[112.574016, "o", "\u001b[?2004h> "]
[112.574048, "o", "                    h_out = i * self.stride - self.padding\r\n\u001b[?2004l\r"]
[112.574064, "o", "\u001b[?2004h> "]
[112.574094, "o", "                    w_out = j * self.stride - self.padding\r\n\u001b[?2004l\r"]
[112.57411, "o", "\u001b[?2004h> "]
[112.574125, "o", "                    \r\n\u001b[?2004l\r"]
[112.574138, "o", "\u001b[?2004h> "]
[112.574164, "o", "                    for ki in range(self.kernel_size):\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.574179, "o", "> "]
[112.574211, "o", "                        for kj in range(self.kernel_size):\r\n\u001b[?2004l\r"]
[112.574226, "o", "\u001b[?2004h> "]
[112.57425, "o", "                            h_idx = h_out + ki\r\n\u001b[?2004l\r"]
[112.574266, "o", "\u001b[?2004h> "]
[112.574301, "o", "                            w_idx = w_out + kj\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.574318, "o", "                            \r\n\u001b[?2004l\r"]
[112.574334, "o", "\u001b[?2004h> "]
[112.574376, "o", "                            if 0 <= h_idx < out_h and 0 <= w_idx < out_w:\r\n\u001b[?2004l\r"]
[112.574391, "o", "\u001b[?2004h> "]
[112.574422, "o", "                                # For each output channel\r\n\u001b[?2004l\r"]
[112.574437, "o", "\u001b[?2004h> "]
[112.574477, "o", "                                for c_out in range(self.out_channels):\r\n\u001b[?2004l\r"]
[112.574493, "o", "\u001b[?2004h> "]
[112.574537, "o", "                                    # Sum over input channels and kernel weights\r\n\u001b[?2004l\r"]
[112.574556, "o", "\u001b[?2004h> "]
[112.574594, "o", "                                    for c_in in range(self.in_channels):\r\n\u001b[?2004l\r"]
[112.574607, "o", "\u001b[?2004h> "]
[112.574643, "o", "                                        val = x[b, i, j, c_in]\r\n\u001b[?2004l\r"]
[112.574657, "o", "\u001b[?2004h> "]
[112.57471, "o", "                                        kernel_val = self.weights[c_in, c_out, ki, kj]\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.574722, "o", "> "]
[112.574776, "o", "                                        output[b, h_idx, w_idx, c_out] += val * kernel_val\r\n\u001b[?2004l\r"]
[112.574789, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[112.5748, "o", "\u001b[?2004h> "]
[112.574812, "o", "        # Add bias\r\n\u001b[?2004l\r"]
[112.574825, "o", "\u001b[?2004h> "]
[112.57485, "o", "        for b in range(batch_size):\r\n\u001b[?2004l\r"]
[112.574867, "o", "\u001b[?2004h> "]
[112.574883, "o", "            for i in range(out_h):\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.574894, "o", "> "]
[112.574919, "o", "                for j in range(out_w):\r\n\u001b[?2004l\r"]
[112.57493, "o", "\u001b[?2004h> "]
[112.574964, "o", "                    output[b, i, j, :] += self.bias\r\n\u001b[?2004l\r"]
[112.574977, "o", "\u001b[?2004h>         \r\n"]
[112.574988, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[112.575006, "o", "        return output\r\n\u001b[?2004l\r"]
[112.575017, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[112.575828, "o", "\u001b[?2004hroot@b05171444938:/app# "]
[112.682585, "i", "cat > /app/src/pooling.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass MaxPool2D(BaseLayer):\n    \"\"\"Max Pooling layer.\"\"\"\n    \n    def __init__(self, kernel_size: int, stride: int | None = None):\n        \"\"\"\n        Args:\n            kernel_size: size of pooling window (positive integer)\n            stride: stride of pooling (positive integer, defaults to kernel_size if None)\n        \"\"\"\n        super().__init__()\n        self.kernel_size = kernel_size\n        self.stride = stride if stride is not None else kernel_size\n    \n    def forward(self, x: np.ndarray) -> np.ndarray:\n        \"\"\"\n        Args:\n            x: input of shape (batch_size, height, width, channels), dtype float64\n        \n        Returns:\n            output of shape (batch_size, out_height, out_width, channels), dtype float64\n        \"\"\"\n        batch_size, height, width, channels = x.shape\n        \n        out_h = (height - self.kernel_size) // self.stride + 1\n        out_w = (width - self.kernel_size) // self.stride + 1"]
[112.682693, "i", "\n        \n        output = np.zeros((batch_size, out_h, out_w, channels), dtype=np.float64)\n        \n        for b in range(batch_size):\n            for i in range(out_h):\n                for j in range(out_w):\n                    h_start = i * self.stride\n                    w_start = j * self.stride\n                    region = x[b, h_start:h_start + self.kernel_size, \n                               w_start:w_start + self.kernel_size, :]\n                    output[b, i, j, :] = np.max(region, axis=(0, 1))\n        \n        return output\n\n\nclass AvgPool2D(BaseLayer):\n    \"\"\"Average Pooling layer.\"\"\"\n    \n    def __init__(self, kernel_size: int, stride: int | None = None):\n        \"\"\"\n        Args:\n            kernel_size: size of pooling window (positive integer)\n            stride: stride of pooling (positive integer, defaults to kernel_size if None)\n        \"\"\"\n        super().__init__()\n        self.kernel_size = kernel_size\n        self.stride = stride if stride is not None else kernel_size\n    \n    def f"]
[112.682703, "o", "cat > /app/src/pooling.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.68271, "i", "orward(self, x: np.ndarray) -> np.ndarray:\n        \"\"\"\n        Args:\n            x: input of shape (batch_size, height, width, channels), dtype float64\n        \n        Returns:\n            output of shape (batch_size, out_height, out_width, channels), dtype float64\n        \"\"\"\n        batch_size, height, width, channels = x.shape\n        \n        out_h = (height - self.kernel_size) // self.stride + 1\n        out_w = (width - self.kernel_size) // self.stride + 1\n        \n        output = np.zeros((batch_size, out_h, out_w, channels), dtype=np.float64)\n        \n        for b in range(batch_size):\n            for i in range(out_h):\n                for j in range(out_w):\n                    h_start = i * self.stride\n                    w_start = j * self.stride\n                    region = x[b, h_start:h_start + self.kernel_size, \n                               w_start:w_start + self.kernel_size, :]\n                    output[b, i, j, :] = np.mean(region, axis=(0, 1))\n        \n        return output\nEOF\n"]
[112.68272, "o", "> "]
[112.682736, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[112.682743, "o", "\u001b[?2004h> "]
[112.682813, "o", "from .base import BaseLayer\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.682826, "o", "class MaxPool2D(BaseLayer):\r\n\u001b[?2004l\r"]
[112.68283, "o", "\u001b[?2004h> "]
[112.68286, "o", "    \"\"\"Max Pooling layer.\"\"\"\r\n\u001b[?2004l\r"]
[112.682872, "o", "\u001b[?2004h> "]
[112.682877, "o", "    \r\n\u001b[?2004l\r"]
[112.682881, "o", "\u001b[?2004h"]
[112.682885, "o", "> "]
[112.683056, "o", "    def __init__(self, kernel_size: int, stride: int | None = None):\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.683074, "o", "            kernel_size: size of pooling window (positive integer)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.683109, "o", "            stride: stride of pooling (positive integer, defaults to kernel_size if None)\r\n\u001b[?2004l\r"]
[112.683147, "o", "\u001b[?2004h> "]
[112.683194, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h>         self.kernel_size = kernel_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.683235, "o", "        self.stride = stride if stride is not None else kernel_size\r\n\u001b[?2004l\r"]
[112.68324, "o", "\u001b[?2004h> "]
[112.683245, "o", "    \r\n\u001b[?2004l\r"]
[112.683282, "o", "\u001b[?2004h> "]
[112.683315, "o", "    def forward(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"\r\n\u001b[?2004l\r"]
[112.683336, "o", "\u001b[?2004h> "]
[112.683385, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.683414, "o", "            x: input of shape (batch_size, height, width, channels), dtype float64\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.68343, "o", "        Returns:\r\n\u001b[?2004l\r"]
[112.683445, "o", "\u001b[?2004h> "]
[112.683498, "o", "            output of shape (batch_size, out_height, out_width, channels), dtype float64\r\n\u001b[?2004l\r"]
[112.683511, "o", "\u001b[?2004h> "]
[112.683526, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.683563, "o", "        batch_size, height, width, channels = x.shape\r\n\u001b[?2004l\r"]
[112.683578, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[112.683595, "o", "\u001b[?2004h> "]
[112.683632, "o", "        out_h = (height - self.kernel_size) // self.stride + 1\r\n\u001b[?2004l\r"]
[112.683646, "o", "\u001b[?2004h> "]
[112.683691, "o", "        out_w = (width - self.kernel_size) // self.stride + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.683738, "o", ">         \r\n\u001b[?2004l\r"]
[112.683791, "o", "\u001b[?2004h>         output = np.zeros((batch_size, out_h, out_w, channels), dtype=np.float64)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[112.683887, "o", "\u001b[?2004h>         for b in range(batch_size):\r\n\u001b[?2004l\r\u001b[?2004h>             for i in range(out_h):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684101, "o", "                for j in range(out_w):\r\n\u001b[?2004l\r\u001b[?2004h>                     h_start = i * self.stride\r\n\u001b[?2004l\r\u001b[?2004h>                     w_start = j * self.stride\r\n\u001b[?2004l\r\u001b[?2004h>                     region = x[b, h_start:h_start + self.kernel_size, \r\n\u001b[?2004l\r\u001b[?2004h>                                w_start:w_start + self.kernel_size, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684148, "o", "                    output[b, i, j, :] = np.max(region, axis=(0, 1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684175, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         return output\r\n\u001b[?2004l\r"]
[112.684198, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684218, "o", "class AvgPool2D(BaseLayer):\r\n\u001b[?2004l\r"]
[112.684237, "o", "\u001b[?2004h> "]
[112.684258, "o", "    \"\"\"Average Pooling layer.\"\"\"\r\n\u001b[?2004l\r"]
[112.684278, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684309, "o", "    def __init__(self, kernel_size: int, stride: int | None = None):\r\n\u001b[?2004l\r"]
[112.684327, "o", "\u001b[?2004h> "]
[112.684346, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684366, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684394, "o", "            kernel_size: size of pooling window (positive integer)\r\n\u001b[?2004l\r"]
[112.684411, "o", "\u001b[?2004h> "]
[112.684458, "o", "            stride: stride of pooling (positive integer, defaults to kernel_size if None)\r\n\u001b[?2004l\r"]
[112.684478, "o", "\u001b[?2004h> "]
[112.684497, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684506, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684533, "o", "        self.kernel_size = kernel_size\r\n\u001b[?2004l\r"]
[112.684552, "o", "\u001b[?2004h> "]
[112.684582, "o", "        self.stride = stride if stride is not None else kernel_size\r\n\u001b[?2004l\r"]
[112.6846, "o", "\u001b[?2004h> "]
[112.684619, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684634, "o", "    def forward(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r"]
[112.684652, "o", "\u001b[?2004h> "]
[112.68467, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684689, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684726, "o", "            x: input of shape (batch_size, height, width, channels), dtype float64\r\n\u001b[?2004l\r"]
[112.684744, "o", "\u001b[?2004h"]
[112.684762, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.68477, "o", "        Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684825, "o", "            output of shape (batch_size, out_height, out_width, channels), dtype float64\r\n\u001b[?2004l\r"]
[112.684849, "o", "\u001b[?2004h> "]
[112.684866, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.68489, "o", "        batch_size, height, width, channels = x.shape\r\n\u001b[?2004l\r"]
[112.684908, "o", "\u001b[?2004h> "]
[112.684928, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.684951, "o", "        out_h = (height - self.kernel_size) // self.stride + 1\r\n\u001b[?2004l\r"]
[112.684969, "o", "\u001b[?2004h> "]
[112.684998, "o", "        out_w = (width - self.kernel_size) // self.stride + 1\r\n\u001b[?2004l\r"]
[112.68502, "o", "\u001b[?2004h> "]
[112.68503, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.685084, "o", "        output = np.zeros((batch_size, out_h, out_w, channels), dtype=np.float64)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.685113, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         for b in range(batch_size):\r\n\u001b[?2004l\r"]
[112.685132, "o", "\u001b[?2004h> "]
[112.685152, "o", "            for i in range(out_h):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.685178, "o", "                for j in range(out_w):\r\n\u001b[?2004l\r"]
[112.685195, "o", "\u001b[?2004h> "]
[112.685214, "o", "                    h_start = i * self.stride\r\n\u001b[?2004l\r"]
[112.685233, "o", "\u001b[?2004h> "]
[112.68525, "o", "                    w_start = j * self.stride\r\n\u001b[?2004l\r"]
[112.68527, "o", "\u001b[?2004h> "]
[112.685302, "o", "                    region = x[b, h_start:h_start + self.kernel_size, \r\n\u001b[?2004l\r"]
[112.685323, "o", "\u001b[?2004h> "]
[112.685354, "o", "                               w_start:w_start + self.kernel_size, :]\r\n\u001b[?2004l\r"]
[112.685375, "o", "\u001b[?2004h> "]
[112.685421, "o", "                    output[b, i, j, :] = np.mean(region, axis=(0, 1))\r\n\u001b[?2004l\r"]
[112.68544, "o", "\u001b[?2004h> "]
[112.685461, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.685481, "o", "        return output\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[112.686347, "o", "\u001b[?2004hroot@b05171444938:/app# "]
[112.792913, "i", "cat > /app/src/normalization.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass BatchNorm2D(BaseLayer):\n    \"\"\"Batch Normalization layer for 2D data (NHWC format).\"\"\"\n    \n    def __init__(self, num_features: int, eps: float = 1e-5, momentum: float = 0.1):\n        \"\"\"\n        Args:\n            num_features: number of channels (C in NHWC format)\n            eps: small constant for numerical stability (default 1e-5)\n            momentum: momentum for running mean/variance update (default 0.1)\n        \"\"\"\n        super().__init__()\n        self.num_features = num_features\n        self.eps = eps\n        self.momentum = momentum\n        \n        # Scale (gamma) initialized to ones\n        self.gamma = np.ones(num_features, dtype=np.float64)\n        # Shift (beta) initialized to zeros\n        self.beta = np.zeros(num_features, dtype=np.float64)\n        # Running statistics for inference\n        self.running_mean = np.zeros(num_features, dtype=np.float64)\n        self.running_var = np.ones(num_featur"]
[112.793064, "i", "es, dtype=np.float64)\n    \n    def forward(self, x: np.ndarray, training: bool = True) -> np.ndarray:\n        \"\"\"\n        Args:\n            x: input of shape (batch_size, height, width, num_features), dtype float64\n            training: if True, use batch statistics and update running stats;\n                     if False, use running stats\n        \n        Returns:\n            normalized output of same shape, dtype float64\n        \"\"\"\n        batch_size, height, width, num_features = x.shape\n        \n        if training:\n            # Compute batch statistics across batch, height, width\n            # Axis 0=batch, 1=height, 2=width, 3=channels\n            batch_mean = np.mean(x, axis=(0, 1, 2))  # (num_features,)\n            batch_var = np.var(x, axis=(0, 1, 2))    # (num_features,)\n            \n            # Update running statistics\n            self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * batch_mean\n            self.running_var = (1 - self.momentum) * self.running_var + self"]
[112.793108, "o", "cat > /app/src/normalization.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.793135, "i", ".momentum * batch_var\n            \n            # Normalize\n            normalized = (x - batch_mean) / np.sqrt(batch_var + self.eps)\n        else:\n            # Use running statistics for inference\n            normalized = (x - self.running_mean) / np.sqrt(self.running_var + self.eps)\n        \n        # Scale and shift\n        output = self.gamma * normalized + self.beta\n        \n        return output\nEOF\n"]
[112.793179, "o", "from .base import BaseLayer\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.7932, "o", "class BatchNorm2D(BaseLayer):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.793224, "o", "    \"\"\"Batch Normalization layer for 2D data (NHWC format).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.793243, "o", ">     \r\n\u001b[?2004l\r"]
[112.793254, "o", "\u001b[?2004h> "]
[112.793333, "o", "    def __init__(self, num_features: int, eps: float = 1e-5, momentum: float = 0.1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.79345, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.7935, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h>             num_features: number of channels (C in NHWC format)\r\n\u001b[?2004l\r\u001b[?2004h>             eps: small constant for numerical stability (default 1e-5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.793563, "o", "            momentum: momentum for running mean/variance update (default 0.1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.793589, "o", ">         \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.793609, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.79363, "o", "> "]
[112.793651, "o", "        self.num_features = num_features\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.793671, "o", ">         self.eps = eps\r\n"]
[112.793691, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[112.79371, "o", "        self.momentum = momentum\r\n\u001b[?2004l\r"]
[112.79373, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.793772, "o", "        # Scale (gamma) initialized to ones\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.793822, "o", "        self.gamma = np.ones(num_features, dtype=np.float64)\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.79385, "o", "> "]
[112.793874, "o", "        # Shift (beta) initialized to zeros\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.793893, "o", "> "]
[112.793926, "o", "        self.beta = np.zeros(num_features, dtype=np.float64)\r\n\u001b[?2004l\r"]
[112.793945, "o", "\u001b[?2004h> "]
[112.79397, "o", "        # Running statistics for inference\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.793988, "o", "> "]
[112.794029, "o", "        self.running_mean = np.zeros(num_features, dtype=np.float64)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.794083, "o", "        self.running_var = np.ones(num_features, dtype=np.float64)\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.794109, "o", ">     \r\n\u001b[?2004l\r"]
[112.79413, "o", "\u001b[?2004h> "]
[112.79416, "o", "    def forward(self, x: np.ndarray, training: bool = True) -> np.ndarray:\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.79418, "o", ">         \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.794198, "o", ">         Args:\r\n\u001b[?2004l\r"]
[112.79422, "o", "\u001b[?2004h> "]
[112.794273, "o", "            x: input of shape (batch_size, height, width, num_features), dtype float64\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.794292, "o", "> "]
[112.794335, "o", "            training: if True, use batch statistics and update running stats;\r\n\u001b[?2004l\r"]
[112.794352, "o", "\u001b[?2004h> "]
[112.79438, "o", "                     if False, use running stats\r\n\u001b[?2004l\r"]
[112.7944, "o", "\u001b[?2004h> "]
[112.794421, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         Returns:\r\n\u001b[?2004l\r"]
[112.794439, "o", "\u001b[?2004h> "]
[112.794473, "o", "            normalized output of same shape, dtype float64\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.794494, "o", ">         \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.794513, "o", "> "]
[112.794541, "o", "        batch_size, height, width, num_features = x.shape\r\n\u001b[?2004l\r"]
[112.794562, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.794583, "o", "        if training:\r\n\u001b[?2004l\r"]
[112.794602, "o", "\u001b[?2004h> "]
[112.794639, "o", "            # Compute batch statistics across batch, height, width\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.794658, "o", "> "]
[112.794689, "o", "            # Axis 0=batch, 1=height, 2=width, 3=channels\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.794709, "o", "> "]
[112.794748, "o", "            batch_mean = np.mean(x, axis=(0, 1, 2))  # (num_features,)\r\n\u001b[?2004l\r"]
[112.794768, "o", "\u001b[?2004h> "]
[112.794808, "o", "            batch_var = np.var(x, axis=(0, 1, 2))    # (num_features,)\r\n\u001b[?2004l\r"]
[112.794828, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[112.794851, "o", "\u001b[?2004h> "]
[112.794894, "o", "            # Update running statistics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.794954, "o", "            self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * batch_mean\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.794975, "o", "> "]
[112.795031, "o", "            self.running_var = (1 - self.momentum) * self.running_var + self.momentum * batch_var\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.79505, "o", ">             \r\n\u001b[?2004l\r"]
[112.795069, "o", "\u001b[?2004h> "]
[112.795096, "o", "            # Normalize\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.795137, "o", "            normalized = (x - batch_mean) / np.sqrt(batch_var + self.eps)\r\n\u001b[?2004l\r"]
[112.795156, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[112.795178, "o", "\u001b[?2004h> "]
[112.795203, "o", "            # Use running statistics for inference\r\n\u001b[?2004l\r"]
[112.795224, "o", "\u001b[?2004h> "]
[112.795289, "o", "            normalized = (x - self.running_mean) / np.sqrt(self.running_var + self.eps)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n"]
[112.795318, "o", "\u001b[?2004l\r\u001b[?2004h>         # Scale and shift\r\n\u001b[?2004l\r"]
[112.79534, "o", "\u001b[?2004h> "]
[112.795373, "o", "        output = self.gamma * normalized + self.beta\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.795397, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.795419, "o", "        return output\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[112.796279, "o", "\u001b[?2004hroot@b05171444938:/app# "]
[112.885814, "i", "cat > /app/src/activation.py << 'EOF'\nimport numpy as np\nfrom .base import BaseLayer\n\n\nclass ReLU(BaseLayer):\n    \"\"\"Rectified Linear Unit activation function.\"\"\"\n    \n    def __init__(self):\n        super().__init__()\n    \n    def forward(self, x: np.ndarray) -> np.ndarray:\n        \"\"\"\n        Args:\n            x: input array of any shape, dtype float64\n        \n        Returns:\n            output of same shape, dtype float64\n            Formula: max(0, x)\n        \"\"\"\n        return np.maximum(0, x).astype(np.float64)\n\n\nclass LeakyReLU(BaseLayer):\n    \"\"\"Leaky Rectified Linear Unit activation function.\"\"\"\n    \n    def __init__(self, negative_slope: float = 0.01):\n        \"\"\"\n        Args:\n            negative_slope: slope for negative values (default 0.01)\n        \"\"\"\n        super().__init__()\n        self.negative_slope = negative_slope\n    \n    def forward(self, x: np.ndarray) -> np.ndarray:\n        \"\"\"\n        Args:\n            x: input array of any shape, dtype float64\n        \n        Returns:\n        "]
[112.885984, "i", "    output of same shape, dtype float64\n            Formula: x if x > 0 else negative_slope * x\n        \"\"\"\n        return np.where(x > 0, x, self.negative_slope * x).astype(np.float64)\n\n\nclass Sigmoid(BaseLayer):\n    \"\"\"Sigmoid activation function.\"\"\"\n    \n    def __init__(self):\n        super().__init__()\n    \n    def forward(self, x: np.ndarray) -> np.ndarray:\n        \"\"\"\n        Args:\n            x: input array of any shape, dtype float64\n        \n        Returns:\n            output of same shape, dtype float64\n            Formula: 1 / (1 + exp(-x))\n            Numerically stable for large positive/negative values\n        \"\"\"\n        # Numerically stable sigmoid\n        # For positive x: 1 / (1 + exp(-x))\n        # For negative x: exp(x) / (1 + exp(x))\n        positive_mask = x >= 0\n        negative_mask = ~positive_mask\n        \n        result = np.zeros_like(x, dtype=np.float64)\n        \n        # For positive values\n        pos_x = x[positive_mask]\n        result[positive_mask] = 1.0 / (1.0 + np.exp(-p"]
[112.886017, "o", "cat > /app/src/activation.py << 'EOF'\r\n\u001b[?2004l\r    output of same shape, dtype float64\r\n            Formula: x if x > 0 else negativ"]
[112.886041, "i", "os_x))\n        \n        # For negative values\n        neg_x = x[negative_mask]\n        exp_x = np.exp(neg_x)\n        result[negative_mask] = exp_x / (1.0 + exp_x)\n        \n        return result\nEOF\n"]
[112.886065, "o", "e_slope * x\r\n        \"\"\"\r\n        return np.where(x > 0, x, self.negative_slope * x).astype(np.float64)\r\n\r\n\r\nclass Sigmoid(BaseLayer):\r\n    \"\"\"Sigmoid activation function.\"\"\"\r\n    \r\n    def __init__(self):\r\n        super().__init__()\r\n    \r\n    def forward(self, x: np.ndarray) -> np.ndarray:\r\n        \"\"\"\r\n        Args:\r\n            x: input array of any shape, dtype float64\r\n        \r\n        Returns:\r\n            output of same shape, dtype float64\r\n            Formula: 1 / (1 + exp(-x))\r\n            Numerically stable for"]
[112.886088, "o", " large positive/negative values\r\n        \"\"\"\r\n        # Numerically stable sigmoid\r\n        # For positive x: 1 / (1 + exp(-x))\r\n        # For negative x: exp(x) / (1 + exp(x))\r\n        positive_mask = x >= 0\r\n        neg"]
[112.886117, "o", "ative_mask = ~positive_mask\r\n        \r\n        result = np.zeros_like(x, dtype=np.float64)\r\n        \r\n        # For positive values\r\n        pos_x = x[positive_mask]\r\n        result[positive_mask] = 1.0 / ("]
[112.886137, "o", "1.0 + np.exp(-pos_x))\r\n        \r\n        # For negative values\r\n        neg_x = x[negative_mask]\r\n      "]
[112.886158, "o", "  exp_x = np.exp(neg_x)\r\n        result[negative_mask] = exp_x / (1.0 + exp_x)\r\n        \r\n        return result\r\nEOF\r\n"]
[112.886177, "o", "\u001b[?2004h> "]
[112.886206, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[112.886226, "o", "\u001b[?2004h> "]
[112.886253, "o", "from .base import BaseLayer\r\n\u001b[?2004l\r"]
[112.886276, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.886294, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.886318, "o", "class ReLU(BaseLayer):\r\n\u001b[?2004l\r"]
[112.886339, "o", "\u001b[?2004h> "]
[112.88637, "o", "    \"\"\"Rectified Linear Unit activation function.\"\"\"\r\n\u001b[?2004l\r"]
[112.886394, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[112.886416, "o", "\u001b[?2004h> "]
[112.886438, "o", "    def __init__(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.886457, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[112.88648, "o", "\u001b[?2004h> "]
[112.886503, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.886549, "o", "    def forward(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r"]
[112.88657, "o", "\u001b[?2004h> "]
[112.88658, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.886647, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h>             x: input array of any shape, dtype float64\r\n\u001b[?2004l\r"]
[112.88668, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.886697, "o", "        Returns:\r\n\u001b[?2004l\r"]
[112.886703, "o", "\u001b[?2004h"]
[112.886749, "o", "> "]
[112.886767, "o", "            output of same shape, dtype float64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.886783, "o", "            Formula: max(0, x)\r\n\u001b[?2004l\r"]
[112.886798, "o", "\u001b[?2004h>         \"\"\"\r\n"]
[112.886811, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[112.88688, "o", "        return np.maximum(0, x).astype(np.float64)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.886907, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.886918, "o", "class LeakyReLU(BaseLayer):\r\n\u001b[?2004l\r"]
[112.886988, "o", "\u001b[?2004h> "]
[112.887024, "o", "    \"\"\"Leaky Rectified Linear Unit activation function.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.887042, "o", "    def __init__(self, negative_slope: float = 0.01):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.887056, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.887093, "o", "> "]
[112.887117, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.887134, "o", "            negative_slope: slope for negative values (default 0.01)\r\n\u001b[?2004l\r"]
[112.887148, "o", "\u001b[?2004h> "]
[112.887161, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.887185, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[112.887198, "o", "\u001b[?2004h> "]
[112.887231, "o", "        self.negative_slope = negative_slope\r\n\u001b[?2004l\r"]
[112.887244, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[112.887256, "o", "\u001b[?2004h> "]
[112.887297, "o", "    def forward(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r"]
[112.887311, "o", "\u001b[?2004h>         \"\"\"\r\n"]
[112.88733, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[112.88736, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.887388, "o", "            x: input array of any shape, dtype float64\r\n\u001b[?2004l\r"]
[112.887401, "o", "\u001b[?2004h> "]
[112.887415, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.88743, "o", "        Returns:\r\n\u001b[?2004l\r"]
[112.887445, "o", "\u001b[?2004h> "]
[112.887477, "o", "            output of same shape, dtype float64\r\n\u001b[?2004l\r"]
[112.887489, "o", "\u001b[?2004h> "]
[112.887528, "o", "            Formula: x if x > 0 else negative_slope * x\r\n\u001b[?2004l\r"]
[112.88754, "o", "\u001b[?2004h> "]
[112.887553, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.887616, "o", "        return np.where(x > 0, x, self.negative_slope * x).astype(np.float64)\r\n\u001b[?2004l\r"]
[112.887629, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.887641, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.887653, "o", "> "]
[112.887667, "o", "class Sigmoid(BaseLayer):\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.887679, "o", "> "]
[112.887704, "o", "    \"\"\"Sigmoid activation function.\"\"\"\r\n\u001b[?2004l\r"]
[112.887717, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[112.887729, "o", "\u001b[?2004h> "]
[112.887749, "o", "    def __init__(self):\r\n\u001b[?2004l\r"]
[112.887761, "o", "\u001b[?2004h> "]
[112.887781, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[112.887794, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[112.887804, "o", "\u001b[?2004h> "]
[112.88785, "o", "    def forward(self, x: np.ndarray) -> np.ndarray:\r\n\u001b[?2004l\r"]
[112.887855, "o", "\u001b[?2004h> "]
[112.887869, "o", "        \"\"\"\r\n\u001b[?2004l\r"]
[112.887881, "o", "\u001b[?2004h> "]
[112.887894, "o", "        Args:\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.887905, "o", "> "]
[112.88794, "o", "            x: input array of any shape, dtype float64\r\n\u001b[?2004l\r"]
[112.887953, "o", "\u001b[?2004h>         \r\n"]
[112.887967, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[112.88798, "o", "        Returns:\r\n\u001b[?2004l\r"]
[112.887992, "o", "\u001b[?2004h> "]
[112.888026, "o", "            output of same shape, dtype float64\r\n\u001b[?2004l\r"]
[112.888038, "o", "\u001b[?2004h> "]
[112.888066, "o", "            Formula: 1 / (1 + exp(-x))\r\n\u001b[?2004l\r"]
[112.888078, "o", "\u001b[?2004h> "]
[112.888124, "o", "            Numerically stable for large positive/negative values\r\n\u001b[?2004l\r"]
[112.888136, "o", "\u001b[?2004h> "]
[112.88815, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.888161, "o", "> "]
[112.888188, "o", "        # Numerically stable sigmoid\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.888218, "o", "> "]
[112.888241, "o", "        # For positive x: 1 / (1 + exp(-x))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.888275, "o", "        # For negative x: exp(x) / (1 + exp(x))\r\n\u001b[?2004l\r"]
[112.888291, "o", "\u001b[?2004h> "]
[112.88831, "o", "        positive_mask = x >= 0\r\n\u001b[?2004l\r"]
[112.888326, "o", "\u001b[?2004h> "]
[112.888349, "o", "        negative_mask = ~positive_mask\r\n\u001b[?2004l\r"]
[112.888361, "o", "\u001b[?2004h>         "]
[112.888374, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.888413, "o", "        result = np.zeros_like(x, dtype=np.float64)\r\n\u001b[?2004l\r"]
[112.88843, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[112.888446, "o", "\u001b[?2004h> "]
[112.888463, "o", "        # For positive values\r\n\u001b[?2004l\r"]
[112.888477, "o", "\u001b[?2004h> "]
[112.888499, "o", "        pos_x = x[positive_mask]\r\n\u001b[?2004l\r"]
[112.888512, "o", "\u001b[?2004h> "]
[112.888554, "o", "        result[positive_mask] = 1.0 / (1.0 + np.exp(-pos_x))\r\n\u001b[?2004l\r"]
[112.888567, "o", "\u001b[?2004h> "]
[112.88858, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.888603, "o", "        # For negative values\r\n\u001b[?2004l\r"]
[112.888615, "o", "\u001b[?2004h> "]
[112.888641, "o", "        neg_x = x[negative_mask]\r\n\u001b[?2004l\r"]
[112.888652, "o", "\u001b[?2004h> "]
[112.888673, "o", "        exp_x = np.exp(neg_x)\r\n\u001b[?2004l\r"]
[112.888685, "o", "\u001b[?2004h> "]
[112.888725, "o", "        result[negative_mask] = exp_x / (1.0 + exp_x)\r\n\u001b[?2004l\r"]
[112.888737, "o", "\u001b[?2004h> "]
[112.888749, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.888772, "o", "        return result\r\n\u001b[?2004l\r"]
[112.888784, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[112.88975, "o", "\u001b[?2004hroot@b05171444938:/app# "]
[112.981838, "i", "ls -la /app/src/\n"]
[112.981983, "o", "ls -la /app/src/\r\n\u001b[?2004l\r"]
