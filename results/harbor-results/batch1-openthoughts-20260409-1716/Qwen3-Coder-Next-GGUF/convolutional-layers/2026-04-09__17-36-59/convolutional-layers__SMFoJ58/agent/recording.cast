[247.72254, "o", "> "]
[247.72258, "o", "        batch_size, height, width, _ = x.shape\r\n\u001b[?2004l\r"]
[247.722593, "o", "\u001b[?2004h"]
[247.722599, "o", "> "]
[247.722619, "o", "        \r\n\u001b[?2004l\r"]
[247.72263, "o", "\u001b[?2004h> "]
[247.72268, "o", "        # Calculate output dimensions using the formula\r\n\u001b[?2004l\r"]
[247.722691, "o", "\u001b[?2004h"]
[247.722701, "o", "> "]
[247.722781, "o", "        # out_dim = (input_dim + 2*padding - dilation*(kernel_size-1) - 1) // stride + 1\r\n\u001b[?2004l\r"]
[247.722795, "o", "\u001b[?2004h> "]
