[5.979957, "o", "drwxr-xr-x  3 root root 4096 Apr 10 00:22 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x  1 root root 4096 Apr 10 00:22 \u001b[01;34m..\u001b[0m\r\ndrwxr-xr-x 34 root root 4096 Apr 10 00:22 \u001b[01;34mcases\u001b[0m\r\n-rw-r--r--  1 root root  308 Apr 10 00:22 introduction.txt\r\n-rw-r--r--  1 root root  539 Apr 10 00:22 summary1.txt\r\n-rw-r--r--  1 root root  533 Apr 10 00:22 summary10.txt\r\n-rw-r--r--  1 root root  458 Apr 10 00:22 summary2.txt\r\n-rw-r--r--  1 root root 2353 Apr 10 00:22 summary3.txt\r\n-rw-r--r--  1 root root 2018 Apr 10 00:22 summary4.txt\r\n-rw-r--r--  1 root root  511 Apr 10 00:22 summary5.txt\r\n-rw-r--r--  1 root root  528 Apr 10 00:22 summary6.txt\r\n-rw-r--r--  1 root root  451 Apr 10 00:22 summary7.txt\r\n-rw-r--r--  1 root root 1171 Apr 10 00:22 summary8.txt\r\n-rw-r--r--  1 root root  713 Apr 10 00:22 summary9.txt\r\n"]
[5.980096, "o", "\u001b[?2004h"]
