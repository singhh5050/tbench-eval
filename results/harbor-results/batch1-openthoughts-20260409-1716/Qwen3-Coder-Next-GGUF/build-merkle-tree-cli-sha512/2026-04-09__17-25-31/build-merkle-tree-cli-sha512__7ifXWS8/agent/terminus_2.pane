[?2004l#!/usr/bin/env python3
"""Merkle Tree CLI Tool using SHA-512"""

import argparse
import hashlib
import json
import os
import sys
from pathlib import Path


def sha512_hash(data):
    """Compute SHA-512 hash of bytes, return 128-char hex string."""
    if isinstance(data, str):
        data = data.encode('utf-8')
    return hashlib.sha512(data).hexdigest()


def sha512_concatenate(left, right):
    """Concatenate two hash strings and return their SHA-512 hash."""
