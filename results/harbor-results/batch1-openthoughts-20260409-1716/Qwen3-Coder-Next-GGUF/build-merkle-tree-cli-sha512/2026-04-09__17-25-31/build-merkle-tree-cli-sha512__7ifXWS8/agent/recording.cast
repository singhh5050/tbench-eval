[168.197788, "o", "#!/usr/bin/env python3\r\n\"\"\"Merkle Tree CLI Tool using SHA-512\"\"\"\r\n\r\nimport argparse\r\nimport hashlib\r\nimport json\r\nimport os\r\nimport sys\r\n"]
[168.197834, "o", "from pathlib import Path\r\n\r\n\r\ndef sha512_hash(data):\r\n    \"\"\"Compute SHA-512 hash of bytes, return 128-char hex string.\"\"\"\r\n    if isinstance(data, str):\r\n        data = data.encode('utf-8')\r\n    return hashlib.sha512(data).hexdigest()\r\n\r\n\r\ndef sha512_concatenate(left, right):\r\n"]
[168.197869, "o", "    \"\"\"Concatenate two hash strings and return their SHA-512 hash.\"\"\"\r\n"]
