[71.164, "i", "cat > /app/merkle_cli.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Merkle Tree CLI Tool using SHA-512\"\"\"\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport sys\nfrom pathlib import Path\n\n\ndef sha512_hash(data):\n    \"\"\"Compute SHA-512 hash of bytes, return 128-char hex string.\"\"\"\n    if isinstance(data, str):\n        data = data.encode('utf-8')\n    return hashlib.sha512(data).hexdigest()\n\n\ndef sha512_concatenate(left, right):\n    \"\"\"Concatenate two hash strings and return their SHA-512 hash.\"\"\"\n    combined = left + right\n    return sha512_hash(combined.encode('utf-8'))\n\n\nclass MerkleTree:\n    \"\"\"Merkle Tree implementation with SHA-512.\"\"\"\n    \n    def __init__(self):\n        self.leaves = []  # List of (file_path, hash) tuples\n        self.proofs = {}  # file_path -> list of [side, hash] pairs\n        self.file_hashes = {}  # file_path -> leaf hash\n        self.root_hash = None\n    \n    def build_from_directory(self, directory):\n        \"\"\"Scan directory and build Merkle tree.\"\"\"\n        self.leaves = []\n  "]
[71.164163, "i", "      self.proofs = {}\n        self.file_hashes = {}\n        \n        dir_path = Path(directory)\n        abs_dir = dir_path.resolve()\n        \n        # Collect all regular files\n        files = []\n        for item in sorted(dir_path.rglob('*')):\n            if item.is_file() and not item.is_symlink():\n                rel_path = str(item.relative_to(dir_path))\n                files.append((rel_path, item))\n        \n        # Sort for deterministic ordering\n        files.sort(key=lambda x: x[0])\n        \n        # Hash each file\n        for rel_path, file_path in files:\n            with open(file_path, 'rb') as f:\n                file_hash = sha512_hash(f.read())\n            self.leaves.append((rel_path, file_hash))\n            self.file_hashes[rel_path] = file_hash\n        \n        # Build the tree\n        self._build_tree()\n    \n    def _build_tree(self):\n        \"\"\"Build the Merkle tree and generate proofs.\"\"\"\n        if not self.leaves:\n            self.root_hash = sha512_hash(b'')\n            return\n     "]
[71.164177, "o", "cat > /app/merkle_cli.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[71.164185, "i", "   \n        # Get just the hashes in order\n        hashes = [h for _, h in self.leaves]\n        \n        # Generate proofs for each leaf\n        for i, (file_path, _) in enumerate(self.leaves):\n            self.proofs[file_path] = self._generate_proof(hashes, i)\n        \n        # Build to root\n        while len(hashes) > 1:\n            next_level = []\n            for j in range(0, len(hashes), 2):\n                if j + 1 < len(hashes):\n                    combined = sha512_concatenate(hashes[j], hashes[j + 1])\n                else:\n                    # Duplicate last node if odd number\n                    combined = sha512_concatenate(hashes[j], hashes[j])\n                next_level.append(combined)\n            hashes = next_level\n        \n        self.root_hash = hashes[0]\n    \n    def _generate_proof(self, hashes, leaf_index):\n        \"\"\"Generate Merkle proof for leaf at given index.\"\"\"\n        proof = []\n        current_level = hashes[:]\n        \n        while len(current_level) > 1:\n            # Deter"]
