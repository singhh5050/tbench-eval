[71.164229, "i", "turn 0\n\n\ndef cmd_proof(args):\n    \"\"\"Generate Merkle proof for a file.\"\"\"\n    data = load_merkle_data()\n    if data is None:\n        print(\"Error: No merkle_data.json found. Run scan first.\", file=sys.stderr)\n        return 1\n    \n    file_path = args.file_path\n    \n    if file_path not in data['file_hashes']:\n        print(f\"Error: File '{file_path}' not found in Merkle tree\", file=sys.stderr)\n        return 1\n    \n    proof = data['proofs'].get(file_path, [])\n    \n    output = {\n        \"file_path\": file_path,\n        \"proof\": proof\n    }\n    \n    print(json.dumps(output, indent=2))\n    return 0\n\n\ndef cmd_verify(args):\n    \"\"\"Verify a file's integrity against stored proof.\"\"\"\n    data = load_merkle_data()\n    if data is None:\n        print(\"Error: No merkle_data.json found. Run scan first.\", file=sys.stderr)\n        return 1\n    \n    file_path = args.file_path\n    proof_file = Path(args.proof_file)\n    \n    # Load proof from file\n    if not proof_file.exists():\n        print(f\"Error: Proof file '{proof_file"]
