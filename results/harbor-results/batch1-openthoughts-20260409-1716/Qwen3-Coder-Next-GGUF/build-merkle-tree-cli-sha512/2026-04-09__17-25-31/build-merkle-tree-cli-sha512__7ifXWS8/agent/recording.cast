[71.164206, "i", "l.append(combined)\n            \n            current_level = next_level\n            leaf_index = leaf_index // 2\n        \n        return proof\n    \n    def get_proof(self, file_path):\n        \"\"\"Get Merkle proof for a file.\"\"\"\n        return self.proofs.get(file_path)\n    \n    def to_dict(self, scanned_dir):\n        \"\"\"Convert to dictionary for JSON storage.\"\"\"\n        return {\n            \"root_hash\": self.root_hash,\n            \"proofs\": self.proofs,\n            \"file_hashes\": self.file_hashes,\n            \"scanned_directory\": str(scanned_dir)\n        }\n\n\ndef load_merkle_data():\n    \"\"\"Load merkle_data.json and validate hashes.\"\"\"\n    data_path = Path('/app/merkle_data.json')\n    if not data_path.exists():\n        return None\n    \n    with open(data_path, 'r') as f:\n        data = json.load(f)\n    \n    # Validate hashes are 128-char hex strings\n    def validate_hash(h):\n        return isinstance(h, str) and len(h) == 128 and all(c in '0123456789abcdef' for c in h)\n    \n    if not validate_hash(data.get('root"]
