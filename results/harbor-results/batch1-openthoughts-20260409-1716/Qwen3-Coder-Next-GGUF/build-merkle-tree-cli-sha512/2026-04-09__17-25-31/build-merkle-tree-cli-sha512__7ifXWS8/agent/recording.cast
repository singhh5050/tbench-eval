[71.164264, "i", "\n    subparsers = parser.add_subparsers(dest='command', required=True)\n    \n    # Scan command\n    scan_parser = subparsers.add_parser('scan', help='Scan directory and build Merkle tree')\n    scan_parser.add_argument('directory', help='Directory to scan')\n    \n    # Proof command\n    proof_parser = subparsers.add_parser('proof', help='Generate Merkle proof for a file')\n    proof_parser.add_argument('file_path', help='File path (relative to scanned directory)')\n    \n    # Verify command\n    verify_parser = subparsers.add_parser('verify', help='Verify file integrity')\n    verify_parser.add_argument('file_path', help='File path to verify')\n    verify_parser.add_argument('proof_file', help='Path to proof JSON file')\n    \n    args = parser.parse_args()\n    \n    if args.command == 'scan':\n        return cmd_scan(args)\n    elif args.command == 'proof':\n        return cmd_proof(args)\n    elif args.command == 'verify':\n        return cmd_verify(args)\n    \n    return 1\n\n\nif __name__ == '__main__':\n    sys.exit(main())\n"]
