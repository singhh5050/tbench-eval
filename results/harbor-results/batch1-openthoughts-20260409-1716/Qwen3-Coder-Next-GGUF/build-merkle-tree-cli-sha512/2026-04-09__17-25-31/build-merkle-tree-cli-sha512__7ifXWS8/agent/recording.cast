[71.16748, "o", "\u001b[?2004h> "]
[71.167503, "o", "                else:\r\n\u001b[?2004l\r"]
[71.167516, "o", "\u001b[?2004h> "]
[71.167567, "o", "                    # Duplicate last node if odd number\r\n\u001b[?2004l\r"]
[71.167581, "o", "\u001b[?2004h> "]
[71.167645, "o", "                    combined = sha512_concatenate(hashes[j], hashes[j])\r\n\u001b[?2004l\r"]
[71.167659, "o", "\u001b[?2004h> "]
[71.167696, "o", "                next_level.append(combined)\r\n\u001b[?2004l\r"]
[71.16771, "o", "\u001b[?2004h> "]
[71.167742, "o", "            hashes = next_level\r\n\u001b[?2004l\r"]
[71.167754, "o", "\u001b[?2004h>         \r\n"]
[71.167766, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.16781, "o", "        self.root_hash = hashes[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.167823, "o", "> "]
[71.167836, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.167885, "o", "    def _generate_proof(self, hashes, leaf_index):\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.167897, "o", "> "]
[71.167947, "o", "        \"\"\"Generate Merkle proof for leaf at given index.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.167959, "o", "> "]
[71.167975, "o", "        proof = []\r\n\u001b[?2004l\r"]
[71.167987, "o", "\u001b[?2004h> "]
[71.168017, "o", "        current_level = hashes[:]\r\n\u001b[?2004l\r"]
[71.16803, "o", "\u001b[?2004h>         \r\n"]
[71.168042, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.168081, "o", "        while len(current_level) > 1:\r\n\u001b[?2004l\r"]
[71.168093, "o", "\u001b[?2004h> "]
[71.168121, "o", "            # Determine sibling\r\n\u001b[?2004l\r"]
[71.168134, "o", "\u001b[?2004h> "]
[71.168164, "o", "            if leaf_index % 2 == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.168179, "o", "> "]
[71.168228, "o", "                # We're on the left, sibling is on right\r\n\u001b[?2004l\r"]
[71.168241, "o", "\u001b[?2004h> "]
[71.168284, "o", "                sibling_index = leaf_index + 1\r\n\u001b[?2004l\r"]
[71.168298, "o", "\u001b[?2004h> "]
[71.168324, "o", "                side = \"right\"\r\n\u001b[?2004l\r"]
[71.168338, "o", "\u001b[?2004h> "]
[71.168352, "o", "            else:\r\n\u001b[?2004l\r"]
[71.168365, "o", "\u001b[?2004h> "]
[71.168417, "o", "                # We're on the right, sibling is on left\r\n\u001b[?2004l\r"]
[71.168429, "o", "\u001b[?2004h> "]
[71.168473, "o", "                sibling_index = leaf_index - 1\r\n\u001b[?2004l\r"]
[71.168485, "o", "\u001b[?2004h> "]
[71.168516, "o", "                side = \"left\"\r\n\u001b[?2004l\r"]
[71.168529, "o", "\u001b[?2004h> "]
[71.168542, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.168556, "o", "> "]
[71.168599, "o", "            if sibling_index < len(current_level):\r\n\u001b[?2004l\r"]
[71.168613, "o", "\u001b[?2004h> "]
[71.168675, "o", "                proof.append([side, current_level[sibling_index]])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.168696, "o", "            else:\r\n\u001b[?2004l\r"]
[71.16871, "o", "\u001b[?2004h> "]
[71.168797, "o", "                # Sibling doesn't exist, use our own hash (duplication case)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.168849, "o", "                proof.append([side, current_level[leaf_index]])\r\n\u001b[?2004l\r"]
[71.168862, "o", "\u001b[?2004h> "]
[71.168873, "o", "            \r\n\u001b[?2004l\r"]
[71.168886, "o", "\u001b[?2004h> "]
[71.168916, "o", "            # Move to next level\r\n\u001b[?2004l\r"]
[71.168928, "o", "\u001b[?2004h> "]
[71.168955, "o", "            next_level = []\r\n\u001b[?2004l\r"]
[71.168968, "o", "\u001b[?2004h> "]
[71.169018, "o", "            for j in range(0, len(current_level), 2):\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.169031, "o", "> "]
[71.169073, "o", "                if j + 1 < len(current_level):\r\n\u001b[?2004l\r"]
[71.169086, "o", "\u001b[?2004h> "]
[71.169168, "o", "                    combined = sha512_concatenate(current_level[j], current_level[j + 1])\r\n\u001b[?2004l\r"]
[71.169182, "o", "\u001b[?2004h> "]
[71.1692, "o", "                else:\r\n\u001b[?2004l\r"]
[71.169214, "o", "\u001b[?2004h> "]
[71.169291, "o", "                    combined = sha512_concatenate(current_level[j], current_level[j])\r\n\u001b[?2004l\r"]
[71.169304, "o", "\u001b[?2004h> "]
[71.169343, "o", "                next_level.append(combined)\r\n\u001b[?2004l\r"]
[71.169356, "o", "\u001b[?2004h> "]
[71.169369, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.169411, "o", "            current_level = next_level\r\n\u001b[?2004l\r"]
[71.169424, "o", "\u001b[?2004h> "]
[71.16946, "o", "            leaf_index = leaf_index // 2\r\n\u001b[?2004l\r"]
[71.169472, "o", "\u001b[?2004h>         \r\n"]
[71.169485, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.169509, "o", "        return proof\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.169522, "o", ">     \r\n\u001b[?2004l\r"]
[71.169534, "o", "\u001b[?2004h> "]
[71.169563, "o", "    def get_proof(self, file_path):\r\n\u001b[?2004l\r"]
[71.169575, "o", "\u001b[?2004h"]
[71.169588, "o", "> "]
[71.169614, "o", "        \"\"\"Get Merkle proof for a file.\"\"\"\r\n\u001b[?2004l\r"]
[71.169627, "o", "\u001b[?2004h> "]
[71.169663, "o", "        return self.proofs.get(file_path)\r\n\u001b[?2004l\r"]
[71.169676, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.169689, "o", "\u001b[?2004h> "]
[71.169727, "o", "    def to_dict(self, scanned_dir):\r\n\u001b[?2004l\r"]
[71.169739, "o", "\u001b[?2004h> "]
[71.169791, "o", "        \"\"\"Convert to dictionary for JSON storage.\"\"\"\r\n\u001b[?2004l\r"]
[71.169803, "o", "\u001b[?2004h> "]
[71.169818, "o", "        return {\r\n\u001b[?2004l\r"]
[71.169831, "o", "\u001b[?2004h> "]
[71.169868, "o", "            \"root_hash\": self.root_hash,\r\n\u001b[?2004l\r"]
[71.16988, "o", "\u001b[?2004h> "]
[71.169914, "o", "            \"proofs\": self.proofs,\r\n\u001b[?2004l\r    \u001b[?2004h> "]
[71.169962, "o", "            \"file_hashes\": self.file_hashes,\r\n\u001b[?2004l\r"]
[71.169975, "o", "\u001b[?2004h> "]
[71.170019, "o", "            \"scanned_directory\": str(scanned_dir)\r\n\u001b[?2004l\r"]
[71.170033, "o", "\u001b[?2004h>         }"]
[71.170044, "o", "\r\n\u001b[?2004l\r"]
[71.170057, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.170071, "o", "> "]
[71.170089, "o", "def load_merkle_data():\r\n\u001b[?2004l\r"]
[71.170103, "o", "\u001b[?2004h> "]
[71.170149, "o", "    \"\"\"Load merkle_data.json and validate hashes.\"\"\"\r\n\u001b[?2004l\r"]
[71.170164, "o", "\u001b[?2004h> "]
[71.170202, "o", "    data_path = Path('/app/merkle_data.json')\r\n\u001b[?2004l\r"]
[71.170215, "o", "\u001b[?2004h> "]
[71.170242, "o", "    if not data_path.exists():\r\n\u001b[?2004l\r"]
[71.170255, "o", "\u001b[?2004h> "]
[71.170272, "o", "        return None\r\n\u001b[?2004l\r"]
[71.170285, "o", "\u001b[?2004h> "]
[71.170299, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.170331, "o", "    with open(data_path, 'r') as f:\r\n\u001b[?2004l\r"]
[71.170344, "o", "\u001b[?2004h> "]
[71.17037, "o", "        data = json.load(f)\r\n\u001b[?2004l\r"]
[71.170383, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.170397, "o", "> "]
[71.170437, "o", "    # Validate hashes are 128-char hex strings\r\n\u001b[?2004l\r"]
[71.17045, "o", "\u001b[?2004h> "]
[71.170472, "o", "    def validate_hash(h):\r\n\u001b[?2004l\r"]
[71.170486, "o", "\u001b[?2004h> "]
[71.170572, "o", "        return isinstance(h, str) and len(h) == 128 and all(c in '0123456789abcdef' for c in h)\r\n\u001b[?2004l\r"]
[71.170585, "o", "\u001b[?2004h> "]
[71.170598, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.170647, "o", "    if not validate_hash(data.get('root_hash', '')):\r\n\u001b[?2004l\r"]
[71.17066, "o", "\u001b[?2004h> "]
[71.170675, "o", "        return None\r\n\u001b[?2004l\r"]
[71.170689, "o", "\u001b[?2004h> "]
[71.170701, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.170752, "o", "    for fp, h in data.get('file_hashes', {}).items():\r\n\u001b[?2004l\r"]
[71.170765, "o", "\u001b[?2004h> "]
[71.170799, "o", "        if not validate_hash(h):\r\n\u001b[?2004l\r"]
[71.170811, "o", "\u001b[?2004h> "]
[71.170831, "o", "            return None\r\n\u001b[?2004l\r"]
[71.170844, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.170856, "o", "\u001b[?2004h> "]
[71.170907, "o", "    for fp, proof in data.get('proofs', {}).items():\r\n\u001b[?2004l\r"]
[71.170919, "o", "\u001b[?2004h> "]
[71.170945, "o", "        for entry in proof:\r\n\u001b[?2004l\r"]
[71.170959, "o", "\u001b[?2004h> "]
[71.171016, "o", "            if len(entry) != 2 or not validate_hash(entry[1]):\r\n\u001b[?2004l\r"]
[71.171028, "o", "\u001b[?2004h> "]
[71.171055, "o", "                return None\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.171069, "o", ">     \r\n\u001b[?2004l\r"]
[71.171082, "o", "\u001b[?2004h> "]
[71.171093, "o", "    return data\r\n\u001b[?2004l\r"]
[71.171106, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.171118, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.171141, "o", "def cmd_scan(args):\r\n\u001b[?2004l\r"]
[71.171153, "o", "\u001b[?2004h> "]
[71.171198, "o", "    \"\"\"Scan directory and build Merkle tree.\"\"\"\r\n\u001b[?2004l\r"]
[71.171211, "o", "\u001b[?2004h> "]
[71.171245, "o", "    directory = Path(args.directory)\r\n\u001b[?2004l\r"]
[71.171257, "o", "\u001b[?2004h> "]
[71.171285, "o", "    if not directory.exists():\r\n\u001b[?2004l\r"]
[71.171298, "o", "\u001b[?2004h> "]
[71.171373, "o", "        print(f\"Error: Directory '{directory}' does not exist\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[71.171385, "o", "\u001b[?2004h> "]
[71.1714, "o", "        return 1\r\n\u001b[?2004l\r"]
[71.171412, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.171424, "o", "\u001b[?2004h> "]
[71.171452, "o", "    if not directory.is_dir():\r\n\u001b[?2004l\r"]
[71.171464, "o", "\u001b[?2004h> "]
[71.171534, "o", "        print(f\"Error: '{directory}' is not a directory\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[71.171546, "o", "\u001b[?2004h> "]
[71.171559, "o", "        return 1\r\n\u001b[?2004l\r"]
[71.171571, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.171583, "o", "\u001b[?2004h> "]
[71.171605, "o", "    tree = MerkleTree()\r\n\u001b[?2004l\r"]
[71.171618, "o", "\u001b[?2004h> "]
[71.171653, "o", "    tree.build_from_directory(directory)\r\n\u001b[?2004l\r"]
[71.171666, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.171678, "o", "\u001b[?2004h> "]
[71.171722, "o", "    data = tree.to_dict(directory.resolve())\r\n\u001b[?2004l\r"]
[71.171735, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.171748, "o", "\u001b[?2004h> "]
[71.171795, "o", "    with open('/app/merkle_data.json', 'w') as f:\r\n\u001b[?2004l\r"]
[71.171807, "o", "\u001b[?2004h> "]
[71.171839, "o", "        json.dump(data, f, indent=2)\r\n\u001b[?2004l\r"]
[71.171852, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.171863, "o", "\u001b[?2004h> "]
[71.171904, "o", "    print(f\"Scanned {len(tree.leaves)} files\")\r\n\u001b[?2004l\r"]
[71.171916, "o", "\u001b[?2004h> "]
[71.171956, "o", "    print(f\"Root hash: {tree.root_hash}\")\r\n\u001b[?2004l\r"]
[71.171968, "o", "\u001b[?2004h> "]
[71.17198, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.171991, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.172004, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.172027, "o", "def cmd_proof(args):\r\n\u001b[?2004l\r"]
[71.17204, "o", "\u001b[?2004h> "]
[71.17208, "o", "    \"\"\"Generate Merkle proof for a file.\"\"\"\r\n\u001b[?2004l\r"]
[71.172091, "o", "\u001b[?2004h> "]
[71.172117, "o", "    data = load_merkle_data()\r\n\u001b[?2004l\r"]
[71.17213, "o", "\u001b[?2004h> "]
[71.172147, "o", "    if data is None:\r\n\u001b[?2004l\r"]
[71.17216, "o", "\u001b[?2004h> "]
[71.172236, "o", "        print(\"Error: No merkle_data.json found. Run scan first.\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[71.172248, "o", "\u001b[?2004h> "]
[71.172263, "o", "        return 1\r\n\u001b[?2004l\r"]
[71.172276, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.172287, "o", "\u001b[?2004h> "]
[71.172318, "o", "    file_path = args.file_path\r\n\u001b[?2004l\r"]
[71.17233, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.172342, "o", "\u001b[?2004h> "]
[71.172384, "o", "    if file_path not in data['file_hashes']:\r\n\u001b[?2004l\r"]
[71.172396, "o", "\u001b[?2004h> "]
[71.172476, "o", "        print(f\"Error: File '{file_path}' not found in Merkle tree\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[71.172488, "o", "\u001b[?2004h> "]
[71.172504, "o", "        return 1\r\n\u001b[?2004l\r"]
[71.172516, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.172528, "o", "\u001b[?2004h> "]
[71.172572, "o", "    proof = data['proofs'].get(file_path, [])\r\n\u001b[?2004l\r"]
[71.172584, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.172596, "o", "\u001b[?2004h> "]
[71.17261, "o", "    output = {\r\n\u001b[?2004l\r"]
[71.172621, "o", "\u001b[?2004h> "]
[71.172651, "o", "        \"file_path\": file_path,\r\n\u001b[?2004l\r"]
[71.172663, "o", "\u001b[?2004h> "]
[71.172685, "o", "        \"proof\": proof\r\n\u001b[?2004l\r"]
[71.172698, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[71.17271, "o", "\u001b[?2004h>     \r\n"]
[71.172723, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.172762, "o", "    print(json.dumps(output, indent=2))\r\n\u001b[?2004l\r"]
[71.172778, "o", "\u001b[?2004h> "]
[71.17279, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.172803, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.172815, "o", "\u001b[?2004h> "]
[71.172837, "o", "def cmd_verify(args):\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.172848, "o", "> "]
[71.1729, "o", "    \"\"\"Verify a file's integrity against stored proof.\"\"\"\r\n\u001b[?2004l\r"]
[71.172913, "o", "\u001b[?2004h> "]
[71.172939, "o", "    data = load_merkle_data()\r\n\u001b[?2004l\r"]
[71.172951, "o", "\u001b[?2004h> "]
[71.172969, "o", "    if data is None:\r\n\u001b[?2004l\r"]
[71.172981, "o", "\u001b[?2004h> "]
[71.17306, "o", "        print(\"Error: No merkle_data.json found. Run scan first.\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[71.173073, "o", "\u001b[?2004h> "]
[71.173086, "o", "        return 1\r\n\u001b[?2004l\r"]
[71.173098, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.173105, "o", "\u001b[?2004h> "]
[71.173141, "o", "    file_path = args.file_path\r\n\u001b[?2004l\r"]
[71.173153, "o", "\u001b[?2004h> "]
[71.173188, "o", "    proof_file = Path(args.proof_file)\r\n\u001b[?2004l\r"]
[71.173201, "o", "\u001b[?2004h> "]
[71.173213, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.173238, "o", "    # Load proof from file\r\n\u001b[?2004l\r"]
[71.17325, "o", "\u001b[?2004h> "]
[71.17328, "o", "    if not proof_file.exists():\r\n\u001b[?2004l\r"]
[71.173292, "o", "\u001b[?2004h> "]
[71.173358, "o", "        print(f\"Error: Proof file '{proof_file}' does not exist\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[71.173371, "o", "\u001b[?2004h> "]
[71.173384, "o", "        return 1\r\n\u001b[?2004l\r"]
[71.173396, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.173424, "o", "    with open(proof_file, 'r') as f:\r\n\u001b[?2004l\r"]
[71.173436, "o", "\u001b[?2004h> "]
[71.173455, "o", "        proof_data = json.load(f)\r\n\u001b[?2004l\r"]
[71.173467, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.17348, "o", "\u001b[?2004h> "]
[71.1735, "o", "    # Get current hash of the file\r\n\u001b[?2004l\r"]
[71.173513, "o", "\u001b[?2004h>     try:\r\n"]
[71.173525, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.173562, "o", "        # Try relative path first (from scanned directory)\r\n\u001b[?2004l\r"]
[71.173573, "o", "\u001b[?2004h> "]
[71.173606, "o", "        scanned_dir = Path(data['scanned_directory'])\r\n\u001b[?2004l\r"]
[71.173618, "o", "\u001b[?2004h> "]
[71.173643, "o", "        abs_path = scanned_dir / file_path\r\n\u001b[?2004l\r"]
[71.173656, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[71.173668, "o", "\u001b[?2004h> "]
[71.173689, "o", "        if not abs_path.exists():\r\n\u001b[?2004l\r"]
[71.173702, "o", "\u001b[?2004h> "]
[71.173722, "o", "            # Try as absolute path\r\n\u001b[?2004l\r"]
[71.173734, "o", "\u001b[?2004h> "]
[71.173757, "o", "            abs_path = Path(file_path)\r\n\u001b[?2004l\r"]
[71.17377, "o", "\u001b[?2004h> "]
[71.173794, "o", "            if not abs_path.exists():\r\n\u001b[?2004l\r"]
[71.173806, "o", "\u001b[?2004h> "]
[71.173853, "o", "                print(f\"Error: File not found: {file_path}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[71.173866, "o", "\u001b[?2004h> "]
[71.17388, "o", "                return 1\r\n\u001b[?2004l\r"]
[71.173892, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[71.173903, "o", "\u001b[?2004h> "]
[71.173932, "o", "        with open(abs_path, 'rb') as f:\r\n\u001b[?2004l\r"]
[71.173944, "o", "\u001b[?2004h> "]
[71.173973, "o", "            current_hash = sha512_hash(f.read())\r\n\u001b[?2004l\r"]
[71.173986, "o", "\u001b[?2004h> "]
[71.174001, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[71.174012, "o", "\u001b[?2004h> "]
[71.174049, "o", "        print(f\"Error reading file: {e}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[71.174061, "o", "\u001b[?2004h> "]
[71.174073, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.174086, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.174113, "o", "    # Reconstruct root from proof\r\n\u001b[?2004l\r"]
[71.174125, "o", "\u001b[?2004h> "]
[71.17414, "o", "    current = current_hash\r\n\u001b[?2004l\r"]
[71.174153, "o", "\u001b[?2004h> "]
[71.174181, "o", "    for side, sibling in proof_data['proof']:\r\n\u001b[?2004l\r"]
[71.174192, "o", "\u001b[?2004h> "]
[71.174208, "o", "        if side == \"left\":\r\n\u001b[?2004l\r"]
[71.17422, "o", "\u001b[?2004h> "]
[71.174256, "o", "            current = sha512_concatenate(sibling, current)\r\n\u001b[?2004l\r"]
[71.174268, "o", "\u001b[?2004h> "]
[71.17428, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.174322, "o", "            current = sha512_concatenate(current, sibling)\r\n\u001b[?2004l\r"]
[71.174334, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.174346, "o", "\u001b[?2004h> "]
[71.174357, "o", "    # Check results\r\n\u001b[?2004l\r"]
[71.174371, "o", "\u001b[?2004h> "]
[71.174399, "o", "    root_matches = (current == data['root_hash'])\r\n\u001b[?2004l\r"]
[71.174411, "o", "\u001b[?2004h> "]
[71.174463, "o", "    file_hash_matches_storage = (current_hash == data['file_hashes'].get(file_path))\r\n\u001b[?2004l\r"]
[71.174475, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.174487, "o", "\u001b[?2004h> "]
[71.174508, "o", "    # Check for added/deleted files\r\n\u001b[?2004l\r"]
[71.17452, "o", "\u001b[?2004h> "]
[71.174551, "o", "    stored_files = set(data['file_hashes'].keys())\r\n\u001b[?2004l\r"]
[71.174563, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.174575, "o", "\u001b[?2004h> "]
[71.174603, "o", "    # Get current files in scanned directory\r\n\u001b[?2004l\r"]
[71.174614, "o", "\u001b[?2004h> "]
[71.174644, "o", "    scanned_dir = Path(data['scanned_directory'])\r\n\u001b[?2004l\r"]
[71.174656, "o", "\u001b[?2004h> "]
[71.174671, "o", "    current_files = set()\r\n\u001b[?2004l\r"]
[71.174684, "o", "\u001b[?2004h> "]
[71.1747, "o", "    if scanned_dir.exists():\r\n\u001b[?2004l\r"]
[71.174713, "o", "\u001b[?2004h> "]
[71.174739, "o", "        for item in scanned_dir.rglob('*'):\r\n\u001b[?2004l\r"]
[71.174751, "o", "\u001b[?2004h> "]
[71.174791, "o", "            if item.is_file() and not item.is_symlink():\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.174803, "o", "> "]
[71.174839, "o", "                rel_path = str(item.relative_to(scanned_dir))\r\n\u001b[?2004l\r"]
[71.174852, "o", "\u001b[?2004h> "]
[71.174877, "o", "                current_files.add(rel_path)\r\n\u001b[?2004l\r"]
[71.174889, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.174901, "o", "\u001b[?2004h> "]
[71.17493, "o", "    added_files = current_files - stored_files\r\n\u001b[?2004l\r"]
[71.174942, "o", "\u001b[?2004h> "]
[71.174971, "o", "    deleted_files = stored_files - current_files\r\n\u001b[?2004l\r"]
[71.174983, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.174996, "o", "\u001b[?2004h> "]
[71.175014, "o", "    # Check for modified files\r\n\u001b[?2004l\r"]
[71.175027, "o", "\u001b[?2004h> "]
[71.175041, "o", "    modified_files = set()\r\n\u001b[?2004l\r"]
[71.175053, "o", "\u001b[?2004h> "]
[71.17508, "o", "    for fp in stored_files & current_files:\r\n\u001b[?2004l\r"]
[71.175092, "o", "\u001b[?2004h> "]
[71.175133, "o", "        if fp != file_path:  # Don't check the file we're verifying\r\n\u001b[?2004l\r"]
[71.175145, "o", "\u001b[?2004h> "]
[71.175167, "o", "            abs_fp = scanned_dir / fp\r\n\u001b[?2004l\r"]
[71.17518, "o", "\u001b[?2004h> "]
[71.175199, "o", "            if abs_fp.exists():\r\n\u001b[?2004l\r"]
[71.17521, "o", "\u001b[?2004h> "]
[71.175238, "o", "                with open(abs_fp, 'rb') as f:\r\n\u001b[?2004l\r"]
[71.17525, "o", "\u001b[?2004h> "]
[71.175285, "o", "                    stored_hash = data['file_hashes'][fp]\r\n\u001b[?2004l\r"]
[71.175297, "o", "\u001b[?2004h> "]
[71.175329, "o", "                    current_h = sha512_hash(f.read())\r\n\u001b[?2004l\r"]
[71.175341, "o", "\u001b[?2004h> "]
[71.17537, "o", "                    if stored_hash != current_h:\r\n\u001b[?2004l\r"]
[71.175382, "o", "\u001b[?2004h> "]
[71.17541, "o", "                        modified_files.add(fp)\r\n\u001b[?2004l\r"]
[71.175422, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.175434, "o", "\u001b[?2004h> "]
[71.17551, "o", "    success = root_matches and file_hash_matches_storage and not added_files and not deleted_files and not modified_files\r\n\u001b[?2004l\r"]
[71.175524, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.175535, "o", "\u001b[?2004h> "]
[71.175547, "o", "    output = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.175573, "o", "        \"file_path\": file_path,\r\n\u001b[?2004l\r"]
[71.175586, "o", "\u001b[?2004h> "]
[71.175609, "o", "        \"root_matches\": root_matches,\r\n\u001b[?2004l\r"]
[71.175622, "o", "\u001b[?2004h> "]
[71.175659, "o", "        \"file_hash_matches_storage\": file_hash_matches_storage,\r\n\u001b[?2004l\r"]
[71.175671, "o", "\u001b[?2004h> "]
[71.175697, "o", "        \"added_files\": list(added_files),\r\n\u001b[?2004l\r"]
[71.17571, "o", "\u001b[?2004h> "]
[71.175736, "o", "        \"deleted_files\": list(deleted_files),\r\n\u001b[?2004l\r"]
[71.175749, "o", "\u001b[?2004h> "]
[71.175782, "o", "        \"modified_files\": list(modified_files)\r\n\u001b[?2004l\r"]
[71.175793, "o", "\u001b[?2004h>     }\r\n"]
[71.175805, "o", "\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[71.175817, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.175829, "o", "    if success:\r\n\u001b[?2004l\r"]
[71.175842, "o", "\u001b[?2004h> "]
[71.175866, "o", "        print(\"Verification successful!\")\r\n\u001b[?2004l\r"]
[71.175878, "o", "\u001b[?2004h> "]
[71.175905, "o", "        print(f\"File hash: {current_hash}\")\r\n\u001b[?2004l\r"]
[71.175917, "o", "\u001b[?2004h> "]
[71.175949, "o", "        print(f\"Root hash matches: {root_matches}\")\r\n\u001b[?2004l\r"]
[71.175961, "o", "\u001b[?2004h> "]
[71.175972, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.175985, "o", "    else:\r\n\u001b[?2004l\r"]
[71.175997, "o", "\u001b[?2004h> "]
[71.176021, "o", "        print(\"Verification failed!\")\r\n\u001b[?2004l\r"]
[71.176033, "o", "\u001b[?2004h> "]
[71.176059, "o", "        print(json.dumps(output, indent=2))\r\n\u001b[?2004l\r"]
[71.176072, "o", "\u001b[?2004h> "]
[71.176085, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.176097, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.176109, "o", "\u001b[?2004h> "]
[71.176121, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.176173, "o", "    parser = argparse.ArgumentParser(description='Merkle Tree CLI Tool')\r\n\u001b[?2004l\r"]
[71.176185, "o", "\u001b[?2004h> "]
[71.176228, "o", "    subparsers = parser.add_subparsers(dest='command', required=True)\r\n\u001b[?2004l\r"]
[71.17624, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.176251, "o", "\u001b[?2004h> "]
[71.176263, "o", "    # Scan command\r\n\u001b[?2004l\r"]
[71.176276, "o", "\u001b[?2004h> "]
[71.176332, "o", "    scan_parser = subparsers.add_parser('scan', help='Scan directory and build Merkle tree')\r\n\u001b[?2004l\r"]
[71.176345, "o", "\u001b[?2004h> "]
[71.176386, "o", "    scan_parser.add_argument('directory', help='Directory to scan')\r\n\u001b[?2004l\r"]
[71.176398, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.17641, "o", "\u001b[?2004h> "]
[71.176422, "o", "    # Proof command\r\n\u001b[?2004l\r"]
[71.176435, "o", "\u001b[?2004h> "]
[71.17649, "o", "    proof_parser = subparsers.add_parser('proof', help='Generate Merkle proof for a file')\r\n\u001b[?2004l\r"]
[71.176503, "o", "\u001b[?2004h> "]
[71.176561, "o", "    proof_parser.add_argument('file_path', help='File path (relative to scanned directory)')\r\n\u001b[?2004l\r"]
[71.176573, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.176585, "o", "\u001b[?2004h> "]
[71.176599, "o", "    # Verify command\r\n\u001b[?2004l\r"]
[71.176611, "o", "\u001b[?2004h> "]
[71.176662, "o", "    verify_parser = subparsers.add_parser('verify', help='Verify file integrity')\r\n\u001b[?2004l\r"]
[71.176675, "o", "\u001b[?2004h> "]
[71.176719, "o", "    verify_parser.add_argument('file_path', help='File path to verify')\r\n\u001b[?2004l\r"]
[71.176734, "o", "\u001b[?2004h> "]
[71.176801, "o", "    verify_parser.add_argument('proof_file', help='Path to proof JSON file')\r\n\u001b[?2004l\r"]
[71.176821, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.176832, "o", "\u001b[?2004h> "]
[71.176848, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r"]
[71.176859, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.176871, "o", "\u001b[?2004h> "]
[71.176892, "o", "    if args.command == 'scan':\r\n\u001b[?2004l\r"]
[71.176904, "o", "\u001b[?2004h> "]
[71.176923, "o", "        return cmd_scan(args)\r\n\u001b[?2004l\r"]
[71.176937, "o", "\u001b[?2004h> "]
[71.176955, "o", "    elif args.command == 'proof':\r\n\u001b[?2004l\r"]
[71.176969, "o", "\u001b[?2004h> "]
[71.176987, "o", "        return cmd_proof(args)\r\n\u001b[?2004l\r"]
[71.177001, "o", "\u001b[?2004h> "]
[71.177021, "o", "    elif args.command == 'verify':\r\n\u001b[?2004l\r"]
[71.177033, "o", "\u001b[?2004h> "]
[71.177054, "o", "        return cmd_verify(args)\r\n\u001b[?2004l\r"]
[71.177066, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[71.17708, "o", "\u001b[?2004h> "]
[71.177094, "o", "    return 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.177109, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.177133, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[71.177146, "o", "\u001b[?2004h> "]
[71.17716, "o", "    sys.exit(main())\r\n\u001b[?2004l\r"]
[71.177172, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[71.178615, "o", "\u001b[?2004hroot@8d75f47cee9b:/app# "]
[84.357254, "i", "chmod +x /app/merkle_cli.py\n"]
[84.357383, "o", "chmod +x /app/merkle_cli.py\r\n\u001b[?2004l\r"]
[84.358213, "o", "\u001b[?2004hroot@8d75f47cee9b:/app# "]
[84.454907, "i", "mkdir -p /app/test_data/subdir\n"]
[84.455037, "o", "mkdir -p /app/test_data/subdir\r\n\u001b[?2004l\r"]
[84.456034, "o", "\u001b[?2004h"]
[84.456089, "o", "root@8d75f47cee9b:/app# "]
[84.565316, "i", "echo 'Hello World' > /app/test_data/file1.txt\n"]
[84.565463, "o", "echo 'Hello World' > /app/test_data/file1.txt\r\n\u001b[?2004l\r"]
[84.570055, "o", "\u001b[?2004hroot@8d75f47cee9b:/app# "]
[84.668395, "i", "echo 'Test content' > /app/test_data/file2.txt\n"]
[84.668605, "o", "echo 'Test content' > /app/test_data/file2.txt\r\n\u001b[?2004l\r"]
[84.669238, "o", "\u001b[?2004hroot@8d75f47cee9b:/app# "]
[84.770656, "i", "echo 'Nested file' > /app/test_data/subdir/nested.txt\n"]
[84.770825, "o", "echo 'Nested file' > /app/test_data/subdir/nested.txt\r\n\u001b[?2004l\r"]
[84.7718, "o", "\u001b[?2004hroot@8d75f47cee9b:/app# "]
[84.864452, "i", "python3 /app/merkle_cli.py scan /app/test_data\n"]
[84.864691, "o", "python3 /app/merkle_cli.py scan /app/test_data\r\n"]
[84.864702, "o", "\u001b[?2004l\r"]
[84.964368, "o", "Scanned 4 files\r\nRoot hash: a1cfd6d78fc8b26b91f2beafe334985326d2747ac068cd701b6fdbca6cfbfe08da584eb05f0fbe6b577c782fe499f546822537ec10f709213f4734dce17ff9cb\r\n"]
[84.969778, "o", "\u001b[?2004hroot@8d75f47cee9b:/app# "]
[91.189806, "i", "cat /app/merkle_data.json\n"]
[91.18997, "o", "cat /app/merkle_data.json\r\n\u001b[?2004l\r"]
