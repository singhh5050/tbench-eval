[25.166075, "i", "cat > train_and_register.py << 'EOF'\nimport mlflow\nimport mlflow.sklearn\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.datasets import make_regression\nimport numpy as np\n\n# Set tracking URI\nmlflow.set_tracking_uri(\"http://localhost:8080\")\n\n# Set experiment\nmlflow.set_experiment(\"linear_regression_experiment\")\n\n# Create random dataset with 3 features\nX, y = make_regression(n_samples=100, n_features=3, random_state=42)\n\n# Create and train the model\nmodel = LinearRegression()\nmodel.fit(X, y)\n\n# Start MLflow run and log the model\nwith mlflow.start_run(run_name=\"linear_regression_run\"):\n    # Log parameters\n    mlflow.log_param(\"n_features\", 3)\n    mlflow.log_param(\"n_samples\", 100)\n    \n    # Log model metrics\n    train_score = model.score(X, y)\n    mlflow.log_metric(\"r2_score\", train_score)\n    \n    # Log the model as 'gpt-5'\n    mlflow.sklearn.log_model(model, \"model\", registered_model_name=\"gpt-5\")\n    \n    print(f\"Model trained with R2 score: {train_score}\")\n    print(\"Model registered as 'gp"]
[25.166207, "i", "t-5' in MLflow\")\nEOF\n"]
