[?2004hroot@8838abadccc6:/app# cat > /app/aggregate.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import glob
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> # Data structures for aggregation
[?2004l[?2004h> user_amounts = defaultdict(float)
[?2004l[?2004h> user_items = defaultdict(int)
[?2004l[?2004h> tag_counts = defaultdict(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Read all JSONL files
[?2004l[?2004h> for filepath in glob.glob('/app/records_*.jsonl'):
[?2004l[?2004h>     with open(filepath, 'r') as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             record = json.loads(line)
[?2004l[?2004h>             user = record['user']
[?2004l[?2004h>             amount = record['amount']
[?2004l[?2004h>             items = record['items']
[?2004l[?2004h>             tags = record['tags']
[?2004l[?2004h>             
[?2004l[?2004h>             user_amounts[user] += amount
[?2004l[?2004h>             user_items[user] += items
[?2004l[?2004h>             
[?2004l[?2004h>             for tag in tags:
[?2004l[?2004h>                 tag_counts[tag] += 1
[?2004l[?2004h> 
[?2004l[?2004h> # Get top 5 users by total amount (rounded to 2 decimal places)
[?2004l[?2004h> top_users = dict(sorted(user_amounts.items(), key=lambda x: x[1], reverse=True)[:5])
[?2004l[?2004h> top_5_users = {user: {"total_amount": round(amount, 2), "total_items": user_items[user]} for user, amount in top_users.items()}
[?2004l[?2004h> 
[?2004l[?2004h> # Get top 5 tags by count
[?2004l[?2004h> top_tags = dict(sorted(tag_counts.items(), key=lambda x: x[1], reverse=True)[:5])
[?2004l[?2004h> top_5_tags = {tag: {"count": count} for tag, count in top_tags.items()}
[?2004l[?2004h> 
[?2004l[?2004h> # Create output structure
[?2004l[?2004h> output = {
[?2004l[?2004h>     "top_5_users_by_amount": top_5_users,
[?2004l[?2004h>     "top_5_tags_by_count": top_5_tags
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Write to file
[?2004l[?2004h> with open('/app/aggregates.json', 'w') as f:
[?2004l[?2004h>     json.dump(output, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print("Done! Created /app/aggregates.json")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@8838abadccc6:/app# python3 /app/aggregate.py
[?2004lDone! Created /app/aggregates.json
