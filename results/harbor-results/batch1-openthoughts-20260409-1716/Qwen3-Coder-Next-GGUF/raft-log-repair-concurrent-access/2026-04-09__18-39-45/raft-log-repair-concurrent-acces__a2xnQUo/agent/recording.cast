[49.133569, "i", "cat > /app/solution.py << 'EOF'\ndef solve(lines: list[str]) -> str:\n    if not lines:\n        return \"OK\"\n    \n    import re\n    \n    # Parse lines\n    entries = []\n    node_pattern = re.compile(r'^n[0-9][0-9]*$')\n    \n    for line in lines:\n        stripped = line.strip()\n        \n        # Skip empty lines and comments\n        if not stripped or stripped.startswith('#'):\n            continue\n        \n        fields = stripped.split()\n        \n        # Validate field count\n        if len(fields) < 4 or len(fields) > 5:\n            break\n        \n        try:\n            term = int(fields[0])\n            if term < 0:\n                break\n        except ValueError:\n            break\n        \n        try:\n            index = int(fields[1])\n            if index < 1:\n                break\n        except ValueError:\n            break\n        \n        node = fields[2]\n        if not node_pattern.match(node):\n            break\n        \n        op = fields[3]\n        if op not in ('VOTE', 'APPEND', 'COMMIT', 'LEADE"]
