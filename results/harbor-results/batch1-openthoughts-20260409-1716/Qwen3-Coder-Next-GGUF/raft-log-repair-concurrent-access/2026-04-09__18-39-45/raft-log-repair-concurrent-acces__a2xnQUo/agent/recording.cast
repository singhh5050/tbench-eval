[263.569567, "o", "for i, (inp, expected) in enumerate(tests, 1):\r\n\u001b[?2004l\r"]
[263.569578, "o", "\u001b[?2004h> "]
[263.5696, "o", "    result = solve(inp)\r\n\u001b[?2004l\r"]
[263.569611, "o", "\u001b[?2004h> "]
[263.569634, "o", "    if result != expected:\r\n\u001b[?2004l\r"]
[263.569645, "o", "\u001b[?2004h> "]
[263.569714, "o", "        print(f\"Test {i}: FAIL - got {repr(result)}, expected {repr(expected)}\")\r\n\u001b[?2004l\r"]
[263.569725, "o", "\u001b[?2004h> "]
[263.569747, "o", "        all_pass = False\r\n\u001b[?2004l\r"]
[263.569759, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[263.569771, "o", "\u001b[?2004h"]
[263.569783, "o", "> if all_pass:\r\n\u001b[?2004l\r"]
[263.569794, "o", "\u001b[?2004h> "]
[263.569833, "o", "    print(f\"All {len(tests)} tests passed!\")\r\n"]
[263.569846, "o", "\u001b[?2004l\r"]
[263.569859, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r"]
[263.56987, "o", "\u001b[?2004h> "]
[263.569897, "o", "    print(\"Some tests failed!\")\r\n\u001b[?2004l\r"]
[263.569907, "o", "\u001b[?2004h> "]
[263.569921, "o", "PYEOF\r\n\u001b[?2004l\r"]
[263.581649, "o", "All 14 tests passed!\r\n"]
[263.583708, "o", "\u001b[?2004hroot@b26515120965:/app# "]
