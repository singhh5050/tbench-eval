[187.629003, "o", "\u001b[?2004h> "]
[187.629022, "o", "    if len(sys.argv) > 1:\r\n\u001b[?2004l\r"]
[187.62903, "o", "\u001b[?2004h> "]
[187.629059, "o", "        with open(sys.argv[1]) as f:\r\n\u001b[?2004l\r"]
[187.629068, "o", "\u001b[?2004h> "]
[187.629105, "o", "            lines = f.read().strip().split('\\n')\r\n\u001b[?2004l\r"]
[187.629115, "o", "\u001b[?2004h> "]
[187.629125, "o", "    else:\r\n\u001b[?2004l\r"]
[187.629133, "o", "\u001b[?2004h> "]
[187.629176, "o", "        lines = [l.strip() for l in sys.stdin if l.strip()]\r\n\u001b[?2004l\r"]
[187.629189, "o", "\u001b[?2004h> "]
[187.629204, "o", "    print(solve(lines))\r\n\u001b[?2004l\r"]
[187.629213, "o", "\u001b[?2004h> "]
[187.629224, "o", "EOF\r\n\u001b[?2004l\r"]
