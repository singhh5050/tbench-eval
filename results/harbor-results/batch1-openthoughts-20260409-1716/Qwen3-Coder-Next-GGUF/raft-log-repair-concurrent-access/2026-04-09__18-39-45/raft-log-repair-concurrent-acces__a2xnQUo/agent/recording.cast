[118.448497, "o", "            else:\r\n\u001b[?2004l\r"]
[118.448506, "o", "\u001b[?2004h> "]
[118.448533, "o", "                term_data[term] = data\r\n\u001b[?2004l\r"]
[118.448541, "o", "\u001b[?2004h> "]
[118.448549, "o", "        \r\n\u001b[?2004l\r"]
[118.44856, "o", "\u001b[?2004h> "]
[118.448574, "o", "        if has_conflict:\r\n\u001b[?2004l\r"]
[118.448583, "o", "\u001b[?2004h> "]
[118.448621, "o", "            if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[118.44863, "o", "\u001b[?2004h> "]
[118.448669, "o", "                bad_entries.append((idx, \"BAD_CONFLICT\"))\r\n\u001b[?2004l\r"]
[118.448678, "o", "\u001b[?2004h> "]
[118.448688, "o", "        \r\n\u001b[?2004l\r"]
[118.448698, "o", "\u001b[?2004h> "]
[118.448716, "o", "        # Rule 4: COMMIT order\r\n\u001b[?2004l\r"]
[118.448725, "o", "\u001b[?2004h> "]
[118.448751, "o", "        has_append = len(appends) > 0\r\n\u001b[?2004l\r"]
[118.448761, "o", "\u001b[?2004h> "]
[118.448783, "o", "        commit_violation = False\r\n\u001b[?2004l\r"]
[118.448791, "o", "\u001b[?2004h> "]
[118.448799, "o", "        \r\n\u001b[?2004l\r"]
[118.448809, "o", "\u001b[?2004h> "]
[118.448826, "o", "        if not has_append:\r\n\u001b[?2004l\r"]
[118.448836, "o", "\u001b[?2004h> "]
[118.448853, "o", "            if commits:\r\n\u001b[?2004l\r"]
[118.448861, "o", "\u001b[?2004h> "]
[118.448894, "o", "                commit_violation = True\r\n\u001b[?2004l\r"]
[118.448906, "o", "\u001b[?2004h> "]
[118.448916, "o", "        else:\r\n\u001b[?2004l\r"]
[118.448925, "o", "\u001b[?2004h> "]
[118.448949, "o", "            # Winning term = highest term\r\n\u001b[?2004l\r"]
[118.448958, "o", "\u001b[?2004h> "]
[118.449021, "o", "            winning_term = max(appends, key=lambda x: x[0])[0] if appends else None\r\n\u001b[?2004l\r"]
[118.449032, "o", "\u001b[?2004h> "]
[118.449057, "o", "            if winning_term is not None:\r\n\u001b[?2004l\r"]
[118.449065, "o", "\u001b[?2004h> "]
[118.449098, "o", "                for commit_term, _ in commits:\r\n\u001b[?2004l\r"]
[118.449108, "o", "\u001b[?2004h> "]
[118.449143, "o", "                    if commit_term != winning_term:\r\n\u001b[?2004l\r"]
[118.449153, "o", "\u001b[?2004h> "]
[118.449185, "o", "                        commit_violation = True\r\n\u001b[?2004l\r"]
[118.449195, "o", "\u001b[?2004h> "]
[118.449215, "o", "                        break\r\n\u001b[?2004l\r"]
[118.449224, "o", "\u001b[?2004h> "]
[118.449234, "o", "        \r\n\u001b[?2004l\r"]
[118.449245, "o", "\u001b[?2004h> "]
[118.449261, "o", "        if commit_violation:\r\n\u001b[?2004l\r"]
[118.44927, "o", "\u001b[?2004h> "]
[118.449308, "o", "            if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[118.449317, "o", "\u001b[?2004h> "]
[118.449359, "o", "                bad_entries.append((idx, \"BAD_COMMIT_ORDER\"))\r\n\u001b[?2004l\r"]
[118.449368, "o", "\u001b[?2004h> "]
[118.449378, "o", "        \r\n\u001b[?2004l\r"]
[118.449386, "o", "\u001b[?2004h> "]
[118.449413, "o", "        # Rule 3: Duplicate vote detection\r\n\u001b[?2004l\r"]
[118.449424, "o", "\u001b[?2004h> "]
[118.449453, "o", "        for commit_term, node in votes_here:\r\n\u001b[?2004l\r"]
[118.449462, "o", "\u001b[?2004h> "]
[118.449495, "o", "            key = (node, commit_term)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.449508, "o", "> "]
[118.449518, "o", "            if key in votes:\r\n\u001b[?2004l\r"]
[118.449528, "o", "\u001b[?2004h> "]
[118.449568, "o", "                if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[118.449579, "o", "\u001b[?2004h> "]
[118.449624, "o", "                    bad_entries.append((idx, \"BAD_DUPLICATE_VOTE\"))\r\n\u001b[?2004l\r"]
[118.449634, "o", "\u001b[?2004h> "]
[118.449649, "o", "                break\r\n\u001b[?2004l\r"]
[118.449658, "o", "\u001b[?2004h> "]
[118.44967, "o", "            else:\r\n\u001b[?2004l\r"]
[118.44968, "o", "\u001b[?2004h> "]
[118.449702, "o", "                votes[key] = idx\r\n\u001b[?2004l\r"]
[118.449711, "o", "\u001b[?2004h> "]
[118.449723, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[118.449733, "o", "> "]
[118.449748, "o", "        # Rule 3: Leader order\r\n\u001b[?2004l\r"]
[118.449757, "o", "\u001b[?2004h> "]
[118.449788, "o", "        for leader_term, node in leaders_here:\r\n\u001b[?2004l\r"]
[118.449796, "o", "\u001b[?2004h"]
[118.449806, "o", "> "]
[118.449825, "o", "            if leader_term in leaders:\r\n\u001b[?2004l\r"]
[118.449836, "o", "\u001b[?2004h> "]
[118.449879, "o", "                if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[118.449895, "o", "\u001b[?2004h> "]
[118.449943, "o", "                    bad_entries.append((idx, \"BAD_LEADER_ORDER\"))\r\n\u001b[?2004l\r"]
[118.449952, "o", "\u001b[?2004h> "]
[118.449969, "o", "                break\r\n\u001b[?2004l\r"]
[118.449978, "o", "\u001b[?2004h> "]
[118.44999, "o", "            else:\r\n\u001b[?2004l\r"]
[118.449999, "o", "\u001b[?2004h> "]
[118.450028, "o", "                leaders[leader_term] = idx\r\n\u001b[?2004l\r"]
[118.450038, "o", "\u001b[?2004h> "]
[118.450048, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[118.450057, "o", "> "]
[118.450081, "o", "        # Record committed term if valid\r\n\u001b[?2004l\r"]
[118.45009, "o", "\u001b[?2004h> "]
[118.450131, "o", "        if has_append and not commit_violation and commits:\r\n\u001b[?2004l\r"]
[118.450139, "o", "\u001b[?2004h"]
[118.450148, "o", "> "]
[118.450173, "o", "            committed_terms[idx] = winning_term\r\n\u001b[?2004l\r"]
[118.450181, "o", "\u001b[?2004h> "]
[118.450192, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.450245, "o", "    # Rule 2: Log matching (need committed terms from previous indices)\r\n\u001b[?2004l\r"]
[118.450254, "o", "\u001b[?2004h> "]
[118.450271, "o", "    prev_committed = 0\r\n\u001b[?2004l\r"]
[118.450281, "o", "\u001b[?2004h> "]
[118.450296, "o", "    for idx in indices:\r\n\u001b[?2004l\r"]
[118.450307, "o", "\u001b[?2004h> "]
[118.45033, "o", "        if idx in committed_terms:\r\n\u001b[?2004l\r"]
[118.450339, "o", "\u001b[?2004h> "]
[118.450376, "o", "            if prev_committed > committed_terms[idx]:\r\n\u001b[?2004l\r"]
[118.450388, "o", "\u001b[?2004h> "]
[118.450428, "o", "                if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[118.450435, "o", "\u001b[?2004h> "]
[118.450479, "o", "                    bad_entries.append((idx, \"BAD_LOG_MATCH\"))\r\n\u001b[?2004l\r"]
[118.450491, "o", "\u001b[?2004h> "]
[118.450526, "o", "            prev_committed = committed_terms[idx]\r\n\u001b[?2004l\r"]
[118.450537, "o", "\u001b[?2004h> "]
[118.450547, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.450579, "o", "    # Collect repair entries (missing COMMITs)\r\n\u001b[?2004l\r"]
[118.450589, "o", "\u001b[?2004h> "]
[118.450604, "o", "    ins_entries = []\r\n\u001b[?2004l\r"]
[118.450615, "o", "\u001b[?2004h> "]
[118.450647, "o", "    bad_indices = set(b[0] for b in bad_entries)\r\n\u001b[?2004l\r"]
[118.450658, "o", "\u001b[?2004h> "]
[118.450668, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.450686, "o", "    for idx in indices:\r\n\u001b[?2004l\r"]
[118.450697, "o", "\u001b[?2004h> "]
[118.450716, "o", "        if idx in bad_indices:\r\n\u001b[?2004l\r"]
[118.450727, "o", "\u001b[?2004h> "]
[118.450739, "o", "            continue\r\n\u001b[?2004l\r"]
[118.45075, "o", "\u001b[?2004h> "]
[118.450774, "o", "        index_entries = by_index[idx]\r\n\u001b[?2004l\r"]
[118.450785, "o", "\u001b[?2004h> "]
[118.450828, "o", "        appends = [e for e in index_entries if e[3] == 'APPEND']\r\n\u001b[?2004l\r"]
[118.450838, "o", "\u001b[?2004h> "]
[118.450885, "o", "        commits = [e for e in index_entries if e[3] == 'COMMIT']\r\n\u001b[?2004l\r"]
[118.450895, "o", "\u001b[?2004h> "]
[118.450905, "o", "        \r\n\u001b[?2004l\r"]
[118.450915, "o", "\u001b[?2004h> "]
[118.450935, "o", "        if appends and not commits:\r\n\u001b[?2004l\r"]
[118.450947, "o", "\u001b[?2004h> "]
[118.450987, "o", "            winning_term = max(appends, key=lambda x: x[0])[0]\r\n\u001b[?2004l\r"]
[118.450998, "o", "\u001b[?2004h> "]
[118.451032, "o", "            ins_entries.append((idx, winning_term))\r\n\u001b[?2004l\r"]
[118.451043, "o", "\u001b[?2004h>     \r\n"]
[118.451052, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[118.451067, "o", "    # Build output\r\n\u001b[?2004l\r"]
[118.451076, "o", "\u001b[?2004h> "]
[118.451088, "o", "    output = []\r\n\u001b[?2004l\r"]
[118.451099, "o", "\u001b[?2004h> "]
[118.451141, "o", "    for idx, reason in sorted(bad_entries, key=lambda x: x[0]):\r\n\u001b[?2004l\r"]
[118.451152, "o", "\u001b[?2004h> "]
[118.451181, "o", "        output.append(f\"BAD {idx} {reason}\")\r\n\u001b[?2004l\r"]
[118.451192, "o", "\u001b[?2004h> "]
[118.451238, "o", "    for idx, term in sorted(ins_entries, key=lambda x: (x[0], x[1])):\r\n\u001b[?2004l\r"]
[118.451249, "o", "\u001b[?2004h> "]
[118.451282, "o", "        output.append(f\"INS {term} {idx} COMMIT\")\r\n\u001b[?2004l\r"]
[118.451293, "o", "\u001b[?2004h> "]
[118.451304, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.451318, "o", "    if not output:\r\n\u001b[?2004l\r"]
[118.451328, "o", "\u001b[?2004h> "]
[118.451341, "o", "        return \"OK\"\r\n\u001b[?2004l\r"]
[118.451351, "o", "\u001b[?2004h> "]
[118.45137, "o", "    return \"\\n\".join(output)\r\n\u001b[?2004l\r"]
[118.451381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.451392, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.451402, "o", "\u001b[?2004h> "]
[118.451416, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[118.451427, "o", "\u001b[?2004h> "]
[118.451437, "o", "    import sys\r\n\u001b[?2004l\r"]
[118.451447, "o", "\u001b[?2004h> "]
[118.451463, "o", "    if len(sys.argv) > 1:\r\n\u001b[?2004l\r"]
[118.451474, "o", "\u001b[?2004h> "]
[118.451498, "o", "        with open(sys.argv[1]) as f:\r\n\u001b[?2004l\r"]
[118.451511, "o", "\u001b[?2004h> "]
[118.451542, "o", "            lines = f.read().strip().split('\\n')\r\n\u001b[?2004l\r"]
[118.451553, "o", "\u001b[?2004h> "]
[118.451564, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.451572, "o", "> "]
[118.45161, "o", "        lines = [l.strip() for l in sys.stdin if l.strip()]\r\n\u001b[?2004l\r"]
[118.451622, "o", "\u001b[?2004h> "]
[118.451636, "o", "    print(solve(lines))\r\n\u001b[?2004l\r"]
[118.451648, "o", "\u001b[?2004h> "]
[118.451658, "o", "EOF\r\n\u001b[?2004l\r"]
