[238.88478, "i", "python3 << 'PYEOF'\nfrom solution import solve\n\n# Test duplicates\nprint(\"Duplicate test:\", repr(solve([\"1 1 n0 APPEND data1\", \"1 1 n0 APPEND data1\"])))\n\n# Test comments\nprint(\"Comment test:\", repr(solve([\"# comment\", \"1 1 n0 APPEND data1\"])))\n\n# Test multiple indices with no issues\nprint(\"Multiple indices OK:\", repr(solve([\"1 1 n0 APPEND data1\", \"1 1 n0 COMMIT\", \"1 2 n0 APPEND data2\", \"1 2 n0 COMMIT\"])))\n\n# Test leader order violation\nprint(\"Leader order:\", repr(solve([\"1 2 n0 LEADER\", \"1 1 n0 LEADER\"])))\n\n# Test malformed node\nprint(\"Malformed node:\", repr(solve([\"1 1 node0 APPEND data1\"])))\n\n# Test negative term\nprint(\"Negative term:\", repr(solve([\"-1 1 n0 APPEND data1\"])))\n\n# Test zero index\nprint(\"Zero index:\", repr(solve([\"1 0 n0 APPEND data1\"])))\n\n# Test unknown op\nprint(\"Unknown op:\", repr(solve([\"1 1 n0 READ data1\"])))\n\n# Test APPEND with 4 fields\nprint(\"APPEND 4 fields:\", repr(solve([\"1 1 n0 APPEND\"])))\n\n# Test VOTE with 5 fields\nprint(\"VOTE 5 fields:\", repr(solve([\"1 1 n0 VOTE extra\"])))\nPYEOF\n"]
