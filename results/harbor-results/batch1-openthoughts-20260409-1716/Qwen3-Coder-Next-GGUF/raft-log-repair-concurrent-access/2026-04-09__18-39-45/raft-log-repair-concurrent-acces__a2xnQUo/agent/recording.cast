[49.138033, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.138111, "o", "        # Rule 5: Conflict detection (same term, different data)\r\n\u001b[?2004l\r\u001b[?2004h>         term_data = {}\r\n\u001b[?2004l\r"]
[49.138118, "o", "\u001b[?2004h"]
[49.138121, "o", "> "]
[49.138171, "o", "        for term, data in appends:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.138212, "o", "            if term in term_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.138232, "o", "                if term_data[term] != data:\r\n\u001b[?2004l\r"]
[49.138246, "o", "\u001b[?2004h> "]
[49.138283, "o", "                    if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[49.138298, "o", "\u001b[?2004h> "]
[49.138336, "o", "                        bad_entries.append((idx, \"BAD_CONFLICT\"))\r\n\u001b[?2004l\r"]
[49.138344, "o", "\u001b[?2004h"]
[49.138355, "o", "> "]
[49.138366, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.138378, "o", "> "]
[49.13839, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.138398, "o", "> "]
[49.138421, "o", "                term_data[term] = data\r\n\u001b[?2004l\r"]
[49.138431, "o", "\u001b[?2004h"]
[49.13844, "o", ">         \r\n\u001b[?2004l\r"]
[49.138451, "o", "\u001b[?2004h> "]
[49.138467, "o", "        # Rule 4: COMMIT order\r\n\u001b[?2004l\r"]
[49.138476, "o", "\u001b[?2004h> "]
[49.138503, "o", "        has_append = len(appends) > 0\r\n\u001b[?2004l\r"]
[49.138513, "o", "\u001b[?2004h> "]
[49.13853, "o", "        if not has_append:\r\n\u001b[?2004l\r"]
[49.138541, "o", "\u001b[?2004h> "]
[49.138568, "o", "            for commit_term, _ in commits:\r\n\u001b[?2004l\r"]
[49.138579, "o", "\u001b[?2004h> "]
[49.138618, "o", "                if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[49.138628, "o", "\u001b[?2004h> "]
[49.138671, "o", "                    bad_entries.append((idx, \"BAD_COMMIT_ORDER\"))\r\n\u001b[?2004l\r"]
[49.138682, "o", "\u001b[?2004h> "]
[49.138695, "o", "                break\r\n\u001b[?2004l\r"]
[49.138705, "o", "\u001b[?2004h> "]
[49.138713, "o", "        else:\r\n\u001b[?2004l\r"]
[49.138723, "o", "\u001b[?2004h> "]
[49.138752, "o", "            # Winning term = highest term\r\n\u001b[?2004l\r"]
[49.138761, "o", "\u001b[?2004h> "]
[49.138819, "o", "            winning_term = max(appends, key=lambda x: x[0])[0] if appends else None\r\n\u001b[?2004l\r"]
[49.138829, "o", "\u001b[?2004h> "]
[49.138856, "o", "            if winning_term is not None:\r\n\u001b[?2004l\r"]
[49.138866, "o", "\u001b[?2004h> "]
[49.138913, "o", "                for commit_term, _ in commits:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.138952, "o", "                    if commit_term != winning_term:\r\n\u001b[?2004l\r"]
[49.138962, "o", "\u001b[?2004h> "]
[49.139007, "o", "                        if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[49.139018, "o", "\u001b[?2004h> "]
[49.139066, "o", "                            bad_entries.append((idx, \"BAD_COMMIT_ORDER\"))\r\n\u001b[?2004l\r"]
[49.139075, "o", "\u001b[?2004h> "]
[49.139096, "o", "                        break\r\n\u001b[?2004l\r"]
[49.139106, "o", "\u001b[?2004h> "]
[49.139117, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.139151, "o", "        # Rule 3: Duplicate vote detection\r\n\u001b[?2004l\r"]
[49.139158, "o", "\u001b[?2004h> "]
[49.139188, "o", "        for commit_term, node in votes_here:\r\n\u001b[?2004l\r"]
[49.139199, "o", "\u001b[?2004h> "]
[49.139226, "o", "            key = (node, commit_term)\r\n\u001b[?2004l\r"]
[49.139235, "o", "\u001b[?2004h> "]
[49.13927, "o", "            if key in votes:\r\n\u001b[?2004l\r"]
[49.13928, "o", "\u001b[?2004h> "]
[49.139326, "o", "                if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.139337, "o", "> "]
[49.139378, "o", "                    bad_entries.append((idx, \"BAD_DUPLICATE_VOTE\"))\r\n\u001b[?2004l\r"]
[49.139387, "o", "\u001b[?2004h"]
[49.139396, "o", "> "]
[49.139406, "o", "                break\r\n\u001b[?2004l\r"]
[49.139417, "o", "\u001b[?2004h> "]
[49.139426, "o", "            else:\r\n\u001b[?2004l\r"]
[49.139435, "o", "\u001b[?2004h> "]
[49.139457, "o", "                votes[key] = idx\r\n\u001b[?2004l\r"]
[49.139464, "o", "\u001b[?2004h> "]
[49.139476, "o", "        \r\n\u001b[?2004l\r"]
[49.139487, "o", "\u001b[?2004h> "]
[49.139507, "o", "        # Rule 3: Leader order\r\n\u001b[?2004l\r"]
[49.139517, "o", "\u001b[?2004h> "]
[49.139548, "o", "        for leader_term, node in leaders_here:\r\n\u001b[?2004l\r"]
[49.139556, "o", "\u001b[?2004h> "]
[49.139584, "o", "            if leader_term in leaders:\r\n\u001b[?2004l\r"]
[49.139594, "o", "\u001b[?2004h> "]
[49.139634, "o", "                if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[49.139644, "o", "\u001b[?2004h> "]
[49.13969, "o", "                    bad_entries.append((idx, \"BAD_LEADER_ORDER\"))\r\n\u001b[?2004l\r"]
[49.139699, "o", "\u001b[?2004h> "]
[49.139717, "o", "                break\r\n\u001b[?2004l\r"]
[49.139727, "o", "\u001b[?2004h> "]
[49.13974, "o", "            else:\r\n\u001b[?2004l\r"]
[49.13975, "o", "\u001b[?2004h> "]
[49.139777, "o", "                leaders[leader_term] = idx\r\n\u001b[?2004l\r"]
[49.139786, "o", "\u001b[?2004h> "]
[49.139797, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.139849, "o", "    # Rule 2: Log matching (need committed terms from previous indices)\r\n\u001b[?2004l\r"]
[49.13986, "o", "\u001b[?2004h> "]
[49.139875, "o", "    committed_term = 0\r\n\u001b[?2004l\r"]
[49.139891, "o", "\u001b[?2004h> "]
[49.139905, "o", "    for idx in indices:\r\n\u001b[?2004l\r"]
[49.139915, "o", "\u001b[?2004h> "]
[49.13994, "o", "        index_entries = by_index[idx]\r\n\u001b[?2004l\r"]
[49.13995, "o", "\u001b[?2004h> "]
[49.139994, "o", "        appends = [e for e in index_entries if e[3] == 'APPEND']\r\n\u001b[?2004l\r"]
[49.140004, "o", "\u001b[?2004h> "]
[49.140047, "o", "        commits = [e for e in index_entries if e[3] == 'COMMIT']\r\n\u001b[?2004l\r"]
[49.140058, "o", "\u001b[?2004h> "]
[49.140068, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[49.140078, "o", "> "]
[49.140093, "o", "        if appends and commits:\r\n\u001b[?2004l\r"]
[49.140103, "o", "\u001b[?2004h> "]
[49.140145, "o", "            winning_term = max(appends, key=lambda x: x[0])[0]\r\n\u001b[?2004l\r"]
[49.140153, "o", "\u001b[?2004h"]
[49.140163, "o", "> "]
[49.140186, "o", "            if committed_term > winning_term:\r\n\u001b[?2004l\r"]
[49.140195, "o", "\u001b[?2004h> "]
[49.140235, "o", "                if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[49.140245, "o", "\u001b[?2004h> "]
[49.140287, "o", "                    bad_entries.append((idx, \"BAD_LOG_MATCH\"))\r\n\u001b[?2004l\r"]
[49.140297, "o", "\u001b[?2004h> "]
[49.140326, "o", "            committed_term = winning_term\r\n\u001b[?2004l\r"]
[49.140336, "o", "\u001b[?2004h>     \r\n"]
[49.140346, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[49.140379, "o", "    # Collect repair entries (missing COMMITs)\r\n\u001b[?2004l\r"]
[49.140389, "o", "\u001b[?2004h> "]
[49.140403, "o", "    ins_entries = []\r\n\u001b[?2004l\r"]
[49.140413, "o", "\u001b[?2004h> "]
[49.140446, "o", "    bad_indices = set(b[0] for b in bad_entries)\r\n\u001b[?2004l\r"]
[49.140455, "o", "\u001b[?2004h> "]
[49.140465, "o", "    \r\n\u001b[?2004l\r"]
[49.140475, "o", "\u001b[?2004h> "]
[49.140498, "o", "    for idx in indices:\r\n\u001b[?2004l\r"]
[49.140509, "o", "\u001b[?2004h"]
[49.140519, "o", "> "]
[49.140528, "o", "        if idx in bad_indices:\r\n\u001b[?2004l\r"]
[49.140541, "o", "\u001b[?2004h> "]
[49.140552, "o", "            continue\r\n\u001b[?2004l\r"]
[49.140561, "o", "\u001b[?2004h> "]
[49.140587, "o", "        index_entries = by_index[idx]\r\n\u001b[?2004l\r"]
[49.140596, "o", "\u001b[?2004h> "]
[49.140642, "o", "        appends = [e for e in index_entries if e[3] == 'APPEND']\r\n\u001b[?2004l\r"]
[49.140652, "o", "\u001b[?2004h> "]
[49.140695, "o", "        commits = [e for e in index_entries if e[3] == 'COMMIT']\r\n\u001b[?2004l\r"]
[49.140705, "o", "\u001b[?2004h"]
[49.140717, "o", ">         \r\n\u001b[?2004l\r"]
[49.140729, "o", "\u001b[?2004h> "]
[49.140743, "o", "        if appends and not commits:\r\n\u001b[?2004l\r"]
[49.140756, "o", "\u001b[?2004h> "]
[49.140795, "o", "            winning_term = max(appends, key=lambda x: x[0])[0]\r\n\u001b[?2004l\r"]
[49.140806, "o", "\u001b[?2004h> "]
[49.140844, "o", "            ins_entries.append((idx, winning_term))\r\n\u001b[?2004l\r"]
[49.140857, "o", "\u001b[?2004h"]
[49.140868, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[49.140877, "o", "> "]
[49.140893, "o", "    # Build output\r\n\u001b[?2004l\r"]
[49.140906, "o", "\u001b[?2004h> "]
[49.140916, "o", "    output = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.140958, "o", "    for idx, reason in sorted(bad_entries, key=lambda x: x[0]):\r\n\u001b[?2004l\r"]
[49.140969, "o", "\u001b[?2004h> "]
[49.141, "o", "        output.append(f\"BAD {idx} {reason}\")\r\n\u001b[?2004l\r"]
[49.14101, "o", "\u001b[?2004h> "]
[49.141061, "o", "    for idx, term in sorted(ins_entries, key=lambda x: (x[0], x[1])):\r\n\u001b[?2004l\r"]
[49.141066, "o", "\u001b[?2004h"]
[49.141095, "o", "> "]
[49.141107, "o", "        output.append(f\"INS {term} {idx} COMMIT\")\r\n\u001b[?2004l\r"]
[49.141118, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[49.141128, "o", "\u001b[?2004h> "]
[49.141145, "o", "    if not output:\r\n\u001b[?2004l\r"]
[49.141154, "o", "\u001b[?2004h> "]
[49.141172, "o", "        return \"OK\"\r\n\u001b[?2004l\r"]
[49.141183, "o", "\u001b[?2004h> "]
[49.141201, "o", "    return \"\\n\".join(output)\r\n\u001b[?2004l\r"]
[49.141211, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.141222, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.141231, "o", "\u001b[?2004h> "]
[49.141251, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[49.141261, "o", "\u001b[?2004h> "]
[49.14127, "o", "    import sys\r\n\u001b[?2004l\r"]
[49.141279, "o", "\u001b[?2004h> "]
[49.141303, "o", "    if len(sys.argv) > 1:\r\n\u001b[?2004l\r"]
[49.141312, "o", "\u001b[?2004h> "]
[49.141352, "o", "        with open(sys.argv[1]) as f:\r\n\u001b[?2004l\r"]
[49.141362, "o", "\u001b[?2004h> "]
[49.141396, "o", "            lines = f.read().strip().split('\\n')\r\n\u001b[?2004l\r"]
[49.141408, "o", "\u001b[?2004h> "]
[49.141418, "o", "    else:\r\n\u001b[?2004l\r"]
[49.141427, "o", "\u001b[?2004h> "]
[49.141465, "o", "        lines = [l.strip() for l in sys.stdin if l.strip()]\r\n\u001b[?2004l\r"]
[49.141475, "o", "\u001b[?2004h> "]
[49.141491, "o", "    print(solve(lines))\r\n\u001b[?2004l\r"]
[49.141501, "o", "\u001b[?2004h> EOF\r\n"]
