[118.444176, "i", "cat > /app/solution.py << 'EOF'\ndef solve(lines: list[str]) -> str:\n    if not lines:\n        return \"OK\"\n    \n    import re\n    \n    # Parse lines\n    entries = []\n    node_pattern = re.compile(r'^n[0-9][0-9]*$')\n    \n    for line in lines:\n        stripped = line.strip()\n        \n        # Skip empty lines and comments\n        if not stripped or stripped.startswith('#'):\n            continue\n        \n        fields = stripped.split()\n        \n        # Validate field count\n        if len(fields) < 4 or len(fields) > 5:\n            break\n        \n        try:\n            term = int(fields[0])\n            if term < 0:\n                break\n        except ValueError:\n            break\n        \n        try:\n            index = int(fields[1])\n            if index < 1:\n                break\n        except ValueError:\n            break\n        \n        node = fields[2]\n        if not node_pattern.match(node):\n            break\n        \n        op = fields[3]\n        if op not in ('VOTE', 'APPEND', 'COMMIT', 'LEADE"]
[118.4443, "i", "R'):\n            break\n        \n        data = None\n        if op == 'APPEND':\n            if len(fields) != 5:\n                break\n            data = fields[4]\n        else:\n            if len(fields) != 4:\n                break\n        \n        entry = (term, index, node, op, data)\n        \n        # Skip exact duplicates\n        if entry in entries:\n            continue\n        \n        entries.append(entry)\n    \n    # Group by index, maintaining file order\n    by_index = {}\n    for entry in entries:\n        idx = entry[1]\n        if idx not in by_index:\n            by_index[idx] = []\n        by_index[idx].append(entry)\n    \n    if not by_index:\n        return \"OK\"\n    \n    indices = sorted(by_index.keys())\n    \n    bad_entries = []\n    \n    # Global tracking for protocol rules\n    votes = {}  # (node, term) -> first index where vote occurred\n    leaders = {}  # term -> first index where leader was established\n    \n    # Track committed terms per index\n    committed_terms = {}\n    \n    # First pass: coll"]
