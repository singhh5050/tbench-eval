[263.568058, "i", "python3 << 'PYEOF'\nfrom solution import solve\n\n# Comprehensive verification\ntests = [\n    # Original tests\n    ([], \"OK\"),\n    ([\"1 1 n0 APPEND data1\", \"X bad\", \"2 2 n1 APPEND data2\"], \"INS 1 1 COMMIT\"),\n    ([\"2 1 n0 APPEND data1\", \"1 1 n1 APPEND data2\"], \"BAD 1 BAD_TERM_REGRESSION\"),\n    ([\"1 1 n0 APPEND data1\"], \"INS 1 1 COMMIT\"),\n    ([\"1 1 n0 COMMIT\"], \"BAD 1 BAD_COMMIT_ORDER\"),\n    ([\"1 1 n0 APPEND data1\", \"2 1 n0 COMMIT\"], \"BAD 1 BAD_COMMIT_ORDER\"),\n    ([\"1 1 n0 VOTE\", \"1 2 n0 VOTE\"], \"BAD 2 BAD_DUPLICATE_VOTE\"),\n    ([\"1 1 n0 APPEND data1\", \"1 1 n1 APPEND data2\"], \"BAD 1 BAD_CONFLICT\"),\n    ([\"1 1 n0 APPEND data1\", \"2 1 n1 APPEND data2\"], \"INS 2 1 COMMIT\"),\n    ([\"2 1 n0 APPEND data1\", \"2 1 n0 COMMIT\", \"1 2 n1 APPEND data2\"], \"BAD 2 BAD_LOG_MATCH\"),\n    # Edge cases\n    ([\"1 1 n0 APPEND data1\", \"1 1 n0 APPEND data1\"], \"INS 1 1 COMMIT\"),  # duplicate skipped\n    ([\"# comment\", \"1 1 n0 APPEND data1\"], \"INS 1 1 COMMIT\"),  # comment ignored\n    ([\"1 1 n0 APPEND data1\", \"1 1 n0 COMMIT\", \"1 2 n0 APPEND dat"]
[263.568319, "i", "a2\", \"1 2 n0 COMMIT\"], \"OK\"),  # multiple OK\n    ([\"1 2 n0 LEADER\", \"1 1 n0 LEADER\"], \"BAD 2 BAD_LEADER_ORDER\"),  # leader order\n]\n\nall_pass = True\nfor i, (inp, expected) in enumerate(tests, 1):\n    result = solve(inp)\n    if result != expected:\n        print(f\"Test {i}: FAIL - got {repr(result)}, expected {repr(expected)}\")\n        all_pass = False\n\nif all_pass:\n    print(f\"All {len(tests)} tests passed!\")\nelse:\n    print(\"Some tests failed!\")\nPYEOF\n"]
