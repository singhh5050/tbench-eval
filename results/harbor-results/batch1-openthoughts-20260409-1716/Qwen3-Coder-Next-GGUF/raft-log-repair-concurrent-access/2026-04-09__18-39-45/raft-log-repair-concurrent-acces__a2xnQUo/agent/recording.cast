[187.624828, "o", "\u001b[?2004h> "]
[187.624878, "o", "        terms_in_order = [e[0] for e in index_entries]\r\n\u001b[?2004l\r"]
[187.624893, "o", "\u001b[?2004h> "]
[187.624902, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[187.624913, "o", "> "]
[187.624944, "o", "        # Rule 1: Term monotonicity\r\n\u001b[?2004l\r"]
[187.624957, "o", "\u001b[?2004h> "]
[187.625001, "o", "        for i in range(1, len(terms_in_order)):\r\n\u001b[?2004l\r"]
[187.625012, "o", "\u001b[?2004h> "]
[187.625065, "o", "            if terms_in_order[i] < terms_in_order[i-1]:\r\n\u001b[?2004l\r"]
[187.625078, "o", "\u001b[?2004h> "]
[187.62513, "o", "                if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[187.625155, "o", "\u001b[?2004h> "]
[187.625212, "o", "                    bad_entries.append((idx, \"BAD_TERM_REGRESSION\"))\r\n\u001b[?2004l\r"]
[187.625223, "o", "\u001b[?2004h> "]
[187.625244, "o", "                break\r\n"]
[187.625253, "o", "\u001b[?2004l\r"]
[187.625265, "o", "\u001b[?2004h> "]
[187.625275, "o", "        \r\n\u001b[?2004l\r"]
[187.62528, "o", "\u001b[?2004h> "]
[187.625307, "o", "        # Extract operations\r\n"]
[187.625316, "o", "\u001b[?2004l\r"]
[187.625326, "o", "\u001b[?2004h> "]
[187.625393, "o", "        appends = [(e[0], e[4]) for e in index_entries if e[3] == 'APPEND']\r\n\u001b[?2004l\r"]
[187.625404, "o", "\u001b[?2004h> "]
[187.625475, "o", "        votes_here = [(e[0], e[2]) for e in index_entries if e[3] == 'VOTE']\r\n\u001b[?2004l\r"]
[187.625483, "o", "\u001b[?2004h> "]
[187.62554, "o", "        commits = [(e[0], e[2]) for e in index_entries if e[3] == 'COMMIT']\r\n"]
[187.625552, "o", "\u001b[?2004l\r\u001b[?2004h"]
[187.625561, "o", "> "]
[187.625607, "o", "        leaders_here = [(e[0], e[2]) for e in index_entries if e[3] == 'LEADER']\r\n\u001b[?2004l\r"]
[187.625618, "o", "\u001b[?2004h> "]
[187.625627, "o", "        \r\n\u001b[?2004l\r"]
[187.625636, "o", "\u001b[?2004h> "]
[187.62568, "o", "        # Rule 5: Conflict detection (same term, different data)\r\n\u001b[?2004l\r"]
[187.625689, "o", "\u001b[?2004h> "]
[187.62571, "o", "        has_conflict = False\r\n\u001b[?2004l\r"]
[187.625718, "o", "\u001b[?2004h"]
[187.625727, "o", "> "]
[187.625737, "o", "        term_data = {}\r\n\u001b[?2004l\r"]
[187.625744, "o", "\u001b[?2004h"]
[187.625752, "o", "> "]
[187.625772, "o", "        for term, data in appends:\r\n\u001b[?2004l\r"]
[187.625793, "o", "\u001b[?2004h> "]
[187.625805, "o", "            if term in term_data:\r\n\u001b[?2004l\r"]
[187.625814, "o", "\u001b[?2004h> "]
[187.625846, "o", "                if term_data[term] != data:\r\n\u001b[?2004l\r"]
[187.625854, "o", "\u001b[?2004h> "]
[187.625894, "o", "                    has_conflict = True\r\n\u001b[?2004l\r"]
[187.625905, "o", "\u001b[?2004h> "]
[187.62592, "o", "                    break\r\n\u001b[?2004l\r"]
[187.625934, "o", "\u001b[?2004h> "]
[187.625944, "o", "            else:\r\n\u001b[?2004l\r"]
[187.625954, "o", "\u001b[?2004h> "]
[187.625979, "o", "                term_data[term] = data\r\n\u001b[?2004l\r"]
[187.625988, "o", "\u001b[?2004h> "]
[187.625997, "o", "        \r\n\u001b[?2004l\r"]
[187.626006, "o", "\u001b[?2004h> "]
[187.626023, "o", "        if has_conflict:\r\n\u001b[?2004l\r"]
[187.62603, "o", "\u001b[?2004h"]
[187.626039, "o", "> "]
[187.626072, "o", "            if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[187.626081, "o", "\u001b[?2004h> "]
[187.626123, "o", "                bad_entries.append((idx, \"BAD_CONFLICT\"))\r\n\u001b[?2004l\r"]
[187.626132, "o", "\u001b[?2004h> "]
[187.626141, "o", "        \r\n\u001b[?2004l\r"]
[187.62615, "o", "\u001b[?2004h> "]
[187.62617, "o", "        # Rule 4: COMMIT order\r\n\u001b[?2004l\r"]
[187.626179, "o", "\u001b[?2004h> "]
[187.626207, "o", "        has_append = len(appends) > 0\r\n\u001b[?2004l\r"]
[187.626216, "o", "\u001b[?2004h> "]
[187.62624, "o", "        commit_violation = False\r\n\u001b[?2004l\r"]
[187.62625, "o", "\u001b[?2004h> "]
[187.626259, "o", "        \r\n\u001b[?2004l\r"]
[187.626268, "o", "\u001b[?2004h> "]
[187.626284, "o", "        if not has_append:\r\n\u001b[?2004l\r"]
[187.626292, "o", "\u001b[?2004h"]
[187.626301, "o", "> "]
[187.626311, "o", "            if commits:\r\n\u001b[?2004l\r"]
[187.626319, "o", "\u001b[?2004h"]
[187.626327, "o", "> "]
[187.626351, "o", "                commit_violation = True\r\n\u001b[?2004l\r"]
[187.62636, "o", "\u001b[?2004h> "]
[187.626369, "o", "        else:\r\n\u001b[?2004l\r"]
[187.626384, "o", "\u001b[?2004h> "]
[187.626409, "o", "            # Winning term = highest term\r\n"]
[187.626418, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[187.626479, "o", "            winning_term = max(appends, key=lambda x: x[0])[0] if appends else None\r\n\u001b[?2004l\r"]
[187.626489, "o", "\u001b[?2004h> "]
[187.626518, "o", "            if winning_term is not None:\r\n\u001b[?2004l\r"]
[187.626528, "o", "\u001b[?2004h> "]
[187.626561, "o", "                for commit_term, _ in commits:\r\n\u001b[?2004l\r"]
[187.626571, "o", "\u001b[?2004h> "]
[187.626609, "o", "                    if commit_term != winning_term:\r\n\u001b[?2004l\r"]
[187.626619, "o", "\u001b[?2004h> "]
[187.626652, "o", "                        commit_violation = True\r\n\u001b[?2004l\r"]
[187.626662, "o", "\u001b[?2004h> "]
[187.626683, "o", "                        break\r\n\u001b[?2004l\r"]
[187.626693, "o", "\u001b[?2004h> "]
[187.626701, "o", "        \r\n\u001b[?2004l\r"]
[187.62671, "o", "\u001b[?2004h> "]
[187.62673, "o", "        if commit_violation:\r\n\u001b[?2004l\r"]
[187.626738, "o", "\u001b[?2004h"]
[187.626747, "o", "> "]
[187.626779, "o", "            if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[187.626787, "o", "\u001b[?2004h> "]
[187.626834, "o", "                bad_entries.append((idx, \"BAD_COMMIT_ORDER\"))\r\n\u001b[?2004l\r"]
[187.626842, "o", "\u001b[?2004h> "]
[187.626849, "o", "        \r\n\u001b[?2004l\r"]
[187.626858, "o", "\u001b[?2004h> "]
[187.626894, "o", "        # Rule 3: Duplicate vote detection\r\n\u001b[?2004l\r"]
[187.626908, "o", "\u001b[?2004h> "]
[187.626943, "o", "        for commit_term, node in votes_here:\r\n\u001b[?2004l\r"]
[187.626949, "o", "\u001b[?2004h> "]
[187.626974, "o", "            key = (node, commit_term)\r\n\u001b[?2004l\r"]
[187.626983, "o", "\u001b[?2004h> "]
[187.627005, "o", "            if key in votes:\r\n\u001b[?2004l\r"]
[187.627015, "o", "\u001b[?2004h> "]
[187.627057, "o", "                if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[187.627066, "o", "\u001b[?2004h> "]
[187.627115, "o", "                    bad_entries.append((idx, \"BAD_DUPLICATE_VOTE\"))\r\n\u001b[?2004l\r"]
[187.627123, "o", "\u001b[?2004h"]
[187.627132, "o", "> "]
[187.62714, "o", "                break\r\n"]
[187.62715, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[187.627164, "o", "            else:\r\n\u001b[?2004l\r"]
[187.627171, "o", "\u001b[?2004h"]
[187.627179, "o", "> "]
[187.627197, "o", "                votes[key] = idx\r\n\u001b[?2004l\r"]
[187.627206, "o", "\u001b[?2004h> "]
[187.627213, "o", "        \r\n\u001b[?2004l\r"]
[187.627222, "o", "\u001b[?2004h> "]
[187.627245, "o", "        # Rule 3: Leader order\r\n\u001b[?2004l\r"]
[187.627255, "o", "\u001b[?2004h> "]
[187.627288, "o", "        for leader_term, node in leaders_here:\r\n\u001b[?2004l\r"]
[187.627298, "o", "\u001b[?2004h> "]
[187.627325, "o", "            if leader_term in leaders:\r\n\u001b[?2004l\r"]
[187.627335, "o", "\u001b[?2004h> "]
[187.627377, "o", "                if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[187.627385, "o", "\u001b[?2004h"]
[187.627394, "o", "> "]
[187.627434, "o", "                    bad_entries.append((idx, \"BAD_LEADER_ORDER\"))\r\n\u001b[?2004l\r"]
[187.627442, "o", "\u001b[?2004h"]
[187.627451, "o", "> "]
[187.627461, "o", "                break\r\n\u001b[?2004l\r"]
[187.627469, "o", "\u001b[?2004h> "]
[187.627481, "o", "            else:\r\n\u001b[?2004l\r"]
[187.627489, "o", "\u001b[?2004h"]
[187.627497, "o", "> "]
[187.627522, "o", "                leaders[leader_term] = idx\r\n\u001b[?2004l\r"]
[187.627534, "o", "\u001b[?2004h"]
[187.627545, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h"]
[187.627555, "o", "> "]
[187.627589, "o", "        # Record winning APPEND term for log matching\r\n\u001b[?2004l\r"]
[187.627597, "o", "\u001b[?2004h> "]
[187.627611, "o", "        if appends:\r\n\u001b[?2004l\r"]
[187.62762, "o", "\u001b[?2004h> "]
[187.62767, "o", "            winning_terms[idx] = max(appends, key=lambda x: x[0])[0]\r\n\u001b[?2004l\r"]
[187.627678, "o", "\u001b[?2004h> "]
[187.627686, "o", "    \r\n\u001b[?2004l\r"]
[187.627695, "o", "\u001b[?2004h> "]
[187.627748, "o", "    # Rule 2: Log matching (need winning APPEND terms from previous indices)\r\n\u001b[?2004l\r"]
[187.627757, "o", "\u001b[?2004h> "]
[187.627775, "o", "    prev_committed = 0\r\n\u001b[?2004l\r"]
[187.627784, "o", "\u001b[?2004h> "]
[187.627801, "o", "    for idx in indices:\r\n\u001b[?2004l\r"]
[187.627811, "o", "\u001b[?2004h> "]
[187.627835, "o", "        if idx in winning_terms:\r\n\u001b[?2004l\r"]
[187.627844, "o", "\u001b[?2004h> "]
[187.627888, "o", "            if prev_committed > winning_terms[idx]:\r\n\u001b[?2004l\r"]
[187.627898, "o", "\u001b[?2004h"]
[187.627908, "o", "> "]
[187.627941, "o", "                if idx not in [b[0] for b in bad_entries]:\r\n\u001b[?2004l\r"]
[187.627949, "o", "\u001b[?2004h> "]
[187.627995, "o", "                    bad_entries.append((idx, \"BAD_LOG_MATCH\"))\r\n\u001b[?2004l\r"]
[187.628004, "o", "\u001b[?2004h> "]
[187.62804, "o", "            prev_committed = winning_terms[idx]\r\n\u001b[?2004l\r"]
[187.62805, "o", "\u001b[?2004h> "]
[187.628059, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[187.628069, "o", "> "]
[187.628098, "o", "    # Collect repair entries (missing COMMITs)\r\n\u001b[?2004l\r"]
[187.628107, "o", "\u001b[?2004h> "]
[187.628123, "o", "    ins_entries = []\r\n\u001b[?2004l\r"]
[187.628136, "o", "\u001b[?2004h> "]
[187.628167, "o", "    bad_indices = set(b[0] for b in bad_entries)\r\n\u001b[?2004l\r"]
[187.628176, "o", "\u001b[?2004h> "]
[187.628185, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[187.628193, "o", "> "]
[187.628207, "o", "    for idx in indices:\r\n\u001b[?2004l\r"]
[187.628216, "o", "\u001b[?2004h"]
[187.628225, "o", "> "]
[187.62824, "o", "        if idx in bad_indices:\r\n\u001b[?2004l\r"]
[187.628248, "o", "\u001b[?2004h> "]
[187.628265, "o", "            continue\r\n\u001b[?2004l\r"]
[187.628274, "o", "\u001b[?2004h> "]
[187.628302, "o", "        index_entries = by_index[idx]\r\n\u001b[?2004l\r"]
[187.628311, "o", "\u001b[?2004h> "]
[187.628358, "o", "        appends = [e for e in index_entries if e[3] == 'APPEND']\r\n\u001b[?2004l\r"]
[187.628368, "o", "\u001b[?2004h> "]
[187.628415, "o", "        commits = [e for e in index_entries if e[3] == 'COMMIT']\r\n\u001b[?2004l\r"]
[187.628425, "o", "\u001b[?2004h> "]
[187.628435, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[187.628444, "o", "> "]
[187.628466, "o", "        if appends and not commits:\r\n\u001b[?2004l\r"]
[187.628474, "o", "\u001b[?2004h> "]
[187.628521, "o", "            winning_term = max(appends, key=lambda x: x[0])[0]\r\n\u001b[?2004l\r"]
[187.62853, "o", "\u001b[?2004h"]
[187.628542, "o", "> "]
[187.628568, "o", "            ins_entries.append((idx, winning_term))\r\n\u001b[?2004l\r"]
[187.628577, "o", "\u001b[?2004h> "]
[187.628586, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[187.628597, "o", "> "]
[187.628605, "o", "    # Build output\r\n\u001b[?2004l\r"]
[187.628613, "o", "\u001b[?2004h> "]
[187.628626, "o", "    output = []\r\n\u001b[?2004l\r"]
[187.628634, "o", "\u001b[?2004h> "]
[187.628681, "o", "    for idx, reason in sorted(bad_entries, key=lambda x: x[0]):\r\n\u001b[?2004l\r"]
[187.628691, "o", "\u001b[?2004h> "]
[187.628724, "o", "        output.append(f\"BAD {idx} {reason}\")\r\n\u001b[?2004l\r"]
[187.628734, "o", "\u001b[?2004h> "]
[187.628784, "o", "    for idx, term in sorted(ins_entries, key=lambda x: (x[0], x[1])):\r\n\u001b[?2004l\r"]
[187.628793, "o", "\u001b[?2004h> "]
[187.628832, "o", "        output.append(f\"INS {term} {idx} COMMIT\")\r\n\u001b[?2004l\r"]
[187.628841, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[187.628849, "o", "\u001b[?2004h> "]
[187.628865, "o", "    if not output:\r\n\u001b[?2004l\r"]
[187.628874, "o", "\u001b[?2004h"]
[187.628887, "o", "> "]
[187.628898, "o", "        return \"OK\"\r\n\u001b[?2004l\r"]
[187.628907, "o", "\u001b[?2004h> "]
[187.628924, "o", "    return \"\\n\".join(output)\r\n\u001b[?2004l\r"]
[187.628932, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[187.628941, "o", "\u001b[?2004h> "]
[187.62895, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.628973, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[187.628981, "o", "\u001b[?2004h> "]
