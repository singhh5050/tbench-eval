[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import re
[?2004l[?2004h> from datetime import datetime
[?2004l[?2004h> 
[?2004l[?2004h> # Read the data
[?2004l[?2004h> df = pd.read_csv('/app/data.csv', dtype=str)
[?2004l[?2004h> 
[?2004l[?2004h> # Parse address to extract postal_code and city
[?2004l[?2004h> def parse_address(addr):
[?2004l[?2004h>     lines = addr.strip().split('\n')
[?2004l[?2004h>     if len(lines) >= 2:
[?2004l[?2004h>         # Postal code is the last 5 digits at end of second line
[?2004l[?2004h>         second_line = lines[1].strip()
[?2004l[?2004h>         postal_match = re.search(r'(\d{5})\s*$', second_line)
[?2004l[?2004h>         postal_code = postal_match.group(1) if postal_match else ''
[?2004l[?2004h>         
[?2004l[?2004h>         # City is before the comma and state code
[?2004l[?2004h>         city_match = re.match(r'([^,]+),', second_line)
[?2004l[?2004h>         city = city_match.group(1).strip() if city_match else ''
[?2004l[?2004h>         
[?2004l[?2004h>         return postal_code, city
[?2004l[?2004h>     return '', ''
[?2004l[?2004h> 
[?2004l[?2004h> # Apply address parsing
[?2004l[?2004h> df['postal_code'], df['city'] = zip(*df['address'].apply(parse_address))
[?2004l[?2004h> 
[?2004l[?2004h> # Create team_name: FL-Country-I
[?2004l[?2004h> # FL = capitalized first and last name initials
[?2004l[?2004h> # I = first letter of each institute word
[?2004l[?2004h> def create_team_name(first_name, last_name, country, institute):
[?2004l[?2004h>     fl = first_name[0].upper() + last_name[0].upper()
[?2004l[?2004h>     country_part = country.upper()
[?2004l[?2004h>     institute_part = ''.join(word[0].upper() for word in institute.split() if word)
[?2004l[?2004h>     return f"{fl}-{country_part}-{institute_part}"
[?2004l[?2004h> 
[?2004l[?2004h> df['team_name'] = df.apply(lambda row: create_team_name(row['first_name'], row['last_name'], row['country'], row['institute']), axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> # Format birth_date as YYYY-MM-DD
[?2004l[?2004h> def format_date(date_str):
[?2004l[?2004h>     dt = datetime.strptime(date_str, '%d %b %Y')
[?2004l[?2004h>     return dt.strftime('%Y-%m-%d')
[?2004l[?2004h> 
[?2004l[?2004h> df['birth_date'] = df['birth_date'].apply(format_date)
[?2004l[?2004h> 
[?2004l[?2004h> # Select and order final columns
[?2004l[?2004h> final_columns = ['participant_id', 'first_name', 'last_name', 'birth_date', 'address', 'phone_number', 'country', 'institute', 'occupation', 'register_time', 'postal_code', 'city', 'team_name']
[?2004l[?2004h> df[final_columns].to_csv('/app/result.csv', index=False)
