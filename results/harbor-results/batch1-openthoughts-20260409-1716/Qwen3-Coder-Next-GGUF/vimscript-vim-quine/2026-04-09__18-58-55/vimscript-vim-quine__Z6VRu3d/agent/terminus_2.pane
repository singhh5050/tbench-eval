[?2004l" LayoutQuine Plugin
" A Vimscript plugin that can replicate a Vim layout

if exists('g:layout_quine_loaded')
    finish
endif
let g:layout_quine_loaded = 1

time function! s:CaptureLayout()
    let layout = {
        \ 'active_tab': tabpagenr(),
        \ 'tabs': []
        \ }
    
    let tab_count = tabpagenr('$')
    
    for tab_num in range(1, tab_count)
        let tab_info = {
            \ 'windows': [],
            \ 'window_count': 0
            \ }
        
        execute 'tabnext' tab_num
        
        let win_count = winnr('$')
        let tab_info.window_count = win_count
        
        for win_num in range(1, win_count)
            let win_info = {
                \ 'bufnr': winbufnr(win_num),
                \ 'bufname': bufname(winbufnr(win_num)),
                \ 'width': winwidth(win_num),
                \ 'height': winheight(win_num)
                \ }
            
            if win_num > 1
                let prev_win = win_num - 1
                let prev_right = win_screenpos(prev_win)[0] + winwidth(prev_win)
                let curr_left = win_screenpos(win_num)[0]
                
                if prev_right == curr_left
                    let win_info.split_type = 'vsplit'
                else
                    let win_info.split_type = 'split'
                endif
            else
                let win_info.split_type = 'first'
            endif
            
            call add(tab_info.windows, win_info)
        endfor
        
        call add(layout.tabs, tab_info)
    endfor
    
    execute 'tabnext' layout.active_tab
    
    return layout
endfunction

time function! s:GenerateLayoutScript(layout, indent)
    let script = ''
    let ind = repeat('    ', a:indent)
    let ind1 = repeat('    ', a:indent + 1)
    
    script .= ind . '" Recreate tabs and windows\n'
    script .= ind . '" Active tab was: ' . a:layout.active_tab . '\n'
    script .= ind . '\n'
    
    let tab_count = len(a:layout.tabs)
    
    for tab_idx in range(0, tab_count - 1)
        let tab = a:layout.tabs[tab_idx]
        
        if tab_idx > 0
            script .= ind . '" Tab ' . (tab_idx + 1) . '\n'
            script .= ind . 'tabnew\n'
            script .= ind . '\n'
        endif
        
        let win_count = len(tab.windows)
        let first_window = 1
        
        for win_idx in range(0, win_count - 1)
            let win = tab.windows[win_idx]
            
            if first_window
                let first_window = 0
                
                if win.bufname != ''
                    script .= ind . '" Window ' . (win_idx + 1) . ' - buffer: ' . win.bufname . '\n'
                    script .= ind . 'edit ' . fnameescape(win.bufname) . '\n'
                endif
            else
                script .= ind . '" Window ' . (win_idx + 1) . ' - buffer: ' . win.bufname . '\n'
                
                if win.split_type == 'vsplit'
                    script .= ind . 'vsplit\n'
                elseif win.split_type == 'split'
                    script .= ind . 'split\n'
                endif
                
                if win.bufname != ''
                    script .= ind . 'edit ' . fnameescape(win.bufname) . '\n'
                endif
            endif
            
            script .= ind . '\n'
        endfor
    endfor
    
    script .= ind . '" Restore active tab\n'
    script .= ind . 'if ' . tab_count . ' > 1\n'
    script .= ind1 . 'tabnext ' . a:layout.active_tab . '\n'
    script .= ind . 'endif\n'
    
    return script
endfunction

time function! s:LayoutQuineImpl(path)
    let layout = s:CaptureLayout()
    let script = s:GenerateLayoutScript(layout, 0)
    
    call writefile(split(script, '\n'), a:path)
    
    echo 'Layout saved to: ' . a:path
endfunction

time command! -nargs=1 LayoutQuine call s:LayoutQuineImpl(<f-args>)
