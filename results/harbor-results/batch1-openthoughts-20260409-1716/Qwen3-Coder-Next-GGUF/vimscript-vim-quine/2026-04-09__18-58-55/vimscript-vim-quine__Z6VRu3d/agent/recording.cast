[388.52603, "o", "\" Recreate tabs and windows\r\n\" Active tab was: 2\r\n\r\n\" Window 1 - buffer: /tmp/file3.txt\r\nedit /tmp/file3.txt\r\n\r\n\" Window 2 - buffer: /tmp/file2.txt\r\nsplit\r\nedit /tmp/file2.txt\r\n"]
[388.526063, "o", "\r\n\" Window 3 - buffer: /tmp/file1.txt\r\nsplit\r\nedit /tmp/file1.txt\r\n\r\n\" Tab 2\r\ntabnew\r\n\r\n\" Window 1 - buffer: /tmp/file2.txt\r\nedit /tmp/file2.txt\r\n\r\n\" Window 2 - buffer: /tmp/file1.txt\r\nsplit\r\nedit /tmp/file1.txt\r\n\r\n\" Restore active tab\r\nif 2 > 1"]
[388.526083, "o", "\r\n    tabnext 2\r\nendif\r\n"]
