[170.287852, "i", "cat > /app/plugin/layout_quine.vim << 'ENDOFFILE'\n\" LayoutQuine Plugin\n\" A Vimscript plugin that can replicate a Vim layout\n\nif exists('g:layout_quine_loaded')\n    finish\nendif\nlet g:layout_quine_loaded = 1\n\nfunction! s:CaptureLayout()\n    let layout = {\n        \\ 'active_tab': tabpagenr(),\n        \\ 'tabs': []\n        \\ }\n\n    let tab_count = tabpagenr('$')\n\n    for tab_num in range(1, tab_count)\n        let tab_info = {\n            \\ 'windows': [],\n            \\ 'window_count': 0\n            \\ }\n\n        execute 'tabnext' tab_num\n\n        let win_count = winnr('$')\n        let tab_info.window_count = win_count\n\n        for win_num in range(1, win_count)\n            let win_info = {\n                \\ 'bufnr': winbufnr(win_num),\n                \\ 'bufname': bufname(winbufnr(win_num)),\n                \\ 'width': winwidth(win_num),\n                \\ 'height': winheight(win_num)\n                \\ }\n\n            if win_num > 1\n                let prev_win = win_num - 1\n                let prev_right = win_screenp"]
[170.287902, "i", "os(prev_win)[0] + winwidth(prev_win)\n                let curr_left = win_screenpos(win_num)[0]\n\n                if prev_right == curr_left\n                    let win_info.split_type = 'vsplit'\n                else\n                    let win_info.split_type = 'split'\n                endif\n            else\n                let win_info.split_type = 'first'\n            endif\n\n            call add(tab_info.windows, win_info)\n        endfor\n\n        call add(layout.tabs, tab_info)\n    endfor\n\n    execute 'tabnext' layout.active_tab\n\n    return layout\nendfunction\n\nfunction! s:GenerateLayoutScript(layout, indent)\n    let script = ''\n    let ind = repeat('    ', a:indent)\n    let ind1 = repeat('    ', a:indent + 1)\n\n    let script = script . ind . '\" Recreate tabs and windows\\n'\n    let script = script . ind . '\" Active tab was: ' . a:layout.active_tab . '\\n'\n    let script = script . ind . '\\n'\n\n    let tab_count = len(a:layout.tabs)\n\n    for tab_idx in range(0, tab_count - 1)\n        let tab = a:layout.tabs[tab_id"]
[170.287911, "i", "x]\n\n        if tab_idx > 0\n            let script = script . ind . '\" Tab ' . (tab_idx + 1) . '\\n'\n            let script = script . ind . 'tabnew\\n'\n            let script = script . ind . '\\n'\n        endif\n\n        let win_count = len(tab.windows)\n        let first_window = 1\n\n        for win_idx in range(0, win_count - 1)\n            let win = tab.windows[win_idx]\n\n            if first_window\n                let first_window = 0\n\n                if win.bufname != ''\n                    let script = script . ind . '\" Window ' . (win_idx + 1) . ' - buffer: ' . win.bufname . '\\n'\n                    let script = script . ind . 'edit ' . fnameescape(win.bufname) . '\\n'\n                endif\n            else\n                let script = script . ind . '\" Window ' . (win_idx + 1) . ' - buffer: ' . win.bufname . '\\n'\n\n                if win.split_type == 'vsplit'\n                    let script = script . ind . 'vsplit\\n'\n                elseif win.split_type == 'split'\n                    let script = script . i"]
[170.287918, "i", "nd . 'split\\n'\n                endif\n\n                if win.bufname != ''\n                    let script = script . ind . 'edit ' . fnameescape(win.bufname) . '\\n'\n                endif\n            endif\n\n            let script = script . ind . '\\n'\n        endfor\n    endfor\n\n    let script = script . ind . '\" Restore active tab\\n'\n    let script = script . ind . 'if ' . tab_count . ' > 1\\n'\n    let script = script . ind1 . 'tabnext ' . a:layout.active_tab . '\\n'\n    let script = script . ind . 'endif\\n'\n\n    return script\nendfunction\n\nfunction! s:LayoutQuineImpl(path)\n    let layout = s:CaptureLayout()\n    let script = s:GenerateLayoutScript(layout, 0)\n\n    call writefile(split(script, '\\n'), a:path)\n\n    echo 'Layout saved to: ' . a:path\nendfunction\n\ncommand! -nargs=1 LayoutQuine call s:LayoutQuineImpl(<f-args>)\nENDOFFILE\n"]
[170.288057, "o", "cat > /app/plugin/layout_quine.vim << 'ENDOFFILE'\r\n\u001b[?2004l\r"]
[170.288101, "o", "\u001b[?2004h> \" LayoutQuine Plugin\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.288133, "o", "\" A Vimscript plugin that can replicate a Vim layout\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.288154, "o", "\u001b[?2004h> "]
[170.28817, "o", "if exists('g:layout_quine_loaded')\r\n\u001b[?2004l\r"]
[170.288182, "o", "\u001b[?2004h> "]
[170.288194, "o", "    finish\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.288205, "o", "> endif\r\n\u001b[?2004l\r"]
[170.288215, "o", "\u001b[?2004h> "]
[170.288238, "o", "let g:layout_quine_loaded = 1\r\n\u001b[?2004l\r"]
[170.288251, "o", "\u001b[?2004h> \r\n"]
[170.288261, "o", "\u001b[?2004l\r"]
[170.288273, "o", "\u001b[?2004h> "]
[170.288287, "o", "function! s:CaptureLayout()\r\n"]
[170.288298, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.288314, "o", "    let layout = {\r\n"]
[170.288325, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.288356, "o", "        \\ 'active_tab': tabpagenr(),\r\n\u001b[?2004l\r"]
[170.288367, "o", "\u001b[?2004h> "]
[170.288381, "o", "        \\ 'tabs': []\r\n\u001b[?2004l\r"]
[170.288392, "o", "\u001b[?2004h> "]
[170.288402, "o", "        \\ }\r\n\u001b[?2004l\r"]
[170.288415, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.288426, "o", "\u001b[?2004h> "]
[170.288447, "o", "    let tab_count = tabpagenr('$')\r\n\u001b[?2004l\r"]
[170.288458, "o", "\u001b[?2004h> \r\n"]
[170.288469, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.288498, "o", "    for tab_num in range(1, tab_count)\r\n"]
[170.288508, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.288527, "o", "        let tab_info = {\r\n\u001b[?2004l\r"]
[170.288532, "o", "\u001b[?2004h"]
[170.288561, "o", "> "]
[170.28858, "o", "            \\ 'windows': [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.288596, "o", "            \\ 'window_count': 0\r\n\u001b[?2004l\r"]
[170.28861, "o", "\u001b[?2004h> "]
[170.288624, "o", "            \\ }\r\n\u001b[?2004l\r"]
[170.288632, "o", "\u001b[?2004h> "]
[170.288636, "o", "\r\n\u001b[?2004l\r"]
[170.288645, "o", "\u001b[?2004h> "]
[170.288843, "o", "        execute 'tabnext' tab_num\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         let win_count = winnr('$')\r\n\u001b[?2004l\r\u001b[?2004h>         let tab_info.window_count = win_count\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.28889, "o", "        for win_num in range(1, win_count)\r\n\u001b[?2004l\r\u001b[?2004h>             let win_info = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.288929, "o", "                \\ 'bufnr': winbufnr(win_num),\r\n\u001b[?2004l\r"]
[170.288942, "o", "\u001b[?2004h> "]
[170.288981, "o", "                \\ 'bufname': bufname(winbufnr(win_num)),\r\n\u001b[?2004l\r"]
[170.288996, "o", "\u001b[?2004h> "]
[170.289025, "o", "                \\ 'width': winwidth(win_num),\r\n\u001b[?2004l\r"]
[170.289038, "o", "\u001b[?2004h> "]
[170.28907, "o", "                \\ 'height': winheight(win_num)\r\n\u001b[?2004l\r"]
[170.289083, "o", "\u001b[?2004h> "]
[170.289132, "o", "                \\ }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.289154, "o", "            if win_num > 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.28917, "o", "> "]
[170.289189, "o", "                let prev_win = win_num - 1\r\n\u001b[?2004l\r"]
[170.289203, "o", "\u001b[?2004h> "]
[170.289258, "o", "                let prev_right = win_screenpos(prev_win)[0] + winwidth(prev_win)\r\n\u001b[?2004l\r"]
[170.289272, "o", "\u001b[?2004h> "]
[170.289312, "o", "                let curr_left = win_screenpos(win_num)[0]\r\n\u001b[?2004l\r"]
[170.289327, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.28934, "o", "\u001b[?2004h> "]
[170.289374, "o", "                if prev_right == curr_left\r\n\u001b[?2004l\r"]
[170.289387, "o", "\u001b[?2004h> "]
[170.289426, "o", "                    let win_info.split_type = 'vsplit'\r\n\u001b[?2004l\r"]
[170.289439, "o", "\u001b[?2004h> "]
[170.289457, "o", "                else\r\n\u001b[?2004l\r"]
[170.28947, "o", "\u001b[?2004h> "]
[170.289508, "o", "                    let win_info.split_type = 'split'\r\n\u001b[?2004l\r"]
[170.289522, "o", "\u001b[?2004h> "]
[170.289539, "o", "                endif\r\n\u001b[?2004l\r"]
[170.289551, "o", "\u001b[?2004h> "]
[170.289565, "o", "            else\r\n\u001b[?2004l\r"]
[170.289577, "o", "\u001b[?2004h> "]
[170.28962, "o", "                let win_info.split_type = 'first'\r\n\u001b[?2004l\r"]
[170.289633, "o", "\u001b[?2004h> "]
[170.289647, "o", "            endif\r\n\u001b[?2004l\r"]
[170.28966, "o", "\u001b[?2004h> \r\n"]
[170.289673, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.289708, "o", "            call add(tab_info.windows, win_info)\r\n\u001b[?2004l\r"]
[170.289721, "o", "\u001b[?2004h> "]
[170.289734, "o", "        endfor\r\n\u001b[?2004l\r"]
[170.289746, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.289757, "o", "\u001b[?2004h> "]
[170.289787, "o", "        call add(layout.tabs, tab_info)\r\n\u001b[?2004l\r"]
[170.2898, "o", "\u001b[?2004h> "]
[170.289813, "o", "    endfor\r\n\u001b[?2004l\r"]
[170.289828, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.289862, "o", "    execute 'tabnext' layout.active_tab\r\n\u001b[?2004l\r"]
[170.289875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.289885, "o", "\u001b[?2004h> "]
[170.289901, "o", "    return layout\r\n\u001b[?2004l\r"]
[170.289912, "o", "\u001b[?2004h> "]
[170.289923, "o", "endfunction\r\n\u001b[?2004l\r"]
[170.289934, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.289947, "o", "\u001b[?2004h> "]
[170.289983, "o", "function! s:GenerateLayoutScript(layout, indent)\r\n\u001b[?2004l\r"]
[170.289996, "o", "\u001b[?2004h> "]
[170.290012, "o", "    let script = ''\r\n\u001b[?2004l\r"]
[170.290051, "o", "\u001b[?2004h> "]
[170.290068, "o", "    let ind = repeat('    ', a:indent)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.290098, "o", "    let ind1 = repeat('    ', a:indent + 1)\r\n\u001b[?2004l\r"]
[170.290111, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.290126, "o", "\u001b[?2004h> "]
[170.290168, "o", "    let script = script . ind . '\" Recreate tabs and windows\\n'\r\n\u001b[?2004l\r"]
[170.290183, "o", "\u001b[?2004h> "]
[170.290236, "o", "    let script = script . ind . '\" Active tab was: ' . a:layout.active_tab . '\\n'\r\n\u001b[?2004l\r"]
[170.290251, "o", "\u001b[?2004h> "]
[170.290273, "o", "    let script = script . ind . '\\n'\r\n\u001b[?2004l\r"]
[170.290287, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.290298, "o", "\u001b[?2004h> "]
[170.290326, "o", "    let tab_count = len(a:layout.tabs)\r\n\u001b[?2004l\r"]
[170.29034, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[170.290354, "o", "> "]
[170.290389, "o", "    for tab_idx in range(0, tab_count - 1)\r\n\u001b[?2004l\r"]
[170.290404, "o", "\u001b[?2004h> "]
[170.290438, "o", "        let tab = a:layout.tabs[tab_idx]\r\n\u001b[?2004l\r"]
[170.290453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.290464, "o", "\u001b[?2004h> "]
[170.290484, "o", "        if tab_idx > 0\r\n\u001b[?2004l\r"]
[170.290498, "o", "\u001b[?2004h> "]
[170.290561, "o", "            let script = script . ind . '\" Tab ' . (tab_idx + 1) . '\\n'\r\n\u001b[?2004l\r"]
[170.290575, "o", "\u001b[?2004h> "]
[170.290627, "o", "            let script = script . ind . 'tabnew\\n'\r\n\u001b[?2004l\r"]
[170.290641, "o", "\u001b[?2004h> "]
[170.290678, "o", "            let script = script . ind . '\\n'\r\n\u001b[?2004l\r"]
[170.290694, "o", "\u001b[?2004h> "]
[170.290706, "o", "        endif\r\n\u001b[?2004l\r"]
[170.29072, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[170.290732, "o", "> "]
[170.290767, "o", "        let win_count = len(tab.windows)\r\n\u001b[?2004l\r"]
[170.290779, "o", "\u001b[?2004h> "]
[170.290805, "o", "        let first_window = 1\r\n\u001b[?2004l\r"]
[170.290819, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.29083, "o", "\u001b[?2004h> "]
[170.290871, "o", "        for win_idx in range(0, win_count - 1)\r\n\u001b[?2004l\r"]
[170.290884, "o", "\u001b[?2004h> "]
[170.290922, "o", "            let win = tab.windows[win_idx]\r\n\u001b[?2004l\r"]
[170.290932, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.290946, "o", "\u001b[?2004h> "]
[170.290972, "o", "            if first_window\r\n\u001b[?2004l\r"]
[170.290984, "o", "\u001b[?2004h> "]
[170.291018, "o", "                let first_window = 0\r\n\u001b[?2004l\r"]
[170.291032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.291044, "o", "\u001b[?2004h> "]
[170.291075, "o", "                if win.bufname != ''\r\n\u001b[?2004l\r"]
[170.291088, "o", "\u001b[?2004h> "]
[170.291169, "o", "                    let script = script . ind . '\" Window ' . (win_idx + 1) . ' - buffer: ' . win.bufname . '\\n'\r\n\u001b[?2004l\r"]
[170.291183, "o", "\u001b[?2004h> "]
[170.291245, "o", "                    let script = script . ind . 'edit ' . fnameescape(win.bufname) . '\\n'\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.291257, "o", "> "]
[170.291269, "o", "                endif\r\n\u001b[?2004l\r"]
[170.291282, "o", "\u001b[?2004h> "]
[170.291294, "o", "            else\r\n\u001b[?2004l\r"]
[170.291305, "o", "\u001b[?2004h> "]
[170.291377, "o", "                let script = script . ind . '\" Window ' . (win_idx + 1) . ' - buffer: ' . win.bufname . '\\n'\r\n\u001b[?2004l\r"]
[170.29139, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.291428, "o", "                if win.split_type == 'vsplit'\r\n\u001b[?2004l\r"]
[170.291439, "o", "\u001b[?2004h> "]
[170.291484, "o", "                    let script = script . ind . 'vsplit\\n'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.291523, "o", "                elseif win.split_type == 'split'\r\n\u001b[?2004l\r"]
[170.291535, "o", "\u001b[?2004h> "]
[170.291574, "o", "                    let script = script . ind . 'split\\n'\r\n\u001b[?2004l\r"]
[170.291586, "o", "\u001b[?2004h> "]
[170.291604, "o", "                endif\r\n\u001b[?2004l\r"]
[170.291616, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.291627, "o", "\u001b[?2004h> "]
[170.291651, "o", "                if win.bufname != ''\r\n\u001b[?2004l\r"]
[170.291661, "o", "\u001b[?2004h> "]
[170.291747, "o", "                    let script = script . ind . 'edit ' . fnameescape(win.bufname) . '\\n'\r\n\u001b[?2004l\r"]
[170.29176, "o", "\u001b[?2004h> "]
[170.291786, "o", "                endif\r\n\u001b[?2004l\r"]
[170.2918, "o", "\u001b[?2004h> "]
[170.291819, "o", "            endif\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.291833, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.291845, "o", "> "]
[170.291868, "o", "            let script = script . ind . '\\n'\r\n\u001b[?2004l\r"]
[170.291881, "o", "\u001b[?2004h> "]
[170.291892, "o", "        endfor\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.291904, "o", "> "]
[170.291916, "o", "    endfor\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.291928, "o", "\u001b[?2004h> "]
[170.291969, "o", "    let script = script . ind . '\" Restore active tab\\n'\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.291981, "o", "> "]
[170.292019, "o", "    let script = script . ind . 'if ' . tab_count . ' > 1\\n'\r\n\u001b[?2004l\r"]
[170.292032, "o", "\u001b[?2004h> "]
[170.292078, "o", "    let script = script . ind1 . 'tabnext ' . a:layout.active_tab . '\\n'\r\n\u001b[?2004l\r"]
[170.292089, "o", "\u001b[?2004h> "]
[170.292116, "o", "    let script = script . ind . 'endif\\n'\r\n\u001b[?2004l\r"]
[170.292128, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[170.292141, "o", "> "]
[170.292153, "o", "    return script\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.292164, "o", "> endfunction\r\n"]
[170.292176, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.292188, "o", "\u001b[?2004h> "]
[170.292213, "o", "function! s:LayoutQuineImpl(path)\r\n\u001b[?2004l\r"]
[170.292225, "o", "\u001b[?2004h> "]
[170.292247, "o", "    let layout = s:CaptureLayout()\r\n\u001b[?2004l\r"]
[170.292259, "o", "\u001b[?2004h> "]
[170.292291, "o", "    let script = s:GenerateLayoutScript(layout, 0)\r\n\u001b[?2004l\r"]
[170.292304, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[170.292316, "o", "> "]
[170.292344, "o", "    call writefile(split(script, '\\n'), a:path)\r\n\u001b[?2004l\r"]
[170.292357, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[170.292369, "o", "> "]
[170.292392, "o", "    echo 'Layout saved to: ' . a:path\r\n\u001b[?2004l\r"]
[170.292405, "o", "\u001b[?2004h> "]
[170.292418, "o", "endfunction\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.292429, "o", "\u001b[?2004h> "]
[170.292476, "o", "command! -nargs=1 LayoutQuine call s:LayoutQuineImpl(<f-args>)\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.292486, "o", "> "]
[170.292497, "o", "ENDOFFILE\r\n\u001b[?2004l\r"]
[170.29424, "o", "\u001b[?2004hroot@8d526f641b03:/app# "]
[177.834054, "i", "head -20 /app/plugin/layout_quine.vim\n"]
[177.834189, "o", "head -20 /app/plugin/layout_quine.vim\r\n\u001b[?2004l\r"]
[177.834889, "o", "\" LayoutQuine Plugin\r\n\" A Vimscript plugin that can replicate a Vim layout\r\n\r\nif exists('g:layout_quine_loaded')\r\n    finish\r\nendif\r\nlet g:layout_quine_loaded = 1\r\n\r\nfunction! s:CaptureLayout()\r\n    let layout = {\r\n        \\ 'active_tab': tabpagenr(),\r\n        \\ 'tabs': []\r\n        \\ }\r\n\r\n    let tab_count = tabpagenr('$')\r\n\r\n    for tab_num in range(1, tab_count)\r\n        let tab_info = {\r\n            \\ 'windows': [],\r\n            \\ 'window_count': 0\r\n"]
[177.83502, "o", "\u001b[?2004hroot@8d526f641b03:/app# "]
[178.040888, "i", "tail -20 /app/plugin/layout_quine.vim\n"]
[178.041044, "o", "tail -20 /app/plugin/layout_quine.vim\r\n\u001b[?2004l\r"]
[178.043832, "o", "    endfor\r\n\r\n    let script = script . ind . '\" Restore active tab\\n'\r\n    let script = script . ind . 'if ' . tab_count . ' > 1\\n'\r\n    let script = script . ind1 . 'tabnext ' . a:layout.active_tab . '\\n'\r\n    let script = script . ind . 'endif\\n'\r\n\r\n"]
[178.04384, "o", "    return script\r\nendfunction\r\n\r\nfunction! s:LayoutQuineImpl(path)\r\n"]
[178.043871, "o", "    let layout = s:CaptureLayout()\r\n    let script = s:GenerateLayoutScript(layout, 0)\r\n\r\n    call writefile(split(script, '\\n'), a:path)\r\n\r\n    echo 'Layout saved to: ' . a:path\r\nendfunction\r\n\r\ncommand! -nargs=1 LayoutQuine call s:LayoutQuineImpl(<f-args>)\r\n"]
[178.043979, "o", "\u001b[?2004h"]
[178.043996, "o", "root@8d526f641b03:/app# "]
[183.046945, "i", "vim -u /app/plugin/layout_quine.vim -c 'LayoutQuine /tmp/test_layout.vim' -c 'q'\n"]
[183.047138, "o", "vim -u /app/plugin/layout_quine.vim -c 'LayoutQuine /tmp/test_layout.vim' -c 'q'\r\n\u001b[?2004l\r"]
