[344.216627, "o", "\u001b[?2004h> "]
[344.216684, "o", "    let layout = s:CaptureLayout()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.216697, "o", "    let script = s:GenerateLayoutScript(layout, 0)\r\n\u001b[?2004l\r"]
[344.216706, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.216799, "o", "    call writefile(script, a:path)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     echo 'Layout saved to: ' . a:path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.21683, "o", "endfunction\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.216876, "o", "command! -nargs=1 LayoutQuine call s:LayoutQuineImpl(<f-args>)\r\n\u001b[?2004l\r"]
[344.216892, "o", "\u001b[?2004h> "]
[344.216905, "o", "ENDOFPLUGIN\r\n\u001b[?2004l\r"]
