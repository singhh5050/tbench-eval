[97.600729, "o", "cat /app/plugin/layout_quine.vim\r\n\u001b[?2004l\r"]
[97.601271, "o", "\" LayoutQuine Plugin\r\n\" A Vimscript plugin that can replicate a Vim layout\r\n\r\nif exists('g:layout_quine_loaded')\r\n    finish\r\nendif\r\nlet g:layout_quine_loaded = 1\r\n\r\ntime function! s:CaptureLayout()\r\n    let layout = {\r\n        \\ 'active_tab': tabpagenr(),\r\n        \\ 'tabs': []\r\n        \\ }\r\n    \r\n    let tab_count = tabpagenr('$')\r\n    \r\n    for tab_num in range(1, tab_count)\r\n        let tab_info = {\r\n            \\ 'windows': [],\r\n            \\ 'window_count': 0\r\n            \\ }\r\n        \r\n        execute 'tabnext' tab_num\r\n        \r\n        let win_count = winnr('$')\r\n        let tab_info.window_count = win_count\r\n        \r\n        for win_num in range(1, win_count)\r\n            let win_info = {\r\n                \\ 'bufnr': winbufnr(win_num),\r\n                \\ 'bufname': bufname(winbufnr(win_num)),\r\n                \\ 'width': winwidth(win_num),\r\n                \\ 'height': winheight(win_num)\r\n                \\ }"]
[97.601318, "o", "\r\n            \r\n            if win_num > 1\r\n                let prev_win = win_num - 1\r\n                let prev_right = win_screenpos(prev_win)[0] + winwidth(prev_win)\r\n                let curr_left = win_screenpos(win_num)[0]\r\n                \r\n                if prev_right == curr_left\r\n                    let win_info.split_type = 'vsplit'\r\n                else\r\n                    let win_info.split_type = 'split'\r\n                endif\r\n            else\r\n                let win_info.split_type = 'first'\r\n            endif\r\n            \r\n            call add(tab_info.windows, win_info)\r\n        endfor\r\n        \r\n        call add(layout.tabs, tab_info)\r\n    endfor\r\n    \r\n    execute 'tabnext' layout.active_tab\r\n    \r\n    return layout\r\nendfunction\r\n\r\ntime function! s:GenerateLayoutScript(layout, indent)\r\n    let script = ''\r\n    let ind = repeat('    ', a:indent)\r\n    let ind1 = repeat('    ', a:indent + 1)\r\n    \r\n    script .= ind . '\" Recreate tabs and windows\\n'\r\n    script .= ind . '\" Active tab was: "]
[97.601341, "o", "' . a:layout.active_tab . '\\n'\r\n    script .= ind . '\\n'\r\n    \r\n    let tab_count = len(a:layout.tabs)\r\n    \r\n    for tab_idx in range(0, tab_count - 1)\r\n        let tab = a:layout.tabs[tab_idx]\r\n        \r\n        if tab_idx > 0\r\n            script .= ind . '\" Tab ' . (tab_idx + 1) . '\\n'\r\n            script .= ind . 'tabnew\\n'\r\n            script .= ind . '\\n'\r\n        endif\r\n        \r\n        let win_count = len(tab.windows)\r\n        let first_window = 1\r\n        \r\n        for win_idx in range(0, win_count - 1)\r\n            let win = tab.windows[win_idx]\r\n            \r\n            if first_window\r\n                let first_window = 0\r\n                \r\n                if win.bufname != ''\r\n                    script .= ind . '\" Window ' . (win_idx + 1) . ' - buffer: ' . win.bufname . '\\n'\r\n                    script .= ind . 'edit ' . fnameescape(win.bufname) . '\\n'\r\n                endif\r\n            else\r\n                script .= ind . '\" Window ' . (win_idx + 1) . ' - buffer: ' . win.bufname . '\\n'\r\n   "]
[97.601359, "o", "             \r\n                if win.split_type == 'vsplit'\r\n                    script .= ind . 'vsplit\\n'\r\n                elseif win.split_type == 'split'\r\n                    script .= ind . 'split\\n'\r\n                endif\r\n                \r\n                if win.bufname != ''\r\n                    script .= ind . 'edit ' . fnameescape(win.bufname) . '\\n'\r\n                endif\r\n            endif\r\n            \r\n            script .= ind . '\\n'\r\n        endfor\r\n    endfor\r\n    \r\n    script .= ind . '\" Restore active tab\\n'\r\n    script .= ind . 'if ' . tab_count . ' > 1\\n'\r\n    script .= ind1 . 'tabnext ' . a:layout.active_tab . '\\n'\r\n    script .= ind . 'endif\\n'\r\n    \r\n    return script\r\nendfunction\r\n\r\ntime function! s:LayoutQuineImpl(path)\r\n    let layout = s:CaptureLayout()\r\n    let script = s:GenerateLayoutScript(layout, 0)\r\n    \r\n    call writefile(split(script, '\\n'), a:path)\r\n    \r\n    echo 'Layout saved to: ' . a:path\r\nendfunction\r\n\r\ntime command! -nargs=1 LayoutQuine call s:LayoutQuineImpl(<f-ar"]
[97.601374, "o", "gs>)\r\n"]
