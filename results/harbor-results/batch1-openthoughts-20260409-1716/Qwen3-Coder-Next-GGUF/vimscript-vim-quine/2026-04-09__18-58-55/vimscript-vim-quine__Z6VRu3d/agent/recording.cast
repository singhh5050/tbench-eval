[304.063313, "o", "\" Recreate tabs and windows\\n\" Active tab was: 2\\n\\n\\n\" Window 2 - buffer: \\nsplit\\n\\n\" Window 3 - buffer: \\nsplit\\n\\n\" Tab 2\\ntabnew\\n\\n\\n\" Window 2 - buffer: \\nsplit\\n\\n\" Restore active tab\\nif 2 > 1\\n    tabnext 2\\nendif\\n\r\n"]
[304.063423, "o", "\u001b[?2004hroot@8d526f641b03:/app# "]
[319.990791, "i", "cat > /app/plugin/layout_quine.vim << 'ENDOFPLUGIN'\n\" LayoutQuine Plugin\n\" A Vimscript plugin that can replicate a Vim layout\n\nif exists('g:layout_quine_loaded')\n    finish\nendif\nlet g:layout_quine_loaded = 1\n\nfunction! s:CaptureLayout()\n    let layout = {}\n    let layout.active_tab = tabpagenr()\n    let layout.tabs = []\n\n    let tab_count = tabpagenr('$')\n\n    for tab_num in range(1, tab_count)\n        let tab_info = {}\n        let tab_info.windows = []\n        let tab_info.window_count = winnr('$')\n\n        execute 'tabnext' tab_num\n\n        let win_count = winnr('$')\n\n        for win_num in range(1, win_count)\n            let win_info = {}\n            let win_info.bufnr = winbufnr(win_num)\n            let win_info.bufname = bufname(winbufnr(win_num))\n            let win_info.width = winwidth(win_num)\n            let win_info.height = winheight(win_num)\n\n            if win_num > 1\n                let prev_win = win_num - 1\n                let prev_right = win_screenpos(prev_win)[0] + winwidth(prev_win)\n    "]
[319.990841, "i", "            let curr_left = win_screenpos(win_num)[0]\n\n                if prev_right == curr_left\n                    let win_info.split_type = 'vsplit'\n                else\n                    let win_info.split_type = 'split'\n                endif\n            else\n                let win_info.split_type = 'first'\n            endif\n\n            call add(tab_info.windows, win_info)\n        endfor\n\n        call add(layout.tabs, tab_info)\n    endfor\n\n    execute 'tabnext' layout.active_tab\n\n    return layout\nendfunction\nENDOFPLUGIN\n"]
[319.990979, "o", "cat > /app/plugin/layout_quine.vim << 'ENDOFPLUGIN'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.991006, "o", "\" LayoutQuine Plugin\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.991031, "o", "\" A Vimscript plugin that can replicate a Vim layout\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[319.99108, "o", "\u001b[?2004h> "]
[319.991145, "o", "if exists('g:layout_quine_loaded')\r\n\u001b[?2004l\r\u001b[?2004h>     finish\r\n\u001b[?2004l\r\u001b[?2004h> endif\r\n\u001b[?2004l\r\u001b[?2004h> let g:layout_quine_loaded = 1\r\n\u001b[?2004l\r"]
[319.991172, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.991196, "o", "function! s:CaptureLayout()\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.991219, "o", ">     let layout = {}\r\n\u001b[?2004l\r"]
