[347.783553, "o", "\" LayoutQuine Plugin\r\n\" A Vimscript plugin that can replicate a Vim layout\r\n\r\nif exists('g:layout_quine_loaded')\r\n    finish\r\nendif\r\nlet g:layout_quine_loaded = 1\r\n\r\nfunction! s:CaptureLayout()\r\n    let layout = {}\r\n    let layout.active_tab = tabpagenr()\r\n    let layout.tabs = []\r\n\r\n    let tab_count = tabpagenr('$')\r\n\r\n    for tab_num in range(1, tab_count)\r\n        let tab_info = {}\r\n        let tab_info.windows = []\r\n        let tab_info.window_count = winnr('$')\r\n\r\n        execute 'tabnext' tab_num\r\n\r\n        let win_count = winnr('$')\r\n\r\n        for win_num in range(1, win_count)\r\n            let win_info = {}\r\n            let win_info.bufnr = winbufnr(win_num)\r\n            let win_info.bufname = bufname(winbufnr(win_num))\r\n            let win_info.width = winwidth(win_num)\r\n            let win_info.height = winheight(win_num)\r\n\r\n            if win_num > 1\r\n                let prev_win = win_num - 1\r\n                let prev_right = win_screenpos(prev_win)[0] + winwidth(prev_win)\r\n                let cu"]
[347.78357, "o", "rr_left = win_screenpos(win_num)[0]\r\n\r\n                if prev_right == curr_left\r\n                    let win_info.split_type = 'vsplit'\r\n                else\r\n                    let win_info.split_type = 'split'\r\n                endif\r\n            else\r\n                let win_info.split_type = 'first'\r\n            endif\r\n\r\n            call add(tab_info.windows, win_info)\r\n        endfor\r\n\r\n        call add(layout.tabs, tab_info)\r\n    endfor\r\n\r\n    execute 'tabnext' layout.active_tab\r\n\r\n    return layout\r\nendfunction\r\n\r\nfunction! s:GenerateLayoutScript(layout, indent)\r\n    let script = []\r\n    let ind = repeat('    ', a:indent)\r\n    let ind1 = repeat('    ', a:indent + 1)\r\n\r\n    call add(script, ind . '\" Recreate tabs and windows')\r\n    call add(script, ind . '\" Active tab was: ' . a:layout.active_tab)\r\n    call add(script, '')\r\n\r\n    let tab_count = len(a:layout.tabs)\r\n\r\n    for tab_idx in range(0, tab_count - 1)\r\n        let tab = a:layout.tabs[tab_idx]\r\n\r\n        if tab_idx > 0\r\n            call add(scr"]
[347.78362, "o", "ipt, ind . '\" Tab ' . (tab_idx + 1))\r\n            call add(script, ind . 'tabnew')\r\n            call add(script, '')\r\n        endif\r\n\r\n        let win_count = len(tab.windows)\r\n        let first_window = 1\r\n\r\n        for win_idx in range(0, win_count - 1)\r\n            let win = tab.windows[win_idx]\r\n\r\n            if first_window\r\n                let first_window = 0\r\n\r\n                if win.bufname != ''\r\n                    call add(script, ind . '\" Window ' . (win_idx + 1) . ' - buffer: ' . win.bufname)\r\n                    call add(script, ind . 'edit ' . fnameescape(win.bufname))\r\n                endif\r\n            else\r\n                call add(script, ind . '\" Window ' . (win_idx + 1) . ' - buffer: ' . win.bufname)\r\n\r\n                if win.split_type == 'vsplit'\r\n                    call add(script, ind . 'vsplit')\r\n                elseif win.split_type == 'split'\r\n                    call add(script, ind . 'split')\r\n                endif\r\n\r\n                if win.bufname != ''\r\n                    ca"]
[347.783642, "o", "ll add(script, ind . 'edit ' . fnameescape(win.bufname))\r\n                endif\r\n            endif\r\n\r\n            call add(script, '')\r\n        endfor\r\n    endfor\r\n\r\n    call add(script, ind . '\" Restore active tab')\r\n    call add(script, ind . 'if ' . tab_count . ' > 1')\r\n    call add(script, ind1 . 'tabnext ' . a:layout.active_tab)\r\n    call add(script, ind . 'endif')\r\n\r\n    return script\r\nendfunction\r\n\r\nfunction! s:LayoutQuineImpl(path)\r\n    let layout = s:CaptureLayout()\r\n    let script = s:GenerateLayoutScript(layout, 0)\r\n\r\n    call writefile(script, a:path)\r\n\r\n    echo 'Layout saved to: ' . a:path\r\nendfunction\r\n\r\ncommand! -nargs=1 LayoutQuine call s:LayoutQuineImpl(<f-args>)\r\n"]
